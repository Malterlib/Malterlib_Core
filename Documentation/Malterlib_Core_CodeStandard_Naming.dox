/** 

\page p_Malterlib_Core_CodeStandard_Naming Naming

Names are written with upper camel case:
~~~
	VariableName
	m_MemberVariableName
	fg_FunctionCall
	CClassName
~~~

They are NOT written with lower camel case or lower case:

\code{+incorrect}
	variableName
	m_member_variable_name
	functionCall
	class_name
\endcode

Underscore is normally not used for anything other than prefixes, but can be used as a separator for groups of things like this:
~~~
	uint32 m_Category_Var1;
	uint32 m_Category_Var2;
	uint32 m_Category_Var3;
	uint32 m_Category_Var4;
	uint32 m_Category_Var5;
~~~

The exception to the upper camel case rule is that features that are emulation of missing language functionality or typedefs for built in types is written as lower case:
~~~
	inline_always
	inline_never
	module_import
	assure_used
	align_cacheline
	likely
	unlikely
	abstract
	uint32
	fp64
	mint
~~~

\section s_Malterlib_Core_CodeStandard_Naming_StoragePrefixes Storage prefixes

All functions, parameters and variables must be prefixed by a storage prefix telling us where the entity originates from. Local variables are the only entities that do not have a storage prefix:
Prefixes | Detailed information
-------- | --------------------
f_ fp_ fs_ fsp_ fg_ fsg_  | \ref s_Malterlib_Core_CodeStandard_Naming_FunctionPrefixes
_ p_ o_ po_ t_ tp_ tf_ tpf_ d_ | \ref s_Malterlib_Core_CodeStandard_Naming_ParameterPrefixes
c_ s_ g_ gc_ gs_ m_ mc_ ms_ mp_ mcp_ msp_ | \ref s_Malterlib_Core_CodeStandard_Naming_VariablePrefixes
 
 
\subsection s_Malterlib_Core_CodeStandard_Naming_FunctionPrefixes Function prefixes

 
<table>
<tr><th>Prefix</th><th>Usage</th><th>Examples</th><th>Discussion</th></tr>
<tr>
	<td>f_</td>
	<td>Member function</td>
	<td>
~~~
	void f_Test()
	void f_rTest()
~~~
	</td>
	<td></td>
</tr>
<tr>
	<td>fp_</td>
	<td>Private or protected member function</td>
	<td>
~~~
	void fp_Test()
	void fp_rTest()
~~~
	</td>
	<td></td>
</tr>
<tr>
	<td>fs_</td>
	<td>Static member function</td>
	<td>
~~~
	static void fs_Test()
	static void fs_rTest()
~~~
	</td>
	<td></td>
</tr>
<tr>
	<td>fsp_</td>
	<td>Private or protected static member function</td>
	<td>
~~~
	static void fsp_Test()
	static void fsp_rTest()
~~~
	</td>
	<td></td>
</tr>
<tr>
	<td>fg_</td>
	<td>Global function</td>
	<td>
~~~
	void fg_Test()
	void fg_rTest()
~~~
	</td>
	<td></td>
</tr>
<tr>
	<td>fsg_</td>
	<td>Static global function</td>
	<td>
~~~
	static void fsg_Test()
	static void fsg_rTest()
~~~
	</td>
	<td></td>
</tr>
</table>
 
\subsection s_Malterlib_Core_CodeStandard_Naming_ParameterPrefixes Parameter prefixes

\subsubsection s_Malterlib_Core_CodeStandard_Naming_FunctionParameterPrefixes Function parameter prefixes

<table>
<tr><th>Prefix</th><th>Usage</th><th>Examples</th><th>Discussion</th></tr>
<tr>
	<td>_</td>
	<td>Function parameter</td>
	<td>
~~~
	void f_Func(int _Test)
	void f_Func(bool _bTest)
	void f_Func(TCSet<int> _cTest)
	void f_Func(mint _iTest)
	void f_Func(mint _nTest)
	void f_Func(int *_pTest)
	void f_Func(FTest _fTest)
~~~
	</td>
	<td></td>
</tr>
<tr>
	<td>p_</td>
	<td>Function parameter pack</td>
	<td>
~~~
	void f_Func(t_CInt ...p_Test)
	void f_Func(t_CBool ...p_bTest)
	void f_Func(t_CContainer ...p_cTest)
	void f_Func(t_CIndex ...p_iTest)
	void f_Func(t_CNum ...p_nTest)
	void f_Func(t_CPointer ...p_pTest)
	void f_Func(t_FFunc ...p_fTest)
~~~
	</td>
	<td></td>
</tr>
<tr>
	<td>o_</td>
	<td>Function output parameter</td>
	<td>
~~~
	void f_Func(int &o_Test)
	void f_Func(bool &o_bTest)
	void f_Func(TCSet<int> &o_cTest)
	void f_Func(mint &o_iTest)
	void f_Func(mint &o_nTest)
	void f_Func(int *&o_pTest)
	void f_Func(FTest &o_fTest)
~~~
	</td>
	<td></td>
</tr>
<tr>
	<td>po_</td>
	<td>Function output parameter pack</td>
	<td>
~~~
	void f_Func(t_CInt &...po_Test)
	void f_Func(t_CBool &...po_bTest)
	void f_Func(t_CContainer &...po_cTest)
	void f_Func(t_CIndex &...po_iTest)
	void f_Func(t_CNum &...po_nTest)
	void f_Func(t_CPointer &...po_pTest)
	void f_Func(t_FFunc &...po_fTest)
~~~
	</td>
	<td></td>
</tr>
</table>

 
 
\subsubsection s_Malterlib_Core_CodeStandard_Naming_TemplateParameterPrefixes Template parameter prefixes

<table>
<tr><th>Prefix</th><th>Usage</th><th>Examples</th><th>Discussion</th></tr>
<tr>
	<td>t_</td>
	<td>Template parameter</td>
	<td>
~~~
	template <uint32 t_Test>
	template <typename t_CTest>
	template <typename t_FTest>
	template <template <typename> class t_TCTest>
~~~
	</td>
	<td></td>
</tr>
<tr>
	<td>tp_</td>
	<td>Template parameter pack	</td>
	<td>
~~~
	template <uint32 ...tp_Test>
	template <typename ...tp_CTest>
	template <typename ...tp_FTest>
	template <template <typename> class ...tp_TCTest>
~~~
	</td>
	<td></td>
</tr>
<tr>
	<td>tf_</td>
	<td>Template function parameter</td>
	<td>
~~~
	template <uint32 tf_Test>
	template <typename tf_CTest>
	template <typename tf_FTest>
	template <template <typename> class tf_TCTest>
~~~
	</td>
	<td></td>
</tr>
<tr>
	<td>tfp_</td>
	<td>Template function paramater pack</td>
	<td>
~~~
	template <uint32 ...tfp_Test>
	template <typename ...tfp_CTest>
	template <typename ...tfp_FTest>
	template <template <typename> class ...tfp_TCTest>
~~~
	</td>
	<td></td>
</tr>
</table>

  
\subsubsection s_Malterlib_Core_CodeStandard_Naming_MacroParameterPrefixes Macro parameter prefix

<table>
<tr><th>Prefix</th><th>Usage</th><th>Examples</th><th>Discussion</th></tr>
<tr>
	<td>d_</td>
	<td>Macro parameter</td>
	<td>
~~~
	#define DTest(d_Test)
	#define DTest(d_bTest)
	#define DTest(d_cTest)
	#define DTest(d_iTest)
	#define DTest(d_nTest)
	#define DTest(d_pTest)
	#define DTest(d_fTest)
	#define DTest(d_NTest)
	#define DTest(d_CTest)
	#define DTest(d_FTest)
	#define DTest(d_ICTest)
	#define DTest(d_TCTest)
	#define DTest(d_TICTest)
~~~
	</td>
	<td>Because a macro parameter can be just about anything, the prefix can be combined with many concept and type prefixes. See examples for which make sense to use.</td>
</tr>
</table>

\subsection s_Malterlib_Core_CodeStandard_Naming_VariablePrefixes Variable prefixes

\subsubsection s_Malterlib_Core_CodeStandard_Naming_LocalVariablePrefixes Local variable prefixes

<table>
<tr><th>Prefix</th><th>Usage</th><th>Examples</th><th>Discussion</th></tr>
<tr>
	<td></td>
	<td>Local variables</td>
	<td>
~~~
	uint32 Test = 0;
	bool bTest = true;
	TCSet<int> cTest;
	mint iTest = 0;
	mint nTest = 0;
	int *pTest = nullptr;
	FTest *fTest = &fg_Test;
	auto fTest = []{};
~~~
	</td>
	<td>The only place where no prefix is used is for local variables.</td>
</tr>
<tr>
	<td>c_</td>
	<td>Compile time constant local variables</td>
	<td>
~~~
	static uint32 const c_Test = 0;
	static bool const c_bTest = true;
	static mint const c_iTest = 0;
	static mint const c_nTest = 0;
~~~
	</td>
	<td></td>
</tr>
<tr>
	<td>s_</td>
	<td>Static local variable</td>
	<td>
~~~
	static uint32 s_Test = 0;
	static bool s_bTest = true;
	static TCSet<int> s_cTest;
	static mint s_iTest = 0;
	static mint s_nTest = 0;
	static int *s_pTest = nullptr;
	static FTest *s_fTest = &fg_Test;
	static auto s_fTest = []{};
~~~
	</td>
	<td></td>
</tr>
</table>

