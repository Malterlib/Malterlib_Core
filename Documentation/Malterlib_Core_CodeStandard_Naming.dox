~~~
	class CTest
	{
		static uint32 const mcp_Test = 0;
		static bool const mcp_bTest = true;
		static mint const mcp_iTest = 0;
		static mint const mcp_nTest = 0;
	};
~~~
	</td>
	<td></td>
