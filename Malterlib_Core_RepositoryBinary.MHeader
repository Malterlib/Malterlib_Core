Import "Malterlib_Core_RepositoryCore.MHeader"

Property
{
	MalterlibBinaryRepositories: [string] = []
	MalterlibBinaryRepositories =+ `MalterlibBinaries_@(HostPlatformFamily)_@(HostArchitecture)`

	MalterlibAllBinaryRepositories: bool = false // User(Repository)=true: Set to true to sync all binary repositories.
	MalterlibAllBinaryRepositories_macOS: bool = false

	MalterlibBinaryRepositoriesUseReleaseLFSStore: bool = true // User(Repository)=true: Use binary LFS store for repositories.

	MalterlibInstallGitHookHelpers: bool = ((!RunningCI) && (!MalterlibBuildServerBuild)) // User(Repository)=false: Install Malterlib git hook helpers into repositories.

	MalterlibBootstrapVersion: int = 5
}

Property
{
	!!MalterlibAllBinaryRepositories true

	MalterlibBinaryRepositories =+ "MalterlibBinaries_Linux_x64"
	MalterlibBinaryRepositories =+ "MalterlibBinaries_Linux_x86"
	MalterlibBinaryRepositories =+ "MalterlibBinaries_Linux_arm64"
	MalterlibBinaryRepositories =+ "MalterlibBinaries_Windows_x64"
	MalterlibBinaryRepositories =+ "MalterlibBinaries_Windows_arm64"
}

Property
{
	|
	{
		MalterlibAllBinaryRepositories true
		MalterlibAllBinaryRepositories_macOS true
	}

	MalterlibBinaryRepositories =+ "MalterlibBinaries_macOS_x64"
	MalterlibBinaryRepositories =+ "MalterlibBinaries_macOS_arm64"
}

%Repository "."
{
	// Gated on MalterlibGitHasOrigin because Repository.URL is a hard requirement
	// for every %Repository in the build system (see Malterlib_BuildSystem_Repository.cpp
	// check for m_OriginProperties.m_URL). Revisit once URL can be optional for Root repos.
	!!MalterlibGitHasOrigin true

	Repository
	{
		Type "Root"
		Location Builtin.BasePathAbsolute
		URL MalterlibGitOriginRemote
		ExcludeFromSeen true
		Hooks #<"post-checkout"> =+ "Scripts/GitHooks/post-checkout.sh"->MakeAbsolute()
		{
			!!MalterlibInstallGitHookHelpers true
		}
	}
}

Property
{
	MalterlibPublicRepositories =+ MalterlibBinaryRepositories->Unique()->ForEach(&f_GetMalterlibRepositoryNameFromRepoRLFS)
}

%Repository MalterlibBinaryRepositories->Unique()
{
	Property
	{
		MalterlibRepoName `@(this.Identity).git`
		MalterlibRepoName `@(this.Identity)_rLFS.git`
		{
			!!MalterlibBinaryRepositoriesUseReleaseLFSStore true
		}
		RepoPlatformFamily: string = this.Identity->ParseFormatString("{}_{}_{}", "{1}")
		RepoArchitecture: string = this.Identity->ParseFormatString("{}_{}_{}", "{2}")
		RepoDir: string = `../../Binaries/Malterlib/@(RepoPlatformFamily)/@(RepoArchitecture)`
	}
	Repository
	{
		Type "Malterlib"
		GitIgnoreType "GitIgnore"
		BootstrapSource (RepoPlatformFamily == HostPlatformFamily && RepoArchitecture == HostArchitecture)
		Location RepoDir->MakeAbsolute()
		URL `@(Repository.MalterlibRoot)/@(MalterlibRepoName)`
		Remotes =+ MalterlibRemotePrefixes->ForEach(&f_MalterlibRemotePrefixesTemplate)
		{
			!MalterlibRemotePrefixes undefined
		}
		Remotes =+ {Name: "malterlib", URL: `https://github.com/Malterlib/@(MalterlibRepoName)`, Write: MalterlibUpstreamWriteAccess}
		{
			&
			{
				MalterlibUpstreamAccess true
				!Repository.URL `https://github.com/Malterlib/@(MalterlibRepoName)`
			}
		}
		LfsReleaseStore MalterlibBinaryRepositoriesUseReleaseLFSStore
		Hooks #<"pre-commit"> =+ "Scripts/GitHooks/pre-commit-lfs-check.sh"->MakeAbsolute()
		{
			!!MalterlibInstallGitHookHelpers true
		}
		ReleasePackage {
			ReleaseName : `bootstrap/@(MalterlibBootstrapVersion->ToString())`
			, Description: `Malterlib bootstrap binaries version @(MalterlibBootstrapVersion->ToString())`
			, SourceReference: "lfs"
			, Packages: [
				{
					PackageName: "MTool.tar.gz"
					, Compress: true
					, Files: ["Bootstrap.version", RepoPlatformFamily->SwitchWithError(
						"Unsupported platform: "
						, "macOS", ["MTool", "mib", "bsdtar", "MalterlibHelper", "MalterlibOverrideMalloc.dylib", "LICENSE"]
						, "Linux", ["MTool", "mib", "bsdtar", "MalterlibHelper", "LICENSE"]
						, "Windows", ["MTool.exe", "mib.exe", "bsdtar.exe", "LICENSE"]
					)...]
				}
			]
		}
	}
}

Property
{
	MalterlibBinaryLLVMRepositories: [string] = []
	MalterlibSyncBinaryLLVMRepositories: bool = true // User(Repository)=true: Set to false to skip LLVM binary repositories.
}

Property
{
	&
	{
		!MalterlibOnlyRepositoryManagement true
		MalterlibSyncBinaryLLVMRepositories true
	}

	MalterlibBinaryLLVMRepositories =+ `MalterlibLLVMBinaries_@(HostPlatformFamily)_@(HostArchitecture)`
	{
		|
		{
			HostPlatformFamily "Linux"
			HostPlatformFamily "macOS"
			&
			{
				MalterlibUseClangForWindowsSupported true
				HostPlatformFamily "Windows"
			}
		}
	}

	MalterlibBinaryLLVMRepositories =+ "MalterlibLLVMBinaries_Linux_x64"
	{
		&
		{
			EnablePlatformFamily_Linux true
			EnableArchitecture_x64 true
		}
	}
	MalterlibBinaryLLVMRepositories =+ "MalterlibLLVMBinaries_Linux_x86"
	{
		&
		{
			EnablePlatformFamily_Linux true
			EnableArchitecture_x86 true
		}
	}
}

Property
{
	&
	{
		MalterlibAllBinaryRepositories true
		!MalterlibOnlyRepositoryManagement true
		MalterlibSyncBinaryLLVMRepositories true
	}

	MalterlibBinaryLLVMRepositories =+ "MalterlibLLVMBinaries_macOS_x64"
	MalterlibBinaryLLVMRepositories =+ "MalterlibLLVMBinaries_macOS_arm64"
	MalterlibBinaryLLVMRepositories =+ "MalterlibLLVMBinaries_Linux_x64"
	MalterlibBinaryLLVMRepositories =+ "MalterlibLLVMBinaries_Linux_x86"
	MalterlibBinaryLLVMRepositories =+ "MalterlibLLVMBinaries_Linux_arm64"
	MalterlibBinaryLLVMRepositories =+ "MalterlibLLVMBinaries_Windows_x64"
	MalterlibBinaryLLVMRepositories =+ "MalterlibLLVMBinaries_Windows_arm64"
}

Property
{
	MalterlibPublicRepositories =+ MalterlibBinaryLLVMRepositories->Unique()->ForEach(&f_GetMalterlibRepositoryNameFromRepoRLFS)
}

%Repository MalterlibBinaryLLVMRepositories->Unique()
{
	Property
	{
		MalterlibRepoName `@(this.Identity).git`
		MalterlibRepoName `@(this.Identity)_rLFS.git`
		{
			!!MalterlibBinaryRepositoriesUseReleaseLFSStore true
		}
		RepoPlatformFamily: string = this.Identity->ParseFormatString("{}_{}_{}", "{1}")
		RepoArchitecture: string = this.Identity->ParseFormatString("{}_{}_{}", "{2}")
		RepoDir: string = `../../Binaries/MalterlibLLVM/@(RepoPlatformFamily)/@(RepoArchitecture)`
	}
	Repository
	{
		Type "Malterlib"
		GitIgnoreType "GitIgnore"
		Location RepoDir->MakeAbsolute()
		URL `@(Repository.MalterlibRoot)/@(MalterlibRepoName)`
		Remotes =+ MalterlibRemotePrefixes->ForEach(&f_MalterlibRemotePrefixesTemplate)
		{
			!MalterlibRemotePrefixes undefined
		}
		Remotes =+ {Name: "malterlib", URL: `https://github.com/Malterlib/@(MalterlibRepoName)`, Write: MalterlibUpstreamWriteAccess}
		{
			&
			{
				MalterlibUpstreamAccess true
				!Repository.URL `https://github.com/Malterlib/@(MalterlibRepoName)`
			}
		}
		LfsReleaseStore MalterlibBinaryRepositoriesUseReleaseLFSStore
		Hooks #<"pre-commit"> =+ "Scripts/GitHooks/pre-commit-lfs-check.sh"->MakeAbsolute()
		{
			!!MalterlibInstallGitHookHelpers true
		}
	}
}

%GenerateFile MalterlibBinaryLLVMRepositories->Unique()
{
	&
	{
		HostPlatformFamily "macOS"
		RepoPlatformFamily "Linux"
	}

	Property
	{
		RepoPlatformFamily: string = this.Identity->ParseFormatString("{}_{}_{}", "{1}")
		RepoArchitecture: string = this.Identity->ParseFormatString("{}_{}_{}", "{2}")
		RepoDir: string = `../../Binaries/MalterlibLLVM/@(RepoPlatformFamily)/@(RepoArchitecture)`

		PlatformSuffix: string
		PlatformSuffix "unknown-linux-gnu"
		{
			!!RepoPlatformFamily "Linux"
		}

		PlatformName: string
		PlatformName `aarch64-@(PlatformSuffix)`
		{
			!!RepoArchitecture "arm64"
		}
		PlatformName `x86_64-@(PlatformSuffix)`
		{
			!!RepoArchitecture "x64"
		}
		PlatformName `i386-@(PlatformSuffix)`
		{
			!!RepoArchitecture "x86"
		}
	}
	GenerateFile
	{
		SymlinkBasePath `../../Binaries/MalterlibLLVM/@(HostPlatformFamily)/@(HostArchitecture)/lib/clang/@(MalterlibClangVersionMajor)/lib`->MakeAbsolute()
		Name `@(GenerateFile.SymlinkBasePath)/@(PlatformName)`
		Contents `../../../../../../@(RepoPlatformFamily)/@(RepoArchitecture)/lib/clang/@(MalterlibClangVersionMajor)/lib/@(PlatformName)`
		Executable false
		UnixLineEnds true
		UnicodeBOM false
		Symlink true
		BeforeImports true
		SymlinkDirectory true
	}
}

%GenerateFile [MalterlibBinaryLLVMRepositories->Unique()...]
{
	&
	{
		HostPlatformFamily "macOS"
		RepoPlatformFamily "Linux"
		RepoArchitecture "x86"
	}

	Property
	{
		RepoPlatformFamily: string = this.Identity->ParseFormatString("{}_{}_{}", "{1}")
		RepoArchitecture: string = this.Identity->ParseFormatString("{}_{}_{}", "{2}")
		RepoDir: string = `../../Binaries/MalterlibLLVM/@(RepoPlatformFamily)/@(RepoArchitecture)`

		PlatformSuffix: string
		PlatformSuffix "unknown-linux-gnu"
		{
			!!RepoPlatformFamily "Linux"
		}

		PlatformName: string
		PlatformName `i386-@(PlatformSuffix)`
		{
			!!RepoArchitecture "x86"
		}
	}
	GenerateFile
	{
		SymlinkBasePath `../../Binaries/MalterlibLLVM/@(HostPlatformFamily)/@(HostArchitecture)/lib/clang/@(MalterlibClangVersionMajor)/lib`->MakeAbsolute()
		Name `@(GenerateFile.SymlinkBasePath)/i686-@(PlatformSuffix)`
		Contents `../../../../../../@(RepoPlatformFamily)/@(RepoArchitecture)/lib/clang/@(MalterlibClangVersionMajor)/lib/@(PlatformName)`
		Executable false
		UnixLineEnds true
		UnicodeBOM false
		Symlink true
		BeforeImports true
		SymlinkDirectory true
	}
}

Property
{
	MalterlibBinaryTestRepositories: [string] = []
	MalterlibAllBinaryTestRepositories: bool = false // User(Repository)=true: Set to true to sync all binary test repositories.
}

%Repository MalterlibBinaryTestRepositories
{
	Property
	{
		MalterlibRepoName `MalterlibTestBinaries_@(this.Identity).git`
		MalterlibRepoName `MalterlibTestBinaries_@(this.Identity)_rLFS.git`
		{
			!!MalterlibBinaryRepositoriesUseReleaseLFSStore true
		}

		RepoModule: string = this.Identity->ParseFormatString("{}_{}_{}", "{0}")
		RepoPlatformFamily: string = this.Identity->ParseFormatString("{}_{}_{}", "{1}")
		RepoArchitecture: string = this.Identity->ParseFormatString("{}_{}_{}", "{2}")
		RepoDir: string = `../../Binaries/MalterlibTest/@(RepoModule)/@(RepoPlatformFamily)/@(RepoArchitecture)`
	}
	Repository
	{
		Type "Malterlib"
		GitIgnoreType "GitIgnore"
		Location RepoDir->MakeAbsolute()
		URL `@(Repository.MalterlibRoot)/@(MalterlibRepoName)`
		Remotes =+ MalterlibRemotePrefixes->ForEach(&f_MalterlibRemotePrefixesTemplate)
		{
			!MalterlibRemotePrefixes undefined
		}
		Remotes =+ {Name: "malterlib", URL: `https://github.com/Malterlib/@(MalterlibRepoName)`, Write: MalterlibUpstreamWriteAccess}
		{
			&
			{
				MalterlibUpstreamAccess true
				!Repository.URL `https://github.com/Malterlib/@(MalterlibRepoName)`
			}
		}
		LfsReleaseStore MalterlibBinaryRepositoriesUseReleaseLFSStore
		Hooks #<"pre-commit"> =+ "Scripts/GitHooks/pre-commit-lfs-check.sh"->MakeAbsolute()
		{
			!!MalterlibInstallGitHookHelpers true
		}
	}
}

%GenerateFile ["Malterlib", "MalterlibLLVM"]->Unique()
{
	GenerateFile
	{
		Name `../../Binaries/@(this.Identity)/HostPlatformArchitecture`->MakeAbsolute()
		Contents `@(HostPlatformFamily)/@(HostArchitecture)`
		Executable false
		UnixLineEnds true
		UnicodeBOM false
		Symlink true
		BeforeImports true
		SymlinkDirectory true
		SymlinkBasePath `../../Binaries/@(this.Identity)`->MakeAbsolute()
	}
}

%GenerateFile "MalterlibLLVMCodeLLDB"
{
	GenerateFile
	{
		Name `../../Binaries/MalterlibLLVM/HostPlatformArchitectureCodeLLDB`->MakeAbsolute()
		Contents `@(HostPlatformFamily)/@(HostArchitecture)`
		Contents `@(HostPlatformFamily)/x64`
		{
			&
			{
				HostPlatformFamily "Windows"
				HostArchitecture "arm64"
			}
		}
		Executable false
		UnixLineEnds true
		UnicodeBOM false
		Symlink true
		BeforeImports true
		SymlinkDirectory true
		SymlinkBasePath `../../Binaries/MalterlibLLVM`->MakeAbsolute()
	}
}

%GenerateFile ["Malterlib", "MalterlibLLVM"]
{
	GenerateFile
	{
		Name `../../Binaries/@(this.Identity)/.gitignore`->MakeAbsolute()
		Contents "/HostPlatformArchitecture\n/HostPlatformArchitectureCodeLLDB\n"
		Executable false
		UnixLineEnds true
		UnicodeBOM false
		BeforeImports true
	}
}

%GenerateFile "mib"
{
	!true "."->FindFilesIn("mib")->IsEmpty()

	Property
	{
		MibScriptFile: string = `@(Builtin.BasePathAbsolute)/mib`
		SourceScriptFile: string = "mib"->MakeAbsolute()
	}

	GenerateFile
	{
		Name MibScriptFile
		Contents ReadFile(SourceScriptFile)
		Executable true
		UnixLineEnds true
		UnicodeBOM false
		KeepGeneratedFile true
	}
}
