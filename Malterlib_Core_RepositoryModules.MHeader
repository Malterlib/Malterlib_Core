Import "Malterlib_Core_RepositoryCore.MHeader"

Property
{
	MalterlibModules: [string] = []
	MalterlibPrivateModules: [string] = [] // The modules of MalterlibModules in this list sync only when MalterlibEnablePrivateModules is true
	MalterlibEnablePrivateModules: bool = false // User(Repository)=true: Sync the private modules that MalterlibModules contains. Syncing them needs read access to their repositories.

	f_GetMalterlibSyncedModules function(string _Name) [string] = []
	f_GetMalterlibSyncedModules =+ _Name
	{
		|
		{
			MalterlibEnablePrivateModules true
			!MalterlibPrivateModules->ContainsListElement(_Name) true
		}
	}
}

%Repository MalterlibModules->Unique()->ForEach(&f_GetMalterlibSyncedModules)
{
	!MalterlibUseGitRepo false
	Property.MalterlibRepoName `Malterlib_@(this.Identity).git`

	Repository
	{
		Type "Malterlib"
		Format true
		// The imported and generated third-party code doesn't follow the Malterlib standard.
		Tidy {Enabled: true, ExcludeFiles: ["ImportCache/*", "*/ImportCache/*", "IC/*", "SourceGenerated/*"]}
		// Neither does what mig generates, or the vendored TCMalloc.
		Tidy {Enabled: true, ExcludeFiles: ["ImportCache/*", "*/ImportCache/*", "IC/*", "SourceGenerated/*", "Source/Mig/*", "Source/TCMalloc/*"]}
		{
			!!MalterlibRepoName "Malterlib_Memory.git"
		}
		Hooks #<"pre-commit"> MalterlibSourcePreCommitHooks
		{
			!!MalterlibInstallGitHookHelpers true
		}
		Remotes =+ MalterlibRemotePrefixes->ForEach(&f_MalterlibRemotePrefixesTemplate)
		{
			!MalterlibRemotePrefixes undefined
		}
		Remotes =+ {Name: "malterlib", URL: `https://github.com/Malterlib/@(MalterlibRepoName)`, Write: MalterlibUpstreamWriteAccess}
		{
			&
			{
				MalterlibUpstreamAccess true
				!Repository.URL `https://github.com/Malterlib/@(MalterlibRepoName)`
			}
		}
	}
}
