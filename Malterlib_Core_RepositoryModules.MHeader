Import "Malterlib_Core_RepositoryCore.MHeader"

Property
{
	MalterlibModules: [string] = []
}

%Repository MalterlibModules->Unique()
{
	!MalterlibUseGitRepo false
	Property.MalterlibRepoName `Malterlib_@(this.Identity).git`

	Repository
	{
		Type "Malterlib"
		Remotes =+ MalterlibRemotePrefixes->ForEach(&f_MalterlibRemotePrefixesTemplate)
		{
			!MalterlibRemotePrefixes undefined
		}
		Remotes =+ {Name: "malterlib", URL: `https://github.com/Malterlib/@(MalterlibRepoName)`, Write: MalterlibUpstreamWriteAccess}
		{
			&
			{
				MalterlibUpstreamAccess true
				!Repository.URL `https://github.com/Malterlib/@(MalterlibRepoName)`
			}
		}
	}
}
