Property
{
	Malterlib_All_App_Targets: [type(CEntity)] = []
	Malterlib_All_App_ExtraGroups: [string] = []
}

%Workspace "Apps_Malterlib_All"
{
	!!MalterlibEnableInternalWorkspaces true

	Property
	{
		MalterlibCloud_EnableVersionUpload true
		{
			!!TargetIsExecutable true
		}

		MalterlibLog_Severities ["Error", "Critical", "Warning", "Info"]
		{
			!!MalterlibLog_EnableVerboseDebugLog false
		}

		MalterlibPostCopyProject "Malterlib_All"
		{
			!!TargetIsExecutable true
		}
	}

	%Group "Apps"
	{
		%Target Malterlib_All_App_Targets
	}

	Workspace.ExtraGroups =+ Malterlib_All_App_ExtraGroups->Unique()
}
