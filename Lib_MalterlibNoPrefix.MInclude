Target.ExtraGroups "{Malterlib}/{TCMalloc}"
{
	!!MalterlibMemoryManager "TcMalloc"
}

Compile
{
	!!CompileDialect "C"
	SearchPath "@(Builtin.BasePathAbsolute)/External/elftoolchain/libelf;@(Builtin.BasePathAbsolute)/External/elftoolchain/common;@(Compile.SearchPath)"
	{
		!!PlatformFamily "Linux"
	}
	SearchPath "@(Builtin.BasePathAbsolute)/External/elftoolchain/libdwarf;@(Compile.SearchPath)"
	{
		!!PlatformFamily "Linux"
	}
	SearchPath "@(MalterlibSysRoot)/usr/include/glib-2.0;@(MalterlibSysRoot)/usr/lib/@(MalterlibNativeClangArchitecture)-linux-gnu/glib-2.0/include;@(Compile.SearchPath)"
	{
		!!PlatformFamily "Linux"
	}
	SearchPath "@(MalterlibSysRoot)/usr/include/dbus-1.0;@(MalterlibSysRoot)/usr/lib/@(MalterlibNativeClangArchitecture)-linux-gnu/dbus-1.0/include;@(Compile.SearchPath)"
	{
		!!PlatformFamily "Linux"
	}
	SearchPath "@(MalterlibSysRoot)/usr/include/libsecret-1;@(Compile.SearchPath)"
	{
		!!PlatformFamily "Linux"
	}


	SearchPath "@('../../External/mimalloc/include'->MakeAbsolute());@(Compile.SearchPath)"
	{
		!!MalterlibMemoryManager "MiMalloc"
	}

	PreprocessorDefines "DMibDynamicLibrary;@(Compile.PreprocessorDefines)"
	{
		!!MalterlibDynamicLibrary true
	}

	PreprocessorDefines "DMibConfig_OverrideSystemMalloc;@(Compile.PreprocessorDefines)"
	{
		!!MalterlibMemoryManager_EnableOverrideSystemMalloc true
	}
	PreprocessorDefines "DMalterlibMemoryOverrideOSXInitBeforeLibSystemSupport;@(Compile.PreprocessorDefines)"
	{
		!!MalterlibMemoryManager_OverrideSystemMallocInitBeforeLibSystem true
	}

	PreprocessorDefines "DMibConfig_CheckOverrideMemoryLeaks;@(Compile.PreprocessorDefines)"
	{
		!!MalterlibMemoryManager_CheckOverrideMemoryLeaks true
	}

	// We don't destroy the heap unless we are in debug mode, this speeds up system exit
	PreprocessorDefines "DMibConfig_HeapNeverDestroyed;@(Compile.PreprocessorDefines)"
	{
		|
		{
			MalterlibMemoryManager_Debug false	// Specifically disabled
			!DebugCode true				// Implicitly disabled
		}
	}

	PreprocessorDefines "DMibConfig_MalterlibMemoryManager_AlwaysRelease=1;@(Compile.PreprocessorDefines)"
	{
		!!MalterlibMemoryManager_AlwaysRelease true
	}
	PreprocessorDefines "DMibConfig_MalterlibMemoryManager_AlwaysRelease=0;@(Compile.PreprocessorDefines)"
	{
		!MalterlibMemoryManager_AlwaysRelease true
	}

	// Debug options

	PreprocessorDefines "DMibConfig_MalterlibMemoryManager_Debug_Features=1;@(Compile.PreprocessorDefines)"
	{
		!!MalterlibMemoryManager_Debug_Features true
	}
	PreprocessorDefines "DMibConfig_MalterlibMemoryManager_Debug_Features=0;@(Compile.PreprocessorDefines)"
	{
		!!MalterlibMemoryManager_Debug_Features false
	}
	PreprocessorDefines "DMibConfig_MalterlibMemoryManager_Debug_Features=2;@(Compile.PreprocessorDefines)"
	{
		&
		{
			!MalterlibMemoryManager_Debug_Features true
			!MalterlibMemoryManager_Debug_Features false
		}
	}

	PreprocessorDefines "DMibConfig_MalterlibMemoryManager_Debug_EnableStackTrace=1;@(Compile.PreprocessorDefines)"
	{
		!!MalterlibMemoryManager_Debug_EnableStackTrace true
	}
	PreprocessorDefines "DMibConfig_MalterlibMemoryManager_Debug_EnableStackTrace=0;@(Compile.PreprocessorDefines)"
	{
		!MalterlibMemoryManager_Debug_EnableStackTrace true
	}

	PreprocessorDefines "DMibConfig_MalterlibMemoryManager_Debug_EnableFreeValidation=1;@(Compile.PreprocessorDefines)"
	{
		!!MalterlibMemoryManager_Debug_EnableFreeValidation true
	}
	PreprocessorDefines "DMibConfig_MalterlibMemoryManager_Debug_EnableFreeValidation=0;@(Compile.PreprocessorDefines)"
	{
		!MalterlibMemoryManager_Debug_EnableFreeValidation true
	}


	PreprocessorDefines "DMibConfig_MalterlibMemoryManager_Debug_EnableMemoryLeaks=1;@(Compile.PreprocessorDefines)"
	{
		!!MalterlibMemoryManager_Debug_EnableMemoryLeaks true
	}
	PreprocessorDefines "DMibConfig_MalterlibMemoryManager_Debug_EnableMemoryLeaks=0;@(Compile.PreprocessorDefines)"
	{
		!MalterlibMemoryManager_Debug_EnableMemoryLeaks true
	}

	PreprocessorDefines "DMibConfig_MalterlibMemoryManager_NeedDualPageSize=1;@(Compile.PreprocessorDefines)"
	{
		&
		{
			PlatformFamily OSX
			MalterlibMemoryManager Malterlib
		}
	}
	PreprocessorDefines "DMibConfig_MalterlibMemoryManager_NeedDualPageSize=0;@(Compile.PreprocessorDefines)"
	{
		!
		{
			&
			{
				PlatformFamily OSX
				MalterlibMemoryManager Malterlib
			}
		}
	}

	PreprocessorDefines "DMibConfig_MalterlibMemoryManager_Debug_EnableFreedGuards=1;@(Compile.PreprocessorDefines)"
	{
		!!MalterlibMemoryManager_Debug_EnableFreedGuards true
	}
	PreprocessorDefines "DMibConfig_MalterlibMemoryManager_Debug_EnableFreedGuards=0;@(Compile.PreprocessorDefines)"
	{
		!MalterlibMemoryManager_Debug_EnableFreedGuards true
	}

	PreprocessorDefines "DMibConfig_MalterlibMemoryManager_Debug_EnableAllocatedFill=1;@(Compile.PreprocessorDefines)"
	{
		!!MalterlibMemoryManager_Debug_EnableAllocatedFill true
	}
	PreprocessorDefines "DMibConfig_MalterlibMemoryManager_Debug_EnableAllocatedFill=0;@(Compile.PreprocessorDefines)"
	{
		!MalterlibMemoryManager_Debug_EnableAllocatedFill true
	}

	PreprocessorDefines "DMibConfig_MalterlibMemoryManager_Debug_EnableEdgeGuards=1;@(Compile.PreprocessorDefines)"
	{
		!!MalterlibMemoryManager_Debug_EnableEdgeGuards true
	}
	PreprocessorDefines "DMibConfig_MalterlibMemoryManager_Debug_EnableEdgeGuards=0;@(Compile.PreprocessorDefines)"
	{
		!MalterlibMemoryManager_Debug_EnableEdgeGuards true
	}
	PreprocessorDefines "DMibConfig_MemoryManager_Stats_Enable=1;@(Compile.PreprocessorDefines)"
	{
		&
		{
			MalterlibMemoryManager_Stats_Enable true
			MalterlibMemory_Shims_Enable true
		}
	}
	PreprocessorDefines "DMibConfig_MemoryManager_Stats_Enable=0;@(Compile.PreprocessorDefines)"
	{
		&
		{
			!MalterlibMemoryManager_Stats_Enable true
			MalterlibMemory_Shims_Enable true
		}
	}
	PreprocessorDefines "DMibConfig_MemoryManager_CrossModule_Enable=1;@(Compile.PreprocessorDefines)"
	{
		&
		{
			MalterlibMemoryManager_CrossModule_Enable true
		}
	}
	PreprocessorDefines "DMibConfig_MemoryManager_CrossModule_Enable=0;@(Compile.PreprocessorDefines)"
	{
		&
		{
			!MalterlibMemoryManager_CrossModule_Enable true
		}
	}
	PreprocessorDefines "DMibConfig_MemoryManager_HugePage_Enable=1;@(Compile.PreprocessorDefines)"
	{
		&
		{
			MalterlibMemoryManager_HugePage_Enable true
		}
	}
	PreprocessorDefines "DMibConfig_MemoryManager_HugePage_Enable=0;@(Compile.PreprocessorDefines)"
	{
		&
		{
			!MalterlibMemoryManager_HugePage_Enable true
		}
	}
}

%Dependency "Lib_mimalloc-static"
{
	!!MalterlibMemoryManager "MiMalloc"

	Dependency.Indirect true
}

%Group "Source"
{
	%File "Source/Platform/Malterlib_Core_PlatformImp_DisableStackTraceUnit.cpp"
	%Group "Memory"
	{
		%Group "Memory"
		{
			Property.RealConfiguration "Release"
			{
				!!MalterlibMemoryManager_AlwaysRelease true
			}
			Property.RealConfiguration "@(MalterlibMemoryManager_AlwaysRelease)"
			{
				&
				{
					!MalterlibMemoryManager_AlwaysRelease ""
					!MalterlibMemoryManager_AlwaysRelease false
					!MalterlibMemoryManager_AlwaysRelease true
				}
			}
			Compile.FullEval true
			{
				!RealConfiguration "@(Configuration)"
			}

			// Which heap to use
			Compile
			{
				!!CompileDialect "C"
				PreprocessorDefines "DMibConfig_MemoryManager_Use@(MalterlibMemoryManager);@(Compile.PreprocessorDefines)"
			}

			%File "../Memory/Source/Malterlib_Memory_SystemManager*"
			%Group "No stack guard"
			{
				Compile.StackGuard false
				{
					!!PlatformFamily "OSX"
				}
				%File "../Memory/Source/Malterlib_Memory_SystemOverride*"
				%File "../Memory/Source/Malterlib_Memory_SystemOverride_OSX.cpp"
				{
					Compile.Disabled true
					{
						!PlatformFamily "OSX"
					}
				}
				%File "../Memory/Source/Malterlib_Memory_SystemOverride_OSXLowLevel.cpp"
				{
					Compile.Disabled true
					{
						!PlatformFamily "OSX"
					}
				}
				%File "../Memory/Source/Malterlib_Memory_SystemOverride_Linux.cpp"
				{
					Compile.Disabled true
					{
						!PlatformFamily "Linux"
					}
				}
				%File "../Memory/Source/Malterlib_Memory_SystemOverride_Windows.cpp"
				{
					Compile.Disabled true
					{
						!PlatformFamily "Windows"
					}
				}
				%File "../Memory/Source/Malterlib_Memory_SystemOverride_OSXLibSystem.cpp"
				{
					Compile.Disabled true
				}
				%File "../Memory/Source/Malterlib_Memory_SystemOverride_OSXDyldDummy.cpp"
				{
					Compile.Disabled true
				}
			}

			%File "../Memory/Source/Malterlib_Memory.cpp"
		}
		%File "../Memory/Source/Malterlib_Memory_Allocator_Heap.cpp"
		{
			Compile.PreprocessorDefines "DMibNoInlineNew;@(Compile.PreprocessorDefines)"
			{
				!!CompileDialect "C"
			}
		}
	}
	%Group "Runtime"
	{
		%Group "Runtimes"
		{
			%Group "MSVC"
			{
				%Group "Included"
				{
					%File "Source/Platform/Malterlib_Core_PlatformImp_MSVC_CPUUsageMonitor.*"
					%File "Source/Platform/Malterlib_Core_PlatformImp_MSVC_LocalSys.cpp"
					%File "Source/Platform/Malterlib_Core_PlatformImp_MSVC_NTSpecific.cpp"
					%File "Source/Platform/Malterlib_Core_PlatformImp_MSVC_Net.cpp"
					%File "Source/Platform/Malterlib_Core_PlatformImp_MSVC_Net.h"
					Compile.Disabled true
				}

				%File "Source/Platform/Malterlib_Core_PlatformImp_MSVC.cpp" // Uses Malterlib heap enablement
				%File "Source/Platform/Malterlib_Core_PlatformImp_MSVC_StructuredException.cpp"
				{
					Compile
					{
						Exceptions "Full"
					}
				}
				%File "Source/Platform/Malterlib_Core_PlatformImp_Windows_Inline.h"
				%File "Source/Platform/Malterlib_Core_PlatformImp_MSVC_WindowsDefines.h"
				%File "Source/Platform/Malterlib_Core_PlatformImp_MSVC_x86_64.asm"
				{
					Compile.Disabled true
					{
						!Architecture "x64"
					}
				}
				Compile.Disabled true
				{
					!PlatformType "Windows"
				}
			}
			%Group "MacOSX"
			{
				%File "Source/Platform/Malterlib_Core_PlatformImp_MacOSX*"
				{
					Compile.Disabled true
				}
				%File "Source/Platform/Malterlib_Core_PlatformImp_MacOSX.cpp"
				{
					Compile.Disabled true
					{
						!PlatformFamily "OSX"
					}
				}
				%File "Source/Platform/Malterlib_Core_PlatformImp_MacOSX_ObjCPP.mm"
				{
					Compile.Disabled true
					{
						!!Documentation "Doxygen"
						!PlatformFamily "OSX"
					}
				}
			}
			%Group "POSIX"
			{
				Compile.Disabled true
				%File "Source/Platform/Malterlib_Core_PlatformImp_POSIX*"
			}
			%Group "Emscripten"
			{
				Compile.Disabled true
				{
					!PlatformFamily "Emscripten"
				}
				%File "Source/Platform/Malterlib_Core_PlatformImp_Emscripten*"
			}
			%Group "Linux"
			{
				%File "Source/Platform/Malterlib_Core_PlatformImp_Linux*"
				{
					Compile.Disabled true
				}
				%File "Source/Platform/Malterlib_Core_PlatformImp_Linux*.cpp"
				{
					Compile.Disabled true
					{
						!PlatformFamily "Linux"
					}
				}
				%File "Source/Platform/Malterlib_Core_PlatformImp_Linux_Breakpad.cpp"
				{
					Compile.Disabled true
				}
			}
		}
		%File "Source/Malterlib_Core_PlatformInterfaceTemp.h"
		%File "Source/Malterlib_Core_PlatformInterface.h"
		%Group "Private"
		{
			Compile.Disabled true
			%File "Source/Platform/Malterlib_Core_PlatformImp.imp.h"
			%File "Source/Platform/Malterlib_Core_PlatformImp.h"
			%File "Source/Platform/Malterlib_Core_PlatformImp_Integration.h"
		}
	}
}
