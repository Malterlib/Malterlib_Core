Target.ExtraGroups "{Malterlib}/{TCMalloc}"
{
	!!MalterlibMemoryManager "TcMalloc"
}

Compile
{
	!!CompileDialect "C"
	SearchPath += [`@(GeneratedWorkspaceDirectory)elftoolchain`, `@(Builtin.BasePathAbsolute)/External/elftoolchain/libelf`, `@(Builtin.BasePathAbsolute)/External/elftoolchain/common`]
	{
		!!PlatformFamily "Linux"
	}
	SearchPath += `@(Builtin.BasePathAbsolute)/External/elftoolchain/libdwarf`
	{
		!!PlatformFamily "Linux"
	}
	SearchPath += [`@(MalterlibSysRoot)/usr/include/glib-2.0`, `@(MalterlibSysRoot)/usr/lib/@(MalterlibNativeClangArchitecture)-linux-gnu/glib-2.0/include`]
	{
		!!PlatformFamily "Linux"
	}
	SearchPath += [`@(MalterlibSysRoot)/usr/include/dbus-1.0`, `@(MalterlibSysRoot)/usr/lib/@(MalterlibNativeClangArchitecture)-linux-gnu/dbus-1.0/include`]
	{
		!!PlatformFamily "Linux"
	}
	SearchPath += `@(MalterlibSysRoot)/usr/include/libsecret-1`
	{
		!!PlatformFamily "Linux"
	}

	SearchPath += "../../External/mimalloc/include"->MakeAbsolute()
	{
		!!MalterlibMemoryManager "MiMalloc"
	}

	PreprocessorDefines =+ "DMibDynamicLibrary"
	{
		!!MalterlibDynamicLibrary true
	}

	PreprocessorDefines =+ "DMibConfig_OverrideSystemMalloc"
	{
		!!MalterlibMemoryManager_EnableOverrideSystemMalloc true
	}
	PreprocessorDefines =+ "DMalterlibMemoryOverrideOSXInitBeforeLibSystemSupport"
	{
		!!MalterlibMemoryManager_OverrideSystemMallocInitBeforeLibSystem true
	}

	PreprocessorDefines =+ "DMibConfig_CheckOverrideMemoryLeaks"
	{
		!!MalterlibMemoryManager_CheckOverrideMemoryLeaks true
	}

	// We don't destroy the heap unless we are in debug mode, this speeds up system exit
	PreprocessorDefines =+ "DMibConfig_HeapNeverDestroyed"
	{
		|
		{
			MalterlibMemoryManager_Debug false	// Specifically disabled
			!DebugCode true				// Implicitly disabled
		}
	}

	PreprocessorDefines =+ `DMibConfig_MalterlibMemoryManager_AlwaysRelease=@(MalterlibMemoryManager_AlwaysRelease ? "1" : "0")`

	// Debug options

	PreprocessorDefines =+ `DMibConfig_MalterlibMemoryManager_Debug_Features=@(MalterlibMemoryManager_Debug_Features ? "1" : "0")`
	{
		!MalterlibMemoryManager_Debug_Features undefined
	}
	PreprocessorDefines =+ "DMibConfig_MalterlibMemoryManager_Debug_Features=2"
	{
		!!MalterlibMemoryManager_Debug_Features undefined
	}

	PreprocessorDefines =+ `DMibConfig_MalterlibMemoryManager_Debug_EnableStackTrace=@(MalterlibMemoryManager_Debug_EnableStackTrace ? "1" : "0")`
	PreprocessorDefines =+ `DMibConfig_MalterlibMemoryManager_Debug_EnableFreeValidation=@(MalterlibMemoryManager_Debug_EnableFreeValidation ? "1" : "0")`
	PreprocessorDefines =+ `DMibConfig_MalterlibMemoryManager_Debug_EnableMemoryLeaks=@(MalterlibMemoryManager_Debug_EnableMemoryLeaks ? "1" : "0")`
	PreprocessorDefines =+ `DMibConfig_MalterlibMemoryManager_Debug_EnableFreedGuards=@(MalterlibMemoryManager_Debug_EnableFreedGuards ? "1" : "0")`
	PreprocessorDefines =+ `DMibConfig_MalterlibMemoryManager_Debug_EnableAllocatedFill=@(MalterlibMemoryManager_Debug_EnableAllocatedFill ? "1" : "0")`
	PreprocessorDefines =+ `DMibConfig_MalterlibMemoryManager_Debug_EnableEdgeGuards=@(MalterlibMemoryManager_Debug_EnableEdgeGuards ? "1" : "0")`
	PreprocessorDefines =+ `DMibConfig_MemoryManager_CrossModule_Enable=@(MalterlibMemoryManager_CrossModule_Enable ? "1" : "0")`
	PreprocessorDefines =+ `DMibConfig_MemoryManager_HugePage_Enable=@(MalterlibMemoryManager_HugePage_Enable ? "1" : "0")`
	PreprocessorDefines =+ `DMibConfig_MemoryManager_System_UseLibC=@(MalterlibMemoryManager_System_UseLibC ? "1" : "0")`
	PreprocessorDefines =+ `DMibConfig_MalterlibMemoryManager_NeedDualPageSize=1`
	{
		&
		{
			PlatformFamily "OSX"
			MalterlibMemoryManager "Malterlib"
		}
	}
	PreprocessorDefines =+ `DMibConfig_MalterlibMemoryManager_NeedDualPageSize=0`
	{
		!
		{
			&
			{
				PlatformFamily "OSX"
				MalterlibMemoryManager "Malterlib"
			}
		}
	}
}

%Dependency "Lib_libmimalloc_mimalloc-static"
{
	!!MalterlibMemoryManager "MiMalloc"

	Dependency.Indirect true
}

%Group "Source"
{
	%File "Source/Platform/Malterlib_Core_PlatformImp_DisableStackTraceUnit.cpp"
	%Group "Memory"
	{
		%Group "Memory"
		{
			Property.RealConfiguration "Release"
			{
				!!MalterlibMemoryManager_AlwaysRelease true
			}
			Compile.FullEval true
			{
				!RealConfiguration Configuration
			}

			// Which heap to use
			Compile
			{
				!!CompileDialect "C"
				PreprocessorDefines =+ `DMibConfig_MemoryManager_Use@(MalterlibMemoryManager)`
			}

			%File "../Memory/Source/Malterlib_Memory_SystemManager*"
			%Group "No stack guard"
			{
				Compile.StackGuard false
				{
					!!PlatformFamily "OSX"
				}
				%File "../Memory/Source/Malterlib_Memory_SystemOverride*"
				%File "../Memory/Source/Malterlib_Memory_SystemOverride_OSX.cpp"
				{
					Compile.Disabled true
					{
						!PlatformFamily "OSX"
					}
				}
				%File "../Memory/Source/Malterlib_Memory_SystemOverride_OSXLowLevel.cpp"
				{
					Compile.Disabled true
					{
						!PlatformFamily "OSX"
					}
				}
				%File "../Memory/Source/Malterlib_Memory_SystemOverride_Linux.cpp"
				{
					Compile.Disabled true
					{
						!PlatformFamily "Linux"
					}
				}
				%File "../Memory/Source/Malterlib_Memory_SystemOverride_Windows.cpp"
				{
					Compile.Disabled true
					{
						!PlatformFamily "Windows"
					}
				}
				%File "../Memory/Source/Malterlib_Memory_SystemOverride_OSXLibSystem.cpp"
				{
					Compile.Disabled true
				}
				%File "../Memory/Source/Malterlib_Memory_SystemOverride_OSXDyldDummy.cpp"
				{
					Compile.Disabled true
				}
			}

			%File "../Memory/Source/Malterlib_Memory.cpp"
		}
		%File "../Memory/Source/Malterlib_Memory_Allocator_Heap.cpp"
		{
			Compile.PreprocessorDefines =+ "DMibNoInlineNew"
			{
				!!CompileDialect "C"
			}
		}
	}
	%Group "Runtime"
	{
		%Group "Runtimes"
		{
			%Group "MSVC"
			{
				%Group "Included"
				{
					%File "Source/Platform/Malterlib_Core_PlatformImp_MSVC_CPUUsageMonitor.*"
					%File "Source/Platform/Malterlib_Core_PlatformImp_MSVC_LocalSys.cpp"
					%File "Source/Platform/Malterlib_Core_PlatformImp_MSVC_NTSpecific.cpp"
					%File "Source/Platform/Malterlib_Core_PlatformImp_MSVC_Net.cpp"
					%File "Source/Platform/Malterlib_Core_PlatformImp_MSVC_Net.h"
					Compile.Disabled true
				}

				%File "Source/Platform/Malterlib_Core_PlatformImp_MSVC.cpp" // Uses Malterlib heap enablement
				%File "Source/Platform/Malterlib_Core_PlatformImp_MSVC_StructuredException.cpp"
				{
					Compile
					{
						Exceptions "Full"
					}
				}
				%File "Source/Platform/Malterlib_Core_PlatformImp_Windows_Inline.h"
				%File "Source/Platform/Malterlib_Core_PlatformImp_MSVC_WindowsDefines.h"
				%File "Source/Platform/Malterlib_Core_PlatformImp_MSVC_x86_64.asm"
				{
					Compile.Disabled true
					{
						!Architecture "x64"
					}
				}
				Compile.Disabled true
				{
					!PlatformType "Windows"
				}
			}
			%Group "MacOSX"
			{
				%File "Source/Platform/Malterlib_Core_PlatformImp_MacOSX*"
				{
					Compile.Disabled true
				}
				%File "Source/Platform/Malterlib_Core_PlatformImp_MacOSX.cpp"
				{
					Compile.Disabled true
					{
						!PlatformFamily "OSX"
					}
				}
				%File "Source/Platform/Malterlib_Core_PlatformImp_MacOSX_ObjCPP.mm"
				{
					Compile.Disabled true
					{
						!!Documentation "Doxygen"
						!PlatformFamily "OSX"
					}
				}
			}
			%Group "POSIX"
			{
				Compile.Disabled true
				%File "Source/Platform/Malterlib_Core_PlatformImp_POSIX*"
			}
			%Group "Emscripten"
			{
				Compile.Disabled true
				{
					!PlatformFamily "Emscripten"
				}
				%File "Source/Platform/Malterlib_Core_PlatformImp_Emscripten*"
			}
			%Group "Linux"
			{
				%File "Source/Platform/Malterlib_Core_PlatformImp_Linux*"
				{
					Compile.Disabled true
				}
				%File "Source/Platform/Malterlib_Core_PlatformImp_Linux*.cpp"
				{
					Compile.Disabled true
					{
						!PlatformFamily "Linux"
					}
				}
				%File "Source/Platform/Malterlib_Core_PlatformImp_Linux_Breakpad.cpp"
				{
					Compile.Disabled true
				}
			}
		}
		%File "Source/Malterlib_Core_PlatformInterfaceTemp.h"
		%File "Source/Malterlib_Core_PlatformInterface.h"
		%Group "Private"
		{
			Compile.Disabled true
			%File "Source/Platform/Malterlib_Core_PlatformImp.imp.h"
			%File "Source/Platform/Malterlib_Core_PlatformImp.h"
			%File "Source/Platform/Malterlib_Core_PlatformImp_Integration.h"
		}
	}
}
