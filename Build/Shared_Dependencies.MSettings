Property.MalterlibBuildDependenciesContents	"@(MalterlibBuildDependenciesContents)"\
			"@('BuildLLVM.sh'->MakeAbsolute()) \"@(MalterlibClangVersion)\" \"@(MalterlibDependenciesDirectory)/llvm/@(MalterlibClangVersion)\" \"@(MalterlibMainMalterlibRepo)\" false\r\n"\
			"ErrorLevel=$?\n"\
			"if [ \"$ErrorLevel\" != \"0\" ]; then\n"\
			"  echo error: Failed to update LLVM dependencies\n"\
			"  exit 1\n"\
			"fi\n"
{
	!!PlatformToolsetCompiler "@(MalterlibDependenciesDirectory)/llvm/@(MalterlibClangVersion)/build/main/bin/clang"
}

Property.MalterlibBuildDependenciesContents	"@(MalterlibBuildDependenciesContents)"\
			"@('BuildLLVM.sh'->MakeAbsolute()) \"@(MalterlibCustomToolchainClangVersion)\" \"@(MalterlibDependenciesDirectory)/llvm/@(MalterlibCustomToolchainClangVersion)\" \"@(MalterlibMainMalterlibRepo)\" true\r\n"\
			"ErrorLevel=$?\n"\
			"if [ \"$ErrorLevel\" != \"0\" ]; then\n"\
			"  echo error: Failed to update custom LLVM toolchain\n"\
			"  exit 1\n"\
			"fi\n"
{
	&
	{
		MalterlibUseCustomXcodeToolchain true
		PlatformToolsetCompiler "@(MalterlibDependenciesDirectory)/llvm/@(MalterlibClangVersion)/build/main/bin/clang"
	}
}
