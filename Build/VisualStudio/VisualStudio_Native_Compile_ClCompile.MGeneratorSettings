GeneratorSetting
{
	&
	{
		Target.Language "Native"
		GeneratorSetting.VisualStudio_FileType "ClCompile"
	}

	Compile_ConcurrentCompile =+ {
		VSSettings: {
			MultiProcessorCompilation: Compile.ConcurrentCompile->f_BoolToString()
		}
	}

	Compile_ForceSynchronousPDBWrites =+ {
		VSSettings: {
			ForceSynchronousPDBWrites: Compile.ForceSynchronousPDBWrites->f_BoolToString()
		}
	}

	Compile_Symbols =+ {
		VSSettings: {
			DebugInformationFormat: Compile.Symbols->SwitchWithError("Unsupported option: "
				, "FullForDebug", "EditAndContinue"
				, "Full", "ProgramDatabase"
				, "Fast", "OldStyle"
				, "None", "None"
				, "", ""
			)
		}
	}

	Compile_CallingConvention =+ {
		VSSettings: {
			CallingConvention: Compile.CallingConvention->SwitchWithError("Unsupported option: "
				, "Cdecl", "Cdecl"
				, "StdCall", "StdCall"
				, "FastCall", "FastCall"
			)
		}
	}

	Compile_SymbolFile =+ {
		VSSettings: {
			ProgramDataBaseFileName: Compile.SymbolFile->EscapeMSBuild()
		}
	}

	Compile_MaxHeap =+ {
		VSSettings: {
			AdditionalOptions: `-Zm@(Compile.MaxHeap->ToString()) @(Builtin.Inherit)`
		}
	}

	Compile_LinkerInternalLinkageOpt =+ {
		VSSettings: {
			AdditionalOptions: `-Zc:@(Compile.LinkerInternalLinkageOpt->ToString()) @(Builtin.Inherit)`
		}
	}

	Compile_ExtraCompilerFlags =+ {
		VSSettings: {
			AdditionalOptions: `@(Compile.ExtraCompilerFlags->f_ExpandFlags()->f_JoinMSBuild(" ")) @(Builtin.Inherit)`
		}
	}

	Compile_PreprocessorDefines =+ {
		VSSettings: {
			PreprocessorDefinitions: Compile.PreprocessorDefines->f_JoinMSBuild()
		}
	}

	Compile_SearchPath =+ {
		VSSettings: {
			AdditionalIncludeDirectories: [Compile.SearchPath..., Compile.SystemSearchPath...]->RemoveDuplicates(Builtin.Inherit)->ForEach(&f_Helper_ShortenAllPaths)->f_JoinMSBuild()
		}
	}

	Compile_SystemSearchPath {}

	Compile_Warnings =+ {
		VSSettings: {
			WarningLevel: Compile.Warnings->SwitchWithError("Unsupported option: "
				, "Off", "TurnOffAllWarnings"
				, "Minimal", "Level1"
				, "On", "Level3"
				, "Pedantic", "Level4"
			)
		}
	}

	Compile_WarningsAsErrors =+ {
		VSSettings: {
			TreatWarningAsError: Compile.WarningsAsErrors->f_BoolToString()
		}
	}

	Compile_IgnoreStandardIncludePath =+ {
		VSSettings: {
			IgnoreStandardIncludePath: Compile.IgnoreStandardIncludePath->f_BoolToString()
		}
	}

	Compile_SeparateWCharType =+ {
		VSSettings: {
			TreatWChar_tAsBuiltInType: Compile.SeparateWCharType->f_BoolToString()
		}
	}

	Compile_ForceConformanceInForLoopScope =+ {
		VSSettings: {
			ForceConformanceInForLoopScope: Compile.ForceConformanceInForLoopScope->f_BoolToString()
		}
	}

	Compile_DynamicTypeInfo =+ {
		VSSettings: {
			RuntimeTypeInfo: Compile.DynamicTypeInfo->f_BoolToString()
		}
	}

	Compile_OpenMP =+ {
		VSSettings: {
			OpenMPSupport: Compile.OpenMP->f_BoolToString()
		}
	}

	Compile_UseFullPaths =+ {
		VSSettings: {
			UseFullPaths: Compile.UseFullPaths->f_BoolToString()
		}
	}

	Compile_FunctionLevelLinking =+ {
		VSSettings: {
			FunctionLevelLinking: Compile.FunctionLevelLinking->f_BoolToString()
		}
	}

	Compile_StringPooling =+ {
		VSSettings: {
			StringPooling: Compile.StringPooling->f_BoolToString()
		}
	}

	Compile_CreateHotpatchableImage =+ {
		VSSettings: {
			CreateHotpatchableImage: Compile.CreateHotpatchableImage->f_BoolToString()
		}
	}

	Compile_EnableFiberSafeOptimizations =+ {
		VSSettings: {
			EnableFiberSafeOptimizations: Compile.EnableFiberSafeOptimizations->f_BoolToString()
		}
	}

	Compile_FloatingPointExceptions =+ {
		VSSettings: {
			FloatingPointExceptions: Compile.FloatingPointExceptions->f_BoolToString()
		}
	}

	Compile_FloatingPointModel =+ {
		VSSettings: {
			FloatingPointModel: Compile.FloatingPointModel->SwitchWithError("Unsupported option: "
				, "Precise", "Precise"
				, "Strict", "Strict"
			)
		}
	}

	Compile_EnableLanguageExtensions =+ {
		VSSettings: {
			DisableLanguageExtensions: (!Compile.EnableLanguageExtensions)->f_BoolToString()
		}
	}

	Compile_MinimalRebuild =+ {
		VSSettings: {
			MinimalRebuild: Compile.MinimalRebuild->f_BoolToString()
		}
	}

	Compile_ExtendedInstructionSet =+ {
		VSSettings: {
			EnableEnhancedInstructionSet: Compile.ExtendedInstructionSet->SwitchWithError("Unsupported option: "
				, "Off", "NoExtensions"
				, "SSE1", "StreamingSIMDExtensions"
				, "SSE2", "StreamingSIMDExtensions2"
				, "SSE3", "StreamingSIMDExtensions2"
				, "AVX", "AdvancedVectorExtensions"
				, "AVX2", "AdvancedVectorExtensions2"
			)
		}
	}

	Compile_RuntimeLibrary =+ {
		VSSettings: {
			RuntimeLibrary: Compile.RuntimeLibrary->SwitchWithError("Unsupported option: "
				, "Static", "MultiThreaded"
				, "StaticDebug", "MultiThreadedDebug"
				, "Dynamic", "MultiThreadedDLL"
				, "DynamicDebug", "MultiThreadedDebugDLL"
			)
		}
	}

	Compile_StructMemberAlignment =+ {
		VSSettings: {
			StructMemberAlignment: Compile.StructMemberAlignment->SwitchWithError("Unsupported option: "
				, "Default", "Default"
				, "1", "1Byte"
				, "2", "2Bytes"
				, "4", "4Bytes"
				, "8", "8Bytes"
				, "16", "16Bytes"
			)
		}
	}

	Compile_PrefixHeader =+ {
		VSSettings: {
			ForcedIncludeFiles: Compile.PrefixHeader->WindowsPath()->EscapeMSBuild()
			, PrecompiledHeaderFile: Compile.PrefixHeader->WindowsPath()->EscapeMSBuild()
		}
	}

	Compile_Exceptions =+ {
		VSSettings: {
			ExceptionHandling: Compile.Exceptions->SwitchWithError("Unsupported option: "
				, "Full", "Async"
				, "C++", "Sync"
				, "ExternCandC++", "SyncCThrow"
				, "Off", "false"
			)
		}
	}

	Compile_PrecompilePrefixHeader =+ {
		VSSettings: {
			PrecompiledHeader: Compile.PrecompilePrefixHeader->SwitchWithError("Unsupported option: "
				, true, "Use"
				, false, "NotUsing"
				, "XInternalCreate", "Create"
			)
		}
	}

	Compile_XInternalPrecompiledHeaderOutputFile =+ {
		VSSettings: {
			PrecompiledHeaderOutputFile: Compile.XInternalPrecompiledHeaderOutputFile->EscapeMSBuild()
		}
	}

	Compile_LinkTimeCodeGeneration =+ {
		VSSettings: {
			WholeProgramOptimization: Compile.LinkTimeCodeGeneration->f_BoolToString()
		}
	}

	Compile_Optimize =+ {
		VSSettings: Compile.Optimize->SwitchWithError("Unsupported option: "
			, "Off", {
				Optimization: "Disabled"
				, IntrinsicFunctions: "false"
				, OmitFramePointers: "false"
				, FavorSizeOrSpeed: "Neither"
			}, "On", {
				Optimization: "Full"
				, IntrinsicFunctions: "true"
				, OmitFramePointers: "false"
				, FavorSizeOrSpeed: "Speed"
			}, "Fast", {
				Optimization: "Full"
				, IntrinsicFunctions: "true"
				, OmitFramePointers: "false"
				, FavorSizeOrSpeed: "Speed"
			}, "Full", {
				Optimization: "Full"
				, IntrinsicFunctions: "true"
				, OmitFramePointers: "true"
				, FavorSizeOrSpeed: "Speed"
			}
		)
	}

	Compile_RuntimeChecks =+ {
		VSSettings: Compile.RuntimeChecks->SwitchWithError("Unsupported option: "
			, "Off", {
				BasicRuntimeChecks: "Default"
				, SmallerTypeCheck: "false"
				, BufferSecurityCheck: "false"
			}, "Fast", {
				BasicRuntimeChecks: "Default"
				, SmallerTypeCheck: "false"
				, BufferSecurityCheck: "true"
			}, "On", {
				BasicRuntimeChecks: "EnableFastChecks"
				, SmallerTypeCheck: "false"
				, BufferSecurityCheck: "true"
			}, "Full", {
				BasicRuntimeChecks: "EnableFastChecks"
				, SmallerTypeCheck: "true"
				, BufferSecurityCheck: "true"
			}
		)
	}

	Compile_Inline =+ {
		VSSettings: {
			InlineFunctionExpansion: Compile.Inline->SwitchWithError("Unsupported option: "
				, "Off", "Disabled"
				, "Explicit", "OnlyExplicitInline"
				, "Automatic", "AnySuitable"
			)
		}
	}

	Compile_DisableSecurityWarnings {}

	f_Helper_SetVSWarning function(string _Warning, bool _Enable) type(CCompileSettings)

	f_Helper_SetVSWarning =+ {
		VSSettings: {
			AdditionalOptions: `/@(_Enable ? "w1" : "wd")@(_Warning) @(Builtin.Inherit)`
		}
	}

	f_Helper_SetVSWarning =+ {
		Flags: `/@(_Enable ? "w1" : "wd")@(_Warning)`
	}
	{
		!!Compiler "MSVC"
	}

	Compile_Warnings_DeprecatedDeclarations =+ GeneratorSetting.f_Helper_SetVSWarning("4996", Compile.Warnings_DeprecatedDeclarations)
	Compile_Warnings_ConversionToSmallerInt =+ GeneratorSetting.f_Helper_SetVSWarning("4244", Compile.Warnings_ConversionToSmallerInt)
	Compile_Warnings_ConversionToSmallerType =+ GeneratorSetting.f_Helper_SetVSWarning("4267", Compile.Warnings_ConversionToSmallerType)
	Compile_Warnings_IncompatibleTypes =+ GeneratorSetting.f_Helper_SetVSWarning("4133", Compile.Warnings_IncompatibleTypes)
	Compile_Warnings_UnknownPragma =+ GeneratorSetting.f_Helper_SetVSWarning("4068", Compile.Warnings_UnknownPragma)
	Compile_Warnings_ASANWithoutDebugInfo =+ GeneratorSetting.f_Helper_SetVSWarning("5072", Compile.Warnings_ASANWithoutDebugInfo)
}
