	f_Helper_SetVSWarning function(string _Warning, string _ClangWarning, bool _Enable) type(CCompileSettings)

	f_Helper_SetVSWarning =+ {
		VSSettings: {
			AdditionalOptions: `/@(_Enable ? "w1" : "wd")@(_Warning) @(Builtin.Inherit)`
		}
	}
	{
		&
		{
			Compiler "MSVC"
			!_Warning ""
		}
	}

	f_Helper_SetVSWarning =+ {
		Flags: `/@(_Enable ? "w1" : "wd")@(_Warning)`
	}
	{
		&
		{
			Compiler "MSVC"
			!_Warning ""
		}
	}

	f_Helper_SetVSWarning =+ {
		VSSettings: {
			AdditionalOptions: `@(_Enable ? "-W" : "-Wno-")@(_ClangWarning) @(Builtin.Inherit)`
		}
	}
	{
		&
		{
			Compiler "Clang"
			!_ClangWarning ""
		}
	}

	f_Helper_SetVSWarning =+ {
		Flags: `@(_Enable ? "-W" : "-Wno-")@(_ClangWarning)`
	}
	{
		&
		{
