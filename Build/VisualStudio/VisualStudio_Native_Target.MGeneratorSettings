	f_ExtractLibraryDependencies function(string _ExternalDependency) [string] = []
	f_ExtractLibraryDependencies =+ (&Dependency.Name->GetProperty(_ExternalDependency))
	{
		&
		{
			|
			{
				TargetIsExecutable true
				!(&Dependency.Indirect->GetProperty(_ExternalDependency)) true
			}
			(&Dependency.Type->GetProperty(_ExternalDependency)) "Library"
		}
	}

	ExtractLibraryDependencies: [string] = []
	ExtractLibraryDependencies Target.ExternalDependencies->ForEach(&GeneratorSetting.f_ExtractLibraryDependencies)->Unique()

