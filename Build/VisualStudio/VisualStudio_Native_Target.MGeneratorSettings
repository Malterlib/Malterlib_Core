	Target_LinkTimeCodeGeneration =+ {
		VSSettings: [
			{
				Type: "ItemDefinitionGroup"
				, Name: "Link"
				, Key: "LinkTimeCodeGeneration"
				, Value: Target.LinkTimeCodeGeneration->SwitchWithError(
					"Unsupported option: "
					, true, "UseLinkTimeCodeGeneration"
					, false, "Default"
					, "Fast", "UseFastLinkTimeCodeGeneration"
				)
			}, {
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "WholeProgramOptimization"
				, Value: Target.LinkTimeCodeGeneration->SwitchWithError(
					"Unsupported option: "
					, true, "true"
					, "Fast", "true"
					, false, "false"
					, "", "false"
				)
			}
