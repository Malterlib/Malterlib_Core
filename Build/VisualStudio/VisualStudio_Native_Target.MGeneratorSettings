%GeneratorSetting "Native_SharedTarget"
{
	%GeneratorSetting "Target"
	{
		// Handled elsewhere
		%GeneratorSetting "PlatformVersion"
		{
			Property
			{
				Disabled "1"
			}
		}
		%GeneratorSetting "PlatformToolset"
		{
			Property
			{
				Disabled "1"
			}
		}
		%GeneratorSetting "ClCompileSuffix"
		{
			Property
			{
				Disabled "1"
			}
		}
		%GeneratorSetting "IgnoreWarnCompileDuplicatedFilename"
		{
			Property
			{
				Disabled "1"
			}
		}		
		%GeneratorSetting "CharacterSet"
		{
			Property
			{
				Disabled "1"
			}
		}
		%GeneratorSetting "UseOfMfc"
		{
			Property
			{
				Disabled "1"
			}
		}
		%GeneratorSetting "UseOfAtl"
		{
			Property
			{
				Disabled "1"
			}
		}
		%GeneratorSetting "LinkTimeCodeGeneration"
		{
			Property
			{
				Entity "Link"
				Name LinkTimeCodeGeneration
			}
			%GeneratorSetting "Value"
			{
				Property
				{
					true UseLinkTimeCodeGeneration
					Fast UseFastLinkTimeCodeGeneration
					false Default
				}
			}
		}
		%GeneratorSetting "DefaultToolArchitecture"
		{
			Property
			{
				Disabled "1"
			}
		}
		%GeneratorSetting "CLRSupport"
		{
			Property
			{
				Disabled 1
			}
		}

		// Basics

		%GeneratorSetting "PlatformToolsetCompiler"
		{
			Property
			{
				Parent "PropertyGroup"
				Name "GccCompiler"
				ConvertPath true
			}
		}

		%GeneratorSetting "FileExtension"
		{
			Property
			{
				Parent "PropertyGroup"
				Name "TargetExt"
			}
		}
		%GeneratorSetting "FileName"
		{
			Property
			{
				Parent "PropertyGroup"
				Name "TargetName"
			}
		}
		%GeneratorSetting "ToolPath"
		{
			Property
			{
				Parent "PropertyGroup"
				Name "ExecutablePath"
				ConvertPath true
			}
		}
		%GeneratorSetting "PostBuildScript"
		{
			Property
			{
				Entity "PostBuildEvent"
				Name "Command"
			}
		}


		%GeneratorSetting "PreBuildScript"
		{
			Property
			{
				Entity "PreBuildEvent"
				Name "Command"
			}
		}

		%GeneratorSetting "DebuggerCommandArguments"
		{
			Property
			{
				Parent "PropertyGroup"
				Name LocalDebuggerCommandArguments
			}
			%GeneratorSetting "Properties"
			{
				%GeneratorSetting "PropertyGroup"
				{
					%GeneratorSetting ""
					{
						%GeneratorSetting "RemoteDebuggerCommandArguments"
					}
				}
			}
		}
		%GeneratorSetting "LocalDebuggerCommand"
		{
			Property
			{
				Parent "PropertyGroup"
				Name LocalDebuggerCommand
			}
		}
		%GeneratorSetting "RemoteDebuggerCommand"
		{
			Property
			{
				Parent "PropertyGroup"
				Name RemoteDebuggerCommand
			}
		}
		%GeneratorSetting "LocalDebuggerWorkingDirectory"
		{
			Property
			{
				Parent "PropertyGroup"
				Name LocalDebuggerWorkingDirectory
			}
		}
		%GeneratorSetting "RemoteDebuggerWorkingDirectory"
		{
			Property
			{
				Parent "PropertyGroup"
				Name RemoteDebuggerWorkingDirectory
			}
		}
	}
}
