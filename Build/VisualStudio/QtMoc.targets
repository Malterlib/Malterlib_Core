<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Condition="'$(UseDefaultPropertyPageSchemas)' != 'false'">
    <PropertyPageSchema Condition="'$(ConfigurationType)' != 'Utility'" Include="$(MalterlibBaseDir)Malterlib\Core\Build\VisualStudio\$(MSBuildThisFileName).xml"/>
  </ItemGroup>
  <UsingTask
     TaskName="MalterlibTool"
     AssemblyFile="MalterlibMSBuild.dll">
  </UsingTask>
  
  <ItemDefinitionGroup>
    <QtMoc>
      <LinkCompiled>$(LinkCompiled)</LinkCompiled>
      <LibCompiled>$(LibCompiled)</LibCompiled>
      <ImpLibCompiled>$(ImpLibCompiled)</ImpLibCompiled>
    </QtMoc>
    <QtUic>
      <LinkCompiled>$(LinkCompiled)</LinkCompiled>
      <LibCompiled>$(LibCompiled)</LibCompiled>
      <ImpLibCompiled>$(ImpLibCompiled)</ImpLibCompiled>
    </QtUic>
    <QtRcc>
      <LinkCompiled>$(LinkCompiled)</LinkCompiled>
      <LibCompiled>$(LibCompiled)</LibCompiled>
      <ImpLibCompiled>$(ImpLibCompiled)</ImpLibCompiled>
    </QtRcc>
  </ItemDefinitionGroup>

  <Target
    Name="QtMoc"
    BeforeTargets="$(QtMocBeforeTargets)"
    AfterTargets="$(QtMocAfterTargets)"
    Condition="'@(QtMoc)' != ''"
    DependsOnTargets="_SelectedFiles;ComputeQtMocGeneratedCompileInputs">
    <ItemGroup Condition="'@(SelectedFiles)' != ''">
      <QtMoc Remove="@(QtMoc)" Condition="'%(Identity)' != '@(SelectedFiles)'" />
    </ItemGroup>
    <ItemGroup>
      <QtMoc Condition="'@(QtMoc)' != ''">
        <MinimalRebuildFromTracking Condition="'$(BuildType)' != 'Build' or '$(ForceRebuild)' == 'true'">false</MinimalRebuildFromTracking>
        <AdditionalOptions0 Condition="'%(QtMoc.ObjectFileName)' != ''"> -o "%(QtMoc.ObjectFileName)"</AdditionalOptions0>
        <AdditionalOptions1 Condition="'%(QtMoc.PreprocessorDefinitions)' != ''"> -D "$([System.String]::Join('&quot; -D &quot;', $([System.String]::Copy('%(QtMoc.PreprocessorDefinitions)').Trim(';').Split(';'))))"</AdditionalOptions1>
        <AdditionalOptions2 Condition="'%(QtMoc.AdditionalIncludeDirectories)' != ''"> -I "$([System.String]::Join('&quot; -I &quot;', $([System.String]::Copy('%(QtMoc.AdditionalIncludeDirectories)').Trim(';').Split(';'))))"</AdditionalOptions2>
        <AdditionalOptions3 Condition="'%(QtMoc.PreprocessOnly)' == 'true'"> -E"</AdditionalOptions3>
        <AdditionalOptions4 Condition="'%(QtMoc.DoNotGenerateInclude)' == 'true'"> -i"</AdditionalOptions4>
        <AdditionalOptions5 Condition="'%(QtMoc.DoNotDisplayWarnings)' == 'true'"> -nw"</AdditionalOptions5>
        <AdditionalOptions6 Condition="'%(QtMoc.IncludePathPrefix)' != ''"> -p "%(QtMoc.IncludePathPrefix)"</AdditionalOptions6>
        <AdditionalOptions7 Condition="'%(QtMoc.PreprocessorUnDefinitions)' != ''"> -U "$([System.String]::Join('&quot; -U &quot;', $([System.String]::Copy('%(QtMoc.PreprocessorUnDefinitions)').Trim(';').Split(';'))))"</AdditionalOptions7>
      </QtMoc>
    </ItemGroup>
    <MalterlibTool
      Condition="'@(QtMoc)' != '' and '%(QtMoc.ExcludedFromBuild)' != 'true'"
      MinimalRebuildFromTracking="%(QtMoc.MinimalRebuildFromTracking)"
      TrackerLogDirectory="$(TLogLocation)"
      TrackFileAccess="$(TrackFileAccess)"
      ToolExecutableName="moc.exe"
      ToolArchitecture="Native64Bit"
      AdditionalOptions="%(QtMoc.AdditionalOptions)%(QtMoc.AdditionalOptions0)%(QtMoc.AdditionalOptions1)%(QtMoc.AdditionalOptions2)%(QtMoc.AdditionalOptions3)%(QtMoc.AdditionalOptions4)%(QtMoc.AdditionalOptions5)%(QtMoc.AdditionalOptions6)%(QtMoc.AdditionalOptions7)"
      Source="%(QtMoc.FullPath)"
      StandardOutputImportance="High"
      StandardErrorImportance="High"
      EchoOff="true"
      />
  </Target>

  <Target Name="ComputeQtMocGeneratedCompileInputs"
          DependsOnTargets="$(ComputeQtMocGeneratedCompileInputsDependsOn)"
          Outputs="%(QtMoc.OutputDirectory)">
    <ItemGroup Condition="'@(QtMoc)' != ''">
      <ClCompile Include="%(QtMoc.ObjectFileName)" Condition="'%(QtMoc.DoCompileAndLink)' == 'true' and '%(QtMoc.ExcludedFromBuild)' != 'true'" >
        <LinkCompiled   Condition="'%(QtMoc.LinkCompiled)'   == '' and '%(QtMoc.LinkCompiledInterface)'   != ''">%(QtMoc.LinkCompiledInterface)</LinkCompiled>
        <LibCompiled    Condition="'%(QtMoc.LibCompiled)'    == '' and '%(QtMoc.LibCompiledInterface)'    != ''">%(QtMoc.LibCompiledInterface)</LibCompiled>
        <ImpLibCompiled Condition="'%(QtMoc.ImpLibCompiled)' == '' and '%(QtMoc.ImpLibCompiledInterface)' != ''">%(QtMoc.ImpLibCompiledInterface)</ImpLibCompiled>
      </ClCompile>
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <ComputeCompileInputsTargets>
      $(ComputeCompileInputsTargets);
      ComputeQtMocGeneratedCompileInputs;
    </ComputeCompileInputsTargets>
  </PropertyGroup>
  
  <Target
      Name="QtUic"
      BeforeTargets="$(QtUicBeforeTargets)"
      AfterTargets="$(QtUicAfterTargets)"
      Condition="'@(QtUic)' != ''"
      DependsOnTargets="_SelectedFiles">
    <ItemGroup Condition="'@(SelectedFiles)' != ''">
      <QtUic Remove="@(QtUic)" Condition="'%(Identity)' != '@(SelectedFiles)'" />
    </ItemGroup>
    <ItemGroup>
      <QtUic_tlog Include="%(QtUic.ObjectFileName)" Condition="'%(QtUic.ObjectFileName)' != '' and '%(QtUic.ExcludedFromBuild)' != 'true'">
        <Source>@(QtUic, '|')</Source>
      </QtUic_tlog>
      <QtUic Condition="'@(QtUic)' != ''">
        <MinimalRebuildFromTracking Condition="'$(BuildType)' != 'Build' or '$(ForceRebuild)' == 'true'">false</MinimalRebuildFromTracking>
        <AdditionalOptions0 Condition="'%(QtUic.ObjectFileName)' != ''"> -o "%(QtUic.ObjectFileName)"</AdditionalOptions0>
        <AdditionalOptions1 Condition="'%(QtUic.DisplayDependencies)' == 'true'"> -d"</AdditionalOptions1>
        <AdditionalOptions2 Condition="'%(QtUic.NoProtection)' == 'true'"> -p"</AdditionalOptions2>
        <AdditionalOptions3 Condition="'%(QtUic.NoImplicitIncludes)' == 'true'"> -n"</AdditionalOptions3>
        <AdditionalOptions4 Condition="'%(QtUic.i18nFunction)' != ''"> -tr "%(QtUic.i18nFunction)"</AdditionalOptions4>
        <AdditionalOptions5 Condition="'%(QtUic.ChangeGenerator)' != ''"> -g "%(QtUic.ChangeGenerator)"</AdditionalOptions5>
      </QtUic>
    </ItemGroup>
    <WriteLinesToFile
      Condition="'@(QtUic_tlog)' != '' and '%(QtUic_tlog.ExcludedFromBuild)' != 'true'"
      File="$(IntDir)$(ProjectName).write.1.tlog"
      Lines="^%(QtUic_tlog.Source);@(QtUic_tlog-&gt;'%(Fullpath)')"/>
    <MalterlibTool
      Condition="'@(QtUic)' != '' and '%(QtUic.ExcludedFromBuild)' != 'true'"
      ToolExecutableName="uic.exe"
      MinimalRebuildFromTracking="%(QtUic.MinimalRebuildFromTracking)"
      TrackerLogDirectory="$(TLogLocation)"
      TrackFileAccess="$(TrackFileAccess)"
      ToolArchitecture="Native64Bit"
      AdditionalOptions="%(QtUic.AdditionalOptions)%(QtUic.AdditionalOptions0)%(QtUic.AdditionalOptions1)%(QtUic.AdditionalOptions2)%(QtUic.AdditionalOptions3)%(QtUic.AdditionalOptions4)%(QtUic.AdditionalOptions5)%(QtUic.AdditionalOptions6)%(QtUic.AdditionalOptions7)"
      Source="%(QtUic.FullPath)"
      StandardOutputImportance="High"
      StandardErrorImportance="High"
      EchoOff="true"
      />
  </Target>

  <Target
        Name="QtRcc"
        BeforeTargets="$(QtRccBeforeTargets)"
        AfterTargets="$(QtRccAfterTargets)"
        Condition="'@(QtRcc)' != ''"
        DependsOnTargets="_SelectedFiles;ComputeQtRccGeneratedCompileInputs">
    <ItemGroup Condition="'@(SelectedFiles)' != ''">
      <QtRcc Remove="@(QtRcc)" Condition="'%(Identity)' != '@(SelectedFiles)'" />
    </ItemGroup>
    <ItemGroup>
      <QtRcc_tlog Include="%(QtRcc.ObjectFileName)" Condition="'%(QtRcc.ObjectFileName)' != '' and '%(QtRcc.ExcludedFromBuild)' != 'true'">
        <Source>@(QtRcc, '|')</Source>
      </QtRcc_tlog>
      <QtRcc Condition="'@(QtRcc)' != ''">
        <MinimalRebuildFromTracking Condition="'$(BuildType)' != 'Build' or '$(ForceRebuild)' == 'true'">false</MinimalRebuildFromTracking>
        <AdditionalOptions0 Condition="'%(QtRcc.ObjectFileName)' != ''"> -o "%(QtRcc.ObjectFileName)"</AdditionalOptions0>
        <AdditionalOptions1 Condition="'%(QtRcc.InitFunc)' != ''"> -name "%(QtRcc.InitFunc)"</AdditionalOptions1>
        <AdditionalOptions2 Condition="'%(QtRcc.NoCompress)' == 'true'"> -no-compress"</AdditionalOptions2>
        <AdditionalOptions3 Condition="'%(QtRcc.Namespace)' == 'true'"> -namespace"</AdditionalOptions3>
      </QtRcc>
    </ItemGroup>
    <WriteLinesToFile
      Condition="'@(QtRcc_tlog)' != '' and '%(QtRcc_tlog.ExcludedFromBuild)' != 'true'"
      File="$(IntDir)$(ProjectName).write.1.tlog"
      Lines="^%(QtRcc_tlog.Source);@(QtRcc_tlog-&gt;'%(Fullpath)')"/>
    <MalterlibTool
      Condition="'@(QtRcc)' != '' and '%(QtRcc.ExcludedFromBuild)' != 'true'"
      ToolExecutableName="rcc.exe"
      MinimalRebuildFromTracking="%(QtRcc.MinimalRebuildFromTracking)"
      TrackerLogDirectory="$(TLogLocation)"
      TrackFileAccess="$(TrackFileAccess)"
      ToolArchitecture="Native64Bit"
      AdditionalOptions="%(QtRcc.AdditionalOptions)%(QtRcc.AdditionalOptions0)%(QtRcc.AdditionalOptions1)%(QtRcc.AdditionalOptions2)%(QtRcc.AdditionalOptions3)%(QtRcc.AdditionalOptions4)%(QtRcc.AdditionalOptions5)%(QtRcc.AdditionalOptions6)%(QtRcc.AdditionalOptions7)"
      Source="%(QtRcc.FullPath)"
      StandardOutputImportance="High"
      StandardErrorImportance="High"
      EchoOff="true"
      />
  </Target>

  <Target Name="ComputeQtRccGeneratedCompileInputs"
          DependsOnTargets="$(ComputeQtRccGeneratedCompileInputsDependsOn)"
          Outputs="%(QtRcc.OutputDirectory)">
    <ItemGroup Condition="'@(QtRcc)' != ''">
      <ClCompile Include="%(QtRcc.ObjectFileName)" Condition="'%(QtRcc.DoCompileAndLink)' == 'true'" >
        <LinkCompiled   Condition="'%(QtRcc.LinkCompiled)'   == '' and '%(QtRcc.LinkCompiledInterface)'   != ''">%(QtRcc.LinkCompiledInterface)</LinkCompiled>
        <LibCompiled    Condition="'%(QtRcc.LibCompiled)'    == '' and '%(QtRcc.LibCompiledInterface)'    != ''">%(QtRcc.LibCompiledInterface)</LibCompiled>
        <ImpLibCompiled Condition="'%(QtRcc.ImpLibCompiled)' == '' and '%(QtRcc.ImpLibCompiledInterface)' != ''">%(QtRcc.ImpLibCompiledInterface)</ImpLibCompiled>
      </ClCompile>
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <ComputeCompileInputsTargets>
      $(ComputeCompileInputsTargets);
      ComputeQtRccGeneratedCompileInputs;
    </ComputeCompileInputsTargets>
  </PropertyGroup>

  
</Project>
