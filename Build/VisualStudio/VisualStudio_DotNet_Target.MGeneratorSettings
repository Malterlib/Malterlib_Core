Target
{
	!!LanguageFamily ".NET"

	AppDesignerFolder: string = "Properties"
}

GeneratorSetting
{
	!!LanguageFamily ".NET"

	Target_FileExtension {}
	{
		!!GeneratorSetting.Target_FileExtension undefined
	}
	Target_DefaultNamespace {}
	{
		!!GeneratorSetting.Target_DefaultNamespace undefined
	}
	Target_ToolPath {}
	{
		!!GeneratorSetting.Target_ToolPath undefined
	}
	Target_SearchPath {}
	{
		!!GeneratorSetting.Target_SearchPath undefined
	}
	Target_RemoteDebuggerCommand {}
	{
		!!GeneratorSetting.Target_RemoteDebuggerCommand undefined
	}
	Target_RemoteDebuggerWorkingDirectory {}
	{
		!!GeneratorSetting.Target_RemoteDebuggerWorkingDirectory undefined
	}

	Target_IntermediateDirectory =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "BaseIntermediateOutputPath"
				, Value: Target.IntermediateDirectory->EscapeMSBuild()
			}, {
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "_InitialBaseIntermediateOutputPath"
				, Value: Target.IntermediateDirectory->EscapeMSBuild()
			}, {
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "MSBuildProjectExtensionsPath"
				, Value: Target.IntermediateDirectory->EscapeMSBuild()
			}, {
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "_InitialMSBuildProjectExtensionsPath"
				, Value: Target.IntermediateDirectory->EscapeMSBuild()
			}, {
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "IntermediateOutputPath"
				, Value: Target.IntermediateDirectory->EscapeMSBuild()
			}, {
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "IntDir"
				, Value: Target.IntermediateDirectory->EscapeMSBuild()
			}
		]
	}

	Target_OutputDirectory =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "BaseOutputPath"
				, Value: Target.OutputDirectory->EscapeMSBuild()
			}, {
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "OutputPath"
				, Value: Target.OutputDirectory->EscapeMSBuild()
			}, {
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "OutDir"
				, Value: Target.OutputDirectory->EscapeMSBuild()
			}
		]
	}

	Target_FileName =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "AssemblyName"
				, Value: Target.FileName->EscapeMSBuild()
			}
		]
	}

	Target_DefaultNamespace =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "RootNamespace"
				, Value: Target.DefaultNamespace->EscapeMSBuild()
			}
		]
	}

	Target_ToolPath =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "MalterlibBuildSystemExecutablePath"
				, Value: Target.ToolPath->ForEach(&f_Helper_AllWindowsPath)->f_JoinMSBuild()
			}
		]
	}

	Target_ProjectDir =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "ProjectDir"
				, Value: `$([System.IO.Path]::GetFullPath(@(`$(MSBuildProjectDirectory)@(Target.ProjectDir->WindowsPath())\\`->Escape())))`
			}
		]
	}

	Target_GenerateAssemblyInfo =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Key: "GenerateAssemblyInfo"
				, Value: Target.GenerateAssemblyInfo->f_BoolToString()
			}
		]
	}

	Target_AppDesignerFolder =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "PreProject"
				, Key: "AppDesignerFolder"
				, Value: Target.AppDesignerFolder->EscapeMSBuild()
			}
		]
	}

	Target_GenerateDebugInformation =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Key: "DebugSymbols"
				, Value: Target.GenerateDebugInformation->f_BoolToString()
			}
		]
	}

	Target_PostBuildScript =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Key: "PostBuildEvent"
				, Value: `set PATH=$(MalterlibBuildSystemExecutablePath);%PATH%\r\n@(Target.PostBuildScript->EscapeMSBuild())`
			}
		]
	}

	Target_PreBuildScript =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Key: "PreBuildEvent"
				, Value: `set PATH=$(MalterlibBuildSystemExecutablePath);%PATH%\r\n@(Target.PreBuildScript->EscapeMSBuild())`
			}
		]
	}

	Target_Version =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Key: "ApplicationVersion"
				, Value: Target.Version->EscapeMSBuild()
			}
		]
	}

	Target_PlatformTarget =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Key: "PlatformTarget"
				, Value: Target.PlatformTarget->EscapeMSBuild()
			}
		]
	}

	Target_ErrorReport =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Key: "ErrorReport"
				, Value: Target.ErrorReport->EscapeMSBuild()
			}
		]
	}

	Target_CodeAnalysisRuleSet =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Key: "CodeAnalysisRuleSet"
				, Value: Target.CodeAnalysisRuleSet->EscapeMSBuild()
			}
		]
	}

	Target_DebuggerCommandArguments =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Key: "StartArguments"
				, Value: Target.DebuggerCommandArguments->EscapeMSBuild()
			}
		]
	}

	Target_LocalDebuggerCommand =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Key: "StartProgram"
				, Value: Target.LocalDebuggerCommand->EscapeMSBuild()
			}
		]
	}

	Target_LocalDebuggerWorkingDirectory =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Key: "StartWorkingDirectory"
				, Value: Target.LocalDebuggerWorkingDirectory->EscapeMSBuild()
			}
		]
	}

	Target_StartAction =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Key: "StartAction"
				, Value: Target.StartAction->EscapeMSBuild()
			}
		]
	}
}
