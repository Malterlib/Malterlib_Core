%GeneratorSetting "DotNet_SharedTarget"
{
	%GeneratorSetting "Target"
	{
		%GeneratorSetting "FileName"
		{
			Property
			{
				Disabled true
			}
		}
		%GeneratorSetting "FileExtension"
		{
			Property
			{
				Disabled true
			}
		}
		%GeneratorSetting "DefaultNamespace"
		{
			Property
			{
				Disabled true
			}
		}
		%GeneratorSetting "ToolPath"
		{
			Property
			{
				Disabled true
			}
		}
		%GeneratorSetting "SearchPath"
		{
			Property
			{
				Disabled true
			}
		}
		%GeneratorSetting "GenerateDebugInformation"
		{
			Property
			{
				Name "DebugSymbols"
			}
			%GeneratorSetting "Value"
			{
				Property
				{
					true true
					false false
				}
			}
		}		

		%GeneratorSetting "Real_PostBuildScript"
		{
			Property
			{
				Name "PostBuildEvent"
				Substitute "set PATH=$(MalterlibBuildSystemExecutablePath);%PATH%\r\n{}"
			}
		}

		%GeneratorSetting "Real_PreBuildScript"
		{
			Property
			{
				Name "PreBuildEvent"
				Substitute "set PATH=$(MalterlibBuildSystemExecutablePath);%PATH%\r\n{}"
			}
		}

		%GeneratorSetting "PostBuildScript"
		{
			Property
			{
				Disabled true
			}
		}

		%GeneratorSetting "PreBuildScript"
		{
			Property
			{
				Disabled true
			}
		}

		%GeneratorSetting "Version"
		{
			Property
			{
				Name "ApplicationVersion"
			}
		}		
		%GeneratorSetting "PlatformTarget"
		{
			Property
			{
				Name "PlatformTarget"
			}
		}	
		%GeneratorSetting "ErrorReport"
		{
			Property
			{
				Name "ErrorReport"
			}
		}
		%GeneratorSetting "CodeAnalysisRuleSet"
		{
			Property
			{
				Name "CodeAnalysisRuleSet"
			}
		}
		%GeneratorSetting "DebuggerCommandArguments"
		{
			Property
			{
				Name "StartArguments"
			}
		}
		%GeneratorSetting "LocalDebuggerCommand"
		{
			Property
			{
				Name "StartProgram"
			}
		}
		%GeneratorSetting "LocalDebuggerWorkingDirectory"
		{
			Property
			{
				Name "StartWorkingDirectory"
			}
		}
		
		%GeneratorSetting "RemoteDebuggerCommand"
		{
			Property
			{
				Disabled true
			}
		}
		%GeneratorSetting "RemoteDebuggerWorkingDirectory"
		{
			Property
			{
				Disabled true
			}
		}
		%GeneratorSetting "StartAction"
	}
}
