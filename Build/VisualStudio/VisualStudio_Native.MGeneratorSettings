GeneratorSetting
{
	Target #<ImportTargets> =+ [
		"$(VCTargetsPath)\\Microsoft.Cpp.targets"
		, "$(VCTargetsPath)\\BuildCustomizations\\masm.targets"
		, `$(MSBuildProjectDirectory)..\\@(Builtin.BasePathRelativeProject->WindowsPath())\\Malterlib\\Core\\Build\\VisualStudio\\VSNASM\\nasm.targets`
		, `$(MSBuildProjectDirectory)..\\@(Builtin.BasePathRelativeProject->WindowsPath())\\Malterlib\\Core\\Build\\VisualStudio\\CustomTargets\\Malterlib.targets`
	]
	{
		!!Target.Language "Native"
	}

	Target #<ImportTargets_Defaults> =+ ["$(VCTargetsPath)\\Microsoft.Cpp.Default.props"]
	{
		!!Target.Language "Native"
	}

	Target #<ImportTargets_Properties> =+ [
		"$(VCTargetsPath)\\Microsoft.Cpp.props"
		, "$(VCTargetsPath)\\BuildCustomizations\\masm.props"
		, `$(MSBuildProjectDirectory)..\\@(Builtin.BasePathRelativeProject->WindowsPath())\\Malterlib\\Core\\Build\\VisualStudio\\VSNASM\\nasm.props`
	]
	{
		!!Target.Language "Native"
	}
}

GeneratorSetting
{
	!!Target.Language "Native"

	Target_Type =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "ConfigurationType"
				, Value: Target.Type->SwitchWithError(
					"Unsupported target type: "
					, "Executable", "Application"
					, "ConsoleExecutable", "Application"
					, "UIExecutable", "Application"
					, "Driver", "Application"
					, "DynamicLibrary", "DynamicLibrary"
					, "SharedDynamicLibrary", "DynamicLibrary"
					, "StaticLibrary", "StaticLibrary"
					, "Tool", "Utility"
				)
			},
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "ResolveNuGetPackages"
				, Value: false->f_BoolToString()
			}
		]
	}

	Target_PlatformToolset =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "PlatformToolset"
				, Value: Target.PlatformToolset->EscapeMSBuild()
			}
		]
	}

	Target_LLVMInstallDir =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "LLVMInstallDir"
				, Value: Target.LLVMInstallDir->EscapeMSBuild()
			}
		]
	}

	Target_LLVMToolsVersion =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "LLVMToolsVersion"
				, Value: Target.LLVMToolsVersion->EscapeMSBuild()
			}
		]
	}

	Target_UseDebugLibraries =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "UseDebugLibraries"
				, Value: Target.UseDebugLibraries->f_BoolToString()
			}
		]
	}

	Target_NasmPath =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "NasmPath"
				, Value: (Target.NasmPath->WindowsPath() + "\\")->EscapeMSBuild()
			}
		]
	}

	Target_CharacterSet =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "CharacterSet"
				, Value: Target.CharacterSet->EscapeMSBuild()
			}
		]
	}

	Target_UseOfMfc =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "UseOfMfc"
				, Value: Target.UseOfMfc->f_BoolToString()
			}
		]
	}

	Target_UseOfAtl =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "UseOfAtl"
				, Value: Target.UseOfAtl->f_BoolToString()
			}
		]
	}

	Target_DefaultToolArchitecture =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "UseNativeEnvironment"
				, Value: Target.DefaultToolArchitecture->SwitchWithError(
					"Unsupported option: "
					, "Native64Bit", "true"
					, "", "false"
				)
			}
		]
	}

	Target_CLRSupport =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "CLRSupport"
				, Value: Target.CLRSupport->SwitchWithError(
					"Unsupported option: "
					, true, "true"
					, false, "false"
					, "NetCore", "NetCore"
					, "", "false"
				)
			}
		]
	}

	Target_IgnoreWarnCompileDuplicatedFilename =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "IgnoreWarnCompileDuplicatedFilename"
				, Value: Target.IgnoreWarnCompileDuplicatedFilename->f_BoolToString()
			}
		]
	}

	Target_EnableASAN =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "EnableASAN"
				, Value: Target.EnableASAN->f_BoolToString()
			}
		]
	}

	Target_IntermediateDirectory =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "IntDir"
				, Value: Target.IntermediateDirectory->EscapeMSBuild()
			}
		]
	}

	Target_OutputDirectory =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "OutDir"
				, Value: Target.OutputDirectory->EscapeMSBuild()
			}
		]
	}
	Target_CustomBuildAfterTargets =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "CustomBuildAfterTargets"
				, Value: Target.CustomBuildAfterTargets->EscapeMSBuild()
			}
		]
	}
	Target_CustomBuildBeforeTargets =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "CustomBuildBeforeTargets"
				, Value: Target.CustomBuildBeforeTargets->EscapeMSBuild()
			}
		]
	}
}

GeneratorSetting
{
	Compile_GenericCompileType {}
}

GeneratorSetting
{
	!!Target.Language "Native"

	VisualStudio_FileType: string = (Compile.GenericCompileType <==> "GenericCustom") ? "CustomBuild" : SwitchWithError(Compile.Type, "Unknown compile type: "
		, "C++", "ClCompile"
		, "C++Managed", "ClCompile"
		, "C", "ClCompile"
		, "Header", "ClInclude"
		, "None", "None"
		, "Object", "Object"
		, "Assembler", "MASM"
		, "AssemblerNasm", "NASM"
		, "WindowsResource", "ResourceCompile"
		, "MSBuildTargets", "None"
		, "PList", "None"
		, "XML", "None"
		, "ShellScript", "None"
		, "VisualStudioVisualizer", "Natvis"
		, "Custom", "CustomBuild"
		, "WindowsManifest", "None"
	)

	VisualStudio_BuildSupported: bool = (Compile.GenericCompileType <==> "GenericCustom") ? true : SwitchWithDefault(Compile.Type, false
		, "C++", true
		, "C++Managed", true
		, "C", true
		, "Object", true
		, "Assembler", true
		, "AssemblerNasm", true
		, "WindowsResource", true
		, "VisualStudioVisualizer", true
		, "Custom", true
	)

	Compile_Type =+ {
		VSSettings: Compile.Type->SwitchWithDefault(
			{}
			, "C", {
				CompileAs: "CompileAsC"
				, CompileAsManaged: "false"
			}
			, "C++", {
				CompileAs: "CompileAsCpp"
				, CompileAsManaged: "false"
			}
			, "C++Managed", {
				CompileAs: "CompileAsCpp"
				, CompileAsManaged: "true"
			}
			, "MSBuildTargets", {
				SubType: "Designer"
			}
		)
	}
}

GeneratorSetting
{
	!!Target.Language "Native"

	Dependency_Link {
		VSSettings: {
			LinkLibraryDependencies: Dependency.Link->f_BoolToString()
			, Private: false->f_BoolToString()
			, ReferenceOutputAssembly: false->f_BoolToString()
		}
	}

	Dependency_LinkWithObjectFiles =+ {
		VSSettings: {
			UseLibraryDependencyInputs: (Dependency.LinkWithObjectFiles && Dependency.Link)->f_BoolToString()
		}
	}

	Dependency_ObjectLibrary {}

	Dependency_TargetProperties {}
	{
		!!GeneratorSetting.Dependency_TargetProperties undefined
	}
}

GeneratorSetting
{
	!Target.Language "Native"

	Dependency_ObjectLibrary =+ {}
	{
		!!GeneratorSetting.Dependency_ObjectLibrary undefined
	}
}
