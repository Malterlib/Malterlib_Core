					UIExecutable "Application"
					Driver "Application"
					DynamicLibrary "DynamicLibrary"
					SharedDynamicLibrary "DynamicLibrary"
					StaticLibrary "StaticLibrary"
					Tool "Makefile"
				}
			}
		}

		%GeneratorSetting "PlatformToolset"
		{
			Property
			{
				Name "PlatformToolset"
			}
		}
		%GeneratorSetting "CharacterSet"
