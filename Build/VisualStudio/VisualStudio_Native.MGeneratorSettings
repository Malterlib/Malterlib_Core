%GeneratorSetting "Native_ImportTargets"
{
	%GeneratorSetting "Defaults"
	{
		Property
		{
			A0 "$(VCTargetsPath)\\Microsoft.Cpp.Default.props"
		}
	}
	%GeneratorSetting "Props"
	{
		Property
		{
			A0 "$(VCTargetsPath)\\Microsoft.Cpp.props"
			A1 "$(VCTargetsPath)\\BuildCustomizations\\masm.props"
			A2 "$(MSBuildProjectDirectory)..\\@(Builtin.BasePathRelativeProject->WindowsPath())\\Malterlib\\Core\\Build\\VisualStudio\\QtMoc.props"
			A3 "$(MSBuildProjectDirectory)..\\@(Builtin.BasePathRelativeProject->WindowsPath())\\Malterlib\\Core\\Build\\VisualStudio\\MalterlibTargets.props"
			A4 "$(MSBuildProjectDirectory)..\\@(Builtin.BasePathRelativeProject->WindowsPath())\\Malterlib\\Core\\Build\\VisualStudio\\VSNASM\\nasm.props"
		}
	}
	%GeneratorSetting "Targets"
	{
		Property
		{
			A0 "$(VCTargetsPath)\\Microsoft.Cpp.targets"
			A1 "$(VCTargetsPath)\\BuildCustomizations\\masm.targets"
			A2 "$(MSBuildProjectDirectory)..\\@(Builtin.BasePathRelativeProject->WindowsPath())\\Malterlib\\Core\\Build\\VisualStudio\\QtMoc.targets"
			A3 "$(MSBuildProjectDirectory)..\\@(Builtin.BasePathRelativeProject->WindowsPath())\\Malterlib\\Core\\Build\\VisualStudio\\MalterlibTargets.targets"
			A4 "$(MSBuildProjectDirectory)..\\@(Builtin.BasePathRelativeProject->WindowsPath())\\Malterlib\\Core\\Build\\VisualStudio\\VSNASM\\nasm.targets"
		}
	}
}
%GeneratorSetting "Native_Root"
