GeneratorSetting
{
	Target #<ImportTargets> =+ [
		"$(VCTargetsPath)\\Microsoft.Cpp.targets"
		, "$(VCTargetsPath)\\BuildCustomizations\\masm.targets"
		, `$(MSBuildProjectDirectory)..\\@(Builtin.BasePathRelativeProject->WindowsPath())\\Malterlib\\Core\\Build\\VisualStudio\\QtMoc.targets`
		, `$(MSBuildProjectDirectory)..\\@(Builtin.BasePathRelativeProject->WindowsPath())\\Malterlib\\Core\\Build\\VisualStudio\\MalterlibTargets.targets`
		, `$(MSBuildProjectDirectory)..\\@(Builtin.BasePathRelativeProject->WindowsPath())\\Malterlib\\Core\\Build\\VisualStudio\\VSNASM\\nasm.targets`
	]
	{
		!!Target.Language "Native"
	}

	Target #<ImportTargets_Defaults> =+ ["$(VCTargetsPath)\\Microsoft.Cpp.Default.props"]
	{
		!!Target.Language "Native"
	}

	Target #<ImportTargets_Properties> =+ [
		"$(VCTargetsPath)\\Microsoft.Cpp.props"
		, "$(VCTargetsPath)\\BuildCustomizations\\masm.props"
		, `$(MSBuildProjectDirectory)..\\@(Builtin.BasePathRelativeProject->WindowsPath())\\Malterlib\\Core\\Build\\VisualStudio\\QtMoc.props`
		, `$(MSBuildProjectDirectory)..\\@(Builtin.BasePathRelativeProject->WindowsPath())\\Malterlib\\Core\\Build\\VisualStudio\\MalterlibTargets.props`
		, `$(MSBuildProjectDirectory)..\\@(Builtin.BasePathRelativeProject->WindowsPath())\\Malterlib\\Core\\Build\\VisualStudio\\VSNASM\\nasm.props`
	]
	{
		!!Target.Language "Native"
	}
}

GeneratorSetting
{
	!!Target.Language "Native"

	Target_Type =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "ConfigurationType"
				, Value: Target.Type->SwitchWithError(
					"Unsupported target type: "
					, "Executable", "Application"
					, "ConsoleExecutable", "Application"
					, "UIExecutable", "Application"
					, "Driver", "Application"
					, "DynamicLibrary", "DynamicLibrary"
					, "SharedDynamicLibrary", "DynamicLibrary"
					, "StaticLibrary", "StaticLibrary"
					, "Tool", "Utility"
				)
			}
		]
	}

	Target_PlatformToolset =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "PlatformToolset"
				, Value: Target.PlatformToolset->EscapeMSBuild()
			}
		]
	}

	Target_NasmPath =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "NasmPath"
				, Value: Target.NasmPath->EscapeMSBuild()
			}
		]
	}

	Target_CharacterSet =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "CharacterSet"
				, Value: Target.CharacterSet->EscapeMSBuild()
			}
		]
	}

	Target_UseOfMfc =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "UseOfMfc"
				, Value: Target.UseOfMfc->f_BoolToString()
			}
		]
	}

	Target_UseOfAtl =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "UseOfAtl"
				, Value: Target.UseOfAtl->f_BoolToString()
			}
		]
	}

	Target_DefaultToolArchitecture =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "UseNativeEnvironment"
				, Value: Target.DefaultToolArchitecture->SwitchWithError(
					"Unsupported option: "
					, "Native64Bit", "true"
					, "", "false"
				)
			}
		]
	}

	Target_CLRSupport =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "CLRSupport"
				, Value: Target.CLRSupport->SwitchWithError(
					"Unsupported option: "
					, true, "true"
					, false, "false"
					, "NetCore", "NetCore"
					, "", "false"
				)
			}
		]
	}

	Target_IgnoreWarnCompileDuplicatedFilename =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "IgnoreWarnCompileDuplicatedFilename"
				, Value: Target.IgnoreWarnCompileDuplicatedFilename->f_BoolToString()
			}
		]
	}

	Target_EnableASAN =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "EnableASAN"
				, Value: Target.EnableASAN->f_BoolToString()
			}
		]
	}

	Target_IntermediateDirectory =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "IntDir"
				, Value: Target.IntermediateDirectory->EscapeMSBuild()
			}
		]
	}

	Target_OutputDirectory =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "OutDir"
				, Value: Target.OutputDirectory->EscapeMSBuild()
			}
		]
	}
}

GeneratorSetting
{
	Compile_GenericCompileType {}
}

GeneratorSetting
{
	!!Target.Language "Native"

	VisualStudio_FileType (Compile.GenericCompileType <==> "GenericCustom") ? "CustomBuild" : SwitchWithError(Compile.Type, "Unknown compile type: "
		, "C++", "ClCompile"
		, "C++Managed", "ClCompile"
		, "C", "ClCompile"
		, "Header", "ClInclude"
		, "None", "None"
		, "Object", "Object"
		, "Assembler", "MASM"
		, "AssemblerNasm", "NASM"
		, "QtRcc", "QtRcc"
		, "QtMoc", "QtMoc"
		, "QtUic", "QtUic"
		, "MlTwk", "MlTwk"
		, "WindowsResource", "ResourceCompile"
		, "MSBuildTargets", "None"
		, "PList", "None"
		, "XML", "None"
		, "ShellScript", "None"
		, "VisualStudioVisualizer", "Natvis"
		, "Custom", "CustomBuild"
		, "WindowsManifest", "Manifest"
	)

	Compile_Type =+ {
		VSSettings: Compile.Type->SwitchWithDefault(
			{}
			, "C", {
				CompileAs: "CompileAsC"
				, CompileAsManaged: "false"
			}
			, "C++", {
				CompileAs: "CompileAsCpp"
				, CompileAsManaged: "false"
			}
			, "C++Managed", {
				CompileAs: "CompileAsCpp"
				, CompileAsManaged: "true"
			}
			, "MSBuildTargets", {
				SubType: "Designer"
			}
		)
	}
}

GeneratorSetting
{
	!!Target.Language "Native"

	Dependency_LinkWithObjectFiles =+ {
		VSSettings: {
			UseLibraryDependencyInputs: Dependency.LinkWithObjectFiles->f_BoolToString()
		}
	}

	Dependency_TargetProperties {}
	{
		!!GeneratorSetting.Dependency_TargetProperties undefined
	}
}
