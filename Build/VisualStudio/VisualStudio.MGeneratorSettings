Type
{
	CVS_Setting_PropertyGroup: {
		Type: one_of("PropertyGroup")
		, Label?: string
		, Key: string
		, Value: string
	}

	CVS_Setting_ItemDefinitionGroup: {
		Type: one_of("ItemDefinitionGroup")
		, Name: string
		, Key: string
		, Value: string
	}

	CVS_Setting: one_of(type(CVS_Setting_PropertyGroup), type(CVS_Setting_ItemDefinitionGroup))

	CVS_SettingWithPositions: {
		Positions: [type(CPosition)]
		, Settings: [type(CVS_Setting)]
	}

	CVS_SettingItem: {
		...: string
	}

	CVS_SettingItemWithPositions: {
		Positions: [type(CPosition)]
		, Settings: {
			...: string
		}
	}
	//one_of(string, [one_of(string, [string])], bool)

	CCompileSettings: {
		Flags?: one_of(string, [string], [[string]])
		, Type?: one_of("unique", "multiple")
		, VSSettings?: {
			...: string
		}
	}

	CTargetSettings: {
		Flags?: one_of(string, [string], [[string]])
		, Type?: one_of("unique", "multiple")
		, VSSettings?: [type(CVS_Setting)]
	}

	CCompile: {
		Type: type(CStringWithPosition)
		, VSType: type(CStringWithPosition)
		, PrecompilePrefixHeader: bool
		, Disabled: bool
		, PrefixHeader: type(COptionalStringWithPosition)
		, VSSettings: {...: type(CVS_SettingItemWithPositions)}
	}
	//Type: string
	//, Settings?: [type(CCompileSettings)]

	CDependency: {
		Type: type(CStringWithPosition)
		, VSType: type(CStringWithPosition)
		, VSSettings: {...: type(CVS_SettingItemWithPositions)}
	}

	CWorkspace: {
	}

	CTarget: {
		Language: type(CStringWithPosition)
		, PlatformVersion: type(COptionalStringWithPosition)
		, ClCompileSuffix: type(COptionalStringWithPosition)
		, TargetFrameworkVersion: type(COptionalStringWithPosition)
		, ImportTargets?: [string]
		, ImportTargets_Defaults?: [string]
		, ImportTargets_Properties?: [string]
		, VSSettings: {...: type(CVS_SettingWithPositions)}
	}
//		Type: type(CStringWithPosition)
//		, Name: type(CStringWithPosition)
//		, Settings?: [type(CCompileSettings)]
}

GeneratorSetting
{
	f_GetTargetVSSettings function(type(CTargetSettingsWithPosition) _CompileSettings) {...: type(CVS_SettingWithPositions)} = {}
	f_GetTargetVSSettings =+ Error(`Flags not allowed for target settings: @(_CompileSettings->ToString())`)
	{
		!!_CompileSettings<Value>->HasMember("Flags") true
	}
	f_GetTargetVSSettings #<@(_CompileSettings<Property.Name>)> {
		Positions: _CompileSettings<Positions>
		, Settings: _CompileSettings<Value.VSSettings>
	}
	{
		!!_CompileSettings<Value>->HasMember("VSSettings") true
	}

	f_GetCompileVSSettings function(type(CCompileSettingsWithPosition) _CompileSettings) {...: type(CVS_SettingItemWithPositions)} = {}
	f_GetCompileVSSettings #<@(_CompileSettings<Property.Name>)> {
		Positions: _CompileSettings<Positions>
		, Settings: _CompileSettings<Value.VSSettings>
	}
	{
		!!_CompileSettings<Value>->HasMember("VSSettings") true
	}

	f_GetDependencyVSSettings function(type(CCompileSettingsWithPosition) _CompileSettings) {...: type(CVS_SettingItemWithPositions)} = {}
	f_GetDependencyVSSettings #<@(_CompileSettings<Property.Name>)> {
		Positions: _CompileSettings<Positions>
		, Settings: _CompileSettings<Value.VSSettings>
	}
	{
		!!_CompileSettings<Value>->HasMember("VSSettings") true
	}

	VisualStudio_DependencyType: string?

	f_BoolToStringDotNet function(bool _bValue) string = (_bValue ? "True" : "False")
}

Target
{
	Language "Native"
	{
		!!Target.Language undefined
	}
}

Property
{
	TargetPlatformVersionString: string?
	TargetPlatformVersionString Target.PlatformVersion->ToString()
	{
		!Target.PlatformVersion undefined
	}
}

GeneratorSetting
{
	Target {
		Language: &Target.Language->WithPosition()
		, PlatformVersion: &TargetPlatformVersionString->WithPosition()
		, ClCompileSuffix: &Target.ClCompileSuffix->WithPosition()
		, TargetFrameworkVersion: &Target.TargetFrameworkVersion->WithPosition()
		, VSSettings: GeneratorSetting.DefinedProperties->ForEach(&GeneratorSetting.f_GetTargetSettings)->ForEach(&GeneratorSetting.f_GetTargetVSSettings)
	}

	Dependency {
		Type: &Dependency.Type->WithPosition()
		, VSType: &GeneratorSetting.VisualStudio_DependencyType->WithPosition()
		, VSSettings: GeneratorSetting.DefinedProperties->ForEach(&GeneratorSetting.f_GetSettings)->ForEach(&GeneratorSetting.f_GetDependencyVSSettings)
	}

	Compile {
		Type: &Compile.Type->WithPosition()
		, VSType: &GeneratorSetting.VisualStudio_FileType->WithPosition()
		, PrecompilePrefixHeader: Compile.PrecompilePrefixHeader <==> true
		, PrefixHeader: &Compile.PrefixHeader->WithPosition()
		, Disabled: (Compile.Disabled || !GeneratorSetting.VisualStudio_BuildSupported)
		, VSSettings: GeneratorSetting.DefinedProperties->ForEach(&GeneratorSetting.f_GetSettings)->ForEach(&GeneratorSetting.f_GetCompileVSSettings)
	}
	{
		!!(Compile.Disabled || !GeneratorSetting.VisualStudio_BuildSupported) false
	}

	VisualStudio_FileTypeNone: string = "None"

	Compile {
		Type: &Compile.Type->WithPosition()
		, VSType: &GeneratorSetting.VisualStudio_FileTypeNone->WithPosition()
		, PrecompilePrefixHeader: false
		, PrefixHeader: &Compile.PrefixHeader->WithPosition()
		, Disabled: true
		, VSSettings: {}
	}
	{
		!!(Compile.Disabled || !GeneratorSetting.VisualStudio_BuildSupported) true
	}
}

