<ProjectSchemaDefinitions xmlns="http://schemas.microsoft.com/build/2009/properties" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
	<Rule
	Name="MlTwk"
	PageTemplate="tool"
	DisplayName="Malterlib Tweak Compiler"
	Order="200">
		<Rule.DataSource>
			<DataSource
			  Persistence="ProjectFile"
			  ItemType="MlTwk" />
		</Rule.DataSource>
		<Rule.Categories>
			<Category
			  Name="General">
				<Category.DisplayName>
					<sys:String>General</sys:String>
				</Category.DisplayName>
			</Category>
			<Category
			  Name="Command Line"
			  Subtype="CommandLine">
				<Category.DisplayName>
					<sys:String>Command Line</sys:String>
				</Category.DisplayName>
			</Category>
		</Rule.Categories>
		<StringProperty
		  Name="Inputs"
		  Category="Command Line"
		  IsRequired="true">
			<StringProperty.DataSource>
				<DataSource
				  Persistence="ProjectFile"
				  ItemType="MlTwk"
				  SourceType="Item" />
			</StringProperty.DataSource>
		</StringProperty>
		<BoolProperty
		  Name="DoCompileAndLink"
		  Category="General"
		  DisplayName="Compile and link"
		  Description="Compile and link."
		  IncludeInCommandLine ="false"
		  Visible="true" />
		<StringProperty
		  Name="ObjectFileName"
		  Category="Output File"
		  DisplayName="Output File Name"
		  Description="Specifies the name of the output file.     (-o:[file])"
		  Switch="-o &quot;[value]&quot;" />
		<DynamicEnumProperty
		 Name="MlTwkBeforeTargets"
		 Category="General"
		 EnumProvider="Targets"
		 IncludeInCommandLine="False">
			<DynamicEnumProperty.DisplayName>
				<sys:String>Execute Before</sys:String>
			</DynamicEnumProperty.DisplayName>
			<DynamicEnumProperty.Description>
				<sys:String>Specifies the targets for the build customization to run before.</sys:String>
			</DynamicEnumProperty.Description>
			<DynamicEnumProperty.ProviderSettings>
				<NameValuePair
				  Name="Exclude"
				  Value="^MlTwkBeforeTargets|^Compute" />
			</DynamicEnumProperty.ProviderSettings>
			<DynamicEnumProperty.DataSource>
				<DataSource
				  Persistence="ProjectFile"
				  ItemType=""
				  HasConfigurationCondition="true" />
			</DynamicEnumProperty.DataSource>
		</DynamicEnumProperty>
		<DynamicEnumProperty
		  Name="MlTwkAfterTargets"
		  Category="General"
		  EnumProvider="Targets"
		  IncludeInCommandLine="False">
			<DynamicEnumProperty.DisplayName>
				<sys:String>Execute After</sys:String>
			</DynamicEnumProperty.DisplayName>
			<DynamicEnumProperty.Description>
				<sys:String>Specifies the targets for the build customization to run after.</sys:String>
			</DynamicEnumProperty.Description>
			<DynamicEnumProperty.ProviderSettings>
				<NameValuePair
				  Name="Exclude"
				  Value="^MlTwkAfterTargets|^Compute" />
			</DynamicEnumProperty.ProviderSettings>
			<DynamicEnumProperty.DataSource>
				<DataSource
				  Persistence="ProjectFile"
				  ItemType=""
				  HasConfigurationCondition="true" />
			</DynamicEnumProperty.DataSource>
		</DynamicEnumProperty>
		<StringProperty
		  Subtype="AdditionalOptions"
		  Name="AdditionalOptions"
		  Category="Command Line">
			<StringProperty.DisplayName>
				<sys:String>Additional Options</sys:String>
			</StringProperty.DisplayName>
			<StringProperty.Description>
				<sys:String>Additional Options</sys:String>
			</StringProperty.Description>
		</StringProperty>
	</Rule>
	<ItemType
	  Name="MlTwk"
	  DisplayName="Malterlib Tweak Compiler" />
	<FileExtension
	  Name="*.twk"
	  ContentType="MlTwk" />
	<ContentType
	  Name="MlTwk"
	  DisplayName="Malterlib Tweak Compiler"
	  ItemType="MlTwk" />

	<Rule
	Name="MalterlibFS"
	PageTemplate="tool"
	DisplayName="Malterlib FS Compiler"
	Order="200">
		<Rule.DataSource>
			<DataSource
			  Persistence="ProjectFile"
			  ItemType="MalterlibFS" />
		</Rule.DataSource>
		<Rule.Categories>
			<Category
			  Name="General">
				<Category.DisplayName>
					<sys:String>General</sys:String>
				</Category.DisplayName>
			</Category>
			<Category
			  Name="Command Line"
			  Subtype="CommandLine">
				<Category.DisplayName>
					<sys:String>Command Line</sys:String>
				</Category.DisplayName>
			</Category>
		</Rule.Categories>
		<StringProperty
		  Name="Inputs"
		  Category="Command Line"
		  IsRequired="true">
			<StringProperty.DataSource>
				<DataSource
				  Persistence="ProjectFile"
				  ItemType="MalterlibFS"
				  SourceType="Item" />
			</StringProperty.DataSource>
		</StringProperty>
		<BoolProperty
		  Name="DoCompileAndLink"
		  Category="General"
		  DisplayName="Compile and link"
		  Description="Compile and link."
		  IncludeInCommandLine ="false"
		  Visible="true" />
		<BoolProperty
		  Name="VerboseLogging"
		  DisplayName="Verbose logging"
		  Description="Detailed information on all operations performed will be displayed.    (-verbose)"
		  Switch="-verbose" />
		<StringProperty
		  Name="MalterlibFSPathPrefix"
		  Category="General"
		  DisplayName="Malterlib FS path prefix"
		  Description="Path within VFS to prefix included files with.     (-dest path)"
		  Switch="-dest &quot;[value]&quot;" />
		<StringProperty
		  Name="CppFileName"
		  Category="General"
		  DisplayName="Malterlib Cpp file name"
		  Description="Path to output Cpp files to.     (-ocpp path)"
		  Switch="-ocpp &quot;[value]&quot;" />
		<StringProperty
		  Name="SymbolName"
		  Category="General"
		  DisplayName="Malterlib Symbol name"
		  Description="The name of the symbol.     (-symbol path)"
		  Switch="-symbol &quot;[value]&quot;" />
		<StringProperty
		  Name="ObjectFileName"
		  Category="General"
		  DisplayName="Output File Name"
		  Description="Specifies the name of the output file.     (-o:[file])"
		  Switch="-o &quot;[value]&quot;" />
		<DynamicEnumProperty
		 Name="MalterlibFSBeforeTargets"
		 Category="General"
		 EnumProvider="Targets"
		 IncludeInCommandLine="False">
			<DynamicEnumProperty.DisplayName>
				<sys:String>Execute Before</sys:String>
			</DynamicEnumProperty.DisplayName>
			<DynamicEnumProperty.Description>
				<sys:String>Specifies the targets for the build customization to run before.</sys:String>
			</DynamicEnumProperty.Description>
			<DynamicEnumProperty.ProviderSettings>
				<NameValuePair
				  Name="Exclude"
				  Value="^MalterlibFSBeforeTargets|^Compute" />
			</DynamicEnumProperty.ProviderSettings>
			<DynamicEnumProperty.DataSource>
				<DataSource
				  Persistence="ProjectFile"
				  ItemType=""
				  HasConfigurationCondition="true" />
			</DynamicEnumProperty.DataSource>
		</DynamicEnumProperty>
		<DynamicEnumProperty
		  Name="MalterlibFSAfterTargets"
		  Category="General"
		  EnumProvider="Targets"
		  IncludeInCommandLine="False">
			<DynamicEnumProperty.DisplayName>
				<sys:String>Execute After</sys:String>
			</DynamicEnumProperty.DisplayName>
			<DynamicEnumProperty.Description>
				<sys:String>Specifies the targets for the build customization to run after.</sys:String>
			</DynamicEnumProperty.Description>
			<DynamicEnumProperty.ProviderSettings>
				<NameValuePair
				  Name="Exclude"
				  Value="^MalterlibFSAfterTargets|^Compute" />
			</DynamicEnumProperty.ProviderSettings>
			<DynamicEnumProperty.DataSource>
				<DataSource
				  Persistence="ProjectFile"
				  ItemType=""
				  HasConfigurationCondition="true" />
			</DynamicEnumProperty.DataSource>
		</DynamicEnumProperty>
		<StringProperty
		  Subtype="AdditionalOptions"
		  Name="AdditionalOptions"
		  Category="Command Line">
			<StringProperty.DisplayName>
				<sys:String>Additional Options</sys:String>
			</StringProperty.DisplayName>
			<StringProperty.Description>
				<sys:String>Additional Options</sys:String>
			</StringProperty.Description>
		</StringProperty>
	</Rule>
	<ItemType
	  Name="MalterlibFS"
	  DisplayName="Malterlib FS Compiler" />
	<FileExtension
	  Name="*.MalterlibFSSpec"
	  ContentType="MalterlibFS" />
	<ContentType
	  Name="MalterlibFS"
	  DisplayName="Malterlib FS Compiler"
	  ItemType="MalterlibFS" />
</ProjectSchemaDefinitions>
