%GeneratorSetting "DotNet_Root"
{
	%GeneratorSetting "Target"
	{
		%GeneratorSetting "FileName"
		{
			Property
			{
				Name "AssemblyName"
			}
		}
		%GeneratorSetting "DefaultNamespace"
		{
			Property
			{
				Name "RootNamespace"
			}
		}
		%GeneratorSetting "ToolPath"
		{
			Property
			{
				Name "MalterlibBuildSystemExecutablePath"
				ConvertPath true
			}
		}
		%GeneratorSetting "ProjectDir"
		{
			Property
			{
				Name "ProjectDir"
				Substitute "$([System.IO.Path]::GetFullPath(\"$(MSBuildProjectDirectory){}\\\"))"
			}
		}
	}
}

%GeneratorSetting "DotNet_Dependency"
{
	%GeneratorSetting "Dependency"
	{
		%GeneratorSetting "LinkWithObjectFiles"
		{
			Property
			{
				Disabled true
			}
		}
	}
}
