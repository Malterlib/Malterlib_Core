<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <UsingTask TaskName="SetEnv" AssemblyFile="$(VCTargetsPath)Microsoft.Build.CppTasks.Common.Base.dll"/>	
  <PropertyGroup
    Condition="'$(MLTwkBeforeTargets)' == '' and '$(MLTwkAfterTargets)' == '' and '$(ConfigurationType)' != 'Makefile'">
    <MLTwkBeforeTargets>ClCompile</MLTwkBeforeTargets>
    <MLTwkAfterTargets>CustomBuild</MLTwkAfterTargets>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <MlTwk>
      <DoCompileAndLink Condition="$(Configuration.Contains('Debug')) == 'true' and $(Configuration.Contains('Release')) == 'false'">false</DoCompileAndLink>
      <DoCompileAndLink Condition="$(Configuration.Contains('Debug')) == 'false' or '$(Configuration)' == 'Release Debug'">true</DoCompileAndLink>
      <ObjectFileName>$(IntDir)%(Filename)_Twk.cpp</ObjectFileName>
      <MinimalRebuildFromTracking>true</MinimalRebuildFromTracking>
    </MlTwk>
  </ItemDefinitionGroup>
</Project>
