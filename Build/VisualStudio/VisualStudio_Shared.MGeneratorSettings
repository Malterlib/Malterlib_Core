GeneratorSetting
{
	Dependency_Indirect {}
	{
		!!GeneratorSetting.Dependency_Indirect undefined
	}
	Dependency_IndirectOrdered {}
	{
		!!GeneratorSetting.Dependency_IndirectOrdered undefined
	}
	Dependency_Name {}
	{
		!!GeneratorSetting.Dependency_Name undefined
	}

	Dependency_Type {
		VSSettings: {
			"@Include": Dependency.Name
		}
	}
	{
		!!GeneratorSetting.Dependency_Type undefined
	}

	VisualStudio_DependencyType SwitchWithError(
		Dependency.Type, "Unknown dependency type: "
		, "", "ProjectReference"
		, "AssemblyReference", "Reference"
		, "Library", ""
	)
	{
		!!Target.Language "Native"
	}

	VisualStudio_DependencyType SwitchWithError(
		Dependency.Type, "Unknown dependency type: "
		, "", "ProjectReference"
		, "AssemblyReference", "Reference"
		, "Package", "PackageReference"
	)
	{
		!!LanguageFamily ".NET"
	}

	Dependency_Version {
		VSSettings: {
			"@Version": Dependency.Version
		}
	}
	{
		!!Dependency.Type "Package"
	}

	Dependency_Version {
		VSSettings: {
			"SpecificVersion": Dependency.Version
		}
	}
	{
		!!Dependency.Type "AssemblyReference"
	}
}
