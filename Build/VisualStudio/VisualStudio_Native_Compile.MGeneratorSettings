%GeneratorSetting "Native_CompileShared"
{
	%GeneratorSetting "Compile"
	{
		%GeneratorSetting "Disabled"
		{
			Property
			{
				Name "ExcludedFromBuild"
			}
			%GeneratorSetting "Value"
			{
				Property
				{
					true true
					false false
				}
			}
		}
		%GeneratorSetting "Optimize"
		{
			Property
			{
				Disabled "1"
			}
		}
		%GeneratorSetting "Verbose"
		{
			Property
			{
				Name "SuppressStartupBanner"
			}
			%GeneratorSetting "Value"
			{
				Property
				{
					true ""
					false "true"
					"" "true"
				}
			}
		}
		%GeneratorSetting "DocumentationModule"
		{
			Property
			{
				Name "AdditionalOptions"
				Substitute "--documentation-module {} %(ClCompile.AdditionalOptions)"
			}
		}
		%GeneratorSetting "ToolClass"
		{
			Property
			{
				Name "AdditionalOptions"
				Substitute "--ToolClass {} %(ClCompile.AdditionalOptions)"
			}
		}
		%GeneratorSetting "ObjectFileName"
		{
			Property.Name "ObjectFileName"
		}
	}
}
