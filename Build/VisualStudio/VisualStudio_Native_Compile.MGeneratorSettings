GeneratorSetting
{
	!!Target.Language "Native"

	Compile_Custom_VerifyInputsAndOutputsExist {}
	{
		!!GeneratorSetting.Compile_Custom_VerifyInputsAndOutputsExist undefined
	}
	Compile_Custom_Optimize {}
	{
		!!GeneratorSetting.Compile_Custom_Optimize undefined
	}
	Compile_DisableSecurityWarnings {}
	{
		!!GeneratorSetting.Compile_DisableSecurityWarnings undefined
	}
	Compile_Analyzer {}
	{
		!!GeneratorSetting.Compile_Analyzer undefined
	}

	Compile_Disabled =+ {
		VSSettings: {
			ExcludedFromBuild: Compile.Disabled->f_BoolToString()
		}
	}

	Compile_Verbose =+ {
		VSSettings: {
			SuppressStartupBanner: Compile.Verbose->SwitchWithError("Unsupported option: "
				, true, ""
				, false, "true"
				, "", "true"
			)
		}
	}

	Compile_DocumentationModule =+ {
		VSSettings: {
			AdditionalOptions: `--documentation-module @(Compile.DocumentationModule->Escape()->EscapeMSBuild()) @(Builtin.Inherit)`
		}
	}

	Compile_ToolClass =+ {
		VSSettings: {
			AdditionalOptions: `--malterlib-command-BA49ADC8-6CAA-4E8C-BA13-3A9273859D89 @(Compile.ToolClass->Escape()->EscapeMSBuild()) @(Builtin.Inherit)`
		}
	}

	Compile_ObjectFileName =+ {
		VSSettings: {
			ObjectFileName: Compile.ObjectFileName->EscapeMSBuild()
		}
	}
}

