%GeneratorSetting "CSharp_ImportTargets"
{
	%GeneratorSetting "Targets"
	{
		Property
		{
			A0 "$(MSBuildToolsPath)\\Microsoft.CSharp.targets"
		}
	}		
}
%GeneratorSetting "CSharp_Root"
{
	%GeneratorSetting "Target"
	{
		%GeneratorSetting "Type"
		{
			Property
			{
				Name "OutputType"
			}
			%GeneratorSetting "Value"
			{
				Property
				{
					Executable WinExe
					ConsoleExecutable Exe
					UIExecutable WinExe
					DynamicLibrary Library
					SharedDynamicLibrary Library
				}
			}
		}
		%GeneratorSetting "IntermediateDirectory"
		{
			Property
			{
				Name BaseIntermediateOutputPath
			}
			%GeneratorSetting "Properties"
			{
				%GeneratorSetting ""
				{
					%GeneratorSetting ""
					{
						%GeneratorSetting "IntermediateOutputPath"
					}
				}
			}
		}
		%GeneratorSetting "OutputDirectory"
		{
			Property
			{
				Name "OutputPath"
			}
		}
	}
	%GeneratorSetting "Compile"
	{
		%GeneratorSetting "Type"
		{
			%GeneratorSetting "ValueSet"
			{
				%GeneratorSetting "EmbeddedResource_ResX"
				{
					%GeneratorSetting ""
					{
						%GeneratorSetting ""
						{
							Property
							{
								Generator "ResXFileCodeGenerator"
								SubType "Designer"
							}
						}
					}
				}
				%GeneratorSetting "Settings"
				{
					%GeneratorSetting ""
					{
						%GeneratorSetting ""
						{
							Property
							{
								Generator "SettingsSingleFileGenerator"
								SubType "Designer"
							}
						}
					}
				}
				%GeneratorSetting "C#Component"
				{
					%GeneratorSetting ""
					{
						%GeneratorSetting ""
						{
							Property
							{
								SubType "Component"
							}
						}
					}
				}
				%GeneratorSetting "ApplicationDefinition"
				{
					%GeneratorSetting ""
					{
						%GeneratorSetting ""
						{
							Property
							{
								Generator "MSBuild:Compile"
								SubType Designer
							}
						}
					}
				}
				%GeneratorSetting "Page"
				{
					%GeneratorSetting ""
					{
						%GeneratorSetting ""
						{
							Property
							{
								Generator "MSBuild:Compile"
								SubType Designer
							}
						}
					}
				}
				%GeneratorSetting "AppxManifest"
				{
					%GeneratorSetting ""
					{
						%GeneratorSetting ""
						{
							Property
							{
								SubType Designer
							}
						}
					}
				}
			}
			%GeneratorSetting "Value"
			{
				Property
				{
					C# Compile
					C#Component Compile
					ApplicationDefinition ApplicationDefinition
					Page Page
					EmbeddedResource_ResX EmbeddedResource
					Settings None
					None None
					AppDesigner AppDesigner
					AppxManifest AppxManifest
				}
			}
		}
	}
}
