GeneratorSetting
{
	!!Target.Language "C#"

	Target_Type =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Configuration"
				, Key: "OutputType"
				, Value: Target.Type->SwitchWithError(
					"Unsupported target type: "
					, "Executable", "WinExe"
					, "ConsoleExecutable", "Exe"
					, "UIExecutable", "WinExe"
					, "DynamicLibrary", "Library"
					, "SharedDynamicLibrary", "Library"
				)
			}
		]
	}
}

GeneratorSetting
{
	!!Target.Language "C#"

	VisualStudio_FileType SwitchWithError(
		Compile.Type, "Unknown compile type: "
		, "C#", "Compile"
		, "C#Component", "Compile"
		, "ApplicationDefinition", "ApplicationDefinition"
		, "Page", "Page"
		, "EmbeddedResource_ResX", "EmbeddedResource"
		, "Settings", "None"
		, "None", "None"
		, "AppDesigner", "AppDesigner"
		, "AppxManifest", "AppxManifest"
	)

	Compile_Type =+ {
		VSSettings: Compile.Type->SwitchWithDefault(
			{}
			, "EmbeddedResource_ResX", {
				Generator: "ResXFileCodeGenerator"
				, SubType: "Designer"
			}
			, "Settings", {
				Generator: "SettingsSingleFileGenerator"
				, SubType: "Designer"
			}
			, "C#Component", {
				SubType: "Component"
			}
			, "ApplicationDefinition", {
				Generator: "MSBuild:Compile"
				, SubType: "Designer"
			}
			, "Page", {
				Generator: "MSBuild:Compile"
				, SubType: "Designer"
			}
			, "AppxManifest", {
				SubType: "Designer"
			}
		)
	}
}
