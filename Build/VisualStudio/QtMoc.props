<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <UsingTask TaskName="SetEnv" AssemblyFile="$(VCTargetsPath)Microsoft.Build.CppTasks.Common.Base.dll"/>	
  <PropertyGroup
    Condition="'$(QtMocBeforeTargets)' == '' and '$(QtMocAfterTargets)' == '' and '$(ConfigurationType)' != 'Makefile'">
    <QtMocBeforeTargets>ClCompile</QtMocBeforeTargets>
    <QtMocAfterTargets>CustomBuild</QtMocAfterTargets>
  </PropertyGroup>
  <PropertyGroup
    Condition="'$(QtUicBeforeTargets)' == '' and '$(QtUicAfterTargets)' == '' and '$(ConfigurationType)' != 'Makefile'">
    <QtUicBeforeTargets>ClCompile</QtUicBeforeTargets>
    <QtUicAfterTargets>CustomBuild</QtUicAfterTargets>
  </PropertyGroup>
  <PropertyGroup
    Condition="'$(QtRccBeforeTargets)' == '' and '$(QtRccAfterTargets)' == '' and '$(ConfigurationType)' != 'Makefile'">
    <QtRccBeforeTargets>ClCompile</QtRccBeforeTargets>
    <QtRccAfterTargets>CustomBuild</QtRccAfterTargets>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <QtMoc>
      <PreprocessOnly>false</PreprocessOnly>
      <DoNotGenerateInclude>false</DoNotGenerateInclude>
      <DoNotDisplayWarnings>false</DoNotDisplayWarnings>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <DoCompileAndLink>true</DoCompileAndLink>
      <ObjectFileName>$(IntermediateOutputPath)%(Filename)_Moc.cpp</ObjectFileName>
      <IncludePathPrefix></IncludePathPrefix>
      <PreprocessorDefinitions></PreprocessorDefinitions>
      <PreprocessorUnDefinitions></PreprocessorUnDefinitions>
      <AdditionalIncludeDirectories></AdditionalIncludeDirectories>
      <CommandLineTemplate>moc.exe [AllOptions] [AdditionalOptions] [Inputs]</CommandLineTemplate>
      <ExecutionDescription>moc %(Identity)</ExecutionDescription>
      <MinimalRebuildFromTracking>true</MinimalRebuildFromTracking>
    </QtMoc>
    <QtUic>
      <ObjectFileName>$(IntermediateOutputPath)%(Filename)_UI.h</ObjectFileName>
      <AdditionalIncludeDirectories></AdditionalIncludeDirectories>
      <DisplayDependencies>false</DisplayDependencies>
      <NoProtection>false</NoProtection>
      <NoImplicitIncludes>false</NoImplicitIncludes>
      <CommandLineTemplate>uic.exe [AllOptions] [AdditionalOptions] [Inputs]</CommandLineTemplate>
      <ExecutionDescription>uic %(Identity)</ExecutionDescription>
      <MinimalRebuildFromTracking>true</MinimalRebuildFromTracking>
    </QtUic>
    <QtRcc>
      <DoCompileAndLink>true</DoCompileAndLink>
      <ObjectFileName>$(IntermediateOutputPath)%(Filename)_Res.cpp</ObjectFileName>
      <InitFunc>%(Filename)</InitFunc>
      <Namespace>false</Namespace>
      <NoCompress>false</NoCompress>
      <CommandLineTemplate>rcc.exe [AllOptions] [AdditionalOptions] [Inputs]</CommandLineTemplate>
      <ExecutionDescription>rcc %(Identity)</ExecutionDescription>
      <MinimalRebuildFromTracking>true</MinimalRebuildFromTracking>
    </QtRcc>
  </ItemDefinitionGroup>
</Project>
