GeneratorSetting
{
	!!LanguageFamily ".NET"

	Compile_Verbose {}
	{
		!!GeneratorSetting.Compile_Verbose undefined
	}

	// Generic
	Compile_Optimize =+ {
		VSSettings: {
			Optimize: Compile.Optimize->SwitchWithError(
				"Unsupported option: "
				"Off", "false"
				"On", "true"
				"Fast", "true"
				"Full", "true"
			)
		}
	}
	{
		!GeneratorSetting.IsFile true
	}

	Compile_PreprocessorDefines =+ {
		VSSettings: {
			DefineConstants: Compile.PreprocessorDefines->f_JoinMSBuild()
		}
	}
	{
		!GeneratorSetting.IsFile true
	}

	// Non-files
	Compile_Symbols =+ {
		VSSettings: {
			DebugType: Compile.Symbols->SwitchWithError(
				"Unsupported option: "
				, "FullForDebug", "full"
				, "Full", "pdbonly"
				, "Fast", "pdbonly"
				, "None", "none"
			)
		}
	}
	{
		!GeneratorSetting.IsFile true
	}

	Compile_Warnings =+ {
		VSSettings: {
			WarningLevel: Compile.Warnings->SwitchWithError(
				"Unsupported option: "
				"Off", "0"
				"Minimal", "1"
				"On", "3"
				"Pedantic", "4"
			)
		}
	}
	{
		!GeneratorSetting.IsFile true
	}

	// Files only
	Compile_AutoGen =+ {
		VSSettings: {
			AutoGen: Compile.AutoGen->f_BoolToStringDotNet()
		}
	}
	{
		!!GeneratorSetting.IsFile true
	}

	Compile_DesignTimeSharedInput =+ {
		VSSettings: {
			DesignTimeSharedInput: Compile.DesignTimeSharedInput->f_BoolToStringDotNet()
		}
	}
	{
		!!GeneratorSetting.IsFile true
	}

	Compile_DependentUpon =+ {
		VSSettings: {
			DependentUpon: Compile.DependentUpon->EscapeMSBuild()
		}
	}
	{
		!!GeneratorSetting.IsFile true
	}

	Compile_LastGenOutput =+ {
		VSSettings: {
			LastGenOutput: Compile.LastGenOutput->EscapeMSBuild()
		}
	}
	{
		!!GeneratorSetting.IsFile true
	}
}
