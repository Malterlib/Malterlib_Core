	Target_TargetFrameworkVersion =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "PreProject"
				, Key: "TargetFrameworkVersion"
				, Value: Target.TargetFrameworkVersion->EscapeMSBuild()
			}
		]
	}
	{
		&
		{
			!LanguageFamily ".NET"
			!Target.CLRSupport "NetCore"
		}
	}

	Target_TargetFrameworkVersion =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "PreProject"
				, Key: "TargetFramework"
				, Value: Target.TargetFrameworkVersion->EscapeMSBuild()
			}
		]
	}
	{
		|
		{
			LanguageFamily ".NET"
			Target.CLRSupport "NetCore"
		}
	}

	Target_PlatformVersion =+ {
		VSSettings: [
			{
				Type: "PropertyGroup"
				, Label: "Globals"
				, Key: "WindowsTargetPlatformVersion"
				, Value: Target.PlatformVersion->EscapeMSBuild()
			}
		]
	}

