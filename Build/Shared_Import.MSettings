Property
{
	ImportIdentityRelativeRootPath define string
	ImportIdentityRelativeRootPath Import:this.IdentityAsAbsolutePath->GetPath()->MakeRelative(Builtin.BasePathAbsolute)

	IsMaintainedConfig define bool
	IsMaintainedConfig true
	{
		&
		{
			IsMaintainedConfig undefined
			|
			{
				Import.CMake_Config "Debug"
				Import.CMake_Config "Release"
			}
		}
	}

	MalterlibImportUpdateCache define bool = false
	MalterlibImportUpdateCache true
	{
		&
		{
			MalterlibImportUpdateCache undefined
			!MalterlibBuildServerBuild true
		}
	}
}

Import
{
	SharedTempDirectory `@(MalterlibCompiledFilesSourceBase)/@(BuildSystemName)/Generated/@(ImportIdentityRelativeRootPath->Replace("/", "_"))`
	TempDirectory `@(Import.SharedTempDirectory)/@(Platform)/@(Architecture)/@(Import.CMake_Config)`
}

Property
{
	MToolCMakePath define string
	MToolCMakePath MToolDirectory / ("MToolCMake" + (Builtin.MToolExe->GetExtension() && ("." + Builtin.MToolExe->GetExtension())))

	CMakeIntermediateDirectory define string = `@(MalterlibCompiledFilesSourceBase)/@(Workspace:Workspace.Name)/Intermediate/SharedCMake/@(Platform)/@(Architecture)/@(FullConfiguration)`
}

Compile
{
	&
	{
		CompileDialect "C"
		HasParentEntity("Import") true
	}

	SearchPath += CMakeIntermediateDirectory / Import.CMake_IntermediateName
	SearchPath += Import.CMake_CacheDirectory
}

Import
{
	CMake_AlwaysFullRebuild define bool = true // User(Import)=false: Always do a full rebuild of cmake generation when the cache is outdated
	CMake_VerboseHash define bool = false // User(Import)=true: Trace out the string used to determine the config hash for cmake imports
	CMake_DiffHash define bool = false // User(Import)=true: Run diff program with differences between hashes

	CMake_FullRebuildVersion "4"

	CMake_UpdateCache true
	{
		&
		{
			Import.CMake_UpdateCache undefined
			MalterlibImportUpdateCache true
		}
	}
	CMake_IntermediateName ImportIdentityRelativeRootPath->Replace("/", "_")
	CMake_CacheDirectory `@(Import:this.IdentityPath->GetPath())/ImportCache/@(ImportIdentityRelativeRootPath->Replace("/", "_"))-@(Platform)-@(Architecture)-@(Import.CMake_Config)`
	{
		!!IsMaintainedConfig true
	}
	CMake_CacheDirectory `@(Builtin.BasePathAbsolute)/ImportCache/@(ImportIdentityRelativeRootPath->Replace("/", "_"))-@(Platform)-@(Architecture)-@(Import.CMake_Config)`
	{
		!IsMaintainedConfig true
	}

	CMake_ReplacePrefixes =+ { Find: `@(Import.TempDirectory)`, Replace: `@(Import.SharedTempDirectory)/@(Platform)/@(Architecture)/\`@@(FullConfiguration)\`` }

	CMake_CacheExcludePatterns =+ [
		"*/CMakeFiles/*"
		, "*/cmake.tmp/*"
		, "*/cmake_install.cmake"
		, "*/CPackConfig.cmake"
		, "*/CPackSourceConfig.cmake"
		, "*/CTestTestfile.cmake"
		, "*.ninja"
		, "*/CMakeCache.txt"
		, "*/MalterlibFullRebuildVersion"
		, "*/.NoDartCoverage"
		, "*/compile_commands.json"
	]

	CMake_ExcludeFromHash =+ `@@(@((MToolCMakePath)->EJSONToString())->MakeAbsolute())`->EJSONToString()
	CMake_ExcludeFromHash =+ `@@(@((MToolCMakePath)->EJSONToString())->MakeAbsolute()->EscapeHost())`->EJSONToString()

	CMake_ExcludeFromHash =+ PlatformToolsetCompiler->GetPath() + "/"
	{
		!PlatformToolsetCompiler undefined
	}

	CMake_CacheReplaceContents =+ [
		{Find: "C:/Go/bin/", Replace: ""}
		, {Find: "C:\\Go\\bin\\", Replace: ""}
		, {Find: "C:\\\\Go\\\\bin\\\\", Replace: ""}
		, {Find: "C:/Program Files/Go/bin/", Replace: ""}
		, {Find: "C:\\Program Files\\Go\\bin\\", Replace: ""}
		, {Find: "C:\\\\Program Files\\\\Go\\\\bin\\\\", Replace: ""}
		, {Find: "C:/Python39/", Replace: ""}
		, {Find: "C:\\Python39\\", Replace: ""}
		, {Find: "C:\\\\Python39\\\\", Replace: ""}
		, {Find: "C:/strawberry/perl/bin/", Replace: ""}
		, {Find: "C:\\strawberry\\perl\\bin\\", Replace: ""}
		, {Find: "C:\\\\strawberry\\\\perl\\\\bin\\\\", Replace: ""}
		, {Find: "c:/Program Files/Git/bin/", Replace: ""}
		, {Find: "c:\\Program Files\\Git\\bin\\", Replace: ""}
		, {Find: "c:\\\\Program Files\\\\Git\\\\bin\\\\", Replace: ""}
		, {Find: "c:/Program Files/Git/usr/bin/", Replace: ""}
		, {Find: "c:\\Program Files\\Git\\usr\\bin\\", Replace: ""}
		, {Find: "c:\\\\Program Files\\\\Git\\\\usr\\\\bin\\\\", Replace: ""}
	]
	{
		!!HostPlatformFamily "Windows"
	}

	CMake_CacheReplaceContents =+ [
		{Find: `@@(@((MToolCMakePath)->EJSONToString())->MakeAbsolute())`, Replace: "MToolCMake"}
		, {Find: `@@(@((MToolCMakePath)->EJSONToString())->MakeAbsolute()->EscapeHost())`, Replace: "MToolCMake"}
		, {Find: "/opt/local/bin/", Replace: ""}
		, {Find: "/usr/bin/", Replace: ""}
		, {Find: "/opt/homebrew/bin/", Replace: ""}
		, {Find: "/usr/local/go/bin/", Replace: ""}
		, {Find: "/usr/local/bin/", Replace: ""}
	]

	CMake_Config "Release"
	{
		&
		{
			Import.CMake_Config undefined
			|
			{
				Configuration "Release"
				Configuration "Profile"
				Configuration "Optimized"
				Configuration "Release Debug"
				Configuration "Release Testing"
			}
		}
	}
	CMake_Config "Debug"
	{
		!!Import.CMake_Config undefined
	}

	CMake_Languages =+ [
		{CMakeLanguage: "C", MalterlibLanguage: "C"},
		{CMakeLanguage: "CXX", MalterlibLanguage: "C++"},
		{CMakeLanguage: "OBJCXX", MalterlibLanguage: "ObjC++"},
		{CMakeLanguage: "ASM", MalterlibLanguage: "Assembler"}
	]

	CMake_Languages =+ [
		{CMakeLanguage: "ASM_NASM", MalterlibLanguage: "AssemblerNasm"},
		{CMakeLanguage: "ASM_MASM", MalterlibLanguage: "Assembler"},
		{CMakeLanguage: "RC", MalterlibLanguage: "WindowsResource"},
	]
	{
		!!GeneratorFamily "VisualStudio"
	}

	CMake_TryCompilePlatformVariables define [string] = []

	CMake_TryCompilePlatformVariables =+ [
		"CMAKE_EXE_LINKER_FLAGS_INIT"
		, "CMAKE_STATIC_LINKER_FLAGS_INIT"
		, "CMAKE_MODULE_LINKER_FLAGS_INIT"
		, "CMAKE_SHARED_LINKER_FLAGS_INIT"
		, "CMAKE_RANLIB"
		, "CMAKE_AR"
		, "CMAKE_C_COMPILER"
		, "CMAKE_CXX_COMPILER"
		, "CMAKE_CXX_COMPILER_TARGET"
		, "CMAKE_C_COMPILER_TARGET"
		, "CMAKE_TOOLCHAIN_NO_PREFIX"
		, "CMAKE_FIND_ROOT_PATH"
		, "CMAKE_SYSROOT"
		, "CMAKE_C_COMPILER_EXTERNAL_TOOLCHAIN"
		, "CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN"
		, "CMAKE_SYSTEM_NAME"
		, "CMAKE_SYSTEM_PROCESSOR", "CMAKE_LINKER"
	]
	{
		|
		{
			PlatformFamily "Linux"
			PlatformFamily "OSX"
		}
	}

	CMake_TryCompilePlatformVariables =+ "CMAKE_OSX_SYSROOT"
	{
		!!PlatformFamily "OSX"
	}

	CMake_Variables =+ [`CMAKE_TRY_COMPILE_PLATFORM_VARIABLES=@(Import.CMake_TryCompilePlatformVariables->Join(";"))`]
	{
		!Import.CMake_TryCompilePlatformVariables []
	}

	CMake_Internal_LinkerFlags define string?

	CMake_Internal_LinkerFlags =+ ` -stdlib=libc++`
	{
		!!PlatformFamily "OSX"
	}

	CMake_Internal_LinkerFlags =+ ` -fuse-ld=@(Malterlib_LinuxLinker) -stdlib=libc++`
	{
		&
		{
			PlatformFamily "Linux"
			!Malterlib_LinuxLinker undefined
		}
	}

	CMake_Internal_LinkerFlags =+ ` -L@(`@(MalterlibLLVMBinariesDirectory)/lib/@(MalterlibTargetTriple)/c++`->EscapeHost())`
	{
		!!PlatformFamily "Linux"
	}

	CMake_Internal_LinkerFlags =+ ` -Xlinker -rpath-link -Xlinker @(`@(MalterlibSysRoot)/lib32`->EscapeHost()) -Xlinker -rpath-link -Xlinker @(`@(MalterlibSysRoot)/usr/lib32`->EscapeHost())`
	{
		&
		{
			PlatformFamily "Linux"
			Architecture "x86"
		}
	}

	CMake_Variables =+ "CMAKE_OBJECT_PATH_MAX=4096"

	CMake_Variables =+ [`CMAKE_EXE_LINKER_FLAGS_INIT=@(Import.CMake_Internal_LinkerFlags)`]
	{
		!Import.CMake_Internal_LinkerFlags undefined
	}

	CMake_Variables =+ [`CMAKE_MODULE_LINKER_FLAGS_INIT=@(Import.CMake_Internal_LinkerFlags)`]
	{
		!Import.CMake_Internal_LinkerFlags undefined
	}

	CMake_Variables =+ [`CMAKE_SHARED_LINKER_FLAGS_INIT=@(Import.CMake_Internal_LinkerFlags)`]
	{
		!Import.CMake_Internal_LinkerFlags undefined
	}

	CMake_Variables =+ ["CMAKE_CXX_FLAGS_INIT=-stdlib=libc++"]
	{
		|
		{
			PlatformFamily "Linux"
			PlatformFamily "OSX"
		}
	}

	CMake_Variables =+ [`CMAKE_LINKER=@(Malterlib_LinuxLinker)`]
	{
		&
		{
			PlatformFamily "Linux"
			!Malterlib_LinuxLinker undefined
		}
	}

	CMake_Variables =+ ["CMAKE_LINKER=ld"]
	{
		&
		{
			PlatformFamily "OSX"
		}
	}

	CMake_Variables =+ [`CMAKE_INSTALL_NAME_TOOL=@(PlatformToolsetCompiler->GetPath())/llvm-install-name-tool`]
	{
		|
		{
			PlatformFamily "Linux"
			PlatformFamily "OSX"
		}
	}

	CMake_Variables =+ [`CMAKE_NM=@(PlatformToolsetCompiler->GetPath())/llvm-nm`]
	{
		|
		{
			PlatformFamily "Linux"
			PlatformFamily "OSX"
		}
	}

	CMake_Variables =+ [`CMAKE_OBJDUMP=@(PlatformToolsetCompiler->GetPath())/llvm-objdump`]
	{
		|
		{
			PlatformFamily "Linux"
			PlatformFamily "OSX"
		}
	}

	CMake_Variables =+ [`CMAKE_STRIP=@(PlatformToolsetCompiler->GetPath())/llvm-strip`]
	{
		|
		{
			PlatformFamily "Linux"
			PlatformFamily "OSX"
		}
	}

	CMake_Variables =+ [`CMAKE_RANLIB=@(PlatformToolsetCompiler->GetPath())/llvm-ranlib`]
	{
		|
		{
			PlatformFamily "Linux"
			PlatformFamily "OSX"
		}
	}

	CMake_Variables =+ [`CMAKE_AR=@(PlatformToolsetCompiler->GetPath())/llvm-ar`]
	{
		|
		{
			PlatformFamily "Linux"
			PlatformFamily "OSX"
		}
	}

	CMake_Variables =+ [
		`CMAKE_OSX_DEPLOYMENT_TARGET=@(Platform->ParseFormatString("OSX{}.{}", "{0}.{1}"))`
		, `CMAKE_OSX_SYSROOT=@((MalterlibMaxSupportedOSXVersion == "Latest") ?
		"/private/var/db/xcode_select_link/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk" :
		`/private/var/db/xcode_select_link/Platforms/MacOSX.platform/Developer/SDKs/MacOSX@(MalterlibMaxSupportedOSXVersion).sdk`)`
	]
	{
		!!PlatformFamily "OSX"
	}

	CMake_Variables =+ "CMAKE_OSX_ARCHITECTURES=x86_64"
	{
		&
		{
			PlatformFamily "OSX"
			Architecture "x64"
		}
	}
	CMake_Variables =+ "CMAKE_OSX_ARCHITECTURES=arm64"
	{
		&
		{
			PlatformFamily "OSX"
			Architecture "arm64"
		}
	}
	CMake_Variables =+ "CMAKE_OSX_ARCHITECTURES=arm64e"
	{
		&
		{
			PlatformFamily "OSX"
			Architecture "arm64e"
		}
	}

	CMake_ExcludeFromHash =+ [`@(MalterlibDependenciesDirectory)/`]
	CMake_ExcludeFromHash =+ Builtin.BasePathAbsolute
	CMake_ExcludeFromHash =+ Import.TempDirectory
	CMake_ExcludeFromHash =+ Builtin.CMakeRoot
	CMake_ExcludeFromHash =+ [MalterlibCompiledFiles]
	CMake_ExcludeFromHash =+ [`@(MalterlibSysRoot)/`]
	{
		&
		{
			PlatformFamily "Linux"
			Architecture "x86"
		}
	}

	CMake_SystemName "Darwin"
	{
		&
		{
			Import.CMake_SystemName undefined
			PlatformFamily "OSX"
		}
	}

	CMake_SystemName PlatformFamily
	{
		&
		{
			Import.CMake_SystemName undefined
		}
	}

	CMake_SystemProcessor "x86_64"
	{
		&
		{
			!Import.CMake_SystemName undefined
			Import.CMake_SystemProcessor undefined
			Architecture "x64"
		}
	}

	CMake_SystemProcessor Architecture
	{
		&
		{
			!Import.CMake_SystemName undefined
			Import.CMake_SystemProcessor undefined
		}
	}

	CMake_CrossCompileValue define string = `CMAKE_CROSSCOMPILING=@((PlatformFamily == HostPlatformFamily && Architecture == HostArchitecture) ? "OFF" : "ON")`
	CMake_Variables =+ Import.CMake_CrossCompileValue
	CMake_ExcludeFromHash =+ Import.CMake_CrossCompileValue

	CMake_CCompiler PlatformToolsetCompiler->UnixPath()
	{
		&
		{
			!PlatformToolsetCompiler undefined
		}
	}

	CMake_CxxCompiler PlatformToolsetCompiler->UnixPath()
	{
		&
		{
			HostPlatformFamily "Windows"
			!PlatformToolsetCompiler undefined
		}
	}

	CMake_CxxCompiler `@(PlatformToolsetCompiler->UnixPath())++`
	{
		&
		{
			!HostPlatformFamily "Windows"
			!PlatformToolsetCompiler undefined
		}
	}

	CMake_Path += [MToolDirectory]
}

Import
{
	!PlatformFamily "Windows"

	CMake_SysRoot MalterlibSysRoot
	{
		&
		{
			!MalterlibSysRoot undefined
			!Documentation "Doxygen"
		}
	}

	CMake_CCompilerTarget MalterlibTargetTriple
	CMake_CxxCompilerTarget MalterlibTargetTriple
	CMake_CExternalToolChain MalterlibToolsPrefix->Replace("/bin/", "/bin")
	CMake_CxxExternalToolChain MalterlibToolsPrefix->Replace("/bin/", "/bin")
}
