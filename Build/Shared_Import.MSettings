Property
{
	ImportIdentityRelativeRootPath "@(Import:this.IdentityAsAbsolutePath->GetPath())"
	ImportIdentityRelativeRootPath "@(ImportIdentityRelativeRootPath->MakeRelative(@(Builtin.BasePathAbsolute)))"
	
	IsMaintainedConfig "true"
	{
		&
		{
			IsMaintainedConfig ""
			|
			{
				Import.CMake_Config "Debug"
				Import.CMake_Config "Release"
			}
		}
	}
}


Import
{
	SharedTempDirectory "@(MalterlibCompiledFilesSourceBase)/@(BuildSystemName)/Generated/@(ImportIdentityRelativeRootPath->Replace('/', '_'))"
	TempDirectory "@(Import.SharedTempDirectory)/@(Platform)/@(Architecture)/@(Import.CMake_Config)"
}

Import
{
	CMake_UpdateCache "true"
	{
		&
		{
			Import.CMake_UpdateCache ""
			!MalterlibBuildServerBuild true
		}
	}
	CMake_CacheDirectory "@(Import:this.IdentityPath->GetPath())/ImportCache/@(ImportIdentityRelativeRootPath->Replace('/', '_'))-@(Platform)-@(Architecture)-@(Import.CMake_Config)"
	{
		!!IsMaintainedConfig true
	}
	CMake_CacheDirectory "@(Builtin.BasePathAbsolute)/ImportCache/@(ImportIdentityRelativeRootPath->Replace('/', '_'))-@(Platform)-@(Architecture)-@(Import.CMake_Config)"
	{
		!IsMaintainedConfig true
	}
	
	CMake_ReplacePrefixes "@(Import.TempDirectory)=@(Import.SharedTempDirectory)/@(Platform)/@(Architecture)/@@(FullConfiguration);@(CMake_ReplacePrefixes)"

	CMake_CacheExcludePatterns "*/CMakeFiles/*;*/cmake.tmp/*;*.cmake;*.ninja;*/CMakeCache.txt;*/MalterlibFullRebuildVersion;*/.NoDartCoverage;@(Import.CMake_CacheExcludePatterns)"
	
	CMake_CacheReplaceContents "/opt/local/bin/=;/usr/bin/=;/usr/local/bin/=;@(Import.CMake_CacheReplaceContents)"

	
	CMake_CacheReplaceContents "C:/Go/bin/=;C:/strawberry/perl/bin/=;@(Import.CMake_CacheReplaceContents)"
	{
		!!HostPlatformFamily "Windows"
	}

	CMake_Config "Release"
	{
		&
		{
			Import.CMake_Config ""
			|
			{
				Configuration "Release"
				Configuration "Profile"
				Configuration "Optimized"
				Configuration "Release Debug"
				Configuration "Release Testing"
			}
		}
	}
	CMake_Config "Debug"
	{
		!!Import.CMake_Config ""
	}
	CMake_Languages "C=C;CXX=C++;ASM=Assembler;@(Import.CMake_Languages)"
	CMake_Languages "ASM_NASM=AssemblerNasm;ASM_MASM=Assembler;RC=WindowsResource;@(Import.CMake_Languages)"
	{
		!!GeneratorFamily VisualStudio
	}

	CMake_Variables "CMAKE_TRY_COMPILE_PLATFORM_VARIABLES=CMAKE_EXE_LINKER_FLAGS_INIT;@(Import.CMake_Variables)"
	{
		&
		{
			PlatformFamily Linux
			Architecture x86
		}
	}

	CMake_Variables "CMAKE_EXE_LINKER_FLAGS_INIT=-Xlinker -rpath-link -Xlinker \"@(MalterlibSysRoot)/lib32\" -Xlinker -rpath-link -Xlinker \"@(MalterlibSysRoot)/usr/lib32\";@(Import.CMake_Variables)"
	{
		&
		{
			PlatformFamily Linux
			Architecture x86
		}
	}


	CMake_Variables "CMAKE_STATIC_LINKER_FLAGS_INIT=-Xlinker -rpath-link -Xlinker \"@(MalterlibSysRoot)/lib32\" -Xlinker -rpath-link -Xlinker \"@(MalterlibSysRoot)/usr/lib32\";@(Import.CMake_Variables)"
	{
		&
		{
			PlatformFamily Linux
			Architecture x86
		}
	}


	CMake_Variables "CMAKE_MODULE_LINKER_FLAGS_INIT=-Xlinker -rpath-link -Xlinker \"@(MalterlibSysRoot)/lib32\" -Xlinker -rpath-link -Xlinker \"@(MalterlibSysRoot)/usr/lib32\";@(Import.CMake_Variables)"
	{
		&
		{
			PlatformFamily Linux
			Architecture x86
		}
	}

	CMake_SystemName "Darwin"
	{
		&
		{
			Import.CMake_SystemName ""
			!PlatformFamily "@(HostPlatformFamily)" 
			PlatformFamily "OSX"
		}
	}
	
	CMake_SystemName "@(PlatformFamily)"
	{
		&
		{
			Import.CMake_SystemName ""
			!PlatformFamily "@(HostPlatformFamily)" 
		}
	}

	CMake_SystemProcessor "x86_64"
	{
		&
		{
			!Import.CMake_SystemName ""
			Import.CMake_SystemProcessor ""
			Architecture x64
		}
	}
	
	CMake_SystemProcessor "@(Architecture)"
	{
		&
		{
			!Import.CMake_SystemName ""
			Import.CMake_SystemProcessor ""
		}
	}

	CMake_CCompiler "@(PlatformToolsetCompiler->UnixPath())"
	{
		&
		{
			!PlatformToolsetCompiler ""
		}
	}

	CMake_CxxCompiler "@(PlatformToolsetCompiler->UnixPath())"
	{
		&
		{
			HostPlatformFamily Windows
			!PlatformToolsetCompiler ""
		}
	}

	CMake_CxxCompiler "@(PlatformToolsetCompiler->UnixPath())++"
	{
		&
		{
			!HostPlatformFamily Windows
			!PlatformToolsetCompiler ""
		}
	}
	
	CMake_Path "@(MToolDirectory);@(Import.CMake_Path)"
}

Import
{
	!PlatformFamily Windows

	CMake_SysRoot "@(MalterlibSysRoot)"
	{
		&
		{
			!MalterlibSysRoot ""
			!Documentation Doxygen
		}
	}
	
	CMake_CCompilerTarget "@(MalterlibTargetTriple)"
	CMake_CxxCompilerTarget "@(MalterlibTargetTriple)"
	CMake_CExternalToolChain "@(MalterlibToolsPrefix->Replace('/bin/', '/bin'))"
	CMake_CxxExternalToolChain "@(MalterlibToolsPrefix->Replace('/bin/', '/bin'))"
}
