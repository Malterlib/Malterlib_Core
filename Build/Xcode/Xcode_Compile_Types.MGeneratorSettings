GeneratorSetting
{
	!!Compiler "Clang"

	Compile_BuiltinSearchPath =+ {
		Flags: Compile.BuiltinSearchPath->f_PrefixFlags("-I")
		, Type: "unique"
		, XCConfigs: {
			"HEADER_SEARCH_PATHS": Compile.BuiltinSearchPath
		}
	}

	Compile_PrefixHeader =+ {
		XCConfigs: {
			"GCC_PREFIX_HEADER": Compile.PrefixHeader
		}
	}

	Compile_PrecompilePrefixHeader =+ {
		XCConfigs: {
			"GCC_PRECOMPILE_PREFIX_HEADER": Compile.PrecompilePrefixHeader->SwitchWithError(
				"Unsupported option: "
				, true, "YES"
				, false, "NO"
				, "XInternalCreate", []
			)
		}
	}
}

GeneratorSetting
{
	Compile_Custom_Shell += {}
	{
		!!GeneratorSetting.Compile_Custom_Shell undefined
	}

	Compile_RealCustom_Inputs += {}
	{
		!!GeneratorSetting.Compile_RealCustom_Inputs undefined
	}
}

GeneratorSetting
{
	!!Compile.Type "Assembler"

	Compile_SearchPath =+ {
		Flags: Compile.SearchPath->f_PrefixFlags("-I")
		, Type: "unique"
	}

	Compile_PreprocessorDefines =+ {
		Flags: Compile.PreprocessorDefines->f_PrefixFlags("-D")
		, Type: "unique"
	}

	Compile_AllCPUSubTypes =+ {
		Flags: Compile.AllCPUSubTypes->SwitchWithError(
			"Unsupported option: "
			, true, "-force_cpusubtype_ALL"
			, false, []
		)
		, Type: "unique"
	}

	Compile_Optimize {}
}
