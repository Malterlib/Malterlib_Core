GeneratorSetting
{
	!!Compiler "Clang"

	Compile_BuiltinSearchPath =+ {
		Flags: Compile.BuiltinSearchPath->f_PrefixFlags("-I")
		, Type: "unique"
		, XCConfigs: {
			"HEADER_SEARCH_PATHS": Compile.BuiltinSearchPath
		}
	}

	Compile_PrefixHeader =+ {
		XCConfigs: {
			"GCC_PREFIX_HEADER": Compile.PrefixHeader
		}
	}

	Compile_PrecompilePrefixHeader =+ {
		XCConfigs: {
			"GCC_PRECOMPILE_PREFIX_HEADER": Compile.PrecompilePrefixHeader->SwitchWithError(
				"Unsupported option: "
				, true, "YES"
				, false, "NO"
				, "XInternalCreate", []
			)
		}
	}
}

