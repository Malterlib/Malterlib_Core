Type
{
	CXcode_XCConfig: one_of(string, [one_of(string, [string])], bool)

	CXcode_PBXFileReference: {
		lastKnownFileType?: string
		, explicitFileType?: string
		, fileEncoding?: int
		, tabWidth?: int
		, usesTabs?: int
		, indentWidth?: int
	}

	CCompileSettings: {
		Flags?: one_of(string, [string], [[string]])
		, Type?: one_of("unique", "multiple")
		, XCConfigs?: {...: type(CXcode_XCConfig)}
	}

	CCompile_CompileFlag: {
		Value: one_of(string, [string], [[string]])
		, Positions: [type(CPosition)]
	}

	CCompile: {
		Type: type(CStringWithPosition)
		, PBXFileReference: type(CXcode_PBXFileReference)
		, XCConfigs: {...: type(CXcode_XCConfig)}
		, Flags: {...: type(CCompile_CompileFlag)}
	}

	CDependency: {
	}

	CWorkspace: {
	}

	CTarget: {
		Type: type(CStringWithPosition)
		, ProductType: type(CStringWithPosition)
		, Name: type(CStringWithPosition)
		, XCConfigs: {...: type(CXcode_XCConfig)}
	}
}

GeneratorSetting
{
	f_GetXCConfigs function(type(CCompileSettingsWithPosition) _CompileSettings) {...: type(CXcode_XCConfig)} = {}
	f_GetXCConfigs =+ Error(`Flags not allowed for target settings: @(_CompileSettings->ToString())`)
	{
		!!_CompileSettings<Value>->HasMember("Flags") true
	}
	f_GetXCConfigs =+ _CompileSettings<Value.XCConfigs>
	{
		!!_CompileSettings<Value>->HasMember("XCConfigs") true
	}
}

GeneratorSetting
{
	f_ExtractSettingsFlags function(type(CCompileSettingsWithPosition) _Setting) {...: type(CCompile_CompileFlag)} = {}

	f_ExtractSettingsFlags =+ {
		`@(_Setting<Property.Type>).@(_Setting<Property.Name>)`: {
			Value: _Setting<Value.Flags>->f_ExpandFlags()->Unique()
			, Positions: _Setting<Positions>
		}
	}
	{
		&
		{
			|
			{
				!_Setting<Value>->HasMember("Type") true
				_Setting<Value.Type> "unique"
			}
			_Setting<Value>->HasMember("Flags") true
			!_Setting<Value>->HasMember("XCConfigs") true
		}
	}
	f_ExtractSettingsFlags =+ {
		`@(_Setting<Property.Type>).@(_Setting<Property.Name>)`: {
			Value: _Setting<Value.Flags>
			, Positions: _Setting<Positions>
		}
	}
	{
		&
		{
			_Setting<Value>->HasMember("Type") true
			_Setting<Value.Type> "multiple"
			_Setting<Value>->HasMember("Flags") true
			!_Setting<Value>->HasMember("XCConfigs") true
		}
	}

	f_ExtractSettingsXCConfigs function(type(CCompileSettingsWithPosition) _Setting) {...: type(CXcode_XCConfig)} = {}
	f_ExtractSettingsXCConfigs =+ _Setting<Value.XCConfigs>
	{
		!!_Setting<Value>->HasMember("XCConfigs") true
	}

	f_ExtractSettings function([type(CCompileSettingsWithPosition)] _Settings) {
		XCConfigs: {...: type(CXcode_XCConfig)}
		, Flags: {
			...: type(CCompile_CompileFlag)
		}
	}

	f_ExtractSettings {
		XCConfigs: _Settings->ForEach(&GeneratorSetting.f_ExtractSettingsXCConfigs)
		, Flags: _Settings->ForEach(&GeneratorSetting.f_ExtractSettingsFlags)
	}
	{
		//#Debug "TraceEval"
	}

	Dependency {
	}
}

GeneratorSetting
{
	Dependency_Link {}
	Dependency_LinkWithObjectFiles {}
	Dependency_Indirect {}
	Dependency_IndirectOrdered {}
}

Import "Xcode_Target.MGeneratorSettings"
Import "Xcode_Compile.MGeneratorSettings"
