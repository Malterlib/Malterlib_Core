                    DefaultValue = YES;
                    CommandLineArgs = {
                            YES = ( "-objcmt-white-list-dir-path=$(TARGET_BUILD_DIR)/$(PUBLIC_HEADERS_FOLDER_PATH)" );
                            NO = ();
                    };
                    Category = "Modernizer";
            },
            {
                    Name = "CLANG_MIGRATOR_OBJC_LITERALS";
                    DisplayName = "ObjC literals";
