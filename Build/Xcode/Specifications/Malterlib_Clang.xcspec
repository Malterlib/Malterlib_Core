    {
               Identifier = "com.apple.compilers.llvm.clang.malterlib_generator.migrator";
               Type = Compiler;
               BasedOn = "com.apple.compilers.llvm.clang.malterlib_generator";
               Name = "ObjC Migrator";
               Description = "Apple Clang ObjC Migrator Generator";
               Architectures = (
                       i386,
                       "x86_64",
                        ppc,
                        "ppc64",
                       armv6,
                       armv7,
               );
               ExecPath = "$(MALTERLIB_GENERATOR_CLANG)";
               OutputDir = "$(TEMP_DIR)/Migrator";
               OutputFileExtension = remap;
               OutputsAreProducts = YES;
               IsAbstract = YES;
               CommandResultsPostprocessor = "XCClangResultsPostprocessor";
               "ShowInCompilerSelectionPopup" = NO;
               "ShowOnlySelfDefinedProperties" = YES;
               SourceFileOption = "--migrate";
               FileTypes = (
