    {
        Identifier = "com.apple.compilers.llvm.clang.malterlib_generator.astbuilder";
        Type = Compiler;
        BasedOn = "com.apple.compilers.llvm.clang.malterlib_generator";
        Name = "AST Builder";
		Description = "Apple Clang AST Builder 9.0";
        FileTypes = (
            "sourcecode.c.c",
            "sourcecode.c.objc",
            "sourcecode.cpp.cpp",
            "sourcecode.cpp.objcpp",
        );
        SourceFileOption = "-fsyntax-only";
        OverridingProperties = {  
            "ENABLE_HEADER_DEPENDENCIES" = YES;
            "SHARED_PRECOMPS_DIR" = "$(INDEX_PRECOMPS_DIR)";
            "CLEAN_PRECOMPS" = NO;
			"CLANG_RETAIN_COMMENTS_FROM_SYSTEM_HEADERS" = YES;
        };
        RuleName = "Build AST from $(InputFile)";
        OutputFileExtension = ast;
        IsAbstract = YES;
        ShowInCompilerSelectionPopup = NO;
        PrunePrecompiledHeaderCache = NO;
    },
)
