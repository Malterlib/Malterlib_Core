/**
    Moc build task
*/

{   Type = Compiler;
    Identifier = com.malterlib.compiler.qt.moc;
    Name = "Moc";
    Vendor = "Malterlib";
    Description = "Moc a header file containing a Qt object.";
	ProgressDescription = "Compiling $(CommandProgressByType) source files";
    CommandLine = "$(QT_TOOLS_ROOT)/moc $(InputFile) [options]";
    RuleName = "Moc $(InputFile)";
    ExecDescription = "Moc $(InputFile)";
    InputFileTypes = (
		sourcecode.c.h,
		sourcecode.c.qt.moc.cpp,
		sourcecode.c.h.nolink,
		sourcecode.c.qt.moc.cpp.nolink,
    );

    SynthesizeBuildRule = Yes;
    OutputsAreSourceFiles = Yes;

    CommandOutputParser = XCGccCommandOutputParser;
    Options = (
	{   Name = MOC_OUTPUT_PATTERN;
		Type = StringList;
		Category = BuildOptions;
		DefaultValue = "$(InputFileBase)$(InputFileBaseUniquefier).cpp";
		CommandLineArgs = "-o$(value)";
		Outputs = ( "$(MOC_OUTPUT_PATTERN)" );
		InputFileTypes = ( sourcecode.c.h );
	},
	{   Name = MOC_IDS_DEPENDENCY;
		Type = string;
		DefaultValue = "";
		Category = BuildOptions;
		CommandLineArgs = {
			"" = ();
			"<<otherwise>>" = ("-d", "$(value)");
		};
	},
	{   Name = MOC_MALTERLIB_DEPENDENCY;
		Type = string;
		DefaultValue = "";
		Category = BuildOptions;
		CommandLineArgs = {
			"" = ();
			"<<otherwise>>" = ("-d", "$(value)");
		};
	},
	{   Name = MOC_OUTPUT_PATTERN_NOLINK;
		Type = StringList;
		Category = BuildOptions;
		DefaultValue = "$(InputFileBase)$(InputFileBaseUniquefier).cpp";
		CommandLineArgs = "-o$(value)";
		Outputs = ( "$(MOC_OUTPUT_PATTERN_NOLINK).h" );
		InputFileTypes = ( sourcecode.c.h.nolink );
	},
	{   Name = MOC_OUTPUT_PATTERN_CPP;
		Type = StringList;
		Category = BuildOptions;
		DefaultValue = "$(InputFileBase)$(InputFileBaseUniquefier).moc";
		CommandLineArgs = "-o$(value)";
		Outputs = ( "$(MOC_OUTPUT_PATTERN_CPP)" );
		InputFileTypes = ( sourcecode.c.qt.moc.cpp );
	},
	{   Name = MOC_OUTPUT_PATTERN_CPP_NOLINK;
		Type = StringList;
		Category = BuildOptions;
		DefaultValue = "$(InputFileBase)$(InputFileBaseUniquefier).moc";
		CommandLineArgs = "-o$(value)";
		Outputs = ( "$(MOC_OUTPUT_PATTERN_CPP_NOLINK).h" );
		InputFileTypes = ( sourcecode.c.qt.moc.cpp.nolink );
	},
	{   Name = MOC_FORCE_INCLUDE;
		Type = PathList;
		Category = BuildOptions;
		DefaultValue = "";
		CommandLinePrefixFlag = "-f";
	},
	{   Name = MOC_AUTO_INCLUDE;
		Type = PathList;
		Category = BuildOptions;
		DefaultValue = "$(InputFile)";
		CommandLinePrefixFlag = "-f";
		InputFileTypes = ( sourcecode.c.h, sourcecode.c.h.nolink );
	},
	{   Name = MOC_NO_INCLUDES;
	    Type = bool;
	    DefaultValue = NO;
	    Category = BuildOptions;
	    CommandLineArgs = { YES = (-i); NO = (); };
	},
	{   Name = MOC_HEADER_SEARCH_PATHS;
	    Type = PathList;
	    DefaultValue = "$(QT_INCLUDE_ROOT)";
	    Category = BuildOptions;
	    CommandLinePrefixFlag = "-I";
	},
	{   Name = MOC_NO_WARNINGS;
	    Type = bool;
	    DefaultValue = NO;
	    Category = BuildOptions;
	    CommandLineArgs = { YES = (-nw); NO = (); };
	},
	{   Name = MOC_INCLUDE_PREFIX;
	    Type = String;
	    Category = BuildOptions;
	    DefaultValue = "";
	    CommandLinePrefixFlag = "-p";
	},
	{   Name = MOC_DEFINES;
	    Type = StringList;
	    Category = BuildOptions;
	    DefaultValue = "";
	    CommandLinePrefixFlag = "-D";
	},
	{   Name = MOC_OSX_FRAMEWORKS;
	    Type = PathList;
	    DefaultValue = "";
	    Category = BuildOptions;
	    CommandLinePrefixFlag = "-F";
	},
    );
}
