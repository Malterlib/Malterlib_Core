	f_ExtractLibraryDependencies function(string _ExternalDependency) [one_of([string], string)] = []

	f_FlagOrAbsolute function(string _Library) string
	f_FlagOrAbsolute _Library
	{
		!!_Library->IsAbsolute() true
	}
	f_FlagOrAbsolute `-l@(_Library)`
	{
		!_Library->IsAbsolute() true
	}

	f_ExtractLibraryDependencies =+ (&Dependency.Name->GetProperty(_ExternalDependency))->GeneratorSetting.f_FlagOrAbsolute()
	{
		&
		{
			|
			{
				TargetIsExecutable true
				!(&Dependency.Indirect->GetProperty(_ExternalDependency)) true
			}
			(&Dependency.Type->GetProperty(_ExternalDependency)) "Library"
		}
	}

	f_FrameworkOrAbsolute function(string _Library) [one_of(string, [string])]
	f_FrameworkOrAbsolute [_Library]
	{
		!!_Library->IsAbsolute() true
	}
	f_FrameworkOrAbsolute [["-framework", _Library]]
	{
		!_Library->IsAbsolute() true
	}

	f_ExtractLibraryDependencies =+ (&Dependency.Name->GetProperty(_ExternalDependency))->GeneratorSetting.f_FrameworkOrAbsolute()
	{
		&
		{
			|
			{
				TargetIsExecutable true
				!(&Dependency.Indirect->GetProperty(_ExternalDependency)) true
			}
			(&Dependency.Type->GetProperty(_ExternalDependency)) "Framework"
		}
	}

	Helper_LinkWithLibraries: [one_of([string], string)]?

	Helper_LinkWithLibraries =+ MalterlibOverrideMallocLibrary
	{
		!!MalterlibNeedsMallocOverrideLibrary true
	}
	Helper_LinkWithLibraries =+ Target.ExternalDependencies->ForEach(&GeneratorSetting.f_ExtractLibraryDependencies)->Unique()
	Helper_LinkWithLibraries =+ Target.LinkWithLibraries

	Helper_LinkWithLibraries =+ [["-exported_symbols_list", Target.ModuleDefinitionFile]]
	{
