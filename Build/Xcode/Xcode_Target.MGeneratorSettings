GeneratorSetting
{
	Xcode_TargetType: string
	Xcode_TargetType SwitchWithError(
		Target.Type, `Unknown target type: @(Target.Type)`
		, "Executable", "Application"
		, "ConsoleExecutable", "Application"
		, "UIExecutable", "Application"
		, "DynamicLibrary", "DynamicLibrary"
		, "XcodeBundle", "DynamicLibrary"
		, "SharedDynamicLibrary", "DynamicLibrary"
		, "StaticLibrary", "StaticLibrary"
		, "Driver", "Driver"
		, "Tool", "Makefile"
	)

	Target {
		Type: &GeneratorSetting.Xcode_TargetType->WithPosition()
		, ProductType: &Target.ProductType->WithPosition()
		, Name: &Target.Name->WithPosition()
		, XCConfigs: GeneratorSetting.DefinedProperties->ForEach(&GeneratorSetting.f_GetSettings)->ForEach(&GeneratorSetting.f_GetXCConfigs)
	}
}

