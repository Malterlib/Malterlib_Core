Property
{
	SharedBuildSettingsScriptContents: string = ""
	// Find base dir and export path
	SharedBuildSettingsScriptContents =+	`chcp 65001\r\n`\
											`SET RunVsDevCmd=true\r\n`\
											`IF "%1"=="false" SET RunVsDevCmd=false\r\n`\
											`set OriginalDirectory=%CD%\r\n`\
											`cd %~dp0..\r\n`\
											`set MalterlibBaseDir=%CD%\\\r\n`\
											`cd %OriginalDirectory%\r\n`\
											`set PATH=%MalterlibBaseDir%Binaries\\Malterlib\\@(HostPlatformFamily)\\@(HostArchitecture);%PATH%\r\n`\
											`\r\n`
	{
		&
		{
			HostPlatformFamily "Windows"
			ScriptWindowsBat true
		}
	}

	SharedBuildSettingsScriptContents =+	`export "MalterlibBaseDir=\`cd "${BASH_SOURCE%/*}/.." && pwd\`/"\r\n`\
											`export "PATH=${MalterlibBaseDir}Binaries/Malterlib/@(HostPlatformFamily)/@(HostArchitecture):$PATH"\r\n`
	{
		!HostPlatformFamily "Windows"
	}

	SharedBuildSettingsScriptContents =+	`export "MalterlibBaseDir=\`cd "${BASH_SOURCE%/*}/.." && pwd\`/"\r\n`\
											`export "PATH=${MalterlibBaseDir}Binaries/Malterlib/@(HostPlatformFamily)/@(HostArchitecture):$PATH"\r\n`\
											`function MTool()\r\n`\
											`{\r\n`\
											`	MTool.exe "$@@"\r\n`\
											`}\r\n`
	{
		&
		{
			HostPlatformFamily "Windows"
			ScriptWindowsBat false
		}
	}

	SharedBuildSettingsScriptContents =+ `@(ScriptExport("MalterlibSharedDeployRoot", MalterlibSharedDeployRoot))\r\n`

	SharedBuildSettingsScriptContents =+	`function ZMTool()\r\n`\
											`{\r\n`\
											`	MTool BuildServerTool Tool=ZMTool "$@@"\r\n`\
											`}\r\n`
	{
		!!ScriptWindowsBat false
	}

	SharedBuildSettingsScriptContents =+	`\r\n`\
											`TempDirectory=/tmp\r\n`\
											`if [ ! "$TEMP" == "" ] ; then\r\n`\
											`	TempDirectory="$TEMP"\r\n`\
											`elif [ ! "$TMP" == "" ] ; then\r\n`\
											`	TempDirectory="$TMP"\r\n`\
											`elif [ ! "$TMPDIR" == "" ] ; then\r\n`\
											`	TempDirectory="$TMPDIR"\r\n`\
											`fi\r\n`
	{
		!!ScriptWindowsBat false
	}

	SharedBuildSettingsScriptContents =+	`\r\n`\
											`@(ScriptExport("MalterlibBranch", MalterlibBranch))\r\n`\
											`@(ScriptExport("MalterlibBranchWindows", MalterlibBranch->WindowsPath()))\r\n`\
											`@(ScriptExport("MalterlibFullBranch", MalterlibFullBranch))\r\n`\
											`@(ScriptExport("MalterlibFullBranchWindows", MalterlibFullBranch->WindowsPath()))\r\n`\
											`@(ScriptExport("MalterlibGitBranch", (MalterlibGitBranch || "")))\r\n`\
											`@(ScriptExport("MalterlibGitCommit", MalterlibGitCommit))\r\n`\
											`@(ScriptExport("MalterlibGenerator", Generator))\r\n`\
											`@(ScriptExport("MalterlibBranchOnlyLast", MalterlibBranch->RemoveStartPaths(1)))\r\n`\
											`@(ScriptExport("MalterlibFullBranchOnlyLast", MalterlibFullBranch->RemoveStartPaths(1)))\r\n`\
											`@(ScriptExport("MalterlibSigning", MalterlibBuildSigning->ToString()))\r\n`\
											`@(ScriptExport("MalterlibSignIncludeCert", MalterlibSignIncludeCert->MakeAbsolute()))\r\n`\
											`@(ScriptExport("MalterlibSignTimestampServer", MalterlibSignTimestampServer))\r\n`\
											`@(ScriptExport("MalterlibSignTimestampServerRFC3161", MalterlibSignTimestampServerRFC3161))\r\n`\
											`@(ScriptExport("Win32SignToolTimestampServerOptions", Win32SignToolTimestampServerOptions))\r\n`\
											`@(ScriptExport("MalterlibSignCertMacOS", MalterlibSignCertMacOS))\r\n`\
											`@(ScriptExport("MalterlibSignCertWindows", MalterlibSignCertWindows))\r\n`\
											`@(ScriptExport("MalterlibDefaultPlatform", SinglePlatform ?? ""))\r\n`\
											`@(ScriptExport("MalterlibDefaultArchitecture", SingleArchitecture ?? ""))\r\n`\
											`@(ScriptExport("MalterlibDefaultConfiguration", SingleConfiguration ?? ""))\r\n`\
											`@(ScriptExport("MalterlibGeneratedBuildSystemDir", Builtin.GeneratedBuildSystemDir))\r\n`\
											`\r\n`\
											`@(ScriptExport("HostPlatformFamily", HostPlatformFamily))\r\n`\
											`@(ScriptExport("HostPlatform", HostPlatform))\r\n`\
											`@(ScriptExport("HostArchitecture", HostArchitecture))\r\n`\
											`@(ScriptExport("MalterlibDeployRoot", MalterlibDeployRoot))\r\n`\
											`@(ScriptExport("MalterlibCompiledFiles", MalterlibCompiledFiles))\r\n`\
											`@(ScriptExport("MalterlibCompiledFilesSourceBase", MalterlibCompiledFilesSourceBase))\r\n`\
											`@(ScriptExport("MalterlibDoingProductBuild", MalterlibDoingProductBuild->ToString()))\r\n`\
											`\r\n`\
											`@(ScriptExport("ProductVersionMajor", ProductVersionMajor->ToString()))\r\n`\
											`@(ScriptExport("ProductVersionMinor", ProductVersionMinor))\r\n`\
											`@(ScriptExport("ProductVersionRevision", ProductVersionRevision))\r\n`\
											`@(ScriptExport("ProductVersionRevisionNumber", ProductVersionRevision->AsInteger()->ToString()))\r\n`\
											`@(ScriptExport("ProductVersionExtra", ProductVersionExtra))\r\n`\
											`@(ScriptExport("ProductName", ProductName))\r\n`\
											`@(ScriptExport("ProductCompany", ProductCompany))\r\n`\
											`@(ScriptExport("ProductCopyright", ProductCopyright))\r\n`\
											`@(ScriptExport("ProductVersionHex", ProductVersionHex))\r\n`\
											`\r\n`

	ProductVersionString: string = `@(ProductVersionMajor)_@(ProductVersionMinor)@(ProductVersionRevision)`

	ProductVersionString `@(ProductVersionString)_@(ProductVersionExtra)`
	{
		!!ProductVersionExtra undefined
	}
	ProductVersionString `@(ProductVersionString)@(VersionStringSuffix)`
	{
		!VersionStringSuffix ""
	}

	ProductVersionStringDotted: string
	ProductVersionStringDotted `@(ProductVersionMajor).@(ProductVersionMinor)@(ProductVersionRevision)`
	ProductVersionStringDotted `@(ProductVersionStringDotted).@(ProductVersionExtra)`
	{
		!ProductVersionExtra ""
	}
	ProductVersionStringDotted `@(ProductVersionStringDotted)@(VersionStringSuffix->Replace("_", "."))`
	{
		!VersionStringSuffix ""
	}

	ProductVersionStringReadable: string
	ProductVersionStringReadable `@(ProductVersionMajor).@(ProductVersionMinor)@(ProductVersionRevision)`
	ProductVersionStringReadable `@(ProductVersionStringReadable) @(ProductVersionExtra)`
	{
		!ProductVersionExtra ""
	}
	ProductVersionStringReadable `@(ProductVersionStringReadable) @(VersionStringSuffix->Replace('_',''))`
	{
		!VersionStringSuffix ""
	}

	SharedBuildSettingsScriptContents =+	`@(ScriptExport("ProductVersionString", ProductVersionString))\r\n`\
											`@(ScriptExport("ProductVersionStringDotted", ProductVersionStringDotted))\r\n`\
											`@(ScriptExport("ProductVersionStringReadable", ProductVersionStringReadable))\r\n`\
											`\r\n`
	{
	}

	VisualstudioVCDir: string = `@(Builtin.VisualStudioRoot->WindowsPath())\\VC`

	SharedBuildSettingsScriptContents =+	`IF "%RunVsDevCmd%"=="false" GOTO NoVsCmd\r\n`\
											`IF EXIST "@(VisualstudioVCDir)\\Auxiliary\\Build\\vcvarsall.bat" call "@(VisualstudioVCDir)\\Auxiliary\\Build\\vcvarsall.bat" @(HostArchitecture)\r\n`\
											`:NoVsCmd\r\n`\
											`cd %OriginalDirectory%\r\n`\
											`\r\n`
	{
		&
		{
			HostPlatformFamily "Windows"
			ScriptWindowsBat true
		}
	}

	SharedBuildSettingsScriptContents =+	`pushd $MalterlibBaseDir/BuildSystem > /dev/null\r\n`\
											`source ./SharedBuildSettingsVCVars.sh\r\n`\
											`popd > /dev/null\r\n`\
											`\r\n`
	{
		&
		{
			HostPlatformFamily "Windows"
			ScriptWindowsBat false
		}
	}

	SharedBuildSettingsScriptContents =+	`function CheckErrors {\r\n`\
											`	if [[ $? -ne 0 ]] ; then\r\n`\
											`		echo ""\r\n`\
											`		echo ERROR: Build failed and aborted\r\n`\
											`		exit 1\r\n`\
											`	fi\r\n`\
											`}\r\n`\
											`\r\n`\
											`function EvalVar {\r\n`\
											`	eval "echo \\${$1}"\r\n`\
											`}\r\n`\
											`\r\n`\
											`export -f CheckErrors\r\n`\
											`export -f EvalVar\r\n`
	{
		!!ScriptWindowsBat false
	}


	SharedBuildSettingsScriptContents =+	`\r\n`\
											`export NumCPUs=${NumCPUs:-\`getconf _NPROCESSORS_ONLN\`}\r\n`
	{
		&
		{
			GeneratorFamily "Xcode"
			HostPlatformFamily "macOS"
		}
	}

	SharedBuildSettingsScriptContents =+	`\r\n`\
											`export NumCPUs=${NumCPUs:-\`grep -c "processor" /proc/cpuinfo\`}\r\n`
	{
		&
		{
			GeneratorFamily "Xcode"
			HostPlatformFamily "Linux"
		}
	}

	MalterlibUseCustomXcodeToolchain: bool // User(Toolset)=true: Use custom toolchain for Xcode to use same compiler as Malterlib when indexing
	/*MalterlibUseCustomXcodeToolchain true
	{
		&
		{
			MalterlibUseCustomXcodeToolchain undefined
			!MalterlibBuildServerBuild true
			!RunningCI true
		}
	}*/
	MalterlibUseCustomXcodeToolchain false
	{
		!!MalterlibUseCustomXcodeToolchain undefined
	}

	XcodeBuildToolChain: string = ""
	XcodeBuildToolChain "-toolchain org.malterlib.1.0"
	{
		!!MalterlibUseCustomXcodeToolchain true
	}

	SharedBuildSettingsScriptContents =+	`\r\n`\
											`function CleanWorkspaceForConfig()\r\n`\
											`{\r\n`\
											`	local BuildPlatformCleanLocal=${2//./_}\r\n`\
											`\r\n`\
											`	if [ "$(EvalVar BuildPlatform_${BuildPlatformCleanLocal})" == "0" ] ; then\r\n`\
											`		return 0\r\n`\
											`	fi\r\n`\
											`	if [ "$(EvalVar BuildArch_$3)" == "0" ] ; then\r\n`\
											`		return 0\r\n`\
											`	fi\r\n`\
											`\r\n`\
											`	$XCodeBuildTool -workspace "@(Builtin.GeneratedBuildSystemDir)/$1.xcworkspace" -scheme "Build All $2 $3 $4" clean\r\n`\
											`	CheckErrors	\r\n`\
											`}\r\n`\
											`\r\n`\
											`function CleanWorkspace()\r\n`\
											`{\r\n`\
											`	CleanWorkspaceForConfig "$1" macOS x64 "$2"\r\n`\
											`	CleanWorkspaceForConfig "$1" Linux x64 "$2"\r\n`\
											`	CleanWorkspaceForConfig "$1" Linux x86 "$2"\r\n`\
											`}\r\n`
	{
		!!GeneratorFamily "Xcode"
	}

	SharedBuildSettingsScriptContents =+	`\r\n`\
											`function CheckBuildPlatform()\r\n`\
											`{\r\n`\
											`	BuildPlatform=$1\r\n`\
											`	BuildArchitecture=$2\r\n`\
											`	BuildPlatformClean=${BuildPlatform//./_}\r\n`\
											`\r\n`\
											`	echo BuildPlatform=$BuildPlatform\r\n`\
											`	echo BuildPlatformClean=$BuildPlatformClean\r\n`\
											`	echo BuildArchitecture=$BuildArchitecture\r\n`\
											`\r\n`\
											`	if [ "$(EvalVar BuildPlatform_${BuildPlatformClean})" == "0" ] ; then\r\n`\
											`		echo Platform disabled, aborting\r\n`\
											`		exit 0\r\n`\
											`	fi\r\n`\
											`\r\n`\
											`	if [ "$(EvalVar BuildArch_$BuildArchitecture)" == "0" ] ; then\r\n`\
											`		echo Architecture disabled, aborting\r\n`\
											`		exit 0\r\n`\
											`	fi\r\n`\
											`}\r\n`
	{
		!!ScriptWindowsBat false
	}
}

%GenerateFile "LocalBuildSettings"
{
	GenerateFile
	{
		Name `BuildSystem/SharedBuildSettings@(ScriptExtension)`
		Contents `@(ScriptPreamble)@(SharedBuildSettingsScriptContents)`
		Executable true
		UnixLineEnds ScriptUnixLineEnds
		UnicodeBOM false
	}
}

%GenerateFile "LocalBuildSettingsWindowsBash"
{
	!!HostPlatformFamily "Windows"
	Property
	{
		ScriptWindowsBash true
	}
	GenerateFile
	{
		Name `BuildSystem/SharedBuildSettings@(ScriptExtension)`
		Contents `@(ScriptPreamble)@(SharedBuildSettingsScriptContents)`
		Executable true
		UnixLineEnds ScriptUnixLineEnds
		UnicodeBOM false
	}
}

%GenerateFile "LocalBuildSettingsWindowsBashVCVarsBat"
{
	!!HostPlatformFamily "Windows"
	Property
	{
		ScriptWindowsBash false
	}
	GenerateFile
	{
		Name `BuildSystem/SharedBuildSettingsVCVars@(ScriptExtension)`
		Executable true
		UnixLineEnds ScriptUnixLineEnds
		UnicodeBOM false

		Contents	`@(ScriptPreamble)`\
					`@@echo off\r\n`\
					`IF EXIST "@(VisualstudioVCDir)\\Auxiliary\\Build\\vcvarsall.bat" call "@(VisualstudioVCDir)\\Auxiliary\\Build\\vcvarsall.bat" @(HostArchitecture) > nul\r\n`\
					`env\r\n`
	}
}

%GenerateFile "LocalBuildSettingsWindowsBashVCVars"
{
	!!HostPlatformFamily "Windows"
	Property
	{
		ScriptWindowsBash true
	}
	GenerateFile
	{
		Name `BuildSystem/SharedBuildSettingsVCVars@(ScriptExtension)`
		Executable true
		UnixLineEnds ScriptUnixLineEnds
		UnicodeBOM false

		Contents	`@(ScriptPreamble)`\
					`if [[ "$MalterlibImportedVCPath" == "true" ]]; then\n`\
					`	return 0\n`\
					`fi\n`\
					`function ArrayContainsValue()\n`\
					`{\n`\
					`	local SearchFor="${1^^}"\n`\
					`	shift\n`\
					`	local Array=("$@@")\n`\
					`\n`\
					`	for ArrayEntry in "${Array[@@]}"; do\n`\
					`		if [[ "${ArrayEntry^^}" == "${SearchFor}" ]]; then\n`\
					`			return 0\n`\
					`		fi\n`\
					`	done\n`\
					`	return 1\n`\
					`}\n`\
					`\n`\
					`function UpdatePath()\n`\
					`{\n`\
					`	OldVars=()\n`\
					`	while read -r line; do\n`\
					`		key="${line%%=*}"\n`\
					`		OldVars+=("$key")\n`\
					`	done < <(env)\n`\
					`\n`\
					`	InvalidKeyRegex=".*[!\\\\(\\\\)]"\n`\
					`	while read -r Line; do\n`\
					`		Key="${Line%%=*}"\n`\
					`		Value="${Line#*=}"\n`\
					`		if ArrayContainsValue "$Key" "${OldVars[@@]}" && [[ "${Key^^}" != "PATH" ]]; then\n`\
					`			continue\n`\
					`		fi\n`\
					`		if [[ "$Key" =~ $InvalidKeyRegex ]]; then\n`\
					`			continue\n`\
					`		fi\n`\
					`		if [[ "${Key^^}" == "PATH" ]]; then\n`\
					`			export "PATH"="$Value"\n`\
					`		else\n`\
					`			export "$Key"="$Value"\n`\
					`		fi\n`\
					`	done < <(cmd.exe //C SharedBuildSettingsVCVars.bat)\n`\
					`\n`\
					`	export "MalterlibImportedVCPath=true"\n`\
					`}\n`\
					`\n`\
					`UpdatePath\n`\
					``
	}
}

%GenerateFile "CheckBuildError"
{
	!!HostPlatformFamily "Windows"
	GenerateFile
	{
		Name "BuildSystem/CheckBuildError.bat"
		Contents	""\
					"IF %ERRORLEVEL% NEQ 0 (\r\n"\
					"	echo.\r\n"\
					"	echo ERROR: Build failed and aborted\r\n"\
					"	exit 1\r\n"\
					")\r\n"
		UnicodeBOM false
		UnixLineEnds ScriptUnixLineEnds
		Executable true
	}
}

%GenerateFile "CompiledFilesInfo"
{
	GenerateFile
	{
		Name `@(MalterlibCompiledFilesSourceBase)/source-info`
		Contents	`BaseDir @(MaltelibBasePathAbsolute)\n`\
					`BuildSystemDir @(Builtin.GeneratedBuildSystemDir)\n`
		UnicodeBOM false
		UnixLineEnds true
		Executable false
	}
}

%GenerateFile "last-build"
{
	GenerateFile
	{
		Name "BuildSystem/LastBuild/last-build"
		Contents `@(MalterlibGitCommit)\n`
		UnicodeBOM false
		UnixLineEnds true
		Executable false
	}
}

%Group "~Automatic/WorkspaceLastBuild"
{
	%GenerateFile "last-build"
	{
		GenerateFile
		{
			Name `BuildSystem/LastBuild/last-build-@(Workspace:this.Identity)`
			Contents `@(MalterlibGitCommit)\n`
			UnicodeBOM false
			UnixLineEnds true
			Executable false
			KeepGeneratedFile true
		}
	}
}

%Group "~Automatic/WorkspaceBranchLastBuild"
{
	%GenerateFile "last-build"
	{
		GenerateFile
		{
			Name `BuildSystem/LastBuild/last-build-@(Workspace:this.Identity)-@(MalterlibGitBranch || "")`
			Contents `@(MalterlibGitCommit)\n`
			UnicodeBOM false
			UnixLineEnds true
			Executable false
			KeepGeneratedFile true
		}
	}
}

Property
{
	MalterlibGeneratorIDEPriority: int = 100
	MalterlibGeneratorIDEPriority 100
	{
		!!MalterlibGeneratorIDEPriority undefined
	}

	MalterlibGeneratorIDEPriority MalterlibGeneratorIDEPriority + 100
	{
		!!BuildSystemOutputDir->GetFile() "Default"
	}

	MalterlibGenerateCompileCommands: bool = (!MalterlibBuildServerBuild && !RunningCI) // User(Build System)=false: Enable compile_commands.json generation. Slows down generation significantly unless you are using the Ninja generator.
}

%Group "~Automatic/WorkspaceConfigStore"
{
	GenerateFile
	{
		UnicodeBOM false
		UnixLineEnds true
		Executable false
	}

	%GenerateFile "Generator"
	{
		GenerateFile
		{
			Name `@(BuildSystemOutputDir)/ConfigStore/Generator.json`

			Contents {
				generator: Generator
				, generatorFamily: GeneratorFamily
				, outputDir: BuildSystemOutputDir
				, buildSystemFile: BuildSystemFile
				, buildSystemBasePath: BuildSystemBasePath
				, priority: MalterlibGeneratorIDEPriority
			}->ToString()
		}
	}

	%GenerateFile "Workspace"
	{
		GenerateFile
		{
			Name `@(BuildSystemOutputDir)/ConfigStore/@(Workspace:Workspace.Name)/Workspace.json`

			Contents {
				name: Workspace:this.Identity
				, priority: Workspace.IDEPriority
			}->ToString()
		}
	}

	%GenerateFile "BuildWorkspace"
	{
		GenerateFile
		{
			Name `@(BuildSystemOutputDir)/ConfigStore/BuildWorkspace.sh`

			Contents `#!/bin/bash\n`\
			`\n`\
			`set -e\n`\
			`\n`

			Contents =+ `@(MalterlibBuildSystemGenerateCommand) --no-signal-changed "$1"\n`
			{
				!MalterlibDisableBuildSystemGeneration true
			}

			Contents =+ `"$MalterlibWorkspaceRoot/Malterlib/Core/BuildScripts/BuildXcodeWorkspace.sh" "$@@"\n`
			{
				!!GeneratorFamily "Xcode"
			}

			Contents =+ `"$MalterlibWorkspaceRoot/Malterlib/Core/BuildScripts/BuildVisualStudioWorkspace.sh" "$@@"\n`
			{
				!!GeneratorFamily "VisualStudio"
			}

			Contents =+ `"$MalterlibWorkspaceRoot/Malterlib/Core/BuildScripts/BuildNinjaWorkspace.sh" "$@@"\n`
			{
				!!GeneratorFamily "Ninja"
			}

			Executable true
		}
	}

	%GenerateFile "BuildTarget"
	{
		GenerateFile
		{
			Name `@(BuildSystemOutputDir)/ConfigStore/BuildTarget.sh`

			Contents `#!/bin/bash\n`\
			`\n`\
			`set -e\n`\
			`\n`

			Contents =+ `@(MalterlibBuildSystemGenerateCommand) --no-signal-changed "$1"\n`
			{
				!MalterlibDisableBuildSystemGeneration true
			}

			Contents =+ `"$MalterlibWorkspaceRoot/Malterlib/Core/BuildScripts/BuildXcodeTarget.sh" "$@@"\n`
			{
				!!GeneratorFamily "Xcode"
			}

			Contents =+ `"$MalterlibWorkspaceRoot/Malterlib/Core/BuildScripts/BuildVisualStudioTarget.sh" "$@@"\n`
			{
				!!GeneratorFamily "VisualStudio"
			}

			Contents =+ `"$MalterlibWorkspaceRoot/Malterlib/Core/BuildScripts/BuildNinjaTarget.sh" "$@@"\n`
			{
				!!GeneratorFamily "Ninja"
			}

			Executable true
		}
	}
}

Type
{
	CCompileCommandsEntry: {
		directory: string
		, file: string
		, arguments: [string]
		, output?: string
	}
}

Target
{
	AllFiles_C\+\+: [string] = []
	AllFiles_C: [string] = []
	AllFiles_ObjC: [string] = []
	AllFiles_ObjC\+\+: [string] = []
}

Property
{
	CompileCommandsFile: string
	CompileCommandsFile `@(BuildSystemOutputDir)/ConfigStore/@(Workspace:Workspace.Name)/Targets/@(Target:Target.Name)/@(Platform) @(Architecture) @(FullConfiguration)/compile_commands.json`
}

Target
{
	CompileCommandsFile CompileCommandsFile
	{
		&
		{
			MalterlibGenerateCompileCommands true
			GeneratorFamily "Ninja"
		}
	}
}

%Group "~Automatic/TargetConfigStore"
{
	GenerateFile
	{
		UnicodeBOM false
		UnixLineEnds true
		Executable false
	}

	%GenerateFile "Target"
	{
		GenerateFile
		{
			Name `@(BuildSystemOutputDir)/ConfigStore/@(Workspace:Workspace.Name)/Targets/@(Target:Target.Name).json`

			Contents {
				name: Target:this.Identity
			}->ToString()
		}
	}

	%GenerateFile "WorkspaceConfigurations"
	{
		GenerateFile
		{
			Name `@(BuildSystemOutputDir)/ConfigStore/@(Workspace:Workspace.Name)/Configs/@(Platform) @(Architecture) @(FullConfiguration).json`

			ContentsJson: any = {}

			ContentsJson {
				defaultDebugTargets: Workspace.IDEDefaultDebugTargets
				, configurationPriority: Workspace.ConfigurationPriority
				, platform: Platform
				, architecture: Architecture
				, configuration: BuildSystemFullConfiguration
			}

			ContentsJson #<defaultBuildTarget> Workspace.IDEDefaultBuildTarget
			{
				!Workspace.IDEDefaultBuildTarget undefined
			}

			Contents GenerateFile.ContentsJson->ToString()
		}
	}

	%GenerateFile "TargetConfigurations"
	{
		GenerateFile
		{
			Name `@(BuildSystemOutputDir)/ConfigStore/@(Workspace:Workspace.Name)/Targets/@(Target:Target.Name)/Configs/@(Platform) @(Architecture) @(FullConfiguration).json`

			f_GetGroupPath function(string _Entity) string = ""
			f_GetGroupPath GenerateFile.f_GetGroupPath / _Entity->RemovePrefix("Group:")
			{
				!!_Entity->StartsWith("Group:") true
			}

			ContentsJson: any = {}

			ContentsJson {
				platform: Platform
				, architecture: Architecture
				, configuration: BuildSystemFullConfiguration
				, debugPriority: Target.IDEDebugPriority
				, generateScheme: Target.GenerateScheme
			}

			ContentsJson #<targetName> (Target:this.EntityPath->Split("->")->ForEach(&GenerateFile.f_GetGroupPath) / Target:Target.Name)->WindowsPath()
			{
				!!GeneratorFamily "VisualStudio"
			}

			ContentsJson #<targetName> Target:Target.Name
			{
				!GeneratorFamily "VisualStudio"
			}

			ContentsJson #<postCopyProject> Target:MalterlibPostCopyProject
			{
				!Target:MalterlibPostCopyProject undefined
			}

			ContentsJson #<postCopyProject2> Target:MalterlibPostCopyProject2
			{
				!Target:MalterlibPostCopyProject2 undefined
			}

			ContentsJson #<postCopyDestination> Target:MalterlibPostCopyDestination
			{
				&
				{
					!Target:MalterlibPostCopyProject undefined
					!Target:MalterlibPostCopyDestination undefined
				}
			}

			ContentsJson #<localDebuggerCommand> Target.LocalDebuggerCommand
			{
				!Target.LocalDebuggerCommand undefined
			}

			ContentsJson #<remoteDebuggerCommand> Target.RemoteDebuggerCommand
			{
				!Target.RemoteDebuggerCommand undefined
			}

			ContentsJson #<localDebuggerWorkingDirectory> Target.LocalDebuggerWorkingDirectory
			{
				!Target.LocalDebuggerWorkingDirectory undefined
			}

			ContentsJson #<remoteDebuggerWorkingDirectory> Target.RemoteDebuggerWorkingDirectory
			{
				!Target.RemoteDebuggerWorkingDirectory undefined
			}

			ContentsJson #<debuggerCommandArguments> Target.DebuggerCommandArguments
			{
				!Target.DebuggerCommandArguments undefined
			}

			ContentsJson #<compileCommands> CompileCommandsFile
			{
				&
				{
					!Target.Type "Tool"
				}
			}

			Contents GenerateFile.ContentsJson->ToString()
		}
	}

	%GenerateFile "CompileCommands"
	{
		&
		{
			MalterlibGenerateCompileCommands true
			!Target.Type "Tool"
			!GeneratorFamily "Ninja"
		}

		GenerateFile
		{
			Name CompileCommandsFile

			XcodePlatformDir: string = Malterlib_MacOSDeveloperLocaction / "Platforms/MacOSX.platform"

			f_GenerateDefine function(string _Define) [string] = []
			f_GenerateDefine += `-D@(_Define)`
			{
				!_Define "{578185E0-2E2A-4481-A34E-BCC3F64CDCA2}"
			}

			f_GenerateInclude function(string _Path) [string] = []
			f_GenerateInclude += `-I@(_Path)`
			{
				!_Path "{578185E0-2E2A-4481-A34E-BCC3F64CDCA2}"
			}

			f_GenerateFrameworkInclude function(string _Path) [string] = []
			f_GenerateFrameworkInclude += `-F@(_Path->Replace("$(PLATFORM_DIR)", GenerateFile.XcodePlatformDir))`

			f_GenerateCompileCommands function(string _File) [type(CCompileCommandsEntry)] = []
			f_OptionalOption function(string _Option, string? _OptionValue) [string] = []
			f_OptionalOption [_Option, _OptionValue]
			{
				!_OptionValue undefined
			}

			PlatformSpecificOptions: [string] = []
			PlatformSpecificOptions =+ `-mmacosx-version-min=@(Compile.MinMacOSVersion->ToString())`
			{
				!!PlatformFamily "macOS"
			}
			PlatformSpecificOptions =+ `-stdlib=@(Target.CxxStandardLibrary->ToString())`
			{
				!PlatformFamily "Windows"
			}

			PlatformSpecificOptions =+ "-DUNICODE"
			{
				&
				{
					PlatformFamily "Windows"
					Target.CharacterSet "Unicode"
				}
			}
			PlatformSpecificOptions =+ "-D_MBCS"
			{
				&
				{
					PlatformFamily "Windows"
					!Target.CharacterSet "Unicode"
				}
			}

			f_GenerateCompileCommands =+ {
				directory: BuildSystemBasePath
				, file: GetProperty(&this.IdentityAsAbsolutePath, _File)
				, arguments: [
					(PlatformToolsetCompiler || MalterlibLLVMHostBinariesDirectory / "bin/clang")
					, "-target"
					, (GetProperty(&Compile.TargetTriple, _File) || MalterlibTargetTriple)
					, (
						(GeneratorFamily == "VisualStudio")
						? []
						: (
							(PlatformFamily == "macOS") ? ["-isysroot", Import.SdkRoot_macOS]
							: ["-isysroot", MalterlibSysRoot, "--sysroot", MalterlibSysRoot]
						)
					)...
					, GenerateFile.PlatformSpecificOptions...
					, "-x"
					, Compile.Type->SwitchWithError(
						"Unknown compile type"
						, "C++", "c++"
						, "C", "c"
						, "ObjC", "objective-c"
						, "ObjC++", "objective-c++"
					)
					, GetProperty(&Compile.DefaultHeaders, _File)->SwitchWithError(
						"Unsupported option: "
						, "None", ["-nostdinc"]
						, "NoStdLib", ["-nostdlibinc"]
						, "NoCompiler", ["-nobuiltininc"]
						, "NoStdIncludeCxx", ["-nostdinc++"]
						, "All", []
						, undefined, []
					)...
					,
					(
						Compile.Type->SwitchWithError(
							"Unknown compile type"
							, "C++", "C++"
							, "C", "C"
							, "ObjC++", "C++"
							, "ObjC", "C"
						)
						->SwitchWithError(
							"Internal error: Unknown compile type"
							, "C++", Compile.CxxLanguage->SwitchWithError(
								"Unsupported option: "
								, "GNU++11", "-std=gnu++11"
								, "GNU++14", "-std=gnu++14"
								, "GNU++17", "-std=gnu++17"
								, "GNU++20", "-std=gnu++20"
								, "GNU++23", "-std=gnu++2b"
								, "C++11", "-std=c++11"
								, "C++14", "-std=c++14"
								, "C++17", "-std=c++17"
								, "C++20", "-std=c++20"
								, "C++23", "-std=c++23"
								, "C++26", "-std=c++26"
								, "", "-std=c++26"
								, undefined, "-std=c++26"
							)
							, "C", ((GeneratorFamily == "VisualStudio") ? "C99" : Compile.CLanguage)->SwitchWithError(
								"Unsupported option: "
								, "C89", "-std=c89"
								, "C99", "-std=c99"
								, "C11", "-std=c11"
								, "C17", "-std=c17"
								, "C2x", "-std=c2x"
								, "GNU89", "-std=gnu89"
								, "GNU99", "-std=gnu99"
								, "GNU11", "-std=gnu11"
								, "GNU17", "-std=gnu17"
								, "GNU2x", "-std=gnu2x"
								, "", "-std=c99"
								, undefined, "-std=c99"
							)
						)
					)
					, GetProperty(&Compile.PreprocessorDefines, _File)->ForEach(&GenerateFile.f_GenerateDefine)...
					, GetProperty(&Compile.SearchPath, _File)->ForEach(&GenerateFile.f_GenerateInclude)...
					, (GetProperty(&Compile.FrameworkSearchPath, _File) || [])->ForEach(&GenerateFile.f_GenerateFrameworkInclude)...
					, GenerateFile.f_OptionalOption("-include", GetProperty(&Compile.PrefixHeader, _File))...
					, "-Wno-inline-new-delete"
					, "-Wno-invalid-offsetof"
				]
			}
			{
				!GetProperty(&Compile.Disabled, _File) true
			}

			f_GetCompileCommandsForCompileType function(string _CompileType) [type(CCompileCommandsEntry)] = []
			f_GetCompileCommandsForCompileType =+ Target:Target.AllFiles_@(_CompileType)->ForEach(&GenerateFile.f_GenerateCompileCommands, {Compile.Type: _CompileType})

			ContentsJson: [type(CCompileCommandsEntry)] = []

			ContentsJson [
				GenerateFile.f_GetCompileCommandsForCompileType("C++")...
				, GenerateFile.f_GetCompileCommandsForCompileType("C")...
				, GenerateFile.f_GetCompileCommandsForCompileType("ObjC")...
				, GenerateFile.f_GetCompileCommandsForCompileType("ObjC++")...
			]

			Contents GenerateFile.ContentsJson->ToString()
		}
	}
}

Workspace
{
	ExtraGroups =+ ["~Automatic/WorkspaceLastBuild", "~Automatic/WorkspaceBranchLastBuild", "~Automatic/WorkspaceConfigStore"]
}

Target
{
	ExtraGroups =+ ["~Automatic/TargetConfigStore"]
}

Property
{
	BuildServerHelpers_ConfigName: string

	BuildServerHelpersPathContents: string?
	BuildServerHelpersPathContents	`@(ScriptExport(`Output_@(BuildServerHelpers_ConfigName)`, Target:Target.OutputDirectory->NativePath()))\r\n`\
									`@(ScriptExport(`Product_@(BuildServerHelpers_ConfigName)`, MalterlibFinalModuleDestination->NativePath()))\r\n`\
									`@(ScriptExport(`Intermediate_@(BuildServerHelpers_ConfigName)`, Target:Target.IntermediateDirectory->NativePath()))\r\n`\
									`@(ScriptExport("MalterlibSharedIntermediateDirectory", Target:Property.MalterlibSharedIntermediateDirectory->NativePath()))\r\n`\
									`@(ScriptExport(`Output_@(Target:Target.Name)_@(BuildServerHelpers_ConfigName)`, Target:Target.OutputDirectory->NativePath()))\r\n`\
									`@(ScriptExport(`Product_@(Target:Target.Name)_@(BuildServerHelpers_ConfigName)`, MalterlibFinalModuleDestination->NativePath()))\r\n`\
									`@(ScriptExport(`Intermediate_@(Target:Target.Name)_@(BuildServerHelpers_ConfigName)`, Target:Target.IntermediateDirectory->NativePath()))\r\n`\
									`@(ScriptExport(`MalterlibSharedIntermediateDirectory_@(Target:Target.Name)`, Target:Property.MalterlibSharedIntermediateDirectory->NativePath()))\r\n`
	{
		!!Property.TargetIsExecutable true
	}
}

%Group "~Automatic/Build Server Helpers"
{
	!Property.BuildServerHelpersPathContents undefined
	Property
	{
		BuildServerHelpers_ConfigName `@(FullConfiguration)_@(Platform->Replace('.', '_'))_@(Architecture)`
	}

	%GenerateFile "Paths"
	{
		//!!Tests undefined
		GenerateFile
		{
			Name `@(BuildSystemOutputDir)/Files/@(Workspace:Workspace.Name)/@(Target:Target.Name)/Paths_@(BuildServerHelpers_ConfigName)@(ScriptExtension)`
			Contents `@(ScriptPreamble)@(BuildServerHelpersPathContents)`
			Executable true
			UnixLineEnds ScriptUnixLineEnds
			UnicodeBOM false
		}
	}
}

%Group "~Automatic/Workspace Build Server Helpers"
{
	Property
	{
		ScriptWindowsBash true
	}
	%GenerateFile "Paths"
	{
		GenerateFile
		{
			Name `@(BuildSystemOutputDir)/Files/@(Workspace:Workspace.Name)/Paths.sh`
			Contents `@(ScriptExport(`WorkspaceBase_@(Workspace:Workspace.Name)`, MalterlibCompiledFilesWarkspaceBase))\r\n`
			Executable true
			UnixLineEnds ScriptUnixLineEnds
			UnicodeBOM false
		}
	}
}

Workspace
{
	ExtraGroups =+ "~Automatic/Workspace Build Server Helpers"
}

Property
{
	MalterlibUseDefaultClangDFile: bool = true // User(Tools)=false: Use default .clangd file from Malterlib/Core/Tools/ClangD/.clangd
	MalterlibUseDefaultLLDBInitFile: bool = true // User(Tools)=false: Use default .lldbinit file from Malterlib/Core/Tools/LLDB/.lldbinit
}

%GenerateFile ".clangd"
{
	!!MalterlibUseDefaultClangDFile true

	GenerateFile
	{
		Name Builtin.BasePathAbsolute / ".clangd"

		Symlink true
		SymlinkBasePath Builtin.BasePathAbsolute
		Contents "Malterlib/Core/Tools/ClangD/.clangd"
		Executable false
		UnixLineEnds true
		UnicodeBOM false
	}
}

%GenerateFile ".lldbinit"
{
	!!MalterlibUseDefaultLLDBInitFile true

	GenerateFile
	{
		Name Builtin.BasePathAbsolute / ".lldbinit"

		Symlink true
		SymlinkBasePath Builtin.BasePathAbsolute
		Contents "Malterlib/Core/Tools/LLDB/.lldbinit"
		Executable false
		UnixLineEnds true
		UnicodeBOM false
	}
}

%GenerateFile "UserSettingGlobal.MSettings"
{
	!!MalterlibUseDefaultLLDBInitFile true

	GenerateFile
	{
		Name Builtin.BasePathAbsolute / "BuildSystem/UserSettingGlobal.MSettings"

		Symlink true
		SymlinkBasePath Builtin.BasePathAbsolute
		Contents `@(HomeDirectory)/UserSettingGlobalV2.MSettings`
		Executable false
		UnixLineEnds true
		UnicodeBOM false
	}
}
