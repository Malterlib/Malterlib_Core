// Misc
Target
{
	IntermediateDirectory	"@(MalterlibCompiledFilesSourceBase)/@(Workspace:Workspace.Name)/Intermediate/@(Target:Target.Name)/@(Platform)/@(Architecture)/@(FullConfiguration)/"
	OutputDirectory			"@(MalterlibCompiledFilesSourceBase)/@(Workspace:Workspace.Name)/Output/@(Target:Target.Name)/@(Platform)/@(Architecture)/@(FullConfiguration)/"

	ToolPath "@(Target.ToolPath);@(Builtin.Inherit)"

	ToolPath "/usr/local/go/bin;/usr/local/bin;@(Target.ToolPath)"
	{
		!!GeneratorFamily "Xcode"
	}

	ToolPath "@(MToolDirectory);@(Target.ToolPath)"

	ToolPath "@('../../../SDK'->MakeAbsolute())/BreakpadBin/@(HostPlatformFamily);@(Target.ToolPath)"
	{
		&
		{
			HostPlatformFamily "OSX"
			TargetIsExecutable true
			MalterlibDeploySymbols true
		}
	}

	ToolPath "@('../../../SDK'->MakeAbsolute())/BreakpadBin/Linux;@(Target.ToolPath)"
	{
		&
		{
			HostPlatformFamily "OSX"
			PlatformFamily "Linux"
			TargetIsExecutable true
			MalterlibDeploySymbols true
		}
	}


	ToolPath "@(MalterlibToolsRoot)/MSVC/@(MalterlibOverrideMSVCVersion)/bin/HostX64/x64;@(Target.ToolPath)"
	{
		&
		{
			!MalterlibOverrideMSVCVersion ""
			HostPlatformFamily "Windows"
			WindowsNativeToolChain true
			!Target.PlatformToolset "v90"
			MSVCToolChainArchitecture "HostX64/x86"
		}
	}

	ToolPath "@(MalterlibToolsRoot)/MSVC/@(MalterlibOverrideMSVCVersion)/bin/@(MSVCToolChainArchitecture);@(Target.ToolPath)"
	{
		&
		{
			!MalterlibOverrideMSVCVersion ""
			HostPlatformFamily "Windows"
			WindowsNativeToolChain true
			!Target.PlatformToolset "v90"
		}
	}

	ToolPath "@(MalterlibBinariesDirectory)/NoLib/x86;@(Target.ToolPath)"
	{
		&
		{
			PlatformType "Windows"
			MalterlibGenerateLibrary false
			WindowsNativeToolChain false
		}
	}

	ToolPath "@(MalterlibBinariesDirectory)/NoLib/x64;@(Target.ToolPath)"
	{
		&
		{
			PlatformType "Windows"
			MalterlibGenerateLibrary false
			WindowsNativeToolChain true
		}
	}
}

Compile
{
