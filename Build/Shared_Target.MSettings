	GeneratedDirectoryNoConfig: string = `@(MalterlibCompiledFilesWarkspaceBase)/Generated/@(Target:Target.Name)/NoConfig/`
	GeneratedWorkspaceDirectory: string = `@(MalterlibCompiledFilesWarkspaceBase)/Generated/@(Platform)/@(Architecture)/@(FullConfiguration)/`
	GeneratedWorkspaceDirectoryNoConfig: string = `@(MalterlibCompiledFilesWarkspaceBase)/Generated/NoConfig/`

	MalterlibUniqueConfig: string = GeneratedDirectory->Sanitize()->Replace('-', '_')->Replace('.', '_')

	MalterlibMacOSLinkerVersion: int
	MalterlibMacOSLinkerVersion ExecuteCommand(`@(GeneratedGlobalDirectory)MacOSLinkerVersion.MState`, ["/usr/bin/ld"], "bash", "-c", "/usr/bin/ld -v 2>&1")->Trim()->Split("PROJECT:")<[1]>->Split("\n")<[0]>->Split("ld64-")<[0]>->AsInteger()
}

Property
{
	MalterlibBinariesDirectory: string = `@("../../../Binaries/Malterlib"->MakeAbsolute())/@(HostPlatformFamily)/@(HostArchitecture)`
	MalterlibLLVMHostBinariesDirectory: string = `@("../../../Binaries/MalterlibLLVM"->MakeAbsolute())/@(HostPlatformFamily)/@(HostArchitecture)`
	MalterlibLLVMBinariesDirectory: string = `@("../../../Binaries/MalterlibLLVM"->MakeAbsolute())/@(PlatformFamily)/@(Architecture)`

	MalterlibLLVMSanitizerRuntime: string?
	MalterlibLLVMSanitizerRuntime MalterlibLLVMBinariesDirectory / `lib/clang/@(MalterlibClangVersionMajor)/lib/darwin/libclang_rt.asan_osx_dynamic.dylib`
	{
		&
		{
			PlatformFamily "macOS"
			MalterlibSupportSanitizerEnable_Address true
		}
	}
	MalterlibLLVMSanitizerRuntime MalterlibLLVMBinariesDirectory / `lib/clang/@(MalterlibClangVersionMajor)/lib/darwin/libclang_rt.tsan_osx_dynamic.dylib`
	{
		&
		{
			PlatformFamily "macOS"
			MalterlibSupportSanitizerEnable_Thread true
		}
	}
	MalterlibLLVMSanitizerRuntime MalterlibLLVMBinariesDirectory / `lib/clang/@(MalterlibClangVersionMajor)/lib/darwin/libclang_rt.ubsan_osx_dynamic.dylib`
	{
		&
		{
			PlatformFamily "macOS"
			MalterlibSupportSanitizerEnable_UndefinedBehavior true
		}
	}

	MSVCSanitizerArchitecture: string = Architecture

	MSVCSanitizerArchitecture "x86_64"
	{
		!!Architecture "x64"
	}

	MSVCSanitizerArchitecture "i386"
	{
		!!Architecture "x86"
	}

	MSVCDebugType: string = ""
	MSVCDebugType "_dbg"
	{
		!!DebugCode true
	}
	
	MalterlibLLVMSanitizerRuntime VisualStudioMSVCRootPath / MalterlibMSVCVersion / `bin/Host@(Architecture)/@(Architecture)/clang_rt.asan@(MSVCDebugType)_dynamic-@(MSVCSanitizerArchitecture).dll`
	{
		&
		{
			MalterlibSupportSanitizerEnable_Address true
			PlatformFamily "Windows"
		}
	}

	MalterlibNeedsLLVMSanitizerRuntime: bool = false
	MalterlibNeedsLLVMSanitizerRuntime true
	{
		&
		{
			MalterlibNeedsLLVMSanitizerRuntime undefined
			!MalterlibLLVMSanitizerRuntime undefined
			|
			{
				PlatformFamily "macOS"
				PlatformFamily "Windows"
			}
			TargetIsLaunchableExecutable true
			!DocumentationEnabled true
			!MalterlibDisableMalterlib true
		}
	}

	MToolDirectory: string = Builtin.MToolExe->GetPath()

	MToolPath: string
	MToolPath `@(MToolDirectory)/MTool.exe`
	{
		!!PlatformFamily "Windows"
	}
	MToolPath `@(MToolDirectory)/MTool`
	{
		!PlatformFamily "Windows"
	}

	MalterlibToolsRoot: string = "x:/Development/Malterlib/Tools"
}

Property
{
	MSVCToolChainArchitecture: string
	MSVCToolChainArchitecture "HostX64/x64"
	{
		!!Architecture "x64"
	}
	MSVCToolChainArchitecture "HostX64/x86"
	{
		!!Architecture "x86"
	}
}

// Misc
Target
{
	IntermediateDirectory `@(MalterlibCompiledFilesWarkspaceBase)/Int/@(Target:Target.Name)/@(Platform)/@(Architecture)/@(FullConfiguration)/`
	{
		!!Target.IntermediateDirectory undefined
	}
	OutputDirectory	`@(MalterlibCompiledFilesWarkspaceBase)/Out/@(Target:Target.Name)/@(Platform)/@(Architecture)/@(FullConfiguration)/`
	{
		!!Target.OutputDirectory undefined
	}

	ToolPath: [string]?
	ToolPath =+ Builtin.Inherit
	{
		!Builtin.Inherit ""
	}

	ToolPath += ["/usr/local/go/bin", "/usr/local/bin", "/opt/homebrew/bin"]
	{
		!!GeneratorFamily "Xcode"
	}

	ToolPath += [MToolDirectory]

	ToolPath += `@(MalterlibToolsRoot)/MSVC/@(MalterlibOverrideMSVCVersion)/bin/HostX64/x64`
	{
		&
		{
			!MalterlibOverrideMSVCVersion undefined
			HostPlatformFamily "Windows"
			WindowsNativeToolChain true
			!Target.PlatformToolset "v90"
			MSVCToolChainArchitecture "HostX64/x86"
		}
	}

	ToolPath += `@(MalterlibToolsRoot)/MSVC/@(MalterlibOverrideMSVCVersion)/bin/@(MSVCToolChainArchitecture)`
	{
		&
		{
			!MalterlibOverrideMSVCVersion undefined
			HostPlatformFamily "Windows"
			WindowsNativeToolChain true
			!Target.PlatformToolset "v90"
		}
	}

	ToolPath += `@(MalterlibBinariesDirectory)/NoLib/x86`
	{
		&
		{
			PlatformType "Windows"
			MalterlibGenerateLibrary false
			WindowsNativeToolChain false
		}
	}

	ToolPath += `@(MalterlibBinariesDirectory)/NoLib/x64`
	{
		&
		{
			PlatformType "Windows"
			MalterlibGenerateLibrary false
			WindowsNativeToolChain true
		}
	}
}

Compile
{
	SearchPath += `@(MalterlibToolsRoot)/MSVC/@(MalterlibOverrideMSVCVersion)/include`
	{
		&
		{
			!MalterlibOverrideMSVCVersion undefined
			CompileDialect "C"
			HostPlatformFamily "Windows"
			!Target.PlatformToolset "v90"
		}
	}
}

Target
{
	SearchPath += `@(MalterlibToolsRoot)/MSVC/@(MalterlibOverrideMSVCVersion)/lib/@(Architecture)`
	{
		&
		{
			!MalterlibOverrideMSVCVersion undefined
			HostPlatformFamily "Windows"
			!Target.PlatformToolset "v90"
		}
	}
}

Property
{
	MalterlibBuildSpecifics =+ `#define DMalterlibBundleIdentifier @(MalterlibBundleIdentifier->Escape())\r\n`
	{
		!!MalterlibIsMacOSBundle true
	}
}

%Group "~Automatic/Build Specifics"
{
	!MalterlibBuildSpecifics undefined

	%GenerateFile "Generate"
	{
		GenerateFile
		{
			Name `@(GeneratedDirectory)MalterlibBuild.h`

			Contents `#pragma once\r\n@(MalterlibBuildSpecifics)`

			UnicodeBOM true
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
		}
		Compile
		{
			Type "None"
		}
	}
}

Target
{
	ExtraGroups =+ "~Automatic/Build Specifics"
	{
		!MalterlibBuildSpecifics undefined
	}
}

%Group "~Automatic/Target Dependencies Linker"
{
	!!GeneratorFamily "Xcode"

	Property
	{
		fg_ExpandDependenciesTemplate function(string _Dependency) string = ""
		fg_ExpandDependenciesTemplate =+ `#include @(_Dependency->Escape())\n`
	}

	%GenerateFile "Generate"
	{
		GenerateFile
		{
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
			Name `@(GeneratedDirectory)Dependencies.cpp`

			Contents [XcodeGeneratorDependencyFiles..., PreBuildOutputFile]->ForEach(&fg_ExpandDependenciesTemplate)
		}
	}
}

Target
{
	ExtraGroups =+ "~Automatic/Target Dependencies Linker"
	{
		!!GeneratorFamily "Xcode"
	}
}

// macOS Specific

Property
{
	MalterlibBundleIdentifier: string = `@(ProductCompanyUniqueIdentifier->Sanitize()).@(Target:Target.Name->Sanitize())`

	MalterlibPostBuildScriptPreSign: string?
	MalterlibPostBuildScriptPreSign =+	`@(ScriptMkDir(`@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.FileExtension)/Contents/Resources`))\r\n`\
										`@(CheckErrors)\r\n`\
										`MTool DiffCopy @(MalterlibExeIcon->Escape()) @(`@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.FileExtension)/Contents/Resources`->Escape()) "" 0\r\n`\
										`@(CheckErrors)\r\n`
	{
		&
		{
			PlatformIsDarwin true
			Target.Type "UIExecutable"
			!MalterlibExeIcon undefined
		}
	}

	MalterlibBundleDebugLogation: string = MalterlibFinalModuleDestinationPath

	MalterlibPostBuildScriptPreSignMalterlibExeMainNibFilePath: string = MalterlibExeMainNibFile->GetLastPaths(2)

	MalterlibPostBuildScriptPreSign =+ `MTool DiffCopy @(MalterlibExeMainNibFile->Escape()) @(`@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.FileExtension)/Contents/Resources/@(MalterlibPostBuildScriptPreSignMalterlibExeMainNibFilePath->GetPath())`->Escape()) "" 0\r\n`
	{
		&
		{
			PlatformIsDarwin true
			Target.Type "UIExecutable"
			!MalterlibExeMainNibFile undefined
		}
	}
}

// Out of process Specific

Property
{
	MalterlibPostBuildScriptPreSign =+ `MTool DiffCopy @(MalterlibOverrideMallocLibrary->Escape()) @(`@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.FileExtension)/Contents/MacOS`->Escape()) "" 0\r\n`
	{
		&
		{
			MalterlibNeedsMallocOverrideLibrary true
			MalterlibIsMacOSBundle true
		}
	}

	MalterlibPostBuildScriptPreSign =+ `MTool DiffCopy @(MalterlibHelperExecutable->Escape()) @(`@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.FileExtension)/Contents/MacOS`->Escape()) "" 0\r\n`
	{
		&
		{
			MalterlibNeedsMalterlibHelper true
			MalterlibIsMacOSBundle true
		}
	}
	MalterlibPostBuildScriptPreSign =+ `MTool DiffCopy @(MalterlibLLVMSanitizerRuntime->Escape()) @(`@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.FileExtension)/Contents/MacOS`->Escape()) "" 0\r\n`
	{
		&
		{
			MalterlibNeedsLLVMSanitizerRuntime true
			MalterlibIsMacOSBundle true
		}
	}


	MalterlibPostBuildScriptPreSign =+ `MTool DiffCopy "@(GetProperty(&MalterlibFinalModuleDestination, "Group:Libraries.Target:Exe_AOCCOutOfProcess.Target:Exe_AOCCOutOfProcess"))" @(`@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.FileExtension)/Contents/MacOS`->Escape()) "" 0\r\n`
	{
		&
		{
			MalterlibOutOfProcessSupport true
			PlatformFamily "macOS"
		}
	}

	MalterlibPostBuildScriptPreSign =+ `MTool DiffCopy "@(GetProperty(&MalterlibFinalModuleDestination, "Group:Libraries.Target:Exe_AOCCOutOfProcess.Target:Exe_AOCCOutOfProcess"))" @(MalterlibFinalModuleDestinationPath->Escape()) "" 0\r\n`
	{
		&
		{
			MalterlibOutOfProcessSupport true
			PlatformFamily "Windows"
		}
	}
}

Target
{
	MalterlibInfoPListFile: string?
	MalterlibInfoPListFile `@(GeneratedDirectory)Info.plist`
	{
		&
		{
			PlatformIsDarwin true
			|
			{
				Target.Type "UIExecutable"
				Target.Type "Driver"
				Target.Type "Executable"
				Target.Type "ConsoleExecutable"
				Target.Type "DynamicLibrary"
				Target.Type "XcodeBundle"
				Target.Type "SharedDynamicLibrary"
			}
		}
	}

	BundleIdentifier: string?
	BundleIdentifier MalterlibBundleIdentifier
	{
		!!PlatformFamily "macOS"
	}
}

Property
{
	MalterlibTargetFriendlyName: string = Target:Target.Name
	MalterlibXcodePrincipalClass: string = "NSApplication"
	MalterlibExtraPListContents: string?
}

Type
{
	CMalterlibURLScheme: {
		Protocols: [string]
		, Role: string
		, Name: string
		, IconFile: string = ""
	}
}

Property
{
	MalterlibURLScheme: [type(CMalterlibURLScheme)]?
}

%Group "~Automatic/MacOS Specific"
{
	%GenerateFile "Generate"
	{
		!Target:Target.MalterlibInfoPListFile undefined

		Property
		{
			URLSchemeTemplateProtocol function(string _Protocol) string
			URLSchemeTemplateProtocol =+ `					<string>@(_Protocol)</string>\n`

			URLSchemeTemplate function(type(CMalterlibURLScheme) _Scheme) string
			URLSchemeTemplate =+	`		<dict>\n`\
									`			<key>CFBundleTypeRole</key>\n`\
									`				<string>@(_Scheme<Role>)</string>\n`\
									`				<key>CFBundleURLName</key>\n`\
									`				<string>@(_Scheme<Name>)</string>\n`\
									`				<key>CFBundleURLIconFile</key>\n`\
									`				<string>@(_Scheme<IconFile>)</string>\n`\
									`				<key>CFBundleURLSchemes</key>\n`\
									`				<array>\n`\
									`@(_Scheme<Protocols>->ForEach(&URLSchemeTemplateProtocol))`\
									`				</array>\n`\
									`		</dict>\n`
		}
		GenerateFile
		{
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
			Name `@(GeneratedDirectory)Info.plist`

			Contents	`<?xml version="1.0" encoding="UTF-8"?>\n`\
						`<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n`\
						`<plist version="1.0">\n`\
						`<dict>\n`\
						`	<key>CFBundleDevelopmentRegion</key>\n`\
						`		<string>en</string>\n`\
						`	<key>CFBundleExecutable</key>\n`\
						`		<string>@(Target:Target.FileName)</string>\n`\
						`	<key>CFBundleIdentifier</key>\n`\
						`		<string>@(MalterlibBundleIdentifier)</string>\n`\
						`	<key>CFBundleInfoDictionaryVersion</key>\n`\
						`		<string>6.0</string>\n`\
						`	<key>CFBundleVersion</key>\n`\
						`		<string>@(ProductVersionMajor->ToString()).@(ProductVersionMinor->ToString()).@(ProductVersionRevision->ToString())</string>\n`\
						`	<key>CFBundleShortVersionString</key>\n`\
						`		<string>@(ProductVersionMajor->ToString()).@(ProductVersionMinor->ToString()).@(ProductVersionRevision->ToString())</string>\n`\
						`	<key>CFBundleName</key>\n`\
						`		<string>@(MalterlibTargetFriendlyName)</string>\n`

			Contents =+	`	<key>NSHumanReadableCopyright</key>\n`\
						`		<string>@(ProductCopyright)</string>\n`\
						`	<key>NSPrincipalClass</key>\n`\
						`		<string>@(MalterlibXcodePrincipalClass)</string>\n`\
						`	<key>LSMinimumSystemVersion</key>\n`\
						`		<string>@(MalterlibMinSupportedMacOSVersion)</string>\n`\
						`	<key>MalterlibBranch</key>\n`\
						`		<string>@(MalterlibFullBranch)</string>\n`\
						`	<key>MalterlibGitBranch</key>\n`\
						`		<string>@(MalterlibGitBranch || "")</string>\n`\
						`	<key>MalterlibGitCommit</key>\n`\
						`		<string>@(MalterlibGitCommit)</string>\n`\
						`	<key>BuildTime</key>\n`\
						`		<string>@(MalterlibTime("{}:{}"))</string>\n`\
						`	<key>ProductVersionMajor</key>\n`\
						`		<string>@(ProductVersionMajor)</string>\n`\
						`	<key>ProductVersionMinor</key>\n`\
						`		<string>@(ProductVersionMinor)</string>\n`\
						`	<key>ProductVersionRevision</key>\n`\
						`		<string>@(ProductVersionRevision)</string>\n`\
						`	<key>ProductVersionExtra</key>\n`\
						`		<string>@(ProductVersionExtra)</string>\n`\
						`	<key>CFBundlePackageType</key>\n`\
						`		<string>APPL</string>\n`\
						`	<key>NSHighResolutionCapable</key>\n`\
						`		<string>YES</string>\n`
			{
				!Target.Type "Driver"
			}

			Contents =+	`	<key>CFBundlePackageType</key>\n`\
						`		<string>KEXT</string>\n`
			{
				&
				{
					Target.Type "Driver"
					Target.DriverType "IoKit"
				}
			}

			Contents =+	`	<key>CFBundlePackageType</key>\n`\
						`		<string>DEXT</string>\n`
			{
				&
				{
					Target.Type "Driver"
					Target.DriverType "DriverKit"
				}
			}

			Contents =+	`	<key>CFBundleSupportedPlatforms</key>\n`\
						`	<array>\n`\
						`		<string>MacOSX</string>\n`\
						`	</array>\n`
			{
				!!PlatformFamily "macOS"
			}


			Contents =+	`	<key>BreakpadProduct</key>\n`\
						`		<string>@(Target:Target.FileName)</string>\n`\
						`	<key>BreakpadProductDisplay</key>\n`\
						`		<string>@(MalterlibTargetFriendlyName)</string>\n`\
						`	<key>BreakpadURL</key>\n`\
						`		<string>@(MalterlibBreakpadUploadServer)</string>\n`\
						`	<key>BreakpadReportInterval</key>\n`\
						`		<string>@(MalterlibBreakpadReportInterval->ToString())</string>\n`\
						`	<key>BreakpadVendor</key>\n`\
						`		<string>@(ProductCompany)</string>\n`\
						`	<key>BreakpadVersion</key>\n`\
						`		<string>@(Target:Target.Version)</string>\n`\
						`	<key>BreakpadInProcess</key>\n`\
						`		<string>YES</string>\n`


			{
				!!MalterlibEnableBreakpad true
			}

			Contents =+	`	<key>BreakpadRequestEmail</key>\n`\
						`		<string>YES</string>\n`
			{
				&
				{
					MalterlibEnableBreakpad true
					MalterlibBreakpadRequestEmail true
				}
			}

			Contents =+	`	<key>BreakpadRequestComments</key>\n`\
						`		<string>YES</string>\n`
			{
				&
				{
					MalterlibEnableBreakpad true
					MalterlibBreakpadRequestComments true
				}
			}

			Contents =+	`	<key>CFBundleIconFile</key>\n`\
						`	<string>@(MalterlibExeIcon->GetFileNoExt())</string>\n`
			{
				!MalterlibExeIcon undefined
			}


			Contents =+	`	<key>NSMainNibFile</key>\n`\
						`	<string>@(MalterlibExeMainNibFile->GetFileNoExt())</string>\n`
			{
				!MalterlibExeMainNibFile undefined
			}


			Contents =+	`	<key>CFBundleURLTypes</key>\n`\
						`		<array>\n`\
						`@(Target:MalterlibURLScheme->ForEach(&URLSchemeTemplate))\n`\
						`		</array>\n`
			{
				!Target:MalterlibURLScheme undefined
			}

			Contents =+	`	<key>LSUIElement</key>\n`\
						`		<string>1</string>\n`
			{
				&
				{
					Property.MalterlibMacOSHideDockTile true
					!Target.Type "Driver"
				}
			}

			Contents =+	`	<key>NSRequiresAquaSystemAppearance</key>\n`\
						`		<string>YES</string>\n`
			{
				!!Property.MalterlibMacOSNoDarkMode true
			}

			Contents =+	MalterlibExtraPListContents
			{
				!MalterlibExtraPListContents undefined
			}

			Contents =+	`</dict>\n`\
						`</plist>\n`
			UnicodeBOM true
		}
		Compile
		{
			Type "None"
		}
	}
}
Target
{
	ExtraGroups =+ "~Automatic/MacOS Specific"
	{
		!Target:Target.MalterlibInfoPListFile undefined
	}
}
Property
{
	MalterlibLinuxProgramIdentifier: string?
	MalterlibLinuxProgramIdentifier `@(ProductCompanyUniqueIdentifier->Sanitize()).@(Target:Target.Name->Sanitize())`
	{
		&
		{
			PlatformFamily "Linux"
			TargetIsExecutable true
		}
	}

	MalterlibLinuxDesktopFile: string?
	MalterlibLinuxDesktopFile `@(GeneratedDirectory)@(MalterlibLinuxProgramIdentifier).desktop`
	{
		&
		{
			PlatformFamily "Linux"
			Target.Type "UIExecutable"
			!MalterlibBuildServerBuild true
		}
	}
}

%Group "~Automatic/Linux Specific"
{
	%GenerateFile "Generate"
	{
		!MalterlibDisableMalterlib true

		GenerateFile
		{
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
			Name `@(GeneratedDirectory)VersionInfo.cpp`

			Contents	`#include <Mib/Core/Core>\n`\
						`assure_used static char fileid[] __attribute__ ((section("IDSVERSIONINFO"))) = "$Id: VersionInfo.cpp,v @(Target:Target.Version) @(DateTime("{YYYY}/{MM}/{DD} {HH}:{MNMN}:{SS}")) $\\n"\n`\
						`@(`MalterlibBranch=@(MalterlibFullBranch)\n`->EJSONToString())\n`\
						`@(`MalterlibGitBranch=@(MalterlibGitBranch || "")\n`->EJSONToString())\n`\
						`@(`MalterlibGitCommit=@(MalterlibGitCommit || "")\n`->EJSONToString())\n`\
						`@(`BuildTime=@(MalterlibTime("{}:{}"))\n`->EJSONToString())\n`\
						`@(`ProductVersionMajor=@(ProductVersionMajor)\n`->EJSONToString())\n`\
						`@(`ProductVersionMinor=@(ProductVersionMinor)\n`->EJSONToString())\n`\
						`@(`ProductVersionRevision=@(ProductVersionRevision)\n`->EJSONToString())\n`\
						`@(`ProductVersionExtra=@(ProductVersionExtra)\n`->EJSONToString());\n`

			UnicodeBOM true
		}
	}

	%GenerateFile ".desktop"
	{
		!MalterlibLinuxDesktopFile undefined
		GenerateFile
		{
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
			Name MalterlibLinuxDesktopFile

			Contents	`[Desktop Entry]\n`\
						`Name=@(MalterlibTargetFriendlyName)\n`\
						`Version=@(ProductVersionMajor->ToString()).@(ProductVersionMinor->ToString()).@(ProductVersionRevision->ToString())\n`\
						`Type=Application\n`

			Contents =+	`Icon=@(MalterlibDeployRoot)/@(MalterlibCalculatedPostCopyProject)/@(MalterlibExeIcon->GetFile())\n`
			{
				!MalterlibExeIcon undefined
			}

			Contents =+	`Terminal=false\n`
			{
				!Target.Type "ConsoleExecutable"
			}

			Contents =+	`Terminal=true\n`
			{
				!!Target.Type "ConsoleExecutable"
			}

			UnicodeBOM false
		}
	}
}

Target
{
	ExtraGroups =+ "~Automatic/Linux Specific"
	{
		&
		{
			PlatformFamily "Linux"
			TargetIsExecutable true
		}
	}
}

Property
{
	MalterlibWindowsSettings_SegmentHeap: bool = false
	MalterlibWindowsSettings_LongPathAware: bool = true
	MalterlibExtraAssemblyInfo: string = ""
	MalterlibGenerateWindowsVersion: bool = true
}

%Group "~Automatic/Windows Specific"
{
	%GenerateFile "Generate .NET Assembly Info"
	{
		!!LanguageFamily ".NET"
		Property
		{
			CalcGUID: string = MalterlibFinalModuleDestination->HashUUID("Bare")
		}
		GenerateFile
		{
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
			Name `@(GeneratedDirectory)AssemblyInfo.cs`

			Contents	`\n`\
						`#if (@(MalterlibUniqueConfig))\r\n`\
						`using System.Reflection;\r\n`\
						`using System.Runtime.CompilerServices;\r\n`\
						`using System.Runtime.InteropServices;\r\n`\
						`[assembly: AssemblyTitle(@(ProductName->Escape()))]\r\n`\
						`[assembly: AssemblyDescription(@(ProductDescription->Escape()))]\r\n`\
						`[assembly: AssemblyConfiguration(@(ProductVersionExtra->Escape()))]\r\n`\
						`[assembly: AssemblyCompany(@(ProductCompany->Escape()))]\r\n`\
						`[assembly: AssemblyProduct(@(ProductName->Escape()))]\r\n`\
						`[assembly: AssemblyCopyright(@(ProductCopyright->Escape()))]\r\n`\
						`[assembly: AssemblyTrademark("")]\r\n`\
						`[assembly: AssemblyCulture("")]\r\n`\
						`[assembly: ComVisible(false)]\r\n`\
						`[assembly: Guid(@(CalcGUID->Escape()))]\r\n`\
						`[assembly: AssemblyFileVersion(@(`@(ProductVersionMajor).@(ProductVersionMinor).@(ProductVersionRevision).0`->Escape()))]\r\n`\
						`[assembly: AssemblyVersion(@(`@(ProductVersionMajor).@(ProductVersionMinor).@(ProductVersionRevision).0`->Escape()))]\r\n`\
						`@(MalterlibExtraAssemblyInfo)`\
						`#endif\r\n`

			UnicodeBOM true
		}
	}

	%GenerateFile "Generate C++ Managed"
	{
		&
		{
			LanguageFamily "Native"
			Target.CLRSupport true
		}

		Property
		{
			CalcGUID: string = MalterlibFinalModuleDestination->HashUUID("Bare")
		}
		GenerateFile
		{
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
			Name `@(GeneratedDirectory)AssemblyInfo.cpp`

			Contents	`\n`\
						`using namespace System;\r\n`\
						`using namespace System::Reflection;\r\n`\
						`using namespace System::Runtime::CompilerServices;\r\n`\
						`using namespace System::Runtime::InteropServices;\r\n`\
						`using namespace System::Security::Permissions;\r\n`\
						`[assembly:AssemblyTitleAttribute(@(ProductName->Escape()))];\r\n`\
						`[assembly:AssemblyDescriptionAttribute(@(ProductDescription->Escape()))];\r\n`\
						`[assembly:AssemblyConfigurationAttribute(@(ProductVersionExtra->Escape()))];\r\n`\
						`[assembly:AssemblyCompanyAttribute(@(ProductCompany->Escape()))];\r\n`\
						`[assembly:AssemblyProductAttribute(@(ProductName->Escape()))];\r\n`\
						`[assembly:AssemblyCopyrightAttribute(@(ProductCopyright->Escape()))];\r\n`\
						`[assembly:AssemblyTrademarkAttribute("")];\r\n`\
						`[assembly:AssemblyCultureAttribute("")];\r\n`\
						`[assembly:ComVisible(false)];\r\n`\
						`[assembly:Guid(@(CalcGUID->Escape()))];\r\n`\
						`[assembly:CLSCompliantAttribute(true)];\r\n`\
						`[assembly:AssemblyFileVersionAttribute(@(`@(ProductVersionMajor).@(ProductVersionMinor).@(ProductVersionRevision).0`->Escape()))];\r\n`\
						`[assembly:AssemblyVersionAttribute(@(`@(ProductVersionMajor).@(ProductVersionMinor).@(ProductVersionRevision).0`->Escape()))];\r\n`\
						`#pragma warning(disable:4947) // Request minimum deprecated in .NET 4.0\r\n`\
						`[assembly:SecurityPermission(SecurityAction::RequestMinimum, UnmanagedCode = true)];\r\n`\
						`@(MalterlibExtraAssemblyInfo)`

			UnicodeBOM true
		}
	}

	%GenerateFile "Generate Resource"
	{
		&
		{
			LanguageFamily "Native"
			MalterlibGenerateWindowsVersion true
		}

		Property
		{
			ResourceFileType: string = "VFT_UNKNOWN"

			ResourceFileType "VFT_APP"
			{
				!!Target.Type "ConsoleExecutable"
				!!Target.Type "UIExecutable"
				!!Target.Type "Executable"
			}
			ResourceFileType "VFT_DRV"
			{
				!!Target.Type "Driver"
			}
			ResourceFileType "VFT_DLL"
			{
				!!Target.Type "DynamicLibrary"
				!!Target.Type "SharedDynamicLibrary"
			}

			PrivateBuildString: string = {
				MalterlibBranch: MalterlibFullBranch
				, MalterlibGitBranch: (MalterlibGitBranch || "")
				, MalterlibGitCommit: MalterlibGitCommit
			}->EJSONToString("")
		}
		GenerateFile
		{
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
			Name `@(GeneratedDirectory)Resources.rc`

			Contents	`\n`\
						`#define IDI_ICON1                       101\r\n`\
						`// Next default values for new objects\r\n`\
						`// \r\n`\
						`#ifdef APSTUDIO_INVOKED\r\n`\
						`#ifndef APSTUDIO_READONLY_SYMBOLS\r\n`\
						`#define _APS_NEXT_RESOURCE_VALUE        102\r\n`\
						`#define _APS_NEXT_COMMAND_VALUE         40001\r\n`\
						`#define _APS_NEXT_CONTROL_VALUE         1001\r\n`\
						`#define _APS_NEXT_SYMED_VALUE           101\r\n`\
						`#endif\r\n`\
						`#endif\r\n`\
						`IDI_ICON1 ICON @(`@(MalterlibExeIcon->MakeRelative(GeneratedDirectory)->WindowsPath()->Replace("\\", "\\\\"))`->Escape())\r\n`
			{
				!MalterlibExeIcon undefined
			}

			Contents =+	`#include "winres.h"\r\n`\
						`VS_VERSION_INFO VERSIONINFO\r\n`\
						` FILEVERSION @(ProductVersionMajor),@(ProductVersionMinor),@(ProductVersionRevision),0\r\n`\
						` PRODUCTVERSION @(ProductVersionMajor),@(ProductVersionMinor),@(ProductVersionRevision),0\r\n`\
						` FILEFLAGSMASK 0x17L\r\n`\
						`#ifdef _DEBUG\r\n`\
						` FILEFLAGS VS_FF_DEBUG | VS_FF_PRIVATEBUILD\r\n`\
						`#else\r\n`\
						` FILEFLAGS VS_FF_PRIVATEBUILD\r\n`\
						`#endif\r\n`\
						` FILEOS VOS_NT_WINDOWS32\r\n`\
						` FILETYPE @(ResourceFileType)\r\n`\
						` FILESUBTYPE VFT2_UNKNOWN\r\n`\
						`BEGIN\r\n`\
						`	BLOCK "StringFileInfo"\r\n`\
						`	BEGIN\r\n`\
						`		BLOCK "040904b0"\r\n`\
						`		BEGIN\r\n`\
						`			VALUE "CompanyName", @(ProductCompany->Escape())\r\n`\
						`			VALUE "FileDescription", @(ProductDescription->Escape())\r\n`\
						`			VALUE "FileVersion", @(`@(ProductVersionMajor).@(ProductVersionMinor)@(ProductVersionRevision) @(ProductVersionExtra)`->Escape())\r\n`\
						`			VALUE "InternalName", @(Target:Target.FileName->Escape())\r\n`\
						`			VALUE "LegalCopyright", @(ProductCopyright->Escape())\r\n`\
						`			VALUE "OriginalFilename", @(`@(Target:Target.FileName)@(Target:Target.FileExtension)`->Escape())\r\n`\
						`			VALUE "ProductName", @(ProductName->Escape())\r\n`\
						`			VALUE "ProductVersion", @(`@(ProductVersionMajor).@(ProductVersionMinor)@(ProductVersionRevision) @(ProductVersionExtra)`->Escape())\r\n`\
						`			VALUE "PrivateBuild", @(PrivateBuildString->Escape()->Replace("\\\"", "\\x22"))\r\n`\
						`		END\r\n`\
						`	END\r\n`\
						`	BLOCK "VarFileInfo"\r\n`\
						`	BEGIN\r\n`\
						`		VALUE "Translation", 0x0409, 1200\r\n`\
						`	END\r\n`\
						`END\r\n`

			UTF16 true
			UnicodeBOM true
		}
	}

	%GenerateFile "Manifest"
	{
		!!LanguageFamily "Native"

		GenerateFile
		{
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
			Name `@(GeneratedDirectory)WindowsManifest.manifest`

			Contents	'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\r\n'\
						'<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0" xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">\r\n'\
						'	<asmv3:application>\r\n'\
						'		<asmv3:windowsSettings xmlns="http://schemas.microsoft.com/SMI/2020/WindowsSettings" xmlns:ws2="http://schemas.microsoft.com/SMI/2016/WindowsSettings">\r\n'

			Contents =+ '			<heapType>SegmentHeap</heapType>\r\n'
			{
				!!MalterlibWindowsSettings_SegmentHeap true
			}

			Contents =+ '			<ws2:longPathAware>true</ws2:longPathAware>\r\n'
			{
				!!MalterlibWindowsSettings_LongPathAware true
			}

			Contents =+ '		</asmv3:windowsSettings>\r\n'\
						'	</asmv3:application>\r\n'\
						'</assembly>\r\n'


			UTF16 false
			UnicodeBOM true
		}
	}
}
Target
{
	ExtraGroups =+ "~Automatic/Windows Specific"
	{
		&
		{
			PlatformFamily "Windows"
			TargetIsExecutable true
			!MalterlibDisableAutomaticResources true
		}
	}
}

Property
{
	MalterlibModuleDefinitionContents: string = ""
	MalterlibModuleDefinitionContents `EXPORTS@(NativeLineEnding)`
	{
		!!PlatformFamily "Windows"
	}

	ModuleDefineTemplate function(string _Symbol) string

	ModuleDefineTemplate =+ `@(_Symbol)@(NativeLineEnding)`
	{
		!!PlatformFamily "Windows"
	}
	ModuleDefineTemplate =+ `_@(_Symbol)@(NativeLineEnding)`
	{
		!!PlatformIsDarwin true
	}

	MalterlibDefinedSymbols: [string]?

	MalterlibModuleDefinitionContents =+ MalterlibDefinedSymbols->ForEach(&ModuleDefineTemplate)

	MalterlibStripProgram: string
	MalterlibStripProgram `@(MalterlibToolsPrefix)llvm-strip`
	{
		!MalterlibToolsPrefix undefined
	}
	MalterlibStripProgram "strip"
	{
		&
		{
			PlatformIsDarwin true
			MalterlibDefaultCompiler true
		}
	}

	MalterlibStripOptions: [string] = []

	MalterlibStripOptions =+ ["-u", "-r"]
	{
		&
		{
			PlatformIsDarwin true
			MalterlibDefaultCompiler true
		}
	}
	MalterlibStripOptions =+ ["--discard-all"]
	{
		&
		{
			PlatformIsDarwin true
			!MalterlibDefaultCompiler true
		}
	}

	MalterlibStripOptions =+ ["--strip-all-gnu"]
	{
		!!PlatformFamily "Linux"
	}

	ModuleDefineTemplateLLVMStrip function(string _Symbol) [string]
	ModuleDefineTemplateLLVMStrip =+ `--keep-symbol=_@(_Symbol)`

	MalterlibStripOptions =+ MalterlibDefinedSymbols->ForEach(&ModuleDefineTemplateLLVMStrip)
	{
		&
		{
			!MalterlibDefinedSymbols undefined
			PlatformFamily "Linux"
		}
	}
}

%Group "~Automatic/DLL Definition"
{
	%GenerateFile "Generate"
	{
		GenerateFile
		{
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
			Name `@(GeneratedDirectory)Module.def`

			Contents MalterlibModuleDefinitionContents
			UnicodeBOM false
		}
		Compile
		{
			Type "None"
		}
	}
}
Target
{
	ExtraGroups =+ "~Automatic/DLL Definition"
	{
		&
		{
			!MalterlibDefinedSymbols undefined
			|
			{
				PlatformFamily "Windows"
				PlatformFamily "macOS"
			}
		}
	}

	ModuleDefinitionFile: string?
	ModuleDefinitionFile GeneratedDirectory / "Module.def"
	{
		&
		{
			!MalterlibDefinedSymbols undefined
			|
			{
				PlatformFamily "Windows"
				PlatformFamily "macOS"
			}
		}
	}
}


// ExeFS

Property
{
	MalterlibExeFSExtraFiles: [type(CFileCopyOptions)] = []

	MalterlibExeFSExtraFilesContentsTemplate function(type(CFileCopyOptionsDetailed) _CopyOptions) string = ""
	MalterlibExeFSExtraFilesContentsTemplate Error("FindDirectory not supported for ExeFS")
	{
		!!true _CopyOptions<FindDirectory>
	}
	MalterlibExeFSExtraFilesContentsTemplate Error("Turning on AbsoluteDestination is not supported for ExeFS")
	{
		!!true _CopyOptions<AbsoluteDestination>
	}
	MalterlibExeFSExtraFilesContentsTemplate =+	`Include\r\n`\
												`{\r\n`\
												`	Pattern @(_CopyOptions<Pattern>->Escape())\r\n`\
												`	Destination @(_CopyOptions<Destination>->Escape())\r\n`\
												`	Recurse @(_CopyOptions<Recursive> ? "1" : "0")\r\n`\
												`}\r\n`

	MalterlibExeFSSpecContents: string?

	MalterlibExeFSSpecContents =+ `Include\r\n`\
								`{\r\n`\
								`	Pattern @(MalterlibExeFSPath->UnixPath()->Escape())\r\n`\
								`}\r\n`\
								`Include\r\n`\
								`{\r\n`\
								`	Pattern @(MalterlibTempExeFSPath->UnixPath()->Escape())\r\n`\
								`}\r\n`\
								`Include\r\n`\
								`{\r\n`\
								`	Pattern @(MalterlibSharedTempExeFSPath->UnixPath()->Escape())\r\n`\
								`}\r\n`\
								`@(fg_ExpandCopyOptions(MalterlibExeFSExtraFiles)->ForEach(&MalterlibExeFSExtraFilesContentsTemplate))`
	{
		&
		{
			TargetIsExecutable true
			MalterlibDoExeFS true
		}
	}
	MalterlibExeFSSpecContents =+	`Include\r\n`\
									`{\r\n`\
									`	Pattern @(MalterlibLocalizationExeFSPath->UnixPath()->Escape())\r\n`\
									`}\r\n`
	{
		&
		{
			MalterlibDoTranslationExeFS true
			MalterlibDoExeFS true
		}
	}
}

%Group "~Automatic/Dummy"
{
	%File "../Source/Dummy/Dummy.c"
	{
		!!MalterlibNeedLanguage_C true
	}
	%File "../Source/Dummy/Dummy.cpp"
	{
		!!MalterlibNeedLanguage_Cxx true
	}
}

Target
{
	ExtraGroups =+ "~Automatic/Dummy"
	{
		!!MalterlibNeedLanguage_C true
		!!MalterlibNeedLanguage_Cxx true
	}
}

%Group "~Automatic/Malterlib ExeFS Files"
{
	%GenerateFile "Generate"
	{
		GenerateFile
		{
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
			Name `@(GeneratedDirectory)/@(Workspace:Workspace.Name)_@(Target:Target.Name).MalterlibFSSpec`
			Contents MalterlibExeFSSpecContents
			UnicodeBOM true
		}
	}
}

Property
{
	MalterlibNeedLanguage_C: bool = false

	MalterlibNeedLanguage_Cxx: bool = false
	MalterlibNeedLanguage_Cxx true
	{
		|
		{
			!MalterlibExeFSSpecContents undefined
			GeneratorFamily "Xcode" // Needed for dependency checking
		}
	}
}
Target
{
	ExtraGroups =+ "~Automatic/Malterlib ExeFS Files"
	{
		!MalterlibExeFSSpecContents undefined
	}

}

Compile
{
	Custom_VerifyInputsAndOutputsExist: bool?
}

%Group "~Automatic/Utility Build"
{
	%GenerateFile "Generate"
	{
		GenerateFile
		{
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
			Name `@(GeneratedDirectory)/@(Workspace:Workspace.Name)_@(Target:Target.Name).build`
			Contents ""
			UnicodeBOM false
		}
		Compile
		{
			Custom_CommandLine Target.Real_CommandLine_Build
			Custom_WorkingDirectory '.'->MakeAbsolute()
			Custom_Outputs [Target.CommandLine_Outputs..., `@(GeneratedDirectory)/@(Workspace:Workspace.Name)_@(Target:Target.Name).never.generated`]
			Custom_Inputs Target.CommandLine_Inputs
			Custom_VerifyInputsAndOutputsExist Target.CommandLine_VerifyInputsAndOutputsExist
			{
				!Target.CommandLine_VerifyInputsAndOutputsExist undefined
			}
		}
	}
}

Target
{
	ExtraGroups =+ "~Automatic/Utility Build"
	{
		&
		{
			GeneratorFamily "VisualStudio"
			Target.Type "Tool"
		}
	}
}

// Post build step

Property
{
	MalterlibOriginalModuleDestinationExpLib: string = `@(MalterlibOriginalModuleDestination->GetPath())/@(MalterlibOriginalModuleDestination->GetFileNoExt()).exp`
	MalterlibOriginalModuleDestinationLib: string = `@(MalterlibOriginalModuleDestination->GetPath())/@(MalterlibOriginalModuleDestination->GetFileNoExt()).lib`
}

Property
{
	CheckErrors: string = ""
	CheckErrors ""
	{
		!!PlatformType "Unix"
	}

	TarOptions: string = ""
	TarOptions "--disable-copyfile"
	{
		!!HostPlatformFamily "macOS"
	}
}

Property
{
	MalterlibDumpSymsCommand: string = "dump_syms"
	MalterlibPostBuildScriptShowEnv: bool = false // User(Build System)=true: Enable to show the environment variables of the build environment
}

Type
{
	CFileCopyOptionsDetailed: {
		Pattern: string
		, Destination?: string = ""
		, Recursive?: bool = false
		, FindDirectory?: bool = false
		, AbsoluteDestination?: bool = false
	}
	// Recursive			Source ^
	// FindDirectory		Source ~
	// AbsoluteDestination	Destination ~

	CFileCopyOptions: one_of(string, type(CFileCopyOptionsDetailed))
}

Property
{
	fg_ExpandCopyOptionsHelper function(type(CFileCopyOptions) _CopyOptions) [type(CFileCopyOptionsDetailed)] = []
	fg_ExpandCopyOptionsHelper =+ _CopyOptions
	{
		!true _CopyOptions->IsString()
	}
	fg_ExpandCopyOptionsHelper =+ {Pattern: _CopyOptions}
	{
		!!true _CopyOptions->IsString()
	}

	fg_ExpandCopyOptions function([type(CFileCopyOptions)] _CopyOptions) [type(CFileCopyOptionsDetailed)]
	fg_ExpandCopyOptions _CopyOptions->ForEach(&fg_ExpandCopyOptionsHelper)

	f_AddDestinationPrefixToCopyOptions_AppendDestination function(type(CFileCopyOptionsDetailed) _Options) type(CFileCopyOptionsDetailed)
	f_AddDestinationPrefixToCopyOptions_AppendDestination _Options
	f_AddDestinationPrefixToCopyOptions_AppendDestination =+ {Destination: DestinationPrefix / _Options<Destination>}
	{
		!!_Options->HasMember("Destination") true
	}
	f_AddDestinationPrefixToCopyOptions_AppendDestination =+ {Destination: _Options<Destination>}
	{
		!_Options->HasMember("Destination") true
	}

	f_AddDestinationPrefixToCopyOptions_AddDestination function(type(CFileCopyOptionsDetailed) _Options) [type(CFileCopyOptionsDetailed)] = []
	f_AddDestinationPrefixToCopyOptions_AddDestination =+ f_AddDestinationPrefixToCopyOptions_AppendDestination(_Options)

	f_AddDestinationPrefixToCopyOptions function([type(CFileCopyOptions)] _Options, string _DestinationPrefix) [type(CFileCopyOptions)] = []

	f_AddDestinationPrefixToCopyOptions _Options->fg_ExpandCopyOptions()->ForEach(&f_AddDestinationPrefixToCopyOptions_AddDestination, {DestinationPrefix: _DestinationPrefix})
}

Property
{
	MalterlibBuildServerPutSources: [type(CFileCopyOptions)] = []
	MalterlibBuildServerPutSources =+ MalterlibFinalModuleDestination
	{
		!Target.Type "Tool"
	}
	MalterlibBuildServerPutSources =+ MalterlibOverrideMallocLibrary
	{
		&
		{
			MalterlibNeedsMallocOverrideLibrary true
			!MalterlibIsMacOSBundle true
		}
	}
	MalterlibBuildServerPutSources =+ MalterlibHelperExecutable
	{
		&
		{
			MalterlibNeedsMalterlibHelper true
			!MalterlibIsMacOSBundle true
		}
	}
	MalterlibBuildServerPutSources =+ MalterlibLLVMSanitizerRuntime
	{
		&
		{
			MalterlibNeedsLLVMSanitizerRuntime true
			!MalterlibIsMacOSBundle true
		}
	}

	MalterlibBuildServerPutPath: string?

	MalterlibBuildServerPutPathUploadTemplate function(type(CFileCopyOptionsDetailed) _CopyOptions) string = ""
	MalterlibBuildServerPutPathUploadTemplate Error("FindDirectory not supported for build server put")
	{
		!!true _CopyOptions<FindDirectory>
	}
	MalterlibBuildServerPutPathUploadTemplate Error("Turning on AbsoluteDestination is not supported for build server put")
	{
		!!true _CopyOptions<AbsoluteDestination>
	}
	MalterlibBuildServerPutPathUploadTemplate =+	`@(MalterlibBuildServerCommandPrefix)MTool BuildServerPut Recursive=@(_CopyOptions<Recursive> ? "1" : "0") @(`Source=@(_CopyOptions<Pattern>)`->EscapeHost()) @(`DestinationDir=@(MalterlibBuildServerPutPath->AppendPath(_CopyOptions<Destination>))`->EscapeHost())\r\n`\
													`@(CheckErrors)\r\n`

	MalterlibBuildServerPutPathUploadContents: string
	MalterlibBuildServerPutPathUploadContents =+ fg_ExpandCopyOptions(MalterlibBuildServerPutSources)->ForEach(&MalterlibBuildServerPutPathUploadTemplate)


	MalterlibTestPutSources: [type(CFileCopyOptions)]

	MalterlibTestPutSources =+ {Pattern: MalterlibFinalModuleDestination}
	MalterlibTestPutSources =+ {Pattern: Target:Target.SymbolFile}
	{
		&
		{
			!Target:Target.SymbolFile undefined
			PlatformFamily "Windows"
		}
	}

	MalterlibTestPutSources =+ {Pattern: `@(MalterlibOriginalModuleDestination).dSYM`}
	{
		&
		{
			PlatformIsDarwin true
			TargetIsExecutable true
			Target.DebugInformationFormat "dwarf-with-dsym"
		}
	}

	MalterlibTestPutPathUploadTemplate function(type(CFileCopyOptionsDetailed) _CopyOptions) string
	MalterlibTestPutPathUploadTemplate Error("FindDirectory not supported for test upload")
	{
		!!true _CopyOptions<FindDirectory>
	}
	MalterlibTestPutPathUploadTemplate Error("Turning on AbsoluteDestination is not supported for test upload")
	{
		!!true _CopyOptions<AbsoluteDestination>
	}
	MalterlibTestPutPathUploadTemplate Error("Turning on Recursive is not supported for test upload")
	{
		!!true _CopyOptions<Recursive>
	}
	MalterlibTestPutPathUploadTemplate =+	`@(MalterlibBuildServerCommandPrefix)MTool BuildServerPut Recursive=0 @(`Source=@(_CopyOptions<Pattern>)`->Escape()) @(`DestinationDir=@(MalterlibTestPutPath)@(_CopyOptions<Destination>)`->Escape())\r\n`\
											`@(CheckErrors)\r\n`
	{
		!MalterlibAutoBuild true
	}

	// AB Copy
	MalterlibTestPutPathUploadTemplate =+	`echo @(ScriptMkDir(`@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(_CopyOptions<Destination>)`))\r\n`\
											`@(ScriptMkDir(`@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(_CopyOptions<Destination>)`))\r\n`\
											`echo cp -fr @(_CopyOptions<Pattern>->Escape()) @(`@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(_CopyOptions<Destination>)/`->Escape())\r\n`\
											`cp -fr @(_CopyOptions<Pattern>->Escape()) @(`@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(_CopyOptions<Destination>)/`->Escape())\r\n`\
											`@(CheckErrors)\r\n`
	{
		&
		{
			!PlatformFamily "Windows"
			MalterlibAutoBuild true
		}
	}

	MalterlibTestPutPathUploadTemplate =+	`echo mkdir @(`@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(_CopyOptions<Destination>)`->Escape())\r\n`\
											`mkdir @(`@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(_CopyOptions<Destination>)`->Escape())\r\n`\
											`@(CheckErrors)\r\n`\
											`echo MTool DiffCopy @(_CopyOptions<Pattern>->Escape()) @(`@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(_CopyOptions<Destination>)`->Escape())\r\n`\
											`MTool DiffCopy @(_CopyOptions<Pattern>->Escape()) @(`@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(_CopyOptions<Destination>)`->Escape())\r\n`\
											`@(CheckErrors)\r\n`
	{
		&
		{
			PlatformFamily "Windows"
			MalterlibAutoBuild true
		}
	}

	MalterlibTestPutPathUploadContents: string = ""
	MalterlibTestPutPathUploadContents =+ MalterlibTestPutSources->ForEach(&MalterlibTestPutPathUploadTemplate)

	MalterlibTestPutPath: string?
	MalterlibTestPutPath `Test/@(Workspace:Workspace.Name)/@(Platform)/@(Architecture)/@(FullConfiguration)`
	{
		&
		{
			MalterlibTestPutPath undefined
			|
			{
				MalterlibMainTest true
				MalterlibHelperTest true
			}
		}
	}

	MalterlibTestPutSources =+ {Pattern: `@(MalterlibFinalModuleDestination).MainTest`}
	{
		!!MalterlibMainTest true
	}

	Win32SignTool: string
	Win32SignTool `@(MalterlibBuildServerCommandPrefix)MTool BuildServerTool Tool=SignToolWin32`
	{
		&
		{
			Win32SignTool undefined
			MalterlibBuildServerBuild true
		}
	}

	Win32SignTool `@('../../../SDK'->MakeAbsolute())/WDK/bin/x86/SignTool.exe`
	{
		!!Win32SignTool undefined
	}

	Win32SignToolTimestampServerOptions: string
	Win32SignToolTimestampServerOptions `/td SHA256 /tr @(MalterlibSignTimestampServerRFC3161)`
	{
		!MalterlibSignTimestampServerRFC3161 ""
	}
	Win32SignToolTimestampServerOptions `/t @(MalterlibSignTimestampServer)`
	{
		!!Win32SignToolTimestampServerOptions undefined
	}

	MalterlibWindowsSignCommandLine: string
	MalterlibWindowsSignCommandLine `@(Win32SignTool) sign /fd SHA256 /ac @(MalterlibSignIncludeCert->WindowsPath()->Escape()) /n @(MalterlibSignCertWindows->Escape()) @(Win32SignToolTimestampServerOptions) @(MalterlibFinalModuleDestination->WindowsPath()->Escape())`

	MalterlibWindowsSignCommandLine `@(Win32SignTool) sign /fd SHA256 /n @(MalterlibSignCertWindows->Escape()) @(Win32SignToolTimestampServerOptions) @(MalterlibFinalModuleDestination->WindowsPath()->Escape())`
	{
		!!MalterlibSignIncludeCert "none"
	}

	MalterlibSignMacOSDeep: bool = true

	MalterlibSignMacOSHardened: bool?

	MalterlibCodeSignMacOSExtraOptions: string = ""
	MalterlibCodeSignMacOSExtraOptions += "--options runtime "
	{
		|
		{
			!MalterlibNotarizeMacOSProfile undefined
			MalterlibSignMacOSHardened true
		}
	}

	MalterlibCodeSignMacOSExtraOptions += "--deep "
	{
		!!MalterlibSignMacOSDeep true
	}

	MalterlibSignMacOSEntitlements: string?

	MalterlibForNotarization: bool = (MalterlibNotarizeMacOSProfile <!=> undefined)

	MalterlibSignMacOSEntitlements "../Resources/macOS/Default.entitlements"->MakeAbsolute()
	{
		&
		{
			MalterlibSignMacOSEntitlements undefined
			!MalterlibForNotarization true
		}
	}

	MalterlibCodeSignMacOSExtraOptions += `--entitlements @(MalterlibSignMacOSEntitlements->Escape()) `
	{
		!MalterlibSignMacOSEntitlements undefined
	}

	MalterlibCodeSignMacOSCommand: string
	MalterlibCodeSignMacOSCommand `@(MalterlibBuildServerCommandPrefix)MTool BuildServerTool Tool=CodeSignMacOS`
	{
		!!MalterlibBuildServerBuild true
	}

	MalterlibCodeSignMacOSCommand "codesign"
	{
		!MalterlibBuildServerBuild true
	}

	MalterlibNotaryToolMacOSCommand: string
	MalterlibNotaryToolMacOSCommand `@(MalterlibBuildServerCommandPrefix)MTool BuildServerTool Tool=NotaryToolMacOS`
	{
		!!MalterlibBuildServerBuild true
	}

	MalterlibNotaryToolMacOSCommand "xcrun notarytool"
	{
		!MalterlibBuildServerBuild true
	}

	MalterlibStaplerMacOSCommand: string
	MalterlibStaplerMacOSCommand `@(MalterlibBuildServerCommandPrefix)MTool BuildServerTool Tool=StaplerMacOS`
	{
		!!MalterlibBuildServerBuild true
	}

	MalterlibStaplerMacOSCommand "xcrun stapler"
	{
		!MalterlibBuildServerBuild true
	}
}

Property
{
	PreBuildScriptDependenciesTemplate function(string _Dependency) [string] = []
	PreBuildScriptDependenciesTemplate =+ GetProperty(&Target.DependencyFile, _Dependency)

	PreBuildScriptDependencies: [string] = []
	PreBuildScriptDependencies =+ Target.DependencyTargets->ForEach(&PreBuildScriptDependenciesTemplate)

	PreBuildOutputFile: string = `@(Target.IntermediateDirectory)PreBuildOutput.h`
}

Target
{
	PreBuildScript: string = ""
	PreBuildScript += "set -eo pipefail\r\n"
	{
		!!PlatformType "Unix"
	}
}

Target
{
	!!GeneratorFamily "Xcode"

	PreBuildScriptInputs =+ Builtin.MToolExe
	PreBuildScriptInputs =+ PreBuildScriptDependencies
	PreBuildScriptOutputs =+ PreBuildOutputFile
	PreBuildScript =+	`@(Builtin.MToolExe->Escape()) CheckDependencies @(`Directory=@(Target.IntermediateDirectory)MalterlibDependencies`->Escape())\n`\
						`if [ "$?" != "0" ]; then\n`\
						`  echo error: Dependency checking failed\n`\
						`  exit 1\n`\
						`fi\n`\
						`MTool TouchOrCreate @(PreBuildOutputFile->Escape())\n`
}

Property
{
	MalterlibExecutableInput: string = MalterlibOriginalModuleDestinationExecutable

	MalterlibPostBuildScriptInputs: [string]?
	MalterlibPostBuildScriptInputs =+ MalterlibExecutableInput
	MalterlibPostBuildScriptInputs =+ MalterlibPostCopyConfigFile
	{
		&
		{
			!MalterlibBuildServerBuild true
			|
			{
				!MalterlibPostCopyContents undefined
				!MalterlibPostCopyContents2 undefined
			}
		}
	}

	fg_ExpartPostBuildScriptInputsPostCopy function(type(CFileCopyOptionsDetailed) _CopyOptions) [string] = []
	fg_ExpartPostBuildScriptInputsPostCopy =+ _CopyOptions<Pattern>
	{
		!_CopyOptions<Pattern>->Find("*") true // Don't support wildcards
	}

	MalterlibPostBuildScriptInputs =+ fg_ExpandCopyOptions(MalterlibPostCopySources)->ForEach(&fg_ExpartPostBuildScriptInputsPostCopy)
	{
		&
		{
			!MalterlibBuildServerBuild true
			|
			{
				!MalterlibPostCopyContents undefined
				!MalterlibPostCopyContents2 undefined
			}
		}
	}

	MalterlibPostBuildScriptInputsInternalTemplate function(string _Input) [string] = []
	MalterlibPostBuildScriptInputsInternalTemplate =+ _Input
	{
		|
		{
			!_Input MalterlibFinalModuleDestinationExecutable
			MalterlibFinalModuleDestinationExecutable MalterlibOriginalModuleDestinationExecutable
		}
	}
	MalterlibPostBuildScriptInputsContents: [string] = MalterlibPostBuildScriptInputs->ForEach(&MalterlibPostBuildScriptInputsInternalTemplate)

	PostBuildOutputfile: string
	PostBuildOutputfile `@(Target.IntermediateDirectory)PostBuildOutput.h`
}

Target
{
	!!GeneratorFamily "Xcode"

	PostBuildScriptInputs MalterlibPostBuildScriptInputsContents
	PostBuildScriptOutputs += PostBuildOutputfile
	PostBuildScriptOutputs += Target:Target.DependencyFile
	{
		&
		{
			!Target:Target.DependencyFile undefined
			!Target:Target.Type "Tool"
		}
	}
}

Property
{
	MalterlibPostCopySources: [type(CFileCopyOptions)] = []
	MalterlibPostCopySources =+ MalterlibFinalModuleDestination
	{
		!Target.Type "Tool" // Tool has no default executable
	}

	MalterlibPostCopySources =+ `@(MalterlibOriginalModuleDestination).dSYM`
	{
		&
		{
			IsDefined("Target.DebugInformationFormat") true
			Target.DebugInformationFormat "dwarf-with-dsym"
		}
	}

	MalterlibPostCopySources =+ MalterlibLinuxDesktopFile
	{
		&
		{
			!MalterlibLinuxDesktopFile undefined
		}
	}
	MalterlibPostCopySources =+ MalterlibExeIcon
	{
		&
		{
			!MalterlibLinuxDesktopFile undefined
			!MalterlibExeIcon undefined
		}
	}

	MalterlibPostCopySources =+ MalterlibOverrideMallocLibrary
	{
		&
		{
			MalterlibNeedsMallocOverrideLibrary true
			!MalterlibIsMacOSBundle true
		}
	}

	MalterlibPostCopySources =+ MalterlibHelperExecutable
	{
		&
		{
			MalterlibNeedsMalterlibHelper true
			!MalterlibIsMacOSBundle true
		}
	}
	MalterlibPostCopySources =+ MalterlibLLVMSanitizerRuntime
	{
		&
		{
			MalterlibNeedsLLVMSanitizerRuntime true
			!MalterlibIsMacOSBundle true
		}
	}

	MalterlibPostCopyConfigFile: string = `@(Builtin.GeneratedBuildSystemDir)/PostCopy.MConfig`

	MalterlibPostCopyInternalTemplate function(type(CFileCopyOptionsDetailed) _CopyOptions) string = ""
	MalterlibPostCopyInternalTemplate Error("Turning on AbsoluteDestination is not supported for post copy")
	{
		!!true _CopyOptions<AbsoluteDestination>
	}
	MalterlibPostCopyInternalTemplate =+	`MTool PostCopy @(`@(_CopyOptions<Pattern>)`->EscapeHost()) @(`Config=@(MalterlibPostCopyConfigFile)`->EscapeHost()) @(`Project=@(MalterlibCalculatedPostCopyProject)`->EscapeHost()) @(`OutFolder=@(MalterlibPostCopyDestination->AppendPath(_CopyOptions<Destination>))`->EscapeHost()) Hash=@(MalterlibPostCopyHash->ToString()) FindDirectory=@(_CopyOptions<FindDirectory>->ToString()) Recursive=@(_CopyOptions<Recursive>->ToString())\r\n`\
											`@(CheckErrors)\r\n`

	MalterlibPostCopyContents: string?
	MalterlibPostCopyContents fg_ExpandCopyOptions(MalterlibPostCopySources)->ForEach(&MalterlibPostCopyInternalTemplate)
	{
		&
		{
			!MalterlibCalculatedPostCopyProject undefined
			!DisablePostCopy true
		}
	}

	MalterlibPostCopyContents2: string?
	MalterlibPostCopyContents2 fg_ExpandCopyOptions(MalterlibPostCopySources)->ForEach(&MalterlibPostCopyInternalTemplate, {MalterlibCalculatedPostCopyProject: MalterlibCalculatedPostCopyProject2, MalterlibPostCopyDestination: MalterlibPostCopyDestination2, MalterlibPostCopyHash: MalterlibPostCopyHash2})
	{
		&
		{
			!MalterlibCalculatedPostCopyProject2 undefined
			!DisablePostCopy true
		}
	}
}

Property
{
	MalterlibPostBuildScript_Last: string?
	MalterlibTestDeployPath: string?
	MalterlibExtraPostBuildScript: string?
	MalterlibStripSymbols: bool?
}

Property
{
	MalterlibPostBuildScriptInputs =+ `@(MalterlibOriginalModuleDestination).dSYM/Contents/Resources/DWARF/@(Target:Target.FileName)`
	{
		&
		{
			PlatformIsDarwin true
			Target.DebugInformationFormat "dwarf-with-dsym"
		}
	}
}

Target
{
	PostBuildScript: string = ""
	PostBuildScript += "set -eo pipefail\r\n"
	{
		!!PlatformType "Unix"
	}

	PostBuildScript =+ "env\r\n"
	{
		!!MalterlibPostBuildScriptShowEnv true
	}

	PostBuildScript =+ "function CheckErrors {\r\n"\
						"	if [[ $? -ne 0 ]]\r\n"\
						"	then\r\n"\
						"		echo ERROR: Command in post build script failed, aborting\r\n"\
						"		exit 1\r\n"\
						"	fi\r\n"\
						"}\r\n"\
						"\r\n"
	{
		!!PlatformType "Unix"
	}

/*
	// This breaks the dependency checking in MSBuild
	PostBuildScript =+	`IF EXIST "@(MalterlibOriginalModuleDestinationExpLib->WindowsPath())" del "@(MalterlibOriginalModuleDestinationExpLib->WindowsPath())"\r\n`\
						`IF EXIST "@(MalterlibOriginalModuleDestinationLib->WindowsPath())" del "@(MalterlibOriginalModuleDestinationLib->WindowsPath())"\r\n`
	{
		&
		{
			Target.Type "DynamicLibrary"
			PlatformType "Windows"
			!MalterlibSaveImpLib true
		}
	}
	*/

	PostBuildScript =+	`MTool DiffCopy @(MalterlibOriginalModuleDestination->Escape()) @(MalterlibFinalModuleDestinationPath->Escape()) "" 0\r\n`\
						`@(CheckErrors)\r\n`

	{
		&
		{
			!MalterlibFinalModuleDestination MalterlibOriginalModuleDestination
			!DisableDiffCopy true
		}
	}

	PostBuildScript =+	`MTool DiffCopy @(`@(MalterlibOriginalModuleDestination).dSYM`->Escape()) @(MalterlibFinalModuleDestinationPath->Escape()) "" 0\r\n`\
						`@(CheckErrors)\r\n`
	{
		&
		{
			!MalterlibFinalModuleDestination MalterlibOriginalModuleDestination
			!DisableDiffCopy true
			PlatformIsDarwin true
			Target.DebugInformationFormat "dwarf-with-dsym"
		}
	}

	PostBuildScript =+ `@(MalterlibExtraPostBuildScript)\r\n`
	{
		&
		{
			TargetIsExecutable true
			!MalterlibExtraPostBuildScript undefined
		}
	}

	PostBuildScript =+ `@(MalterlibPostBuildScriptPreSign)\r\n`
	{
		!MalterlibPostBuildScriptPreSign undefined
	}

	// Do this before signing as we want to strip the executable
	PostBuildScript =+ `echo Deploy Symbols:\r\n`\
					`echo @(MalterlibDumpSymsCommand) @(MalterlibFinalModuleDestinationExecutable->Escape()) \\> @(`@(MalterlibFinalModuleDestination).breakpad`->Escape())\r\n`\
					`@(MalterlibDumpSymsCommand) @(MalterlibFinalModuleDestinationExecutable->Escape()) > @(`@(MalterlibFinalModuleDestination).breakpad`->Escape())\r\n`\
					`@(CheckErrors)\r\n`
	{
		&
		{
			|
			{
				PlatformIsDarwin true
				PlatformFamily "Linux"
			}
			TargetIsExecutable true
			MalterlibDeploySymbols true
		}
	}
	PostBuildScript =+	`echo @(MalterlibDumpSymsCommand) @(`@(MalterlibFinalModuleDestination).dSYM`->Escape()) \\> @(`@(MalterlibFinalModuleDestination).dSYM.breakpad`->Escape())\r\n`\
						`@(MalterlibDumpSymsCommand) @(`@(MalterlibFinalModuleDestination).dSYM`->Escape()) > @(`@(MalterlibFinalModuleDestination).dSYM.breakpad`->Escape())\r\n`\
						`@(CheckErrors)\r\n`
	{
		&
		{
			PlatformIsDarwin true
			TargetIsExecutable true
			MalterlibDeploySymbols true
			Target.DebugInformationFormat "dwarf-with-dsym"
		}
	}

	PostBuildScript =+	`echo zip -qj @(MalterlibFinalModuleDestination->Escape()) @(`@(MalterlibFinalModuleDestination).zip`->Escape())\r\n`\
						`if [ -f @(`@(MalterlibFinalModuleDestination).zip`->Escape()) ]\r\n`\
						`then\r\n`\
						`	rm @(`@(MalterlibFinalModuleDestination).zip`->Escape())\r\n`\
						`	@(CheckErrors)\r\n`\
						`fi\r\n`\
						`zip -qj @(`@(MalterlibFinalModuleDestination).zip`->Escape()) @(MalterlibFinalModuleDestination->Escape())\r\n`\
						`@(CheckErrors)\r\n`
	{
		&
		{
			PlatformFamily "Linux"
			TargetIsExecutable true
			MalterlibDeploySymbols true
		}
	}

	PostBuildScript =+	`echo @(MalterlibStripProgram) @(EscapeHost(MalterlibStripOptions...)) @(MalterlibFinalModuleDestinationExecutable->EscapeHost())\r\n`\
						`@(MalterlibStripProgram) @(EscapeHost(MalterlibStripOptions...)) @(MalterlibFinalModuleDestinationExecutable->EscapeHost())\r\n`\
						`@(CheckErrors)\r\n`
	{
		&
		{
			|
			{
				PlatformIsDarwin true
				PlatformFamily "Linux"
			}
			TargetIsExecutable true
			!MalterlibStripSymbols false
			|
			{
				MalterlibDeploySymbols true
				MalterlibStripSymbols true
			}
			|
			{
				!Configuration "Release Testing"
				PlatformFamily "Linux"
			}
		}
	}

	PostBuildScript =+	`echo zip -qj @(`@(MalterlibFinalModuleDestination).breakpad.zip`->Escape()) @(`@(MalterlibFinalModuleDestination).breakpad`->Escape())\r\n`\
						`if [ -f @(`@(MalterlibFinalModuleDestination).breakpad.zip`->Escape()) ]\r\n`\
						`then\r\n`\
						`	rm @(`@(MalterlibFinalModuleDestination).breakpad.zip`->Escape())\r\n`\
						`	@(CheckErrors)\r\n`\
						`fi\r\n`\
						`zip -qj @(`@(MalterlibFinalModuleDestination).breakpad.zip`->Escape()) @(`@(MalterlibFinalModuleDestination).breakpad`->Escape())\r\n`\
						`@(CheckErrors)\r\n`\
						`echo MTool SymbolBreakpad "/Temp/SymbolTest" @(`@(MalterlibFinalModuleDestination).breakpad`->Escape())\r\n`\
						`export BrekapadOutputPath=\`MTool SymbolBreakpad @(MalterlibDeploySymbolsPath->Escape()) @(`@(MalterlibFinalModuleDestination).breakpad`->Escape())\`\r\n`\
						`@(CheckErrors)\r\n`\
						`echo Deploying symbols to: $BrekapadOutputPath\r\n`
	{
		&
		{
			|
			{
				PlatformFamily "Linux"
				PlatformIsDarwin true
			}
			TargetIsExecutable true
			MalterlibDeploySymbols true
		}
	}

	PostBuildScript =+	`echo zip -qj "@(MalterlibFinalModuleDestination).dSYM.breakpad" "@(MalterlibFinalModuleDestination).dSYM.breakpad.zip"\r\n`\
						`if [ -f "@(MalterlibFinalModuleDestination).dSYM.breakpad.zip" ]\r\n`\
						`then\r\n`\
						`	rm "@(MalterlibFinalModuleDestination).dSYM.breakpad.zip"\r\n`\
						`	@(CheckErrors)\r\n`\
						`fi\r\n`\
						`zip -qj "@(MalterlibFinalModuleDestination).dSYM.breakpad.zip" "@(MalterlibFinalModuleDestination).dSYM.breakpad"\r\n`\
						`@(CheckErrors)\r\n`
	{
		&
		{
			PlatformIsDarwin true
			TargetIsExecutable true
			MalterlibDeploySymbols true
			Target.DebugInformationFormat "dwarf-with-dsym"
		}
	}

	PostBuildScript =+	`echo zip -qj "@(MalterlibFinalModuleDestination).dSYM" "@(MalterlibFinalModuleDestination).dSYM.zip"\r\n`\
						`if [ -f "@(MalterlibFinalModuleDestination).dSYM.zip" ]\r\n`\
						`then\r\n`\
						`	rm "@(MalterlibFinalModuleDestination).dSYM.zip"\r\n`\
						`	@(CheckErrors)\r\n`\
						`fi\r\n`\
						`zip -qrj "@(MalterlibFinalModuleDestination).dSYM.zip" "@(MalterlibFinalModuleDestination).dSYM"\r\n`\
						`@(CheckErrors)\r\n`
	{
		&
		{
			PlatformIsDarwin true
			TargetIsExecutable true
			MalterlibDeploySymbols true
			Target.DebugInformationFormat "dwarf-with-dsym"
		}
	}


	PostBuildScript =+	`echo @(MalterlibDeploySymbolsTool("$BrekapadOutputPath")) DiffCopy "@(MalterlibFinalModuleDestination).breakpad.zip" "$BrekapadOutputPath" "" 0\r\n`\
						`@(MalterlibDeploySymbolsTool("$BrekapadOutputPath")) DiffCopy "@(MalterlibFinalModuleDestination).breakpad.zip" "$BrekapadOutputPath" "" 0\r\n`
	{
		&
		{
			|
			{
				PlatformFamily "Linux"
				PlatformIsDarwin true
			}
			TargetIsExecutable true
			MalterlibDeploySymbols true
		}
	}
	PostBuildScript =+	`echo @(MalterlibDeploySymbolsTool("$BrekapadOutputPath")) DiffCopy "@(MalterlibFinalModuleDestination).dSYM.breakpad.zip" "$BrekapadOutputPath" "" 0\r\n`\
						`@(MalterlibDeploySymbolsTool("$BrekapadOutputPath")) DiffCopy "@(MalterlibFinalModuleDestination).dSYM.breakpad.zip" "$BrekapadOutputPath" "" 0\r\n`
	{
		&
		{
			PlatformIsDarwin true
			TargetIsExecutable true
			MalterlibDeploySymbols true
			Target.DebugInformationFormat "dwarf-with-dsym"
		}
	}
	PostBuildScript =+	`echo @(MalterlibDeploySymbolsTool("$BrekapadOutputPath")) DiffCopy "@(MalterlibFinalModuleDestination).dSYM.zip" "$BrekapadOutputPath" "" 0\r\n`\
						`@(MalterlibDeploySymbolsTool("$BrekapadOutputPath")) DiffCopy "@(MalterlibFinalModuleDestination).dSYM.zip" "$BrekapadOutputPath" "" 0\r\n`
	{
		&
		{
			PlatformIsDarwin true
			TargetIsExecutable true
			MalterlibDeploySymbols true
			Target.DebugInformationFormat "dwarf-with-dsym"
		}
	}
	PostBuildScript =+	`echo @(MalterlibDeploySymbolsTool("$BrekapadOutputPath")) DiffCopy "@(MalterlibFinalModuleDestination).zip" "$BrekapadOutputPath" "" 0\r\n`\
						`@(MalterlibDeploySymbolsTool("$BrekapadOutputPath")) DiffCopy "@(MalterlibFinalModuleDestination).zip" "$BrekapadOutputPath" "" 0\r\n`
	{
		&
		{
			PlatformFamily "Linux"
			TargetIsExecutable true
			MalterlibDeploySymbols true
		}
	}


	PostBuildScript =+	`sn -Ra "@(MalterlibFinalModuleDestination->WindowsPath())" "@(MalterlibStronglyNamedAssembly->WindowsPath())"\r\n`\
						`@(CheckErrors)\r\n`
	{
		&
		{
			TargetIsExecutable true
			!MalterlibStronglyNamedAssembly undefined
			PlatformType "Windows"
			!Configuration "Fast Compile"
		}
	}

	CodeSignEntitlements: string?
	CodeSignEntitlements MalterlibSignMacOSEntitlements
	{
		&
		{
			GeneratorFamily "Xcode"
			!MalterlibSignMacOSEntitlements undefined
		}
	}

	LDFlags =+ "-Wl,-no_adhoc_codesign"
	{
		&
		{
			PlatformFamily "macOS"
			!MalterlibDefaultCompiler true
			TargetIsExecutable true
			|
			{
				MalterlibSigning true
				&
				{
					Target.Type "Driver"
					MalterlibDriverSigning true
				}
			}
		}
	}

	PostBuildScript =+	`echo Sign:\r\n`\
						`echo @(MalterlibCodeSignMacOSCommand) --force @(MalterlibCodeSignMacOSExtraOptions) --timestamp --sign @(MalterlibSignCertMacOS->EscapeHost()) @(MalterlibFinalModuleDestination->EscapeHost())\r\n`\
						`@(MalterlibCodeSignMacOSCommand) --force @(MalterlibCodeSignMacOSExtraOptions) --timestamp --sign @(MalterlibSignCertMacOS->EscapeHost()) @(MalterlibFinalModuleDestination->EscapeHost())\r\n`
	{
		&
		{
			PlatformFamily "macOS"
			TargetIsExecutable true
			|
			{
				MalterlibSigning true
				&
				{
					Target.Type "Driver"
					MalterlibDriverSigning true
				}
			}
		}
	}

	PostBuildScript =+	`echo Notarize:\r\n`\
						`/usr/bin/ditto -c -k --keepParent "@(MalterlibFinalModuleDestination->NativePath())" "@(MalterlibFinalModuleDestination->NativePath()).zip"\r\n`\
						`echo @(MalterlibNotaryToolMacOSCommand) submit "@(MalterlibFinalModuleDestination->NativePath()).zip" --keychain-profile @(MalterlibNotarizeMacOSProfile->EscapeBash()) \r\n`\
						`@(MalterlibNotaryToolMacOSCommand) submit "@(MalterlibFinalModuleDestination->NativePath()).zip" --keychain-profile @(MalterlibNotarizeMacOSProfile->EscapeBash()) 2>&1 | tee "@(MalterlibFinalModuleDestination->NativePath()).log"\r\n`\
						`SubmissionID=\`grep "@(MalterlibFinalModuleDestination->NativePath()).log" -e "id:" | head -n 1 | awk -F 'id: ' '{print $2}'\`\r\n`\
						`echo SubmissionID=$SubmissionID\r\n`\
						`@(MalterlibNotaryToolMacOSCommand) wait "$SubmissionID" --keychain-profile @(MalterlibNotarizeMacOSProfile->EscapeBash())\r\n`\
						`@(MalterlibNotaryToolMacOSCommand) log "$SubmissionID" --keychain-profile @(MalterlibNotarizeMacOSProfile->EscapeBash()) | tee "@(MalterlibFinalModuleDestination->NativePath()).log"\r\n`\
						`if ! grep -q "\\"status\\": \\"Accepted\\"" "@(MalterlibFinalModuleDestination->NativePath()).log"; then\r\n`\
						`	echo "Error: Notarization failed"\r\n`\
						`	exit 1\r\n`\
						`fi\r\n`\
						`echo @(MalterlibStaplerMacOSCommand) staple "@(MalterlibFinalModuleDestination->NativePath())"\r\n`\
						`@(MalterlibStaplerMacOSCommand) staple "@(MalterlibFinalModuleDestination->NativePath())"\r\n`
	{
		&
		{
			PlatformFamily "macOS"
			MalterlibSigning true
			Target.Type "UIExecutable"
			!MalterlibNotarizeMacOSProfile undefined
		}
	}

	PostBuildScript =+	`echo Sign:\r\n`\
						`echo @(MalterlibWindowsSignCommandLine)\r\n`\
						`@(MalterlibWindowsSignCommandLine)\r\n`\
						`@(CheckErrors)\r\n`
	{
		&
		{
			PlatformType "Windows"
			TargetIsExecutable true
			|
			{
				MalterlibSigning true
				&
				{
					Target.Type "Driver"
					MalterlibDriverSigning true
				}
			}

		}
	}

	PostBuildScript =+	`echo Deploy Symbols:\r\n`\
						`echo @(MalterlibDeploySymbolsTool(MalterlibDeploySymbolsPath, `@(MalterlibFinalModuleDestination)?@(Target:Target.SymbolFile)`)) Symbol "@(MalterlibDeploySymbolsPath)" "@(MalterlibFinalModuleDestination)"\r\n`\
						`@(MalterlibDeploySymbolsTool(MalterlibDeploySymbolsPath, `@(MalterlibFinalModuleDestination)?@(Target:Target.SymbolFile)`)) Symbol "@(MalterlibDeploySymbolsPath)" "@(MalterlibFinalModuleDestination)"\r\n`\
						`@(CheckErrors)\r\n`
	{
		&
		{
			PlatformFamily "Windows"
			TargetIsExecutable true
			!Target:Target.SymbolFile undefined
			MalterlibDeploySymbols true
		}
	}

	PostBuildScript =+	`MTool DiffCopy "@(MalterlibFinalModuleDestination)" "@(MalterlibTestDeployPath)" "" 0\r\n`\
						`@(CheckErrors)\r\n`
	{
		&
		{
			!MalterlibTestDeployPath undefined
			TargetIsExecutable true
		}
	}


	PostBuildScript =+	`MTool TouchOrCreate "@(MalterlibTestDeployPath)/@(MalterlibFinalModuleDestination->GetFile()).MainTest"\r\n`\
						`@(CheckErrors)\r\n`
	{
		&
		{
			!MalterlibTestDeployPath undefined
			MalterlibMainTest true
			TargetIsExecutable true
		}
	}

	PostBuildScript =+	`MTool TouchOrCreate "@(MalterlibFinalModuleDestination).MainTest"\r\n`\
						`@(CheckErrors)\r\n`
	{
		&
		{
			!MalterlibTestPutPath undefined
			MalterlibBuildServerTest true
			MalterlibMainTest true
			TargetIsExecutable true
		}
	}

	PostBuildScript =+ `@(ScriptExport("MalterlibDeployRoot", MalterlibDeployRoot))\r\n`
	{
		!MalterlibBuildServerBuild true
	}

	PostBuildScript =+ MalterlibPostCopyContents
	{
		&
		{
			!MalterlibBuildServerBuild true
			!MalterlibPostCopyContents undefined
		}
	}

	PostBuildScript =+ MalterlibPostCopyContents2
	{
		&
		{
			!MalterlibBuildServerBuild true
			!MalterlibCalculatedPostCopyProject2 undefined
			!DisablePostCopy true
			!MalterlibPostCopyContents2 undefined
		}
	}

	PostBuildScript =+ MalterlibBuildServerPutPathUploadContents
	{
		&
		{
			!MalterlibBuildServerPutPath undefined
			MalterlibBuildServerBuild true
			!MalterlibBuildServerTest true
			!MalterlibBuildServerPutDisabled true
		}
	}


	PostBuildScript =+ MalterlibTestPutPathUploadContents
	{
		&
		{
			!MalterlibTestPutPath undefined
			MalterlibBuildServerTest true
			!MalterlibBuildServerPutDisabled true
		}
	}

	PostBuildScript =+ MalterlibPostBuildScript_Last
	{
		&
		{
			!MalterlibPostBuildScript_Last undefined
		}
	}

	PostBuildScript =+	`echo ***RESULT PROPERTY*** : ResultExecutable=@(MalterlibFinalModuleDestination->FullPath())\r\n`\
						`\r\n`
	{
		!!MalterlibNotifyResult true
	}
	PostBuildScript =+	`echo ***RESULT PROPERTY*** : ResultSymbols=@(SymbolFile->FullPath())`\
						`\r\n`
	{
		&
		{
			MalterlibNotifyResult true
			!SymbolFile undefined
		}
	}

	DependencyFile `@(Target.OutputDirectory)@(Target.Name).h`
	{
		&
		{
			GeneratorFamily "Xcode"
		}
	}

	PostBuildScript =+	`MTool CopyWriteTime "@(MalterlibOriginalModuleDestinationExecutable)" "@(Target:Target.DependencyFile)"\r\n`\
						`@(CheckErrors)\r\n`
	{
		&
		{
			!Target:Target.DependencyFile undefined
			!Target:Target.Type "Tool"
		}
	}

	PostBuildScript =+	`MTool TouchOrCreate "@(PostBuildOutputfile)"\r\n`\
						`@(CheckErrors)\r\n`
	{
		|
		{
			!Target:Target.Type "Tool"
			GeneratorFamily "Xcode"
		}
	}
}

