	MToolDirectory: string = Builtin.MToolExe->GetPath()

	MToolPath: string
	MToolPath `@(MToolDirectory)/MTool.exe`
	{
		!!PlatformFamily "Windows"
	}
	MToolPath `@(MToolDirectory)/MTool`
	{
		!PlatformFamily "Windows"
	}

	MalterlibToolsRoot: string = "x:/Development/Malterlib/Tools"
}

Property
{
	MSVCToolChainArchitecture: string = `Host@(HostArchitecture)/@(Architecture)`
}

// Misc
Target
{
	IntermediateDirectory `@(MalterlibCompiledFilesWarkspaceBase)/Int/@(Target:Target.Name)/@(Platform)/@(Architecture)/@(FullConfiguration)/`
	{
		!!Target.IntermediateDirectory undefined
	}
	OutputDirectory	`@(MalterlibCompiledFilesWarkspaceBase)/Out/@(Target:Target.Name)/@(Platform)/@(Architecture)/@(FullConfiguration)/`
	{
		!!Target.OutputDirectory undefined
	}

	ToolPath: [string]?
	ToolPath =+ Builtin.Inherit
	{
		!Builtin.Inherit ""
	}

	ToolPath += ["/usr/local/go/bin", "/usr/local/bin", "/opt/homebrew/bin"]
	{
		!!GeneratorFamily "Xcode"
	}

	VCToolsVersion MalterlibMSVCVersion
	{
		&
		{
			!MalterlibMSVCVersion undefined
			Target.Language "Native"
			GeneratorFamily "VisualStudio"
		}
	}

	ToolPath =+ [MalterlibWindowsSDKBinPath, MalterlibWindowsSDKBinPathx86]
	{
		&
		{
			HostPlatformFamily "Windows"
			!Generator "VisualStudio"
		}
	}

	ToolPath += [MalterlibBinariesDirectory]
	{
		!MToolDirectory MalterlibBinariesDirectory
	}

	ToolPath += [MToolDirectory]

	ToolPath += `@(MalterlibBinariesDirectory)/NoLib/x86`
	{
		&
		{
			PlatformType "Windows"
			MalterlibGenerateLibrary false
			WindowsNativeToolChain false
		}
	}

	ToolPath += `@(MalterlibBinariesDirectory)/NoLib/x64`
	{
		&
		{
			PlatformType "Windows"
			MalterlibGenerateLibrary false
			WindowsNativeToolChain true
		}
	}
}

Property
{
	MalterlibBuildSpecifics =+ `#define DMalterlibBundleIdentifier @(MalterlibBundleIdentifier->Escape())\r\n`
	{
		!!MalterlibIsMacOSBundle true
	}
}

%Group "~Automatic/Build Specifics"
{
	!MalterlibBuildSpecifics undefined

	%GenerateFile "Generate"
	{
		GenerateFile
		{
			Name `@(GeneratedDirectory)MalterlibBuild.h`

			Contents `#pragma once\r\n@(MalterlibBuildSpecifics)`

			UnixLineEnds true
			UnicodeBOM false

			Group `@(Platform) @(Architecture) @(FullConfiguration)`
		}
		Compile
		{
			Type "None"
		}
	}
}

Target
{
	ExtraGroups =+ "~Automatic/Build Specifics"
	{
		!MalterlibBuildSpecifics undefined
	}
}

%Group "~Automatic/Target Dependencies Linker"
{
	!!GeneratorFamily "Xcode"

	Property
	{
		fg_ExpandDependenciesTemplate function(string _Dependency) string = ""
		fg_ExpandDependenciesTemplate =+ `#include @(_Dependency->Escape())\n`
	}

	%GenerateFile "Generate"
	{
		GenerateFile
		{
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
			Name `@(GeneratedDirectory)Dependencies.cpp`

			UnixLineEnds true
			UnicodeBOM false

			Contents [XcodeGeneratorDependencyFiles..., PreBuildOutputFile]->ForEach(&fg_ExpandDependenciesTemplate)
		}
	}
}

Target
{
	ExtraGroups =+ "~Automatic/Target Dependencies Linker"
	{
		!!GeneratorFamily "Xcode"
	}
}

// macOS Specific

Property
{
	MalterlibBundleIdentifier: string = `@(ProductCompanyUniqueIdentifier->Sanitize()).@(Target:Target.Name->Sanitize())`

	MalterlibPostBuildScriptPreSign: string?
	MalterlibPostBuildScriptPreSign =+	`@(ScriptMkDir(`@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.FileExtension)/Contents/Resources`))\r\n`\
										`MTool DiffCopy @(MalterlibExeIcon->Escape()) @(`@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.FileExtension)/Contents/Resources`->Escape()) "" 0\r\n`
	{
		&
		{
			PlatformIsDarwin true
			Target.Type "UIExecutable"
			!MalterlibExeIcon undefined
			!MalterlibExeIcon->GetExtension() "icon"
		}
	}

	MalterlibPostBuildScriptPreSign =+	`@(ScriptMkDir(`@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.FileExtension)/Contents/Resources`))\r\n`\
										`actool --compile @(`@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.FileExtension)/Contents/Resources`->Escape()) --platform macosx --minimum-deployment-target "@(MalterlibMinSupportedMacOSVersion)" --warnings --notices --compress-pngs --app-icon @(MalterlibExeIcon->GetFileNoExt()->Escape()) --output-partial-info-plist @((Target.IntermediateDirectory / "Partial.plist")->Escape()) @(MalterlibExeIcon->Escape())\r\n`
	{
		&
		{
			PlatformIsDarwin true
			Target.Type "UIExecutable"
			!MalterlibExeIcon undefined
			MalterlibExeIcon->GetExtension() "icon"
		}
	}

	MalterlibBundleDebugLogation: string = MalterlibFinalModuleDestinationPath

	MalterlibPostBuildScriptPreSignMalterlibExeMainNibFilePath: string = MalterlibExeMainNibFile->GetLastPaths(2)

	MalterlibPostBuildScriptPreSign =+ `MTool DiffCopy @(MalterlibExeMainNibFile->Escape()) @(`@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.FileExtension)/Contents/Resources/@(MalterlibPostBuildScriptPreSignMalterlibExeMainNibFilePath->GetPath())`->Escape()) "" 0\r\n`
	{
		&
		{
			PlatformIsDarwin true
			Target.Type "UIExecutable"
			!MalterlibExeMainNibFile undefined
		}
	}

	// Process Info.plist and create PkgInfo for non-Xcode builds (Ninja generator)
	// Use plutil to normalize format like Xcode does

	MalterlibPostBuildScriptInputs =+ Target:Target.MalterlibInfoPListFile
	{
		&
		{
			MalterlibIsMacOSBundle true
			!GeneratorFamily "Xcode"
			!Target:Target.MalterlibInfoPListFile undefined
		}
	}

	// Process Info.plist to Contents/ for standard bundles (non-DriverKit)
	MalterlibPostBuildScriptPreSign =+ `plutil -convert xml1 @(Target:Target.MalterlibInfoPListFile->Escape()) -o @(`@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.FileExtension)/Contents/Info.plist`->Escape())\r\n`
	{
		&
		{
			MalterlibIsMacOSBundle true
			!GeneratorFamily "Xcode"
			!Target:Target.MalterlibInfoPListFile undefined
			!Target.DriverType "DriverKit"
		}
	}

	// Process Info.plist to bundle root for DriverKit bundles
	MalterlibPostBuildScriptPreSign =+ `plutil -convert xml1 @(Target:Target.MalterlibInfoPListFile->Escape()) -o @(`@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.FileExtension)/Info.plist`->Escape())\r\n`
	{
		&
		{
			MalterlibIsMacOSBundle true
			!GeneratorFamily "Xcode"
			!Target:Target.MalterlibInfoPListFile undefined
			Target.DriverType "DriverKit"
		}
	}

	// Create PkgInfo for UIExecutable and XcodeBundle (APPL type)
	MalterlibPostBuildScriptPreSign =+ `printf 'APPL????' > @(`@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.FileExtension)/Contents/PkgInfo`->Escape())\r\n`
	{
		&
		{
			MalterlibIsMacOSBundle true
			!GeneratorFamily "Xcode"
			!Target.Type "Driver"
		}
	}

	// Create PkgInfo for IoKit kernel extensions (KEXT type)
	MalterlibPostBuildScriptPreSign =+ `printf 'KEXT????' > @(`@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.FileExtension)/Contents/PkgInfo`->Escape())\r\n`
	{
		&
		{
			MalterlibIsMacOSBundle true
			!GeneratorFamily "Xcode"
			Target.Type "Driver"
			Target.DriverType "IoKit"
		}
	}
}

// Out of process Specific

Property
{
	MalterlibPostBuildScriptPreSign =+ `MTool DiffCopy @(MalterlibOverrideMallocLibrary->Escape()) @(`@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.FileExtension)/Contents/MacOS`->Escape()) "" 0\r\n`
	{
		&
		{
			MalterlibNeedsMallocOverrideLibrary true
			MalterlibIsMacOSBundle true
		}
	}

	MalterlibPostBuildScriptPreSign =+ `MTool DiffCopy @(MalterlibHelperExecutable->Escape()) @(`@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.FileExtension)/Contents/MacOS`->Escape()) "" 0\r\n`
	{
		&
		{
			MalterlibNeedsMalterlibHelper true
			MalterlibIsMacOSBundle true
		}
	}
	MalterlibPostBuildScriptPreSign =+ `MTool DiffCopy @(MalterlibLLVMSanitizerRuntime->Escape()) @(`@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.FileExtension)/Contents/MacOS`->Escape()) "" 0\r\n`
	{
		&
		{
			MalterlibNeedsLLVMSanitizerRuntime true
			MalterlibIsMacOSBundle true
		}
	}


	MalterlibPostBuildScriptPreSign =+ `MTool DiffCopy "@(GetProperty(&MalterlibFinalModuleDestination, "Group:Libraries.Target:Exe_AOCCOutOfProcess.Target:Exe_AOCCOutOfProcess"))" @(`@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.FileExtension)/Contents/MacOS`->Escape()) "" 0\r\n`
	{
		&
		{
			MalterlibOutOfProcessSupport true
			PlatformFamily "macOS"
		}
	}

	MalterlibPostBuildScriptPreSign =+ `MTool DiffCopy "@(GetProperty(&MalterlibFinalModuleDestination, "Group:Libraries.Target:Exe_AOCCOutOfProcess.Target:Exe_AOCCOutOfProcess"))" @(MalterlibFinalModuleDestinationPath->Escape()) "" 0\r\n`
	{
		&
		{
			MalterlibOutOfProcessSupport true
			PlatformFamily "Windows"
		}
	}
}

Target
{
	MalterlibInfoPListFile: string?
	MalterlibInfoPListFile `@(GeneratedDirectory)Info.plist`
	{
		&
		{
			PlatformIsDarwin true
			|
			{
				Target.Type "UIExecutable"
				Target.Type "Driver"
				Target.Type "Executable"
				Target.Type "ConsoleExecutable"
				Target.Type "DynamicLibrary"
				Target.Type "XcodeBundle"
				Target.Type "SharedDynamicLibrary"
			}
		}
	}

	BundleIdentifier: string?
	BundleIdentifier MalterlibBundleIdentifier
	{
		!!PlatformFamily "macOS"
	}
}

Property
{
	MalterlibTargetFriendlyName: string = Target:Target.Name
	MalterlibXcodePrincipalClass: string = "NSApplication"
	MalterlibExtraPListContents: string?
}

Type
{
	CMalterlibURLScheme: {
		Protocols: [string]
		, Role: string
		, Name: string
		, IconFile: string = ""
	}
}

Property
{
	MalterlibURLScheme: [type(CMalterlibURLScheme)]?
}

%Group "~Automatic/MacOS Specific"
{
	%GenerateFile "Generate"
	{
		!Target:Target.MalterlibInfoPListFile undefined

		Property
		{
			URLSchemeTemplateProtocol function(string _Protocol) string
			URLSchemeTemplateProtocol =+ `					<string>@(_Protocol)</string>\n`

			URLSchemeTemplate function(type(CMalterlibURLScheme) _Scheme) string
			URLSchemeTemplate =+	`		<dict>\n`\
									`			<key>CFBundleTypeRole</key>\n`\
									`				<string>@(_Scheme<Role>)</string>\n`\
									`				<key>CFBundleURLName</key>\n`\
									`				<string>@(_Scheme<Name>)</string>\n`\
									`				<key>CFBundleURLIconFile</key>\n`\
									`				<string>@(_Scheme<IconFile>)</string>\n`\
									`				<key>CFBundleURLSchemes</key>\n`\
									`				<array>\n`\
									`@(_Scheme<Protocols>->ForEach(&URLSchemeTemplateProtocol))`\
									`				</array>\n`\
									`		</dict>\n`
		}
		GenerateFile
		{
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
			Name `@(GeneratedDirectory)Info.plist`

			Contents	`<?xml version="1.0" encoding="UTF-8"?>\n`\
						`<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n`\
						`<plist version="1.0">\n`\
						`<dict>\n`\
						`	<key>CFBundleDevelopmentRegion</key>\n`\
						`		<string>en</string>\n`\
						`	<key>CFBundleExecutable</key>\n`\
						`		<string>@(Target:Target.FileName)</string>\n`\
						`	<key>CFBundleIdentifier</key>\n`\
						`		<string>@(MalterlibBundleIdentifier)</string>\n`\
						`	<key>CFBundleInfoDictionaryVersion</key>\n`\
						`		<string>6.0</string>\n`\
						`	<key>CFBundleVersion</key>\n`\
						`		<string>@(ProductVersionMajor->ToString()).@(ProductVersionMinor->ToString()).@(ProductVersionRevision->ToString())</string>\n`\
						`	<key>CFBundleShortVersionString</key>\n`\
						`		<string>@(ProductVersionMajor->ToString()).@(ProductVersionMinor->ToString()).@(ProductVersionRevision->ToString())</string>\n`\
						`	<key>CFBundleName</key>\n`\
						`		<string>@(MalterlibTargetFriendlyName)</string>\n`

			Contents =+	`	<key>CFBundleDisplayName</key>\n`\
						`		<string>@(Target:Target.FileName)</string>\n`\
						`	<key>NSHumanReadableCopyright</key>\n`\
						`		<string>@(ProductCopyright)</string>\n`\
						`	<key>NSPrincipalClass</key>\n`\
						`		<string>@(MalterlibXcodePrincipalClass)</string>\n`\
						`	<key>LSMinimumSystemVersion</key>\n`\
						`		<string>@(MalterlibMinSupportedMacOSVersion)</string>\n`\
						`	<key>MalterlibBranch</key>\n`\
						`		<string>@(MalterlibFullBranch)</string>\n`\
						`	<key>MalterlibGitBranch</key>\n`\
						`		<string>@(MalterlibGitBranch || "")</string>\n`\
						`	<key>MalterlibGitCommit</key>\n`\
						`		<string>@(MalterlibGitCommit)</string>\n`\
						`	<key>BuildTime</key>\n`\
						`		<string>@(CurrentMalterlibTime)</string>\n`\
						`	<key>ProductVersionMajor</key>\n`\
						`		<string>@(ProductVersionMajor)</string>\n`\
						`	<key>ProductVersionMinor</key>\n`\
						`		<string>@(ProductVersionMinor)</string>\n`\
						`	<key>ProductVersionRevision</key>\n`\
						`		<string>@(ProductVersionRevision)</string>\n`\
						`	<key>ProductVersionExtra</key>\n`\
						`		<string>@(ProductVersionExtra)</string>\n`\
						`	<key>CFBundlePackageType</key>\n`\
						`		<string>APPL</string>\n`\
						`	<key>NSHighResolutionCapable</key>\n`\
						`		<string>YES</string>\n`
			{
				!Target.Type "Driver"
			}

			Contents =+	`	<key>CFBundlePackageType</key>\n`\
						`		<string>KEXT</string>\n`
			{
				&
				{
					Target.Type "Driver"
					Target.DriverType "IoKit"
				}
			}

			Contents =+	`	<key>CFBundlePackageType</key>\n`\
						`		<string>DEXT</string>\n`
			{
				&
				{
					Target.Type "Driver"
					Target.DriverType "DriverKit"
				}
			}

			Contents =+	`	<key>OSMinimumDriverKitVersion</key>\n`\
						`		<string>@(Target.DriverkitDeploymentTarget)</string>\n`
			{
				&
				{
					Target.Type "Driver"
					Target.DriverType "DriverKit"
					!Target.DriverkitDeploymentTarget undefined
				}
			}

			Contents =+	`	<key>CFBundleSupportedPlatforms</key>\n`\
						`	<array>\n`\
						`		<string>MacOSX</string>\n`\
						`	</array>\n`
			{
				!!PlatformFamily "macOS"
			}


			Contents =+	`	<key>BreakpadProduct</key>\n`\
						`		<string>@(Target:Target.FileName)</string>\n`\
						`	<key>BreakpadProductDisplay</key>\n`\
						`		<string>@(MalterlibTargetFriendlyName)</string>\n`\
						`	<key>BreakpadURL</key>\n`\
						`		<string>@(MalterlibBreakpadUploadServer)</string>\n`\
						`	<key>BreakpadReportInterval</key>\n`\
						`		<string>@(MalterlibBreakpadReportInterval->ToString())</string>\n`\
						`	<key>BreakpadVendor</key>\n`\
						`		<string>@(ProductCompany)</string>\n`\
						`	<key>BreakpadVersion</key>\n`\
						`		<string>@(Target:Target.Version)</string>\n`\
						`	<key>BreakpadInProcess</key>\n`\
						`		<string>YES</string>\n`


			{
				!!MalterlibEnableBreakpad true
			}

			Contents =+	`	<key>BreakpadRequestEmail</key>\n`\
						`		<string>YES</string>\n`
			{
				&
				{
					MalterlibEnableBreakpad true
					MalterlibBreakpadRequestEmail true
				}
			}

			Contents =+	`	<key>BreakpadRequestComments</key>\n`\
						`		<string>YES</string>\n`
			{
				&
				{
					MalterlibEnableBreakpad true
					MalterlibBreakpadRequestComments true
				}
			}

			Contents =+	`	<key>CFBundleIconFile</key>\n`\
						`	<string>@(MalterlibExeIcon->GetFileNoExt())</string>\n`
			{
				!MalterlibExeIcon undefined
			}

			Contents =+	`	<key>CFBundleIconName</key>\n`\
						`	<string>@(MalterlibExeIcon->GetFileNoExt())</string>\n`
			{
				&
				{
					!MalterlibExeIcon undefined
					MalterlibExeIcon->GetExtension() "icon"
				}
			}


			Contents =+	`	<key>NSMainNibFile</key>\n`\
						`	<string>@(MalterlibExeMainNibFile->GetFileNoExt())</string>\n`
			{
				!MalterlibExeMainNibFile undefined
			}


			Contents =+	`	<key>CFBundleURLTypes</key>\n`\
						`		<array>\n`\
						`@(Target:MalterlibURLScheme->ForEach(&URLSchemeTemplate))\n`\
						`		</array>\n`
			{
				!Target:MalterlibURLScheme undefined
			}

			Contents =+	`	<key>LSUIElement</key>\n`\
						`		<string>1</string>\n`
			{
				&
				{
					Property.MalterlibMacOSHideDockTile true
					!Target.Type "Driver"
				}
			}

			Contents =+	`	<key>NSRequiresAquaSystemAppearance</key>\n`\
						`		<string>YES</string>\n`
			{
				!!Property.MalterlibMacOSNoDarkMode true
			}

			Contents =+	MalterlibExtraPListContents
			{
				!MalterlibExtraPListContents undefined
			}

			Contents =+	`</dict>\n`\
						`</plist>\n`
			UnicodeBOM true
		}
		Compile
		{
			Type "None"
		}
	}
}
Target
{
	ExtraGroups =+ "~Automatic/MacOS Specific"
	{
		!Target:Target.MalterlibInfoPListFile undefined
	}
}
Property
{
	MalterlibLinuxProgramIdentifier: string?
	MalterlibLinuxProgramIdentifier `@(ProductCompanyUniqueIdentifier->Sanitize()).@(Target:Target.Name->Sanitize())`
	{
		&
		{
			PlatformFamily "Linux"
			TargetIsExecutable true
		}
	}

	MalterlibLinuxDesktopFile: string?
	MalterlibLinuxDesktopFile `@(GeneratedDirectory)@(MalterlibLinuxProgramIdentifier).desktop`
	{
		&
		{
			PlatformFamily "Linux"
			Target.Type "UIExecutable"
			!MalterlibBuildServerBuild true
		}
	}
}

%Group "~Automatic/Linux Specific"
{
	%GenerateFile "Generate"
	{
		!MalterlibDisableMalterlib true

		GenerateFile
		{
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
			Name `@(GeneratedDirectory)VersionInfo.cpp`

			Contents	`#include <Mib/Core/Core>\n`\
						`assure_used static char fileid[] __attribute__ ((section("IDSVERSIONINFO"))) = "$Id: VersionInfo.cpp,v @(Target:Target.Version) @(CurrentTimeVersionString) $\\n"\n`\
						`@(`MalterlibBranch=@(MalterlibFullBranch)\n`->EJSONToString())\n`\
						`@(`MalterlibGitBranch=@(MalterlibGitBranch || "")\n`->EJSONToString())\n`\
						`@(`MalterlibGitCommit=@(MalterlibGitCommit || "")\n`->EJSONToString())\n`\
						`@(`BuildTime=@(CurrentMalterlibTime)\n`->EJSONToString())\n`\
						`@(`ProductVersionMajor=@(ProductVersionMajor)\n`->EJSONToString())\n`\
						`@(`ProductVersionMinor=@(ProductVersionMinor)\n`->EJSONToString())\n`\
						`@(`ProductVersionRevision=@(ProductVersionRevision)\n`->EJSONToString())\n`\
						`@(`ProductVersionExtra=@(ProductVersionExtra)\n`->EJSONToString());\n`

			UnicodeBOM true
		}
	}

	%GenerateFile ".desktop"
	{
		!MalterlibLinuxDesktopFile undefined
		GenerateFile
		{
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
			Name MalterlibLinuxDesktopFile

			Contents	`[Desktop Entry]\n`\
						`Name=@(MalterlibTargetFriendlyName)\n`\
						`Version=@(ProductVersionMajor->ToString()).@(ProductVersionMinor->ToString()).@(ProductVersionRevision->ToString())\n`\
						`Type=Application\n`

			Contents =+	`Icon=@(MalterlibDeployRoot)/@(MalterlibCalculatedPostCopyProject)/@(MalterlibExeIcon->GetFile())\n`
			{
				!MalterlibExeIcon undefined
			}

			Contents =+	`Terminal=false\n`
			{
				!Target.Type "ConsoleExecutable"
			}

			Contents =+	`Terminal=true\n`
			{
				!!Target.Type "ConsoleExecutable"
			}

			UnicodeBOM false
		}
	}
}

Target
{
	ExtraGroups =+ "~Automatic/Linux Specific"
	{
		&
		{
			PlatformFamily "Linux"
			TargetIsExecutable true
		}
	}
}

Property
{
	MalterlibWindowsSettings_SegmentHeap: bool = true
	MalterlibWindowsSettings_LongPathAware: bool = true
	MalterlibExtraAssemblyInfo: string = ""
	MalterlibGenerateWindowsVersion: bool = true
}

%Group "{~Automatic}/{Windows Specific}"
{
	%Group "~Automatic"
	{
		%Group "Windows Specific"
		{
			%GenerateFile "Generate .NET Assembly Info"
			{
				!!LanguageFamily ".NET"
				Property
				{
					CalcGUID: string = MalterlibFinalModuleDestination->HashUUID("Bare")
				}
				GenerateFile
				{
					Group `@(Platform) @(Architecture) @(FullConfiguration)`
					Name `@(GeneratedDirectory)AssemblyInfo.cs`

					Contents	`\n`\
								`#if (@(MalterlibUniqueConfig))\r\n`\
								`using System.Reflection;\r\n`\
								`using System.Runtime.CompilerServices;\r\n`\
								`using System.Runtime.InteropServices;\r\n`\
								`[assembly: AssemblyTitle(@(ProductName->Escape()))]\r\n`\
								`[assembly: AssemblyDescription(@(ProductDescription->Escape()))]\r\n`\
								`[assembly: AssemblyConfiguration(@(ProductVersionExtra->Escape()))]\r\n`\
								`[assembly: AssemblyCompany(@(ProductCompany->Escape()))]\r\n`\
								`[assembly: AssemblyProduct(@(ProductName->Escape()))]\r\n`\
								`[assembly: AssemblyCopyright(@(ProductCopyright->Escape()))]\r\n`\
								`[assembly: AssemblyTrademark("")]\r\n`\
								`[assembly: AssemblyCulture("")]\r\n`\
								`[assembly: ComVisible(false)]\r\n`\
								`[assembly: Guid(@(CalcGUID->Escape()))]\r\n`\
								`[assembly: AssemblyFileVersion(@(`@(ProductVersionMajor).@(ProductVersionMinor).@(ProductVersionRevision).0`->Escape()))]\r\n`\
								`[assembly: AssemblyVersion(@(`@(ProductVersionMajor).@(ProductVersionMinor).@(ProductVersionRevision).0`->Escape()))]\r\n`\
								`@(MalterlibExtraAssemblyInfo)`\
								`#endif\r\n`

					UnicodeBOM true
				}
			}

			// .NET 5+ apps need a runtimeconfig.json next to the entry assembly so the
			// host (apphost.exe / dotnet) knows which framework version to load.
			// Without this, running the .exe falls back to .NET Framework 4 and fails
			// with "Could not load file or assembly 'System.Runtime, Version=8.0.0.0...'".
			%GenerateFile "Generate .NET runtimeconfig.json"
			{
				&
				{
					LanguageFamily ".NET"
					Target.CLRSupport "NetCore"
					TargetIsLaunchableExecutable true
				}

				GenerateFile
				{
					Group `@(Platform) @(Architecture) @(FullConfiguration)`
					Name `@(GeneratedDirectory)@(MalterlibFinalModuleDestination->GetFileNoExt()).runtimeconfig.json`

					ContentsJson: any = {
						runtimeOptions: {
							tfm: Target.TargetFrameworkVersion
							, framework: {
								name: "Microsoft.NETCore.App"
								, version: `@(Target.TargetFrameworkVersion->Extract(3)).0`
							}
						}
					}

					Contents GenerateFile.ContentsJson->ToString()

					// hostfxr's bundle-loader feeds runtimeconfig.json bytes
					// straight to RapidJSON without skipping a UTF-8 BOM, so a
					// BOM here causes the embedded config to fail JSON parse
					// inside a single-file apphost. Emit raw UTF-8 with no BOM.
					UnicodeBOM false
				}
			}

			%GenerateFile "Generate C++ Managed"
			{
				&
				{
					LanguageFamily "Native"
					Target.CLRSupport true
				}

				Property
				{
					CalcGUID: string = MalterlibFinalModuleDestination->HashUUID("Bare")
				}
				GenerateFile
				{
					Group `@(Platform) @(Architecture) @(FullConfiguration)`
					Name `@(GeneratedDirectory)AssemblyInfo.cpp`

					Contents	`\n`\
								`using namespace System;\r\n`\
								`using namespace System::Reflection;\r\n`\
								`using namespace System::Runtime::CompilerServices;\r\n`\
								`using namespace System::Runtime::InteropServices;\r\n`\
								`using namespace System::Security::Permissions;\r\n`\
								`[assembly:AssemblyTitleAttribute(@(ProductName->Escape()))];\r\n`\
								`[assembly:AssemblyDescriptionAttribute(@(ProductDescription->Escape()))];\r\n`\
								`[assembly:AssemblyConfigurationAttribute(@(ProductVersionExtra->Escape()))];\r\n`\
								`[assembly:AssemblyCompanyAttribute(@(ProductCompany->Escape()))];\r\n`\
								`[assembly:AssemblyProductAttribute(@(ProductName->Escape()))];\r\n`\
								`[assembly:AssemblyCopyrightAttribute(@(ProductCopyright->Escape()))];\r\n`\
								`[assembly:AssemblyTrademarkAttribute("")];\r\n`\
								`[assembly:AssemblyCultureAttribute("")];\r\n`\
								`[assembly:ComVisible(false)];\r\n`\
								`[assembly:Guid(@(CalcGUID->Escape()))];\r\n`\
								`[assembly:CLSCompliantAttribute(true)];\r\n`\
								`[assembly:AssemblyFileVersionAttribute(@(`@(ProductVersionMajor).@(ProductVersionMinor).@(ProductVersionRevision).0`->Escape()))];\r\n`\
								`[assembly:AssemblyVersionAttribute(@(`@(ProductVersionMajor).@(ProductVersionMinor).@(ProductVersionRevision).0`->Escape()))];\r\n`\
								`#pragma warning(disable:4947) // Request minimum deprecated in .NET 4.0\r\n`\
								`[assembly:SecurityPermission(SecurityAction::RequestMinimum, UnmanagedCode = true)];\r\n`\
								`@(MalterlibExtraAssemblyInfo)`

					UnicodeBOM true
				}
			}

			%GenerateFile "Generate Resource"
			{
				&
				{
					LanguageFamily "Native"
					MalterlibGenerateWindowsVersion true
				}

				Property
				{
					ResourceFileType: string = "VFT_UNKNOWN"

					ResourceFileType "VFT_APP"
					{
						!!Target.Type "ConsoleExecutable"
						!!Target.Type "UIExecutable"
						!!Target.Type "Executable"
					}
					ResourceFileType "VFT_DRV"
					{
						!!Target.Type "Driver"
					}
					ResourceFileType "VFT_DLL"
					{
						!!Target.Type "DynamicLibrary"
						!!Target.Type "SharedDynamicLibrary"
					}

					PrivateBuildString: string = {
						MalterlibBranch: MalterlibFullBranch
						, MalterlibGitBranch: (MalterlibGitBranch || "")
						, MalterlibGitCommit: MalterlibGitCommit
					}->EJSONToString("")
				}
				GenerateFile
				{
					Group `@(Platform) @(Architecture) @(FullConfiguration)`
					Name `@(GeneratedDirectory)Resources.rc`

					Contents	`\n`\
								`#define IDI_ICON1                       101\r\n`\
								`// Next default values for new objects\r\n`\
								`// \r\n`\
								`#ifdef APSTUDIO_INVOKED\r\n`\
								`#ifndef APSTUDIO_READONLY_SYMBOLS\r\n`\
								`#define _APS_NEXT_RESOURCE_VALUE        102\r\n`\
								`#define _APS_NEXT_COMMAND_VALUE         40001\r\n`\
								`#define _APS_NEXT_CONTROL_VALUE         1001\r\n`\
								`#define _APS_NEXT_SYMED_VALUE           101\r\n`\
								`#endif\r\n`\
								`#endif\r\n`\
								`IDI_ICON1 ICON @(`@(MalterlibExeIcon->MakeRelative(GeneratedDirectory)->WindowsPath()->Replace("\\", "\\\\"))`->Escape())\r\n`
					{
						!MalterlibExeIcon undefined
					}

					Contents =+	`#include "winres.h"\r\n`\
								`VS_VERSION_INFO VERSIONINFO\r\n`\
								` FILEVERSION @(ProductVersionMajor),@(ProductVersionMinor),@(ProductVersionRevision->AsInteger()->ToString()),0\r\n`\
								` PRODUCTVERSION @(ProductVersionMajor),@(ProductVersionMinor),@(ProductVersionRevision->AsInteger()->ToString()),0\r\n`\
								` FILEFLAGSMASK 0x17L\r\n`\
								`#ifdef _DEBUG\r\n`\
								` FILEFLAGS VS_FF_DEBUG | VS_FF_PRIVATEBUILD\r\n`\
								`#else\r\n`\
								` FILEFLAGS VS_FF_PRIVATEBUILD\r\n`\
								`#endif\r\n`\
								` FILEOS VOS_NT_WINDOWS32\r\n`\
								` FILETYPE @(ResourceFileType)\r\n`\
								` FILESUBTYPE VFT2_UNKNOWN\r\n`\
								`BEGIN\r\n`\
								`	BLOCK "StringFileInfo"\r\n`\
								`	BEGIN\r\n`\
								`		BLOCK "040904b0"\r\n`\
								`		BEGIN\r\n`\
								`			VALUE "CompanyName", @(ProductCompany->Escape())\r\n`\
								`			VALUE "FileDescription", @(ProductDescription->Escape())\r\n`\
								`			VALUE "FileVersion", @(`@(ProductVersionMajor).@(ProductVersionMinor)@(ProductVersionRevision) @(ProductVersionExtra)`->Escape())\r\n`\
								`			VALUE "InternalName", @(Target:Target.FileName->Escape())\r\n`\
								`			VALUE "LegalCopyright", @(ProductCopyright->Escape())\r\n`\
								`			VALUE "OriginalFilename", @(`@(Target:Target.FileName)@(Target:Target.FileExtension)`->Escape())\r\n`\
								`			VALUE "ProductName", @(ProductName->Escape())\r\n`\
								`			VALUE "ProductVersion", @(`@(ProductVersionMajor).@(ProductVersionMinor)@(ProductVersionRevision) @(ProductVersionExtra)`->Escape())\r\n`\
								`			VALUE "PrivateBuild", @(PrivateBuildString->Escape()->Replace("\\\"", "\\x22"))\r\n`\
								`		END\r\n`\
								`	END\r\n`\
								`	BLOCK "VarFileInfo"\r\n`\
								`	BEGIN\r\n`\
								`		VALUE "Translation", 0x0409, 1200\r\n`\
								`	END\r\n`\
								`END\r\n`

					UTF16 true
					UnicodeBOM true

					// llvm-rc doesn't support UTF-16, use UTF-8 for Ninja generator
					UTF16 false
					{
						!!Generator "Ninja"
					}
				}
			}

			%GenerateFile "Manifest"
			{
				!!LanguageFamily "Native"

				GenerateFile
				{
					Group `@(Platform) @(Architecture) @(FullConfiguration)`
					Name `@(GeneratedDirectory)WindowsManifest.manifest`

					Contents	'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\r\n'\
								'<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0" xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">\r\n'\
								'	<asmv3:application>\r\n'\
								'		<asmv3:windowsSettings xmlns="http://schemas.microsoft.com/SMI/2020/WindowsSettings" xmlns:ws2="http://schemas.microsoft.com/SMI/2016/WindowsSettings">\r\n'

					Contents =+ '			<heapType>SegmentHeap</heapType>\r\n'
					{
						!!MalterlibWindowsSettings_SegmentHeap true
					}

					Contents =+ '			<ws2:longPathAware>true</ws2:longPathAware>\r\n'
					{
						!!MalterlibWindowsSettings_LongPathAware true
					}

					Contents =+ '		</asmv3:windowsSettings>\r\n'\
								'	</asmv3:application>\r\n'\
								'</assembly>\r\n'


					UTF16 false
					UnicodeBOM true
				}
			}
		}
	}

	Target
	{
		!!LanguageFamily "Native"

		// For Visual Studio, add manifest via ExtraLinkerFlags
		// For Ninja, this is handled by Ninja_WindowsManifest.MGeneratorSettings with -Wl, prefix
		ExtraLinkerFlags =+ `/MANIFESTINPUT:@(GeneratedDirectory)WindowsManifest.manifest`
		{
			!Generator "Ninja"
		}
	}
}

Target
{
	ExtraGroups =+ "{~Automatic}/{Windows Specific}"
	{
		&
		{
			PlatformFamily "Windows"
			TargetIsExecutable true
			!MalterlibDisableAutomaticResources true
		}
	}
}

Property
{
	MalterlibModuleDefinitionContents: string = ""
	MalterlibModuleDefinitionContents `EXPORTS@(NativeLineEnding)`
	{
		!!PlatformFamily "Windows"
	}

	ModuleDefineTemplate function(string _Symbol) string

	ModuleDefineTemplate =+ `@(_Symbol)@(NativeLineEnding)`
	{
		!!PlatformFamily "Windows"
	}
	ModuleDefineTemplate =+ `_@(_Symbol)@(NativeLineEnding)`
	{
		!!PlatformIsDarwin true
	}

	MalterlibDefinedSymbols: [string]?

	MalterlibModuleDefinitionContents =+ MalterlibDefinedSymbols->ForEach(&ModuleDefineTemplate)

	MalterlibStripProgram: string
	MalterlibStripProgram `@(MalterlibToolsPrefix)llvm-strip`
	{
		!MalterlibToolsPrefix undefined
	}
	MalterlibStripProgram "strip"
	{
		&
		{
			PlatformIsDarwin true
			MalterlibDefaultCompiler true
		}
	}

	MalterlibObjCopyProgram: string
	MalterlibObjCopyProgram `@(MalterlibToolsPrefix)llvm-objcopy`
	{
		!MalterlibToolsPrefix undefined
	}
	MalterlibObjCopyProgram "llvm-objcopy"
	{
		!!MalterlibObjCopyProgram undefined
	}

	MalterlibReadElfProgram: string
	MalterlibReadElfProgram `@(MalterlibToolsPrefix)llvm-readobj`
	{
		!MalterlibToolsPrefix undefined
	}
	MalterlibReadElfProgram "llvm-readelf"
	{
		!!MalterlibReadElfProgram undefined
	}

	MalterlibStripOptions: [string] = []

	MalterlibStripOptions =+ ["-u", "-r"]
	{
		&
		{
			PlatformIsDarwin true
			MalterlibDefaultCompiler true
		}
	}
	MalterlibStripOptions =+ ["--discard-all"]
	{
		&
		{
			PlatformIsDarwin true
			!MalterlibDefaultCompiler true
		}
	}

	MalterlibStripOptions =+ ["--strip-all-gnu"]
	{
		!!PlatformFamily "Linux"
	}

	ModuleDefineTemplateLLVMStrip function(string _Symbol) [string]
	ModuleDefineTemplateLLVMStrip =+ `--keep-symbol=_@(_Symbol)`

	MalterlibStripOptions =+ MalterlibDefinedSymbols->ForEach(&ModuleDefineTemplateLLVMStrip)
	{
		&
		{
			!MalterlibDefinedSymbols undefined
			PlatformFamily "Linux"
		}
	}
}

%Group "~Automatic/DLL Definition"
{
	%GenerateFile "Generate"
	{
		GenerateFile
		{
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
			Name `@(GeneratedDirectory)Module.def`

			Contents MalterlibModuleDefinitionContents
			UnicodeBOM false
		}
		Compile
		{
			Type "None"
		}
	}
}
Target
{
	ExtraGroups =+ "~Automatic/DLL Definition"
	{
		&
		{
			!MalterlibDefinedSymbols undefined
			|
			{
				PlatformFamily "Windows"
				PlatformFamily "macOS"
			}
		}
	}

	ModuleDefinitionFile: string?
	ModuleDefinitionFile GeneratedDirectory / "Module.def"
	{
		&
		{
			!MalterlibDefinedSymbols undefined
			|
			{
				PlatformFamily "Windows"
				PlatformFamily "macOS"
			}
		}
	}
}


// ExeFS

Property
{
	MalterlibExeFSExtraFiles: [type(CFileCopyOptions)] = []

	MalterlibExeFSExtraFilesContentsTemplate function(type(CFileCopyOptionsDetailed) _CopyOptions) string = ""
	MalterlibExeFSExtraFilesContentsTemplate Error("FindDirectory not supported for ExeFS")
	{
		!!true _CopyOptions<FindDirectory>
	}
	MalterlibExeFSExtraFilesContentsTemplate Error("Turning on AbsoluteDestination is not supported for ExeFS")
	{
		!!true _CopyOptions<AbsoluteDestination>
	}
	MalterlibExeFSExtraFilesContentsTemplate =+	`Include\r\n`\
												`{\r\n`\
												`	Pattern @(_CopyOptions<Pattern>->Escape())\r\n`\
												`	Destination @(_CopyOptions<Destination>->Escape())\r\n`\
												`	Recurse @(_CopyOptions<Recursive> ? "1" : "0")\r\n`\
												`}\r\n`

	MalterlibExeFSSpecContents: string?

	MalterlibExeFSSpecContents =+ `Include\r\n`\
								`{\r\n`\
								`	Pattern @(MalterlibExeFSPath->UnixPath()->Escape())\r\n`\
								`}\r\n`\
								`Include\r\n`\
								`{\r\n`\
								`	Pattern @(MalterlibTempExeFSPath->UnixPath()->Escape())\r\n`\
								`}\r\n`\
								`Include\r\n`\
								`{\r\n`\
								`	Pattern @(MalterlibSharedTempExeFSPath->UnixPath()->Escape())\r\n`\
								`}\r\n`\
								`@(fg_ExpandCopyOptions(MalterlibExeFSExtraFiles)->ForEach(&MalterlibExeFSExtraFilesContentsTemplate))`
	{
		&
		{
			TargetIsExecutable true
			MalterlibDoExeFS true
		}
	}
	MalterlibExeFSSpecContents =+	`Include\r\n`\
									`{\r\n`\
									`	Pattern @(MalterlibLocalizationExeFSPath->UnixPath()->Escape())\r\n`\
									`}\r\n`
	{
		&
		{
			MalterlibDoTranslationExeFS true
			MalterlibDoExeFS true
		}
	}
}

%Group "~Automatic/Dummy"
{
	%File "../Source/Dummy/Dummy.c"
	{
		!!MalterlibNeedLanguage_C true
	}
	%File "../Source/Dummy/Dummy.cpp"
	{
		!!MalterlibNeedLanguage_Cxx true
	}
}

Target
{
	ExtraGroups =+ "~Automatic/Dummy"
	{
		!!MalterlibNeedLanguage_C true
		!!MalterlibNeedLanguage_Cxx true
	}
}

%Group "~Automatic/Malterlib ExeFS Files"
{
	%GenerateFile "Generate"
	{
		GenerateFile
		{
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
			Name `@(GeneratedDirectory)/@(Workspace:Workspace.Name)_@(Target:Target.Name).MalterlibFSSpec`
			Contents MalterlibExeFSSpecContents
			UnicodeBOM true
		}
	}
}

Property
{
	MalterlibNeedLanguage_C: bool = false

	MalterlibNeedLanguage_Cxx: bool = false
	MalterlibNeedLanguage_Cxx true
	{
		|
		{
			!MalterlibExeFSSpecContents undefined
			GeneratorFamily "Xcode" // Needed for dependency checking
		}
	}
}
Target
{
	ExtraGroups =+ "~Automatic/Malterlib ExeFS Files"
	{
		!MalterlibExeFSSpecContents undefined
	}
}

Property
{
	f_GetUrlInfo function(string _Property) [{
		URL: string,
		Location: string,
		Commit: string,
	}]

	f_GetUrlInfo =+ {
		URL: GetProperty(&Repository.URL, _Property),
		Location: GetProperty(&Repository.Location, _Property),
		Commit: ExecuteCommand(`@(GeneratedGlobalDirectory)GitCommit-@(GetProperty(&Repository.Location, _Property)->HashSHA256()).MState`, f_MalterlibGitRepoInputFiles(f_MalterlibGitDataDir(GetProperty(&Repository.Location, _Property)), f_MalterlibGitCommonDir(f_MalterlibGitDataDir(GetProperty(&Repository.Location, _Property)))), "git", "-C", GetProperty(&Repository.Location, _Property), "rev-parse", "HEAD")->Trim()
	}

	MalterlibEnableRepoDebugInfo: bool = MalterlibBuildServerBuild // User(Build System)=true: Enable repository debug information embedded in the executable

	RepoDebugInfo: string

	RepoDebugInfo AllRepositories->ForEach(&f_GetUrlInfo)->ToString()
}

%GenerateFile "Repository Debug Info"
{
	&
	{
		MalterlibEnableRepoDebugInfo true
		!PlatformFamily "Windows"
	}

	GenerateFile
	{
		Group `@(Platform) @(Architecture) @(FullConfiguration)`
		Name GeneratedGlobalDirectory / "RepoDebug.json"
		Contents RepoDebugInfo
		UnicodeBOM false
	}
}

%GenerateFile "Repository Debug Info Hash"
{
	&
	{
		MalterlibEnableRepoDebugInfo true
		!PlatformFamily "Windows"
	}

	GenerateFile
	{
		Group `@(Platform) @(Architecture) @(FullConfiguration)`
		Name GeneratedGlobalDirectory / "RepoDebug.json.sha256"
		Contents RepoDebugInfo->HashSHA256()
		UnicodeBOM false
	}
}

%GenerateFile "Repository Debug Info Cpp"
{
	&
	{
		MalterlibEnableRepoDebugInfo true
		PlatformFamily "Windows"
	}

	Property
	{
		f_OutputCppStringChunk function(string _Chunk) string = ""

		f_OutputCppStringChunk =+ `R"-----(@(_Chunk))-----"\n`
	}

	GenerateFile
	{
		Group `@(Platform) @(Architecture) @(FullConfiguration)`
		Name GeneratedGlobalDirectory / "RepoDebug.cpp"
		Contents	`#include <Mib/Core/Core>\n`\
					`\n`\
					`#pragma section(".repo", read)\n`\
					`\n`\
					`extern "C" __declspec(allocate(".repo")) assure_used __declspec(selectany) ch8 const g_Malterlib_RepoInfo[] = @(RepoDebugInfo->ChunkString(16000)->ForEach(&f_OutputCppStringChunk));\n`
		UnicodeBOM false
	}
}

Property
{
	RepoDebugInfoHash: string = ReadFile(GeneratedGlobalDirectory / "RepoDebug.json.sha256")
	RepoDebugInfoSectionName: string = `.repo_@(RepoDebugInfoHash->Left(8))`

	RepoDebugInfoSectionName `__repo_@(RepoDebugInfoHash->Left(8))`
	{
		!!PlatformFamily "macOS"
	}
}

%Group "{~Automatic}/{Repository Debug Info}"
{
	Property
	{
		OutputFile: string = Target.IntermediateDirectory / "RepoDebug.o"
		SourceObject: string = Target.IntermediateDirectory / "RepoDebug-empty.o"

		ClangPath: string = MalterlibLLVMHostBinariesDirectory / "bin/clang"
		ObjCopyPath: string = MalterlibLLVMHostBinariesDirectory / "bin/llvm-objcopy"

		OutputFile Target.IntermediateDirectory / "RepoDebug.obj"
		{
			!!PlatformFamily "Windows"
		}
	}

	%Group "~Automatic"
	{
		%Group "Repository Debug Info"
		{
			%File GeneratedGlobalDirectory / "RepoDebug.cpp"
			{
				!!PlatformFamily "Windows"
			}

			%File GeneratedGlobalDirectory / "RepoDebug.json"
			{
				!!PlatformFamily "Linux"

				Compile
				{
					Type "Custom"

					Custom_CommandLine 	`@(ClangPath->fg_EscapeCommand()) -target @(MalterlibTargetTriple->fg_EscapeCommand()) -c -x c /dev/null -o @(SourceObject->fg_EscapeCommand()) && `\
										`@(ObjCopyPath->fg_EscapeCommand()) --add-section @(`@(RepoDebugInfoSectionName)=@(GeneratedGlobalDirectory / "RepoDebug.json")`->fg_EscapeCommand()) --set-section-flags @(RepoDebugInfoSectionName)=readonly,debug @(SourceObject->fg_EscapeCommand()) @(OutputFile->fg_EscapeCommand())`

					Custom_Inputs [GeneratedGlobalDirectory / "RepoDebug.json"]
					Custom_Outputs [OutputFile]
				}
			}
		}
	}

	Target.LinkWithLibraries =+ OutputFile
	{
		!!PlatformFamily "Linux"
	}

	Target.LinkWithLibraries =+ [["-sectcreate", "__TEXT", RepoDebugInfoSectionName, GeneratedGlobalDirectory / "RepoDebug.json"]]
	{
		!!PlatformFamily "macOS"
	}
}

Target
{
	ExtraGroups =+ "{~Automatic}/{Repository Debug Info}"
	{
		&
		{
			MalterlibEnableRepoDebugInfo true
			TargetIsExecutable true
		}
	}
}

Compile
{
	Custom_VerifyInputsAndOutputsExist: bool?

	DwarfDebugFlags `repo-debug-section=@(RepoDebugInfoSectionName)`
	{
		&
		{
			MalterlibEnableRepoDebugInfo true
			CompileDialect "C"
			!PlatformFamily "Windows"
		}
	}
}

%Group "~Automatic/BuildScripts"
{
	%GenerateFile "PreBuild"
	{
		GenerateFile
		{
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
			Name GeneratedDirectory / "PreBuild.sh"
			Contents Target.PreBuildScript ?? ""
			UnixLineEnds true
			UnicodeBOM false
			Executable true
		}
	}
	%GenerateFile "PostBuild"
	{
		GenerateFile
		{
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
			Name GeneratedDirectory / "PostBuild.sh"
			Contents Target.PostBuildScript ?? ""
			UnixLineEnds true
			UnicodeBOM false
			Executable true
		}
	}
}

Target
{
	!!GeneratorFamily "Ninja"

	PostBuildScriptFile: string? = GeneratedDirectory / "PostBuild.sh"
	PreBuildScriptFile: string? = GeneratedDirectory / "PreBuild.sh"

	ExtraGroups =+ "~Automatic/BuildScripts"
}

%Group "~Automatic/Utility Build"
{
	%GenerateFile "Generate"
	{
		GenerateFile
		{
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
			Name `@(GeneratedDirectory)/@(Workspace:Workspace.Name)_@(Target:Target.Name).build`
			Contents ""
			UnicodeBOM false
		}
		Compile
		{
			Custom_CommandLine Target.Real_CommandLine_Build
			Custom_WorkingDirectory '.'->MakeAbsolute()
			Custom_Outputs [Target.CommandLine_Outputs..., `@(GeneratedDirectory)/@(Workspace:Workspace.Name)_@(Target:Target.Name).never.generated`]
			Custom_Inputs Target.CommandLine_Inputs
			Custom_VerifyInputsAndOutputsExist Target.CommandLine_VerifyInputsAndOutputsExist
			{
				!Target.CommandLine_VerifyInputsAndOutputsExist undefined
			}
		}
	}
}

Target
{
