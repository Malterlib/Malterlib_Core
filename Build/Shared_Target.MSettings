// Windows
Target
{
	&
	{
		PlatformType "Windows"
		LanguageFamily "Native"
	}

	PlatformToolset: string?

	// Toolset
	PlatformToolset "clang"
	{
		&
		{
			Target.PlatformToolset undefined
			Target.VisualStudioPlatform "Clang"
		}
	}

	PlatformToolset "v90"
	{
		&
		{
			Target.PlatformToolset undefined
			|
			{
				Target:Target.TargetFrameworkVersion "v2.0"
				Target:Target.TargetFrameworkVersion "v3.0"
				Target:Target.TargetFrameworkVersion "v3.5"
			}
		}
	}

	EnableASAN: bool?
	EnableASAN true
	{
		!!MalterlibSupportSanitizerEnable_Address true
	}

	PlatformToolset MalterlibVisualStudioToolset
	{
		&
		{
			!MalterlibVisualStudioToolset undefined
			Target.PlatformToolset undefined
		}
	}

	PlatformToolset "v143"
	{
		&
		{
			Target.PlatformToolset undefined
			|
			{
				Generator "VisualStudio2022"
			}
		}
	}

	PlatformToolset "v142"
	{
		&
		{
			Target.PlatformToolset undefined
			|
			{
				Generator "VisualStudio2019"
			}
		}
	}

	PlatformToolset "v141"
	{
		&
		{
			Target.PlatformToolset undefined
			|
			{
				Generator "VisualStudio2017"
			}
		}
	}

	PlatformToolset "v110"
	{
		!!Target.PlatformToolset undefined
	}

	PlatformToolsetCompiler "x:/Development/Malterlib/llvm/unstable/build/VisualStudio2012/bin/RelWithDebInfo/clang.exe"
	{
		!!Target.PlatformToolset "clang"
	}

	PlatformVersion: string?
	PlatformVersion MalterlibMaxSupportedWindowsVersion
	{
		!!Target.PlatformVersion undefined
	}

	IgnoreWarnCompileDuplicatedFilename: bool?
	IgnoreWarnCompileDuplicatedFilename true
	{
		!!Generator "VisualStudio2013"
	}

	CharacterSet: string?
	CharacterSet "Unicode"
	{
		!!Target.CharacterSet undefined
	}

	UseOfMfc: bool?
	UseOfMfc false
	{
		!!Target.UseOfMfc undefined
	}
	UseOfAtl: bool?
	UseOfAtl false
	{
		!!Target.UseOfAtl undefined
	}

	TargetMachine: string?
	TargetMachine "MachineX86"
	{
		&
		{
			Architecture "x86"
			!Target.Type "Tool"
		}
	}
	TargetMachine "MachineX64"
	{
		&
		{
			Architecture "x64"
			!Target.Type "Tool"
		}
	}

	DefaultToolArchitecture: string?
	DefaultToolArchitecture "Native64Bit"
	{
		&
		{
			WindowsNativeToolChain true
			!HostArchitecture "arm64"
		}
	}

	ExtraLinkerFlags: [one_of(string, [string])]?
	ExtraLinkerFlags += [["--malterlib-command-BA49ADC8-6CAA-4E8C-BA13-3A9273859D89", "DoxygenLD"], ["--doxygen-executable", "/Development/Malterlib/Tools/stable_build/bin/doxygen"]]
	{
		&
		{
			!Target:Target.Type "StaticLibrary"
			Documentation "Doxygen"
			GeneratorFamily "VisualStudio"
		}
	}

	ExtraLibFlags: [one_of(string, [string])]?
	ExtraLibFlags += [["--malterlib-command-BA49ADC8-6CAA-4E8C-BA13-3A9273859D89", "DoxygenLibTool"]]
	{
		&
		{
			Target:Target.Type "StaticLibrary"
			Documentation "Doxygen"
			GeneratorFamily "VisualStudio"
		}
	}

	ExtraLinkerFlags += "/ignore:4042"
	{
		&
		{
			GeneratorFamily "VisualStudio"
			TargetIsExecutable true
		}

	}

	ExtraLibFlags += "/ignore:4042"
	{
		&
		{
			Target.Type "StaticLibrary"
			GeneratorFamily "VisualStudio"
		}
	}


	ExtraLinkerFlags =+ "/GENPROFILE"
	{
		&
		{
			TargetIsExecutable true
			MalterlibProfileGuidedOptimization "generate"
			!MalterlibEnableLinkTimeCodeGeneration false
		}
	}

	ExtraLinkerFlags =+ `/USEPROFILE:PGD=@(MalterlibProfileGuidedOptimization)`
	{
		&
		{
			TargetIsExecutable true
			!MalterlibProfileGuidedOptimization undefined
			!MalterlibProfileGuidedOptimization "generate"
			!MalterlibEnableLinkTimeCodeGeneration false
		}
	}
}

