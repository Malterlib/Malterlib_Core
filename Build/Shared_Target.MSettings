Dependency
{
	Link true
	{
		!!Dependency.Link ""
	}
}
Dependency
{
	!!LanguageFamily "Native"
	/*
	LinkWithObjectFiles true
	{
		&
		{
			Dependency.LinkWithObjectFiles ""
			|
			{
				Configuration "Debug"
				Configuration "Debug Inlined"
				Configuration "Fast Compile"
			}
		}
	}
	*/
	LinkWithObjectFiles false
	{
		!!Dependency.LinkWithObjectFiles ""
	}
}

// Target type
Target
{
	Type "ConsoleExecutable"
	{
		!!Target.Type ""
	}

	FollowIndirectDependencies true
	{
		&
		{
			Target.FollowIndirectDependencies ""
			Target.Type "StaticLibrary"
		}
	}
}

// Properties derived from target type
Property
{
	TargetIsExecutable true
	{
		&
		{
			Property.true "@(Builtin.Function->HasParentEntity('Target'))"
			|
			{
				Target:Target.Type "ConsoleExecutable"
				Target:Target.Type "UIExecutable"
				Target:Target.Type "Executable"
				Target:Target.Type "DynamicLibrary"
				Target:Target.Type "XcodeBundle"
				Target:Target.Type "SharedDynamicLibrary"
				Target:Target.Type "Driver"
			}
		}
	}
	TargetIsLaunchableExecutable true
	{
		&
		{
			Property.true "@(Builtin.Function->HasParentEntity('Target'))"
			|
			{
				Target:Target.Type "ConsoleExecutable"
				Target:Target.Type "UIExecutable"
				Target:Target.Type "Executable"
			}
		}
	}

	TargetExecutable "@(Target.FileName)@(Target.FileExtension)"
	TargetIdentity "@(Target:this.Identity)"
}

// Name / Filename
Target
{
	BaseName "@(this.Identity)"

	Name "Com_@(Target.BaseName)"
	{
		&
		{
			Target:Target.Name ""
			Target:Target.Type "ConsoleExecutable"
		}
	}
	Name "Exe_@(Target.BaseName)"
	{
		&
		{
			Target:Target.Name ""
			|
			{
				Target:Target.Type "Executable"
				Target:Target.Type "UIExecutable"
			}
		}
	}

	Name "Drv_@(Target.BaseName)"
	{
		&
		{
			Target:Target.Name ""
			Target:Target.Type "Driver"
		}
	}
	Name "Dll_@(Target.BaseName)"
	{
		&
		{
			Target:Target.Name ""
			|
			{
				Target:Target.Type "DynamicLibrary"
				Target:Target.Type "XcodeBundle"
				Target:Target.Type "SharedDynamicLibrary"
			}
		}
	}
	Name "Lib_@(Target.BaseName)"
	{
		&
		{
			Target:Target.Name ""
			Target:Target.Type "StaticLibrary"
		}
	}
	Name "Tool_@(Target.BaseName)"
	{
		&
		{
			Target:Target.Name ""
			Target:Target.Type "Tool"
		}
	}

	BaseFileName "@(Target.BaseName)"

	// Filename
	FileName "@(Target.BaseFileName)@(MalterlibConfigSuffix)_@(MalterlibArchitectureSuffix)@(MalterlibTargetExtraSuffix)"
	{
		&
		{
			Target.FileName ""
			Property.MalterlibTargetNameType "Suffixed"
		}
	}
	FileName "@(Target.BaseFileName)@(MalterlibTargetExtraSuffix)"
	{
		&
		{
			Target.FileName ""
			Property.MalterlibTargetNameType "Normal"
		}
	}
	FileName "@(Target.BaseFileName)"
	{
		&
		{
			Target.FileName ""
			Property.MalterlibTargetNameType "BaseName"
		}
	}

	FileName "@(Target.BaseFileName)@(MalterlibConfigSuffix)@(MalterlibTargetExtraSuffix)"
	{
		&
		{
			Target.FileName ""
			Property.MalterlibTargetNameType "Launcher"
		}
	}

	FileName "@(Target.BaseFileName)@(MalterlibConfigSuffix)@(MalterlibTargetExtraSuffix)"
	{
		&
		{
			Target.FileName ""
			Property.MalterlibTargetNameType "Config"
		}
	}

	FileName "@(Target.BaseFileName)_@(Architecture)@(MalterlibTargetExtraSuffix)"
	{
		&
		{
			Target.FileName ""
			Property.MalterlibTargetNameType "Architectured"
		}
	}
}

Property.MalterlibGenerateScheme true
{
	!!MalterlibGenerateScheme ""
}

Target
{
	!!GeneratorFamily "Xcode"

	EnableModuleDebugging false

	GenerateScheme "@(MalterlibGenerateScheme)"
	{
		&
		{
			!MalterlibGenerateScheme false
			Target.GenerateScheme ""
			|
			{
				MalterlibAllSchemes true
				|
				{
					!Target.LocalDebuggerCommand ""
					!Target.RemoteDebuggerCommand ""
				}
			}
		}
	}

	GenerateScheme false
	{
		!!Target.GenerateScheme ""
	}
}

Target
{
	!!LanguageFamily ".NET"

	DefaultNamespace "@(Target:Target.BaseFileName)"
	{
		!!Target.DefaultNamespace ""
	}

	PlatformTarget "@(Architecture)"
	ErrorReport "prompt"
	CodeAnalysisRuleSet "AllRules.ruleset"
}

// File extensions windows
Target
{
	&
	{
		LanguageFamily "Native"
		PlatformType "Windows"
	}
	FileExtension ".exe"
	FileExtension ".sys"
	{
		!!Target.Type "Driver"
	}
	FileExtension ".dll"
	{
		!!Target.Type "DynamicLibrary"
		!!Target.Type "SharedDynamicLibrary"
	}
	FileExtension ".lib"
	{
		!!Target.Type "StaticLibrary"
	}
}

// File extensions .NET
Target
{
	&
	{
		LanguageFamily ".NET"
	}
	FileExtension ".exe"
	FileExtension ".dll"
	{
		!!Target.Type "DynamicLibrary"
		!!Target.Type "SharedDynamicLibrary"
	}
}

// File extensions unix
Target
{
	&
	{
		LanguageFamily "Native"
		PlatformType "Unix"
	}
	FileExtension ".a"
	{
		!!Target.Type "StaticLibrary"
	}
	FileExtension ".so"
	{
		!!Target.Type "DynamicLibrary"
		!!Target.Type "SharedDynamicLibrary"
	}
}

// File extensions OSX
Target
{
	&
	{
		LanguageFamily "Native"
		PlatformIsDarwin true
	}
	FileExtension ".app"
	{
		!!Target.Type "UIExecutable"
	}
	FileExtension ".kext"
	{
		!!Target.Type "Driver"
	}
	FileExtension ".a"
	{
		!!Target.Type "StaticLibrary"
	}
	FileExtension ".dylib"
	{
		!!Target.Type "DynamicLibrary"
		!!Target.Type "SharedDynamicLibrary"
	}
	FileExtension ".framework"
	{
		!!Target.Type "XcodeBundle"
	}
}

// File extensions Emscripten
Target
{
	&
	{
		LanguageFamily "Native"
		PlatformFamily "Emscripten"
	}
	FileExtension ".a"
	{
		!!Target.Type "StaticLibrary"
	}
	FileExtension ".js"
	{
		!!Target.Type "DynamicLibrary"
		!!Target.Type "SharedDynamicLibrary"
	}
	FileExtension ".html"
	{
		!!Target.Type "UIExecutable"
		!!Target.Type "Executable"
		!!Target.Type "ConsoleExecutable"
	}
}


Property
{
	MalterlibUseClangForWindows false // User(Toolset)=true: Enable clang compilation for Windows platform
	{
		!!MalterlibUseClangForWindows ""
	}
}

Property
{
	&
	{
		GeneratorFamily "VisualStudio"
	}

	MalterlibExportEnvironmentScript "@(GeneratedDirectory)ExportEnvironment.bat"
	{
		!Target.ExportScriptEnvironment ""
	}
}

%Group "~Automatic/Export Environment"
{
	!!GeneratorFamily "VisualStudio"

	%GenerateFile "Generate"
	{
		Property
		{
			Name "@(MalterlibExportEnvironmentScript)"

			Contents "@(Target.ExportScriptEnvironmentContents)\r\n"

			UnicodeBOM false

			Group "@(Platform) @(Architecture) @(FullConfiguration)"
		}
	}
}

Target
{
	ExtraGroups "~Automatic/Export Environment;@(Target.ExtraGroups)"
	{
		&
		{
			GeneratorFamily "VisualStudio"
			!MalterlibExportEnvironmentScript ""
		}
	}
}

Target
{
	&
	{
		GeneratorFamily "VisualStudio"
		MalterlibExportEnvironmentScript ""
		Target.Type "Tool"
	}

	Real_CommandLine_Build "@(Target.PreBuildScript)\r\n\r\n@(Target.CommandLine_Build)\r\n\r\n@(Target.PostBuildScript)"
	Real_CommandLine_ReBuild "@(Target.CommandLine_ReBuild)"
	Real_CommandLine_Clean "@(Target.CommandLine_Clean)"
}
Target
{
	&
	{
		GeneratorFamily "VisualStudio"
		!MalterlibExportEnvironmentScript ""
		Target.Type "Tool"
	}

	Real_CommandLine_Build "@(Target.PreBuildScript)\r\ncall \"@(MalterlibExportEnvironmentScript->WindowsPath())\"\r\n\r\n@(Target.CommandLine_Build)\r\n\r\n@(Target.PostBuildScript)"
	Real_CommandLine_ReBuild "call \"@(MalterlibExportEnvironmentScript->WindowsPath())\"\r\n@(Target.CommandLine_ReBuild)"
	Real_CommandLine_Clean "call \"@(MalterlibExportEnvironmentScript->WindowsPath())\"\r\n@(Target.CommandLine_Clean)"
}

Target
{
	&
	{
		GeneratorFamily "VisualStudio"
	}

	VisualStudioPlatform "Clang"
	{
		&
		{
			Target.VisualStudioPlatform ""
			LanguageFamily "Native"
			MalterlibUseClangForWindows true
		}
	}

	VisualStudioPlatform "x64"
	{
		&
		{
			Target.VisualStudioPlatform ""
			Platform "Windows"
			Architecture "x64"
		}
	}

	VisualStudioPlatform "Win32"
	{
		&
		{
			Target.VisualStudioPlatform ""
			LanguageFamily "Native"
			Platform "Windows"
			Architecture "x86"
		}
	}

	VisualStudioPlatform "x86"
	{
		&
		{
			Target.VisualStudioPlatform ""
			Platform "Windows"
			Architecture "x86"
		}
	}
	VisualStudioPlatform "Clang"
	{
		&
		{
			Target.VisualStudioPlatform ""
			LanguageFamily "Native"
		}
	}
	ClCompileSuffix "_Clang"
	{
		!!Target.VisualStudioPlatform "Clang"
	}
}

Property
{
	MalterlibVisualStudioToolset "" // User(Toolset)=: Manually set another visual studio toolset
	{
		!!MalterlibVisualStudioToolset ""
	}
}

// Windows
Target
{
	&
	{
		PlatformType "Windows"
		LanguageFamily "Native"
	}


	// Toolset

	PlatformToolset "clang"
	{
		&
		{
			Target.PlatformToolset ""
			Target.VisualStudioPlatform "Clang"
		}
	}

	PlatformToolset "v90"
	{
		&
		{
			Target.PlatformToolset ""
			|
			{
				Target:Target.TargetFrameworkVersion "v2.0"
				Target:Target.TargetFrameworkVersion "v3.0"
				Target:Target.TargetFrameworkVersion "v3.5"
			}
		}
	}

	PlatformToolset "@(MalterlibVisualStudioToolset)"
	{
		&
		{
			!MalterlibVisualStudioToolset ""
			Target.PlatformToolset ""
		}
	}

	PlatformToolset "v142"
	{
		&
		{
			Target.PlatformToolset ""
			|
			{
				Generator "VisualStudio2019"
			}
		}
	}

	PlatformToolset "v141"
	{
		&
		{
			Target.PlatformToolset ""
			|
			{
				Generator "VisualStudio2017"
			}
		}
	}

	PlatformToolset "v110"
	{
		!!Target.PlatformToolset ""
	}

	PlatformToolsetCompiler "x:/Development/Malterlib/llvm/unstable/build/VisualStudio2012/bin/RelWithDebInfo/clang.exe"
	{
		!!Target.PlatformToolset "clang"
	}

	PlatformVersion "@(MalterlibMaxSupportedWindowsVersion)"

	IgnoreWarnCompileDuplicatedFilename true
	{
		!!Generator "VisualStudio2013"
	}

	CharacterSet "Unicode"
	{
		!!Target.CharacterSet ""
	}

	UseOfMfc false
	UseOfAtl false
	TargetMachine "MachineX86"
	{
		&
		{
			Architecture "x86"
			!Target.Type "Tool"
		}
	}
	TargetMachine "MachineX64"
	{
		&
		{
			Architecture "x64"
			!Target.Type "Tool"
		}
	}

	DefaultToolArchitecture "Native64Bit"
	{
		!!WindowsNativeToolChain true
	}


	ExtraLinkerFlags "--malterlib-command-BA49ADC8-6CAA-4E8C-BA13-3A9273859D89 DoxygenLD --doxygen-executable /Development/Malterlib/Tools/stable_build/bin/doxygen @(Target.ExtraLinkerFlags)"
	{
		&
		{
			!Target:Target.Type "StaticLibrary"
			Documentation "Doxygen"
			GeneratorFamily "VisualStudio"
		}
	}

	ExtraLibFlags "--malterlib-command-BA49ADC8-6CAA-4E8C-BA13-3A9273859D89 DoxygenLibTool @(Target.LibToolFlags)"
	{
		&
		{
			Target:Target.Type "StaticLibrary"
			Documentation "Doxygen"
			GeneratorFamily "VisualStudio"
		}
	}

	ExtraLinkerFlags "/ignore:4042 @(Target.ExtraLinkerFlags)"
	{
		&
		{
			GeneratorFamily "VisualStudio"
			TargetIsExecutable true
		}

	}

	ExtraLibFlags "/ignore:4042 @(Target.ExtraLibFlags)"
	{
		&
		{
			Target.Type "StaticLibrary"
			GeneratorFamily "VisualStudio"
		}
	}
}

Property
{
	MalterlibSysRoot "@(MalterlibSharedBinariesRoot)/Malterlib_@(PlatformFamily)/SDKs/@(Platform).sdk"
	{
		&
		{
	 		!MalterlibUseGitRepo false
			|
			{
				PlatformFamily "Linux"
				PlatformFamily "Emscripten"
			}
		}
	}
	MalterlibSysRoot "@(MalterlibDevelopmentRoot)/Malterlib/Tools/SDKs/@(Platform).sdk"
	{
		&
		{
	 		MalterlibUseGitRepo false
			|
			{
				PlatformFamily "Linux"
				PlatformFamily "Emscripten"
			}
		}
	}

	MalterlibToolsPrefix ""
	MalterlibToolsPrefix "/opt/Development/Malterlib/llvm/unstable-emscripten/emscripten/"
	{
		!!PlatformFamily "Emscripten"
	}

	MalterlibToolsPrefix "@(PlatformToolsetCompilerBasePath)/bin/"
	{
		&
		{
			!PlatformToolsetCompilerBasePath ""
			GeneratorFamily "Xcode"
		}
	}
}

Property
{
	MalterlibLinkerDemangle true // User(Toolset)=false: Set to false to display mangled names in linker messages
	{
		!!MalterlibLinkerDemangle ""
	}

	MalterlibMSVCVersion "@(MalterlibOverrideMSVCVersion)"
	{
		&
		{
			MalterlibMSVCVersion ""
			!MalterlibOverrideMSVCVersion ""
		}
	}

	VisualStudioRootUnix "@(Builtin.VisualStudioRoot->UnixPath())"
	VisualStudioMSVCRootPath "@(VisualStudioRootUnix)/VC/Tools/MSVC"

	MalterlibMSVCVersionFromInstalled "@(VisualStudioMSVCRootPath->FindDirectoriesIn('*'))"
	MalterlibMSVCVersionFromInstalled "@(MalterlibMSVCVersionFromInstalled->GetFile())"

	MalterlibMSVCVersion "@(MalterlibMSVCVersionFromInstalled)"
	{
		!!MalterlibMSVCVersion ""
	}

	PlatformToolsetCompiler "/opt/Development/Malterlib/llvm/unstable-emscripten/emscripten/emcc" // User(Toolset): Change the clang compiler location
	{
		&
		{
			PlatformToolsetCompiler ""
			PlatformFamily "Emscripten"
			!HostPlatformFamily "Windows"
		}
	}
	PlatformToolsetCompiler "@(MalterlibDependenciesDirectory)/llvm/@(MalterlibClangVersion)/build/main/bin/clang"
	{
		&
		{
			PlatformToolsetCompiler ""
			!MalterlibDefaultCompiler true
			!HostPlatformFamily "Windows"
		}
	}
	PlatformToolsetCompiler "@(MalterlibToolsRoot)/MSVC/@(MalterlibOverrideMSVCVersion)/bin/@(MSVCToolChainArchitecture)/cl.exe"
	{
		&
		{
			PlatformToolsetCompiler ""
			!MalterlibOverrideMSVCVersion ""
			!MalterlibDefaultCompiler true
			HostPlatformFamily "Windows"
		}
	}
	PlatformToolsetCompilerBasePath "@(PlatformToolsetCompiler->GetPath())"
	PlatformToolsetCompilerBasePath "@(PlatformToolsetCompilerBasePath->GetPath())"
}

// Emscripten
Target
{
	&
	{
		LanguageFamily "Native"
		GeneratorFamily "Xcode"
		PlatformFamily "Emscripten"
	}

	EmscriptenFastCompiler true
	EmscriptenEmscriptenRoot "/Development/Malterlib/llvm/unstable-emscripten/emscripten"
	EmscriptenLLVMRoot "/Development/Malterlib/llvm/unstable-emscripten/build/make/bin"
	EmscriptenPython "/usr/bin/python"
	EmscriptenNode "/usr/local/bin/node"
}

Target
{
	!!GeneratorFamily "Xcode"

	MToolPath "@(MToolPath)"
}

Property
{
	ExportScriptEnvironmentContents_Template "export @(Explodee)=\"@(Builtin.Function->GetProperty('Property', '@(Explodee)', 'Target:*'))\"\n"
	{
		&
		{
			!Explodee ""
			!PlatformFamily "Windows"
		}
	}
	ExportScriptEnvironmentContents_Template "set \"@(Explodee)=@(Builtin.Function->GetProperty('Property', '@(Explodee)', 'Target:*'))\"\r\n"
	{
		&
		{
			!Explodee ""
			PlatformFamily "Windows"
			!MalterlibExportEnvironmentMinGW true
		}
	}

	ExportScriptEnvironmentContents_MaybeMinGW "@(Builtin.Function->GetProperty('Property', '@(Explodee)', 'Target:*'))"
	ExportScriptEnvironmentContents_MaybeMinGW "@(ExportScriptEnvironmentContents_MaybeMinGW->UnixPath())"
	ExportScriptEnvironmentContents_MaybeMinGW "@(ExportScriptEnvironmentContents_MaybeMinGW->ParseFormatString('{}:/{}', '/{0,cl}/{1}'))"
	{
		!!ExportScriptEnvironmentContents_MaybeMinGW "~?:*"
	}

	ExportScriptEnvironmentContents_Template "set \"@(Explodee)=@(ExportScriptEnvironmentContents_MaybeMinGW)\"\r\n"
	{
		&
		{
			!Explodee ""
			PlatformFamily "Windows"
			MalterlibExportEnvironmentMinGW true
		}
	}
}

Target
{
	ExportScriptEnvironmentContents "@(Builtin.Function->ExplodeList('@(Target.ExportScriptEnvironment)', ';', 'ExportScriptEnvironmentContents_Template'))"
}

// Xcode workarounds
Target
{
	&
	{
		LanguageFamily "Native"
		GeneratorFamily "Xcode"
		MalterlibDefaultXcode true
	}

	IndexStoreEnable "NO"
	Workaround_GCC_ENABLE_TRIGRAPHS ""
	Workaround_GCC_ENABLE_PASCAL_STRINGS ""
	Workaround_GCC_WARN_ABOUT_MISSING_FIELD_INITIALIZERS ""
	Workaround_GCC_WARN_ABOUT_MISSING_PROTOTYPES ""
	Workaround_GCC_WARN_ABOUT_RETURN_TYPE ""
	Workaround_GCC_WARN_NON_VIRTUAL_DESTRUCTOR ""
	Workaround_GCC_WARN_HIDDEN_VIRTUAL_FUNCTIONS ""
	Workaround_CLANG_WARN__EXIT_TIME_DESTRUCTORS ""
	Workaround_GCC_WARN_INITIALIZER_NOT_FULLY_BRACKETED ""
	Workaround_GCC_WARN_MISSING_PARENTHESES ""
	Workaround_GCC_WARN_CHECK_SWITCH_STATEMENTS ""
	Workaround_GCC_WARN_UNUSED_FUNCTION ""
	Workaround_GCC_WARN_UNUSED_LABEL ""
	Workaround_GCC_WARN_UNUSED_PARAMETER ""
	Workaround_GCC_WARN_UNUSED_VARIABLE ""
	Workaround_GCC_WARN_UNUSED_VALUE ""
	Workaround_CLANG_WARN_EMPTY_BODY ""
	Workaround_GCC_WARN_UNINITIALIZED_AUTOS ""
	Workaround_GCC_WARN_UNKNOWN_PRAGMAS ""
	Workaround_GCC_WARN_SHADOW ""
	Workaround_GCC_WARN_FOUR_CHARACTER_CONSTANTS ""
	Workaround_CLANG_WARN_SUSPICIOUS_IMPLICIT_CONVERSION ""
	Workaround_CLANG_WARN_CONSTANT_CONVERSION ""
	Workaround_CLANG_WARN_INT_CONVERSION ""
	Workaround_CLANG_WARN_BOOL_CONVERSION ""
	Workaround_CLANG_WARN_ENUM_CONVERSION ""
	Workaround_CLANG_WARN_FLOAT_CONVERSION ""
	Workaround_CLANG_WARN_NON_LITERAL_NULL_CONVERSION ""
	Workaround_CLANG_WARN_OBJC_LITERAL_CONVERSION ""
	Workaround_GCC_WARN_64_TO_32_BIT_CONVERSION ""
	Workaround_GCC_WARN_ABOUT_MISSING_NEWLINE ""
	Workaround_CLANG_WARN_CXX0X_EXTENSIONS ""
	Workaround_GCC_CW_ASM_SYNTAX ""
	Workaround_GCC_STRICT_ALIASING ""
	Workaround_GCC_WARN_ABOUT_DEPRECATED_FUNCTIONS ""
	Workaround_GCC_WARN_ABOUT_INVALID_OFFSETOF_MACRO ""
	Workaround_CLANG_WARN_IMPLICIT_SIGN_CONVERSION ""
	Workaround_CLANG_WARN_INFINITE_RECURSION ""
	Workaround_CLANG_WARN_SUSPICIOUS_MOVE ""
	Workaround_CLANG_WARN_COMMA ""
	Workaround_CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING ""
	Workaround_CLANG_WARN_STRICT_PROTOTYPES ""
	Workaround_CLANG_WARN_RANGE_LOOP_ANALYSIS ""
}

Property
{
	MalterlibUseAllLinkerGroup true
	{
		!!MalterlibUseAllLinkerGroup ""
	}
}

// Xcode
Target
{
	&
	{
		LanguageFamily "Native"
		GeneratorFamily "Xcode"
	}

	EnableLinkerGroups true
	{
		&
		{
			Target.EnableLinkerGroups ""
			PlatformFamily "Linux"
		}
	}
	EnableLinkerGroups false
	{
		!!Target.EnableLinkerGroups ""
	}
	LinkerGroup "All"
	{
		!!MalterlibUseAllLinkerGroup true
	}
	LTOObjectFile ""
	{
		!!PlatformFamily "Linux"
	}

	LDFlags "-env_EMCC_FAST_COMPILER 1 @(Target.LDFlags)"
	{
		!!Target.EmscriptenFastCompiler true
	}
	LDFlags "-env_EMSCRIPTEN \"@(Target.EmscriptenEmscriptenRoot)\" @(Target.LDFlags)"
	{
		!Target.EmscriptenEmscriptenRoot ""
	}
	LDFlags "-env_LLVM \"@(Target.EmscriptenLLVMRoot)\" @(Target.LDFlags)"
	{
		!Target.EmscriptenLLVMRoot ""
	}
	LDFlags "-env_PYTHON \"@(Target.EmscriptenPython)\" @(Target.LDFlags)"
	{
		!Target.EmscriptenPython ""
	}
	LDFlags "-env_NODE \"@(Target.EmscriptenNode)\" @(Target.LDFlags)"
	{
		!Target.EmscriptenNode ""
	}
	LDFlags "-s DISABLE_SYSLIB_libcxx=1 -s DISABLE_SYSLIB_libcxxabi=1 @(Target.LDFlags)"
	{
		&
		{
			PlatformFamily "Emscripten"
			!MalterlibDisableMalterlib true
		}
	}

	LDFlags "-O2 -s DISABLE_EXCEPTION_CATCHING=0 @(Target.LDFlags)"
	{
		&
		{
			PlatformFamily "Emscripten"
			!Compile.Optimize "Off"
		}
	}
	
	LDFlags "-mmacosx-version-min=@(Platform->Replace('OSX', '')) @(Target.LDFlags)"
	{
		!!PlatformFamily "OSX"
	}	

	LDFlags "--closure 1 @(Target.LDFlags)"
	{
		&
		{
			PlatformFamily "Emscripten"
			Configuration "Release"
		}
	}
	LDFlags "--closure 0 @(Target.LDFlags)"
	{
		&
		{
			PlatformFamily "Emscripten"
			!Configuration "Release"
		}
	}

	LDFlags "-nostdlibc++ @(Target.LDFlags)"
	{
		&
		{
			MalterlibUseStaticLibCxx true
			!Target.Type "Driver"
			!MalterlibDisableMalterlib true
			!MalterlibDefaultCompiler true
			MalterlibCustomCompilerOptions true
		}
	}

	LDFlags "-nostdlib @(Target.LDFlags)"
	{
		&
		{
			MalterlibUseStaticLibCxx true
			!Target.Type "Driver"
			!MalterlibDisableMalterlib true
			|
			{
