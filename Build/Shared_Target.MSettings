Property
{
	MalterlibUseClangForWindows: bool = false // User(Toolset)=true: Enable clang compilation for Windows platform
}

Target
{
	ExportScriptEnvironment: [string] = []
}

Property
{
	&
	{
		GeneratorFamily "VisualStudio"
	}

	MalterlibExportEnvironmentScript: string? = `@(GeneratedDirectory)ExportEnvironment.bat`
}

%Group "~Automatic/Export Environment"
{
	!!GeneratorFamily "VisualStudio"

	%GenerateFile "Generate"
	{
		GenerateFile
		{
			Name MalterlibExportEnvironmentScript
			Contents `@(Target.ExportScriptEnvironmentContents)\r\n`
			UnicodeBOM false
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
		}
	}
}

Target
{
	ExtraGroups =+ "~Automatic/Export Environment"
	{
		&
		{
			GeneratorFamily "VisualStudio"
			!MalterlibExportEnvironmentScript undefined
		}
	}
}

Target
{
	CommandLine_Build: string?
	CommandLine_ReBuild: string?
	CommandLine_Clean: string?

	CommandLine_Inputs: [string]?
	CommandLine_Outputs: [string]?
}

Target
{
	&
	{
		LanguageFamily "Native"
		Target.Type "Tool"
		GeneratorFamily "VisualStudio"
	}

	Real_CommandLine_Build: string = "rem\r\n"
	Real_CommandLine_ReBuild: string = "rem\r\n"
	Real_CommandLine_Clean: string = "rem\r\n"

	CommandLine_VerifyInputsAndOutputsExist: bool = false
}

Target
{
	&
	{
		GeneratorFamily "VisualStudio"
		MalterlibExportEnvironmentScript undefined
		Target.Type "Tool"
	}

	Real_CommandLine_Build `rem\r\n@(Target.PreBuildScript)\r\n\r\n@(Target.CommandLine_Build)\r\n\r\n@(Target.PostBuildScript)`
	{
		!Target.CommandLine_Build undefined
	}
	Real_CommandLine_ReBuild Target.CommandLine_ReBuild
	{
		!Target.CommandLine_ReBuild undefined
	}
	Real_CommandLine_Clean Target.CommandLine_Clean
	{
		!Target.CommandLine_Clean undefined
	}
}
Target
{
	&
	{
		GeneratorFamily "VisualStudio"
		!MalterlibExportEnvironmentScript undefined
		Target.Type "Tool"
	}

	Real_CommandLine_Build `rem\r\n@(Target.PreBuildScript)\r\ncall "@(MalterlibExportEnvironmentScript->WindowsPath())"\r\n\r\n@(Target.CommandLine_Build)\r\n\r\n@(Target.PostBuildScript)`
	{
		!Target.CommandLine_Build undefined
	}
	Real_CommandLine_ReBuild `call "@(MalterlibExportEnvironmentScript->WindowsPath())"\r\n@(Target.CommandLine_ReBuild)`
	{
		!Target.CommandLine_ReBuild undefined
	}
	Real_CommandLine_Clean `call "@(MalterlibExportEnvironmentScript->WindowsPath())"\r\n@(Target.CommandLine_Clean)`
	{
		!Target.CommandLine_Clean undefined
	}
}

