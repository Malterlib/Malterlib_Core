	{
		&
		{
			PlatformFamily "Windows"
			MalterlibSupportSanitizerEnable_Address true
			Target.PlatformToolset "ClangCL"
		}
	}

	MalterlibNeedsLLVMSanitizerRuntime: bool = false
	MalterlibNeedsLLVMSanitizerRuntime true
	{
		&
		{
			MalterlibNeedsLLVMSanitizerRuntime undefined
			!MalterlibLLVMSanitizerRuntime undefined
			|
			{
				PlatformFamily "macOS"
				PlatformFamily "Windows"
			}
			TargetIsLaunchableExecutable true
			!DocumentationEnabled true
			!MalterlibDisableMalterlib true
