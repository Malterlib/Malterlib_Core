// Executable native targets
Target
{
	&
	{
		LanguageFamily "Native"
		TargetIsExecutable true
	}

	// Force evaluation to extract dependencies
	LinkWithLibraries =+ []

	LinkWithLibraries =+ Builtin.Inherit
	{
		&
		{
			!Builtin.Inherit ""
			!Target.Type "Driver"
		}
	}

	LinkWithLibraries += [["-first_object", MalterlibPosixInitFileName]]
	{
		&
		{
			TargetIsExecutable true
			!Target.Type "Driver"
			!MalterlibDisableMalterlib true
			!MalterlibPosixInitFileName undefined
			!MalterlibDefaultCompiler true
			MalterlibCustomCompilerOptions true
		}
	}

	LinkWithLibraries += [["-sectcreate", "__TEXT", "__info_plist", Target:Target.MalterlibInfoPListFile]]
	{

		&
		{
			!Target:Target.MalterlibInfoPListFile undefined
			!MalterlibIsMacOSBundle true
		}
	}

	LinkWithLibraries += ["-pthread"]
	{
		!!PlatformFamily "Linux"
	}

	SearchPath: [string]?
	SearchPath =+ Builtin.Inherit
	{
		!Builtin.Inherit ""
	}

	SearchPath += `@("../../../SDK"->MakeAbsolute())/WDK/lib/WXP/i386`
	{
		&
		{
			PlatformType "Windows"
			Target.Type "Driver"
			Architecture "x86"
		}
	}
	SearchPath =+ `@("../../../SDK"->MakeAbsolute())/WDK/lib/WNET/amd64`
	{
		&
		{
			PlatformType "Windows"
			Target.Type "Driver"
			Architecture "x64"
		}
	}

	RemoveUnreferencedSymbols: bool?
	RemoveUnreferencedSymbols true // OptimizeReferences
	{
		!!Target.RemoveUnreferencedSymbols undefined
	}
}

