		!!MalterlibBundleDebugLogation ""		
	}

	MalterlibPostBuildScriptPreSign "@(MalterlibPostBuildScriptPreSign)"\
                                    "mkdir -p \"@(MalterlibBundleDebugLogation)/@(Target.FileName)@(Target.FileExtension)/Contents/Python\"\r\n"\
									"@(CheckErrors)\r\n"\
                                    "mkdir -p \"@(MalterlibBundleDebugLogation)/@(Target.FileName)@(Target.FileExtension)/Contents/Python/@(Target.FileName)@(Target.Extension)_LLDBLib\"\r\n"\
									"@(CheckErrors)\r\n"\
									"cp -f \"@(MalterlibLLDBDebuggerScript)\" \"@(MalterlibBundleDebugLogation)/@(Target.FileName)@(Target.FileExtension)/Contents/Python/@(MalterlibPythonDebugScriptName)\"\r\n"\
									"@(CheckErrors)\r\n"\
									"MTool DiffCopy \"@(MalterlibLLDBDebuggerScriptLibDir)/*\" \"@(MalterlibBundleDebugLogation)/@(Target.FileName)@(Target.FileExtension)/Contents/Python/@(Target.FileName)@(Target.Extension)_LLDBLib\"\r\n"\
									"@(CheckErrors)\r\n"
	{
		&
		{
			!DocumentationEnabled true
			!MalterlibBuildServerBuild true
			PlatformIsDarwin true
			MalterlibIsOSXBundle true
			!MalterlibDisableMalterlib "true"
		}
	}
	
	MalterlibPostBuildScriptPreSignMalterlibExeMainNibFilePath "@(MalterlibExeMainNibFile->GetLastPaths(2))"
	
	MalterlibPostBuildScriptPreSign "@(MalterlibPostBuildScriptPreSign)"\
									"MTool DiffCopy \"@(MalterlibExeMainNibFile)\" \"@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.FileExtension)/Contents/Resources/@(MalterlibPostBuildScriptPreSignMalterlibExeMainNibFilePath->GetPath())\" \"\" 0\r\n"
	{
		&
		{
			PlatformIsDarwin true
			Target.Type "UIExecutable"
			!MalterlibExeMainNibFile ""
		}
	}

	
	MalterlibBreakpadSourceSuffix "_cli"
	{
		"!Target:Target.Type" "UIExecutable"
	}
	
	MalterlibPostBuildScriptPreSign "@(MalterlibPostBuildScriptPreSign)"\
					"MTool DiffCopy \"@('../../../SDK'->MakeAbsolute())/BreakpadBin/@(PlatformFamily)@(MalterlibBreakpadSourceSuffix)/Breakpad.framework\" \"@(Target:Target.IntermediateDirectory)Breakpad\" \"\" 0 1\r\n"\
					"MTool DiffReplace \"http://www.google.com/privacypolicy.html\" \"@(MalterlibBreakpadPrivacyPolicyURL)\" \"@('../../../SDK'->MakeAbsolute())/BreakpadBin/@(PlatformFamily)@(MalterlibBreakpadSourceSuffix)/Breakpad.framework/Localizable.strings\" \"@(Target:Target.IntermediateDirectory)Breakpad/Breakpad.framework\" \"\" 1 1 1\r\n"
	{
		&
		{
			MalterlibEnableBreakpad true
			PlatformIsDarwin true
			Target.Type "UIExecutable"
		}
	}
	
	MalterlibPostBuildScriptPreSign "@(MalterlibPostBuildScriptPreSign)"\
					"MTool DiffCopy \"@(Target:Target.IntermediateDirectory)Breakpad/Breakpad.framework\" \"@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.FileExtension)/Contents/Frameworks\" \"\" 0\r\n"
	{
		&
		{
			MalterlibEnableBreakpad true
			PlatformIsDarwin true
			Target.Type "UIExecutable"
		}
	}


	
}

// Out of process Specific

Property
{
	MalterlibPostBuildScriptPreSign "@(MalterlibPostBuildScriptPreSign)"\
									"MTool DiffCopy \"@(MalterlibOverrideMallocLibrary)\" \"@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.FileExtension)/Contents/MacOS\" \"\" 0\r\n"
	{
		&
		{
			MalterlibNeedsMallocOverrideLibrary true
			MalterlibIsOSXBundle true
		}
	}
	MalterlibPostBuildScriptPreSign "@(MalterlibPostBuildScriptPreSign)"\
									"MTool DiffCopy \"@(Builtin.Function->GetProperty('Property', 'MalterlibFinalModuleDestination', 'Group:Libraries.Target:Exe_AOCCOutOfProcess.Target:Exe_AOCCOutOfProcess'))\" \"@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.FileExtension)/Contents/MacOS\" \"\" 0\r\n"
	{
		&
		{
			MalterlibOutOfProcessSupport "true"
			PlatformFamily "OSX"
		}
	}
	MalterlibPostBuildScriptPreSign "@(MalterlibPostBuildScriptPreSign)"\
									"MTool DiffCopy \"@(Builtin.Function->GetProperty('Property', 'MalterlibFinalModuleDestination', 'Group:Libraries.Target:Exe_AOCCOutOfProcess.Target:Exe_AOCCOutOfProcess'))\" \"@(MalterlibFinalModuleDestinationPath)\" \"\" 0\r\n"
	{
		&
		{
			MalterlibOutOfProcessSupport "true"
			PlatformFamily "Windows"
		}
	}
	
	
}

Target
{
	MalterlibInfoPListFile "@(GeneratedDirectory)Info.plist"
	{
		&
		{
			PlatformIsDarwin true
			|
			{
				Target.Type "UIExecutable"
				Target.Type "Driver"
				Target.Type "Executable"
				Target.Type "ConsoleExecutable"
				Target.Type "DynamicLibrary"
				Target.Type "XcodeBundle"
				Target.Type "SharedDynamicLibrary"
			}
		}
	}
}

Property
{
	MalterlibTargetFriendlyName "@(Target:Target.Name)"
	{
		!!MalterlibTargetFriendlyName ""
	}
}

%Group "~Automatic/OSX Specific"
{
	%GenerateFile "Generate"
	{
		Property
		{
			Group "@(Platform) @(Architecture) @(FullConfiguration)"
			Name "@(GeneratedDirectory)Info.plist"

			MalterlibOSXVersion	"@(Platform->Replace('OSX',''))"
			{
				!!MalterlibOSXVersion ""
			}

			Contents 	"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"\
						"<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"\
						"<plist version=\"1.0\">\n"\
						"<dict>\n"\
						"	<key>CFBundleDevelopmentRegion</key>\n"\
						"		<string>en</string>\n"\
						"	<key>CFBundleExecutable</key>\n"\
						"		<string>@(Target:Target.FileName)</string>\n"\
						"	<key>CFBundleIdentifier</key>\n"\
						"		<string>@(MalterlibBundleIdentifier)</string>\n"\
						"	<key>CFBundleInfoDictionaryVersion</key>\n"\
						"		<string>6.0</string>\n"\
						"	<key>CFBundleSignature</key>\n"\
						"		<string>????</string>\n"\
						"	<key>CFBundleVersion</key>\n"\
						"		<string>@(ProductVersionMajor->FormatInt('{}')).@(ProductVersionMinor->FormatInt('{}')).@(ProductVersionRevision->FormatInt('{}'))</string>\n"

			Contents 	"@(Contents)"\
						"	<key>CFBundleName</key>\n"\
						"		<string>@(MalterlibTargetFriendlyName)</string>\n"\
						"	<key>CFBundleShortVersionString</key>\n"\
						"		<string>@(Target:Target.Version)</string>\n"\
						"	<key>NSHumanReadableCopyright</key>\n"\
						"		<string>@(ProductCopyright)</string>\n"\
						"	<key>NSPrincipalClass</key>\n"\
						"		<string>NSApplication</string>\n"\
						"	<key>LSMinimumSystemVersion</key>\n"\
						"		<string>@(MalterlibOSXVersion)</string>\n"\
						"	<key>MalterlibBranch</key>\n"\
						"		<string>@(MalterlibFullBranch)</string>\n"\
						"	<key>BuildTime</key>\n"\
						"		<string>@(Builtin.Function->MalterlibTime('{}:{}'))</string>\n"\
						"	<key>ProductVersionMajor</key>\n"\
						"		<string>@(ProductVersionMajor)</string>\n"\
						"	<key>ProductVersionMinor</key>\n"\
						"		<string>@(ProductVersionMinor)</string>\n"\
						"	<key>ProductVersionRevision</key>\n"\
						"		<string>@(ProductVersionRevision)</string>\n"\
						"	<key>ProductVersionExtra</key>\n"\
						"		<string>@(ProductVersionExtra)</string>\n"\
						"	<key>CFBundlePackageType</key>\n"\
						"		<string>APPL</string>\n"\
						"	<key>NSHighResolutionCapable</key>\n"\
						"		<string>YES</string>\n"
			{
				!Target.Type "Driver"
			}

			Contents 	"@(Contents)"\
						"	<key>CFBundlePackageType</key>\n"\
						"		<string>KEXT</string>\n"
			{
				!!Target.Type "Driver"
			}

			Contents 	"@(Contents)"\
						"	<key>CFBundleSupportedPlatforms</key>\n"\
						"	<array>\n"\
						"		<string>MacOSX</string>\n"\
						"	</array>\n"
			{
				!!PlatformFamily "OSX"
			}


			Contents 	"@(Contents)"\
						"	<key>BreakpadProduct</key>\n"\
						"		<string>@(Target:Target.FileName)</string>\n"\
						"	<key>BreakpadProductDisplay</key>\n"\
						"		<string>@(MalterlibTargetFriendlyName)</string>\n"\
						"	<key>BreakpadURL</key>\n"\
						"		<string>@(MalterlibBreakpadUploadServer)</string>\n"\
						"	<key>BreakpadReportInterval</key>\n"\
						"		<string>@(MalterlibBreakpadReportInterval)</string>\n"\
						"	<key>BreakpadVendor</key>\n"\
						"		<string>@(ProductCompany)</string>\n"\
						"	<key>BreakpadVersion</key>\n"\
						"		<string>@(Target:Target.Version)</string>\n"\
						"	<key>BreakpadInProcess</key>\n"\
						"		<string>YES</string>\n"
			
			
			{
				!!MalterlibEnableBreakpad "true"
			}

			Contents 	"@(Contents)"\
						"	<key>BreakpadRequestEmail</key>\n"\
						"		<string>YES</string>\n"
			{
				&
				{
					MalterlibEnableBreakpad "true"
					MalterlibBreakpadRequestEmail "true"
				}
			}			

			Contents 	"@(Contents)"\
						"	<key>BreakpadRequestComments</key>\n"\
						"		<string>YES</string>\n"
			{
				&
				{
					MalterlibEnableBreakpad "true"
					MalterlibBreakpadRequestComments "true"
				}
			}

			Contents 	"@(Contents)"\
						"	<key>CFBundleIconFile</key>\n"\
						"	<string>@(MalterlibExeIcon->GetFileNoExt())</string>\n"
			{
				!MalterlibExeIcon ""
			}


			Contents 	"@(Contents)"\
						"	<key>NSMainNibFile</key>\n"\
						"	<string>@(MalterlibExeMainNibFile->GetFileNoExt())</string>\n"
			{
				!MalterlibExeMainNibFile ""
			}
			
			
			URLSchemeTemplateProtocol "					<string>@(Explodee)</string>\n"

			URLSchemeTemplate 	"		<dict>\n"\
							 	"			<key>CFBundleTypeRole</key>\n"\
								"				<string>@(Expand1)</string>\n"\
								"				<key>CFBundleURLName</key>\n"\
								"				<string>@(Expand2)</string>\n"\
								"				<key>CFBundleURLIconFile</key>\n"\
								"				<string>@(Expand3)</string>\n"\
								"				<key>CFBundleURLSchemes</key>\n"\
								"				<array>\n"\
								"@(Builtin.Function->ExplodeList('@(Expand0)', '|', 'URLSchemeTemplateProtocol'))"\
								"				</array>\n"\
								"		</dict>\n"
			{
				!Target:MalterlibURLScheme ""
			}

			URLSchemeTemplateOuter "@(Builtin.Function->ExpandList('@(Explodee)', ',', 'URLSchemeTemplate'))\n"
			{
				!Target:MalterlibURLScheme ""
			}

			Contents  	"@(Contents)"\
						"	<key>CFBundleURLTypes</key>\n"\
						"		<array>\n"\			
						"@(Builtin.Function->ExplodeList('@(Target:MalterlibURLScheme)', ';', 'URLSchemeTemplateOuter'))\n"\
						"		</array>\n"
			{
				!Target:MalterlibURLScheme ""
			}
			
			Contents	"@(Contents)"\
						"	<key>LSUIElement</key>\n"\
						"		<string>1</string>\n"
			{
				!!Property.MalterlibOSXHideDockTile true
			}

			Contents  	"@(Contents)@(MalterlibExtraPListContents)"
			{
				!MalterlibExtraPListContents ""
			}

			Contents 	"@(Contents)\n"\
						"</dict>\n"\
						"</plist>\n"
			UnicodeBOM "true"
		}
		Compile
		{
			Type "None"
		}
		
		"!Target:Target.MalterlibInfoPListFile" ""
	}
}
Target
{
	ExtraGroups "~Automatic/OSX Specific;@(Target.ExtraGroups)"
	{
		"!Target:Target.MalterlibInfoPListFile" ""
	}
}
Property
{
	MalterlibLinuxProgramIdentifier "@(ProductCompanyUniqueIdentifier->Sanitize()).@(Target:Target.Name->Sanitize())"
	{
		&
		{
			PlatformFamily Linux
			TargetIsExecutable true
		}
	}

	MalterlibLinuxDesktopFile "@(GeneratedDirectory)@(MalterlibLinuxProgramIdentifier).desktop"
	{
		&
		{
			PlatformFamily Linux
			Target.Type UIExecutable
			!MalterlibBuildServerBuild true
		}
	}
}

%Group "~Automatic/Posix Specific"
{
	%GenerateFile "Breakpad"
	{
		!!MalterlibEnableBreakpad true
		
		Property
		{
			!!Target.Type UIExecutable
			Group "@(Platform) @(Architecture) @(FullConfiguration)"
			
			Name "@(GeneratedDirectory)BreakpadInfo.cpp"
			
			Contents	"#include <Mib/Core/Core>\n\n"\
						"namespace NMib\n"\
						"{\n"\
						"\tnamespace NSys\n"\
						"\t{\n"\
						"\t\tvoid fg_InitialiseCrashReporter()\n"\
						"\t\t{\n"\
						"\t\t\tNMib::fg_GetSys()->f_SetCrashHandler(NMib::NFile::CFile::fs_GetProgramDirectory() + \"/OutOfProcess@(MalterlibConfigSuffix)\", \"@(MalterlibBreakpadUploadServer)\");\n"\
						"\t\t}\n"\
						"\t}\n"\
						"}\n"
			
			UnicodeBOM "true"
			
		}
		
		Property
		{
			!!Target.Type Executable
			!!Target.Type ConsoleExecutable
			Group "@(Platform) @(Architecture) @(FullConfiguration)"
			
			Name "@(GeneratedDirectory)BreakpadInfo.cpp"
			
			Contents	"#include <Mib/Core/Core>\n\n"\
						"namespace NMib\n"\
						"{\n"\
						"\tnamespace NSys\n"\
						"\t{\n"\
						"\t\tvoid fg_InitialiseCrashReporter()\n"\
						"\t\t{\n"\
						"\t\t\tNMib::fg_GetSys()->f_SetCrashHandler(\"\", \"@(MalterlibBreakpadUploadServer)\");\n"\
						"\t\t}\n"\
						"\t}\n"\
						"}\n"
			
			UnicodeBOM "true"
		}
	}
}

Target
{
	ExtraGroups "~Automatic/Posix Specific;@(Target.ExtraGroups)"
	{
		&
		{
			|
			{
				PlatformIsDarwin true
				PlatformFamily Linux
			}
			TargetIsExecutable true
		}
	}
}

%Group "~Automatic/Linux Specific"
{
	%GenerateFile "Generate"
	{
		Property
		{
			Group "@(Platform) @(Architecture) @(FullConfiguration)"
			Name "@(GeneratedDirectory)VersionInfo.cpp"

			Contents 	"#include <Mib/Core/Core>\n"\
						"assure_used static char fileid[] __attribute__ ((section(\"IDSVERSIONINFO\"))) = \"$Id: VersionInfo.cpp,v @(Target:Target.Version) @(Builtin.Function->DateTime('{YYYY}/{MM}/{DD} {HH}:{MNMN}:{SS}')) $\\n\"\n"\
						"\"MalterlibBranch=@(MalterlibFullBranch)\\n\"\n"\
						"\"BuildTime=@(Builtin.Function->MalterlibTime('{}:{}'))\\n\"\n"\
						"\"ProductVersionMajor=@(ProductVersionMajor)\\n\"\n"\
						"\"ProductVersionMinor=@(ProductVersionMinor)\\n\"\n"\
						"\"ProductVersionRevision=@(ProductVersionRevision)\\n\"\n"\
						"\"ProductVersionExtra=@(ProductVersionExtra)\\n\";\n"							

			UnicodeBOM "true"
		}
	}

	%GenerateFile ".desktop"
	{
		!MalterlibLinuxDesktopFile ""
		Property
		{
			Group "@(Platform) @(Architecture) @(FullConfiguration)"
			Name "@(MalterlibLinuxDesktopFile)"

			Contents 	"[Desktop Entry]\n"\
						"Name=@(MalterlibTargetFriendlyName)\n"\
						"Version=@(ProductVersionMajor->FormatInt('{}')).@(ProductVersionMinor->FormatInt('{}')).@(ProductVersionRevision->FormatInt('{}'))\n"\
						"Type=Application\n"

			Contents 	"@(Contents)"\
						"Icon=@(MalterlibDeployRoot)/@(MalterlibCalculatedPostCopyProject)/@(MalterlibExeIcon->GetFile())\n"
			{
				!MalterlibExeIcon ""
			}

			Contents 	"@(Contents)"\
						"Terminal=false\n"
			{
				!Target.Type ConsoleExecutable
			}
			Contents 	"@(Contents)"\
						"Terminal=true\n"
			{
				!!Target.Type ConsoleExecutable
			}


			UnicodeBOM "false"
		}
	}
}

Target
{
	ExtraGroups "~Automatic/Linux Specific;@(Target.ExtraGroups)"
	{
		&
		{
			PlatformFamily Linux
			TargetIsExecutable true
		}
	}
}


%Group "~Automatic/Windows Specific"
{
	%GenerateFile "Generate .NET Assembly Info"
	{
		!!LanguageFamily .NET
		Property
		{
			Group "@(Platform) @(Architecture) @(FullConfiguration)"
			Name "@(GeneratedDirectory)AssemblyInfo.cs"

			CalcGUID @(MalterlibFinalModuleDestination->HashUUID('Bare'))

			Contents 	"\n"

			Contents 	"@(Contents)"\
						"#if (@(MalterlibUniqueConfig))\r\n"\
						"using System.Reflection;\r\n"\
						"using System.Runtime.CompilerServices;\r\n"\
						"using System.Runtime.InteropServices;\r\n"\
						"[assembly: AssemblyTitle(\"@(ProductName)\")]\r\n"\
						"[assembly: AssemblyDescription(\"@(ProductDescription)\")]\r\n"\
						"[assembly: AssemblyConfiguration(\"@(ProductVersionExtra)\")]\r\n"\
						"[assembly: AssemblyCompany(\"@(ProductCompany)\")]\r\n"\
						"[assembly: AssemblyProduct(\"@(ProductName)\")]\r\n"\
						"[assembly: AssemblyCopyright(\"@(ProductCopyright)\")]\r\n"\
						"[assembly: AssemblyTrademark(\"\")]\r\n"\
						"[assembly: AssemblyCulture(\"\")]\r\n"\
						"[assembly: ComVisible(false)]\r\n"\
						"[assembly: Guid(\"@(CalcGUID)\")]\r\n"\
						"[assembly: AssemblyFileVersion(\"@(ProductVersionMajor).@(ProductVersionMinor).@(ProductVersionRevision).0\")]\r\n"\
						"[assembly: AssemblyVersion(\"@(ProductVersionMajor).@(ProductVersionMinor).@(ProductVersionRevision).0\")]\r\n"\
						"@(MalterlibExtraAssemblyInfo)"\
						"#endif\r\n"
			
			UnicodeBOM "true"
		}
	}

	%GenerateFile "Generate C++ Managed"
	{
		&
		{
			LanguageFamily Native
			Target.CLRSupport true
		}
		Property
		{

			Group "@(Platform) @(Architecture) @(FullConfiguration)"
			Name "@(GeneratedDirectory)AssemblyInfo.cpp"

			CalcGUID @(MalterlibFinalModuleDestination->HashUUID('Bare'))

			Contents 	"\n"

			Contents 	"@(Contents)"\
						"using namespace System;\r\n"\
						"using namespace System::Reflection;\r\n"\
						"using namespace System::Runtime::CompilerServices;\r\n"\
						"using namespace System::Runtime::InteropServices;\r\n"\
						"using namespace System::Security::Permissions;\r\n"\
						"[assembly:AssemblyTitleAttribute(\"@(ProductName)\")];\r\n"\
						"[assembly:AssemblyDescriptionAttribute(\"@(ProductDescription)\")];\r\n"\
						"[assembly:AssemblyConfigurationAttribute(\"@(ProductVersionExtra)\")];\r\n"\
						"[assembly:AssemblyCompanyAttribute(\"@(ProductCompany)\")];\r\n"\
						"[assembly:AssemblyProductAttribute(\"@(ProductName)\")];\r\n"\
						"[assembly:AssemblyCopyrightAttribute(\"@(ProductCopyright)\")];\r\n"\
						"[assembly:AssemblyTrademarkAttribute(\"\")];\r\n"\
						"[assembly:AssemblyCultureAttribute(\"\")];\r\n"\
						"[assembly:ComVisible(false)];\r\n"\
						"[assembly:Guid(\"@(CalcGUID)\")];\r\n"\
						"[assembly:CLSCompliantAttribute(true)];\r\n"\
						"[assembly:AssemblyFileVersionAttribute(\"@(ProductVersionMajor).@(ProductVersionMinor).@(ProductVersionRevision).0\")];\r\n"\
						"[assembly:AssemblyVersionAttribute(\"@(ProductVersionMajor).@(ProductVersionMinor).@(ProductVersionRevision).0\")];\r\n"\
						"#pragma warning(disable:4947) // Request minimum deprecated in .NET 4.0\r\n"\
						"[assembly:SecurityPermission(SecurityAction::RequestMinimum, UnmanagedCode = true)];\r\n"\
						"@(MalterlibExtraAssemblyInfo)"
			
			UnicodeBOM "true"
		}
	}

	%GenerateFile "Generate Resource"
	{
		!!LanguageFamily Native
		Property
		{

			Group "@(Platform) @(Architecture) @(FullConfiguration)"
			Name "@(GeneratedDirectory)Resources.rc"

			Contents 	"\n"

			IcanCalcPath "@(MalterlibExeIcon->MakeRelative('@(GeneratedDirectory)'))"
			IcanCalcPath "@(IcanCalcPath->WindowsPath())"
			IcanCalcPath "@(IcanCalcPath->Replace('\\\\', '\\\\\\\\'))"

			Contents 	"@(Contents)"\
						"#define IDI_ICON1                       101\r\n"\
						"// Next default values for new objects\r\n"\
						"// \r\n"\
						"#ifdef APSTUDIO_INVOKED\r\n"\
						"#ifndef APSTUDIO_READONLY_SYMBOLS\r\n"\
						"#define _APS_NEXT_RESOURCE_VALUE        102\r\n"\
						"#define _APS_NEXT_COMMAND_VALUE         40001\r\n"\
						"#define _APS_NEXT_CONTROL_VALUE         1001\r\n"\
						"#define _APS_NEXT_SYMED_VALUE           101\r\n"\
						"#endif\r\n"\
						"#endif\r\n"\
						"IDI_ICON1 ICON \"@(IcanCalcPath)\"\r\n"
			{
				!MalterlibExeIcon ""
			}

			ResourceFileType "VFT_UNKNOWN"

			ResourceFileType "VFT_APP"
			{
				!!Target.Type "ConsoleExecutable"
				!!Target.Type "UIExecutable"
				!!Target.Type "Executable"
			}
			ResourceFileType "VFT_DRV"
			{
				!!Target.Type "Driver"
			}
			ResourceFileType "VFT_DLL"
			{
				!!Target.Type "DynamicLibrary"
				!!Target.Type "SharedDynamicLibrary"
			}

			Contents 	"@(Contents)"\
						"#include \"winres.h\"\r\n"\
						"VS_VERSION_INFO VERSIONINFO\r\n"\
						" FILEVERSION @(ProductVersionMajor),@(ProductVersionMinor),@(ProductVersionRevision),0\r\n"\
						" PRODUCTVERSION @(ProductVersionMajor),@(ProductVersionMinor),@(ProductVersionRevision),0\r\n"\
						" FILEFLAGSMASK 0x17L\r\n"\
						"#ifdef _DEBUG\r\n"\
						" FILEFLAGS VS_FF_DEBUG | VS_FF_PRIVATEBUILD\r\n"\
						"#else\r\n"\
						" FILEFLAGS VS_FF_PRIVATEBUILD\r\n"\
						"#endif\r\n"\
						" FILEOS VOS_NT_WINDOWS32\r\n"\
						" FILETYPE @(ResourceFileType)\r\n"\
						" FILESUBTYPE VFT2_UNKNOWN\r\n"\
						"BEGIN\r\n"\
						"	BLOCK \"StringFileInfo\"\r\n"\
						"	BEGIN\r\n"\
						"		BLOCK \"040904b0\"\r\n"\
						"		BEGIN\r\n"\
						"			VALUE \"CompanyName\", \"@(ProductCompany)\"\r\n"\
						"			VALUE \"FileDescription\", \"@(ProductDescription)\"\r\n"\
						"			VALUE \"FileVersion\", \"@(ProductVersionMajor).@(ProductVersionMinor)@(ProductVersionRevision) @(ProductVersionExtra)\"\r\n"\
						"			VALUE \"InternalName\", \"@(Target:Target.FileName)\"\r\n"\
						"			VALUE \"LegalCopyright\", \"@(ProductCopyright)\"\r\n"\
						"			VALUE \"OriginalFilename\", \"@(Target:Target.FileName)@(Target:Target.FileExtension)\"\r\n"\
						"			VALUE \"ProductName\", \"@(ProductName)\"\r\n"\
						"			VALUE \"ProductVersion\", \"@(ProductVersionMajor).@(ProductVersionMinor)@(ProductVersionRevision) @(ProductVersionExtra)\"\r\n"\
						"			VALUE \"PrivateBuild\", \"@(MalterlibFullBranch)\"\r\n"\
						"		END\r\n"\
						"	END\r\n"\
						"	BLOCK \"VarFileInfo\"\r\n"\
						"	BEGIN\r\n"\
						"		VALUE \"Translation\", 0x0409, 1200\r\n"\
						"	END\r\n"\
						"END\r\n"

			
			UTF16 true
			UnicodeBOM "true"
		}
	}
}
Target
{
	ExtraGroups "~Automatic/Windows Specific;@(Target.ExtraGroups)"
	{
		&
		{
			PlatformFamily Windows
			TargetIsExecutable true
			!MalterlibDisableAutomaticResources true
		}
	}
}

Property
{
	MalterlibModuleDefinitionContents ""
	MalterlibModuleDefinitionContents "EXPORTS@(NativeLineEnding)"
	{
		!!PlatformFamily Windows
	}

	ModuleDefineTemplate "--keep-symbol=_@(Explodee) "

	ModuleDefineTemplate "@(Explodee)@(NativeLineEnding)"
	{
		!!PlatformFamily Windows
	}
	ModuleDefineTemplate "_@(Explodee)@(NativeLineEnding)"
	{
		!!PlatformIsDarwin true
	}
	
	
	MalterlibModuleDefinitionContents  	"@(MalterlibModuleDefinitionContents)"\
										"@(Builtin.Function->ExplodeList('@(MalterlibDefinedSymbols)', ';', 'ModuleDefineTemplate'))"
	
	MalterlibStripOptions "-u -r @(MalterlibStripOptions)"
	{
		!!PlatformIsDarwin true
	}
										
	MalterlibStripOptions "-s \"@(GeneratedDirectory)Module.def\" @(MalterlibStripOptions)"
	{
		&
		{
			!MalterlibDefinedSymbols ""
			PlatformIsDarwin true
		}
	}

	MalterlibStripOptions "--strip-unneeded @(MalterlibStripOptions)"
	{
		!!PlatformFamily Linux
	}

	MalterlibStripOptions "@(MalterlibModuleDefinitionContents) @(MalterlibStripOptions)"
	{
		&
		{
			!MalterlibDefinedSymbols ""
			PlatformFamily Linux
		}
	}
	
}

%Group "~Automatic/DLL Definition"
{
	%GenerateFile "Generate"
