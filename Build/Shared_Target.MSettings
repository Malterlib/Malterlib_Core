		{
			"!MalterlibDefinedSymbols" ""
			PlatformFamily Windows
		}
	}	
}


// ExeFS

Property
{

	MalterlibBuildServerPutPathUploadTemplateExpand	"MTool BuildServerPut Recursive=0 \"Source=@(Expand0)\" \"DestinationDir=@(MalterlibBuildServerPutPath)@(Expand1)\"\r\n"\
													"@(CheckErrors)\r\n"
	
	MalterlibBuildServerPutPathUploadContents	"@(MalterlibBuildServerPutPathUploadContents)"\
												"@(Builtin.Function->ExplodeList('@(MalterlibBuildServerPutSources)', ';', 'MalterlibBuildServerPutPathUploadTemplate'))"

	
	MalterlibExeFSExtraFilesContentsTemplateExpand	"@(MalterlibExeFSSpecContents)"\
													"Include\r\n"\
													"{\r\n"\
													"	Pattern \"@(Expand0)\"\r\n"\
													"	Destination \"@(Expand1)\"\r\n"\
													"	Recurse 0\r\n"\
													"}\r\n"
	
	MalterlibExeFSExtraFilesContentsTemplate	"@(Builtin.Function->ExpandList('@(Explodee)', '|', 'MalterlibExeFSExtraFilesContentsTemplateExpand'))"
	{
		!Explodee ""
	}
	
	MalterlibExeFSExtraFilesContents	"@(Builtin.Function->ExplodeList('@(MalterlibExeFSExtraFiles)', ';', 'MalterlibExeFSExtraFilesContentsTemplate'))"
	{
		!MalterlibExeFSExtraFiles ""
	}
	
	MalterlibExeFSSpecContents	"@(MalterlibExeFSSpecContents)"\
								"Include\r\n"\
								"{\r\n"\
								"	Pattern \"@(MalterlibExeFSPath->UnixPath())\"\r\n"\
								"}\r\n"\
								"Include\r\n"\
								"{\r\n"\
								"	Pattern \"@(MalterlibTempExeFSPath->UnixPath())\"\r\n"\
								"}\r\n"\
								"Include\r\n"\
								"{\r\n"\
								"	Pattern \"@(MalterlibSharedTempExeFSPath->UnixPath())\"\r\n"\
								"}\r\n"\
								"@(MalterlibExeFSExtraFilesContents)"
	{
		&
		{
			TargetIsExecutable true
			MalterlibDoExeFS true
		}
	}
	MalterlibExeFSSpecContents	"@(MalterlibExeFSSpecContents)"\
								"Include\r\n"\
								"{\r\n"\
								"	Pattern \"@(MalterlibLocalizationExeFSPath->UnixPath())\"\r\n"\
								"}\r\n"
	{
		&
		{
			MalterlibDoTranslationExeFS "true"
			MalterlibDoExeFS "true"
		}
	}
}

%Group "~Automatic/Malterlib ExeFS Files"
{
	%GenerateFile "Generate"
	{
		Property
		{
			Group "@(Platform) @(Architecture) @(FullConfiguration)"
			Name "@(GeneratedDirectory)/@(Workspace:Workspace.Name)_@(Target:Target.Name).MalterlibFSSpec"
			Contents "@(MalterlibExeFSSpecContents)"
			UnicodeBOM "true"
		}
	}
	
	%File "../Source/Dummy/Dummy.cpp"
}

Target
{
	ExtraGroups "~Automatic/Malterlib ExeFS Files;@(Target.ExtraGroups)"
	{
		!MalterlibExeFSSpecContents ""
	}

}

// Post build step

Property
{
	MalterlibOriginalModuleDestinationExpLib "@(MalterlibOriginalModuleDestination->GetPath())/@(MalterlibOriginalModuleDestination->GetFileNoExt()).exp"
	MalterlibOriginalModuleDestinationLib "@(MalterlibOriginalModuleDestination->GetPath())/@(MalterlibOriginalModuleDestination->GetFileNoExt()).lib"
}

Property
{
	CheckErrors ""
	CheckErrors "CheckErrors"
	{
		!!PlatformType "Unix"
	}
}

Property
{
	MalterlibDumpSymsCommand "dump_syms"
	
	MalterlibPostBuildScriptShowEnv "false" // User: Enable to show the environment variables of the build environment
	{
		!!MalterlibPostBuildScriptShowEnv ""
	}
}


Property
{
	MalterlibBuildServerPutSources "@(MalterlibFinalModuleDestination);@(MalterlibBuildServerPutSources)"
	{
		!Target.Type Tool
	}
	MalterlibBuildServerPutSources "@(MalterlibOverrideMallocLibrary);@(MalterlibBuildServerPutSources)"
	{
		&
		{
			MalterlibNeedsMallocOverrideLibrary true
			!MalterlibIsOSXBundle true
		}
	}
	
	MalterlibBuildServerPutPathUploadTemplateExpand	"MTool BuildServerPut Recursive=0 \"Source=@(Expand0)\" \"DestinationDir=@(MalterlibBuildServerPutPath)@(Expand1)\"\r\n"\
													"@(CheckErrors)\r\n"
	
	MalterlibBuildServerPutPathUploadTemplate	"@(Builtin.Function->ExpandList('@(Explodee)', '|', 'MalterlibBuildServerPutPathUploadTemplateExpand'))"
	{
		!Explodee ""
	}
	
	MalterlibBuildServerPutPathUploadContents	"@(MalterlibBuildServerPutPathUploadContents)"\
												"@(Builtin.Function->ExplodeList('@(MalterlibBuildServerPutSources)', ';', 'MalterlibBuildServerPutPathUploadTemplate'))"
	

	MalterlibTestPutSources "@(MalterlibFinalModuleDestination)"
	MalterlibTestPutSources "@(Target:Target.SymbolFile);@(MalterlibTestPutSources)"
	{
		!!PlatformFamily Windows		
	}
	
	MalterlibTestPutSources "@(MalterlibOriginalModuleDestination).dSYM;@(MalterlibTestPutSources)"
	{
		&
		{
			PlatformIsDarwin true
			TargetIsExecutable true
			Target.DebugInformationFormat "dwarf-with-dsym"
		}
	}
	
	
	MalterlibTestPutPathUploadTemplate	"MTool BuildServerPut Recursive=0 \"Source=@(Expand0)\" \"DestinationDir=@(MalterlibTestPutPath)@(Expand1)\"\r\n"\
											"@(CheckErrors)\r\n"
	{
		!MalterlibAutoBuild true
	}

	// AB Copy
	MalterlibTestPutPathUploadTemplate	"echo mkdir -p \"@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(Expand1)\"\r\n"\
											"mkdir -p \"@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(Expand1)\"\r\n"\
											"echo cp -fr \"@(Expand0)\" \"@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(Expand1)/\"\r\n"\
											"cp -fr \"@(Expand0)\" \"@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(Expand1)/\"\r\n"\
											"@(CheckErrors)\r\n"
	{
		&
		{
			!PlatformFamily Windows
			MalterlibAutoBuild true
		}
	}
	
	MalterlibTestPutPathUploadTemplate	"echo mkdir \"@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(Expand1)\"\r\n"\
											"mkdir \"@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(Expand1)\"\r\n"\
											"echo MTool DiffCopy \"@(Expand0)\" \"@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(Expand1)\"\r\n"\
											"MTool DiffCopy \"@(Expand0)\" \"@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(Expand1)\"\r\n"\
											"@(CheckErrors)\r\n"
	{
		&
		{
			PlatformFamily Windows		
			MalterlibAutoBuild true
		}
	}

	MalterlibTestPutPathUploadInternalTemplate	"@(Builtin.Function->ExpandList('@(Explodee)', '|', 'MalterlibTestPutPathUploadTemplate'))\r\n"
	{
		!Explodee ""
	}
	
	MalterlibTestPutPathUploadContents	"@(MalterlibTestPutPathUploadContents)"\
											"@(Builtin.Function->ExplodeList('@(MalterlibTestPutSources)', ';', 'MalterlibTestPutPathUploadInternalTemplate'))"

	MalterlibTestPutPath "Test/@(Workspace:Workspace.Name)/@(Platform)/@(Architecture)/@(FullConfiguration)"
	{
		&
		{
			MalterlibTestPutPath ""
			|
			{
				MalterlibMainTest true
				MalterlibHelperTest true
			}
		}
	}	

	MalterlibTestPutSources "@(MalterlibFinalModuleDestination).MainTest;@(MalterlibTestPutSources)"
	{
		!!MalterlibMainTest true
	}	


	Win32SignTool "MTool BuildServerTool Tool=SignToolWin32"
	{
		&
		{
			Win32SignTool ""
			MalterlibBuildServerBuild "true"
		}
	}

	Win32SignTool "@('../../../SDK'->MakeAbsolute())/WDK/bin/x86/SignTool.exe"
	{
		!!Win32SignTool ""
	}

	MalterlibWindowsSignCommandLine "@(Win32SignTool) sign /fd SHA256 /ac \"@(MalterlibSignIncludeCert->WindowsPath())\" /n \"@(MalterlibSignCertWindows)\" /t http://timestamp.globalsign.com/scripts/timestamp.dll \"@(MalterlibFinalModuleDestination->WindowsPath())\""

	MalterlibWindowsSignCommandLine "@(Win32SignTool) sign /fd SHA256 /n \"@(MalterlibSignCertWindows)\" /t http://timestamp.globalsign.com/scripts/timestamp.dll \"@(MalterlibFinalModuleDestination->WindowsPath())\""
	{
		!!MalterlibSignIncludeCert "none"
	}

}

Property
{
	PreBuildScriptDependenciesTemplate "@(Builtin.Function->GetProperty('Target', 'DependencyFile', '@(Explodee)'));"
	{
		!Explodee ""
	}
	
	PreBuildScriptDependencies	"@(PreBuildScriptDependencies)"\
								"@(Builtin.Function->ExplodeList('@(Target.Dependencies)', ';', 'PreBuildScriptDependenciesTemplate'))"
	
	PreBuildOutputfile "@(Target.IntermediateDirectory)PreBuildOutput.c"
}

Target
{
	!!GeneratorFamily Xcode

	PreBuildScriptInputs "@(PreBuildScriptDependencies)"
	PreBuildScriptOutputs "@(PreBuildOutputfile)"
	PreBuildScript	"@(Target.PreBuildScript)\n"\
					"\"@(Builtin.MToolExe)\" CheckDependencies \"Directory=@(Target.IntermediateDirectory)MalterlibDependencies\"\n"\
					"if [ \"$?\" != \"0\" ]; then\n"\
					"  echo error: Dependency checking failed\n"\
					"  exit 1\n"\
					"fi\n"\
					"MTool TouchOrCreate \"@(PreBuildOutputfile)\"\n"\
					"exit 0\n"
	{
		//!!MalterlibAccurateDependencies true
	}


}

Target
{
	!!GeneratorFamily Xcode

	PostBuildScriptInputs "$(CONFIGURATION_BUILD_DIR)/$(PRODUCT_NAME)"
	PostBuildScriptInputs "$(CONFIGURATION_BUILD_DIR)/$(PRODUCT_NAME).$(EXECUTABLE_EXTENSION)"
	{
		!Target.FileExtension ""
	}
	PostBuildScriptInputs "$(CONFIGURATION_BUILD_DIR)/$(PRODUCT_NAME).$(EXECUTABLE_EXTENSION)/Contents/MacOS/$(PRODUCT_NAME)"
	{
		&
		{
			PlatformFamily OSX
			MalterlibIsOSXBundle true
		}
	}
	PostBuildScriptInputs "$(CONFIGURATION_BUILD_DIR)/$(PRODUCT_NAME).$(EXECUTABLE_EXTENSION)/$(PRODUCT_NAME)"
	{
		&
		{
			PlatformFamily iOS
			MalterlibIsOSXBundle true
		}
	}
	PostBuildScriptOutputs "$(CONFIGURATION_BUILD_DIR)/@(Target.Name).c"

}

Property
{

	MalterlibPostCopySources "@(MalterlibFinalModuleDestination)|;@(MalterlibPostCopySources)"
	{
		!Target.Type Tool // Tool has no default executable
	}
	
	MalterlibPostCopySources "@(MalterlibOriginalModuleDestination).dSYM|;@(MalterlibPostCopySources)"
	{
		&
		{
			Target.DebugInformationFormat "dwarf-with-dsym"
			Target.Type Driver
		}
	}

	MalterlibPostCopySources "@(Target:Target.IntermediateDirectory)Breakpad/Breakpad.framework|;@(MalterlibPostCopySources)"
	{
		&
		{
			MalterlibEnableBreakpad true
			PlatformIsDarwin true
			Target.Type "UIExecutable"
		}
	}
	MalterlibPostCopySources "@(MalterlibLinuxDesktopFile)|;@(MalterlibPostCopySources)"
	{
		&
		{
			!MalterlibLinuxDesktopFile ""
		}
	}
	MalterlibPostCopySources "@(MalterlibExeIcon)|;@(MalterlibPostCopySources)"
	{
		&
		{
			!MalterlibLinuxDesktopFile ""
			!MalterlibExeIcon ""
		}
	}

	MalterlibPostCopySources "@(MalterlibOverrideMallocLibrary)|;@(MalterlibPostCopySources)"
	{
		&
		{
			MalterlibNeedsMallocOverrideLibrary true
			!MalterlibIsOSXBundle true
		}
	}

	
	MalterlibPostCopySources	"@(MalterlibFinalModuleDestinationPath)/@(MalterlibPythonDebugScriptName)|../Python;"\
								"@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.Extension)_LLDBLib|../Python;"\
								"@(MalterlibPostCopySources)"
	
	{
		&
		{
			!DocumentationEnabled true
			PlatformIsDarwin true
			TargetIsExecutable true
			!MalterlibIsOSXBundle true
			!MalterlibDisableMalterlib true
		}
	}
	

	MalterlibPostCopyInternalTemplate	"MTool PostCopy \"@(Expand0)\" \"Config=@(Builtin.GeneratedBuildSystemDir)/PostCopy.MConfig\" \"Project=@(MalterlibCalculatedPostCopyProject)\" \"OutFolder=@(MalterlibPostCopyDestination)@(Expand1)\" \"Hash=@(MalterlibPostCopyHash)\"\r\n"\
										"@(CheckErrors)\r\n"
	MalterlibPostCopyTemplate			"@(Builtin.Function->ExpandList('@(Explodee)', '|', 'MalterlibPostCopyInternalTemplate'))"
	{
		!Explodee ""
	}
	MalterlibPostCopyContents			"@(MalterlibPostCopyContents)"\
										"@(Builtin.Function->ExplodeList('@(MalterlibPostCopySources)', ';', 'MalterlibPostCopyTemplate'))"

	MalterlibPostCopyInternalTemplate2	"MTool PostCopy \"@(Expand0)\" \"Config=@(Builtin.GeneratedBuildSystemDir)/PostCopy.MConfig\" \"Project=@(MalterlibCalculatedPostCopyProject2)\" \"OutFolder=@(MalterlibPostCopyDestination2)@(Expand1)\" \"Hash=@(MalterlibPostCopyHash2)\"\r\n"\
										"@(CheckErrors)\r\n"
	MalterlibPostCopyTemplate2			"@(Builtin.Function->ExpandList('@(Explodee)', '|', 'MalterlibPostCopyInternalTemplate2'))"
	{
		!Explodee ""
	}
	MalterlibPostCopyContents2			"@(MalterlibPostCopyContents)"\
										"@(Builtin.Function->ExplodeList('@(MalterlibPostCopySources)', ';', 'MalterlibPostCopyTemplate2'))"
	
	MalterlibLLDBDebuggerScript			"@('../../Debug/Source/Malterlib_LLDB.py'->MakeAbsolute())"
	MalterlibLLDBDebuggerScriptLibDir	"@('../../Debug/Source/Malterlib_LLDB'->MakeAbsolute())"
}	

Target
{

	PostBuildScript "@(Target.PostBuildScript)"\
					"set\r\n"
	{
		!!MalterlibPostBuildScriptShowEnv true
	}

	PostBuildScript "@(Target.PostBuildScript)"\
					"function CheckErrors {\r\n"\
					"	if [[ $? -ne 0 ]]\r\n"\
					"	then\r\n"\
					"		echo ERROR: Command in post build script failed, aborting\r\n"\
					"		exit 1\r\n"\
					"	fi\r\n"\
					"}\r\n"\
					"\r\n"
	{
		!!PlatformType "Unix"
	}


/*
	// This breaks the dependency checking in MSBuild
	PostBuildScript "@(Target.PostBuildScript)"\
					"IF EXIST \"@(MalterlibOriginalModuleDestinationExpLib->WindowsPath())\" del \"@(MalterlibOriginalModuleDestinationExpLib->WindowsPath())\"\r\n"\
					"IF EXIST \"@(MalterlibOriginalModuleDestinationLib->WindowsPath())\" del \"@(MalterlibOriginalModuleDestinationLib->WindowsPath())\"\r\n"
	{
		&
		{
			Target.Type "DynamicLibrary"
			PlatformType "Windows"
			!MalterlibSaveImpLib true
		}
	}
	*/

	PostBuildScript "@(Target.PostBuildScript)"\
					"mkdir -p \"@(MalterlibFinalModuleDestinationPath)\"\r\n"\
					"@(CheckErrors)\r\n"\
					"mkdir -p \"@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.Extension)_LLDBLib\"\r\n"\
					"@(CheckErrors)\r\n"\
					"cp -f \"@(MalterlibLLDBDebuggerScript)\" \"@(MalterlibFinalModuleDestinationPath)/@(MalterlibPythonDebugScriptName)\"\r\n"\
					"@(CheckErrors)\r\n"\
					"MTool DiffCopy \"@(MalterlibLLDBDebuggerScriptLibDir)/*\" \"@(MalterlibFinalModuleDestinationPath)/@(Target.FileName)@(Target.Extension)_LLDBLib\"\r\n"\
					"@(CheckErrors)\r\n"

	{
		&
		{
			!DocumentationEnabled true
			PlatformIsDarwin true
			TargetIsExecutable true
			!MalterlibIsOSXBundle true
			!MalterlibDisableMalterlib "true"
		}
	}

	PostBuildScript "@(Target.PostBuildScript)"\
					"MTool DiffCopy \"@(MalterlibOriginalModuleDestination)\" \"@(MalterlibFinalModuleDestinationPath)\" \"\" 0\r\n"\
					"@(CheckErrors)\r\n"

	{
		&
		{
			!MalterlibFinalModuleDestination "@(MalterlibOriginalModuleDestination)"
			!DisableDiffCopy "true"
		}
	}
	
	PostBuildScript "@(Target.PostBuildScript)"\
					"MTool DiffCopy \"@(MalterlibOriginalModuleDestination).dSYM\" \"@(MalterlibFinalModuleDestinationPath)\" \"\" 0\r\n"\
					"@(CheckErrors)\r\n"
	{
		&
		{
			!MalterlibFinalModuleDestination "@(MalterlibOriginalModuleDestination)"
			!DisableDiffCopy "true"
			Target.DebugInformationFormat "dwarf-with-dsym"
			PlatformIsDarwin true
		}
	}

	PostBuildScript "@(Target.PostBuildScript)"\
					"MTool SetImageOsVersion \"@(MalterlibFinalModuleDestination)\" 5.01\r\n"\
					"@(CheckErrors)\r\n"
	{
		&
		{
			TargetIsExecutable "true"
			PlatformType "Windows"
			LanguageFamily Native
		}
	}
	

	PostBuildScript "@(Target.PostBuildScript)"\
					"@(MalterlibExtraPostBuildScript)\r\n"
	{
		&
		{
			TargetIsExecutable "true"
			!MalterlibExtraPostBuildScript ""
		}
	}

	PostBuildScript "@(Target.PostBuildScript)"\
					"@(MalterlibPostBuildScriptPreSign)"
	{
		!MalterlibPostBuildScriptPreSign ""
	}

	// Do this before signing as we want to strip the executable
	PostBuildScript "@(Target.PostBuildScript)"\
					"echo Deploy Symbols:\r\n"\
					"echo @(MalterlibDumpSymsCommand) \"@(MalterlibFinalModuleDestinationExecutable)\" \\> \"@(MalterlibFinalModuleDestination).breakpad\"\r\n"\
					"@(MalterlibDumpSymsCommand) \"@(MalterlibFinalModuleDestinationExecutable)\" > \"@(MalterlibFinalModuleDestination).breakpad\"\r\n"\
					"@(CheckErrors)\r\n"
	{
		&
		{
			|
			{
				PlatformIsDarwin true
				PlatformFamily "Linux"
			}
			TargetIsExecutable true
			MalterlibDeploySymbols true
		}
	}
	PostBuildScript "@(Target.PostBuildScript)"\
					"echo @(MalterlibDumpSymsCommand) \"@(MalterlibFinalModuleDestination).dSYM\" \\> \"@(MalterlibFinalModuleDestination).dSYM.breakpad\"\r\n"\
					"@(MalterlibDumpSymsCommand) \"@(MalterlibFinalModuleDestination).dSYM\" > \"@(MalterlibFinalModuleDestination).dSYM.breakpad\"\r\n"\
					"@(CheckErrors)\r\n"
	{
		&
		{
			PlatformIsDarwin true
			TargetIsExecutable true
			MalterlibDeploySymbols true
			Target.DebugInformationFormat "dwarf-with-dsym"
		}
	}
	
	PostBuildScript "@(Target.PostBuildScript)"\
					"echo zip -qj \"@(MalterlibFinalModuleDestination)\" \"@(MalterlibFinalModuleDestination).zip\"\r\n"\
					"if [ -f \"@(MalterlibFinalModuleDestination).zip\" ]\r\n"\
					"then\r\n"\
					"\trm \"@(MalterlibFinalModuleDestination).zip\"\r\n"\
					"\t@(CheckErrors)\r\n"\
					"fi\r\n"\
					"zip -qj \"@(MalterlibFinalModuleDestination).zip\" \"@(MalterlibFinalModuleDestination)\"\r\n"\
					"@(CheckErrors)\r\n"
	{
		&
		{
			PlatformFamily "Linux"
			TargetIsExecutable true
			MalterlibDeploySymbols true
		}
	}

	PostBuildScript "@(Target.PostBuildScript)"\
					"echo @(MalterlibToolsPrefix)strip @(MalterlibStripOptions) \"@(MalterlibFinalModuleDestinationExecutable)\"\r\n"\
					"@(MalterlibToolsPrefix)strip @(MalterlibStripOptions) \"@(MalterlibFinalModuleDestinationExecutable)\"\r\n"\
					"@(CheckErrors)\r\n"
	{
		&
		{
			|
			{
				PlatformIsDarwin true
				PlatformFamily "Linux"
			}
			TargetIsExecutable true
			!MalterlibStripSymbols false
			MalterlibDeploySymbols true
			|
			{
				!Configuration "Release Testing"
				PlatformFamily "Linux"
			}
		}
	}
					
	PostBuildScript "@(Target.PostBuildScript)"\
					"echo zip -qj \"@(MalterlibFinalModuleDestination).breakpad.zip\" \"@(MalterlibFinalModuleDestination).breakpad\"\r\n"\
					"if [ -f \"@(MalterlibFinalModuleDestination).breakpad.zip\" ]\r\n"\
					"then\r\n"\
					"\trm \"@(MalterlibFinalModuleDestination).breakpad.zip\"\r\n"\
					"\t@(CheckErrors)\r\n"\
					"fi\r\n"\
					"zip -qj \"@(MalterlibFinalModuleDestination).breakpad.zip\" \"@(MalterlibFinalModuleDestination).breakpad\"\r\n"\
					"@(CheckErrors)\r\n"\
					"echo MTool SymbolBreakpad \"/Temp/SymbolTest\" \"@(MalterlibFinalModuleDestination).breakpad\"\r\n"\
					"export BrekapadOutputPath=`MTool SymbolBreakpad \"@(MalterlibDeploySymbolsPath)\" \"@(MalterlibFinalModuleDestination).breakpad\"`\r\n"\
					"@(CheckErrors)\r\n"\
					"echo Deploying symbols to: $BrekapadOutputPath\r\n"
	{
		&
		{
			|
			{
				PlatformFamily "Linux"
				PlatformIsDarwin true
			}
			TargetIsExecutable true
			MalterlibDeploySymbols true
		}
	}

	PostBuildScript "@(Target.PostBuildScript)"\
					"echo zip -qj \"@(MalterlibFinalModuleDestination).dSYM.breakpad\" \"@(MalterlibFinalModuleDestination).dSYM.breakpad.zip\"\r\n"\
