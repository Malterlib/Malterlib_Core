	}

	MalterlibSharedTempExeFSPath "@(MalterlibSharedIntermediateDirectory)/ExeFS/*"
	{
		!!MalterlibSharedTempExeFSPath ""
	}


	MalterlibOriginalModuleDestination "@(Target.OutputDirectory)@(Target.FileName)@(Target.FileExtension)"
	MalterlibOriginalModulePath "@(MalterlibOriginalModuleDestination->GetPath())"
	MalterlibFinalModuleDestination "@(MalterlibOriginalModuleDestination)"
	MalterlibFinalModuleDestination "@(Target.OutputDirectory)Deployed/@(Target.FileName)@(Target.FileExtension)"
	{
		&
		{
			!DocumentationEnabled true
			|
			{
				TargetIsExecutable true
				/*
				&
				{
					|
