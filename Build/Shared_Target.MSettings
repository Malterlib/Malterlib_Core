Target.DriverType define string?

// File extensions OSX
Target
{
	&
	{
		LanguageFamily "Native"
		PlatformIsDarwin true
	}
	FileExtension ".app"
	{
		!!Target.Type "UIExecutable"
	}
	FileExtension ".kext"
	{
		&
		{
			Target.Type "Driver"
			Target.DriverType "IoKit"
 		}
	}
	FileExtension ".dext"
	{
		&
		{
			Target.Type "Driver"
			Target.DriverType "DriverKit"
 		}
	}
	FileExtension ".a"
	{
		!!Target.Type "StaticLibrary"
	}
	FileExtension ".dylib"
	{
		!!Target.Type "DynamicLibrary"
		!!Target.Type "SharedDynamicLibrary"
	}
	FileExtension ".framework"
	{
		!!Target.Type "XcodeBundle"
	}
}

	// File extensions OSX
Target
{
	&
	{
		LanguageFamily "Native"
		GeneratorFamily "Xcode"
		!PlatformIsDarwin true
		Target.FileExtension undefined
	}

	FileExtension ""
	{
		!!Target.Type "UIExecutable"
	}
}

// File extensions Emscripten
Target
{
	&
	{
		LanguageFamily "Native"
		PlatformFamily "Emscripten"
	}
	FileExtension ".a"
	{
		!!Target.Type "StaticLibrary"
	}
	FileExtension ".js"
	{
		!!Target.Type "DynamicLibrary"
		!!Target.Type "SharedDynamicLibrary"
	}
	FileExtension ".html"
	{
		!!Target.Type "UIExecutable"
		!!Target.Type "Executable"
		!!Target.Type "ConsoleExecutable"
	}
}

Property
{
	MalterlibUseClangForWindows define bool = false // User(Toolset)=true: Enable clang compilation for Windows platform
}

Target
{
	ExportScriptEnvironment define [string] = []
}

Property
{
	&
	{
		GeneratorFamily "VisualStudio"
	}

	MalterlibExportEnvironmentScript define string? = `@(GeneratedDirectory)ExportEnvironment.bat`
}

%Group "~Automatic/Export Environment"
{
	!!GeneratorFamily "VisualStudio"

	%GenerateFile "Generate"
	{
		GenerateFile
		{
			Name MalterlibExportEnvironmentScript
			Contents `@(Target.ExportScriptEnvironmentContents)\r\n`
			UnicodeBOM false
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
		}
	}
}

Target
{
	ExtraGroups =+ "~Automatic/Export Environment"
	{
		&
		{
			GeneratorFamily "VisualStudio"
			!MalterlibExportEnvironmentScript undefined
		}
	}
}

Target
{
	CommandLine_Build define string?
	CommandLine_ReBuild define string?
	CommandLine_Clean define string?

	CommandLine_Inputs define [string]?
	CommandLine_Outputs define [string]?
}

Target
{
	&
	{
		LanguageFamily "Native"
		Target.Type "Tool"
		GeneratorFamily "VisualStudio"
	}

	Real_CommandLine_Build define string = "rem\r\n"
	Real_CommandLine_ReBuild define string = "rem\r\n"
	Real_CommandLine_Clean define string = "rem\r\n"

	CommandLine_VerifyInputsAndOutputsExist define bool = false
}

Target
{
	&
	{
		GeneratorFamily "VisualStudio"
		MalterlibExportEnvironmentScript undefined
		Target.Type "Tool"
	}

	Real_CommandLine_Build `rem\r\n@(Target.PreBuildScript)\r\n\r\n@(Target.CommandLine_Build)\r\n\r\n@(Target.PostBuildScript)`
	{
		!Target.CommandLine_Build undefined
	}
	Real_CommandLine_ReBuild Target.CommandLine_ReBuild
	{
		!Target.CommandLine_ReBuild undefined
	}
	Real_CommandLine_Clean Target.CommandLine_Clean
	{
		!Target.CommandLine_Clean undefined
	}
}
Target
{
	&
	{
		GeneratorFamily "VisualStudio"
		!MalterlibExportEnvironmentScript undefined
		Target.Type "Tool"
	}

	Real_CommandLine_Build `rem\r\n@(Target.PreBuildScript)\r\ncall "@(MalterlibExportEnvironmentScript->WindowsPath())"\r\n\r\n@(Target.CommandLine_Build)\r\n\r\n@(Target.PostBuildScript)`
	{
		!Target.CommandLine_Build undefined
	}
	Real_CommandLine_ReBuild `call "@(MalterlibExportEnvironmentScript->WindowsPath())"\r\n@(Target.CommandLine_ReBuild)`
	{
		!Target.CommandLine_ReBuild undefined
	}
	Real_CommandLine_Clean `call "@(MalterlibExportEnvironmentScript->WindowsPath())"\r\n@(Target.CommandLine_Clean)`
	{
		!Target.CommandLine_Clean undefined
	}
}

