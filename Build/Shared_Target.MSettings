	PostBuildScript "@(Target.PostBuildScript)"\
					"sn -Ra \"@(MalterlibFinalModuleDestination->WindowsPath())\" \"@(MalterlibStronglyNamedAssembly->WindowsPath())\"\r\n"\
					"@(CheckErrors)\r\n"
	{
		&
		{
