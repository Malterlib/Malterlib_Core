	MalterlibToolsPrefix define string
	MalterlibToolsPrefix ""
	MalterlibToolsPrefix "/opt/Development/Malterlib/llvm/unstable-emscripten/emscripten/"
	{
		!!PlatformFamily "Emscripten"
	}

	MalterlibToolsPrefix `@(PlatformToolsetCompilerBasePath)/bin/`
