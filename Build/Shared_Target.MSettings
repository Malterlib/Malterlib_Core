												"@(Builtin.Function->ExplodeList('@(MalterlibBuildServerPutSources)', ';', 'MalterlibBuildServerPutPathUploadTemplate'))"


	MalterlibTestPutSources "@(MalterlibFinalModuleDestination)"
	MalterlibTestPutSources "@(Target:Target.SymbolFile);@(MalterlibTestPutSources)"
