Property
{
	f_ValidatePathExists function(string _Path, string _Error) string
	f_ValidatePathExists _Path
	{
		!!_Path->FileOrDirectoryExists() true
	}
	f_ValidatePathExists Error(`@(_Error) @(_Path)`)
	{
		!_Path->FileOrDirectoryExists() true
	}
}

// Windows
Target
{
	&
	{
		PlatformType "Windows"
		LanguageFamily "Native"
	}

	ExtraLinkerFlags: [one_of(string, [string])]?
	ExtraLibFlags: [one_of(string, [string])]?
	PlatformToolset: string?

	// Toolset
	PlatformToolset "ClangCL"
	{
		&
		{
			Target.PlatformToolset undefined
			MalterlibUseClangForWindows true
		}
	}

	LLVMInstallDir: string?

	LLVMInstallDir MalterlibLLVMHostBinariesDirectory
	{
		!!Target.PlatformToolset "ClangCL"
	}

	LLVMToolsVersion: string?
	LLVMToolsVersion `@(MalterlibClangVersion).0`
	{
		!!Target.PlatformToolset "ClangCL"
	}

	UseDebugLibraries: bool?

	UseDebugLibraries true
	{
		&
		{
			DebugCompiler true
			PlatformFamily "Windows"
		}
	}

	EnableASAN: bool?
	EnableASAN true
	{
		&
		{
			MalterlibSupportSanitizerEnable_Address true
			!Target.PlatformToolset "ClangCL"
		}
	}

	ExtraLinkerFlags =+ ["/FORCE:MULTIPLE"->f_LinkerFlag(), "-incremental:no"->f_LinkerFlag(), "clang_rt.asan_dynamic-x86_64.lib"->f_LinkerLibrary(), "-wholearchive:clang_rt.asan_static_runtime_thunk-x86_64.lib"->f_LinkerFlag()]
	{
		&
		{
			TargetIsExecutable true
			TargetIsLaunchableExecutable true
			MalterlibSupportSanitizerEnable_Address true
			Target.PlatformToolset "ClangCL"
			GeneratorFamily "VisualStudio"
		}
	}

	ExtraLinkerFlags =+ ["/FORCE:MULTIPLE"->f_LinkerFlag(), "-incremental:no"->f_LinkerFlag(), "clang_rt.asan_dynamic-x86_64.lib"->f_LinkerLibrary(), "-wholearchive:clang_rt.asan_static_runtime_thunk-x86_64.lib"->f_LinkerFlag()]
	{
		&
		{
			TargetIsExecutable true
			!TargetIsLaunchableExecutable true
			MalterlibSupportSanitizerEnable_Address true
			Target.PlatformToolset "ClangCL"
			GeneratorFamily "VisualStudio"
		}
	}

	ExtraLinkerFlags =+ ["/FORCE:MULTIPLE"->f_LinkerFlag(), "-incremental:no"->f_LinkerFlag()]
	{
		&
		{
			TargetIsExecutable true
			MalterlibSupportSanitizerEnable_Address true
			Target.PlatformToolset "ClangCL"
			GeneratorFamily "Ninja"
		}
	}

	ExtraLinkerFlags =+ ["/SAFESEH:NO"->f_LinkerFlag()]
	{
		&
		{
			TargetIsExecutable true
			Architecture "x86"
			MalterlibDoExeFS true
			Target.PlatformToolset "ClangCL"
		}
	}

	PlatformToolset MalterlibVisualStudioToolset
	{
		&
		{
			!MalterlibVisualStudioToolset undefined
			Target.PlatformToolset undefined
		}
	}

	PlatformToolset "v145"
	{
		&
		{
			Target.PlatformToolset undefined
			(Builtin.VisualStudioRoot / "MSBuild/Current/Microsoft.VisualStudioVersion.v18.Common.props")->FileExists() true
		}
	}

	PlatformToolset "v143"
	{
		&
		{
			Target.PlatformToolset undefined
			(Builtin.VisualStudioRoot / "MSBuild/Current/Microsoft.VisualStudioVersion.v17.Common.props")->FileExists() true
		}
	}

	PlatformToolset Error("Could not find suitable PlatformToolset")
	{
		!!Target.PlatformToolset undefined
	}

	PlatformToolsetCompiler "x:/Development/Malterlib/llvm/unstable/build/VisualStudio2012/bin/RelWithDebInfo/clang.exe"
	{
		!!Target.PlatformToolset "clang"
	}

	PlatformVersion: string?
	PlatformVersion MalterlibMaxSupportedWindowsVersion
	{
		!!Target.PlatformVersion undefined
	}

	IgnoreWarnCompileDuplicatedFilename: bool?
	IgnoreWarnCompileDuplicatedFilename true
	{
		!!Generator "VisualStudio2013"
	}

	CharacterSet: string?
	CharacterSet "Unicode"
	{
		!!Target.CharacterSet undefined
	}

	UseOfMfc: bool?
	UseOfMfc false
	{
		!!Target.UseOfMfc undefined
	}
	UseOfAtl: bool?
	UseOfAtl false
	{
		!!Target.UseOfAtl undefined
	}

	TargetMachine: string?
	TargetMachine "MachineX86"
	{
		&
		{
			Architecture "x86"
			!Target.Type "Tool"
		}
	}
	TargetMachine "MachineX64"
	{
		&
		{
			Architecture "x64"
			!Target.Type "Tool"
		}
	}

	DefaultToolArchitecture: string?
	DefaultToolArchitecture "Native64Bit"
	{
		&
		{
			WindowsNativeToolChain true
			!HostArchitecture "arm64"
		}
	}

	ExtraLinkerFlags += [["--malterlib-command-BA49ADC8-6CAA-4E8C-BA13-3A9273859D89", "DoxygenLD"], ["--doxygen-executable", "/Development/Malterlib/Tools/stable_build/bin/doxygen"]]
	{
		&
		{
			!Target:Target.Type "StaticLibrary"
			Documentation "Doxygen"
			GeneratorFamily "VisualStudio"
		}
	}

	ExtraLinkerFlags += "/ignore:4042"
	{
		&
		{
			GeneratorFamily "VisualStudio"
			TargetIsExecutable true
		}

	}

	ExtraLibFlags += "/ignore:4042"
	{
		&
		{
			Target.Type "StaticLibrary"
			GeneratorFamily "VisualStudio"
		}
	}


	ExtraLinkerFlags =+ "/GENPROFILE"
	{
		&
		{
			TargetIsExecutable true
			MalterlibProfileGuidedOptimization "generate"
			!MalterlibEnableLinkTimeCodeGeneration false
		}
	}

	ExtraLinkerFlags =+ `/USEPROFILE:PGD=@(MalterlibProfileGuidedOptimization)`
	{
		&
		{
			TargetIsExecutable true
			!MalterlibProfileGuidedOptimization undefined
			!MalterlibProfileGuidedOptimization "generate"
			!MalterlibEnableLinkTimeCodeGeneration false
		}
	}
}

Property
{
	MalterlibLinuxSDKDistro: string = "Ubuntu"

	MalterlibLinuxSDKDistro "Debian"
	{
		&
		{
			MalterlibLinuxSDKDistro undefined
			PlatformFamily "Linux"
			Architecture "x86"
		}
	}

	MalterlibSysRoot: string?
	MalterlibSysRoot `@("../../../Binaries/MalterlibSDK"->MakeAbsolute())/@(PlatformFamily)/@(MalterlibLinuxSDKDistro)/@(Architecture)/Linux.sdk`
	{
		|
		{
			PlatformFamily "Linux"
		}
	}

	MalterlibToolsPrefix: string?

	MalterlibToolsPrefix `@(PlatformToolsetCompilerBasePath)/bin/`
	{
		&
		{
			!PlatformToolsetCompilerBasePath undefined
			PlatformToolsetCompiler->GetFileNoExt() "clang"
		}
	}

	// Fallback for macOS when using default compiler (Xcode toolchain)
	MalterlibToolsPrefix `@(Malterlib_MacOSDeveloperLocaction)/Toolchains/XcodeDefault.xctoolchain/usr/bin/`
	{
		&
		{
			MalterlibDefaultCompiler true
			PlatformFamily "macOS"
		}
	}
}

Property
{
	MalterlibLinkerDemangle: bool = true // User(Toolset)=false: Set to false to display mangled names in linker messages

	MalterlibDisableAutomaticResources: bool = false

	MalterlibUseLocalCompilerBuild: bool = false // User(Toolset)=true: Build llvm locally and use that for building

	MalterlibMSVCVersion: string?

	VisualStudioRootUnix: string = `@(Builtin.VisualStudioRoot->UnixPath())`
	VisualStudioMSVCRootPath: string = `@(VisualStudioRootUnix)/VC/Tools/MSVC`

	MalterlibMSVCVersion "14.34.31933"
	{
		!HostPlatformFamily "Windows"
	}

	VisualStudioMSVCVersionPaths: [string] = VisualStudioMSVCRootPath->FindDirectoriesIn('*')->Sort()

	MalterlibLatestMSVCVersion: string = VisualStudioMSVCVersionPaths<[VisualStudioMSVCVersionPaths->Length() - 1]>->GetFile()

	MalterlibMSVCVersion MalterlibLatestMSVCVersion
	{
		!!MalterlibMSVCVersion undefined
	}

	// Windows SDK paths for Ninja generator (avoiding vcvarsall.bat dependency)
	MalterlibWindowsSDKRootPath: string = "C:/Program Files (x86)/Windows Kits/10" // User(Toolset): Windows SDK root path

	MalterlibWindowsSDKVersionPaths: [string] = (MalterlibWindowsSDKRootPath / "Include")->FindDirectoriesIn('10.*')->Sort()

	MalterlibLatestWindowsSDKVersion: string = MalterlibWindowsSDKVersionPaths<[MalterlibWindowsSDKVersionPaths->Length() - 1]>->GetFile()

	// Use Target.PlatformVersion if set, otherwise use latest SDK version
	MalterlibWindowsSDKVersion: string?
	MalterlibWindowsSDKVersion Target.PlatformVersion
	{
		&
		{
			MalterlibWindowsSDKVersion undefined
			!Target.PlatformVersion undefined
		}
	}
	MalterlibWindowsSDKVersion MalterlibLatestWindowsSDKVersion
	{
		!!MalterlibWindowsSDKVersion undefined
	}

	// MSVC architecture mapping (x64 -> x64, arm64 -> arm64)
	MalterlibMSVCArchitecture: string?
	MalterlibMSVCArchitecture "x64"
	{
		!!Architecture "x64"
	}
	MalterlibMSVCArchitecture "x86"
	{
		!!Architecture "x86"
	}
	MalterlibMSVCArchitecture "arm64"
	{
		!!Architecture "arm64"
	}

	// MSVC include path
	MalterlibMSVCIncludePath: string = VisualStudioMSVCRootPath / MalterlibMSVCVersion / "include"

	// MSVC ATL/MFC include path (optional Visual Studio component, not part of clang-cl auto-detection)
	MalterlibMSVCAtlMfcIncludePath: string = VisualStudioMSVCRootPath / MalterlibMSVCVersion / "atlmfc/include"

	// MSVC library path
	MalterlibMSVCLibPath: string = VisualStudioMSVCRootPath / MalterlibMSVCVersion / "lib" / MalterlibMSVCArchitecture

	// MSVC ATL/MFC library path
	MalterlibMSVCAtlMfcLibPath: string = VisualStudioMSVCRootPath / MalterlibMSVCVersion / "atlmfc/lib" / MalterlibMSVCArchitecture

	// Windows SDK include paths
	MalterlibWindowsSDKIncludePath: string = (MalterlibWindowsSDKRootPath / "Include" / MalterlibWindowsSDKVersion)->f_ValidatePathExists("Windows SDK not found at")
	MalterlibWindowsSDKUCRTIncludePath: string = MalterlibWindowsSDKIncludePath / "ucrt"
	MalterlibWindowsSDKUMIncludePath: string = MalterlibWindowsSDKIncludePath / "um"
	MalterlibWindowsSDKSharedIncludePath: string = MalterlibWindowsSDKIncludePath / "shared"
	MalterlibWindowsSDKWinRTIncludePath: string = MalterlibWindowsSDKIncludePath / "winrt"
	MalterlibWindowsSDKCppWinRTIncludePath: string = MalterlibWindowsSDKIncludePath / "cppwinrt"

	// Windows SDK library paths
	MalterlibWindowsSDKLibPath: string = MalterlibWindowsSDKRootPath / "Lib" / MalterlibWindowsSDKVersion
	MalterlibWindowsSDKUCRTLibPath: string = MalterlibWindowsSDKLibPath / "ucrt" / MalterlibMSVCArchitecture
	MalterlibWindowsSDKUMLibPath: string = MalterlibWindowsSDKLibPath / "um" / MalterlibMSVCArchitecture

	// Windows SDK binary paths
	MalterlibWindowsSDKBinPath: string = MalterlibWindowsSDKRootPath / "bin" / MalterlibWindowsSDKVersion / MalterlibMSVCArchitecture

	// Windows SDK binary path (x86 tools, used for inf2cat which is only available as x86)
	MalterlibWindowsSDKBinPathx86: string = MalterlibWindowsSDKRootPath / "bin" / MalterlibWindowsSDKVersion / "x86"

	// Windows WDK (Driver Kit) include paths
	MalterlibWindowsWDKKMIncludePath: string = MalterlibWindowsSDKIncludePath / "km"
	MalterlibWindowsWDKKMCRTIncludePath: string = MalterlibWindowsSDKIncludePath / "km/crt"
	MalterlibWindowsWDKSharedIncludePath: string = MalterlibWindowsSDKSharedIncludePath

	// KMDF version auto-detection (use latest installed)
	MalterlibWindowsKMDFRootPath: string = MalterlibWindowsSDKRootPath / "Include/wdf/kmdf"
	MalterlibWindowsKMDFVersionPaths: [string] = MalterlibWindowsKMDFRootPath->FindDirectoriesIn('*')->Sort()
	MalterlibWindowsKMDFVersion: string = MalterlibWindowsKMDFVersionPaths<[MalterlibWindowsKMDFVersionPaths->Length() - 1]>->GetFile()
	MalterlibWindowsKMDFIncludePath: string = MalterlibWindowsKMDFRootPath / MalterlibWindowsKMDFVersion

	// Windows WDK library paths
	MalterlibWindowsWDKKMLibPath: string = MalterlibWindowsSDKLibPath / "km" / MalterlibMSVCArchitecture
	MalterlibWindowsKMDFLibPath: string = MalterlibWindowsSDKRootPath / "Lib/wdf/kmdf" / MalterlibMSVCArchitecture / MalterlibWindowsKMDFVersion

	PlatformToolsetCompiler: string? // User(Toolset)="/opt/Source/llvm-malterlib/build/main/bin/clang": Change the clang compiler location

	PlatformToolsetCompiler MalterlibLLVMHostBinariesDirectory / `bin/clang@(HostExecutableExtension)`
	{
		&
		{
			PlatformToolsetCompiler undefined
			!MalterlibUseLocalCompilerBuild true
			!MalterlibDefaultCompiler true
		}
	}

	PlatformToolsetCompiler `@(MalterlibDependenciesDirectory)/llvm/@(MalterlibClangVersion)/build/main/bin/clang@(HostExecutableExtension)`
	{
		&
		{
			PlatformToolsetCompiler undefined
			MalterlibUseLocalCompilerBuild true
			!MalterlibDefaultCompiler true
		}
	}
	PlatformToolsetCompilerBasePath: string?
	PlatformToolsetCompilerBasePath PlatformToolsetCompiler->GetPath()->GetPath()
	{
		!PlatformToolsetCompiler undefined
	}

	// Windows resource compiler (llvm-rc)
	PlatformToolsetResourceCompiler: string?
	PlatformToolsetResourceCompiler `@(MalterlibToolsPrefix)llvm-rc@(HostExecutableExtension)`
	{
		&
		{
			PlatformToolsetResourceCompiler undefined
			!PlatformToolsetCompilerBasePath undefined
			PlatformFamily "Windows"
		}
	}

	// MASM assembler (ml64.exe/ml.exe from MSVC)
	PlatformToolsetMASM: string?
	PlatformToolsetMASM VisualStudioMSVCRootPath / MalterlibMSVCVersion / `bin/@(MSVCToolChainArchitecture)/ml64@(HostExecutableExtension)`
	{
		&
		{
			PlatformToolsetMASM undefined
			!MalterlibMSVCVersion undefined
			PlatformFamily "Windows"
			!Architecture "x86"
		}
	}
	PlatformToolsetMASM VisualStudioMSVCRootPath / MalterlibMSVCVersion / `bin/@(MSVCToolChainArchitecture)/ml@(HostExecutableExtension)`
	{
		&
		{
			PlatformToolsetMASM undefined
			!MalterlibMSVCVersion undefined
			PlatformFamily "Windows"
			Architecture "x86"
		}
	}

	// MSVC compiler (cl.exe from MSVC) for managed C++ builds
	PlatformToolsetMSVC: string?
	PlatformToolsetMSVC VisualStudioMSVCRootPath / MalterlibMSVCVersion / `bin/@(MSVCToolChainArchitecture)/cl@(HostExecutableExtension)`
	{
		&
		{
			PlatformToolsetMSVC undefined
			!MalterlibMSVCVersion undefined
			PlatformFamily "Windows"
		}
	}

	// MSVC linker (link.exe from MSVC) — required for C++/CLI (managed) targets
	// because lld-link cannot consume CLR object files
	PlatformToolsetMSVCLinker: string?
	PlatformToolsetMSVCLinker VisualStudioMSVCRootPath / MalterlibMSVCVersion / `bin/@(MSVCToolChainArchitecture)/link@(HostExecutableExtension)`
	{
		&
		{
			PlatformToolsetMSVCLinker undefined
			!MalterlibMSVCVersion undefined
			PlatformFamily "Windows"
		}
	}

	// C# compiler (csc.exe from Visual Studio's Roslyn install).
	// The Roslyn build supports modern C# features and works for both .NET Framework and NetCore targets.
	PlatformToolsetCSharpCompiler: string?
	PlatformToolsetCSharpCompiler `@(VisualStudioRootUnix)/MSBuild/Current/Bin/Roslyn/csc@(HostExecutableExtension)`
	{
		&
		{
			PlatformToolsetCSharpCompiler undefined
			HostPlatformFamily "Windows"
		}
	}

	// .NET Framework reference assemblies (System.dll, System.Data.dll, etc.) used by C# /reference:.
	// Visual Studio looks these up automatically via project properties; direct csc invocation needs the path.
	MalterlibNETFXReferenceAssemblyRoot: string = "C:/Program Files (x86)/Reference Assemblies/Microsoft/Framework/.NETFramework"

	// Resolve the reference-assembly directory for a given Target.TargetFrameworkVersion (e.g. "v4.6" → ".../v4.6").
	f_MalterlibNETFXReferenceAssemblyPath function(string _TargetFrameworkVersion) string? = undefined
	f_MalterlibNETFXReferenceAssemblyPath MalterlibNETFXReferenceAssemblyRoot / _TargetFrameworkVersion
	{
		!!HostPlatformFamily "Windows"
	}

	// ---------------------------------------------------------------------------------------------
	// .NET SDK discovery — used for C++/CLI (NetCore) reference assemblies (mscorlib.dll etc.)
	// passed to cl.exe via /AI<path>. Discovery avoids launching `dotnet --list-sdks`.
	//
	//   Windows: HKLM\SOFTWARE\dotnet\Setup\InstalledVersions\<arch>\InstallLocation
	//            (the dotnet bootstrappers themselves use this; falls back to %ProgramFiles%\dotnet
	//            which is the documented default install path)
	//   macOS:   /usr/local/share/dotnet  (Microsoft installer default)
	//   Linux:   /usr/share/dotnet        (typical distro/.deb default)
	// ---------------------------------------------------------------------------------------------
	MalterlibDotNetRoot: string? // User(Toolset): Override the .NET SDK install root
	// Default to Microsoft's documented install path; override below if the registry has a value.
	MalterlibDotNetRoot "C:/Program Files/dotnet"
	{
		&
		{
			MalterlibDotNetRoot undefined
			HostPlatformFamily "Windows"
		}
	}
	// .NET 7+ registry layout: <arch>\sharedhost\Path (older .NET 6 used <arch>\InstallLocation directly).
	// Use HostArchitecture — dotnet is installed for the host arch and the ref packs are arch-neutral.
	MalterlibDotNetRoot ReadWindowsRegistry(
		"Win64_LocalMachine"
		, `SOFTWARE\\dotnet\\Setup\\InstalledVersions\\@(HostArchitecture)\\sharedhost`
		, "Path"
	)
	{
		&
		{
			HostPlatformFamily "Windows"
			!ReadWindowsRegistry(
				"Win64_LocalMachine"
				, `SOFTWARE\\dotnet\\Setup\\InstalledVersions\\@(HostArchitecture)\\sharedhost`
				, "Path"
			) ""
		}
	}
	MalterlibDotNetRoot "/usr/local/share/dotnet"
	{
		&
		{
			MalterlibDotNetRoot undefined
			HostPlatformFamily "macOS"
		}
	}
	MalterlibDotNetRoot "/usr/share/dotnet"
	{
		&
		{
			MalterlibDotNetRoot undefined
			HostPlatformFamily "Linux"
		}
	}

	// Reference-pack root: contains <Major>.<Minor>.<Patch>/ref/net<Major>.<Minor>/ subdirs.
	MalterlibDotNetReferencePacksRoot: string?
	MalterlibDotNetReferencePacksRoot MalterlibDotNetRoot / "packs/Microsoft.NETCore.App.Ref"
	{
		!MalterlibDotNetRoot undefined
	}

	// Resolve the latest patch version of a given <Major>.<Minor> series (e.g. "8.0" → "8.0.10").
	// Globs Microsoft.NETCore.App.Ref/<Major>.<Minor>.* and returns the highest patch.
	f_MalterlibDotNetLatestRefVersion function(string _MajorMinor) string? = undefined
	f_MalterlibDotNetLatestRefVersion (
		MalterlibDotNetReferencePacksRoot->FindDirectoriesIn(`@(_MajorMinor).*`)->Sort()
		<[MalterlibDotNetReferencePacksRoot->FindDirectoriesIn(`@(_MajorMinor).*`)->Length() - 1]>
	)->GetFile()
	{
		&
		{
			!MalterlibDotNetReferencePacksRoot undefined
			(MalterlibDotNetReferencePacksRoot->FindDirectoriesIn(`@(_MajorMinor).*`)->Length() > 0) true
		}
	}

	// Full reference-assembly directory for a given <Major>.<Minor> (e.g. "8.0" → ".../ref/net8.0/").
	// Pass the result to cl.exe as /AI<path> so /clr:netcore can resolve mscorlib.dll etc.
	f_MalterlibDotNetReferenceAssemblyPath function(string _MajorMinor) string? = undefined
	f_MalterlibDotNetReferenceAssemblyPath MalterlibDotNetReferencePacksRoot / f_MalterlibDotNetLatestRefVersion(_MajorMinor) / `ref/net@(_MajorMinor)`
	{
		!f_MalterlibDotNetLatestRefVersion(_MajorMinor) undefined
	}

	// .NET Framework SDK — contains mscoree.lib and other managed-code import libs.
	// Visual Studio's vcvarsall normally injects this automatically; Ninja+link.exe must
	// add it explicitly. Latest installed version is fine — these import libs are stable.
	// Only meaningful on Windows; consumers gate usage on PlatformFamily.
	MalterlibNETFXSDKRoot: string = "C:/Program Files (x86)/Windows Kits/NETFXSDK"
	MalterlibNETFXSDKVersionPaths: [string] = MalterlibNETFXSDKRoot->FindDirectoriesIn('*')->Sort()

	MalterlibNETFXSDKVersion: string?
	MalterlibNETFXSDKVersion MalterlibNETFXSDKVersionPaths<[MalterlibNETFXSDKVersionPaths->Length() - 1]>->GetFile()
	{
		&
		{
			HostPlatformFamily "Windows"
			(MalterlibNETFXSDKVersionPaths->Length() > 0) true
		}
	}

	MalterlibNETFXSDKLibPath: string?
	MalterlibNETFXSDKLibPath MalterlibNETFXSDKRoot / MalterlibNETFXSDKVersion / `Lib/um/@(MalterlibMSVCArchitecture)`
	{
		!MalterlibNETFXSDKVersion undefined
	}

	// .NET Framework SDK Tools directory — contains sn.exe for strong-naming assemblies.
	// Visual Studio's vcvarsall puts this on PATH; Ninja invokes the post-build script
	// directly so we must add it via Target.ToolPath ourselves.
	MalterlibNETFXSDKToolsRoot: string = "C:/Program Files (x86)/Microsoft SDKs/Windows/v10.0A/bin"
	MalterlibNETFXSDKToolsPaths: [string] = MalterlibNETFXSDKToolsRoot->FindDirectoriesIn('NETFX*Tools')->Sort()

	MalterlibNETFXSDKToolsPath: string?
	MalterlibNETFXSDKToolsPath MalterlibNETFXSDKToolsPaths<[MalterlibNETFXSDKToolsPaths->Length() - 1]>
	{
		&
		{
			HostPlatformFamily "Windows"
			(MalterlibNETFXSDKToolsPaths->Length() > 0) true
		}
	}

	// Apphost pack: contains ijwhost.lib (linked by C++/CLI assemblies under /clr:netcore).
	// Per-architecture pack name uses the win-<arch> RID (Windows Runtime Identifier).
	MalterlibDotNetAppHostPackRoot: string?
	MalterlibDotNetAppHostPackRoot MalterlibDotNetRoot / `packs/Microsoft.NETCore.App.Host.win-@(Architecture)`
	{
		&
		{
			!MalterlibDotNetRoot undefined
			PlatformFamily "Windows"
		}
	}

	f_MalterlibDotNetLatestAppHostVersion function(string _MajorMinor) string? = undefined
	f_MalterlibDotNetLatestAppHostVersion (
		MalterlibDotNetAppHostPackRoot->FindDirectoriesIn(`@(_MajorMinor).*`)->Sort()
		<[MalterlibDotNetAppHostPackRoot->FindDirectoriesIn(`@(_MajorMinor).*`)->Length() - 1]>
	)->GetFile()
	{
		&
		{
			!MalterlibDotNetAppHostPackRoot undefined
			(MalterlibDotNetAppHostPackRoot->FindDirectoriesIn(`@(_MajorMinor).*`)->Length() > 0) true
		}
	}

	// Path containing ijwhost.lib for a given <Major>.<Minor>. Add to Target.SearchPath
	// so link.exe can resolve the auto-linked import lib.
	f_MalterlibDotNetAppHostNativePath function(string _MajorMinor) string? = undefined
	f_MalterlibDotNetAppHostNativePath MalterlibDotNetAppHostPackRoot / f_MalterlibDotNetLatestAppHostVersion(_MajorMinor) / `runtimes/win-@(Architecture)/native`
	{
		!f_MalterlibDotNetLatestAppHostVersion(_MajorMinor) undefined
	}
}

Target
{
	!!GeneratorFamily "Xcode"
	!!GeneratorFamily "Ninja"

	MToolPath: string?
	MToolPath MToolPath
}

Property
{
	fg_ExportScriptEnvironmentContents_Template function(string _EnvVar) string = ""
	fg_ExportScriptEnvironmentContents_Template =+ `export @(_EnvVar)=@(GetProperty(&@(_EnvVar), "Target:*")->ToStringCompact()->EscapeHost())\n`
	{
		&
		{
			!PlatformFamily "Windows"
			!GetProperty(&@(_EnvVar), "Target:*") undefined
		}
	}
	fg_ExportScriptEnvironmentContents_Template =+ `set "@(_EnvVar)=@(GetProperty(&@(_EnvVar), "Target:*")->ToStringCompact())"\r\n`
	{
		&
		{
			PlatformFamily "Windows"
			!MalterlibExportEnvironmentMinGW true
			!GetProperty(&@(_EnvVar), "Target:*") undefined
		}
	}

	fg_ExportScriptEnvironmentContents_MaybeMinGW function(string _EnvVar) string
	fg_ExportScriptEnvironmentContents_MaybeMinGW GetProperty(&@(_EnvVar), "Target:*")->ToStringCompact()->UnixPath()
	fg_ExportScriptEnvironmentContents_MaybeMinGW fg_ExportScriptEnvironmentContents_MaybeMinGW->ParseFormatString("{}:/{}", "/{0,cl}/{1}")
	{
		!!fg_ExportScriptEnvironmentContents_MaybeMinGW ~"?:*"
	}

	fg_ExportScriptEnvironmentContents_Template =+ `set @(`@(_EnvVar)=@(fg_ExportScriptEnvironmentContents_MaybeMinGW(_EnvVar))`->EscapeHost())\r\n`
	{
		&
		{
			PlatformFamily "Windows"
			MalterlibExportEnvironmentMinGW true
			!GetProperty(&@(_EnvVar), "Target:*") undefined
		}
	}
}

Target
{
	ExportScriptEnvironmentContents: string ?
	ExportScriptEnvironmentContents Target.ExportScriptEnvironment->ForEach(&fg_ExportScriptEnvironmentContents_Template)
}

