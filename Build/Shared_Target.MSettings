}

// Executable targets
Target
{
	!!TargetIsExecutable true
	Version "@(ProductVersionMajor).@(ProductVersionMinor)@(ProductVersionRevision)"

	GenerateDebugInformation true
	GenerateDebugInformation "DebugFastLink"
	{
		&
		{
			LanguageFamily "Native"
			!MalterlibDeploySymbols true
			GeneratorFamily "VisualStudio"
			!Target.PlatformToolset "v90"
			!Target.CLRSupport true
			!MalterlibMemoryManager_Debug_EnableStackTrace true // Currently crashes in DIA if enabled
			!MalterlibEnableFastLink false
		}
	}
	GenerateDebugInformation false
	{
		!!Configuration "Fast Compile"
	}
}

Property
{
	MalterlibXcodeObjectsDirectory "$(OBJECT_FILE_DIR_$CURRENT_VARIANT:file)"

	MalterlibPosixInitFileName "@(MalterlibCompiledFilesSourceBase)/@(Workspace:Workspace.Name)/Intermediate/Lib_Malterlib_Init/@(Platform)/@(Architecture)/@(FullConfiguration)/@(MalterlibXcodeObjectsDirectory)/@(MalterlibXcodeBuildArchitecture)/Malterlib_Core_PlatformImp_Posix_Init.o"
	{
		&
		{
			!MalterlibDisableMalterlib true
			MalterlibNeedsInitProject true
		}
	}
}

Property
{
	MalterlibOverrideMallocLibrary "@(MalterlibCompiledFilesSourceBase)/@(Workspace:Workspace.Name)/Output/Dll_MalterlibOverrideMalloc/@(Platform)/@(Architecture)/@(FullConfiguration)/Deployed/MalterlibOverrideMalloc.dylib"

	MalterlibNeedsMallocOverrideLibrary true
	{
		&
		{
			MalterlibNeedsMallocOverrideLibrary ""
			TargetIsExecutable true
			!Target.Type "DynamicLibrary"
			!Target.Type "XcodeBundle"
			!Target.Type "SharedDynamicLibrary"
			!Target.Type "Driver"
			!DocumentationEnabled true
			!MalterlibDisableMalterlib true
			PlatformIsDarwin true
			MalterlibMemoryManager_EnableOverrideSystemMalloc true
		}
	}
}

// Executable native targets
Target
{
	&
	{
		LanguageFamily "Native"
		TargetIsExecutable true
	}

	LinkWithLibraries "@(Target.LinkWithLibraries) @(Builtin.Inherit)"
	{
		&
		{
			!Target.Type "Driver"
			!PlatformFamily "Windows"
		}
	}
	LinkWithLibraries "@(Target.LinkWithLibraries);@(Builtin.Inherit)"
	{
		&
		{
			!Target.Type "Driver"
			PlatformFamily "Windows"
		}
	}

	LinkWithLibraries "-first_object @(MalterlibPosixInitFileName) @(Target.LinkWithLibraries)"
	{
		&
		{
			TargetIsExecutable true
			!Target.Type "Driver"
			!MalterlibDisableMalterlib true
			!MalterlibPosixInitFileName ""
			!MalterlibDefaultCompiler true
			MalterlibCustomCompilerOptions true
		}
	}

	LinkWithLibraries "-sectcreate __TEXT __info_plist \"@(Target:Target.MalterlibInfoPListFile)\" @(Target.LinkWithLibraries)"
	{

		&
		{
			"!Target:Target.MalterlibInfoPListFile" ""
			!MalterlibIsOSXBundle true
		}
	}

	LinkWithLibraries "-framework CoreFoundation @(Target.LinkWithLibraries)"
	{
		&
		{
			PlatformIsDarwin true
			!Target.Type "Driver"
		}
	}

	LinkWithLibraries "-framework CoreServices @(Target.LinkWithLibraries)"
	{
		// Used for FSEvents API
		&
		{
			PlatformFamily "OSX"
			!Target.Type "Driver"
		}
	}

	LinkWithLibraries "-framework AppKit @(Target.LinkWithLibraries)"
	{
		&
		{
			PlatformFamily "OSX"
			!Target.Type "Driver"
		}
	}

	LinkWithLibraries "-framework Security @(Target.LinkWithLibraries)"
	{
		&
		{
			PlatformIsDarwin true
			!Target.Type "Driver"
		}
	}

	LinkWithLibraries "-framework Cocoa -framework IOKit -framework OpenGL @(Target.LinkWithLibraries)"
	{
		&
		{
			PlatformFamily "OSX"
			!Target.Type "Driver"
		}
	}

	LinkWithLibraries "-framework UIKit @(Target.LinkWithLibraries)"
	{
		&
		{
			PlatformFamily "iOS"
			!Target.Type "Driver"
		}
	}

	LinkWithLibraries "-pthread -ldl -luuid -lrt @(Target.LinkWithLibraries)"
	{
		!!PlatformFamily "Linux"
	}

	LinkWithLibraries "-lasound @(Target.LinkWithLibraries)"
	{
		&
		{
			PlatformFamily "Linux"
			Target.Type "UIExecutable"
		}
	}

	LinkWithLibraries "\"-F@('../../../SDK'->MakeAbsolute())/BreakpadBin/@(PlatformFamily)\" @(Target.LinkWithLibraries)"
	{
		&
		{
			PlatformIsDarwin true
			MalterlibEnableBreakpad true
			Target.Type "UIExecutable"
		}
	}
	LinkWithLibraries "-framework Breakpad @(Target.LinkWithLibraries)"
	{
		&
		{
			PlatformIsDarwin true
			MalterlibEnableBreakpad true
			Target.Type "UIExecutable"
		}
	}

	LinkWithLibraries "-lc++abi @(Target.LinkWithLibraries)"
	{
		&
		{
			PlatformIsDarwin true
			!MalterlibUseStaticLibCxxABI true
			!Target.Type "Driver"
		}
	}

	RealLinkWithLibraries "@(Target.LinkWithLibraries)"
	{
		!!GeneratorFamily "Xcode"
	}

	RealLinkWithLibraries "\"@(MalterlibOverrideMallocLibrary)\" @(Target.RealLinkWithLibraries)"
	{
		!!MalterlibNeedsMallocOverrideLibrary true
	}

	SearchPath "@(Target.SearchPath);@(Builtin.Inherit)"

	SearchPath "@('../../../SDK'->MakeAbsolute())/WDK/lib/WXP/i386;@(Target.SearchPath)"
	{
		&
		{
			PlatformType "Windows"
			Target.Type "Driver"
			Architecture "x86"
		}
	}
	SearchPath "@('../../../SDK'->MakeAbsolute())/WDK/lib/WNET/amd64;@(Target.SearchPath)"
	{
		&
		{
			PlatformType "Windows"
			Target.Type "Driver"
			Architecture "x64"
		}
	}

	LinkWithLibraries "-framework Security @(Target.LinkWithLibraries)"
	{
		&
		{
			MalterlibLinkWithOpenSSL true
			PlatformIsDarwin true
			!AOCCDisableSSL true
			!Target.Type "Driver"
		}
	}

	RemoveUnreferencedSymbols false
	RemoveUnreferencedSymbols true // OptimizeReferences
	{
		&
		{
			DebugCompiler false
			!Configuration "Release Debug"
		}
	}
}

// .NET Executable Targets
Target
{
	&
	{
		LanguageFamily ".NET"
		TargetIsExecutable true
	}
	StartAction "Program"
}

// Windows native executable targets
Target
{
	&
	{
		LanguageFamily "Native"
		TargetIsExecutable true
		PlatformType "Windows"
	}

	IgnoreImportLibrary true
	GenerateManifest true
	GenerateManifest false
	{
		!!Configuration "Fast Compile"
	}
	LinkIncremental true
	{
		!!DebugCompiler true
	}
	LinkIncremental false
	{
		!!DebugCompiler false
	}
	LinkKeyFile "@(MalterlibStronglyNamedAssembly)"
	{
		&
		{
			!MalterlibStronglyNamedAssembly ""
			!Configuration "Fast Compile"
		}
	}
	DelaySign true
	{
		&
		{
			!MalterlibStronglyNamedAssembly ""
			!Configuration "Fast Compile"
		}
	}

	SymbolFile "@(Builtin.OutputDirectory)@(Target.FileName).pdb"

	SymbolFile ""
	{
		!!Configuration "Fast Compile"
	}

	SubSystem "Windows"
	{
	}
	SubSystem "Console"
	{
		!!Target.Type "ConsoleExecutable"
	}

	LargeAddressAware true

	MinimumRequiredVersion "6.0"

	EntryPointSymbol "wWinMainCRTStartup"
	{
		&
		{
			Target.CharacterSet "Unicode"
			|
			{
				Target.Type "Executable"
				Target.Type "UIExecutable"
			}
		}
	}
	EntryPointSymbol "wmainCRTStartup"
	{
		&
		{
			Target.CharacterSet "Unicode"
			Target.Type "ConsoleExecutable"
		}
	}
	EntryPointSymbol "WinMainCRTStartup"
	{
		&
		{
			Target.CharacterSet "MultiByte"
			|
			{
				Target.Type "Executable"
				Target.Type "UIExecutable"
			}
		}
	}
	EntryPointSymbol "mainCRTStartup"
	{
		&
		{
			Target.CharacterSet "MultiByte"
			Target.Type "ConsoleExecutable"
		}
	}
	ExtraLinkerFlags "/CGTHREADS:8 /OPT:ICF=16 @(Target.ExtraLinkerFlags)"
	{
		&
		{
			DebugCompiler false
			!Configuration "Release Debug"
		}
	}

	AssemblyDebug true
	{
		!!DebugCompiler true
		!!Configuration "Release Debug"
	}
}

// Windows and driver targets
Target
{
	&
	{
		LanguageFamily "Native"
		Target.Type "Driver"
		PlatformType "Windows"
	}
	GenerateManifest false
	SubSystem "Native"
	Driver true
	EntryPointSymbol "DriverEntry"
	IgnoreAllDefaultLibraries true
	LinkWithLibraries "BufferOverflowK.lib;Wdmsec.lib;ntoskrnl.lib;hal.lib;ntstrsafe.lib;@(Target.LinkWithLibraries)"
	//RandomizedBaseAddress false
	//DataExecutionPrevention false
}

Property
{
	MalterlibSeparatePostCopyPerPlatfrom true // User(Build System)=false: Enable separate post copy projects when building for non-host platforms
	{
