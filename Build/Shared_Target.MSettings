	PostBuildScript "@(Target.PostBuildScript)"\
					"echo Sign:\r\n"\
					"echo @(MalterlibCodeSignOSXCommand) --force --timestamp --deep --sign @(MalterlibSignCertOSX) \"@(MalterlibFinalModuleDestination->NativePath())\"\r\n"\
					"@(MalterlibCodeSignOSXCommand) --force --timestamp --deep --sign @(MalterlibSignCertOSX) \"@(MalterlibFinalModuleDestination->NativePath())\"\r\n"
	{
		&
		{
			PlatformFamily "OSX"
			TargetIsExecutable true
			|
			{
				MalterlibSigning true
				&
				{
					Target.Type "Driver"
					MalterlibDriverSigning true
				}
			}
		}
	}

	PostBuildScript "@(Target.PostBuildScript)"\
					"echo Notarize:\r\n"\
					"/usr/bin/ditto -c -k --keepParent \"@(MalterlibFinalModuleDestination->NativePath())\" \"@(MalterlibFinalModuleDestination->NativePath()).zip\"\r\n"\
					"echo @(MalterlibALToolOSXCommand) --notarize-app --primary-bundle-id \"@(MalterlibBundleIdentifier)\" --asc-provider \"@(MalterlibNotarizeOSXProvider)\" --username \"@(MalterlibNotarizeOSXUser)\" --password \"@(MalterlibNotarizeOSXPassword)\" --file \"@(MalterlibFinalModuleDestination->NativePath()).zip\"\r\n"\
					"@(MalterlibALToolOSXCommand) --notarize-app --primary-bundle-id \"@(MalterlibBundleIdentifier)\" --asc-provider \"@(MalterlibNotarizeOSXProvider)\" --username \"@(MalterlibNotarizeOSXUser)\" --password \"@(MalterlibNotarizeOSXPassword)\" --file \"@(MalterlibFinalModuleDestination->NativePath()).zip\" 2>&1 | tee \"@(MalterlibFinalModuleDestination->NativePath()).log\"\r\n"\
					"NotarizationRequestUUID=$(awk -F ' = ' '/RequestUUID/ {print $2}' \"@(MalterlibFinalModuleDestination->NativePath()).log\")\r\n"\
					"while true; do\r\n"\
					"	@(MalterlibALToolOSXCommand) --notarization-info \"$NotarizationRequestUUID\" --asc-provider \"@(MalterlibNotarizeOSXProvider)\" --username \"@(MalterlibNotarizeOSXUser)\" --password \"@(MalterlibNotarizeOSXPassword)\" > \"@(MalterlibFinalModuleDestination->NativePath()).log\" 2>&1\r\n"\
					"	if ! grep -q \"Status: in progress\" \"@(MalterlibFinalModuleDestination->NativePath()).log\"; then\r\n"\
					"		break\r\n"\
					"	fi\r\n"\
					"	sleep 15\r\n"\
					"done\r\n"\
					"cat \"@(MalterlibFinalModuleDestination->NativePath()).log\"\r\n"\
					"LogFileURL=$(awk -F ': ' '/LogFileURL/ {print $2}' \"@(MalterlibFinalModuleDestination->NativePath()).log\")\r\n"\
					"if [[ \"$LogFileURL\" != \"\" ]]; then\r\n"\
					"	curl -s \"$LogFileURL\"\r\n"\
					"	echo \"\"\r\n"\
					"fi\r\n"\
					"if ! grep -q \"Status: success\" \"@(MalterlibFinalModuleDestination->NativePath()).log\"; then\r\n"\
					"	echo \"Error: Notarization failed\"\r\n"\
					"	exit 1\r\n"\
					"fi\r\n"\
					"echo @(MalterlibStaplerOSXCommand) staple \"@(MalterlibFinalModuleDestination->NativePath())\"\r\n"\
					"@(MalterlibStaplerOSXCommand) staple \"@(MalterlibFinalModuleDestination->NativePath())\"\r\n"
	{
		&
		{
			PlatformFamily "OSX"
			MalterlibSigning true
			Target.Type "UIExecutable"
			!MalterlibNotarizeOSXUser ""
		}
	}

	PostBuildScript "@(Target.PostBuildScript)"\
					"echo Sign:\r\n"\
