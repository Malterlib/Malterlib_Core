// ExeFS
Property
{

	MalterlibLocalizationTranslationsPath: string = `@(MalterlibCompiledFilesWarkspaceBase)/Int/GeneratedTranslation/@(Platform)/@(Architecture)/@(FullConfiguration)`
	MalterlibLocalizationExeFSPath: string = `@(MalterlibLocalizationTranslationsPath)/TranslationsExeFS/*`
	MalterlibLocalizationTranslationHeadersPath: string = `@(MalterlibLocalizationTranslationsPath)/TranslationHeaders`

	MalterlibTempExeFSPath: string = `@(Target.IntermediateDirectory)ExeFS/*`

	MalterlibSharedIntermediateDirectory: string = `@(MalterlibCompiledFilesWarkspaceBase)/Int/@(Target:Target.Name)/Shared`

	MalterlibSharedTempExeFSPath: string = `@(MalterlibSharedIntermediateDirectory)/ExeFS/*`

	MalterlibOriginalModuleDestination: string = `@(Target.OutputDirectory)@(Target:Target.FileName)@(Target:Target.FileExtension)`
	MalterlibOriginalModulePath: string = MalterlibOriginalModuleDestination->GetPath()

	MalterlibFinalModuleDestination: string = MalterlibOriginalModuleDestination
	MalterlibFinalModuleDestination `@(Target:Target.OutputDirectory)Deployed/@(Target:Target.FileName)@(Target:Target.FileExtension)`
	{
		&
		{
			!DocumentationEnabled true
			TargetIsExecutable true
		}
	}

	MalterlibFinalModuleDestinationPath: string = MalterlibFinalModuleDestination->GetPath()

	MalterlibFinalModuleDestinationExecutable: string = MalterlibFinalModuleDestination
	MalterlibFinalModuleDestinationExecutable `@(MalterlibFinalModuleDestination)/Contents/MacOS/@(Target:Target.FileName)`
	{
		&
		{
			MalterlibIsMacOSBundle true
			!Target.DriverType "DriverKit"
		}
	}
	MalterlibFinalModuleDestinationExecutable `@(MalterlibFinalModuleDestination)/@(Target:Target.FileName)`
	{
		&
		{
			MalterlibIsMacOSBundle true
			Target.DriverType "DriverKit"
		}
	}

	MalterlibOriginalModuleDestinationExecutable: string?
	MalterlibOriginalModuleDestinationExecutable MalterlibOriginalModuleDestination
	{
		!Target.Type "Tool"
	}
	MalterlibOriginalModuleDestinationExecutable `@(MalterlibOriginalModuleDestination)/Contents/MacOS/@(Target:Target.FileName)`
	{
		&
		{
			MalterlibIsMacOSBundle true
			!Target.DriverType "DriverKit"
		}
	}
	MalterlibOriginalModuleDestinationExecutable `@(MalterlibOriginalModuleDestination)/@(Target:Target.FileName)`
	{
		&
		{
			MalterlibIsMacOSBundle true
			Target.DriverType "DriverKit"
		}
	}

	// .NET 5+ launchable executables under Ninja: csc writes the managed
	// assembly into the target's intermediate directory under <name>.dll
	// instead of producing the runnable .exe directly. PostBuild then runs
	// MTool BuildAppHost to read the .dll and generate the canonical
	// MalterlibOriginalModuleDestination (.exe = apphost shim, optionally
	// containing a single-file bundle). Keeping csc's output and BuildAppHost's
	// output in different directories means re-firing PostBuild without csc
	// firing first can't corrupt the .dll by overwriting it with apphost bytes.
	MalterlibOriginalModuleDestinationExecutable `@(Target.IntermediateDirectory)@(Target:Target.FileName).dll`
	{
		&
		{
			GeneratorFamily "Ninja"
			Target.Language "C#"
			Target.CLRSupport "NetCore"
			TargetIsLaunchableExecutable true
		}
	}
}

Property
{
	GeneratedDirectory: string = `@(MalterlibCompiledFilesWarkspaceBase)/Generated/@(Target:Target.Name)/@(Platform)/@(Architecture)/@(FullConfiguration)/`

	GeneratedDirectoryNoConfig: string = `@(MalterlibCompiledFilesWarkspaceBase)/Generated/@(Target:Target.Name)/NoConfig/`
	GeneratedWorkspaceDirectory: string = `@(MalterlibCompiledFilesWarkspaceBase)/Generated/@(Platform)/@(Architecture)/@(FullConfiguration)/`
	GeneratedWorkspaceDirectoryNoConfig: string = `@(MalterlibCompiledFilesWarkspaceBase)/Generated/NoConfig/`

	MalterlibUniqueConfig: string = GeneratedDirectory->Sanitize()->Replace('-', '_')->Replace('.', '_')

	MalterlibMacOSLinkerVersion: int?
	MalterlibMacOSLinkerVersion ExecuteCommand(`@(GeneratedGlobalDirectory)MacOSLinkerVersion.MState`, ["/usr/bin/ld"], "bash", "-c", "/usr/bin/ld -v 2>&1")->Trim()->Split("PROJECT:")<[1]>->Split("\n")<[0]>->RemovePrefix("ld64-")->RemovePrefix("ld-")->AsInteger()
	{
		&
		{
			HostPlatformFamily "macOS"
			!MalterlibDefaultCompiler true
		}
	}
}

Property
{
