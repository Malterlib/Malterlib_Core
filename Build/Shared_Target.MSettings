		{
			Group "@(Platform) @(Architecture) @(FullConfiguration)"
			Name "@(GeneratedDirectory)/@(Workspace:Workspace.Name)_@(Target:Target.Name).MalterlibFSSpec"
			Contents "@(MalterlibExeFSSpecContents)"
			UnicodeBOM true
		}
	}
}

