%Group "~Automatic/Build Specifics"
{
	%GenerateFile "Generate"
	{
		Property
		{
			Name "@(GeneratedDirectory)MalterlibBuild.h"

			Contents "#pragma once\r\n@(MalterlibBuildSpecifics)"

			UnicodeBOM "true"
			Group "@(Platform) @(Architecture) @(FullConfiguration)"
		}
		Compile
		{
			Type "None"
		}		
	}

	!MalterlibBuildSpecifics ""
}
