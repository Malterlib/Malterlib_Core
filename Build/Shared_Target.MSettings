		!Target.Type "Tool"
	}

	MalterlibEnableLinkTimeCodeGeneration true
	{
		&
		{
			MalterlibEnableLinkTimeCodeGeneration ""
			|
			{
				PlatformFamily "Windows"
			}
			|
			{
				Compile.Optimize "On"
				Compile.Optimize "Full"
			}
		}
	}

	MalterlibEnableLinkTimeCodeGeneration "Fast"
	{
		&
		{
			MalterlibEnableLinkTimeCodeGeneration ""
			|
			{
				Compile.Optimize "On"
				Compile.Optimize "Full"
			}
		}
	}

	MalterlibEnableLinkTimeCodeGeneration false
	{
		!!MalterlibEnableLinkTimeCodeGeneration ""
	}
}

