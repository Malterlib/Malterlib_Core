	MalterlibWindowsSignCommandLine "@(Win32SignTool) sign /fd SHA256 /ac \"@(MalterlibSignIncludeCert->WindowsPath())\" /n \"@(MalterlibSignCertWindows)\" @(Win32SignToolTimestampServerOptions) \"@(MalterlibFinalModuleDestination->WindowsPath())\""

	MalterlibWindowsSignCommandLine "@(Win32SignTool) sign /fd SHA256 /n \"@(MalterlibSignCertWindows)\" @(Win32SignToolTimestampServerOptions) \"@(MalterlibFinalModuleDestination->WindowsPath())\""
