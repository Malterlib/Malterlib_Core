Dependency
{
	Link TargetIsExecutable
	{
		!!Dependency.Link undefined
	}
}
Dependency
{
	!!LanguageFamily "Native"
	/*
	LinkWithObjectFiles true
	{
		&
		{
			Dependency.LinkWithObjectFiles undefined
			|
			{
				Configuration "Debug"
				Configuration "Debug Inlined"
				Configuration "Fast Compile"
			}
		}
	}
	*/
	LinkWithObjectFiles: bool = false

	LinkWithObjectFiles true
	{
		&
		{
			GeneratorFamily "VisualStudio"
			Dependency.LinkWithObjectFiles undefined
			Dependency.ObjectLibrary true
		}
	}
}

Target
{
	Language: string?
	TargetFrameworkVersion: string?
	CLRSupport: one_of(bool, "NetCore")?
	ProjectDir: string?
	CodeCoverageLinkerMapping: bool?
	CodeCoverageMapping: bool?
	InstrumentForOptimization: bool?
	LinkWithStandardLibraries: bool?
	SharedLibraryInstallPath: string?
	PhonyOutputs: [string]?
}

Target
{
	&
	{
		LanguageFamily "Native"
		!Target.CLRSupport undefined
		GeneratorFamily "Ninja"
	}

	// Use the MSVC linker (link.exe) directly instead of the clang++ driver / lld-link.
	// Required for C++/CLI managed targets (both Framework /clr and NetCore /clr:netcore) —
	// lld-link cannot consume CLR objects. Can be set explicitly for other native MS-link scenarios.
	UseMSLinker: bool?
	UseMSLinker true
	{
		!!Target.UseMSLinker undefined
	}
}

Target
{
	&
	{
		LanguageFamily ".NET"
		GeneratorFamily "Ninja"
	}

	// Baseline assembly references for NetCore C# / C++/CLI targets. .NET Framework's System.dll
	// forwards to types like Object/Enum/etc., but NetCore splits the BCL across many small
	// assemblies — these are the ones every NetCore target needs in addition to its own deps.
	// Targets can extend this list (e.g. add System.Console for console apps) via += in their .MTarget.
	NetCoreBaselineRefs: [string]? = []
	NetCoreBaselineRefs ["mscorlib", "netstandard", "System.Runtime", "System.Runtime.InteropServices", "System.Console", "System.Threading", "System.Threading.Thread"]
	{
		!!Target.CLRSupport "NetCore"
	}
}

Target
{
	!!PlatformFamily "Windows"

	NasmPath: string? = MalterlibBinariesDirectory
	{
		!!Target.Language "Native"
	}
}

Target
{
	!!GeneratorFamily "VisualStudio"

	CLRSupport false
	{
		!!Target.CLRSupport undefined
	}

	CustomBuildAfterTargets: string?
	{
		!!LanguageFamily "Native"
	}
	//= "ClCompile"
	CustomBuildBeforeTargets: string?
	{
		!!LanguageFamily "Native"
	}
}

// Target type
Target
{
	Type "ConsoleExecutable"
	{
		!!Target.Type undefined
	}

	FollowIndirectDependencies true
	{
		!!Target.Type "StaticLibrary"
	}
}

// Properties derived from target type
Property
{
	MalterlibExportEnvironmentMinGW: bool?

	TargetIsExecutable: bool = false
	TargetIsExecutable true
	{
		&
		{
			HasParentEntity("Target") true
			|
			{
				Target:Target.Type "ConsoleExecutable"
				Target:Target.Type "UIExecutable"
				Target:Target.Type "Executable"
				Target:Target.Type "DynamicLibrary"
				Target:Target.Type "XcodeBundle"
				Target:Target.Type "SharedDynamicLibrary"
				Target:Target.Type "Driver"
			}
		}
	}

	TargetIsLinkable: bool = false
	TargetIsLinkable true
	{
		|
		{
			TargetIsExecutable true
			&
			{
				HasParentEntity("Target") true
				|
				{
					Target:Target.Type "StaticLibrary"
				}
			}
		}
	}

	TargetIsLaunchableExecutable: bool = false
	TargetIsLaunchableExecutable true
	{
		&
		{
			HasParentEntity("Target") true
			|
			{
				Target:Target.Type "ConsoleExecutable"
				Target:Target.Type "UIExecutable"
				Target:Target.Type "Executable"
			}
		}
	}

	TargetExecutable: string = `@(Target.FileName)@(Target.FileExtension)`
	TargetIdentity: string
	TargetIdentity Target:this.Identity

	WorkspaceIdentity: string
	WorkspaceIdentity Workspace:this.Identity

	MalterlibTargetNameType: one_of("Suffixed", "Normal", "BaseName", "Launcher", "Config", "Architectured") = "Normal"
}

// Name / Filename
Target
{
	BaseName: string = this.Identity

	Name `Com_@(Target.BaseName)`
	{
		&
		{
			Target:Target.Name undefined
			Target:Target.Type "ConsoleExecutable"
		}
	}
	Name `Exe_@(Target.BaseName)`
	{
		&
		{
			Target:Target.Name undefined
			|
			{
				Target:Target.Type "Executable"
				Target:Target.Type "UIExecutable"
			}
		}
	}

	Name `Drv_@(Target.BaseName)`
	{
		&
		{
			Target:Target.Name undefined
			Target:Target.Type "Driver"
		}
	}
	Name `Dll_@(Target.BaseName)`
	{
		&
		{
			Target:Target.Name undefined
			|
			{
				Target:Target.Type "DynamicLibrary"
				Target:Target.Type "XcodeBundle"
				Target:Target.Type "SharedDynamicLibrary"
			}
		}
	}
	Name `Lib_@(Target.BaseName)`
	{
		&
		{
			Target:Target.Name undefined
			Target:Target.Type "StaticLibrary"
		}
	}
	Name `Tool_@(Target.BaseName)`
	{
		&
		{
			Target:Target.Name undefined
			Target:Target.Type "Tool"
		}
	}

	BaseFileName: string = Target.BaseName

	// Filename
	FileName `@(Target.BaseFileName)@(MalterlibConfigSuffix)_@(MalterlibArchitectureSuffix)@(MalterlibTargetExtraSuffix)`
	{
		&
		{
			Target.FileName undefined
			Property.MalterlibTargetNameType "Suffixed"
		}
	}
	FileName `@(Target.BaseFileName)@(MalterlibTargetExtraSuffix)`
	{
		&
		{
			Target.FileName undefined
			Property.MalterlibTargetNameType "Normal"
		}
	}
	FileName Target.BaseFileName
	{
		&
		{
			Target.FileName undefined
			Property.MalterlibTargetNameType "BaseName"
		}
	}

	FileName `@(Target.BaseFileName)@(MalterlibConfigSuffix)@(MalterlibTargetExtraSuffix)`
	{
		&
		{
			Target.FileName undefined
			Property.MalterlibTargetNameType "Launcher"
		}
	}

	FileName `@(Target.BaseFileName)@(MalterlibConfigSuffix)@(MalterlibTargetExtraSuffix)`
	{
		&
		{
			Target.FileName undefined
			Property.MalterlibTargetNameType "Config"
		}
	}

	FileName `@(Target.BaseFileName)_@(Architecture)@(MalterlibTargetExtraSuffix)`
	{
		&
		{
			Target.FileName undefined
			Property.MalterlibTargetNameType "Architectured"
		}
	}
}

Property.MalterlibGenerateScheme: bool = true

Compile
{
	BuildPriority: int? // Used for ordering the build in the build graph. Higher value is higher priority. After first build it's inferred from the number of milliseconds the build took, overrides the targets build priority
}

Target
{
	IDEDebugPriority: int = 100 // Used for selecting the default debug target in IDEs. Higher value is higher priority

	BuildPriority: int = 100 // Used for ordering the build in the build graph. Higher value is higher priority. After first build it's inferred from the number of milliseconds the build took

	BuildPriority 2000
	{
		&
		{
			Target.BuildPriority undefined
			Target.Type "Tool"
		}
	}

	GenerateScheme: bool

	GenerateScheme MalterlibGenerateScheme
	{
		&
		{
			!MalterlibGenerateScheme false
			Target.GenerateScheme undefined
			|
			{
				MalterlibAllSchemes true
				|
				{
					!Target.LocalDebuggerCommand undefined
					!Target.RemoteDebuggerCommand undefined
				}
			}
		}
	}

	GenerateScheme false
	{
		!!Target.GenerateScheme undefined
	}
}

Target
{
	!!GeneratorFamily "Xcode"

	EnableModuleDebugging: bool?
	EnableModuleDebugging false
