	OnlyActiveArchitectures: bool = true
	NativeArchitecture: string = MalterlibXcodeBuildArchitecture
	NativeArchitectureActual: string = MalterlibXcodeBuildArchitecture
}

Property
{
	MalterlibSupportAtos: bool = false // User(Debug)=true: Enable dsym symbols to support file and line tracing with atos
}

// macOS
Target
{
	&
	{
		LanguageFamily "Native"
		PlatformFamily "macOS"
		!Target.Type "Tool"
	}
	ObjcLinkRuntime false

	DebugInformationFormat "dwarf"
	DebugInformationFormat "dwarf-with-dsym"
	{
		|
		{
			MalterlibDeploySymbols true
			MalterlibSupportAtos true
			Target.Type "Driver"
			&
			{
				MalterlibBuildServerTest true
				|
				{
					MalterlibMainTest true
					MalterlibHelperTest true
				}
			}
		}
	}

	ValidArchitectures MalterlibXcodeBuildArchitecture

	Architectures MalterlibXcodeBuildArchitecture

	SupportedPlatforms "macosx"
	SupportedPlatforms "driverkit"
	{
		!!Target.Type "Driver"
	}
}

// iOS
Target
{
	&
	{
		LanguageFamily "Native"
		PlatformFamily "iOS"
		!Target.Type "Tool"
	}
	ObjcLinkRuntime false

	DebugInformationFormat "dwarf"
	DebugInformationFormat "dwarf-with-dsym"
	{
		|
		{
			MalterlibDeploySymbols true
			Target.Type "Driver"
			&
			{
				MalterlibBuildServerTest true
				|
				{
					MalterlibMainTest true
					MalterlibHelperTest true
				}
			}
		}
	}

	ValidArchitectures MalterlibXcodeBuildArchitecture
	Architectures MalterlibXcodeBuildArchitecture

	SupportedPlatforms "iphonesimulator iphoneos"
	OnlyActiveArchitectures true
	NativeArchitecture MalterlibXcodeBuildArchitecture
	NativeArchitectureActual MalterlibXcodeBuildArchitecture
}

