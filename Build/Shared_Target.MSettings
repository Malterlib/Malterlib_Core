					"MTool BuildServerTool Tool=ZMTool \"ProtectedDirs=$BrekapadOutputPath\" DiffCopy \"@(MalterlibFinalModuleDestination).dSYM.breakpad.zip\" \"$BrekapadOutputPath\" \"\" 0\r\n"
	{
