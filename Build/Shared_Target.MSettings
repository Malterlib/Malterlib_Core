// Post build step

Property
{
	MalterlibOriginalModuleDestinationExpLib: string = `@(MalterlibOriginalModuleDestination->GetPath())/@(MalterlibOriginalModuleDestination->GetFileNoExt()).exp`
	MalterlibOriginalModuleDestinationLib: string = `@(MalterlibOriginalModuleDestination->GetPath())/@(MalterlibOriginalModuleDestination->GetFileNoExt()).lib`
}

Property
{
	TarOptions: string = ""
	TarOptions "--disable-copyfile"
	{
		!!HostPlatformFamily "macOS"
	}
}

Property
{
	MalterlibDumpSymsCommand: string = "dump_syms"
	MalterlibPostBuildScriptShowEnv: bool = false // User(Build System)=true: Enable to show the environment variables of the build environment
}

Type
{
	CFileCopyOptionsDetailed: {
		Pattern: string
		, Destination?: string = ""
		, Recursive?: bool = false
		, FindDirectory?: bool = false
		, AbsoluteDestination?: bool = false
		, NoInput?: bool = false
	}
	// Recursive			Source ^
	// FindDirectory		Source ~
	// AbsoluteDestination	Destination ~

	CFileCopyOptions: one_of(string, type(CFileCopyOptionsDetailed))
}

Property
{
	fg_ExpandCopyOptionsHelper function(type(CFileCopyOptions) _CopyOptions) [type(CFileCopyOptionsDetailed)] = []
	fg_ExpandCopyOptionsHelper =+ _CopyOptions
	{
		!true _CopyOptions->IsString()
	}
	fg_ExpandCopyOptionsHelper =+ {Pattern: _CopyOptions}
	{
		!!true _CopyOptions->IsString()
	}

	fg_ExpandCopyOptions function([type(CFileCopyOptions)] _CopyOptions) [type(CFileCopyOptionsDetailed)]
	fg_ExpandCopyOptions _CopyOptions->ForEach(&fg_ExpandCopyOptionsHelper)

	f_AddDestinationPrefixToCopyOptions_AppendDestination function(type(CFileCopyOptionsDetailed) _Options) type(CFileCopyOptionsDetailed)
	f_AddDestinationPrefixToCopyOptions_AppendDestination _Options
	f_AddDestinationPrefixToCopyOptions_AppendDestination =+ {Destination: DestinationPrefix / _Options<Destination>}
	{
		!!_Options->HasMember("Destination") true
	}
	f_AddDestinationPrefixToCopyOptions_AppendDestination =+ {Destination: _Options<Destination>}
	{
		!_Options->HasMember("Destination") true
	}

	f_AddDestinationPrefixToCopyOptions_AddDestination function(type(CFileCopyOptionsDetailed) _Options) [type(CFileCopyOptionsDetailed)] = []
	f_AddDestinationPrefixToCopyOptions_AddDestination =+ f_AddDestinationPrefixToCopyOptions_AppendDestination(_Options)

	f_AddDestinationPrefixToCopyOptions function([type(CFileCopyOptions)] _Options, string _DestinationPrefix) [type(CFileCopyOptions)] = []

	f_AddDestinationPrefixToCopyOptions _Options->fg_ExpandCopyOptions()->ForEach(&f_AddDestinationPrefixToCopyOptions_AddDestination, {DestinationPrefix: _DestinationPrefix})
}

Property
{
	MalterlibBuildServerPutSources: [type(CFileCopyOptions)] = []
	MalterlibBuildServerPutSources =+ MalterlibFinalModuleDestination
	{
		!Target.Type "Tool"
	}
	MalterlibBuildServerPutSources =+ MalterlibOverrideMallocLibrary
	{
		&
		{
			MalterlibNeedsMallocOverrideLibrary true
			!MalterlibIsMacOSBundle true
		}
	}
	MalterlibBuildServerPutSources =+ MalterlibHelperExecutable
	{
		&
		{
			MalterlibNeedsMalterlibHelper true
			!MalterlibIsMacOSBundle true
		}
	}
	MalterlibBuildServerPutSources =+ MalterlibLLVMSanitizerRuntime
	{
		&
		{
			MalterlibNeedsLLVMSanitizerRuntime true
			!MalterlibIsMacOSBundle true
		}
	}

	MalterlibBuildServerPutPath: one_of(string, [string])?

	MalterlibBuildServerPutPathUploadTemplateCopyOptions: type(CFileCopyOptionsDetailed)

	MalterlibBuildServerPutPathUploadTemplate function(string _DestinationDir) [string] = []
	MalterlibBuildServerPutPathUploadTemplate Error("FindDirectory not supported for build server put")
	{
		!!true _CopyOptions<FindDirectory>
	}
	MalterlibBuildServerPutPathUploadTemplate Error("Turning on AbsoluteDestination is not supported for build server put")
	{
		!!true _CopyOptions<AbsoluteDestination>
	}
	MalterlibBuildServerPutPathUploadTemplate =+ _DestinationDir / MalterlibBuildServerPutPathUploadTemplateCopyOptions<Destination>

	MalterlibBuildServerPutPathUploadDestinationDirs function(type(CFileCopyOptionsDetailed) _CopyOptions) string
	MalterlibBuildServerPutPathUploadDestinationDirs MalterlibBuildServerPutPath->f_ToStringArray()->ForEach(&MalterlibBuildServerPutPathUploadTemplate, {MalterlibBuildServerPutPathUploadTemplateCopyOptions: _CopyOptions})->Join(";")

	MalterlibBuildServerPutPathUploadTemplateOuter function(type(CFileCopyOptionsDetailed) _CopyOptions) string = ""
	MalterlibBuildServerPutPathUploadTemplateOuter =+ `@(MalterlibBuildServerCommandPrefix)MTool BuildServerPut Recursive=@(_CopyOptions<Recursive> ? "1" : "0") @(`Source=@(_CopyOptions<Pattern>)`->f_ScriptEscapeString()) @(`DestinationDir=@(MalterlibBuildServerPutPathUploadDestinationDirs(_CopyOptions))`->f_ScriptEscapeString())\r\n`

	MalterlibBuildServerPutPathUploadContents: string
	MalterlibBuildServerPutPathUploadContents =+ fg_ExpandCopyOptions(MalterlibBuildServerPutSources)->ForEach(&MalterlibBuildServerPutPathUploadTemplateOuter)


	MalterlibTestPutSources: [type(CFileCopyOptions)]

	MalterlibTestPutSources =+ {Pattern: MalterlibFinalModuleDestination}
	MalterlibTestPutSources =+ {Pattern: Target:Target.SymbolFile}
	{
		&
		{
			!Target:Target.SymbolFile undefined
			PlatformFamily "Windows"
		}
	}

	MalterlibTestPutSources =+ {Pattern: `@(MalterlibOriginalModuleDestination).dSYM`}
	{
		&
		{
			PlatformIsDarwin true
			TargetIsExecutable true
			Target.DebugInformationFormat "dwarf-with-dsym"
		}
	}

	MalterlibTestPutPathUploadTemplate function(type(CFileCopyOptionsDetailed) _CopyOptions) string
	MalterlibTestPutPathUploadTemplate Error("FindDirectory not supported for test upload")
	{
		!!true _CopyOptions<FindDirectory>
	}
	MalterlibTestPutPathUploadTemplate Error("Turning on AbsoluteDestination is not supported for test upload")
	{
		!!true _CopyOptions<AbsoluteDestination>
	}
	MalterlibTestPutPathUploadTemplate Error("Turning on Recursive is not supported for test upload")
	{
		!!true _CopyOptions<Recursive>
	}
	MalterlibTestPutPathUploadTemplate =+	`@(MalterlibBuildServerCommandPrefix)MTool BuildServerPut Recursive=0 @(`Source=@(_CopyOptions<Pattern>)`->Escape()) @(`DestinationDir=@(MalterlibTestPutPath)@(_CopyOptions<Destination>)`->Escape())\r\n`
	{
		!MalterlibAutoBuild true
	}

	// AB Copy
	MalterlibTestPutPathUploadTemplate =+	`echo @(ScriptMkDir(`@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(_CopyOptions<Destination>)`))\r\n`\
											`@(ScriptMkDir(`@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(_CopyOptions<Destination>)`))\r\n`\
											`echo cp -fr @(_CopyOptions<Pattern>->Escape()) @(`@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(_CopyOptions<Destination>)/`->Escape())\r\n`\
											`cp -fr @(_CopyOptions<Pattern>->Escape()) @(`@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(_CopyOptions<Destination>)/`->Escape())\r\n`
	{
		&
		{
			!PlatformFamily "Windows"
			MalterlibAutoBuild true
		}
	}

	MalterlibTestPutPathUploadTemplate =+	`echo mkdir @(`@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(_CopyOptions<Destination>)`->Escape())\r\n`\
											`mkdir @(`@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(_CopyOptions<Destination>)`->Escape())\r\n`\
											`echo MTool DiffCopy @(_CopyOptions<Pattern>->Escape()) @(`@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(_CopyOptions<Destination>)`->Escape())\r\n`\
											`MTool DiffCopy @(_CopyOptions<Pattern>->Escape()) @(`@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(_CopyOptions<Destination>)`->Escape())\r\n`
	{
		&
		{
			PlatformFamily "Windows"
			MalterlibAutoBuild true
		}
	}

	MalterlibTestPutPathUploadContents: string = ""
	MalterlibTestPutPathUploadContents =+ MalterlibTestPutSources->ForEach(&MalterlibTestPutPathUploadTemplate)

	MalterlibTestPutPath: string?
	MalterlibTestPutPath `Test/@(Workspace:Workspace.Name)/@(Platform)/@(Architecture)/@(FullConfiguration)`
	{
		&
		{
			MalterlibTestPutPath undefined
			|
			{
				MalterlibMainTest true
				MalterlibHelperTest true
			}
		}
	}

	MalterlibTestPutSources =+ {Pattern: `@(MalterlibFinalModuleDestination).MainTest`}
	{
		!!MalterlibMainTest true
	}

	Win32SignTool: string
	Win32SignTool `@(MalterlibBuildServerCommandPrefix)MTool BuildServerTool Tool=SignToolWin32`
	{
		&
		{
			Win32SignTool undefined
			MalterlibBuildServerBuild true
		}
	}

	Win32SignTool "SignTool.exe"
	{
		!!Win32SignTool undefined
	}

	Win32SignToolTimestampServerOptions: string
	Win32SignToolTimestampServerOptions `/td SHA256 /tr @(MalterlibSignTimestampServerRFC3161)`
	{
		!MalterlibSignTimestampServerRFC3161 ""
	}
	Win32SignToolTimestampServerOptions `/t @(MalterlibSignTimestampServer)`
	{
		!!Win32SignToolTimestampServerOptions undefined
	}

	MalterlibWindowsSignCommandLine: string
	MalterlibWindowsSignCommandLine `MSYS_NO_PATHCONV=1 @(Win32SignTool) sign /fd SHA256 /ac @(MalterlibSignIncludeCert->WindowsPath()->Escape()) /n @(MalterlibSignCertWindows->Escape()) @(Win32SignToolTimestampServerOptions) @(MalterlibFinalModuleDestination->WindowsPath()->Escape())`

	MalterlibWindowsSignCommandLine `MSYS_NO_PATHCONV=1 @(Win32SignTool) sign /fd SHA256 /n @(MalterlibSignCertWindows->Escape()) @(Win32SignToolTimestampServerOptions) @(MalterlibFinalModuleDestination->WindowsPath()->Escape())`
	{
		!!MalterlibSignIncludeCert "none"
	}

	MalterlibSignMacOSDeep: bool = true

	MalterlibSignMacOSHardened: bool?

	MalterlibCodeSignMacOSExtraOptions: string = ""
	MalterlibCodeSignMacOSExtraOptions += "--options runtime "
	{
		|
		{
			!MalterlibNotarizeMacOSProfile undefined
			MalterlibSignMacOSHardened true
		}
	}

	MalterlibCodeSignMacOSExtraOptions += "--deep "
	{
		!!MalterlibSignMacOSDeep true
	}

	MalterlibSignMacOSEntitlements: string?

	MalterlibForNotarization: bool = (MalterlibNotarizeMacOSProfile <!=> undefined)

	MalterlibSignMacOSEntitlements "../Resources/macOS/Default.entitlements"->MakeAbsolute()
	{
		&
		{
			MalterlibSignMacOSEntitlements undefined
			!MalterlibForNotarization true
		}
	}

	MalterlibCodeSignMacOSExtraOptions += `--entitlements @(MalterlibSignMacOSEntitlements->Escape()) `
	{
		!MalterlibSignMacOSEntitlements undefined
	}

	MalterlibCodeSignMacOSCommand: string
	MalterlibCodeSignMacOSCommand `@(MalterlibBuildServerCommandPrefix)MTool BuildServerTool Tool=CodeSignMacOS`
	{
		!!MalterlibBuildServerBuild true
	}

	MalterlibCodeSignMacOSCommand "codesign"
	{
		!MalterlibBuildServerBuild true
	}

	MalterlibNotaryToolMacOSCommand: string
	MalterlibNotaryToolMacOSCommand `@(MalterlibBuildServerCommandPrefix)MTool BuildServerTool Tool=NotaryToolMacOS`
	{
		!!MalterlibBuildServerBuild true
	}

	MalterlibNotaryToolMacOSCommand "xcrun notarytool"
	{
		!MalterlibBuildServerBuild true
	}

	MalterlibStaplerMacOSCommand: string
	MalterlibStaplerMacOSCommand `@(MalterlibBuildServerCommandPrefix)MTool BuildServerTool Tool=StaplerMacOS`
	{
		!!MalterlibBuildServerBuild true
	}

	MalterlibStaplerMacOSCommand "xcrun stapler"
	{
		!MalterlibBuildServerBuild true
	}
}

Property
{
	PreBuildScriptDependenciesTemplate function(string _Dependency) [string] = []
	PreBuildScriptDependenciesTemplate =+ &Target.DependencyFile->GetProperty(_Dependency)

	PreBuildScriptDependencies: [string] = []
	PreBuildScriptDependencies =+ Target.DependencyTargets->ForEach(&PreBuildScriptDependenciesTemplate)
	{
		!GeneratorFamily "Ninja"
	}

	MaybeGetPreBuildDependency: one_of(string, [string]) = []
	MaybeGetPreBuildDependency &Target.DependencyFile->GetProperty(Dependency.TargetPropertyPath)
	{
		&
		{
			!Dependency.IndirectEvaluated true
			Dependency.Stage "Compile"
		}
	}

	f_GetPreBuildDependencies function(string _Dependency) [string] = []
	f_GetPreBuildDependencies =+ &MaybeGetPreBuildDependency->GetProperty(_Dependency)

	PreBuildScriptDependencies =+ Target.Dependencies->ForEach(&f_GetPreBuildDependencies)
	{
		!!GeneratorFamily "Ninja"
	}

	PreBuildOutputFile: string = `@(Target.IntermediateDirectory)PreBuildOutput.h`
}

Target
{
	PreBuildScript: string = ""
	PreBuildScript += "set -eo pipefail\r\n"
	{
		|
		{
			PlatformType "Unix"
			GeneratorFamily "Ninja"
		}
	}
}

Target
{
	|
	{
		GeneratorFamily "Xcode"
		GeneratorFamily "Ninja"
	}

	PreBuildScriptInputs =+ Builtin.MToolExe
	PreBuildScriptInputs =+ PreBuildScriptDependencies
	PreBuildScriptOutputs =+ PreBuildOutputFile
	PreBuildScript =+	`@(Builtin.MToolExe->Escape()) CheckDependencies @(`Directory=@(Target.IntermediateDirectory)MalterlibDependencies`->Escape())\n`\
						`if [ "$?" != "0" ]; then\n`\
						`  echo error: Dependency checking failed\n`\
						`  exit 1\n`\
						`fi\n`

	PreBuildScript =+	`MTool CopyWriteTime @(Target.PreBuildScriptInputs<[0]>->Escape()) @(PreBuildOutputFile->Escape()) @(Target.PreBuildScriptInputs->Slice(1)->JoinEscaped(" "))\n`
	{
		!Target.PreBuildScriptInputs []
	}

	PreBuildScript =+	`MTool CreateFile @(PreBuildOutputFile->Escape())\n`
	{
		!!Target.PreBuildScriptInputs []
	}
}

Property
{
	MalterlibExecutableInput: string? = MalterlibOriginalModuleDestinationExecutable

	MalterlibPostBuildScriptInputs: [string] = []
	MalterlibPostBuildScriptInputs =+ MalterlibExecutableInput
	{
		!MalterlibExecutableInput undefined
	}

	MalterlibPostBuildScriptInputs =+ Target.CommandLine_Outputs
	{
		&
		{
			Target.Type "Tool"
			!Target.CommandLine_Outputs undefined
		}
	}

	MalterlibPostBuildScriptInputs =+ MalterlibPostCopyConfigFile
	{
		&
		{
			!MalterlibBuildServerBuild true
			|
			{
				!MalterlibPostCopyContents undefined
				!MalterlibPostCopyContents2 undefined
			}
		}
	}

	f_ExtractPlainFilesFromCopyOptions function(type(CFileCopyOptionsDetailed) _CopyOptions) [string] = []
	f_ExtractPlainFilesFromCopyOptions =+ _CopyOptions<Pattern>
	{
		&
		{
			!_CopyOptions<NoInput> true // Manualy disabled
			!_CopyOptions<Pattern>->Find("*") true // Don't support wildcards
		}
	}

	MalterlibPostBuildScriptInputs =+ fg_ExpandCopyOptions(MalterlibPostCopySources)->ForEach(&f_ExtractPlainFilesFromCopyOptions)
	{
		&
		{
			!MalterlibBuildServerBuild true
			|
			{
				!MalterlibPostCopyContents undefined
				!MalterlibPostCopyContents2 undefined
			}
		}
	}

	MalterlibPostBuildScriptInputs =+ fg_ExpandCopyOptions(MalterlibBuildServerPutSources)->ForEach(&f_ExtractPlainFilesFromCopyOptions)
	{
		&
		{
			!MalterlibBuildServerPutPath undefined
			MalterlibBuildServerBuild true
			!MalterlibBuildServerTest true
			!MalterlibBuildServerPutDisabled true
		}
	}

	MalterlibPostBuildScriptInputsInternalTemplate function(string _Input) [string] = []
	MalterlibPostBuildScriptInputsInternalTemplate =+ _Input
	{
		|
		{
			&
			{
				!_Input MalterlibFinalModuleDestinationExecutable
				!_Input MalterlibFinalModuleDestination
			}
			&
			{
				MalterlibFinalModuleDestinationExecutable MalterlibOriginalModuleDestinationExecutable
				MalterlibFinalModuleDestination MalterlibOriginalModuleDestination
			}
		}
	}
	MalterlibPostBuildScriptInputsContents: [string] = MalterlibPostBuildScriptInputs->ForEach(&MalterlibPostBuildScriptInputsInternalTemplate)

	PostBuildOutputfile: string?
	PostBuildOutputfile `@(Target.IntermediateDirectory)PostBuildOutput.h`
	{
		!!Target:Target.DependencyFile undefined
	}
}

Property
{
	f_CalculateTargetFilePostBuildImplicitInputs function(string _File) [string] = []
	f_CalculateTargetFilePostBuildImplicitInputs =+ &Compile.PostBuildImplicitInputs->GetProperty(_File)
}

Target
{
	|
	{
		GeneratorFamily "Xcode"
		GeneratorFamily "Ninja"
	}


	PostBuildScriptInputs MalterlibPostBuildScriptInputsContents
	PostBuildScriptInputs =+ Target.AllFiles_Custom->ForEach(&f_CalculateTargetFilePostBuildImplicitInputs)
	{
		&
		{
			GeneratorFamily "Ninja"
			Target.Type "Tool"
		}
	}

	PostBuildScriptOutputs += PostBuildOutputfile
	{
		!PostBuildOutputfile undefined
	}
	PostBuildScriptOutputs += Target:Target.DependencyFile
	{
		!Target:Target.DependencyFile undefined
	}

	PostBuildScriptOutputs += MalterlibFinalModuleDestinationExecutable
	{
		&
		{
			!MalterlibFinalModuleDestinationExecutable MalterlibOriginalModuleDestinationExecutable
			!Target.Type "Tool"
		}
	}

	PostBuildScriptOutputs += MalterlibFinalModuleDestination
	{
		&
		{
			MalterlibIsMacOSBundle true
			!MalterlibFinalModuleDestination MalterlibFinalModuleDestinationExecutable
		}
	}

	PostBuildScriptOutputs += [`@(MalterlibOriginalModuleDestination).dSYM`, `@(MalterlibOriginalModuleDestination).dSYM/Contents/Resources/DWARF/@(Target:Target.FileName)`]
	{
		&
		{
			PlatformIsDarwin true
			!GeneratorFamily "Xcode"
			Target.DebugInformationFormat "dwarf-with-dsym"
			TargetIsExecutable true
		}
	}

	// Ninja .NET 5+: csc writes <Int>/<base>.dll (declared as the link rule's
	// output via the MalterlibOriginalModuleDestinationExecutable override),
	// PostBuild's MTool BuildAppHost step produces the canonical
	// MalterlibOriginalModuleDestination (Out/<base>.exe). Declare it as a
	// PostBuild output so ninja knows where the apphost comes from.
	PostBuildScriptOutputs += MalterlibOriginalModuleDestination
	{
		!MalterlibNinjaCSharpDllPath undefined
	}

	// Non-single-file Ninja .NET 5+: PostBuild also DiffCopies the managed .dll
	// from <Int>/ into <Out>/Deployed/ alongside the apphost .exe, so declare
	// that as an output too. Skipped when SingleFile is on (the .dll is
	// embedded inside the apphost and never lands in Deployed/).
	PostBuildScriptOutputs += MalterlibFinalModuleDestinationPath / `@(MalterlibFinalModuleDestination->GetFileNoExt()).dll`
	{
		&
		{
			!MalterlibNinjaCSharpDllPath undefined
			!MalterlibFinalModuleDestination MalterlibOriginalModuleDestination
			!DisableDiffCopy true
			!MalterlibNinjaCSharpSingleFile true
		}
	}

	PostBuildScriptOutputs += `@(MalterlibFinalModuleDestinationPath)/@(Target:Target.BaseFileName).cat`
	{
		&
		{
			PlatformType "Windows"
			Target.Type "Driver"
			!MalterlibDriverINFFile undefined
		}
	}
}

Property
{
	MalterlibPostCopySources: [type(CFileCopyOptions)] = []
	MalterlibPostCopySources =+ MalterlibFinalModuleDestination
	{
		!Target.Type "Tool" // Tool has no default executable
	}

	MalterlibPostCopySources =+ `@(MalterlibOriginalModuleDestination).dSYM`
	{
		&
		{
			IsDefined("Target.DebugInformationFormat") true
			Target.DebugInformationFormat "dwarf-with-dsym"
		}
	}

	MalterlibPostCopySources =+ MalterlibLinuxDesktopFile
	{
		&
		{
			!MalterlibLinuxDesktopFile undefined
		}
	}
	MalterlibPostCopySources =+ MalterlibExeIcon
	{
		&
		{
			!MalterlibLinuxDesktopFile undefined
			!MalterlibExeIcon undefined
		}
	}

	MalterlibPostCopySources =+ MalterlibOverrideMallocLibrary
	{
		&
		{
			MalterlibNeedsMallocOverrideLibrary true
			!MalterlibIsMacOSBundle true
		}
	}

	MalterlibPostCopySources =+ MalterlibHelperExecutable
	{
		&
		{
			MalterlibNeedsMalterlibHelper true
			!MalterlibIsMacOSBundle true
		}
	}
	MalterlibPostCopySources =+ `@(MalterlibFinalModuleDestinationPath)/@(Target:Target.BaseFileName).cat`
	{
		&
		{
			PlatformType "Windows"
			Target.Type "Driver"
			!MalterlibDriverINFFile undefined
		}
	}

	// .NET 5+ executables need the runtimeconfig.json deployed alongside the .exe.
	// The file is generated into GeneratedDirectory by %GenerateFile "Generate .NET runtimeconfig.json"
	// and copied to the deploy location here. Skipped in Ninja+SingleFile mode
	// where the runtimeconfig.json is embedded in the apphost bundle.
	MalterlibPostCopySources =+ `@(GeneratedDirectory)@(MalterlibFinalModuleDestination->GetFileNoExt()).runtimeconfig.json`
	{
		&
		{
			Target.CLRSupport "NetCore"
			TargetIsLaunchableExecutable true
			!MalterlibNinjaCSharpSingleFile true
		}
	}

	// Ninja's C# pipeline drives csc.exe directly, so unlike MSBuild it doesn't
	// produce the apphost shim that .NET 5+ executables need on Windows. We rename
	// csc's .exe output to .dll and generate the apphost in PostBuild (see below),
	// so the managed assembly must also be deployed alongside the apphost .exe.
	// NoInput because the .dll is produced by the PostBuild step itself — pulling
	// it into PostBuildScriptInputs via f_ExtractPlainFilesFromCopyOptions would
	// make Ninja see a cycle (output depends on itself).
	// Skipped in SingleFile mode where the .dll is embedded in the apphost bundle.
	MalterlibPostCopySources =+ {
		Pattern: MalterlibFinalModuleDestinationPath / `@(MalterlibFinalModuleDestination->GetFileNoExt()).dll`
		, NoInput: true
	}
	{
		&
		{
			GeneratorFamily "Ninja"
			Target.Language "C#"
			Target.CLRSupport "NetCore"
			TargetIsLaunchableExecutable true
			!MalterlibNinjaCSharpSingleFile true
		}
	}

	// Mixed-mode C++/CLI assemblies built with /clr:netcore link against ijwhost.dll
	// (the .NET 5+ "It Just Works" host that bridges into hostfxr). Unlike Framework
	// /clr which goes through mscoree, NetCore /clr requires ijwhost.dll to be
	// resolvable at load time — the simplest fix is to deploy it next to the assembly.
	// MSBuild handles this for VS-driven C++/CLI projects; with Ninja we copy it ourselves.
	MalterlibPostCopySources =+ f_MalterlibDotNetAppHostNativePath(Target.TargetFrameworkVersion->Extract(3)) / "ijwhost.dll"
	{
		&
		{
			GeneratorFamily "Ninja"
			LanguageFamily "Native"
			Target.CLRSupport "NetCore"
			|
			{
				Target.Type "DynamicLibrary"
				Target.Type "SharedDynamicLibrary"
			}
			!f_MalterlibDotNetAppHostNativePath(Target.TargetFrameworkVersion->Extract(3)) undefined
		}
	}

	MalterlibPostCopySources =+ MalterlibLLVMSanitizerRuntime
	{
		&
		{
			MalterlibNeedsLLVMSanitizerRuntime true
			!MalterlibIsMacOSBundle true
		}
	}

	MalterlibPostCopyConfigFile: string = `@(Builtin.GeneratedBuildSystemDir)/PostCopy.MConfig`

	MalterlibPostCopyInternalTemplate function(type(CFileCopyOptionsDetailed) _CopyOptions) string = ""
	MalterlibPostCopyInternalTemplate Error("Turning on AbsoluteDestination is not supported for post copy")
	{
		!!true _CopyOptions<AbsoluteDestination>
	}
	MalterlibPostCopyInternalTemplate =+	`MTool PostCopy @(`@(_CopyOptions<Pattern>)`->f_ScriptNativeEscapedPath()) @(`Config=@(MalterlibPostCopyConfigFile)`->f_ScriptEscapeString()) @(`Project=@(MalterlibCalculatedPostCopyProject)`->f_ScriptEscapeString()) @(`OutFolder=@(MalterlibPostCopyDestination / _CopyOptions<Destination>)`->f_ScriptEscapeString()) Hash=@(MalterlibPostCopyHash->ToString()) FindDirectory=@(_CopyOptions<FindDirectory>->ToString()) Recursive=@(_CopyOptions<Recursive>->ToString())\r\n`

	MalterlibPostCopyContents: string?
	MalterlibPostCopyContents fg_ExpandCopyOptions(MalterlibPostCopySources)->ForEach(&MalterlibPostCopyInternalTemplate)
	{
		&
		{
			!MalterlibCalculatedPostCopyProject undefined
			!DisablePostCopy true
		}
	}

	MalterlibPostCopyContents2: string?
	MalterlibPostCopyContents2 fg_ExpandCopyOptions(MalterlibPostCopySources)->ForEach(&MalterlibPostCopyInternalTemplate, {MalterlibCalculatedPostCopyProject: MalterlibCalculatedPostCopyProject2, MalterlibPostCopyDestination: MalterlibPostCopyDestination2, MalterlibPostCopyHash: MalterlibPostCopyHash2})
	{
		&
		{
			!MalterlibCalculatedPostCopyProject2 undefined
			!DisablePostCopy true
		}
	}
}

Property
{
	MalterlibPostBuildScript_Last: string?
	MalterlibTestDeployPath: string?
	MalterlibExtraPostBuildScript: string?
	MalterlibStripSymbols: bool?
}

Property
{
	MalterlibPostBuildScriptInputs =+ `@(MalterlibOriginalModuleDestination).dSYM/Contents/Resources/DWARF/@(Target:Target.FileName)`
	{
		&
		{
			PlatformIsDarwin true
			Target.DebugInformationFormat "dwarf-with-dsym"
			GeneratorFamily "Xcode"
		}
	}

	MalterlibPostBuildScriptInputs =+ MalterlibDriverINFFile
	{
		!MalterlibDriverINFFile undefined
	}

	// In SingleFile mode the runtimeconfig.json is consumed by MTool BuildAppHost
	// (embedded in the apphost bundle) rather than deployed as a sibling, so it
	// no longer reaches PostBuildScriptInputs via PostCopySources. Add it
	// explicitly so PostBuild reruns when the template's runtimeconfig changes.
	MalterlibPostBuildScriptInputs =+ MalterlibNinjaCSharpRuntimeConfigPath
	{
		&
		{
			!MalterlibNinjaCSharpRuntimeConfigPath undefined
			MalterlibNinjaCSharpSingleFile true
		}
	}

	// Track the apphost.exe template too: when the .NET SDK is updated and a
	// newer apphost ships, the PostBuild step needs to rerun so the launcher
	// inherits the new bytes.
	MalterlibPostBuildScriptInputs =+ MalterlibNinjaCSharpAppHostTemplate
	{
		!MalterlibNinjaCSharpAppHostTemplate undefined
	}
}

// Ninja-only helpers for .NET 5+ launchable executables. csc.exe doesn't produce
// the native apphost shim that lets .NET Core/5+ EXEs boot under hostfxr — we
// replicate that step in PostBuild. These properties stay undefined for any other
// generator/language/CLR combination so the rest of the build is unaffected.
Property
{
	// csc's output path: <Int>/<base>.dll. This is what
	// MalterlibOriginalModuleDestinationExecutable resolves to for NetCore C#
	// launchables on Ninja (overridden above) — the link rule writes the
	// managed assembly here, PostBuild reads it and produces the apphost .exe
	// at MalterlibOriginalModuleDestination. Two distinct paths means PostBuild
	// can't ever overwrite csc's output with apphost bytes.
	MalterlibNinjaCSharpDllPath: string?
	MalterlibNinjaCSharpDllPath MalterlibOriginalModuleDestinationExecutable
	{
		&
		{
			GeneratorFamily "Ninja"
			Target.Language "C#"
			Target.CLRSupport "NetCore"
			TargetIsLaunchableExecutable true
		}
	}

	// apphost.exe shipped in the Microsoft.NETCore.App.Host.win-<arch> pack matching
	// Target.TargetFrameworkVersion (e.g. "net8.0" → 8.0). f_MalterlibDotNetAppHostNativePath
	// is gated on Windows + a discovered .NET install, so this stays undefined when
	// either is missing and the PostBuild apphost step short-circuits.
	MalterlibNinjaCSharpAppHostTemplate: string?
	MalterlibNinjaCSharpAppHostTemplate f_MalterlibDotNetAppHostNativePath(Target.TargetFrameworkVersion->Extract(3)) / "apphost.exe"
	{
		&
		{
			!MalterlibNinjaCSharpDllPath undefined
			!f_MalterlibDotNetAppHostNativePath(Target.TargetFrameworkVersion->Extract(3)) undefined
		}
	}

	// winexe targets need the apphost's PE Subsystem field flipped from Console (3)
	// to Windows GUI (2) so launching doesn't pop up a console window.
	MalterlibNinjaCSharpAppHostSubsystemGUI: bool = false
	MalterlibNinjaCSharpAppHostSubsystemGUI true
	{
		&
		{
			!MalterlibNinjaCSharpDllPath undefined
			|
			{
				Target.Type "Executable"
				Target.Type "UIExecutable"
			}
		}
	}

	// Single-file mode: append a .NET 8 bundle (format v6) to the apphost so the
	// managed assembly and runtimeconfig.json are embedded in the .exe. The
	// runtime prefers the bundle when present, so external sibling files become
	// redundant — we skip deploying them when SingleFile is true.
	// User(Build System): Disable to deploy the .dll and runtimeconfig.json as separate files.
	MalterlibNinjaCSharpSingleFile: bool?
	MalterlibNinjaCSharpSingleFile true
	{
		&
		{
			!MalterlibNinjaCSharpDllPath undefined
			MalterlibNinjaCSharpSingleFile undefined
		}
	}

	// runtimeconfig.json source path — generated by %GenerateFile and consumed
	// by both the deploy (when not single-file) and the bundle.
	MalterlibNinjaCSharpRuntimeConfigPath: string?
	MalterlibNinjaCSharpRuntimeConfigPath `@(GeneratedDirectory)@(MalterlibFinalModuleDestination->GetFileNoExt()).runtimeconfig.json`
	{
		!MalterlibNinjaCSharpDllPath undefined
	}
}

Target
{
	PostBuildScript: string = ""
	PostBuildScript += "set -eo pipefail\r\n"
	{
		|
		{
			PlatformType "Unix"
			GeneratorFamily "Ninja"
		}
	}

	PostBuildScript =+ "env\r\n"
	{
		!!MalterlibPostBuildScriptShowEnv true
	}

/*
	// This breaks the dependency checking in MSBuild
	PostBuildScript =+	`IF EXIST "@(MalterlibOriginalModuleDestinationExpLib->WindowsPath())" del "@(MalterlibOriginalModuleDestinationExpLib->WindowsPath())"\r\n`\
						`IF EXIST "@(MalterlibOriginalModuleDestinationLib->WindowsPath())" del "@(MalterlibOriginalModuleDestinationLib->WindowsPath())"\r\n`
	{
		&
		{
			Target.Type "DynamicLibrary"
			PlatformType "Windows"
			!MalterlibSaveImpLib true
		}
	}
	*/

	// Ninja .NET 5+ apphost generation. csc writes the managed assembly to
	// MalterlibOriginalModuleDestinationExecutable (= <Int>/<base>.dll under
	// the target's intermediate dir; see the override at line ~3580). We then
	// patch a copy of apphost.exe to load that .dll at runtime and write the
	// result to MalterlibOriginalModuleDestination (= Out/<base>.exe). The two
	// paths are in different directories so PostBuild can rerun without ever
	// clobbering csc's output.
	//
	// Target.Type "Executable"/"UIExecutable" map to /target:winexe in
	// Ninja_CSharp.MGeneratorSettings; for those we also flip the apphost's
	// PE Subsystem field to Windows GUI (2). "ConsoleExecutable" stays Console (3).
	//
	// SingleFile mode (default): pass the .dll and runtimeconfig.json as bundle
	// specs so MTool BuildAppHost embeds them in the .exe; nothing else needs
	// to ship. Otherwise the .dll and runtimeconfig.json are deployed as siblings.
	PostBuildScript =+	`MTool BuildAppHost --template @(MalterlibNinjaCSharpAppHostTemplate->Escape()) --output @(MalterlibOriginalModuleDestination->Escape()) --assembly @(MalterlibNinjaCSharpDllPath->GetFile()->Escape())`\
						`@(MalterlibNinjaCSharpAppHostSubsystemGUI ? " --gui" : "")`\
						`@(MalterlibNinjaCSharpSingleFile ? ` --bundle-file @(`@(MalterlibNinjaCSharpDllPath),@(MalterlibNinjaCSharpRuntimeConfigPath)`->Escape())` : "")\r\n`
	{
		&
		{
			!MalterlibNinjaCSharpDllPath undefined
			!MalterlibNinjaCSharpAppHostTemplate undefined
		}
	}

	PostBuildScript =+	`MTool DiffCopy @(MalterlibOriginalModuleDestination->Escape()) @(MalterlibFinalModuleDestinationPath->Escape()) "" 0\r\n`
	{
		&
		{
			!MalterlibFinalModuleDestination MalterlibOriginalModuleDestination
			!DisableDiffCopy true
		}
	}

	// Deploy the managed assembly alongside the apphost .exe (Ninja .NET 5+).
	// Skipped when SingleFile is on — the .dll is embedded inside the .exe.
	PostBuildScript =+	`MTool DiffCopy @(MalterlibNinjaCSharpDllPath->Escape()) @(MalterlibFinalModuleDestinationPath->Escape()) "" 0\r\n`
	{
		&
		{
			!MalterlibNinjaCSharpDllPath undefined
			!MalterlibFinalModuleDestination MalterlibOriginalModuleDestination
			!DisableDiffCopy true
			!MalterlibNinjaCSharpSingleFile true
		}
	}

	// Generate dSYM bundle for non-Xcode builds (Ninja generator)
	PostBuildScript =+	`echo dsymutil @(MalterlibOriginalModuleDestinationExecutable->Escape()) -o @(`@(MalterlibOriginalModuleDestination).dSYM`->Escape())\r\n`\
						`dsymutil @(MalterlibOriginalModuleDestinationExecutable->Escape()) -o @(`@(MalterlibOriginalModuleDestination).dSYM`->Escape())\r\n`
	{
		&
		{
			PlatformIsDarwin true
			!GeneratorFamily "Xcode"
			Target.DebugInformationFormat "dwarf-with-dsym"
			TargetIsExecutable true
		}
	}

	PostBuildScript =+	`MTool DiffCopy @(`@(MalterlibOriginalModuleDestination).dSYM`->Escape()) @(MalterlibFinalModuleDestinationPath->Escape()) "" 0\r\n`
	{
		&
		{
			!MalterlibFinalModuleDestination MalterlibOriginalModuleDestination
			!DisableDiffCopy true
			PlatformIsDarwin true
			Target.DebugInformationFormat "dwarf-with-dsym"
		}
	}

	PostBuildScript =+ `@(MalterlibExtraPostBuildScript)\r\n`
	{
		&
		{
			TargetIsExecutable true
			!MalterlibExtraPostBuildScript undefined
		}
	}

	PostBuildScript =+ `@(MalterlibPostBuildScriptPreSign)\r\n`
	{
		!MalterlibPostBuildScriptPreSign undefined
	}

	PostBuildScript =+ `touch @(MalterlibFinalModuleDestination->Escape())\r\n`
	{
		!!MalterlibIsMacOSBundle true
	}

	// Do this before signing as we want to strip the executable
	PostBuildScript =+ `echo Deploy Symbols:\r\n`\
					`echo @(MalterlibDumpSymsCommand) @(MalterlibFinalModuleDestinationExecutable->Escape()) \\> @(`@(MalterlibFinalModuleDestination).breakpad`->Escape())\r\n`\
					`@(MalterlibDumpSymsCommand) @(MalterlibFinalModuleDestinationExecutable->Escape()) > @(`@(MalterlibFinalModuleDestination).breakpad`->Escape())\r\n`
	{
		&
		{
			|
			{
				PlatformIsDarwin true
				PlatformFamily "Linux"
			}
			TargetIsExecutable true
			MalterlibDeploySymbols true
		}
	}
	PostBuildScript =+	`echo @(MalterlibDumpSymsCommand) @(`@(MalterlibFinalModuleDestination).dSYM`->Escape()) \\> @(`@(MalterlibFinalModuleDestination).dSYM.breakpad`->Escape())\r\n`\
						`@(MalterlibDumpSymsCommand) @(`@(MalterlibFinalModuleDestination).dSYM`->Escape()) > @(`@(MalterlibFinalModuleDestination).dSYM.breakpad`->Escape())\r\n`
	{
		&
		{
			PlatformIsDarwin true
			TargetIsExecutable true
			MalterlibDeploySymbols true
			Target.DebugInformationFormat "dwarf-with-dsym"
		}
	}

	PostBuildScript =+	`echo zip -qj @(MalterlibFinalModuleDestination->Escape()) @(`@(MalterlibFinalModuleDestination).zip`->Escape())\r\n`\
						`rm -f @(`@(MalterlibFinalModuleDestination).zip`->Escape())\r\n`\
						`zip -qj @(`@(MalterlibFinalModuleDestination).zip`->Escape()) @(MalterlibFinalModuleDestination->Escape())\r\n`
	{
		&
		{
			PlatformFamily "Linux"
			TargetIsExecutable true
			MalterlibDeploySymbols true
		}
	}

	PostBuildScript =+	`echo @(MalterlibStripProgram) @(EscapeHost(MalterlibStripOptions...)) @(MalterlibFinalModuleDestinationExecutable->f_ScriptNativeEscapedPath())\r\n`\
						`@(MalterlibStripProgram) @(EscapeHost(MalterlibStripOptions...)) @(MalterlibFinalModuleDestinationExecutable->f_ScriptNativeEscapedPath())\r\n`
	{
		&
		{
			|
			{
				PlatformIsDarwin true
				PlatformFamily "Linux"
			}
			TargetIsExecutable true
			!MalterlibStripSymbols false
			|
			{
				MalterlibDeploySymbols true
				MalterlibStripSymbols true
			}
			|
			{
				!Configuration "Release Testing"
				PlatformFamily "Linux"
			}
		}
	}

	PostBuildScript =+	`echo zip -qj @(`@(MalterlibFinalModuleDestination).breakpad.zip`->Escape()) @(`@(MalterlibFinalModuleDestination).breakpad`->Escape())\r\n`\
						`if [ -f @(`@(MalterlibFinalModuleDestination).breakpad.zip`->Escape()) ]\r\n`\
						`then\r\n`\
						`	rm @(`@(MalterlibFinalModuleDestination).breakpad.zip`->Escape())\r\n`\
						`fi\r\n`\
						`zip -qj @(`@(MalterlibFinalModuleDestination).breakpad.zip`->Escape()) @(`@(MalterlibFinalModuleDestination).breakpad`->Escape())\r\n`\
						`echo MTool SymbolBreakpad "/Temp/SymbolTest" @(`@(MalterlibFinalModuleDestination).breakpad`->Escape())\r\n`\
						`export BrekapadOutputPath=\`MTool SymbolBreakpad @(MalterlibDeploySymbolsPath->Escape()) @(`@(MalterlibFinalModuleDestination).breakpad`->Escape())\`\r\n`\
						`echo Deploying symbols to: $BrekapadOutputPath\r\n`
	{
		&
		{
			|
			{
				PlatformFamily "Linux"
				PlatformIsDarwin true
			}
			TargetIsExecutable true
			MalterlibDeploySymbols true
		}
	}

	PostBuildScript =+	`echo zip -qj "@(MalterlibFinalModuleDestination).dSYM.breakpad" "@(MalterlibFinalModuleDestination).dSYM.breakpad.zip"\r\n`\
						`if [ -f "@(MalterlibFinalModuleDestination).dSYM.breakpad.zip" ]\r\n`\
						`then\r\n`\
						`	rm "@(MalterlibFinalModuleDestination).dSYM.breakpad.zip"\r\n`\
						`fi\r\n`\
						`zip -qj "@(MalterlibFinalModuleDestination).dSYM.breakpad.zip" "@(MalterlibFinalModuleDestination).dSYM.breakpad"\r\n`
	{
		&
		{
			PlatformIsDarwin true
			TargetIsExecutable true
			MalterlibDeploySymbols true
			Target.DebugInformationFormat "dwarf-with-dsym"
		}
	}

	PostBuildScript =+	`echo zip -qj "@(MalterlibFinalModuleDestination).dSYM" "@(MalterlibFinalModuleDestination).dSYM.zip"\r\n`\
						`if [ -f "@(MalterlibFinalModuleDestination).dSYM.zip" ]\r\n`\
						`then\r\n`\
						`	rm "@(MalterlibFinalModuleDestination).dSYM.zip"\r\n`\
						`fi\r\n`\
						`zip -qrj "@(MalterlibFinalModuleDestination).dSYM.zip" "@(MalterlibFinalModuleDestination).dSYM"\r\n`
	{
		&
		{
			PlatformIsDarwin true
			TargetIsExecutable true
			MalterlibDeploySymbols true
			Target.DebugInformationFormat "dwarf-with-dsym"
		}
	}


	PostBuildScript =+	`echo @(MalterlibDeploySymbolsTool("$BrekapadOutputPath")) DiffCopy "@(MalterlibFinalModuleDestination).breakpad.zip" "$BrekapadOutputPath" "" 0\r\n`\
						`@(MalterlibDeploySymbolsTool("$BrekapadOutputPath")) DiffCopy "@(MalterlibFinalModuleDestination).breakpad.zip" "$BrekapadOutputPath" "" 0\r\n`
	{
		&
		{
			|
			{
				PlatformFamily "Linux"
				PlatformIsDarwin true
			}
			TargetIsExecutable true
			MalterlibDeploySymbols true
		}
	}
	PostBuildScript =+	`echo @(MalterlibDeploySymbolsTool("$BrekapadOutputPath")) DiffCopy "@(MalterlibFinalModuleDestination).dSYM.breakpad.zip" "$BrekapadOutputPath" "" 0\r\n`\
						`@(MalterlibDeploySymbolsTool("$BrekapadOutputPath")) DiffCopy "@(MalterlibFinalModuleDestination).dSYM.breakpad.zip" "$BrekapadOutputPath" "" 0\r\n`
	{
		&
		{
			PlatformIsDarwin true
			TargetIsExecutable true
			MalterlibDeploySymbols true
			Target.DebugInformationFormat "dwarf-with-dsym"
		}
	}
	PostBuildScript =+	`echo @(MalterlibDeploySymbolsTool("$BrekapadOutputPath")) DiffCopy "@(MalterlibFinalModuleDestination).dSYM.zip" "$BrekapadOutputPath" "" 0\r\n`\
						`@(MalterlibDeploySymbolsTool("$BrekapadOutputPath")) DiffCopy "@(MalterlibFinalModuleDestination).dSYM.zip" "$BrekapadOutputPath" "" 0\r\n`
	{
		&
		{
			PlatformIsDarwin true
			TargetIsExecutable true
			MalterlibDeploySymbols true
			Target.DebugInformationFormat "dwarf-with-dsym"
		}
	}
	PostBuildScript =+	`echo @(MalterlibDeploySymbolsTool("$BrekapadOutputPath")) DiffCopy "@(MalterlibFinalModuleDestination).zip" "$BrekapadOutputPath" "" 0\r\n`\
						`@(MalterlibDeploySymbolsTool("$BrekapadOutputPath")) DiffCopy "@(MalterlibFinalModuleDestination).zip" "$BrekapadOutputPath" "" 0\r\n`
	{
		&
		{
			PlatformFamily "Linux"
			TargetIsExecutable true
			MalterlibDeploySymbols true
		}
	}


	PostBuildScript =+	`sn -Ra "@(MalterlibFinalModuleDestination->WindowsPath())" "@(MalterlibStronglyNamedAssembly->WindowsPath())"\r\n`
	{
		&
		{
			TargetIsExecutable true
			!MalterlibStronglyNamedAssembly undefined
			PlatformType "Windows"
			!Configuration "Fast Compile"
		}
	}

	// Make sn.exe (and other NETFX SDK tools) findable by the post-build script
	ToolPath =+ MalterlibNETFXSDKToolsPath ?? []
	{
		&
		{
			TargetIsExecutable true
			!MalterlibStronglyNamedAssembly undefined
			PlatformType "Windows"
			!Configuration "Fast Compile"
		}
	}

	CodeSignEntitlements: string?
	CodeSignEntitlements MalterlibSignMacOSEntitlements
	{
		&
		{
			GeneratorFamily "Xcode"
			!MalterlibSignMacOSEntitlements undefined
		}
	}

	LDFlags =+ "-Wl,-no_adhoc_codesign"
	{
		&
		{
			PlatformFamily "macOS"
			!MalterlibDefaultCompiler true
			TargetIsExecutable true
			|
			{
				MalterlibSigning true
				&
				{
					Target.Type "Driver"
					MalterlibDriverSigning true
				}
			}
		}
	}

	PostBuildScript =+	`echo Sign:\r\n`\
						`echo @(MalterlibCodeSignMacOSCommand) --force @(MalterlibCodeSignMacOSExtraOptions) --timestamp --sign @(MalterlibSignCertMacOS->f_ScriptNativeEscapedPath()) @(MalterlibFinalModuleDestination->f_ScriptNativeEscapedPath())\r\n`\
						`@(MalterlibCodeSignMacOSCommand) --force @(MalterlibCodeSignMacOSExtraOptions) --timestamp --sign @(MalterlibSignCertMacOS->f_ScriptNativeEscapedPath()) @(MalterlibFinalModuleDestination->f_ScriptNativeEscapedPath())\r\n`
	{
		&
		{
			PlatformFamily "macOS"
			TargetIsExecutable true
			!DocumentationEnabled true
			|
			{
				MalterlibSigning true
				&
				{
					Target.Type "Driver"
					MalterlibDriverSigning true
				}
			}
		}
	}

	PostBuildScript =+	`echo Notarize:\r\n`\
						`/usr/bin/ditto -c -k --keepParent "@(MalterlibFinalModuleDestination->f_ScriptNativePath())" "@(MalterlibFinalModuleDestination->f_ScriptNativePath()).zip"\r\n`\
						`echo @(MalterlibNotaryToolMacOSCommand) submit "@(MalterlibFinalModuleDestination->f_ScriptNativePath()).zip" --keychain-profile @(MalterlibNotarizeMacOSProfile->EscapeBash()) \r\n`\
						`@(MalterlibNotaryToolMacOSCommand) submit "@(MalterlibFinalModuleDestination->f_ScriptNativePath()).zip" --keychain-profile @(MalterlibNotarizeMacOSProfile->EscapeBash()) 2>&1 | tee "@(MalterlibFinalModuleDestination->f_ScriptNativePath()).log"\r\n`\
						`SubmissionID=\`grep "@(MalterlibFinalModuleDestination->f_ScriptNativePath()).log" -e "id:" | head -n 1 | awk -F 'id: ' '{print $2}'\`\r\n`\
						`echo SubmissionID=$SubmissionID\r\n`\
						`@(MalterlibNotaryToolMacOSCommand) wait "$SubmissionID" --keychain-profile @(MalterlibNotarizeMacOSProfile->EscapeBash())\r\n`\
						`@(MalterlibNotaryToolMacOSCommand) log "$SubmissionID" --keychain-profile @(MalterlibNotarizeMacOSProfile->EscapeBash()) | tee "@(MalterlibFinalModuleDestination->f_ScriptNativePath()).log"\r\n`\
						`if ! grep -q "\\"status\\": \\"Accepted\\"" "@(MalterlibFinalModuleDestination->f_ScriptNativePath()).log"; then\r\n`\
						`	echo "Error: Notarization failed"\r\n`\
						`	exit 1\r\n`\
						`fi\r\n`\
						`echo @(MalterlibStaplerMacOSCommand) staple "@(MalterlibFinalModuleDestination->f_ScriptNativePath())"\r\n`\
						`@(MalterlibStaplerMacOSCommand) staple "@(MalterlibFinalModuleDestination->f_ScriptNativePath())"\r\n`
	{
		&
		{
			PlatformFamily "macOS"
			MalterlibSigning true
			!DocumentationEnabled true
			Target.Type "UIExecutable"
			!MalterlibNotarizeMacOSProfile undefined
		}
	}

	PostBuildScript =+	`echo Sign:\r\n`\
						`echo @(MalterlibWindowsSignCommandLine)\r\n`\
						`@(MalterlibWindowsSignCommandLine)\r\n`
	{
		&
		{
			PlatformType "Windows"
			TargetIsExecutable true
			|
			{
				MalterlibSigning true
				&
				{
					Target.Type "Driver"
					MalterlibDriverSigning true
				}
			}

		}
	}

	PostBuildScript =+	`cp @(MalterlibDriverINFFile->Escape()) @(MalterlibFinalModuleDestinationPath->Escape())\r\n`\
						`echo Inf2Cat:\r\n`\
						`echo MSYS_NO_PATHCONV=1 Inf2Cat.exe /driver:@(MalterlibFinalModuleDestinationPath->WindowsPath()->Escape()) /os:@(MalterlibWindowsInf2CatOS) /uselocaltime\r\n`\
						`MSYS_NO_PATHCONV=1 Inf2Cat.exe /driver:@(MalterlibFinalModuleDestinationPath->WindowsPath()->Escape()) /os:@(MalterlibWindowsInf2CatOS) /uselocaltime\r\n`\
						`echo Sign Catalog:\r\n`\
						`echo MSYS_NO_PATHCONV=1 SignTool.exe sign /fd SHA256 /n @(MalterlibSignCertWindows->Escape()) @(Win32SignToolTimestampServerOptions) @(`@(MalterlibFinalModuleDestinationPath)/@(Target:Target.BaseFileName).cat`->WindowsPath()->Escape())\r\n`\
						`MSYS_NO_PATHCONV=1 SignTool.exe sign /fd SHA256 /n @(MalterlibSignCertWindows->Escape()) @(Win32SignToolTimestampServerOptions) @(`@(MalterlibFinalModuleDestinationPath)/@(Target:Target.BaseFileName).cat`->WindowsPath()->Escape())\r\n`
	{
		&
		{
			PlatformType "Windows"
			Target.Type "Driver"
			MalterlibDriverSigning true
			!MalterlibDriverINFFile undefined
		}
	}

	PostBuildScript =+	`echo Deploy Symbols:\r\n`\
						`echo MSYS_NO_PATHCONV=1 @(MalterlibDeploySymbolsTool(MalterlibDeploySymbolsPath, `@(MalterlibFinalModuleDestination)?@(Target:Target.SymbolFile)`)) Symbol "@(MalterlibDeploySymbolsPath)" "@(MalterlibFinalModuleDestination)"\r\n`\
						`MSYS_NO_PATHCONV=1 @(MalterlibDeploySymbolsTool(MalterlibDeploySymbolsPath, `@(MalterlibFinalModuleDestination)?@(Target:Target.SymbolFile)`)) Symbol "@(MalterlibDeploySymbolsPath)" "@(MalterlibFinalModuleDestination)"\r\n`
	{
		&
		{
			PlatformFamily "Windows"
			TargetIsExecutable true
			MalterlibDeploySymbols true
			!Target:Target.SymbolFile undefined
		}
	}

	PostBuildScript =+	`MTool DiffCopy "@(MalterlibFinalModuleDestination)" "@(MalterlibTestDeployPath)" "" 0\r\n`
	{
		&
		{
			!MalterlibTestDeployPath undefined
			TargetIsExecutable true
		}
	}


	PostBuildScript =+	`MTool TouchOrCreate "@(MalterlibTestDeployPath)/@(MalterlibFinalModuleDestination->GetFile()).MainTest"\r\n`
	{
		&
		{
			!MalterlibTestDeployPath undefined
			MalterlibMainTest true
			TargetIsExecutable true
		}
	}

	PostBuildScript =+	`MTool TouchOrCreate "@(MalterlibFinalModuleDestination).MainTest"\r\n`
	{
		&
		{
			!MalterlibTestPutPath undefined
			MalterlibBuildServerTest true
			MalterlibMainTest true
			TargetIsExecutable true
		}
	}

	PostBuildScript =+ `@(ScriptExport("MalterlibDeployRoot", MalterlibDeployRoot))\r\n`
	{
		!MalterlibBuildServerBuild true
	}

	PostBuildScript =+ MalterlibPostCopyContents
	{
		&
		{
			!MalterlibBuildServerBuild true
			!MalterlibPostCopyContents undefined
		}
	}

	PostBuildScript =+ MalterlibPostCopyContents2
	{
		&
		{
			!MalterlibBuildServerBuild true
			!MalterlibCalculatedPostCopyProject2 undefined
			!DisablePostCopy true
			!MalterlibPostCopyContents2 undefined
		}
	}

	PostBuildScript =+ MalterlibBuildServerPutPathUploadContents
	{
		&
		{
			!MalterlibBuildServerPutPath undefined
			MalterlibBuildServerBuild true
			!MalterlibBuildServerTest true
			!MalterlibBuildServerPutDisabled true
		}
	}


	PostBuildScript =+ MalterlibTestPutPathUploadContents
	{
		&
		{
			!MalterlibTestPutPath undefined
			MalterlibBuildServerTest true
			!MalterlibBuildServerPutDisabled true
		}
	}

	PostBuildScript =+ MalterlibPostBuildScript_Last
	{
		&
		{
			!MalterlibPostBuildScript_Last undefined
		}
	}

	PostBuildScript =+	`echo ***RESULT PROPERTY*** : ResultExecutable=@(MalterlibFinalModuleDestination->FullPath())\r\n`\
						`\r\n`
	{
		!!MalterlibNotifyResult true
	}
	PostBuildScript =+	`echo ***RESULT PROPERTY*** : ResultSymbols=@(SymbolFile->FullPath())`\
						`\r\n`
	{
		&
		{
			MalterlibNotifyResult true
			!SymbolFile undefined
		}
	}

	DependencyFile `@(Target.OutputDirectory)@(Target.Name).h`
	{
		|
		{
			GeneratorFamily "Xcode"
			GeneratorFamily "Ninja"
		}
	}

	PostBuildScript =+	`MTool CopyWriteTime @(Target:Target.PostBuildScriptInputs<[0]>->Escape()) @(Target:Target.DependencyFile->Escape()) @(Target:Target.PostBuildScriptInputs->Slice(1)->JoinEscaped(" "))\r\n`
	{
		&
		{
			!Target:Target.PostBuildScriptInputs []
			!Target:Target.DependencyFile undefined
		}
	}

	PostBuildScript =+	`MTool TouchOrCreate "@(PostBuildOutputfile)"\r\n`
	{
		!PostBuildOutputfile undefined
	}
}
