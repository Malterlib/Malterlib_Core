	MalterlibTestPutPathUploadTemplate	"MTool BuildServerPut Recursive=0 \"Source=@(Expand0)\" \"DestinationDir=@(MalterlibTestPutPath)@(Expand1)\"\r\n"\
											"@(CheckErrors)\r\n"
	{
		!MalterlibAutoBuild true
	}

	// AB Copy
	MalterlibTestPutPathUploadTemplate	"echo mkdir -p \"@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(Expand1)\"\r\n"\
											"mkdir -p \"@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(Expand1)\"\r\n"\
											"echo cp -fr \"@(Expand0)\" \"@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(Expand1)/\"\r\n"\
											"cp -fr \"@(Expand0)\" \"@(MalterlibAutoBuildTestPutPath)/@(MalterlibTestPutPath)@(Expand1)/\"\r\n"\
											"@(CheckErrors)\r\n"
	{
