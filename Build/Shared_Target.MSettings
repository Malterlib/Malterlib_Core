		{
			MalterlibOutOfProcessSupport true
			PlatformFamily "OSX"
		}
	}
	MalterlibPostBuildScriptPreSign "@(MalterlibPostBuildScriptPreSign)"\
									"MTool DiffCopy \"@(Builtin.Function->GetProperty('Property', 'MalterlibFinalModuleDestination', 'Group:Libraries.Target:Exe_AOCCOutOfProcess.Target:Exe_AOCCOutOfProcess'))\" \"@(MalterlibFinalModuleDestinationPath)\" \"\" 0\r\n"
	{
		&
		{
			MalterlibOutOfProcessSupport true
			PlatformFamily "Windows"
		}
	}


}

