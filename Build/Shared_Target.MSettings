	{
		&
		{
			!MalterlibPostCopyProject ""
			MalterlibSeparatePostCopyPerPlatfrom true
			|
			{
				!HostPlatformFamily "@(PlatformFamily)"
				!HostArchitecture "@(Architecture)"
			}
		}
	}
	MalterlibCalculatedPostCopyProject "@(MalterlibPostCopyProject)"
	{
		!!MalterlibCalculatedPostCopyProject ""
	}
	MalterlibCalculatedPostCopyProject2 "@(MalterlibPostCopyProject2)_@(PlatformFamily)_@(Architecture)"
	{
		&
		{
			!MalterlibPostCopyProject2 ""
			MalterlibSeparatePostCopyPerPlatfrom true
			|
			{
				!HostPlatformFamily "@(PlatformFamily)"
				!HostArchitecture "@(Architecture)"
			}
		}
	}
	MalterlibCalculatedPostCopyProject2 "@(MalterlibPostCopyProject2)"
	{
		!!MalterlibCalculatedPostCopyProject2 ""
	}
}

// Debugger settings
Target
{
	&
	{
		TargetIsExecutable true
		!Target.Type "DynamicLibrary"
		!Target.Type "XcodeBundle"
		!Target.Type "SharedDynamicLibrary"
	}

	LocalDebuggerCommand "@(MalterlibDeployRoot)/@(MalterlibCalculatedPostCopyProject)/@(MalterlibPostCopyDestination)/@(Target.FileName)@(Target.FileExtension)"
	{
		&
		{
			Target.LocalDebuggerCommand ""
			!MalterlibCalculatedPostCopyProject ""
			!MalterlibPostCopyDestination ""
		}
	}
	LocalDebuggerCommand "@(MalterlibDeployRoot)/@(MalterlibCalculatedPostCopyProject)/@(Target.FileName)@(Target.FileExtension)"
	{
		&
		{
			Target.LocalDebuggerCommand ""
			!MalterlibCalculatedPostCopyProject ""
			MalterlibPostCopyDestination ""
		}
	}
	RemoteDebuggerCommand "@(MalterlibRemoteDeployDebugRoot)/@(MalterlibCalculatedPostCopyProject)/@(MalterlibPostCopyDestination)/@(Target.FileName)@(Target.FileExtension)"
	{
		&
		{
			Target.RemoteDebuggerCommand ""
			!MalterlibCalculatedPostCopyProject ""
			!MalterlibPostCopyDestination ""
		}
	}
	RemoteDebuggerCommand "@(MalterlibRemoteDeployDebugRoot)/@(MalterlibCalculatedPostCopyProject)/@(Target.FileName)@(Target.FileExtension)"
	{
		&
		{
			Target.RemoteDebuggerCommand ""
			!MalterlibCalculatedPostCopyProject ""
			MalterlibPostCopyDestination ""
		}
	}
}

Target
{
	LocalDebuggerWorkingDirectory "@(Target.LocalDebuggerCommand->GetPath())"
	{
		&
		{
			Target.LocalDebuggerWorkingDirectory ""
			!Target.LocalDebuggerCommand ""
		}
	}
	RemoteDebuggerWorkingDirectory "@(Target.RemoteDebuggerCommand->GetPath())"
	{
		&
		{
			Target.RemoteDebuggerWorkingDirectory ""
			!Target.RemoteDebuggerCommand ""
		}
	}
	DebuggerCommandArguments "--test"
	{
		&
		{
			|
			{
				!Target.LocalDebuggerCommand ""
				!Target.RemoteDebuggerCommand ""
			}
			|
			{
				Tests "Tests"
				MalterlibTest true
			}
		}
	}
	DebuggerCommandArguments "--test --groups Performance"
	{
		&
		{
			|
			{
				!Target.LocalDebuggerCommand ""
				!Target.RemoteDebuggerCommand ""
			}
			Tests "Perf Tests"
		}
	}
}

// ExeFS
Property
{

	MalterlibLocalizationTranslationsPath "@(MalterlibCompiledFilesSourceBase)/@(Workspace:Workspace.Name)/Intermediate/GeneratedTranslation/@(Platform)/@(Architecture)/@(FullConfiguration)"
	MalterlibLocalizationExeFSPath "@(MalterlibLocalizationTranslationsPath)/TranslationsExeFS/*"
	MalterlibLocalizationTranslationHeadersPath "@(MalterlibLocalizationTranslationsPath)/TranslationHeaders"
	MalterlibQtTweakPath "@(MalterlibCompiledFilesSourceBase)/@(Workspace:Workspace.Name)/Intermediate/GeneratedTweaks/@(Platform)/@(Architecture)/@(FullConfiguration)"

	MalterlibTempExeFSPath "@(Target.IntermediateDirectory)ExeFS/*"
	{
