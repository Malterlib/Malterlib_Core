						}
					}
				}
				*/
			}
		}
//		# TraceCondition,TraceEval
	}
	MalterlibFinalModuleDestinationPath "@(MalterlibFinalModuleDestination->GetPath())"

	MalterlibFinalModuleDestinationExecutable "@(MalterlibFinalModuleDestination)"
	MalterlibFinalModuleDestinationExecutable "@(MalterlibFinalModuleDestination)/Contents/MacOS/@(Target:Target.FileName)"
	{
		!!MalterlibIsOSXBundle true
	}

	MalterlibOriginalModuleDestinationExecutable "@(MalterlibOriginalModuleDestination)"
	MalterlibOriginalModuleDestinationExecutable "@(MalterlibOriginalModuleDestination)/Contents/MacOS/@(Target:Target.FileName)"
	{
		!!MalterlibIsOSXBundle true
	}
}

Property
{
	GeneratedDirectory "@(MalterlibCompiledFilesSourceBase)/@(Workspace:Workspace.Name)/Generated/@(Target:Target.Name)/@(Platform)/@(Architecture)/@(FullConfiguration)/"

	GeneratedDirectoryNoConfig	"@(MalterlibCompiledFilesSourceBase)/@(Workspace:Workspace.Name)/Generated/@(Target:Target.Name)/NoConfig/"
	GeneratedWorkspaceDirectory	"@(MalterlibCompiledFilesSourceBase)/@(Workspace:Workspace.Name)/Generated/@(Platform)/@(Architecture)/@(FullConfiguration)/"
	GeneratedWorkspaceDirectoryNoConfig	"@(MalterlibCompiledFilesSourceBase)/@(Workspace:Workspace.Name)/Generated/NoConfig/"

	MalterlibUniqueConfig "@(GeneratedDirectory->Sanitize())"
	MalterlibUniqueConfig "@(MalterlibUniqueConfig->Replace('-', '_'))"
	MalterlibUniqueConfig "@(MalterlibUniqueConfig->Replace('.', '_'))"

}
Property
{
	MalterlibBinariesDirectory "@('../../../Binaries/Malterlib'->MakeAbsolute())/@(HostPlatformFamily)/@(HostArchitecture)"
	MToolDirectory "@('../../../Binaries/Malterlib'->MakeAbsolute())/@(HostPlatformFamily)/@(HostArchitecture)"

	MToolPath "@(MToolDirectory)/MTool.exe"
	{
