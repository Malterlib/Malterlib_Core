	LinkWithStandardLibraries: bool?
	SharedLibraryInstallPath: string?
}

Target
{
	!!GeneratorFamily "VisualStudio"

	CLRSupport false
	{
		!!Target.CLRSupport undefined
	}

	NasmPath: string? = `@(MalterlibBinariesDirectory->WindowsPath())\\`
	{
		!!Target.Language "Native"
	}

	CustomBuildAfterTargets: string?
	{
		!!LanguageFamily "Native"
	}
	//= "ClCompile"
	CustomBuildBeforeTargets: string?
	{
		!!LanguageFamily "Native"
	}
