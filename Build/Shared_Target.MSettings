	}
	MToolPath "@(MToolDirectory)/MTool"
	{
		!PlatformFamily "Windows"
	}

	MalterlibToolsRoot "x:/Development/Malterlib/Tools"
	{
		!!MalterlibToolsRoot ""
	}

}

