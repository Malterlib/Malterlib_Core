{
	&
	{
		LanguageFamily "Native"
		ToolChain "llvm"
	}

	EnableLinkerGroups true
	{
		&
		{
			Target.EnableLinkerGroups undefined
			PlatformFamily "Linux"
		}
	}
	EnableLinkerGroups false
	{
		!!Target.EnableLinkerGroups undefined
	}
	LinkerGroup "All"
	{
		!!MalterlibUseAllLinkerGroup true
	}

	LTOObjectFile: string?
	LTOObjectFile ""
	{
		&
		{
			PlatformFamily "Linux"
			GeneratorFamily "Xcode"
		}
	}

	TargetTripleArchitecture: string?
	TargetTripleVendor: string?
	TargetTripleOsVersion: string?
	TargetTripleSuffix: string?

	TargetTripleArchitecture MalterlibNativeClangArchitecture
	{
		&
		{
			GeneratorFamily "Xcode"
			PlatformFamily "Linux"
		}
	}

	TargetTripleVendor "unknown-linux"
	{
		&
		{
			GeneratorFamily "Xcode"
			PlatformFamily "Linux"
		}
	}

	TargetTripleOsVersion ""
	{
		&
		{
			GeneratorFamily "Xcode"
			PlatformFamily "Linux"
		}
	}

	TargetTripleSuffix "gnu"
	{
		&
		{
			GeneratorFamily "Xcode"
			PlatformFamily "Linux"
		}
	}

	LDFlags: [one_of(string, [string])] = []
	LDFlags =+ `-mlinker-version=@(MalterlibMacOSLinkerVersion->ToString())`
	{
		&
		{
			!MalterlibMacOSLinkerVersion undefined
			PlatformFamily "macOS"
			HostPlatformFamily "macOS"
			!Target.DriverType "DriverKit"
		}
	}

	LDFlags =+ "-Wl,-no_warn_duplicate_libraries"
	{
		!!MalterlibDefaultCompiler true
	}

	EmscriptenFastCompiler: bool?
	EmscriptenEmscriptenRoot: string?
	EmscriptenLLVMRoot: string?
	EmscriptenPython: string?
	EmscriptenNode: string?

	DriverkitDeploymentTarget: string?

	LDFlags =+ [["-env_EMCC_FAST_COMPILER", "1"]]
	{
		!!Target.EmscriptenFastCompiler true
	}
	LDFlags =+ [["-env_EMSCRIPTEN", Target.EmscriptenEmscriptenRoot]]
	{
		!Target.EmscriptenEmscriptenRoot undefined
	}
	LDFlags =+ [["-env_LLVM", Target.EmscriptenLLVMRoot]]
	{
		!Target.EmscriptenLLVMRoot undefined
	}
	LDFlags =+ [["-env_PYTHON", Target.EmscriptenPython]]
	{
		!Target.EmscriptenPython undefined
	}
	LDFlags =+ [["-env_NODE", Target.EmscriptenNode]]
	{
		!Target.EmscriptenNode undefined
	}

	LDFlags =+ `-mmacosx-version-min=@(MalterlibMinSupportedMacOSVersion)`
	{
		&
		{
			PlatformFamily "macOS"
			!Target.DriverType "DriverKit"
		}
	}

	LDFlags =+ "-nostdlib++"
	{
		&
		{
			MalterlibUseStaticLibCxx true
			!Target.Type "Driver"
			!MalterlibDisableMalterlib true
			MalterlibCustomCompilerOptions true
		}
	}

	LDFlags =+ "-nostdlib"
	{
		&
		{
			MalterlibUseStaticLibCxx true
			!Target.Type "Driver"
			!MalterlibDisableMalterlib true
			|
			{
				MalterlibDefaultCompiler true
				!MalterlibCustomCompilerOptions true
			}
		}
	}

	LDFlags =+ "-lunwind"
	{
		&
		{
			!MalterlibUseStaticLibCxx true
			!Target.Type "Driver"
			!MalterlibDisableMalterlib true
			PlatformFamily "Linux"
		}
	}

	LDFlags =+ "-fdwarf-exceptions"
	{
		&
		{
			PlatformFamily "Linux"
			Architecture "x86"
		}
	}

	LDFlags =+ "-Wl,--build-id=uuid"
