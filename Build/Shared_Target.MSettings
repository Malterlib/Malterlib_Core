Dependency
{
	Link true
	{
		!!Dependency.Link undefined
	}
}
Dependency
{
	!!LanguageFamily "Native"
	/*
	LinkWithObjectFiles true
	{
		&
		{
			Dependency.LinkWithObjectFiles undefined
			|
			{
				Configuration "Debug"
				Configuration "Debug Inlined"
				Configuration "Fast Compile"
			}
		}
	}
	*/
	LinkWithObjectFiles define bool = false
}

Target
{
	Language define string?
	TargetFrameworkVersion define string?
	CLRSupport define bool?
	ProjectDir define string?
	ExternalDependencies define [string]?
	CodeCoverageLinkerMapping define bool?
	CodeCoverageMapping define bool?
	InstrumentForOptimization define bool?
	LinkWithStandardLibraries define bool?
	SharedLibraryInstallPath define string?
}

// Target type
Target
{
	Type "ConsoleExecutable"
	{
		!!Target.Type undefined
	}

	FollowIndirectDependencies true
	{
		!!Target.Type "StaticLibrary"
	}
}

// Properties derived from target type
Property
{
	MalterlibExportEnvironmentMinGW define bool?

	TargetIsExecutable define bool = false
	TargetIsExecutable true
	{
		&
		{
			HasParentEntity("Target") true
			|
			{
				Target:Target.Type "ConsoleExecutable"
				Target:Target.Type "UIExecutable"
				Target:Target.Type "Executable"
				Target:Target.Type "DynamicLibrary"
				Target:Target.Type "XcodeBundle"
				Target:Target.Type "SharedDynamicLibrary"
				Target:Target.Type "Driver"
			}
		}
	}

	TargetIsLaunchableExecutable define bool = false
	TargetIsLaunchableExecutable true
	{
		&
		{
			HasParentEntity("Target") true
			|
			{
				Target:Target.Type "ConsoleExecutable"
				Target:Target.Type "UIExecutable"
				Target:Target.Type "Executable"
			}
		}
	}

	TargetExecutable define string = `@(Target.FileName)@(Target.FileExtension)`
	TargetIdentity define string
	TargetIdentity Target:this.Identity

	WorkspaceIdentity define string
	WorkspaceIdentity Workspace:this.Identity

	MalterlibTargetNameType define one_of("Suffixed", "Normal", "BaseName", "Launcher", "Config", "Architectured") = "Normal"
}

// Name / Filename
Target
{
	BaseName define string = this.Identity

	Name `Com_@(Target.BaseName)`
	{
		&
		{
			Target:Target.Name undefined
			Target:Target.Type "ConsoleExecutable"
		}
	}
	Name `Exe_@(Target.BaseName)`
	{
		&
		{
			Target:Target.Name undefined
			|
			{
				Target:Target.Type "Executable"
				Target:Target.Type "UIExecutable"
			}
		}
	}

	Name `Drv_@(Target.BaseName)`
	{
		&
		{
			Target:Target.Name undefined
			Target:Target.Type "Driver"
		}
	}
	Name `Dll_@(Target.BaseName)`
	{
		&
		{
			Target:Target.Name undefined
			|
			{
				Target:Target.Type "DynamicLibrary"
				Target:Target.Type "XcodeBundle"
				Target:Target.Type "SharedDynamicLibrary"
			}
		}
	}
	Name `Lib_@(Target.BaseName)`
	{
		&
		{
			Target:Target.Name undefined
			Target:Target.Type "StaticLibrary"
		}
	}
	Name `Tool_@(Target.BaseName)`
	{
		&
		{
			Target:Target.Name undefined
			Target:Target.Type "Tool"
		}
	}

	BaseFileName define string = Target.BaseName

	// Filename
	FileName `@(Target.BaseFileName)@(MalterlibConfigSuffix)_@(MalterlibArchitectureSuffix)@(MalterlibTargetExtraSuffix)`
	{
		&
		{
			Target.FileName undefined
			Property.MalterlibTargetNameType "Suffixed"
		}
	}
	FileName `@(Target.BaseFileName)@(MalterlibTargetExtraSuffix)`
	{
		&
		{
			Target.FileName undefined
			Property.MalterlibTargetNameType "Normal"
		}
	}
	FileName Target.BaseFileName
	{
		&
		{
			Target.FileName undefined
			Property.MalterlibTargetNameType "BaseName"
		}
	}

	FileName `@(Target.BaseFileName)@(MalterlibConfigSuffix)@(MalterlibTargetExtraSuffix)`
	{
		&
		{
			Target.FileName undefined
			Property.MalterlibTargetNameType "Launcher"
		}
	}

	FileName `@(Target.BaseFileName)@(MalterlibConfigSuffix)@(MalterlibTargetExtraSuffix)`
	{
		&
		{
			Target.FileName undefined
			Property.MalterlibTargetNameType "Config"
		}
	}

	FileName `@(Target.BaseFileName)_@(Architecture)@(MalterlibTargetExtraSuffix)`
	{
		&
		{
			Target.FileName undefined
			Property.MalterlibTargetNameType "Architectured"
		}
	}
}

Property.MalterlibGenerateScheme define bool = true

Target
{
	!!GeneratorFamily "Xcode"

	EnableModuleDebugging define bool?
	EnableModuleDebugging false

	GenerateScheme define bool?

	GenerateScheme MalterlibGenerateScheme
	{
		&
		{
			!MalterlibGenerateScheme false
			Target.GenerateScheme undefined
			|
			{
				MalterlibAllSchemes true
				|
				{
					!Target.LocalDebuggerCommand undefined
					!Target.RemoteDebuggerCommand undefined
				}
			}
		}
	}

	GenerateScheme false
	{
		!!Target.GenerateScheme undefined
	}
}

Target
{
	!!LanguageFamily ".NET"

	DefaultNamespace define string?
	DefaultNamespace Target:Target.BaseFileName
	{
		!!Target.DefaultNamespace undefined
	}

	PlatformTarget define string?
	PlatformTarget Architecture

	ErrorReport define string?
	ErrorReport "prompt"

	CodeAnalysisRuleSet define string?
	CodeAnalysisRuleSet "AllRules.ruleset"
}

