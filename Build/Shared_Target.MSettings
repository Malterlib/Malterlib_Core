	LinkKeyFile MalterlibStronglyNamedAssembly
	{
		&
		{
			!MalterlibStronglyNamedAssembly undefined
			!Configuration "Fast Compile"
		}
	}

	DelaySign define bool?
	DelaySign true
	{
		&
		{
			!MalterlibStronglyNamedAssembly undefined
			!Configuration "Fast Compile"
		}
	}

	SymbolFile define string?
	SymbolFile ""
	{
		&
		{
			Target.SymbolFile undefined
			Configuration "Fast Compile"
		}
	}

	SymbolFile `@(Builtin.OutputDirectory)@(Target.FileName).pdb`
	{
		!!Target.SymbolFile undefined
	}

	SubSystem define string?
	SubSystem "Windows"
	{
	}
	SubSystem "Console"
	{
		!!Target.Type "ConsoleExecutable"
	}

	LargeAddressAware define bool?
	LargeAddressAware true

	MinimumRequiredVersion define string?
	MinimumRequiredVersion "6.0"

	EntryPointSymbol define string?
	EntryPointSymbol "wWinMainCRTStartup"
	{
		&
		{
			Target.CharacterSet "Unicode"
			|
			{
				Target.Type "Executable"
				Target.Type "UIExecutable"
			}
		}
	}
	EntryPointSymbol "wmainCRTStartup"
	{
		&
		{
			Target.CharacterSet "Unicode"
			Target.Type "ConsoleExecutable"
		}
	}
	EntryPointSymbol "WinMainCRTStartup"
	{
		&
		{
			Target.CharacterSet "MultiByte"
			|
			{
				Target.Type "Executable"
				Target.Type "UIExecutable"
			}
		}
	}
	EntryPointSymbol "mainCRTStartup"
	{
		&
		{
			Target.CharacterSet "MultiByte"
			Target.Type "ConsoleExecutable"
		}
	}

	ExtraLinkerFlags += ["/CGTHREADS:8", "/OPT:ICF=16"]
	{
		&
		{
			DebugCompiler false
			!Configuration "Release Debug"
		}
	}

	AssemblyDebug define bool?
	AssemblyDebug true
	{
		!!DebugCompiler true
		!!Configuration "Release Debug"
	}
}

// Windows and driver targets
Target
{
	&
	{
		LanguageFamily "Native"
		Target.Type "Driver"
		PlatformType "Windows"
	}

	GenerateManifest false

	SubSystem "Native"

	Driver define bool?
	Driver true

	EntryPointSymbol "DriverEntry"

	IgnoreAllDefaultLibraries define bool?
	IgnoreAllDefaultLibraries true

	LinkWithLibraries += ["BufferOverflowK.lib", "Wdmsec.lib", "ntoskrnl.lib", "hal.lib", "ntstrsafe.lib"]
	//RandomizedBaseAddress false
	//DataExecutionPrevention false
}

Property
{
	MalterlibSeparatePostCopyPerPlatfrom define bool = true // User(Build System)=false: Enable separate post copy projects when building for non-host platforms

	MalterlibCalculatedPostCopyProject define string?
	MalterlibCalculatedPostCopyProject `@(MalterlibPostCopyProject)_@(PlatformFamily)_@(Architecture)`
