Dependency
{
	Link "true"
	{
		!!Dependency.Link ""
	}
}
Dependency
{
	!!LanguageFamily "Native"

	LinkWithObjectFiles "true"
	{
		&
		{
			Dependency.LinkWithObjectFiles ""
			|
			{
				Configuration "Debug"
				Configuration "Debug Inlined"
				Configuration "Fast Compile"
			}
		}
	}
	LinkWithObjectFiles "false"
	{
		!!Dependency.LinkWithObjectFiles ""
	}
}

// Target type
Target
{
	Type "ConsoleExecutable"
	{
		!!Target.Type ""
	}
}

// Properties derived from target type
Property
{
	TargetIsExecutable "true"
	{
		&
		{
			Property.true "@(Builtin.Function->HasParentEntity('Target'))"
			|
			{
				Target:Target.Type "ConsoleExecutable"
				Target:Target.Type "UIExecutable"
				Target:Target.Type "Executable"
				Target:Target.Type "DynamicLibrary"
				Target:Target.Type "XcodeBundle"
				Target:Target.Type "SharedDynamicLibrary"
				Target:Target.Type "Driver"
			}
		}
	}
}

// Name / Filename
Target
{
	BaseName "@(this.Identity)"

	Name "Com_@(Target.BaseName)"
	{
		!!Target:Target.Type "ConsoleExecutable"
	}
	Name "Exe_@(Target.BaseName)"
	{
		!!Target:Target.Type "Executable"
		!!Target:Target.Type "UIExecutable"
	}
		
	Name "Drv_@(Target.BaseName)"
	{
		!!Target:Target.Type "Driver"
	}
	Name "Dll_@(Target.BaseName)"
	{
		!!Target:Target.Type "DynamicLibrary"
		!!Target:Target.Type "XcodeBundle"
		!!Target:Target.Type "SharedDynamicLibrary"
	}
	Name "Lib_@(Target.BaseName)"
	{
		!!Target:Target.Type "StaticLibrary"
	}
	Name "Tool_@(Target.BaseName)"
	{
		!!Target:Target.Type "Tool"
	}

	BaseFileName "@(Target.BaseName)"

	// Filename
	FileName "@(Target.BaseFileName)@(MalterlibConfigSuffix)_@(MalterlibArchitectureSuffix)@(MalterlibTargetExtraSuffix)"
	{
		&
		{
			Target.FileName ""
			Property.MalterlibTargetNameType "Suffixed"
		}
	}
	FileName "@(Target.BaseFileName)@(MalterlibTargetExtraSuffix)"
	{
		&
		{
			Target.FileName ""
			Property.MalterlibTargetNameType "Normal"
		}
	}
	FileName "@(Target.BaseFileName)"
	{
		&
		{
			Target.FileName ""
			Property.MalterlibTargetNameType "BaseName"
		}
	}

	FileName "@(Target.BaseFileName)@(MalterlibConfigSuffix)@(MalterlibTargetExtraSuffix)"
	{
		&
		{
			Target.FileName ""
			Property.MalterlibTargetNameType "Launcher"
		}
	}

	FileName "@(Target.BaseFileName)@(MalterlibConfigSuffix)@(MalterlibTargetExtraSuffix)"
	{
		&
		{
			Target.FileName ""
			Property.MalterlibTargetNameType "Config"
		}
	}

	FileName "@(Target.BaseFileName)_@(Architecture)@(MalterlibTargetExtraSuffix)"
	{
		&
		{
			Target.FileName ""
			Property.MalterlibTargetNameType "Architectured"
		}
	}
}

Target
{
	!!GeneratorFamily Xcode
	
	EnableModuleDebugging "false"
	
	GenerateScheme true
	{
		&
		{
			Target.GenerateScheme ""
			|
			{
				MalterlibAllSchemes true
				|
				{
					!Target.LocalDebuggerCommand ""
					!Target.RemoteDebuggerCommand ""
				}
			}
		}
	}
	
	GenerateScheme false
	{
		!!Target.GenerateScheme ""
	}
}

Target
{
	!!LanguageFamily ".NET"

	DefaultNamespace "@(Target:Target.BaseFileName)"
	{
		!!Target.DefaultNamespace ""
	}

	PlatformTarget "@(Architecture)"
	ErrorReport "prompt"
	CodeAnalysisRuleSet "AllRules.ruleset"
}

// File extensions windows
Target
{
	&
	{
		LanguageFamily Native
		PlatformType "Windows"
	}
	FileExtension ".exe"
	FileExtension ".sys"
	{
		!!Target.Type "Driver"
	}
	FileExtension ".dll"
	{
		!!Target.Type "DynamicLibrary"
		!!Target.Type "SharedDynamicLibrary"
	}
	FileExtension ".lib"
	{
		!!Target.Type "StaticLibrary"
	}
}

// File extensions .NET
Target
{
	&
	{
		LanguageFamily ".NET"
	}
	FileExtension ".exe"
	FileExtension ".dll"
	{
		!!Target.Type "DynamicLibrary"
		!!Target.Type "SharedDynamicLibrary"
	}
}

// File extensions unix
Target
{
	&
	{
		LanguageFamily Native
		PlatformType "Unix"
	}
	FileExtension ".a"
	{
		!!Target.Type "StaticLibrary"
	}
	FileExtension ".so"
	{
		!!Target.Type "DynamicLibrary"
		!!Target.Type "SharedDynamicLibrary"
	}
}

// File extensions OSX
Target
{
	&
	{
		LanguageFamily Native
		PlatformIsDarwin true
	}
	FileExtension ".app"
	{
		!!Target.Type "UIExecutable"
	}
	FileExtension ".kext"
	{
		!!Target.Type "Driver"
	}
	FileExtension ".a"
	{
		!!Target.Type "StaticLibrary"
	}
	FileExtension ".dylib"
	{
		!!Target.Type "DynamicLibrary"
		!!Target.Type "SharedDynamicLibrary"
	}
	FileExtension ".framework"
	{
		!!Target.Type "XcodeBundle"
	}
}

// File extensions Emscripten
Target
{
	&
	{
		LanguageFamily Native
		PlatformFamily "Emscripten"
	}
	FileExtension ".a"
	{
		!!Target.Type "StaticLibrary"
	}
	FileExtension ".js"
	{
		!!Target.Type "DynamicLibrary"
		!!Target.Type "SharedDynamicLibrary"
	}
	FileExtension ".html"
	{
		!!Target.Type "UIExecutable"
		!!Target.Type "Executable"
		!!Target.Type "ConsoleExecutable"
	}
}


Property
{
	MalterlibUseClangForWindows false // User: Enable clang compilation for Windows platform
	{
		!!MalterlibUseClangForWindows ""
	}
}

Target
{
	&
	{
		GeneratorFamily VisualStudio
	}

	VisualStudioPlatform "Clang"
	{
		&
		{
			Target.VisualStudioPlatform ""
			LanguageFamily "Native"
			MalterlibUseClangForWindows true
		}
	}

	VisualStudioPlatform "x64"
	{
		&
		{
			Target.VisualStudioPlatform ""
			Platform "Windows"
			Architecture "x64"
		}
	}

	VisualStudioPlatform "Win32"
	{
		&
		{
			Target.VisualStudioPlatform ""
			LanguageFamily "Native"
			Platform "Windows"
			Architecture "x86"
		}
	}

	VisualStudioPlatform "x86"
	{
		&
		{
			Target.VisualStudioPlatform ""
			Platform "Windows"
			Architecture "x86"
		}
	}
	VisualStudioPlatform "Clang"
	{
		&
		{
			Target.VisualStudioPlatform ""
			LanguageFamily "Native"
		}
	}
	ClCompileSuffix "_Clang"
	{
		!!Target.VisualStudioPlatform "Clang"
	}
}

Property
{
	MalterlibVisualStudioToolset "" // User: Manually set another visual studio toolset
	{
		!!MalterlibVisualStudioToolset ""
	}
}

// Windows
Target
{
	&
	{
		PlatformType "Windows"
		LanguageFamily "Native"
	}


	// Toolset

	PlatformToolset "clang"
	{
		&
		{
			Target.PlatformToolset ""
			Target.VisualStudioPlatform "Clang"
		}
	}

	PlatformToolset "v90"
	{
		&
		{
			Target.PlatformToolset ""
			|
			{
				Target:Target.TargetFrameworkVersion "v2.0"
				Target:Target.TargetFrameworkVersion "v3.0"
				Target:Target.TargetFrameworkVersion "v3.5"
			}
		}
	}

	PlatformToolset "@(MalterlibVisualStudioToolset)"
	{
		&
		{
			!MalterlibVisualStudioToolset ""
			Target.PlatformToolset ""
		}
	}
	

	PlatformToolset "v140"
	{
		&
		{
			Target.PlatformToolset ""
			|
			{
				Generator "VisualStudio2013"
				Generator "VisualStudio2015"
			}
		}
	}

	PlatformToolset "v110"
	{
		!!Target.PlatformToolset ""
	}

	PlatformToolsetCompiler "x:/Development/Malterlib/llvm/unstable/build/VisualStudio2012/bin/RelWithDebInfo/clang.exe" // User: Change the clang compiler location
	{
		!!Target.PlatformToolset "clang"
	}

	//PlatformToolset "v120_CTP_Nov2012"

	IgnoreWarnCompileDuplicatedFilename true
	{
		!!Generator "VisualStudio2013"
	}

	CharacterSet "Unicode"
	{
		!!Target.CharacterSet ""
	}

	UseOfMfc "false"
	UseOfAtl "false"
	TargetMachine "MachineX86"
	{
		&
		{
			Architecture "x86"
			!Target.Type "Tool"
		}
	}
	TargetMachine "MachineX64"
	{
		&
		{
			Architecture "x64"
			!Target.Type "Tool"
		}
	}

	DefaultToolArchitecture "Native64Bit"
	{
		!!WindowsNativeToolChain "true"
	}
}

Property
{
	MalterlibSysRoot "/Development/Malterlib/Tools/SDKs/@(Platform).sdk"
	{
		!!PlatformFamily Linux
	}
	
	MalterlibToolsPrefix ""
	MalterlibToolsPrefix "/opt/local/@(MalterlibNativeClangArchitecture)-elf/bin/"
	{
		!!PlatformFamily Linux
	}
	MalterlibToolsPrefix "/Development/Malterlib/llvm/unstable-emscripten/emscripten/"
	{
		!!PlatformFamily Emscripten
	}
}

Property
{
	MalterlibLinkerDemangle true // User: Set to false to display mangled names in linker messages
	{
		!!MalterlibLinkerDemangle ""
	}
}

// Emscripten
Target
{
	&
	{
		LanguageFamily Native
		GeneratorFamily "Xcode"
		PlatformFamily Emscripten
	}

	EmscriptenFastCompiler true
	EmscriptenEmscriptenRoot "/Development/Malterlib/llvm/unstable-emscripten/emscripten"
	EmscriptenLLVMRoot "/Development/Malterlib/llvm/unstable-emscripten/build/make/bin"
	EmscriptenPython "/usr/bin/python"
	EmscriptenNode "/opt/local/bin/node"
}

Target
{
	!!GeneratorFamily "Xcode"
	
	MToolPath "@(MToolPath)"
}

// Xcode
Target
{
	&
	{
		LanguageFamily Native
		GeneratorFamily "Xcode"
	}
	
	EnableLinkerGroups true
	{
		&
		{
			Target.EnableLinkerGroups ""
			PlatformFamily Linux
		}
	}
	EnableLinkerGroups false
	{
		!!Target.EnableLinkerGroups ""
	}
	LDFlags "-env_EMCC_FAST_COMPILER 1 @(Target.LDFlags)"
	{
		!!Target.EmscriptenFastCompiler true
	}
	LDFlags "-env_EMSCRIPTEN \"@(Target.EmscriptenEmscriptenRoot)\" @(Target.LDFlags)"
	{
		!Target.EmscriptenEmscriptenRoot ""
	}
	LDFlags "-env_LLVM \"@(Target.EmscriptenLLVMRoot)\" @(Target.LDFlags)"
	{
		!Target.EmscriptenLLVMRoot ""
	}
	LDFlags "-env_PYTHON \"@(Target.EmscriptenPython)\" @(Target.LDFlags)"
	{
		!Target.EmscriptenPython ""
	}
	LDFlags "-env_NODE \"@(Target.EmscriptenNode)\" @(Target.LDFlags)"
	{
		!Target.EmscriptenNode ""
	}
	LDFlags "-s DISABLE_SYSLIB_libcxx=1 -s DISABLE_SYSLIB_libcxxabi=1 @(Target.LDFlags)"
	{
		&
		{
			PlatformFamily Emscripten
			!MalterlibDisableMalterlib true
		}
	}

	LDFlags "-O2 -s DISABLE_EXCEPTION_CATCHING=0 @(Target.LDFlags)"
	{
		&
		{
			PlatformFamily Emscripten
			!Compile.Optimize Off
		}
	}
	
	LDFlags "--closure 1 @(Target.LDFlags)"
	{
		&
		{
			PlatformFamily Emscripten
			Configuration Release
		}
	}
	LDFlags "--closure 0 @(Target.LDFlags)"
	{
		&
		{
			PlatformFamily Emscripten
			!Configuration Release
		}
	}
	
	PlatformToolset "com.apple.compilers.llvm.clang.1_0"
	{
		&
		{
			Target.PlatformToolset ""
			MalterlibDefaultToolset true
		}
	}
	
	PlatformToolset "com.apple.compilers.llvm.clang.p4generator"
	{
		!!Target.PlatformToolset ""
	}
/*	PlatformToolsetCompiler "/Development/Malterlib/Tools/llvm/stable/build/make/bin/clang"
	{
		&
		{
			Target.PlatformToolsetCompiler ""
			Generator "Xcode5"
		}
	}*/

	
	PlatformToolsetCompiler "@(MToolPath)" // User: Change the clang compiler location
	{
		&
		{
			Target.PlatformToolsetCompiler ""
			Documentation Doxygen
		}
	}
	
	PlatformToolsetCompiler "/Development/Malterlib/llvm/unstable-emscripten/emscripten/emcc" // User: Change the clang compiler location
	{
		&
		{
			Target.PlatformToolsetCompiler ""
			PlatformFamily "Emscripten"
		}
	}
	PlatformToolsetCompiler "/Development/Malterlib/Tools/llvm/stable/build/make/bin/clang" // User: Change the clang compiler location
	{
		&
		{
			Target.PlatformToolsetCompiler ""
			!MalterlibDefaultToolset true
		}
	}
	
//	PlatformToolsetLibTool "/Deploy/LibTool/libtool"
	PlatformToolsetLibTool "/Development/Malterlib/Tools/OSXPatches/libtool/libtool"
	{
		!!PlatformFamily Linux
		!!PlatformFamily Emscripten
	}

	PlatformToolsetLibTool "@(MToolPath)"
	{
		!!Documentation Doxygen
	}

	LibToolFlags "--ToolClass DoxygenLibTool @(Target.LibToolFlags)"
	{
		&
		{
			Target:Target.Type StaticLibrary
			Documentation Doxygen
			GeneratorFamily Xcode
		}
	}

	ExtraLibFlags "--ToolClass DoxygenLibTool @(Target.LibToolFlags)"
	{
		&
		{
			Target:Target.Type StaticLibrary
			Documentation Doxygen
			GeneratorFamily VisualStudio
		}
	}
	

	LDFlags "--ToolClass DoxygenLD --doxygen-executable /Development/Malterlib/Tools/doxygen/stable/bin/doxygen @(Target.LDFlags)"
	{
		&
		{
			!Target:Target.Type StaticLibrary
			Documentation Doxygen
			GeneratorFamily Xcode
		}
	}
	

	ExtraLinkerFlags "--ToolClass DoxygenLD --doxygen-executable /Development/Malterlib/Tools/doxygen/stable/bin/doxygen @(Target.LDFlags)"
	{
		&
		{
			!Target:Target.Type StaticLibrary
			Documentation Doxygen
			GeneratorFamily VisualStudio
		}
	}
	
	
	LDFlags "-Wno-warn-absolute-paths @(Target.LDFlags)"
	{
		!!PlatformFamily Emscripten
	}
	
	LDFlags "-target @(MalterlibTargetTriple) @(Target.LDFlags)"
	{
		!MalterlibTargetTriple ""
	}

	LDFlags "--sysroot \"@(MalterlibSysRoot)\" @(Target.LDFlags)"
	{
		!MalterlibSysRoot ""
	}

	LDFlags "-Xlinker -demangle @(Target.LDFlags)"
	{
		!!MalterlibLinkerDemangle true
	}

	LDFlags "-Xlinker -rpath-link -Xlinker \"@(MalterlibSysRoot)/lib32\" -Xlinker -rpath-link -Xlinker \"@(MalterlibSysRoot)/usr/lib32\" @(Target.LDFlags)"
	{
		&
		{
			PlatformFamily Linux
			Architecture x86
		}
	}

	LDFlags "-Xlinker --wrap=memcpy -Xlinker -Bsymbolic -Xlinker -Bsymbolic-functions @(Target.LDFlags)"
	{
		!!PlatformFamily Linux
	}
	
	LDFlags "-claim_xcode @(Target.LDFlags)"
	{
		&
		{
			PlatformFamily Linux
			GeneratorFamily Xcode
			!Target.PlatformToolsetCompiler "/Development/Malterlib/Tools/External/Build/llvm/bin/clang"
		}
	}

	LDFlags "-v @(Target.LDFlags)"
	{
		!!Compile.Verbose true
	}

	LDFlags "-B@(MalterlibToolsPrefix) @(Target.LDFlags)"
	{
		!MalterlibToolsPrefix ""
	}

	LDFlags "-shared @(Target.LDFlags)"
	{
		&
		{
			PlatformFamily Linux
			|
			{
				Target.Type DynamicLibrary
				Target.Type XcodeBundle
				Target.Type SharedDynamicLibrary
			}
		}
	}

/*
	LDFlags "-shared @(Target.LDFlags)"
	{
		&
		{
			PlatformFamily Linux
			TargetIsExecutable true
		}
	}
	*/
	
	LibToolFlags "-crosspath /opt/local/@(MalterlibNativeClangArchitecture)-elf/bin"
	{
		&
		{
			PlatformFamily Linux
			|
			{
				Architecture x86
				Architecture x64
			}
		}
	}
	LibToolFlags "-crosspath /Development/Malterlib/llvm/unstable-emscripten/emscripten"
	{
		!!PlatformFamily Emscripten
	}
	
	LibToolFlags "-env_EMCC_FAST_COMPILER 1 @(Target.LibToolFlags)"
	{
		!!Target.EmscriptenFastCompiler true
	}
	LibToolFlags "-env_EMSCRIPTEN \"@(Target.EmscriptenEmscriptenRoot)\" @(Target.LibToolFlags)"
	{
		!Target.EmscriptenEmscriptenRoot ""
	}
	LibToolFlags "-env_LLVM \"@(Target.EmscriptenLLVMRoot)\" @(Target.LibToolFlags)"
	{
		!Target.EmscriptenLLVMRoot ""
	}
	LibToolFlags "-env_PYTHON \"@(Target.EmscriptenPython)\" @(Target.LibToolFlags)"
	{
		!Target.EmscriptenPython ""
	}
	LibToolFlags "-env_NODE \"@(Target.EmscriptenNode)\" @(Target.LibToolFlags)"
	{
		!Target.EmscriptenNode ""
	}	

	CxxLanguage "C++17"
	{
		"!!Target.CxxLanguage" ""
	}
	//CxxStandardLibrary "libc++"
	CxxStandardLibrary "none"
	{
		!MalterlibDisableMalterlib true
	}
	CxxStandardLibrary "libc++"
	{
		!!MalterlibUseStaticLibCxx false
		!!MalterlibDisableMalterlib true
		!!Target.PlatformToolset "com.apple.compilers.llvm.clang.1_0"
	}
	
	HeadermapIncludeTarget false
	HeadermapIncludeFrameworks false
	HeadermapIncludeProject false
	HeadermapEnable false

	AlwaysSearchUserPaths "false"
	CombineHiDPIImages "true" // to prevent Xcode upgrading warning
	
	StripDebugSymbolsDuringCopy "false"

/*	StripLinkedProduct "true"
	{
		!!MalterlibDeploySymbols true
	}
	StripStyle "All"
	UseSeperateStrip "true"
	{
		!!MalterlibDeploySymbols true
	}*/

	FilePrefix ""
	
	CodeSigningReqired false
	{
		!!PlatformFamily iOS
	}

	SDKRoot "OSX@(MalterlibMaxSupportedOSXVersion)"
	{
		!!PlatformFamily OSX
	}

	SDKRoot "iOS@(MalterlibMaxSupportediOSVersion)"
	{
		!!PlatformFamily iOS
	}

	SDKRoot "@(Platform)"
	{
		!!PlatformFamily Emscripten
	}

	SDKRoot "@(Platform)"
	{
		!!Target.SDKRoot ""
	}

	
	DeploymentTarget "@(Platform)"
	{
		&
		{
			Target.DeploymentTarget ""
			!PlatformFamily iOS
		}
	}
	
	iOSDeploymentTarget "@(Platform)"
	{
		&
		{
			Target.iOSDeploymentTarget ""
			PlatformFamily iOS
		}
	}

	ProductType "com.apple.product-type.library.static"
	{
		!!Target.Type "StaticLibrary"
	}
	ProductType "com.apple.product-type.library.dynamic"
	{
		!!Target.Type "DynamicLibrary"
		!!Target.Type "SharedDynamicLibrary"
	}
	//TODO:  Target.Type XcodeBundle

	ProductType "com.apple.product-type.tool"
	{
		!!Target.Type "ConsoleExecutable"
		!!Target.Type "Executable"
	}
	ProductType "com.apple.product-type.application"
	{
		!!Target.Type "UIExecutable"
	}
	ProductType "com.apple.product-type.kernel-extension.iokit"
	{
		!!Target.Type "Driver"
	}
	ProductType ""
	{
		!!Target.Type "Tool"
	}
	
	ExecutableFolder ""

	ExecutableFolder "@(Target.FileName)@(Target.FileExtension)/Contents/MacOS"
	{
		&
		{
			PlatformFamily OSX
			MalterlibIsOSXBundle true
		}
	}

	ExecutableFolder "@(Target.FileName)@(Target.FileExtension)"
	{
		&
		{
			PlatformFamily iOS
			MalterlibIsOSXBundle true
		}
	}

	ProjectDerivedSourcesDir "@(Target:Target.IntermediateDirectory)DerivedSources"
	ProjectSharedPrecompPrefixDir "@(Target:Target.IntermediateDirectory)PrefixHeaders"
	
	CompatibilityVersion ""
	{
		!!Target.Type "DynamicLibrary"
		!!Target.Type "XcodeBundle"
	}
	
	CurrentVersion ""
	{
		!!Target.Type "DynamicLibrary"
		!!Target.Type "XcodeBundle"
	}

	CompatibilityVersion "1.0"
	{
		!!Target.Type "SharedDynamicLibrary"
	}
	
	CurrentVersion "1.1"
	{
		!!Target.Type "SharedDynamicLibrary"
	}
}

// OSX
Target
{
	&
	{
		LanguageFamily Native
		PlatformFamily OSX
		!Target.Type "Tool"
	}
	ObjcLinkRuntime "false"

	DebugInformationFormat "dwarf"
	DebugInformationFormat "dwarf-with-dsym"
	{
		|
		{
			MalterlibDeploySymbols true
			Target.Type Driver
			&
			{
				MalterlibBuildServerTest true
				|
				{
					MalterlibMainTest true
					MalterlibHelperTest true
				}
			}
		}
	}

	ValidArchitectures "@(MalterlibNativeClangArchitecture)"
	Architectures "@(MalterlibNativeClangArchitecture)"

	SupportedPlatforms "macosx"
	OnlyActiveArchitectures "true"
	NativeArchitecture "@(MalterlibNativeClangArchitecture)"
	NativeArchitectureActual "@(MalterlibNativeClangArchitecture)"
	
}

// iOS
Target
{
	&
	{
		LanguageFamily Native
		PlatformFamily iOS
		!Target.Type "Tool"
	}
	ObjcLinkRuntime "false"

	DebugInformationFormat "dwarf"
	DebugInformationFormat "dwarf-with-dsym"
	{
		|
		{
			MalterlibDeploySymbols true
			Target.Type Driver
			&
			{
				MalterlibBuildServerTest true
				|
				{
					MalterlibMainTest true
					MalterlibHelperTest true
				}
			}
		}
	}

	ValidArchitectures "@(MalterlibNativeClangArchitecture)"
	Architectures "@(MalterlibNativeClangArchitecture)"

	SupportedPlatforms "iphonesimulator iphoneos"
	OnlyActiveArchitectures "true"
	NativeArchitecture "@(MalterlibNativeClangArchitecture)"
	NativeArchitectureActual "@(MalterlibNativeClangArchitecture)"
}

// Linux
Target
{
	&
	{
		LanguageFamily Native
		PlatformFamily "Linux"
		!Target.Type "Tool"
	}
	ObjcLinkRuntime "false"

	DebugInformationFormat ""
	
	ValidArchitectures "@(MalterlibNativeClangArchitecture)"
	Architectures "@(MalterlibNativeClangArchitecture)"

	SupportedPlatforms "macosx"
	OnlyActiveArchitectures "true"
	NativeArchitecture "@(MalterlibNativeClangArchitecture)"
	NativeArchitectureActual "@(MalterlibNativeClangArchitecture)"
	
	DependencyInfoFile "" // Empty as the linker does not support it
//	ValidArchitectures "none"
//	Architectures "none"

}

// Emscripten
Target
{
	&
	{
		LanguageFamily Native
		PlatformFamily "Emscripten"
		!Target.Type "Tool"
	}
	ObjcLinkRuntime "false"

	DebugInformationFormat ""
	
	ValidArchitectures "@(MalterlibNativeClangArchitecture)"
	Architectures "@(MalterlibNativeClangArchitecture)"

	SupportedPlatforms "macosx"
	OnlyActiveArchitectures "true"
	NativeArchitecture "@(MalterlibNativeClangArchitecture)"
	NativeArchitectureActual "@(MalterlibNativeClangArchitecture)"
	
	DependencyInfoFile "" // Empty as the linker does not support it
//	ValidArchitectures "none"
//	Architectures "none"

}

Property
{
	TargetIsCodeGen "true"
	{
		!Target.Type "Tool"
	}
}

// Code generating targets
Target
{
	&
	{
		TargetIsCodeGen "true"
		LanguageFamily "Native"
	}

	LinkTimeCodeGeneration "false"
	LinkTimeCodeGeneration "true"
	{
		!!Compile.Optimize "On"
		!!Compile.Optimize "Full"
	}
}

// Executable targets
Target
{
	!!TargetIsExecutable "true"
	Version "@(ProductVersionMajor).@(ProductVersionMinor)@(ProductVersionRevision)"

	GenerateDebugInformation "true"
	GenerateDebugInformation "DebugFastLink"
	{
		&
		{
			LanguageFamily Native
			!MalterlibDeploySymbols true
			GeneratorFamily VisualStudio
			!Target.PlatformToolset "v90"
			!Target.CLRSupport true
		}
	}
	GenerateDebugInformation "false"
	{
		!!Configuration "Fast Compile"
	}
}

Property
{
	MalterlibPosixInitFileName "@(MalterlibCompiledFiles)@(MalterlibBranch)/@(Workspace:Workspace.Name)/Intermediate/Lib_Malterlib_Init/@(Platform)/@(Architecture)/@(FullConfiguration)/Objects-normal/@(MalterlibNativeClangArchitecture)/Malterlib_Core_PlatformImp_Posix_Init.o"
	{
		&
		{
			!MalterlibDefaultToolset true
			!MalterlibDisableMalterlib true
			MalterlibNeedsInitProject true
		}
	}
}

Property
{
	MalterlibOverrideMallocLibrary "@(MalterlibCompiledFiles)@(MalterlibBranch)/@(Workspace:Workspace.Name)/Output/Dll_MalterlibOverrideMalloc/@(Platform)/@(Architecture)/@(FullConfiguration)/Deployed/MalterlibOverrideMalloc.dylib"
	
	MalterlibNeedsMallocOverrideLibrary true
	{
		&
		{
			TargetIsExecutable true
			!Target.Type DynamicLibrary
			!Target.Type XcodeBundle
			!Target.Type SharedDynamicLibrary
			!Target.Type Driver
			!DocumentationEnabled true
			!MalterlibDisableMalterlib true
			PlatformIsDarwin true
			MalterlibMemoryManager_EnableOverrideSystemMalloc true
		}
	}	
}

// Executable native targets
Target
{
	&
	{
		LanguageFamily Native
		TargetIsExecutable "true"
	}

	LinkWithLibraries "@(Target.LinkWithLibraries) @(Builtin.Inherit)"
	{
		&
		{
			!Target.Type Driver
			!PlatformFamily Windows
		}
	}
	LinkWithLibraries "@(Target.LinkWithLibraries);@(Builtin.Inherit)"
	{
		&
		{
			!Target.Type Driver
			PlatformFamily Windows
		}
	}

	LinkWithLibraries "@(MalterlibPosixInitFileName) @(Target.LinkWithLibraries)"
	{
		&
		{
			Target.PlatformToolsetCompiler "/Development/Malterlib/Tools/External/Build/llvm/bin/clang"
			TargetIsExecutable "true"
			!Target.Type "Driver"
			!MalterlibDisableMalterlib true
			!MalterlibPosixInitFileName ""
		}
	}

	LinkWithLibraries "-first_object @(MalterlibPosixInitFileName) @(Target.LinkWithLibraries)"
	{
		&
		{
			TargetIsExecutable "true"
			!Target.Type "Driver"
			!MalterlibDisableMalterlib true
			!MalterlibPosixInitFileName ""
		}
	}

	LinkWithLibraries "-sectcreate __TEXT __info_plist \"@(Target:Target.MalterlibInfoPListFile)\" @(Target.LinkWithLibraries)"
	{

		&
		{
			"!Target:Target.MalterlibInfoPListFile" ""
			!MalterlibIsOSXBundle true
		}
	}

	LinkWithLibraries "-framework CoreFoundation @(Target.LinkWithLibraries)"
	{
		&
		{
			PlatformIsDarwin true
			!Target.Type Driver
		}
	}
	
	LinkWithLibraries "-framework CoreServices @(Target.LinkWithLibraries)"
	{
		// Used for FSEvents API
		&
		{
			PlatformFamily OSX
			!Target.Type Driver
		}
	}
	
	LinkWithLibraries "-framework AppKit @(Target.LinkWithLibraries)"
	{
		&
		{
			PlatformFamily OSX
			!Target.Type Driver
		}
	}
	
	LinkWithLibraries "-framework Security @(Target.LinkWithLibraries)"
	{
		&
		{
			PlatformIsDarwin true
			!Target.Type Driver
		}
	}

	LinkWithLibraries "-framework Cocoa -framework IOKit -framework OpenGL @(Target.LinkWithLibraries)"
	{
		&
		{
			PlatformFamily OSX
			!Target.Type Driver
		}
	}

	LinkWithLibraries "-framework UIKit @(Target.LinkWithLibraries)"
	{
		&
		{
			PlatformFamily iOS
			!Target.Type Driver
		}
	}

	LinkWithLibraries "-pthread -ldl -luuid -lrt @(Target.LinkWithLibraries)"
	{
		!!PlatformFamily "Linux"
	}

	LinkWithLibraries "-lasound @(Target.LinkWithLibraries)"
	{
		&
		{
			PlatformFamily "Linux"
			Target.Type "UIExecutable"
		}
	}

	LinkWithLibraries "\"-F@('../../../SDK'->MakeAbsolute())/BreakpadBin/@(PlatformFamily)\" @(Target.LinkWithLibraries)"
	{
		&
		{
			PlatformIsDarwin true
			MalterlibEnableBreakpad true
			Target.Type "UIExecutable"
		}
	}
	LinkWithLibraries "-framework Breakpad @(Target.LinkWithLibraries)"
	{
		&
		{
			PlatformIsDarwin true
			MalterlibEnableBreakpad true
			Target.Type "UIExecutable"
		}
	}
	
	LinkWithLibraries "-lc++abi @(Target.LinkWithLibraries)"
	{
		&
		{
			PlatformIsDarwin true
			!MalterlibUseStaticLibCxxABI true
			!Target.Type Driver
		}
	}

	RealLinkWithLibraries "@(Target.LinkWithLibraries)"
	{
		!!GeneratorFamily Xcode
	}
	
	RealLinkWithLibraries "\"@(MalterlibOverrideMallocLibrary)\" @(Target.RealLinkWithLibraries)"
	{
		!!MalterlibNeedsMallocOverrideLibrary true
	}

	SearchPath "@(Target.SearchPath);@(Builtin.Inherit)"

	SearchPath "@('../../../SDK'->MakeAbsolute())/WDK/lib/WXP/i386;@(Target.SearchPath)"
	{
		&
		{
			PlatformType "Windows"
			Target.Type "Driver"
			Architecture "x86"
		}
	}	
	SearchPath "@('../../../SDK'->MakeAbsolute())/WDK/lib/WNET/amd64;@(Target.SearchPath)"
	{
		&
		{
			PlatformType "Windows"
			Target.Type "Driver"
			Architecture "x64"
		}
	}
	
	SearchPath "@('../../../SDK'->MakeAbsolute())/OpenSSL/build/lib/@(Platform)/@(ToolsetDir)/@(Architecture)/@(MalterlibDebugLibrariesFolderName);@(Target.SearchPath)"
	{
		&
		{
			MalterlibLinkWithOpenSSL true
			MalterlibUsesOpenSSL true
			!AOCCDisableSSL true
		}
	}
	
	LinkWithLibraries "@('../../../SDK'->MakeAbsolute())/OpenSSL/build/lib/@(Platform)/@(ToolsetDir)/@(Architecture)/@(MalterlibDebugLibrariesFolderName)/libssl.a "\
					  "@('../../../SDK'->MakeAbsolute())/OpenSSL/build/lib/@(Platform)/@(ToolsetDir)/@(Architecture)/@(MalterlibDebugLibrariesFolderName)/libcrypto.a "\
					  "@(Target.LinkWithLibraries)"
	{
		&
		{
			MalterlibLinkWithOpenSSL true
			PlatformType "Unix"
			!AOCCDisableSSL true
		}
	}
	
	LinkWithLibraries "@('../../../SDK'->MakeAbsolute())/OpenSSL/build/lib/@(Platform)/@(ToolsetDir)/@(Architecture)/@(MalterlibDebugLibrariesFolderName)/ssleay32.lib;"\
					  "@('../../../SDK'->MakeAbsolute())/OpenSSL/build/lib/@(Platform)/@(ToolsetDir)/@(Architecture)/@(MalterlibDebugLibrariesFolderName)/libeay32.lib;"\
					  "@(Target.LinkWithLibraries)"
	{
		&
		{
			MalterlibLinkWithOpenSSL true
			PlatformFamily Windows
			!AOCCDisableSSL true
		}
	}

	LinkWithLibraries "-framework Security @(Target.LinkWithLibraries)"
	{
		&
		{
			MalterlibLinkWithOpenSSL true
			PlatformIsDarwin true
			!AOCCDisableSSL true
			!Target.Type Driver
		}
	}

	SearchPath "@('../../../SDK'->MakeAbsolute())/Perforce/lib/@(Platform)/@(ToolsetDir)/@(Architecture);@(Target.SearchPath)"
	{
		&
		{
			MalterlibLinkWithPerforce true
			!PlatformFamily "Windows"
			!PlatformIsDarwin true
		}
	}
	SearchPath "@('../../../SDK'->MakeAbsolute())/Perforce/lib/OSX10.5/@(ToolsetDir)/@(Architecture);@(Target.SearchPath)"
	{
		&
		{
			MalterlibLinkWithPerforce true
			PlatformFamily "OSX"
		}
	}

	LinkWithLibraries "-Xlinker -( -lclient -lrpc -lsupp -Xlinker -) @(Target.LinkWithLibraries)"
	{
		&
		{
			MalterlibLinkWithPerforce true
			!PlatformFamily "Windows"
			!PlatformIsDarwin true
		}
	}
	LinkWithLibraries "-lclient -lrpc -lsupp @(Target.LinkWithLibraries)"
	{
		&
		{
			MalterlibLinkWithPerforce true
			!PlatformFamily "Windows"
			PlatformIsDarwin true
		}
	}

	RemoveUnreferencedSymbols "false"
	RemoveUnreferencedSymbols "true" // OptimizeReferences
	{
		&
		{
			DebugCompiler "false"
			!Configuration "Release Debug"
		}
	}
}

// .NET Executable Targets
Target
{
	&
	{
		LanguageFamily .NET
		TargetIsExecutable "true"
	}
	StartAction "Program"
}

// Windows native executable targets
Target
{
	&
	{
		LanguageFamily Native
		TargetIsExecutable "true"
		PlatformType "Windows"
	}

	IgnoreImportLibrary "true"
	GenerateManifest "true"
	GenerateManifest "false"
	{
		!!Configuration "Fast Compile"
	}
	LinkIncremental "true"
	{
		!!DebugCompiler "true"
	}
	LinkIncremental "false"
	{
		!!DebugCompiler "false"
	}
	LinkKeyFile "@(MalterlibStronglyNamedAssembly)"
	{
		&
		{
			!MalterlibStronglyNamedAssembly ""
			!Configuration "Fast Compile"
		}
	}
	DelaySign true
	{
		&
		{
			!MalterlibStronglyNamedAssembly ""
			!Configuration "Fast Compile"
		}
	}
	
	SymbolFile "@(Builtin.OutputDirectory)@(Target.FileName).pdb"

	SymbolFile ""
	{
		!!Configuration "Fast Compile"
	}

	SubSystem "Windows"
	{
	}
	SubSystem "Console"
	{
		!!Target.Type "ConsoleExecutable"
	}

	LargeAddressAware "true"

	MinimumRequiredVersion "6.0"

	EntryPointSymbol "wWinMainCRTStartup"
	{
		&
		{
			Target.CharacterSet "Unicode"
			|
			{
				Target.Type "Executable"
				Target.Type "UIExecutable"
			}
		}
	}
	EntryPointSymbol "wmainCRTStartup"
	{
		&
		{
			Target.CharacterSet "Unicode"
			Target.Type "ConsoleExecutable"
		}
	}
	EntryPointSymbol "WinMainCRTStartup"
	{
		&
		{
			Target.CharacterSet "MultiByte"
			|
			{
				Target.Type "Executable"
				Target.Type "UIExecutable"
			}
		}
	}
	EntryPointSymbol "mainCRTStartup"
	{
		&
		{
			Target.CharacterSet "MultiByte"
			Target.Type "ConsoleExecutable"
		}
	}
	ExtraLinkerFlags "/CGTHREADS:8 /OPT:ICF=16 @(Target.ExtraLinkerFlags)"
	{
		&
		{
			DebugCompiler "false"
			!Configuration "Release Debug"
		}
	}

	AssemblyDebug "true"
	{
		!!DebugCompiler "true"
		!!Configuration "Release Debug"
	}
}

