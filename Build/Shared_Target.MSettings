				Target.SDKRoot "Emscripten"
				Target.SDKRoot "Linux2.6"
			}
		}
	}

	DeploymentTarget define string?
	DeploymentTarget Platform
	{
		&
		{
			Target.DeploymentTarget undefined
			!PlatformFamily "iOS"
		}
	}

	iOSDeploymentTarget define string?
	iOSDeploymentTarget Platform
	{
		&
		{
			Target.iOSDeploymentTarget undefined
			PlatformFamily "iOS"
		}
	}

	ProductType define string?
	ProductType "com.apple.product-type.library.static"
	{
		!!Target.Type "StaticLibrary"
	}
	ProductType "com.apple.product-type.library.dynamic"
	{
		!!Target.Type "DynamicLibrary"
		!!Target.Type "SharedDynamicLibrary"
	}
	//TODO:  Target.Type "XcodeBundle"

	ProductType "com.apple.product-type.tool"
	{
		!!Target.Type "ConsoleExecutable"
		!!Target.Type "Executable"
	}
	ProductType "com.apple.product-type.application"
	{
		!!Target.Type "UIExecutable"
	}
	ProductType "com.apple.product-type.kernel-extension.iokit"
	{
		&
		{
			Target.Type "Driver"
			|
			{
				Target.DriverType "IoKit"
				Target.DriverType undefined
			}
		}
	}
	ProductType "com.apple.product-type.driver-extension"
	{
		&
		{
			Target.Type "Driver"
			Target.DriverType "DriverKit"
		}
	}

	ProductType ""
	{
		!!Target.Type "Tool"
	}

	ExecutableFolder define string?
	ExecutableFolder `@(Target.FileName)@(Target.FileExtension)/Contents/MacOS`
	{
		&
		{
			PlatformFamily "OSX"
			!Target.DriverType "DriverKit"
			MalterlibIsOSXBundle true
		}
	}

	ExecutableFolder `@(Target.FileName)@(Target.FileExtension)`
	{
		&
		{
			|
			{
				PlatformFamily "iOS"
				&
				{
					PlatformFamily "OSX"
					Target.DriverType "DriverKit"
				}
			}
			MalterlibIsOSXBundle true
		}
	}

	ExecutableFolder ""
	{
		!!PlatformFamily "Linux"
	}

	ProjectDerivedSourcesDir define string = `@(Target:Target.IntermediateDirectory)DerivedSources`

	ProjectSharedPrecompPrefixDir define string = `@(Target:Target.IntermediateDirectory)PrefixHeaders`

	CompatibilityVersion define string?
	CompatibilityVersion ""
	{
		!!Target.Type "DynamicLibrary"
		!!Target.Type "XcodeBundle"
	}

	CurrentVersion define string?
	CurrentVersion ""
	{
		!!Target.Type "DynamicLibrary"
		!!Target.Type "XcodeBundle"
	}

	CompatibilityVersion "1.0"
	{
		!!Target.Type "SharedDynamicLibrary"
	}

	CurrentVersion "1.1"
	{
		!!Target.Type "SharedDynamicLibrary"
	}
}

