Property
{
	MalterlibUseAllLinkerGroup: bool = true
}

Property
{
	MalterlibDeploySymbolsTool function(string? _ProtectedDirs, string? _ExtraUploads) string

	MalterlibDeploySymbolsTool `MTool`
	{
		!MalterlibBuildServerBuild true
	}
	MalterlibDeploySymbolsTool `@(MalterlibBuildServerCommandPrefix)MTool BuildServerTool Tool=ZMTool "ProtectedDirs=@(_ProtectedDirs || "")" ExtraUploads="@(_ExtraUploads || "")"`
	{
		!!MalterlibBuildServerBuild true
	}
}

