					"set -eo pipefail\r\n"
	{
		!!PlatformType "Unix"
	}
}

Target
{
	!!GeneratorFamily "VisualStudio"

	Real_PreBuildScript "@(Target.ExportScriptEnvironmentContents)\r\n@(Target.PreBuildScript)"
	Real_PostBuildScript "@(Target.ExportScriptEnvironmentContents)\r\n@(Target.PostBuildScript)"
}

Target
{
	!!GeneratorFamily "Xcode"

	PreBuildScriptInputs "@(PreBuildScriptDependencies)"
	PreBuildScriptOutputs "@(PreBuildOutputfile)"
	PreBuildScript	"@(Target.PreBuildScript)\n"\
					"\"@(Builtin.MToolExe)\" CheckDependencies \"Directory=@(Target.IntermediateDirectory)MalterlibDependencies\"\n"\
					"if [ \"$?\" != \"0\" ]; then\n"\
					"  echo error: Dependency checking failed\n"\
					"  exit 1\n"\
					"fi\n"\
					"MTool TouchOrCreate \"@(PreBuildOutputfile)\"\n"
	{
		//!!MalterlibAccurateDependencies true
	}
}

Property
{
	MalterlibExecutableInput "@(MalterlibOriginalModuleDestinationExecutable)"

	MalterlibPostBuildScriptInputs "@(MalterlibExecutableInput);@(MalterlibPostBuildScriptInputs)"
