Property
{
	MalterlibLinkerDemangle: bool = true // User(Toolset)=false: Set to false to display mangled names in linker messages
	MalterlibOverrideMSVCVersion: string?

	MalterlibDisableAutomaticResources: bool = false

	MalterlibUseLocalCompilerBuild: bool = false // User(Toolset)=true: Build llvm locally and use that for building

	MalterlibMSVCVersion: string?
	MalterlibMSVCVersion MalterlibOverrideMSVCVersion
	{
		&
		{
			MalterlibMSVCVersion undefined
			!MalterlibOverrideMSVCVersion undefined
		}
	}

	VisualStudioRootUnix: string = `@(Builtin.VisualStudioRoot->UnixPath())`
	VisualStudioMSVCRootPath: string = `@(VisualStudioRootUnix)/VC/Tools/MSVC`

	MalterlibMSVCVersion "14.34.31933"
	{
		!HostPlatformFamily "Windows"
	}

	MalterlibMSVCVersion VisualStudioMSVCRootPath->FindDirectoriesIn('*')<[0]>->GetFile()
	{
		!!MalterlibMSVCVersion undefined
	}

	PlatformToolsetCompiler: string? // User(Toolset)="/opt/Source/llvm-malterlib/build/main/bin/clang": Change the clang compiler location

	PlatformToolsetCompiler MalterlibLLVMHostBinariesDirectory / "bin/clang"
	{
		&
		{
			PlatformToolsetCompiler undefined
			!MalterlibUseLocalCompilerBuild true
			!MalterlibDefaultCompiler true
			!HostPlatformFamily "Windows"
		}
	}

	PlatformToolsetCompiler "/opt/Development/Malterlib/llvm/unstable-emscripten/emscripten/emcc"
	{
		&
		{
			PlatformToolsetCompiler undefined
			PlatformFamily "Emscripten"
			!HostPlatformFamily "Windows"
		}
	}
	PlatformToolsetCompiler `@(MalterlibDependenciesDirectory)/llvm/@(MalterlibClangVersion)/build/main/bin/clang`
	{
		&
		{
			PlatformToolsetCompiler undefined
			MalterlibUseLocalCompilerBuild true
			!MalterlibDefaultCompiler true
			!HostPlatformFamily "Windows"
		}
	}
	PlatformToolsetCompiler `@(MalterlibToolsRoot)/MSVC/@(MalterlibOverrideMSVCVersion)/bin/@(MSVCToolChainArchitecture)/cl.exe`
	{
		&
		{
			PlatformToolsetCompiler undefined
			!MalterlibOverrideMSVCVersion undefined
			!MalterlibDefaultCompiler true
			HostPlatformFamily "Windows"
		}
	}
	PlatformToolsetCompilerBasePath: string?
	PlatformToolsetCompilerBasePath PlatformToolsetCompiler->GetPath()->GetPath()
	{
		!PlatformToolsetCompiler undefined
	}
}

// Emscripten
Target
{
	&
	{
		LanguageFamily "Native"
		GeneratorFamily "Xcode"
		PlatformFamily "Emscripten"
	}

	EmscriptenFastCompiler true
	EmscriptenEmscriptenRoot "/Development/Malterlib/llvm/unstable-emscripten/emscripten"
	EmscriptenLLVMRoot "/Development/Malterlib/llvm/unstable-emscripten/build/make/bin"
	EmscriptenPython "/usr/bin/python"
	EmscriptenNode "/usr/local/bin/node"
}

Target
{
	!!GeneratorFamily "Xcode"

	MToolPath: string?
	MToolPath MToolPath
}

Property
{
	fg_ExportScriptEnvironmentContents_Template function(string _EnvVar) string = ""
	fg_ExportScriptEnvironmentContents_Template =+ `export @(_EnvVar)=@(GetProperty(&@(_EnvVar), "Target:*")->ToStringCompact()->Escape())\n`
	{
		&
		{
			!PlatformFamily "Windows"
			!GetProperty(&@(_EnvVar), "Target:*") undefined
		}
	}
	fg_ExportScriptEnvironmentContents_Template =+ `set @(_EnvVar)=@(GetProperty(&@(_EnvVar), "Target:*")->ToStringCompact())\r\n`
	{
		&
		{
			PlatformFamily "Windows"
			!MalterlibExportEnvironmentMinGW true
			!GetProperty(&@(_EnvVar), "Target:*") undefined
		}
	}

	fg_ExportScriptEnvironmentContents_MaybeMinGW function(string _EnvVar) string
	fg_ExportScriptEnvironmentContents_MaybeMinGW GetProperty(&@(_EnvVar), "Target:*")->ToStringCompact()->UnixPath()
	fg_ExportScriptEnvironmentContents_MaybeMinGW fg_ExportScriptEnvironmentContents_MaybeMinGW->ParseFormatString("{}:/{}", "/{0,cl}/{1}")
	{
		!!fg_ExportScriptEnvironmentContents_MaybeMinGW ~"?:*"
	}

	fg_ExportScriptEnvironmentContents_Template =+ `set @(`@(_EnvVar)=@(fg_ExportScriptEnvironmentContents_MaybeMinGW(_EnvVar))`->EscapeHost())\r\n`
	{
		&
		{
			PlatformFamily "Windows"
			MalterlibExportEnvironmentMinGW true
			!GetProperty(&@(_EnvVar), "Target:*") undefined
		}
	}
}

Target
{
	ExportScriptEnvironmentContents: string ?
	ExportScriptEnvironmentContents Target.ExportScriptEnvironment->ForEach(&fg_ExportScriptEnvironmentContents_Template)
}

