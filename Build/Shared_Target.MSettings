// Executable native targets
Target
{
	&
	{
		LanguageFamily "Native"
		TargetIsExecutable true
	}

	LinkWithLibraries =+ Builtin.Inherit
	{
		!Target.Type "Driver"
	}

	LinkWithLibraries += ["-first_object", MalterlibPosixInitFileName]
	{
		&
		{
			TargetIsExecutable true
			!Target.Type "Driver"
			!MalterlibDisableMalterlib true
			!MalterlibPosixInitFileName undefined
			!MalterlibDefaultCompiler true
			MalterlibCustomCompilerOptions true
		}
	}

	LinkWithLibraries += ["-sectcreate", "__TEXT", "__info_plist", Target:Target.MalterlibInfoPListFile]
	{

		&
		{
			!Target:Target.MalterlibInfoPListFile undefined
			!MalterlibIsOSXBundle true
		}
	}

	LinkWithLibraries += ["-framework", "CoreFoundation"]
	{
		&
		{
			PlatformIsDarwin true
			!Target.Type "Driver"
		}
	}

	LinkWithLibraries += ["-framework", "CoreServices"]
	{
		// Used for FSEvents API
		&
		{
			PlatformFamily "OSX"
			!Target.Type "Driver"
		}
	}

	LinkWithLibraries += ["-framework", "AppKit"]
	{
		&
		{
			PlatformFamily "OSX"
			!Target.Type "Driver"
		}
	}

	LinkWithLibraries += ["-framework", "Security"]
	{
		&
		{
			PlatformIsDarwin true
			!Target.Type "Driver"
		}
	}

	LinkWithLibraries += ["-framework", "Cocoa", "-framework", "IOKit", "-framework", "OpenGL"]
	{
		&
		{
			PlatformFamily "OSX"
			!Target.Type "Driver"
		}
	}

	LinkWithLibraries += ["-framework", "UIKit"]
	{
		&
		{
			PlatformFamily "iOS"
			!Target.Type "Driver"
		}
	}

	LinkWithLibraries += ["-pthread", "-ldl", "-luuid", "-lrt"]
	{
		!!PlatformFamily "Linux"
	}

	LinkWithLibraries += "-lasound"
	{
		&
		{
			PlatformFamily "Linux"
			Target.Type "UIExecutable"
		}
	}

	LinkWithLibraries += "-lc++abi"
	{
		&
		{
			PlatformIsDarwin true
			!MalterlibUseStaticLibCxxABI true
			!Target.Type "Driver"
		}
	}

	RealLinkWithLibraries define [one_of(string, [string])]?
	RealLinkWithLibraries Target.LinkWithLibraries
	{
		!!GeneratorFamily "Xcode"
	}

	RealLinkWithLibraries += MalterlibOverrideMallocLibrary
	{
		!!MalterlibNeedsMallocOverrideLibrary true
	}

	SearchPath define [string]?
	SearchPath =+ Builtin.Inherit

	SearchPath += `@("../../../SDK"->MakeAbsolute())/WDK/lib/WXP/i386`
	{
		&
		{
			PlatformType "Windows"
			Target.Type "Driver"
			Architecture "x86"
		}
	}
	SearchPath =+ `@("../../../SDK"->MakeAbsolute())/WDK/lib/WNET/amd64`
	{
		&
		{
			PlatformType "Windows"
			Target.Type "Driver"
			Architecture "x64"
		}
	}

	RemoveUnreferencedSymbols define bool?
	RemoveUnreferencedSymbols true // OptimizeReferences
	{
		&
		{
			Target.RemoveUnreferencedSymbols undefined
			DebugCompiler false
			!Configuration "Release Debug"
		}
	}
	RemoveUnreferencedSymbols false
	{
		!!Target.RemoveUnreferencedSymbols undefined
	}

}

// .NET Executable Targets
Target
{
	&
	{
		LanguageFamily ".NET"
		TargetIsExecutable true
	}

	StartAction define string?
	StartAction "Program"
}

// Windows native executable targets
Target
{
	&
	{
		LanguageFamily "Native"
		TargetIsExecutable true
		PlatformType "Windows"
	}

	IgnoreImportLibrary define bool?
	IgnoreImportLibrary true

	GenerateManifest define bool?
	GenerateManifest true
	GenerateManifest false
	{
		!!Configuration "Fast Compile"
	}

	LinkIncremental define bool?
	// Currently slower than full linking in most cases
	//
	//LinkIncremental true
	//{
	//	!!DebugCompiler true
	//}
	LinkIncremental false
	{
		!!Target.LinkIncremental undefined
	}

