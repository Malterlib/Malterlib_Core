Property
{
	IsClangCL: bool = false
	IsClangCL true
	{
		!!PlatformFamily "Windows"
	}

	f_ClangFlag function(string _Flag) string = _Flag
	f_ClangFlag `/clang:@(_Flag)`
	{
		!!IsClangCL true
	}

	f_ClangFlagsHelper function(string _Flag) [string] = []
	f_ClangFlagsHelper =+ `/clang:@(_Flag)`
	{
		!!IsClangCL true
	}

	f_ClangFlags function([string] _Flags) [string] = _Flags
	f_ClangFlags _Flags->ForEach(&f_ClangFlagsHelper)
	{
		!!IsClangCL true
	}

	// Wrap a linker flag for the clang driver (-Wl,X). Returns _Flag raw for
	// VisualStudio (which fronts link.exe natively) and for MS-linker mode on
	// Ninja (link.exe invoked directly — no driver to peel off the prefix).
	f_LinkerFlag function(string _Flag) string = _Flag
	f_LinkerFlag `-Wl,@(_Flag)`
	{
		&
		{
			GeneratorFamily "Ninja"
			!Target.UseMSLinker true
		}
	}

	f_LinkerFlagsHelper function(string _Flag) [string] = []
	f_LinkerFlagsHelper =+ `-Wl,@(_Flag)`
	{
		&
		{
			GeneratorFamily "Ninja"
			!Target.UseMSLinker true
		}
	}
	f_LinkerFlagsHelper =+ _Flag
	{
		&
		{
			GeneratorFamily "Ninja"
			Target.UseMSLinker true
		}
	}

	f_LinkerFlags function([string] _Flags) [string] = _Flags
	f_LinkerFlags _Flags->ForEach(&f_LinkerFlagsHelper)
	{
		!!GeneratorFamily "Ninja"
	}

	f_LinkerLibrary function(string _Library) string = _Library
	f_LinkerLibrary `-l@(_Library)`
	{
		!!GeneratorFamily "Ninja"
	}

	f_SourceLanguageFlag function(string _Type) string = `-x@(_Type->SwitchWithError(
		"Unsupported compile type: "
		, "C++", "c++"
		, "C", "c"
		, "ObjC++", "objective-c++"
		, "ObjC", "objective-c"
	))`
	f_SourceLanguageFlag _Type->SwitchWithError(
		"Unsupported compile type: "
		, "C++", "/TP"
		, "C", "/TC"
		, "ObjC++", "/TP"
		, "ObjC", "/TC"
	)
	{
		!!IsClangCL true
	}

	f_HeaderLanguageFlags function(string _Type) [string] = [`-x@(_Type->SwitchWithError(
		"Unsupported compile type: "
		, "C++", "c++-header"
		, "C", "c-header"
		, "ObjC++", "objective-c++-header"
		, "ObjC", "objective-c-header"
	))`]

	f_HeaderLanguageFlags [
		_Type->SwitchWithError(
			"Unsupported compile type: "
			, "C++", "/TP"
			, "C", "/TC"
			, "ObjC++", "/TP"
			, "ObjC", "/TC"
		)
		, "-Xclang"
		, "-emit-pch"
	]
	{
		!!IsClangCL true
	}
}

