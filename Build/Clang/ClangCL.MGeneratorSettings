// Windows clang-cl specific settings
// These settings translate Visual Studio compiler options to clang-cl equivalents

GeneratorSetting
{
	&
	{
		IsClangCL true
		Compiler "Clang"
	}

	Compile_RuntimeLibrary =+ {
		Flags: Compile.RuntimeLibrary->SwitchWithError(
			"Unsupported option: "
			, "Static", "/MT"
			, "StaticDebug", "/MTd"
			, "Dynamic", "/MD"
			, "DynamicDebug", "/MDd"
		)
		, Type: "unique"
	}

	Compile_CallingConvention =+ {
		Flags: Compile.CallingConvention->SwitchWithError(
			"Unsupported option: "
			, "Cdecl", "/Gd"
			, "StdCall", "/Gr"
			, "FastCall", "/Gz"
		)
		, Type: "unique"
	}

	Compile_StringPooling =+ {
		Flags: Compile.StringPooling ? [] : "/clang:-fwritable-strings"
		, Type: "unique"
	}
}

GeneratorSetting
{
	&
	{
		TargetIsExecutable true
		IsClangCL true
	}

	Target_DataExecutionPrevention =+ GeneratorSetting.f_SetSharedFlags(
		[
			{
				Tools: ["lld-link"]
				, Flags: Target.DataExecutionPrevention ? [GeneratorSetting.f_LDFlag("/NXCOMPAT")] : [GeneratorSetting.f_LDFlag("/NXCOMPAT:NO")]
			}
		]
	)

	Target_RandomizedBaseAddress =+ GeneratorSetting.f_SetSharedFlags(
		[
			{
				Tools: ["lld-link"]
				, Flags: Target.RandomizedBaseAddress ? [GeneratorSetting.f_LDFlag("/DYNAMICBASE")] : [GeneratorSetting.f_LDFlag("/DYNAMICBASE:NO")]
			}
		]
	)

	Target_LargeAddressAware =+ GeneratorSetting.f_SetSharedFlags(
		[
			{
				Tools: ["lld-link"]
				, Flags: Target.LargeAddressAware ? [GeneratorSetting.f_LDFlag("/LARGEADDRESSAWARE")] : []
			}
		]
	)

	Target_LinkIncremental =+ GeneratorSetting.f_SetSharedFlags(
		[
			{
				Tools: ["lld-link"]
				, Flags: Target.LinkIncremental ? [GeneratorSetting.f_LDFlag("/INCREMENTAL")] : [GeneratorSetting.f_LDFlag("/INCREMENTAL:NO")]
			}
		]
	)

	Target_IgnoreAllDefaultLibraries =+ GeneratorSetting.f_SetSharedFlags(
		[
			{
				Tools: ["lld-link"]
				, Flags: Target.IgnoreAllDefaultLibraries ? [GeneratorSetting.f_LDFlag("/NODEFAULTLIB")] : []
			}
		]
	)

	Target_EntryPointSymbol =+ GeneratorSetting.f_SetSharedFlags(
		[
			{
				Tools: ["lld-link"]
				, Flags: [GeneratorSetting.f_LDFlag(`/ENTRY:@(Target.EntryPointSymbol)`)]
			}
		]
	)

	Target_ModuleDefinitionFile =+ GeneratorSetting.f_SetSharedFlags(
		[
			{
				Tools: ["lld-link"]
				, Flags: [GeneratorSetting.f_LDFlag(`/DEF:@(Target.ModuleDefinitionFile)`)]
			}
		]
	)

	Target_TargetMachine =+ GeneratorSetting.f_SetSharedFlags(
		[
			{
				Tools: ["lld-link"]
				, Flags: Target.TargetMachine->SwitchWithError(
					"Unsupported machine: "
					, "MachineX64", GeneratorSetting.f_LDFlag("/MACHINE:X64")
					, "MachineX86", GeneratorSetting.f_LDFlag("/MACHINE:X86")
					, "MachineARM64", GeneratorSetting.f_LDFlag("/MACHINE:ARM64")
				)
			}
		]
	)

	Target_GenerateManifest =+ GeneratorSetting.f_SetSharedFlags(
		[
			{
				Tools: ["lld-link"]
				, Flags: Target.GenerateManifest ? [GeneratorSetting.f_LDFlag("/MANIFEST")] : [GeneratorSetting.f_LDFlag("/MANIFEST:NO")]
			}
		]
	)

	Target_Driver =+ GeneratorSetting.f_SetSharedFlags(
		[
			{
				Tools: ["lld-link"]
				, Flags: Target.Driver->SwitchWithError(
					"Unsupported option: "
					, true, GeneratorSetting.f_LDFlag("/DRIVER")
					, "UpOnly", GeneratorSetting.f_LDFlag("/DRIVER:UPONLY")
					, "WDM", GeneratorSetting.f_LDFlag("/DRIVER:WDM")
				)
			},
			{
				Tools: ["clang", "clang++", "clang-cl", "clang-cl++"]
				, Flags: `/DRIVER`
			}
		]
	)

	Target_Version =+ GeneratorSetting.f_SetSharedFlags(
		[
			{
				Tools: ["lld-link"]
				, Flags: [GeneratorSetting.f_LDFlag(`/VERSION:@(Target.Version)`)]
			}
		]
	)

	Target_SymbolFile =+ GeneratorSetting.f_SetSharedFlags(
		[
			{
				Tools: ["lld-link"]
				, Flags: [GeneratorSetting.f_LDFlag(`/PDB:@(Target.SymbolFile)`)]
			}
		]
	)

	// Strong-name key file for managed targets. Visual Studio sets this via the <KeyFile>
	// project property; for direct link.exe invocation we must pass it as /KEYFILE:.
	// Pair with /DELAYSIGN+ so the post-build sn -Ra step has a delay-signed assembly to fix up.
	Target_LinkKeyFile =+ GeneratorSetting.f_SetSharedFlags(
		[
			{
				Tools: ["lld-link"]
				, Flags: [
					GeneratorSetting.f_LDFlag(`/KEYFILE:@(Target.LinkKeyFile->WindowsPath())`)
					, GeneratorSetting.f_LDFlag("/DELAYSIGN")
				]
			}
		]
	)
	{
		!Target.LinkKeyFile undefined
	}
}

GeneratorSetting
{
	&
	{
		Target.Type "StaticLibrary"
		PlatformFamily "Windows"
		Compiler "Clang"
	}

	Target_ExtraLibFlags =+ GeneratorSetting.f_SetSharedFlags(
		[
			{
				Tools: ["llvm-lib"]
				, Flags: Target.ExtraLibFlags
			}
		]
	)

	Target_TargetMachine =+ GeneratorSetting.f_SetSharedFlags(
		[
			{
				Tools: ["llvm-lib"]
				, Flags: Target.TargetMachine->SwitchWithError(
					"Unsupported machine: "
					, "MachineX64", "/MACHINE:X64"
					, "MachineX86", "/MACHINE:X86"
					, "MachineARM64", "/MACHINE:ARM64"
				)
			}
		]
	)
}
