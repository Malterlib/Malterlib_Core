%Group "~Automatic/Prefix Headers"
{
	%Group "C++"
	{
		%File Target.AllFiles_C\+\+->ForEach(&f_GetUniquePrefixHeaders)->Unique()
		{
			Compile
			{
				Type NinjaCompileType
				PrecompilePrefixHeader "XInternalCreate"
				//PrefixHeader undefined
			}
		}
	}
	%Group "ObjC++"
	{
		%File Target.AllFiles_ObjC\+\+->ForEach(&f_GetUniquePrefixHeaders)->Unique()
		{
			Compile
			{
				Type NinjaCompileType
				PrecompilePrefixHeader "XInternalCreate"
				//PrefixHeader undefined
			}
		}
	}
	%Group "C"
	{
		%File Target.AllFiles_C->ForEach(&f_GetUniquePrefixHeaders)->Unique()
		{
			Compile
			{
				Type NinjaCompileType
				PrecompilePrefixHeader "XInternalCreate"
				//PrefixHeader undefined
			}
		}
	}
	%Group "ObjC"
	{
		%File Target.AllFiles_ObjC->ForEach(&f_GetUniquePrefixHeaders)->Unique()
		{
			Compile
			{
				Type NinjaCompileType
				PrecompilePrefixHeader "XInternalCreate"
				//PrefixHeader undefined
			}
		}
	}
}

