Property
{
	MalterlibMemoryPerLTOLink: float = 8192.0
	MalterlibThreadsPerLTOLink: int = 4
}

Workspace
{
	PoolDepths: {
		...: int
	} = {
		LTOLinkPool: Clamp((HostSystemInfo<PhysicalMemoryMiB> / MalterlibMemoryPerLTOLink)->AsInteger(), 1, Max(HostSystemInfo<PhysicalThreads> / MalterlibThreadsPerLTOLink, 1))
	}
}


GeneratorSetting
{
	Ninja_TargetType: string
	Ninja_TargetType SwitchWithError(
		Target.Type, `Unknown target type: @(Target.Type)`
		, "Executable", "Application"
		, "ConsoleExecutable", "Application"
		, "UIExecutable", "Application"
		, "DynamicLibrary", "DynamicLibrary"
		, "XcodeBundle", "DynamicLibrary"
		, "SharedDynamicLibrary", "DynamicLibrary"
		, "StaticLibrary", "StaticLibrary"
		, "Driver", "Driver"
		, "Tool", "Makefile"
	)

	Ninja_TargetExecutable: string

	// Unix/POSIX tool executables
	Ninja_TargetExecutable Target.Type->SwitchWithError(
		"Target executable in native mode is not known for target type: "
		, "StaticLibrary", (Documentation <==> "Doxygen") ? Builtin.MToolExe->GetPath() / "DoxygenLibTool/libtool" : `@(MalterlibToolsPrefix)llvm-ar`
		, "ConsoleExecutable", `@(MalterlibToolsPrefix)clang++`
		, "UIExecutable", `@(MalterlibToolsPrefix)clang++`
		, "Executable", `@(MalterlibToolsPrefix)clang++`
		, "DynamicLibrary", `@(MalterlibToolsPrefix)clang++`
		, "XcodeBundle", `@(MalterlibToolsPrefix)clang++`
		, "SharedDynamicLibrary", `@(MalterlibToolsPrefix)clang++`
		, "Driver", `@(MalterlibToolsPrefix)clang++`
		, "Tool", "false"
	)
	{
		&
		{
			LanguageFamily "Native"
			!PlatformFamily "Windows"
		}
	}

	// Windows tool executables using ClangCL toolchain
	Ninja_TargetExecutable Target.Type->SwitchWithError(
		"Target executable in native mode is not known for target type: "
		, "StaticLibrary", (Documentation <==> "Doxygen") ? Builtin.MToolExe->GetPath() / `DoxygenLibTool/libtool@(HostExecutableExtension)` : `@(MalterlibToolsPrefix)llvm-lib@(HostExecutableExtension)`
		, "ConsoleExecutable", `@(MalterlibToolsPrefix)clang++@(HostExecutableExtension)`
		, "UIExecutable", `@(MalterlibToolsPrefix)clang++@(HostExecutableExtension)`
		, "Executable", `@(MalterlibToolsPrefix)clang++@(HostExecutableExtension)`
		, "DynamicLibrary", `@(MalterlibToolsPrefix)clang++@(HostExecutableExtension)`
		, "SharedDynamicLibrary", `@(MalterlibToolsPrefix)clang++@(HostExecutableExtension)`
		, "Driver", `@(MalterlibToolsPrefix)clang++@(HostExecutableExtension)`
		, "Tool", "false"
	)
	{
		&
		{
			LanguageFamily "Native"
			PlatformFamily "Windows"
		}
	}

	// Tool type used for flag matching (separate from actual executable for clang driver usage)
	Ninja_TargetToolType: string

	// Unix/POSIX tool types
	Ninja_TargetToolType Target.Type->SwitchWithError(
		"Target tool type in native mode is not known for target type: "
		, "StaticLibrary", (Documentation <==> "Doxygen") ? "libtool" : "llvm-ar"
		, "ConsoleExecutable", "ld.lld"
		, "UIExecutable", "ld.lld"
		, "Executable", "ld.lld"
		, "DynamicLibrary", "ld.lld"
		, "XcodeBundle", "ld.lld"
		, "SharedDynamicLibrary", "ld.lld"
		, "Driver", "ld.lld"
		, "Tool", "false"
	)
	{
		&
		{
			LanguageFamily "Native"
			!PlatformFamily "Windows"
		}
	}

	// Windows tool types using ClangCL toolchain
	Ninja_TargetToolType Target.Type->SwitchWithError(
		"Target tool type in native mode is not known for target type: "
		, "StaticLibrary", "llvm-lib"
		, "ConsoleExecutable", "lld-link"
		, "UIExecutable", "lld-link"
		, "Executable", "lld-link"
		, "DynamicLibrary", "lld-link"
		, "SharedDynamicLibrary", "lld-link"
		, "Driver", "lld-link"
		, "Tool", "false"
	)
	{
		&
		{
			LanguageFamily "Native"
			PlatformFamily "Windows"
		}
	}

	// Deterministic mode modifier for llvm-ar (appended to rcs flags)
	Ninja_ArDeterministicModifier: string = ""
	Ninja_ArDeterministicModifier "D"
	{
		!!Target.LibtoolDeterministicMode true
	}

	Ninja_FirstObjects: string = ""
	Ninja_FirstObjects ` @(Target.FirstObjects->JoinEscaped(" "))`
	{
		!Target.FirstObjects undefined
	}

	Ninja_TargetCommand: string

	// Unix/POSIX command format
	Ninja_TargetCommand Target.Type->SwitchWithError(
		"Target command in native mode is not known for target type: "
		, "StaticLibrary", `@(GeneratorSetting.Ninja_TargetExecutable->Escape()) @(Builtin.Flags) rcs@(GeneratorSetting.Ninja_ArDeterministicModifier) @(Builtin.Output) @(Builtin.Input)`
		, "ConsoleExecutable", `@(GeneratorSetting.Ninja_TargetExecutable->Escape()) -o @(Builtin.Output)@(GeneratorSetting.Ninja_FirstObjects) @(Builtin.Input) @(Builtin.Flags)`
		, "UIExecutable", `@(GeneratorSetting.Ninja_TargetExecutable->Escape()) -o @(Builtin.Output)@(GeneratorSetting.Ninja_FirstObjects) @(Builtin.Input) @(Builtin.Flags)`
		, "Executable", `@(GeneratorSetting.Ninja_TargetExecutable->Escape()) -o @(Builtin.Output)@(GeneratorSetting.Ninja_FirstObjects) @(Builtin.Input) @(Builtin.Flags)`
		, "DynamicLibrary", `@(GeneratorSetting.Ninja_TargetExecutable->Escape()) -o @(Builtin.Output)@(GeneratorSetting.Ninja_FirstObjects) @(Builtin.Input) @(Builtin.Flags)`
		, "XcodeBundle", `@(GeneratorSetting.Ninja_TargetExecutable->Escape()) -o @(Builtin.Output)@(GeneratorSetting.Ninja_FirstObjects) @(Builtin.Input) @(Builtin.Flags)`
		, "SharedDynamicLibrary", `@(GeneratorSetting.Ninja_TargetExecutable->Escape()) -o @(Builtin.Output)@(GeneratorSetting.Ninja_FirstObjects) @(Builtin.Input) @(Builtin.Flags)`
		, "Driver", `@(GeneratorSetting.Ninja_TargetExecutable->Escape()) -o @(Builtin.Output)@(GeneratorSetting.Ninja_FirstObjects) @(Builtin.Input) @(Builtin.Flags)`
		, "Tool", "false"
	)
	{
		&
		{
			LanguageFamily "Native"
			!PlatformFamily "Windows"
		}
	}

	// Windows command format using clang++ driver with lld-link
	// Uses response files (@$rspfile) to avoid command line length limits
	Ninja_TargetCommand Target.Type->SwitchWithError(
		"Target command in native mode is not known for target type: "
		, "StaticLibrary", `@(GeneratorSetting.Ninja_TargetExecutable->Escape()) /nologo /OUT:@(Builtin.Output) @@@(Builtin.RspFile)`
		, "ConsoleExecutable", `@(GeneratorSetting.Ninja_TargetExecutable->Escape()) -fuse-ld=lld-link -o @(Builtin.Output) @@@(Builtin.RspFile)`
		, "UIExecutable", `@(GeneratorSetting.Ninja_TargetExecutable->Escape()) -fuse-ld=lld-link -o @(Builtin.Output) @@@(Builtin.RspFile)`
		, "Executable", `@(GeneratorSetting.Ninja_TargetExecutable->Escape()) -fuse-ld=lld-link -o @(Builtin.Output) @@@(Builtin.RspFile)`
		, "DynamicLibrary", `@(GeneratorSetting.Ninja_TargetExecutable->Escape()) -fuse-ld=lld-link -o @(Builtin.Output) @@@(Builtin.RspFile)`
		, "SharedDynamicLibrary", `@(GeneratorSetting.Ninja_TargetExecutable->Escape()) -fuse-ld=lld-link -o @(Builtin.Output) @@@(Builtin.RspFile)`
		, "Driver", `@(GeneratorSetting.Ninja_TargetExecutable->Escape()) -fuse-ld=lld-link -o @(Builtin.Output) @@@(Builtin.RspFile)`
		, "Tool", "false"
	)
	{
		&
		{
			LanguageFamily "Native"
			PlatformFamily "Windows"
		}
	}

	// Response file content for Windows linking (inputs only)
	Ninja_TargetRspfileContent: string = `@(GeneratorSetting.Ninja_FirstObjects) @(Builtin.Input) @(Builtin.Flags)`
	{
		&
		{
			LanguageFamily "Native"
			PlatformFamily "Windows"
		}
	}

	Ninja_TargetInputs: [string] = []
	Ninja_TargetImplicitInputs: [string] = []
	Ninja_TargetOutputs: [string] = []
	Ninja_TargetImplicitOutputs: [string] = []
	Ninja_TargetOrderDependencies: [string] = []
	Ninja_TargetValidationDependencies: [string] = []

	Ninja_TargetImplicitOutputs =+ MalterlibOriginalModuleDestination
	{
		&
		{
			!MalterlibOriginalModuleDestinationExecutable undefined
			!MalterlibOriginalModuleDestinationExecutable MalterlibOriginalModuleDestination
		}
	}

	f_Ninja_CalculateTargetFileInputs function(string _File) [string] = []
	f_Ninja_CalculateTargetFileInputs =+ &Compile.LinkerInputs->GetProperty(_File)

	Ninja_TargetInputs =+ Target.AllFiles->ForEach(&GeneratorSetting.f_Ninja_CalculateTargetFileInputs)

	// Collect implicit linker inputs (e.g., manifest files)
	f_Ninja_CalculateTargetFileImplicitInputs function(string _File) [string] = []
	f_Ninja_CalculateTargetFileImplicitInputs =+ &Compile.LinkerImplicitInputs->GetProperty(_File)

	Ninja_TargetImplicitInputs =+ Target.AllFiles->ForEach(&GeneratorSetting.f_Ninja_CalculateTargetFileImplicitInputs)

	// Add library dependencies as implicit inputs for executables
	// This ensures Ninja rebuilds when dependent libraries change
	Ninja_TargetImplicitInputs =+ Target:Target.Dependencies->ForEach(&GeneratorSetting.f_GetLibraryPaths)
	{
		|
		{
			TargetIsExecutable true
			Target.Type "StaticLibrary"
		}
	}

	// Get object files from ObjectLibrary dependencies
	// For ObjectLibrary dependencies, get Target.AllFiles and calculate linker inputs
	MaybeGetObjectLibraryInputs: one_of(string, [string]) = []
	MaybeGetObjectLibraryInputs (&Target.AllFiles->GetProperty(Dependency.TargetPropertyPath))->ForEach(&GeneratorSetting.f_Ninja_CalculateTargetFileInputs)
	{
		&
		{
			Dependency.Link true
			!Dependency.IndirectEvaluated true
			Dependency.ObjectLibrary true
		}
	}

	f_GetObjectLibraryInputs function(string _Dependency) [string] = []
	f_GetObjectLibraryInputs =+ &GeneratorSetting.MaybeGetObjectLibraryInputs->GetProperty(_Dependency)

	// Add object library files to target inputs for executables
	Ninja_TargetInputs =+ Target:Target.Dependencies->ForEach(&GeneratorSetting.f_GetObjectLibraryInputs)
	{
		!!TargetIsExecutable true
	}

	// Get library output path from regular (non-ObjectLibrary) dependencies
	MaybeGetLibraryPath: one_of(string, [string]) = []
	MaybeGetLibraryPath &MalterlibFinalModuleDestination->GetProperty(Dependency.TargetPropertyPath)
	{
		&
		{
			Dependency.Link true
			!Dependency.IndirectEvaluated true
			Dependency.Type ""
			!Dependency.ObjectLibrary true
		}
	}

	f_GetLibraryPaths function(string _Dependency) [string] = []
	f_GetLibraryPaths =+ &GeneratorSetting.MaybeGetLibraryPath->GetProperty(_Dependency)

	// Get LinkerGroup from dependency's target
	MaybeGetLinkerGroup: one_of(string, [string]) = []
	MaybeGetLinkerGroup &Target.LinkerGroup->GetProperty(Dependency.TargetPropertyPath)
	{
		&
		{
			Dependency.Link true
			!Dependency.IndirectEvaluated true
			Dependency.Type ""
			!Dependency.ObjectLibrary true
		}
	}

	f_GetLinkerGroup function(string _Dependency) [string] = []
	f_GetLinkerGroup =+ &GeneratorSetting.MaybeGetLinkerGroup->GetProperty(_Dependency)

	// Collect libraries grouped by LinkerGroup value
	// Dynamic object keys: group name -> array of library paths
	MaybeAddLibraryToGroup: [{Group: string, Path: string}] = []
	MaybeAddLibraryToGroup += { Group: &Target.LinkerGroup->GetProperty(Dependency.TargetPropertyPath), Path: &MalterlibFinalModuleDestination->GetProperty(Dependency.TargetPropertyPath) }
	{
		&
		{
			Dependency.Link true
			!Dependency.IndirectEvaluated true
			Dependency.Type ""
			!Dependency.ObjectLibrary true
		}
	}

	f_AddLibraryToGroup function(string _Dependency) [{Group: string, Path: string}] = []
	f_AddLibraryToGroup =+ &GeneratorSetting.MaybeAddLibraryToGroup->GetProperty(_Dependency)

	f_ToLibraryGroupedObject function({Group: string, Path: string} _Entry) {...: [string]} = {}
	f_ToLibraryGroupedObject #<@(_Entry<Group>)> += _Entry<Path>

	// Collect all library dependencies into groups
	Helper_LibraryGroups: {...: [string]} = {}
	Helper_LibraryGroups Target:Target.Dependencies->ForEach(&GeneratorSetting.f_AddLibraryToGroup)->ForEach(&GeneratorSetting.f_ToLibraryGroupedObject)

	// Wrap linker group with --start-group/--end-group on Linux when enabled
	f_WrapLinkerGroup function(string _GroupName, [string] _Paths) [string] = []
	f_WrapLinkerGroup =+ ["-Wl,--start-group", _Paths..., "-Wl,--end-group"]
	{
		&
		{
			PlatformFamily "Linux"
			Target.EnableLinkerGroups true
			!_Paths->IsEmpty() true
		}
	}
	f_WrapLinkerGroup =+ _Paths
	{
		|
		{
			!PlatformFamily "Linux"
			!Target.EnableLinkerGroups true
		}
	}

	// Process all groups and wrap them appropriately
	Helper_WrappedLibraries: [string] = []
	Helper_WrappedLibraries =+ GeneratorSetting.Helper_LibraryGroups->ForEach(&GeneratorSetting.f_WrapLinkerGroup)
	{
		!!TargetIsExecutable true
	}

	// Bash executable for script execution (Git Bash on Windows)
	Ninja_BashExecutable: string = "/bin/bash"
	Ninja_BashExecutable "C:/Program Files/Git/bin/bash.exe"
	{
		!!PlatformFamily "Windows"
	}

	Target {
		Rule_PreBuild: {
			All: {
				Positions: []
				, Rule: {
					command: `@(GeneratorSetting.Ninja_BashExecutable->Escape()) @(Builtin.Dollar)script_file`
					, restat: true
					, environment: {
						PATH: `@(Target:Target.ToolPath->Join(PathSeparator))@(PathSeparator)@(PATH)`
						, <<: Target:Target.ExportScriptEnvironment->ForEach(&fg_ExportScriptEnvironmentContentsNinja_Template)
					}
				}
				, Build: {
					description: `@(Target:Target.Name) pre build`
					, outputs: Target:Target.PreBuildScriptOutputs
					, order_dependencies: [Target:Target.Dependencies->ForEach(&GeneratorSetting.f_GetCompileDependencies)...]
					, implicit_dependencies: [Target:Target.PreBuildScriptFile, Target:Target.PreBuildScriptInputs...]
					, script_file: Target:Target.PreBuildScriptFile->Escape()
				}
			}
		}
		, Rule_Build: {
		}
		, Rule_PostBuild: {
			All: {
				Positions: []
				, Rule: {
					command: `@(GeneratorSetting.Ninja_BashExecutable->Escape()) @(Builtin.Dollar)script_file`
					, restat: true
					, environment: {
						PATH: `@(Target:Target.ToolPath->Join(PathSeparator))@(PathSeparator)@(PATH)`
						, <<: Target:Target.ExportScriptEnvironment->ForEach(&fg_ExportScriptEnvironmentContentsNinja_Template)
					}
				}
				, Build: {
					description: `@(Target:Target.Name) post build`
					, outputs: Target:Target.PostBuildScriptOutputs
					, implicit_dependencies: [Target:Target.PostBuildScriptFile, Target:Target.PostBuildScriptInputs...]
					, script_file: Target:Target.PostBuildScriptFile->Escape()
				}
			}
		}
		, OtherRules: [
			{
				TargetPostBuildPhony: {
					Positions: []
					, Rule: {
						phony: true
					}
					, Build: {
						outputs: [`@(Target:Target.Name) post build`]
						, order_dependencies: Target:Target.PostBuildScriptOutputs
					}
				}
			}
		]
	}

	f_ExtractTargetSettings function([type(CSharedSettingsWithPosition)] _Settings) any
	f_ExtractTargetSettings {
		Rule_Build: _Settings->ForEach(&GeneratorSetting.f_ExtractTargetSettingsFlags)
	}

	Target =+ GeneratorSetting.f_ExtractTargetSettings(GeneratorSetting.DefinedProperties->ForEach(&GeneratorSetting.f_GetSettings))

	MaybeGetLinkDependency: one_of(string, [string]) = []
	MaybeGetLinkDependency `@(Dependency.Name) post build`
	{
		&
		{
			!Dependency.IndirectEvaluated true
			Dependency.Stage "Link"
			Dependency.Type ""
		}
	}

	f_GetLinkDependencies function(string _Dependency) [string] = []
	f_GetLinkDependencies =+ &GeneratorSetting.MaybeGetLinkDependency->GetProperty(_Dependency)

	Target #<OtherRules> =+ {
		TargetLinkDependencies: {
			Positions: []
			, Rule: {
				phony: true
			}
			, Build: {
				outputs: [GeneratorSetting.TargetPhony_LinkDependencies]
				, order_dependencies: Target:Target.Dependencies->ForEach(&GeneratorSetting.f_GetLinkDependencies)
			}
		}
	}

	MaybeGetValidationDependency: one_of(string, [string]) = []
	MaybeGetValidationDependency `@(Dependency.Name) post build`
	{
		&
		{
			!Dependency.IndirectEvaluated true
			Dependency.Stage "Runtime"
			Dependency.Type ""
		}
	}

	f_GetValidationDependencies function(string _Dependency) [string] = []
	f_GetValidationDependencies =+ &GeneratorSetting.MaybeGetValidationDependency->GetProperty(_Dependency)

	Target #<OtherRules> =+ {
		TargetValidationDependencies: {
			Positions: []
			, Rule: {
				phony: true
			}
			, Build: {
				outputs: [GeneratorSetting.TargetPhony_ValidationDependencies]
				, validations: Target:Target.Dependencies->ForEach(&GeneratorSetting.f_GetValidationDependencies)
			}
		}
	}

	MaybeGetCompileDependency: one_of(string, [string]) = []
	MaybeGetCompileDependency `@(Dependency.Name) post build`
	{
		&
		{
			!Dependency.IndirectEvaluated true
			Dependency.Stage "Compile"
			Dependency.Type ""
		}
	}

	f_GetCompileDependencies function(string _Dependency) [string] = []
	f_GetCompileDependencies =+ &GeneratorSetting.MaybeGetCompileDependency->GetProperty(_Dependency)

	Target #<OtherRules> =+ {
		TargetCompileDependencies: {
			Positions: []
			, Rule: {
				phony: true
			}
			, Build: {
				outputs: [GeneratorSetting.TargetPhony_CompileDependencies]
				, order_dependencies: Target:Target.PreBuildScriptOutputs
			}
		}
	}

	Target #<OtherRules> =+ {
		TargetPhonyOutputs: {
			Positions: []
			, Rule: {
				phony: true
			}
			, Build: {
				outputs: Target.PhonyOutputs
			}
		}
	}
	{
		&
		{
			!Target.PhonyOutputs undefined
			!Target.PhonyOutputs []
		}
	}
}

GeneratorSetting
{
	Ninja_TargetOrderDependencies =+ [GeneratorSetting.TargetPhony_LinkDependencies, GeneratorSetting.TargetPhony_CompileDependencies]
	Ninja_TargetValidationDependencies [GeneratorSetting.TargetPhony_ValidationDependencies]

	Target_Type #<Build.order_dependencies> =+ GeneratorSetting.Ninja_TargetOrderDependencies
	Target_Type #<Build.validations> =+ GeneratorSetting.Ninja_TargetValidationDependencies

	Target_Type #<Rule.environment> += Target.ExportScriptEnvironment->ForEach(&fg_ExportScriptEnvironmentContentsNinja_Template)
	Target_Type #<Rule.environment> += {
		PATH: `@(Target.ToolPath->Join(PathSeparator))@(PathSeparator)@(PATH)`
	}
	{
		&
		{
			!Target.ToolPath undefined
			!Target.ToolPath []
		}
	}

	Target #<OtherRules> =+ {
		CleanStaticLibrary: {
			Positions: []
			, Rule: {
				command: `@(GeneratorSetting.Ninja_BashExecutable->Escape()) -c "rm -f @(Builtin.Dollar)target && touch @(Builtin.Dollar)prepfile"`
				, restat: true
			}
			, Build: {
				outputs: [`@(Target.IntermediateDirectory / MalterlibOriginalModuleDestinationExecutable->GetFile()).prep`]
				, description: `Preparing @(Builtin.Dollar)target`
				, inputs: GeneratorSetting.Ninja_TargetInputs
				, implicit_dependencies: GeneratorSetting.Ninja_TargetImplicitInputs
				, order_dependencies: GeneratorSetting.Ninja_TargetOrderDependencies
				, target: MalterlibOriginalModuleDestinationExecutable->EscapeBash()->EscapeBash()->RemovePrefix('"')->RemoveSuffix('"')
				, prepfile: `@(Target.IntermediateDirectory / MalterlibOriginalModuleDestinationExecutable->GetFile()).prep`->EscapeBash()->EscapeBash()->RemovePrefix('"')->RemoveSuffix('"')
			}
		}
	}
	{
		!!Target.Type "StaticLibrary"
	}
}

GeneratorSetting
{
	TargetIsExecutable true

	// macOS/iOS/DriverKit: Use -dead_strip
	Target_RemoveUnreferencedSymbols =+ GeneratorSetting.f_SetSharedFlags(
		[
			{
				Tools: ["ld", "ld.lld", "lld"]
				, Flags: Target.RemoveUnreferencedSymbols ? ["-dead_strip"] : []
			}
		]
	)
	{
		|
		{
			PlatformFamily "macOS"
			PlatformFamily "iOS"
			PlatformFamily "DriverKit"
		}
	}

	// Linux: Use --gc-sections
	Target_RemoveUnreferencedSymbols =+ GeneratorSetting.f_SetSharedFlags(
		[
			{
				Tools: ["ld", "ld.lld", "lld"]
				, Flags: Target.RemoveUnreferencedSymbols ? [["-Xlinker", "--gc-sections"]] : []
			}
		]
	)
	{
		!!PlatformFamily "Linux"
	}

	Target_RemoveUnreferencedSymbols =+ GeneratorSetting.f_SetSharedFlags(
		[
			{
				Tools: ["lld-link"]
				, Flags: Target.RemoveUnreferencedSymbols ? [["-Wl,/OPT:REF"]] : []
			}
		]
	)
	{
		!!PlatformFamily "Windows"
	}

	f_PrefixWithL function(string _Path) [string] = []
	f_PrefixWithL =+ `-L@(_Path)`

	Target_SearchPath =+ GeneratorSetting.f_SetSharedFlags(
		[
			{
				Tools: ["ld", "ld.lld", "lld", "libtool"]
				, Flags: Target.SearchPath->ForEach(&GeneratorSetting.f_PrefixWithL)
			}
		]
	)
	{
		!PlatformFamily "Windows"
	}

	f_PrefixWithLibPath function(string _Path) [string] = []
	f_PrefixWithLibPath =+ `-Wl,/LIBPATH:@(_Path)`

	Target_SearchPath =+ GeneratorSetting.f_SetSharedFlags(
		[
			{
				Tools: ["lld-link"]
				, Flags: Target.SearchPath->ForEach(&GeneratorSetting.f_PrefixWithLibPath)
			}
		]
	)
	{
		!!PlatformFamily "Windows"
	}
}

GeneratorSetting
{
	!!Target.Type "Tool"

	Target_Type #<Build.description> `Running @(this.Identity->GetFile())`

	Target_CommandLine_Build #<Rule.command> `@(GeneratorSetting.Ninja_BashExecutable->Escape()) -c @(Target.CommandLine_Build->Escape())`
	Target_CommandLine_Build #<Rule.restat> true
	Target_CommandLine_AlwaysDirty #<Build.implicit_dependencies> =+ (Target.CommandLine_AlwaysDirty ? [".AlwaysDirty"] : [])

	Target_CommandLine_Inputs #<Build.implicit_dependencies> =+ Target.CommandLine_Inputs
	Target_CommandLine_Outputs #<Build.outputs> =+ Target.CommandLine_Outputs
	Target_CommandLine_IsGenerator #<Rule.generator> Target.CommandLine_IsGenerator

	Target_CommandLine_ReBuild {}
	Target_CommandLine_Clean {}
}

GeneratorSetting
{
	!!TargetIsLinkable true

	Target_Type #<Rule.command> GeneratorSetting.Ninja_TargetCommand

	// Enable restat for macOS bundles so ninja re-checks mtimes after bundle creation
	Target_Type #<Rule.restat> true
	{
		!!MalterlibIsMacOSBundle true
	}

	// Response file for Windows to handle long command lines
	Target_Type #<Rule.rspfile> Target.IntermediateDirectory / "link.rsp"
	{
		!!PlatformFamily "Windows"
	}
	Target_Type #<Rule.rspfile_content> GeneratorSetting.Ninja_TargetRspfileContent
	{
		!!PlatformFamily "Windows"
	}

	Target_Type #<Build.description> Target:Target.Name

	Target_Type #<Build.outputs> =+ MalterlibOriginalModuleDestinationExecutable
	Target_Type #<Build.outputs> =+ GeneratorSetting.Ninja_TargetOutputs

	Target_Type #<Build.inputs> =+ GeneratorSetting.Ninja_TargetInputs
	Target_Type #<Build.order_dependencies> =+ `@(Target.IntermediateDirectory / MalterlibOriginalModuleDestinationExecutable->GetFile()).prep`
	{
		!!Target.Type "StaticLibrary"
	}

	Target_Type #<Build.implicit_outputs> =+ GeneratorSetting.Ninja_TargetImplicitOutputs
	Target_Type #<Build.implicit_dependencies> =+ GeneratorSetting.Ninja_TargetImplicitInputs
}

GeneratorSetting
{
	Target_PhonyOutputs =+ {}
