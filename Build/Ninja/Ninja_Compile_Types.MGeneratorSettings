GeneratorSetting
{
	!!Compiler "Clang"

	Compile_BuiltinSearchPath =+ {
		Flags: Compile.BuiltinSearchPath->f_PrefixFlags("-I")
		, Type: "unique"
	}
}

Property
{
	CompileSupported: bool = false
	CompileSupported !([
		"CSS"
		, "PNG"
		, "Header"
		, "JavaScript"
		, "JSON"
		, "MalterlibBuildSystem"
		, "None"
		, "PList"
		, "Python"
		, "ShellScript"
		, "SVG"
		, "VisualStudioVisualizer"
		, "XML"
		, "HTML"
	]->ContainsListElement(Compile.Type
	))
	{
		&
		{
			!Compile.Type undefined
			!Compile.Type ""
		}
	}
}

Compile
{
	Disabled true
	{
		!CompileSupported true
	}

	BuildDisabled: bool = false
}

GeneratorSetting
{
	|
	{
		Compile.Type "Custom"
		Compile.GenericCompileType "GenericCustom"
	}

	CalculateCommandLine: string
	CalculateCommandLine `set -eo pipefail\n`\
	`@(Compile.Custom_CommandLine)\n`

	Compile_Custom_CommandLine #<Rule.command> `@(Compile.Custom_Shell) @(GeneratorSetting.CalculateCommandLine->Escape())`
	{
		!Compile.Custom_Shell undefined
	}
	Compile_Custom_CommandLine #<Rule.command> Compile.Custom_CommandLine
	{
		!!Compile.Custom_Shell undefined
	}

	Compile_Type #<Build.description> `Custom rule @(this.Identity->GetFile())`
	Compile_Custom_Outputs #<Build.outputs> =+ Compile.Custom_Outputs
	Compile_Custom_Inputs #<Build.implicit_dependencies> =+ Compile.Custom_Inputs
	Compile_Custom_WorkingDirectory #<Rule.command_cwd> Compile.Custom_WorkingDirectory

	Compile_Type #<Rule.environment> += Target.ExportScriptEnvironment->ForEach(&fg_ExportScriptEnvironmentContentsNinja_Template)
	Compile_Type #<Rule.environment> += {
		PATH: `@(Target.ToolPath->Join(":")):@(PATH)`
	}
	{
		&
		{
			!Target.ToolPath undefined
			!Target.ToolPath []
		}
	}
}

Compile
{
	CompileTypeDependencies =+ "Custom"
	{
		!!ClangCanCompile true
	}
}

Property
{
	AllCompileTypeDependencies =+ "Custom"
}

GeneratorSetting
{
	Compile_Custom_Shell += {}
	{
		!!GeneratorSetting.Compile_Custom_Shell undefined
	}
}

GeneratorSetting
{
	&
	{
		Compile.Type "Assembler"
		!PlatformFamily "Windows" // Uses MASM
	}

	Compile_SearchPath =+ {
		Flags: Compile.SearchPath->f_PrefixFlags("-I")
		, Type: "unique"
	}

	Compile_PreprocessorDefines =+ {
		Flags: Compile.PreprocessorDefines->f_PrefixFlags("-D")
		, Type: "unique"
	}

	Compile_AllCPUSubTypes =+ {
		Flags: Compile.AllCPUSubTypes->SwitchWithError(
			"Unsupported option: "
			, true, "-force_cpusubtype_ALL"
			, false, []
		)
		, Type: "unique"
	}

	Compile_Optimize {}
}

Property
{
	f_GetObjectOutputs function(string _Output) [string] = []
	f_GetObjectOutputs =+ _Output
	{
		|
		{
			_Output->GetExtension() "o"
			_Output->GetExtension() "obj"
			_Output->GetExtension() "a"
		}
	}

	f_GetHeaderOutputs function(string _Output) [string] = []
	f_GetHeaderOutputs =+ _Output
	{
		|
		{
			_Output->GetExtension() "h"
			_Output->GetExtension() "hpp"
			_Output->GetExtension() "hxx"
			_Output->GetExtension() "i"
			_Output->GetExtension() "ipp"
			_Output->GetExtension() "ixx"
		}
	}
}

Compile
{
	&
	{
		|
		{
			Compile.Type "Custom"
			Compile.GenericCompileType "GenericCustom"
		}
		!Compile.Disabled true
	}

	LinkerInputs =+ (Compile.Custom_Outputs || [])->ForEach(&f_GetObjectOutputs)
}

Target
{
	AllFiles_Custom: [string] = []

}

GeneratorSetting
{
	Target_AllFiles_Custom {}

	CompileTypeOutputs_Custom: [string] = []
	CompileTypeOutputs_Custom =+ (Compile.Custom_Outputs || [])->ForEach(&f_GetHeaderOutputs)
}
