// DriverKit Interface Generator (iig) support for Ninja generator
// Processes .iig files to generate header and implementation files

Property
{
	// Path to the iig tool in the Xcode toolchain
	IIGToolPath: string = `@(Malterlib_MacOSDeveloperLocaction)/Toolchains/XcodeDefault.xctoolchain/usr/bin/iig`
}

// Collect all DriverKitInterface files in the target
Target
{
	AllFiles_DriverKitInterface: [string] = []
}

GeneratorSetting
{
	Target_AllFiles_DriverKitInterface {}
}

// Define properties for generated files from iig
Property
{
	// Generated implementation file entity for injection
	IIG_GeneratedFile_Cpp: one_of(type(CEntity), [any]) = []

	IIG_GeneratedFile_Cpp {
		Name: Compile.IIG_ImplOutput
		, Properties: {
		}
	}
	{
		&
		{
			Compile.Type "DriverKitInterface"
			Target.DriverType "DriverKit"
		}
	}
}

Compile
{
	&
	{
		Compile.Type "DriverKitInterface"
		Target.DriverType "DriverKit"
	}

	// Generated header file output path (in IntermediateDirectory)
	IIG_HeaderOutput: string = Target.IntermediateDirectory / `@(this.Identity->GetFileNoExt()).h`

	// Generated implementation file output path (in IntermediateDirectory)
	IIG_ImplOutput: string = Target.IntermediateDirectory / `@(this.Identity->GetFileNoExt()).iig.cpp`

	// Dependency file for tracking header includes
	DepFileName: string = Target.IntermediateDirectory / `@(this.Identity->GetFileNoExt()).iig.d`
}

GeneratorSetting
{
	&
	{
		PlatformFamily "macOS"
		Compile.Type "DriverKitInterface"
		Target.DriverType "DriverKit"
	}

	Compile_Type #<Build.inputs> =+ this.Identity

	// iig command: --def <input> --header <header output> --impl <impl output> -- <clang args>
	Compile_Type #<Rule.command> `@(IIGToolPath->Escape()) --def @(Builtin.Input) --header @(Compile.IIG_HeaderOutput->Escape()) --impl @(Compile.IIG_ImplOutput->Escape()) --deployment-target @(Target.DriverkitDeploymentTarget) -- @(Builtin.Flags)`

	Compile_Type #<Build.description> `Generating DriverKit interface @(this.Identity->GetFile())`

	// Output the header file as primary output, implementation as implicit
	Compile_Type #<Build.outputs> =+ Compile.IIG_HeaderOutput
	Compile_Type #<Build.implicit_outputs> =+ Compile.IIG_ImplOutput

	// Include paths for iig preprocessing
	Compile_SearchPath =+ {
		Flags: Compile.SearchPath->f_PrefixFlags("-I")
		, Type: "unique"
	}

	Compile_SystemSearchPath =+ {
		Flags: Compile.SystemSearchPath->f_PrefixFlags("-isystem")
		, Type: "unique"
	}

	Compile_FrameworkSearchPath =+ {
		Flags: Compile.FrameworkSearchPath->f_PrefixFlags("-F")
		, Type: "unique"
	}

	Compile_PreprocessorDefines =+ {
		Flags: Compile.PreprocessorDefines->f_PrefixFlags("-D")
		, Type: "unique"
	}

	// SDK root for DriverKit headers
	Compile_SDKRoot =+ {
		Flags: ["-isysroot", Compile.SDKRoot->GeneratorSetting.f_GetSDKPath()]
	}

	// Source language type (iig processes C++ code)
	Compile_Type =+ {
		Flags: ["-x", "c++"]
		, FlagsPriority: 1000
	}

	// C++ language standard
	Compile_CxxLanguage =+ {
		Flags: Compile.CxxLanguage->SwitchWithError(
			"Unknown C++ language option: "
			, "C++11", "-std=c++11"
			, "C++14", "-std=c++14"
			, "C++17", "-std=c++17"
			, "C++20", "-std=c++20"
			, "C++23", "-std=c++23"
			, "GNU++11", "-std=gnu++11"
			, "GNU++14", "-std=gnu++14"
			, "GNU++17", "-std=gnu++17"
			, "GNU++20", "-std=gnu++20"
			, "GNU++23", "-std=gnu++2b"
		)
	}

	// Empty handlers for settings not applicable to iig
	Compile_Optimize =+ {}
	Compile_Warnings =+ {}
	Compile_WarningsAsErrors =+ {}
	Compile_Symbols =+ {}
	Compile_ObjectFileName =+ {}
	Compile_PrecompilePrefixHeader =+ {}
	Compile_PrefixHeader =+ {}
	Compile_TargetTriple =+ {}

	// Handlers for IIG-specific properties (output handled via Build.outputs above)
	Compile_IIG_HeaderOutput =+ {}
	Compile_IIG_ImplOutput =+ {}

	// Dependency file support for tracking header includes
	Compile_DepFileName =+ {
		Flags: ["-MD", `-MF@(Compile.DepFileName)`]
	}

	Compile_DepFileName #<Build.depfile> Compile.DepFileName

	Compile_DepFileName #<Rule.depfile> `@(Builtin.Dollar)depfile`
	Compile_DepFileName #<Rule.deps> "gcc"
}

// Group for injecting generated C++ files to be compiled
Property
{
	f_GetIIGGeneratedCpp function(string _File) [type(CEntity)] = []
	f_GetIIGGeneratedCpp =+ &IIG_GeneratedFile_Cpp->GetProperty(_File)
}

%Group "~Automatic/Generated/DriverKitInterface"
{
	Compile.AllowNonExisting true

	%Group "Cpp"
	{
		%File Target.AllFiles_DriverKitInterface->ForEach(&f_GetIIGGeneratedCpp)->Unique()
		{
			Compile
			{
				Type "C++"

				// Add IntermediateDirectory to search path so generated headers can be found
				SearchPath =+ Target:Target.IntermediateDirectory
			}
		}
	}
}

Target
{
	ExtraGroups =+ "~Automatic/Generated/DriverKitInterface"
	{
		&
		{
			Target.DriverType "DriverKit"
			LanguageFamily "Native"
		}
	}
}
