Property
{
	MalterlibDebugConfigureLLDBScript true // User(Debug)=false: Configure Malterlib lldb helpers in ~/.lldbinit automatically when building
	{
		!!MalterlibDebugConfigureLLDBScript ""
	}
}

%Target "Tool_GenerateBuildSystem"
{
	Property
	{
		IntermediateDirectoriesFile "@(GeneratedDirectory)IntermediateDirectories.txt"
	}
	Target
	{
		BaseName "GenerateBuildSystem"
		Type "Tool"
		CommandLine_Build "\"@(Builtin.Function->GetProperty('Property', 'Name', 'Target:Tool_GenerateBuildSystem.Group:Source.Group:Build System Generated Files.GenerateFile:Generate'))\" Build \"@(IntermediateDirectoriesFile)\""
		CommandLine_ReBuild "\"@(Builtin.Function->GetProperty('Property', 'Name', 'Target:Tool_GenerateBuildSystem.Group:Source.Group:Build System Generated Files.GenerateFile:Generate'))\" ReBuild \"@(IntermediateDirectoriesFile)\""
		CommandLine_Clean "\"@(Builtin.Function->GetProperty('Property', 'Name', 'Target:Tool_GenerateBuildSystem.Group:Source.Group:Build System Generated Files.GenerateFile:Generate'))\" Clean \"@(IntermediateDirectoriesFile)\""
		Output "@(Builtin.GeneratorStateFile)"
		Group "Tools/Malterlib"
	}
	%Group "Source"
	{
		%Group "Post Copy"
		{
			%File "@(MalterlibPostCopyConfigFile)"
			{
				Compile.AllowNonExisting true
			}
		}
		%Group "Build System Source"
		{
			Compile.AllowNonExisting true
			%Group "Build System"
			{
				%File "@(Builtin.Function->SourceFiles('*.MBuildSystem*'))"
				%File "@(Builtin.Function->SourceFiles('*.OldMBuildSystem'))"
			}
			%Group "Headers"
			{
				%File "@(Builtin.Function->SourceFiles('*.MHeader*'))"
			}
			%Group "Include Headers"
			{
				%File "@(Builtin.Function->SourceFiles('*.MInclude*'))"
			}
			%Group "Settings"
			{
				%File "@(Builtin.Function->SourceFiles('*.MSettings*'))"
			}
			%Group "Targets"
			{
				%File "@(Builtin.Function->SourceFiles('*.MTarget*'))"
			}
			%Group "Generator Settings"
			{
				%File "@(Builtin.Function->SourceFiles('*.MGeneratorSettings*'))"
			}
			%Group "Dependency"
			{
				%File "@(Builtin.Function->SourceFiles('*.MDependency*'))"
			}
			%Group "Workspace"
			{
				%File "@(Builtin.Function->SourceFiles('*.MWorkspace*'))"
			}
			%Group "CMake"
			{
				%File "@(Builtin.Function->SourceFiles('*/CMakeLists.txt'))"
				%File "@(Builtin.Function->SourceFiles('*.cmake'))"
			}
		}
		%Group "vs-tool"
		{
			!!GeneratorFamily "VisualStudio"
			/*
			%File "c:/Program Files (x86)/MSBuild/Microsoft.Cpp/v4.0/V120/Platforms/Clang/*"
			%Group "Props"
			{
				%File "c:/Program Files (x86)/MSBuild/Microsoft.Cpp/v4.0/V120/Platforms/Clang/Props/*"
			}
			%Group "PlatformToolsets"
			{
				%Group "clang"
				{
					%File "c:/Program Files (x86)/MSBuild/Microsoft.Cpp/v4.0/V120/Platforms/Clang/PlatformToolsets/clang/*"
				}
			}
			 */
		}
		/*
		%Group "emscripten"
		{
			Compile
			{
				!!MalterlibCompileSupportTabSetings true
				IndentWidth 2
				TabWidth 2
				UsesTabs false
			}

			%File "/opt/Development/Malterlib/llvm/unstable-emscripten/emscripten/*.py"
			%File "/opt/Development/Malterlib/llvm/unstable-emscripten/emscripten/em*"
			%Group "tools"
			{
				%File "/opt/Development/Malterlib/llvm/unstable-emscripten/emscripten/tools/*.py"
				%File "/opt/Development/Malterlib/llvm/unstable-emscripten/emscripten/tools/*.js"
			}
			%Group "Library"
			{
				%File "/opt/Development/Malterlib/llvm/unstable-emscripten/emscripten/src/*"
			}
		}*/
		%Group "MSBuild Targets"
		{
			Compile.Type "XML"
			{
				!GeneratorFamily "VisualStudio"
			}
			%File "VisualStudio/*.props"
			%File "VisualStudio/*.targets"
			%File "VisualStudio/*.xml"
		}
		%Group "Build System Generated Files"
		{
			%GenerateFile "IntermediateDirectories"
			{
				&
				{
					GeneratorFamily "Xcode"
				}
				Property
				{
					IntermediateDirectoriesTemplate "@(Builtin.Function->GetProperty('Target', 'IntermediateDirectory', '@(Explodee)'))MalterlibDependencies\n"
					{
						!Explodee ""
					}

					IntermediateDirectoriesContents	"@(IntermediateDirectoriesContents)"\
													"@(Builtin.Function->ExplodeList('@(Workspace.AllTargets)', ';', 'IntermediateDirectoriesTemplate'))"

					Name "@(IntermediateDirectoriesFile)"
					Contents "@(IntermediateDirectoriesContents)"
					Executable false
					UnicodeBOM true
					UnixLineEnds true
				}
				Compile
				{
					Type "None"
				}
			}
			%GenerateFile "Generate"
			{
				Property
				{
					Name "@(BuildSystemOutputDir)/Files/@(Workspace:Workspace.Name)/@(Target:Target.Name)/GenerateBuildSystem_@(Workspace:Workspace.Name)_@(Platform)_@(Architecture)@(ScriptExtension)"

					Contents	"@(Contents)"\
								"IF \"%DisableProjectGen%\" == \"1\" GOTO Skip\r\n"\
								":RetryGeneration\r\n"\
								"cd @(Builtin.BasePathAbsolute->WindowsPath())\r\n"\
								"\"@(Builtin.MalterlibExe)\" generate --build-system \"@(Builtin.BuildSystemSource)\" --generator \"@(Generator)\" --output-directory \"@(Builtin.GeneratedBuildSystemDir)\" --use-cached-environment --action \"%1\" \"@(Workspace:Workspace.Name)\"\r\n"\
								"IF %ERRORLEVEL% EQU 2 set ERRORLEVEL=0\r\n"
					{
						&
						{
							!MalterlibDisableBuildSystemGeneration true
							HostPlatformFamily "Windows"
						}
					}


					MToolDirectory "@(Builtin.MToolExe->GetPath())"
					IsSafeMTool true
					{
						!!MToolDirectory "@(Builtin.BasePathAbsolute)/BuildSystem/Binaries/General/Windows"
					}

					BuildSystemBasePath "@(Builtin.BasePathAbsolute)/BuildSystem"
					BinariesPath "@(Builtin.BasePathAbsolute)/Binaries/Malterlib"
					DependencyFile "@(BuildSystemBasePath)/Binaries/Binaries.MalterlibDependency"
					UpdatedFile "@(BuildSystemBasePath)/Binaries.updated"
					ExcludePatterns "*/.git;*/.DS_Store"

					Contents	"@(Contents)"\
								"if exist \"@(DependencyFile)\" \"@(Builtin.MToolExe)\" CheckDependencies Verbose=true \"Directory=@(BuildSystemBasePath)/Binaries\"\r\n"\
								"if not exist \"@(UpdatedFile)\" (\r\n"\
								"	echo Updated needed\r\n"\
								"	\"@(Builtin.MToolExe)\" DiffCopy \"@(BinariesPath)/General/Windows\" \"@(BuildSystemBasePath)/Binaries/General\"\r\n"\
								"	\"@(Builtin.MToolExe)\" DiffCopy \"@(BinariesPath)/*.sh\" \"@(BuildSystemBasePath)/Binaries\" \"\" 0\r\n"\
								"	\"@(Builtin.MToolExe)\" TouchOrCreate \"@(UpdatedFile)\"\r\n"\
								"	\"@(Builtin.MToolExe)\" BuildDependencies \"OutputFile=@(DependencyFile)\" \"Output:@(UpdatedFile)\" \"Input:@(Builtin.BasePathAbsolute)/mib\" \"Find:@(BinariesPath)/*;RIF;33;@(ExcludePatterns)\"\r\n"\
								"	if exist \"@(UpdatedFile)\" GOTO RetryGeneration\r\n"\
								")\r\n"
					{
						&
						{

							!MalterlibDisableBuildSystemGeneration true
							HostPlatformFamily "Windows"
							IsSafeMTool true
						}
					}

					LLDBScriptLocation "@('../../Debug/Source/Malterlib_LLDB'->MakeAbsolute())"

					Contents	"@(Contents)"\
								"if ! grep ~/.lldbinit -qe '#StartMalterlibLLDB'; then\r\n"\
								"	echo '#StartMalterlibLLDB' >> ~/.lldbinit\r\n"\
								"	echo '#EndMalterlibLLDB' >> ~/.lldbinit\r\n"\
								"fi\r\n"\
								"sed -i '' $'/#StartMalterlibLLDB/,/#EndMalterlibLLDB/c\\\\\\n#StartMalterlibLLDB\\\\\\ncommand script import \"@(LLDBScriptLocation)\"\\\\\\n#EndMalterlibLLDB\\n' ~/.lldbinit\r\n"
					{
						&
						{

 							MalterlibDebugConfigureLLDBScript true
							!MalterlibDisableBuildSystemGeneration true
							!HostPlatformFamily "Windows"
						}
					}

					Contents	"@(Contents)"\
								":Skip\r\n"
					{
						&
						{
							!MalterlibDisableBuildSystemGeneration true
							HostPlatformFamily "Windows"
						}
					}

					Contents	"@(Contents)"\
								"if [ \"$DisableProjectGen\" == \"1\" ]; then\n"\
								"  exit 0\n"\
								"fi\n"\
								"cd @(Builtin.BasePathRelativeProject)/..\n"\
								"\"@(Builtin.MalterlibExe)\" generate --build-system \"@(Builtin.BuildSystemSource)\" --generator \"@(Generator)\" --output-directory \"@(Builtin.GeneratedBuildSystemDir)\" --action \"$1\" --use-cached-environment \"@(Workspace:Workspace.Name)\"\n"\
								"ErrorLevel=$?\n"\
								"if [ \"$ErrorLevel\" == \"2\" ]; then\n"\
								"  echo error: Build system changed, aborting build\n"\
								"  exit 1\n"\
								"fi\n"\
								"if [ \"$ErrorLevel\" != \"0\" ]; then\n"\
								"  echo error: Build system generation failed\n"\
								"  exit 1\n"\
								"fi\n"
					{
						&
						{
							!MalterlibDisableBuildSystemGeneration true
							!HostPlatformFamily "Windows"
						}
					}

					Contents	"@(Contents)"\
								"@(MalterlibBuildDependenciesContents)"

					LibToolCopy_BinariesDirectory "@(PlatformToolsetCompilerBasePath)/bin"
					LibToolCopy_UpdatedFile "@(LibToolCopy_BinariesDirectory)/Malterlib_libtool.updated"
					LibToolCopy_DependencyFile "@(LibToolCopy_BinariesDirectory)/Malterlib_libtool.MalterlibDependency"

					Contents	"@(Contents)"\
								"if [ -f \"@(LibToolCopy_DependencyFile)\" ]; then\n"\
								"	\"@(Builtin.MToolExe)\" CheckDependencies Verbose=true \"Directory=@(LibToolCopy_BinariesDirectory)\"\n"\
								"fi\n"\
								"if ! [ -f \"@(LibToolCopy_UpdatedFile)\" ] || ! [ -f \"@(LibToolCopy_BinariesDirectory)/libtool\" ]; then\n"\
								"	echo Updated of libtool needed\n"\
								"	set -e\n"\
								"	\"@(Builtin.MToolExe)\" DiffCopy \"${DT_TOOLCHAIN_DIR}/usr/bin/libtool\" \"@(LibToolCopy_BinariesDirectory)\"\n"\
								"	\"@(Builtin.MToolExe)\" TouchOrCreate \"@(LibToolCopy_UpdatedFile)\"\n"\
								"	\"@(Builtin.MToolExe)\" BuildDependencies \"OutputFile=@(LibToolCopy_DependencyFile)\" \"Output:@(LibToolCopy_UpdatedFile)\" \"Input:${DT_TOOLCHAIN_DIR}/usr/bin/libtool\"\n"\
								"	set +e\n"\
								"fi\n"
					{
						&
						{
							GeneratorFamily "Xcode"
							!MalterlibDefaultCompiler true
						}
					}

					Contents	"@(Contents)"\
								"\"@(Builtin.MToolExe)\" CheckDependencies \"$2\"\n"\
								"if [ \"$?\" != \"0\" ]; then\n"\
								"  echo error: Dependency checking failed\n"\
								"  exit 1\n"\
								"fi\n"
					{
						&
						{
							!HostPlatformFamily "Windows"
							!MalterlibAccurateDependencies true
						}
					}
					Contents	"@(Contents)"\
								"exit 0\n"
					{
						!!MalterlibDisableBuildSystemGeneration true
					}
					Executable true
					UnixLineEnds "@(ScriptUnixLineEnds)"
					UnicodeBOM false
				}
				Compile
				{
					Type "None"
				}
			}
/*			%File "@(Builtin.Function->GeneratedFiles('*'))"
			{
				Compile
				{
					Type "None"
				}
			}*/
		}
	}
}

%Group "~Automatic/Dependencies/Tool_GenerateBuildSystem"
{
	%Dependency "Tool_GenerateBuildSystem"
	{
		Dependency.Link false
	}
}

Target.ExtraGroups "~Automatic/Dependencies/Tool_GenerateBuildSystem;@(Target.ExtraGroups)"
{
	!Target:Target.Name "Tool_GenerateBuildSystem"
}

