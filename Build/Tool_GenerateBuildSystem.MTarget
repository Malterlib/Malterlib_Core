Property
{
	MalterlibDebugConfigureLLDBScript: bool = true // User(Debug)=false: Configure Malterlib lldb helpers in ~/.lldbinit automatically when building

	MalterlibIntermediateDirectoriesFile: string = GeneratedWorkspaceDirectory / "IntermediateDirectories.txt"

	MalterlibCheckAllDependenciesCommandBash: string = `@(Builtin.MToolExe->EscapeBash()) CheckDependencies OutputDirty=true "$MalterlibIntermediateDirectoriesFile"`

	MalterlibCheckAllDependenciesCommand: string = MalterlibCheckAllDependenciesCommandBash
	MalterlibCheckAllDependenciesCommand `@(Builtin.MToolExe->EscapeWindows()) CheckDependencies "%MalterlibIntermediateDirectoriesFile%"`
	{
		!!ScriptWindowsBat true
	}

	MalterlibNinjaGeneratorFile: string
	MalterlibNinjaGeneratorFile Builtin.GeneratedBuildSystemDir / Workspace:Workspace.Name / `@(Platform) @(Architecture) @(BuildSystemFullConfiguration)/build.ninja`
	{
		!!GeneratorFamily "Ninja"
	}
}

Property
{
	MalterlibBuildSystemGenerateCommand: string

	MalterlibBuildSystemGenerateCommand `@(Builtin.MalterlibExe->f_ScriptNativeEscapedPath()) generate --build-system @(Builtin.BuildSystemSourceAbsolute->f_ScriptNativeEscapedPath()) --generator "@(Generator)" --output-directory @(Builtin.GeneratedBuildSystemDir->f_ScriptNativeEscapedPath()) --use-cached-environment`

	SharedBuildSettingsScriptContents =+ `@(ScriptExport("MalterlibBuildSystemGenerateCommand", MalterlibBuildSystemGenerateCommand))\r\n`
	SharedBuildSettingsScriptContents =+ `@(ScriptExport("MalterlibDisableBuildSystemGeneration", MalterlibDisableBuildSystemGeneration->ToString()))\r\n`
}

%Target "Tool_GenerateBuildSystem"
{
	Target
	{
		BaseName "GenerateBuildSystem"
		Type "Tool"
		CommandLine_Build `@(GetProperty(&GenerateFile.Name, "Target:Tool_GenerateBuildSystem.Group:Source.Group:Build System Generated Files.GenerateFile:Generate")->fg_EscapeCommand()) Build`
		CommandLine_ReBuild `@(GetProperty(&GenerateFile.Name, "Target:Tool_GenerateBuildSystem.Group:Source.Group:Build System Generated Files.GenerateFile:Generate")->fg_EscapeCommand()) ReBuild`
		CommandLine_Clean `@(GetProperty(&GenerateFile.Name, "Target:Tool_GenerateBuildSystem.Group:Source.Group:Build System Generated Files.GenerateFile:Generate")->fg_EscapeCommand()) Clean`
		CommandLine_Outputs =+ "build.ninja"
		{
			!!GeneratorFamily "Ninja"
		}
		CommandLine_Outputs =+ Builtin.GeneratorStateFile
		{
			!GeneratorFamily "Ninja"
		}
		CommandLine_IsGenerator !MalterlibDisableBuildSystemGeneration

		ExportScriptEnvironment += ["MalterlibIntermediateDirectoriesFile"]
		ExportScriptEnvironment += ["MalterlibNinjaGeneratorFile"]
		{
			!!GeneratorFamily "Ninja"
		}

		Group "Tools/Malterlib"

		PhonyOutputs [MalterlibPostCopyConfigFile]
	}
	%Group "Source"
	{
		%Group "Post Copy"
		{
			%File MalterlibPostCopyConfigFile
			{
				Compile.AllowNonExisting true
			}
		}
		%Group "Build System Source"
		{
			Compile.AllowNonExisting true
			%Group "Build System"
			{
				%File SourceFiles("*.MBuildSystem*")
				%File SourceFiles("*.OldMBuildSystem")
			}
			%Group "Headers"
			{
				%File SourceFiles("*.MHeader*")
			}
			%Group "Include Headers"
			{
				%File SourceFiles("*.MInclude*")
			}
			%Group "Settings"
			{
				%File SourceFiles("*.MSettings*")
			}
			%Group "Targets"
			{
				%File SourceFiles("*.MTarget*")
			}
			%Group "Generator Settings"
			{
				%File SourceFiles("*.MGeneratorSettings*")
			}
			%Group "Dependency"
			{
				%File SourceFiles("*.MDependency*")
			}
			%Group "Workspace"
			{
				%File SourceFiles("*.MWorkspace*")
			}
			%Group "CMake"
			{
				%File SourceFiles("*/CMakeLists.txt")
				%File SourceFiles("*.cmake")
			}
		}
		%Group "vs-tool"
		{
			!!GeneratorFamily "VisualStudio"
			/*
			%File "c:/Program Files (x86)/MSBuild/Microsoft.Cpp/v4.0/V120/Platforms/Clang/*"
			%Group "Props"
			{
				%File "c:/Program Files (x86)/MSBuild/Microsoft.Cpp/v4.0/V120/Platforms/Clang/Props/*"
			}
			%Group "PlatformToolsets"
			{
				%Group "clang"
				{
					%File "c:/Program Files (x86)/MSBuild/Microsoft.Cpp/v4.0/V120/Platforms/Clang/PlatformToolsets/clang/*"
				}
			}
			 */
		}
		/*
		%Group "emscripten"
		{
			Compile
			{
				!!MalterlibCompileSupportTabSetings true
				IndentWidth 2
				TabWidth 2
				UsesTabs false
			}

			%File "/opt/Development/Malterlib/llvm/unstable-emscripten/emscripten/*.py"
			%File "/opt/Development/Malterlib/llvm/unstable-emscripten/emscripten/em*"
			%Group "tools"
			{
				%File "/opt/Development/Malterlib/llvm/unstable-emscripten/emscripten/tools/*.py"
				%File "/opt/Development/Malterlib/llvm/unstable-emscripten/emscripten/tools/*.js"
			}
			%Group "Library"
			{
				%File "/opt/Development/Malterlib/llvm/unstable-emscripten/emscripten/src/*"
			}
		}*/
		%Group "Build System Generated Files"
		{
			%GenerateFile "IntermediateDirectories"
			{
				Property
				{
					IntermediateDirectoriesTemplate function(string _Target) string
					IntermediateDirectoriesTemplate =+ `@(GetProperty(&Target.IntermediateDirectory, _Target))MalterlibDependencies\n`
				}
				GenerateFile
				{
					Name MalterlibIntermediateDirectoriesFile
					Contents Workspace.AllTargets->ForEach(&IntermediateDirectoriesTemplate)
					Executable false
					UnicodeBOM true
					UnixLineEnds true
				}
				Compile
				{
					Type "None"
				}
			}
			%GenerateFile "Generate"
			{
				Property
				{
					BuiltinMToolDirectory: string = Builtin.MToolExe->GetPath()

					IsSafeMTool: bool = false
					IsSafeMTool true
					{
						!!BuiltinMToolDirectory `@(Builtin.BasePathAbsolute)/BuildSystem/Binaries/General/Windows`
					}

					BuildSystemOutputBasePath: string = `@(Builtin.BasePathAbsolute)/BuildSystem`
					BinariesPath: string = `@(Builtin.BasePathAbsolute)/Binaries/Malterlib`
					DependencyFile: string = `@(BuildSystemOutputBasePath)/Binaries/Binaries.MalterlibDependency`
					UpdatedFile: string = `@(BuildSystemOutputBasePath)/Binaries.updated`
					ExcludePatterns: string = "*/.git;*/.DS_Store"
					LLDBScriptLocation: string = "../../Debug/Source/Malterlib_LLDB"->MakeAbsolute()

					LibToolCopy_BinariesDirectory: string = `@(PlatformToolsetCompilerBasePath)/bin`
					LibToolCopy_UpdatedFile: string = `@(LibToolCopy_BinariesDirectory)/Malterlib_libtool.updated`
					LibToolCopy_DependencyFile: string = `@(LibToolCopy_BinariesDirectory)/Malterlib_libtool.MalterlibDependency`
				}
				GenerateFile
				{
					Name `@(BuildSystemOutputDir)/Files/@(Workspace:Workspace.Name)/@(Target:Target.Name)/GenerateBuildSystem_@(Workspace:Workspace.Name)_@(Platform)_@(Architecture)@(ScriptExtension)`

					Contents =+	"set -eo pipefail\r\n"
					{
						!ScriptWindowsBat true
					}

					Contents =+	`IF "%DisableProjectGen%" == "1" GOTO Skip\r\n`\
								`:RetryGeneration\r\n`\
								`cd @(Builtin.BasePathAbsolute->WindowsPath()->EscapeHost())\r\n`\
								`@(MalterlibBuildSystemGenerateCommand) --action "%1" "@(Workspace:Workspace.Name)" --no-signal-changed\r\n`
					{
						&
						{
							!MalterlibDisableBuildSystemGeneration true
							ScriptWindowsBat true
						}
					}


					Contents =+	`if exist "@(DependencyFile)" "@(Builtin.MToolExe)" CheckDependencies Verbose=true "Directory=@(BuildSystemOutputBasePath)/Binaries"\r\n`\
								`if not exist "@(UpdatedFile)" (\r\n`\
								`	echo Updated needed\r\n`\
								`	"@(Builtin.MToolExe)" DiffCopy "@(BinariesPath)/General/Windows" "@(BuildSystemOutputBasePath)/Binaries/General"\r\n`\
								`	"@(Builtin.MToolExe)" DiffCopy "@(BinariesPath)/*.sh" "@(BuildSystemOutputBasePath)/Binaries" "" 0\r\n`\
								`	"@(Builtin.MToolExe)" TouchOrCreate "@(UpdatedFile)"\r\n`\
								`	"@(Builtin.MToolExe)" BuildDependencies "OutputFile=@(DependencyFile)" "Output:@(UpdatedFile)" "Input:@(Builtin.BasePathAbsolute)/mib" "Find:@(BinariesPath)/*;RIF;33;@(ExcludePatterns)"\r\n`\
								`	if exist "@(UpdatedFile)" GOTO RetryGeneration\r\n`\
								`)\r\n`
					{
						&
						{

							!MalterlibDisableBuildSystemGeneration true
							ScriptWindowsBat true
							IsSafeMTool true
						}
					}

					Contents =+	`if ! [ -f ~/.lldbinit ] || ! grep ~/.lldbinit -qe '#StartMalterlibLLDB'; then\r\n`\
								`	echo '#StartMalterlibLLDB' >> ~/.lldbinit\r\n`\
								`	echo '#EndMalterlibLLDB' >> ~/.lldbinit\r\n`\
								`fi\r\n`\
								`sed -i.bak $'/#StartMalterlibLLDB/,/#EndMalterlibLLDB/c\\\\\\n#StartMalterlibLLDB\\\\\\ncommand script import "@(LLDBScriptLocation)"\\\\\\n#EndMalterlibLLDB\\n' ~/.lldbinit && rm -f ~/.lldbinit.bak\r\n`
					{
						&
						{
							MalterlibDebugConfigureLLDBScript true
							!MalterlibDisableBuildSystemGeneration true
							!ScriptWindowsBat true
						}
					}

					Contents =+ ":Skip\r\n"
					{
						&
						{
							!MalterlibDisableBuildSystemGeneration true
							ScriptWindowsBat true
						}
					}

					Contents =+	`if [ "$DisableProjectGen" == "1" ]; then\n`\
								`  exit 0\n`\
								`fi\n`\
								`cd @(Builtin.BasePathAbsolute->EscapeHost())\n`\
								`set +e\n`\
								`@(MalterlibBuildSystemGenerateCommand) --action "$1" "@(Workspace:Workspace.Name)"\n`\
								`ErrorLevel=$?\n`\
								`set -e\n`
					{
						&
						{
							!MalterlibDisableBuildSystemGeneration true
							!ScriptWindowsBat true
						}
					}

					Contents =+	`if [ "$ErrorLevel" == "2" ]; then\n`\
								`  echo error: Build system changed, aborting build\n`\
								`  exit 1\n`\
								`elif [ "$ErrorLevel" != "0" ]; then\n`\
								`  echo error: Build system generation failed\n`\
								`  exit 1\n`\
								`fi\n`
					{
						&
						{
							!MalterlibDisableBuildSystemGeneration true
							GeneratorFamily "Xcode"
						}
					}

					Contents =+	`if [ "$ErrorLevel" == "2" ]; then\n`\
								`  echo error: Build system changed, Ninja generator should pick it up\n`\
								`elif [ "$ErrorLevel" != "0" ]; then\n`\
								`  echo error: Build system generation failed\n`\
								`  exit 1\n`\
								`fi\n`
					{
						&
						{
							!MalterlibDisableBuildSystemGeneration true
							GeneratorFamily "Ninja"
						}
					}

					Contents =+ MalterlibBuildDependenciesContents

					Contents =+ `if [ -f "@(LibToolCopy_DependencyFile)" ]; then\n`\
								`	"@(Builtin.MToolExe)" CheckDependencies Verbose=true "Directory=@(LibToolCopy_BinariesDirectory)"\n`\
								`fi\n`\
								`if ! [ -f "@(LibToolCopy_UpdatedFile)" ] || ! [ -f "@(LibToolCopy_BinariesDirectory)/libtool" ]; then\n`\
								`	echo Updated of libtool needed\n`\
								`	"@(Builtin.MToolExe)" DiffCopy "${DT_TOOLCHAIN_DIR}/usr/bin/libtool" "@(LibToolCopy_BinariesDirectory)"\n`\
								`	"@(Builtin.MToolExe)" TouchOrCreate "@(LibToolCopy_UpdatedFile)"\n`\
								`	"@(Builtin.MToolExe)" BuildDependencies "OutputFile=@(LibToolCopy_DependencyFile)" "Output:@(LibToolCopy_UpdatedFile)" "Input:${DT_TOOLCHAIN_DIR}/usr/bin/libtool"\n`\
								`fi\n`
					{
						&
						{
							GeneratorFamily "Xcode"
							!MalterlibDefaultCompiler true
						}
					}

					Contents =+	`@(MalterlibCheckAllDependenciesCommand)\n`\
								`IF %ERRORLEVEL% NEQ 0 (\n`\
								`  echo error: Dependency checking failed\n`\
								`  exit 1\n`\
								`)\n`
					{
						!!ScriptWindowsBat true
					}
					Contents =+	`set +e\n`\
								`DependencyOutput=$(@(MalterlibCheckAllDependenciesCommand))\n`\
								`DependencyExitCode=$?\n`\
								`set -e\n`\
								`echo "$DependencyOutput"\n`\
								`if [ "$DependencyExitCode" != "0" ]; then\n`\
								`  echo error: Dependency checking failed\n`\
								`  exit 1\n`\
								`fi\n`\
								`DependenciesDirtyCheckString=\`echo "$DependencyOutput" | grep "Dependency check: Some files were dirty" || true\`\n`\
								`if [ -n "$DependenciesDirtyCheckString" ]; then\n`\
								`  touch "$MalterlibNinjaGeneratorFile"\n`\
								`fi\n`
					{
						&
						{
							!ScriptWindowsBat true
							GeneratorFamily "Ninja"
						}
					}
					Contents =+	`set +e\n`\
								`@(MalterlibCheckAllDependenciesCommand)\n`\
								`set -e\n`\
								`if [ "$?" != "0" ]; then\n`\
								`  echo error: Dependency checking failed\n`\
								`  exit 1\n`\
								`fi\n`
					{
						&
						{
							!ScriptWindowsBat true
							!GeneratorFamily "Ninja"
						}
					}
					Contents =+ "exit 0\n"
					{
						!!MalterlibDisableBuildSystemGeneration true
					}
					Executable true
					UnixLineEnds ScriptUnixLineEnds
					UnicodeBOM false
				}
			}
/*			%File "@(GeneratedFiles("*"))"
			{
				Compile
				{
					Type "None"
				}
			}*/
		}
	}
}

%Group "~Automatic/Dependencies/Tool_GenerateBuildSystem"
{
	%Dependency "Tool_GenerateBuildSystem"
	{
		Dependency
		{
			Link false
			Stage ((GeneratorFamily == "Ninja") ? "None" : "Compile")
		}
	}
}

Target.ExtraGroups =+ "~Automatic/Dependencies/Tool_GenerateBuildSystem"
{
	!Target:Target.Name "Tool_GenerateBuildSystem"
}

