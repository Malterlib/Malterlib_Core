Workspace
{
	Enabled false
	{
		&
		{
			Workspace.Enabled undefined
			DocumentationEnabled true
		}
	}

	XcodeNewBuildSystem: bool?
	XcodeNewBuildSystem true
	{
		&
		{
			GeneratorFamily "Xcode"
			MalterlibXcodeNewBuildSystem true
		}
	}

	IntermediateDirectory: string = `@(MalterlibCompiledFilesWarkspaceBase)/Int`
	OutputDirectory: string = `@(MalterlibCompiledFilesWarkspaceBase)/Out`

	IDEDefaultBuildTarget: string? // Used to specify the default build target to use in IDEs. Default is to build all targets.
	IDEDefaultDebugTargets: [string] = [] // Used to specify the default debug targets to use in IDEs. Overrides Target.IDEDebugPriority.
	IDEPriority: int = 100 // Priority used to select the default workspace in IDEs

	ConfigurationPriority: int = 100 // Priority used to select the default configuration in IDEs

	ConfigurationPriority 100
	{
		!!Workspace.ConfigurationPriority undefined
	}

	ConfigurationPriority Workspace.ConfigurationPriority + 100
	{
		!!PlatformFamily HostPlatformFamily
	}

	ConfigurationPriority Workspace.ConfigurationPriority + 10
	{
		!!Architecture HostArchitecture
	}

	ConfigurationPriority Workspace.ConfigurationPriority + 1
	{
		!!Configuration "Debug"
	}
}

Property
{
	BuildSystemProtectedEnvironmentVariables: [string] = []

	// Malterlib build server
	BuildSystemProtectedEnvironmentVariables =+ [
		"IdsBuildServerLaunchID"
		, "IdsBuildServerTemp"
		, "MSBUILD_PIPE_NAME"
		, "MSBUILDDISABLENODEREUSE"
		, "_MSPDBSRV_ENDPOINT_"
		, "MalterlibBuildServerLaunchID"
		, "MalterlibCompiledFiles"
		, "MalterlibDevelopmentRoot"
		, "MalterlibDependenciesDirectory"
		, "MalterlibSandboxUniqueFiles"
		, "MalterlibSandboxLimitProcesses"
		, "MalterlibTerminalWidth"
		, "MalterlibBoxDrawing"
		, "MalterlibColor"
		, "MalterlibColor24Bit"
		, "P4CLIENT"
		, "P4USER"
		, "P4PORT"
		, "P4HOST"
		, "P4PASSWD"
	]

	// VS Code
	BuildSystemProtectedEnvironmentVariables =+ [
		"VSCODE_GIT_ASKPASS_EXTRA_ARGS"
		, "VSCODE_GIT_ASKPASS_MAIN"
		, "VSCODE_GIT_ASKPASS_NODE"
		, "VSCODE_GIT_IPC_HANDLE"
		, "VSCODE_NONCE"
	]

	// Security/Authentication tokens
	BuildSystemProtectedEnvironmentVariables =+ [
		"GITHUB_TOKEN"
		, "GIT_ASKPASS"
		, "GH_TOKEN"
		, "GITLAB_TOKEN"
		, "CI_JOB_TOKEN"
		, "NPM_TOKEN"
		, "NODE_AUTH_TOKEN"
		, "AWS_ACCESS_KEY_ID"
		, "AWS_SECRET_ACCESS_KEY"
		, "AWS_SESSION_TOKEN"
		, "HOMEBREW_GITHUB_API_TOKEN"
		, "CODECOV_TOKEN"
		, "COVERALLS_REPO_TOKEN"
	]

	// Session-specific variables
	BuildSystemProtectedEnvironmentVariables =+ [
		"XDG_SESSION_ID"
		, "XDG_RUNTIME_DIR"
		, "SSH_AUTH_SOCK"
		, "SSH_CONNECTION"
		, "SSH_CLIENT"
		, "SSH_TTY"
		, "GPG_TTY"
		, "TERM_SESSION_ID"
		, "DISPLAY"
		, "WINDOWID"
	]

	// CI/CD variables that change per build
	BuildSystemProtectedEnvironmentVariables =+ [
		"GITHUB_RUN_ID"
		, "GITHUB_RUN_NUMBER"
		, "GITHUB_SHA"
		, "BUILD_NUMBER"
		, "BUILD_ID"
	]

	// Temporary directories
	BuildSystemProtectedEnvironmentVariables =+ [
		"TMPDIR"
		, "TEMP"
		, "TMP"
	]
}
