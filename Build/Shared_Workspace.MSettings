Workspace
{
	Enabled false
	{
		&
		{
			Workspace.Enabled undefined
			DocumentationEnabled true
		}
	}

	XcodeNewBuildSystem: bool?
	XcodeNewBuildSystem true
	{
		&
		{
			GeneratorFamily "Xcode"
			MalterlibXcodeNewBuildSystem true
		}
	}

	IntermediateDirectory: string = `@(MalterlibCompiledFilesSourceBase)/@(Workspace:Workspace.Name)/Intermediate`
	OutputDirectory: string = `@(MalterlibCompiledFilesSourceBase)/@(Workspace:Workspace.Name)/Output`
}
