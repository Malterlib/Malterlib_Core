		{
			Compiler "Clang"
			MalterlibClangTimeTrace true
		}
	}

	ExtraCompilerFlags =+ "/Zo"
	{
		&
		{
			PlatformFamily "Windows"
			|
			{
				Compile.Symbols "Full"
				Compile.Symbols "FullForDebug"
			}
		}
	}

	ExtraCompilerFlags =+ "/Zc:threadSafeInit-"
	{
		&
		{
			PlatformFamily "Windows"
		}
	}

	ExtraCompilerFlags =+ "/Zc:__cplusplus"
	{
		!!PlatformFamily "Windows"
	}	

	ExtraCompilerFlags =+ "/utf-8"
	{
		&
		{
			MalterlibMSVCEnableUTF8 true
			PlatformFamily "Windows"
		}
	}

	Symbols "None"
	{
		!!Configuration "Fast Compile"
		!!MalterlibDebugSymbolsEnable false
	}
	Symbols "Default"
	{
		&
		{
			|
			{
				Configuration "Release"
				Configuration "Fast Compile"
			}
			PlatformFamily "Emscripten"
		}
