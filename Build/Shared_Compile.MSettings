	Warnings_ASANWithoutDebugInfo false
	{
		&
		{
			MalterlibSupportSanitizerEnable_Address true
			PlatformFamily "Windows"
			!Target.PlatformToolset "ClangCL"
		}
	}
	PreprocessorDefines += ["_DISABLE_VECTOR_ANNOTATION=1", "_DISABLE_STRING_ANNOTATION=1"]
	{
