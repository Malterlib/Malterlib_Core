	PreprocessorDefines += [`DProductVersionMajor=@(ProductVersionMajor)`, `DProductVersionMinor=@(ProductVersionMinor)`, `DProductVersionRevision=@(ProductVersionRevision)`]

	PreprocessorDefines += `DProductCompanyUniqueIdentifier=@(ProductCompanyUniqueIdentifier)`
	PreprocessorDefines += `DProductContact=@(ProductContact)`
	PreprocessorDefines += `DProductCompany=@(ProductCompany->Escape())`
	PreprocessorDefines += `DProductCountry=@(ProductCountry->Escape())`
	PreprocessorDefines += `DProductLocality=@(ProductLocality->Escape())`
	PreprocessorDefines += `DProductOrganizationalUnit=@(ProductOrganizationalUnit->Escape())`

	PreprocessorDefines += `DMibLLVMSanitizerRuntime=@(MalterlibLLVMSanitizerRuntime->GetFile()->Escape())`
	{
		!MalterlibLLVMSanitizerRuntime undefined
	}

	PreprocessorDefines += [
		`DConfigSuffix=@(MalterlibConfigSuffix->Escape())`
		, `DWorkspace_@(Workspace:this.Identity->Replace(' ', ''))`
		, `DTarget_@(Target:this.Identity->ReplaceChars(' -.', ''))`
		, `DConfig_@(ConfigNoSpace)`
		, `DArchitecture_@(Architecture)`
		, `DPlatform_@(Platform->Replace('.', '_'))`
		, `DTarget=@(Target:this.Identity)`
		, `DConfig=@(Configuration)`
		, `DRealConfig=@(RealConfiguration)`
		, `DArchitecture=@(Architecture)`
		, `DPlatform=@(Platform)`
		, `DPlatformFamily=@(PlatformFamily)`
		, `DPlatformFamily_@(PlatformFamily)`
	]

	PreprocessorDefines += `DTests_@(Tests->Replace(' ', ''))`
	{
		&
		{
			!Tests undefined
			!Tests ""
		}
	}

	PreprocessorDefines += `DPlatformVersion=@(PlatformVersion->ToString())`
	{
		!PlatformVersion undefined
	}
	PreprocessorDefines += ["_CONSOLE", "DPConsole"]
	{
		!!Target.Type "ConsoleExecutable"
	}
	PreprocessorDefines += `DPlatformVersion=@(PlatformVersion->ToString())`
	{
		!PlatformVersion undefined
	}
	PreprocessorDefines += "_DDK_"
	{
		&
		{
			PlatformType "Windows"
			Target.Type "Driver"
		}
	}
	PreprocessorDefines += "_LIB"
	{
		&
		{
			PlatformType "Windows"
			Target.Type "StaticLibrary"
		}
	}
	PreprocessorDefines += ["_USRDLL", "_WINDLL"]
	{
		&
		{
			PlatformType "Windows"
			Target.Type "DynamicLibrary"
		}
	}

	PreprocessorDefines += `DMibConfig_RefCountDebugging=@(Malterlib_RefCountDebugging_Enable ? "1" : "0")`
	PreprocessorDefines += `DMibConfig_RefCountLeakDebugging=@(Malterlib_RefCountLeakDebugging_Enable ? "1" : "0")`
	PreprocessorDefines += `DMibConfig_Tests_Enable=@(Malterlib_Tests_Enable ? "1" : "0")`
	PreprocessorDefines += `DMibConfig_Contracts_Enable=@(Malterlib_Contracts_Enable ? "1" : "0")`
	PreprocessorDefines += `DMibConfig_MalterlibMemoryManager_Debug=@(MalterlibMemoryManager_Debug ? "1" : "0")`
	PreprocessorDefines += `DMibConfig_Memory_Shims_Lightweight=@(MalterlibMemory_Shims_Lightweight ? "1" : "0")`
	PreprocessorDefines += `DMibConfig_Memory_Shims_Enable=@(MalterlibMemory_Shims_Enable ? "1" : "0")`
	PreprocessorDefines += `DMibConfig_Memory_Shims_EnableLocal=@(MalterlibMemory_Shims_EnableLocal? "1" : "0")`
	{
		!!MalterlibMemory_Shims_Enable true
	}
	PreprocessorDefines += `DMibConfig_Memory_Shims_EnableGlobal=@(MalterlibMemory_Shims_EnableGlobal ? "1" : "0")`
	{
		!!MalterlibMemory_Shims_Enable true
	}
	PreprocessorDefines += `DMibConfig_MemoryManager_Stats_EnableCategories=@(MalterlibMemoryManager_Stats_EnableCategories ? "1" : "0")`
	{
		!!MalterlibMemory_Shims_Enable true
	}
	PreprocessorDefines += `DMibConfig_MemoryManager_Stats_EnableCallstack=@(MalterlibMemoryManager_Stats_EnableCallstack ? "1" : "0")`
	{
		!!MalterlibMemory_Shims_Enable true
	}

	PreprocessorDefines =+ "DMibConfig_ManualForeignThreadInitialization"
	{
		!!MalterlibManualForeignThreadInitialization true
	}

	PreprocessorDefines += "_LIBCPP_ENABLE_ASSERTIONS=1"
	{
		&
		{
			!MalterlibDisableMalterlib true
			MalterlibUseStaticLibCxx true
			Malterlib_Contracts_Enable true
		}
	}

	PreprocessorDefines += `DMalterlibEnable32Bit=@(BuildArch_x86 ? "1" : "0")`
	{
		!BuildArch_x86 undefined
	}

	PreprocessorDefines += "DMibLinkTimeCodeGeneration"
	{
		!Target:Target.LinkTimeCodeGeneration false
	}

	Symbols: string?
