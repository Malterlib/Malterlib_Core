			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.js"
				this.Identity ~"*.ts" // Typescript
			}
		}
	}


	Type "HTML"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.html"
				this.Identity ~"*.xhtml"
				this.Identity ~"*.htm"
			}
		}
	}

	Type "CSS"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.css"
				this.Identity ~"*.less"
			}
		}
	}

	Type "PNG"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.png"
			}
		}
	}

	Type "SVG"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.svg"
			}
		}
	}

	Type "XML"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.xml"
			}
		}
	}

	Type "MacIcon"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.icns"
			}
		}
	}

	Type "StaticLibrary"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.a"
			}
		}
	}

	Type "DynamicLibrary"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.dylib"
			}
		}
	}

	Type "JSON"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.json"
			}
		}
	}

	// Malterlib build system types

	Type "MalterlibBuildSystem"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.MTarget*"
				this.Identity ~"*.MBuildSystem*"
				this.Identity ~"*.OldMBuildSystem"
				this.Identity ~"*.MWorkspace*"
				this.Identity ~"*.MHeader"
				this.Identity ~"*.MInclude"
				this.Identity ~"*.MSettings*"
				this.Identity ~"*.MGeneratorSettings*"
				this.Identity ~"*.MBuildOptions*"
				this.Identity ~"*.MConfig*"
				this.Identity ~"*.MLBuildOptions"
				this.Identity ~"*.ir"
				this.Identity ~"*.irg"
			}
		}
	}


}

Compile
{
	Type "Custom"
	{
		&
		{
			//!GeneratorFamily "Xcode"
			this.Type "File"
			Compile.GenericCompileType undefined
			!Compile.Custom_CommandLine undefined
		}
	}
}

Compile
{
	///////////////////////////////
	// Leave this last
	///////////////////////////////

	Type "None"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
		}
	}
}

// Optimization needs to be available for all types
Compile
{
	Optimize: one_of("Off", "Fast", "On", "Full")? = "Off"

	Optimize "Fast"
	{
		&
		{
			RealDebugCompiler false
			!RealConfiguration "Release Debug"
		}
	}

	// The following levels are not enabled for RealConfiguration as they require link time code generation which we don't want in debug
	Optimize "On"
	{
		!!Configuration "Release"
	}

	Optimize "Full"
	{
		!!Configuration "Optimized"
	}
}

Property
{
	MalterlibDebugSymbolsEnable: bool = true // User(Debug)=false: Enable generation of debug symbols
	BuildArch_x86: bool = true
	DebugCodeAlwaysRelease: bool = false
}

Compile
{
	!!LanguageFamily ".NET"

	Symbols "Full"
	Symbols "FullForDebug"
	{
		!!RealDebugCompiler true
	}
	Symbols "None"
	{
		!!Configuration "Fast Compile"
		!!MalterlibDebugSymbolsEnable false
	}

	Warnings "Pedantic"

	PreprocessorDefines += ["DEBUG", "TRACE"]
	{
		&
		{
			DebugCode true
			!DebugCodeAlwaysRelease true
		}
	}

	PreprocessorDefines += [
		MalterlibUniqueConfig
		, `DWorkspace_@(Workspace:this.Identity->Replace(' ', ''))`
		, `DTarget_@(Target:this.Identity->ReplaceChars(' -', ''))`, `DConfig_@(ConfigNoSpace)`
	]

	PreprocessorDefines += "DPConsole"
	{
		!!Target.Type "ConsoleExecutable"
	}
	PreprocessorDefines += "DMibConfig_RefCountDebugging"
	{
		!!Malterlib_RefCountDebugging_Enable true
	}
	PreprocessorDefines += "DMibConfig_RefCountLeakDebugging"
	{
		!!Malterlib_RefCountLeakDebugging_Enable true
	}

	PreprocessorDefines += "DMibConfig_Tests_Enable"
	{
		!!Malterlib_Tests_Enable true
	}
	PreprocessorDefines += "DMibConfig_Contracts_Enable"
	{
		!!Malterlib_Contracts_Enable true
	}
	PreprocessorDefines += "DMibConfig_Memory_Shims_Enable"
	{
		!!MalterlibMemory_Shims_Enable true
	}
	PreprocessorDefines += "DMibConfig_MalterlibMemoryManager_Debug"
	{
		!!MalterlibMemoryManager_Debug true
	}
	PreprocessorDefines += "DMalterlibEnable32Bit"
	{
		!!BuildArch_x86 true
	}
}

Property
{
	MalterlibNativeClangArchitecture: string

	MalterlibNativeClangArchitecture "i686"
	{
		&
		{
			|
			{
				Architecture "x86"
				Architecture "le32"
			}
			PlatformFamily "Linux"
		}
	}

	MalterlibNativeClangArchitecture "i386"
	{
		&
		{
			|
			{
				Architecture "x86"
				Architecture "le32"
			}
			!PlatformFamily "Linux"
		}
	}

	MalterlibNativeClangArchitecture "x86_64"
	{
		!!Architecture "x64"
	}
	MalterlibNativeClangArchitecture "ppc"
	{
		!!Architecture "ppc32"
	}

	MalterlibNativeClangArchitecture "armv7"
	{
		!!Architecture "ArmV7"
	}
	MalterlibNativeClangArchitecture "armv7s"
	{
		!!Architecture "ArmV7s"
	}
	MalterlibNativeClangArchitecture "arm64"
	{
		!!Architecture "arm64"
	}
	MalterlibNativeClangArchitecture "arm64e"
	{
		|
		{
			Architecture "arm64e"
			&
			{
				Architecture "arm64"
				Target.Type "Driver"
				!Target.DriverType "DriverKit"
			}
		}
	}
	MalterlibNativeClangArchitecture "aarch64"
	{
		&
		{
			Architecture "arm64"
			PlatformFamily "Linux"
		}
	}

	MalterlibNativeClangLibraryArchitecture: string = MalterlibNativeClangArchitecture

	MalterlibNativeClangLibraryArchitecture "i686"
	{
		&
		{
			|
			{
				Architecture "x86"
				Architecture "le32"
			}
			PlatformFamily "Linux"
		}
	}
}

Property
{
	MalterlibXcodeBuildArchitecture: string = MalterlibNativeClangArchitecture
	MalterlibXcodeBuildArchitecture "x86_64"
	{
		!!PlatformFamily "Linux"
	}
}

Property
{
	!!PlatformIsDarwin true

	MalterlibNativeClangDarwinTarget: string

	MalterlibNativeClangDarwinTarget Format("{1,xpr($+4)}", MalterlibMinSupportedMacOSVersion->Parse("{}.{}", "int", "int")...)
	{
		!!PlatformFamily "macOS"
	}
	MalterlibNativeClangDarwinTarget Format("{1,xpr($+6)}", MalterlibMinSupportediOSVersion->Parse("{}.{}", "int", "int")...)
	{
		!!PlatformFamily "iOS"
	}
	MalterlibNativeClangDarwinTarget Format("{0,xpr($+9)}", MalterlibMinSupportedMacOSVersion->Parse("{}.{}", "int", "int")...)
	{
		&
		{
			PlatformFamily "macOS"
			MalterlibMinSupportedMacOSVersion >= "11.0"
		}
	}
}

Property
{
	MalterlibTargetTriple: string?
	MalterlibTargetTriple `@(MalterlibNativeClangArchitecture)-apple-macos@(MalterlibMinSupportedMacOSVersion)`
	{
		&
		{
			PlatformFamily "macOS"
			!Target.DriverType "DriverKit"
		}
	}
	MalterlibTargetTriple `@(MalterlibNativeClangArchitecture)-unknown-linux-gnu`
	{
		!!PlatformFamily "Linux"
	}

	MalterlibClangLibraryTargetTriple: string?
	MalterlibClangLibraryTargetTriple `@(MalterlibNativeClangLibraryArchitecture)-apple-macos@(MalterlibMinSupportedMacOSVersion)`
	{
		!!PlatformFamily "macOS"
	}
	MalterlibClangLibraryTargetTriple `@(MalterlibNativeClangLibraryArchitecture)-unknown-linux-gnu`
	{
		!!PlatformFamily "Linux"
	}
}

Property
{
	MalterlibFullSymbolsOnLinux: bool = false // User(Toolset)=true: Enable full symbol generation on Linux
	MalterlibClangTimeTrace: bool = false // User(Debug)=true: Generate time traces for clang invocations
}

Compile
{
	&
	{
		PlatformFamily "macOS"
		|
		{
			CompileDialect "C"
			Compile.Type "Assembler"
		}
	}

	MinMacOSVersion: string?
	MinMacOSVersion MalterlibMinSupportedMacOSVersion
	{
		&
		{
			Compile.MinMacOSVersion undefined
			!Target.DriverType "DriverKit"
		}
	}
}

Compile
{
	TargetTriple: string?
	AsyncUnwindTables: bool?
}

Compile
{
	&
	{
		LanguageFamily "Native"
		|
		{
			CompileDialect "C"
			Compile.Type "Assembler"
		}
		|
		{
			PlatformIsDarwin true
			PlatformFamily "Linux"
		}
	}

	TargetTriple MalterlibTargetTriple
	{
		!MalterlibTargetTriple undefined
	}
	/*AsyncUnwindTables false
	{
		!Compile.Type "Assembler"
	}*/
}

Compile
{
	&
	{
		LanguageFamily "Native"
		PlatformFamily "Linux"
		|
		{
			CompileDialect "C"
			Compile.Type "Assembler"
		}
	}

	TargetTriple MalterlibTargetTriple
	{
		!MalterlibTargetTriple undefined
	}
}

Property
{
	MalterlibVerboseTemplateErrors: bool = false // User(Toolset)=true: Enabled more verbose template errors for clang
	MalterlibCodeCoverage: bool = false // User(Tests)=true: Set to true to enable code coverage
}

Property
{
	MalterlibCompileSupportTabSetings: bool = false
	MalterlibCompileSupportTabSetings true
	{
		&
		{
			GeneratorFamily "Xcode"
			!
			{
				|
				{
					// Directory/binary targets does not get the tab settings
					Compile.Type "Nib"
					Compile.Type "StaticLibrary"
					Compile.Type "DynamicLibrary"
					Compile.Type "XcodeBundle"

	/*
					// Text targets all get tab settings
					Compile.Type "Assembler"
					Compile.Type "C++"
					Compile.Type "C"
					Compile.Type "Header"
					Compile.Type "MalterlibFS"
					Compile.Type "WindowsResource"
					Compile.Type "MSBuildTargets"
					Compile.Type "AppxManifest"
					Compile.Type "ApplicationDefinition"
					Compile.Type "Page"
					Compile.Type "EmbeddedResource_ResX"
					Compile.Type "Settings"
					Compile.Type "C#"
					Compile.Type "ObjC++"
					Compile.Type "ObjC"
					Compile.Type "MacIcon"
					Compile.Type "None"
	*/
				}
			}
		}
	}
}

Compile
{
	!!MalterlibCompileSupportTabSetings true

	IndentWidth 4
	TabWidth 4
	UsesTabs true
}

Compile
{
	!!Compiler "Clang"

	CLanguage: string?
}

Compile
{
	&
	{
		LanguageFamily "Native"
		|
		{
			Compile.Type "C"
		}
	}

	CLanguage "GNU11"
	{
		&
		{
			Compiler "Clang"
			PlatformFamily "Linux"
			Compile.CLanguage undefined
		}
	}
	CLanguage "C11"
	{
		&
		{
			Compiler "Clang"
			!PlatformFamily "Linux"
			Compile.CLanguage undefined
		}
	}
}

Property
{
	!!PlatformFamily "macOS"

	MaxSupportedPlatformVersion `@(MalterlibMaxSupportedMacOSVersion->Replace('.',''))0`
	{
		!!MaxSupportedPlatformVersion undefined
	}
}

Property
{
	!!PlatformFamily "iOS"

	MaxSupportedPlatformVersion `@(MalterlibMaxSupportediOSVersion->Replace('.',''))0`
	{
		!!MaxSupportedPlatformVersion undefined
	}
	PlatformVersion `@(Platform->Replace('.',''))0`->Replace('iOS','')
}

Property
{
	!!PlatformFamily "Emscripten"

	PlatformVersion 1000
}

Property
{
	MalterlibMSVCEnableUTF8: bool = true
	MalterlibNoShortcuts: bool = false
	DoesNotUseMalterlib: bool = false
	AOCCDisableSSL: bool = false

	MalterlibDisableMalterlib: bool = false
	MalterlibDisableMalterlib true
	{
		&
		{
			GeneratorFamily "VisualStudio"
			|
			{
				!Target.CLRSupport false
				LanguageFamily ".NET"
			}
		}
	}

	MalterlibDynamicCRT: bool = false
	MalterlibDynamicCRT true
	{
		&
		{
			MalterlibDynamicCRT undefined
			Target.CLRSupport true
		}
	}
	
	MalterlibAlwaysUseLongWindowsPaths: bool = false
	MalterlibCustomConcurrentCompile: int?

	MalterlibFileLineOnDebugBreak: bool = false // User(Debug)=true: Output file and line when debug break is encountered
}

Compile
{
	Warnings_UnusedCommandLineArgument: bool?
	Warnings_TautolagicalPointerCompare: bool?
	Warnings_UnusedFunction: bool?
	Warnings_UnusedValue: bool?
	Warnings_VarArgs: bool?
	Warnings_CharSubscripts: bool?
	Warnings_Cxx11Narrowing: bool?
	Warnings_OverloadedVirtual: bool?
	Warnings_Parentheses: bool?
	Warnings_UnusedLabel: bool?
	Warnings_NoUnused: bool?
	Warnings_NoVirtualOverride: bool?
	Warnings_DeprecatedEnumConversion: bool?
	Warnings_NoPessimizingMove: bool?
	Warnings_ASANWithoutDebugInfo: bool?
	Warnings_InlineNewDelete: bool?

	AllCPUSubTypes: bool?
	StackGuard: bool?

	Warnings_CharSubscripts false
	{
		&
		{
			Compiler "Clang"
			CompileDialect "C"
		}
	}
	Warnings_InlineNewDelete false
	{
		&
		{
			Compiler "Clang"
			CompileDialect "C"
		}
	}
}

// Assembler settings
Compile
{
	&
	{
		LanguageFamily "Native"
		Compile.Type "Assembler"
	}

	Warnings_UnusedCommandLineArgument false
	{
		&
		{
			Compiler "Clang"
			!PlatformFamily "Windows"
			!Target.PlatformToolset "com.apple.compilers.llvm.clang.malterlib_generator"
		}
	}
}

Property
{
	DefaultPrefixHeader: string?
	DefaultPrefixHeader `@(Builtin.BasePathAbsolute)/Malterlib/Core/Source/PrefixHeader/PCH_C.h`
	{
		&
		{
			GeneratorFamily "VisualStudio"
			DefaultPrefixHeader undefined
			|
			{
				Compile.Type "C"
				Compile.Type "ObjC"
			}
			!DocumentationEnabled true
			!Target.Type "Driver"
			!Target.CLRSupport true
		}
	}

	DefaultPrefixHeader `@(Builtin.BasePathAbsolute)/Malterlib/Core/Source/PrefixHeader/PCH.h`
	{
		&
		{
			DefaultPrefixHeader undefined
			!DocumentationEnabled true
			!Target.Type "Driver"
			!Target.CLRSupport true
		}
	}

	MalterlibProfileGuidedOptimization: string? // User(Toolset)="generate": Generate or use profile guided optimization
}

Compile
{
	&
	{
		LanguageFamily "Native"
	}

	Verbose: bool?
	Verbose false // User(Toolset)=true: Enables output of cc1 command line
	{
		&
		{
			PlatformToolsetFamily "clang"
			Compile.Verbose undefined
		}
	}
}

