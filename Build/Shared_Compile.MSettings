		&
		{
			RealDebugCompiler "true"
			!Compile.Type "C++Managed"
			!Target:Target.Type Driver
		}
	}
	RuntimeChecks "Fast"
	{
		&
		{
			RealConfiguration "Release Testing"
			!Compile.Type "C++Managed"
			!Target:Target.Type Driver
		}
	}
	FunctionLevelLinking "false"
	{
		&
		{
			PlatformType "Windows"
			!Target.VisualStudioPlatform "Clang"
		}
	}
	FunctionLevelLinking "true"
	{
		&
		{
			!Target.VisualStudioPlatform "Clang"
			PlatformType "Windows"
			|
			{
				RealDebugCompiler "false"
				Target.Type "Driver"
			}
		}
	}

	ExtendedInstructionSet "Off"
	{
		&
		{
			PlatformType "Windows"
			!Target:Target.PlatformToolset "v90"
			|
			{
				Architecture x86
			}
		}
	}

	ExtendedInstructionSet "AVX"
	{
		&
		{
			!
			{
				&
				{
					PlatformType "Windows"
					Target:Target.PlatformToolset "v90"
				}
			}
			RealConfiguration "Optimized"
			|
			{
				Architecture x86
				Architecture x64
			}
		}
	}

	FloatingPointModel "Precise"
	{
		&
		{
			PlatformType "Windows"
			!Target.VisualStudioPlatform "Clang"
		}
	}
	FloatingPointExceptions "false"
	{
		!Target.VisualStudioPlatform "Clang"
	}
	EnableLanguageExtensions "true"
	EnableFiberSafeOptimizations "false"
	{
		&
		{
			PlatformType "Windows"
			!Target.VisualStudioPlatform "Clang"
		}
	}
	CreateHotpatchableImage "false"
	{
		&
		{
			PlatformType "Windows"
			!Target.VisualStudioPlatform "Clang"
		}
	}
	IgnoreStandardIncludePath "true"
	{
		&
		{
			PlatformType "Windows"
			Target.Type "Driver"
		}
	}
}


// ObjC and ObjC++ Settings
Compile
{
	&
	{
		LanguageFamily Native
		PlatformIsDarwin true
		|
		{
			CompileDialect "C"
		}
	}

	//ObjectiveCARC "true"
	ObjectiveCARC "true"
	{
		!!PlatformFamily iOS
	}
	ObjectiveCARC "false"
	{
		!!Compile.ObjectiveCARC ""
	}
	ObjectiveCARC "false"
	{
		&
		{
			Compile.ObjectiveCARC ""
			|
			{
				Platform "OSX10.5"
				Platform "OSX10.6"
			}
		}
	}
	
	PreprocessorDefines "DMibObjC_Arc;@(Compile.PreprocessorDefines)"
	{
		!!Compile.ObjectiveCARC "true"
	}
}

// Windows resources
Compile
{
	&
	{
		LanguageFamily Native
		Compile.Type WindowsResource
	}

	Culture "0x0409"
	PreprocessorDefines "@(Compile.PreprocessorDefines);@(Builtin.Inherit)"

	PreprocessorDefines "NDEBUG;@(Compile.PreprocessorDefines)"
	{
		!!DebugCode "false"
	}
	PreprocessorDefines "DBG=0;@(Compile.PreprocessorDefines)"
	{
		&
		{
			DebugCode "false"
			Target.Type "Driver"
		}
	}
	PreprocessorDefines "_DEBUG;@(Compile.PreprocessorDefines)"
	{
		!!DebugCode "true"
	}
	PreprocessorDefines "DBG=1;@(Compile.PreprocessorDefines)"
	{
		&
		{
			DebugCode "false"
			Target.Type "Driver"
		}
	}
}


// MalterlibFS
Compile
{
	&
	{
		LanguageFamily Native
		Compile.Type MalterlibFS
	}

	DoCompileAndLink true
	VerboseLogging false
	MalterlibFSPathPrefix ""

	ObjectFileName "@(Target:Target.IntermediateDirectory)@(Builtin.SourceFileName)_VirtualFS.obj"
	{
		!!PlatformFamily Windows
	}
	ObjectFileName "@(Target:Target.IntermediateDirectory)@(Builtin.SourceFileName)_VirtualFS.s"
	{
		!PlatformFamily Windows
	}
	ASMFileName "@(Compile.ObjectFileName)"
	{
		!PlatformFamily Windows
	}
	Platform "@(PlatformFamily)"
	{
		!!PlatformFamily Linux
		!!PlatformFamily OSX
	}
	
	CppFileName "@(Target:Target.IntermediateDirectory)@(Builtin.SourceFileName)_VirtualFSCPP.cpp"
	//DependencyFileName "@(Target:Target.IntermediateDirectory)@(Builtin.SourceFileName)_VirtualFS.d"
	MalterlibDependencyFileName "@(Target:Target.IntermediateDirectory)MalterlibDependencies/@(Builtin.SourceFileName)_VirtualFS.MalterlibDependency"
	{
		&
		{
			GeneratorFamily Xcode
			!MalterlibDisableDependencyFiles true
		}
	}
	
	SymbolName "_gc_VFS_Bytes"
	{
		&
		{
			PlatformFamily Windows
			Architecture x86
		}
	}
	OutputAsObjectFile true
	{
		!!PlatformFamily Windows
	}
	OutputAsAssembly true
	{
		!!PlatformFamily Linux
		!!PlatformFamily OSX
	}
	/*OutputAsObjectFile Elf32
	{
		&
		{
			!PlatformFamily Windows
			ArchitectureBitness 32
		}
	}
	OutputAsObjectFile Elf64
	{
		&
		{
			!PlatformFamily Windows
			ArchitectureBitness 64
		}
	}*/
}

// MlTwk
Compile
{
	&
	{
		LanguageFamily Native
		Compile.Type MlTwk
	}

	DoCompileAndLink "true"
	{
		&
		{
			Compile.DoCompileAndLink ""
			!DebugCode "true"
            !GeneratorFamily "Xcode" // Due to limitations in Xcode we always compile and link
		}
	}
	DoCompileAndLink "false"
	{
		&
		{
			Compile.DoCompileAndLink ""
			DebugCode "true"
            !GeneratorFamily "Xcode" // Due to limitations in Xcode we always compile and link
		}
	}
	GenerateDebugInformation "true"
	{
		!!Compile.GenerateDebugInformation ""
	}

	ObjectFileName "@(MalterlibQtTweakPath)/@(Builtin.SourceFileName)_Twk.cpp"
}


// Windows assembler settings
Compile
{
	&
	{
		LanguageFamily Native
		Compile.Type "Assembler"
		PlatformType "Windows"
	}

	PreserveIdentifierCase "true"
	{
	}
}

// C#
Compile
{
	&
	{
		Target:Target.Language C#
		Compile.Type "Compile"
	}
}

Compile 
{
	!!Compile.Type Custom

	Custom_WorkingDirectory "@(this.Identity->GetPath())"
	{
		!!Compile.Custom_WorkingDirectory ""
	}

	FullEval true

	Custom_Message "Generating @(File:this.Identity->GetFile())"
	{
		&
		{
			GeneratorFamily VisualStudio
			this.Type File
		}
	}
	
	CustomCombined_CommandLine 	"@(Compile.Custom_WorkingDirectory->GetDrive())\r\n"\
								"cd \"@(Compile.Custom_WorkingDirectory)\"\r\n"\
								"@(Compile.Custom_CommandLine->Replace('\">\"', '>'))\r\n"
	{
		!!GeneratorFamily VisualStudio
	}
}


