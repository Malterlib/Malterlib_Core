				this.Identity ~"*.xcassets"
			}
		}
	}

	Type "Python"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.py"
			}
		}
	}

	Type "JavaScript"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.js"
				this.Identity ~"*.ts" // Typescript
			}
		}
	}


	Type "HTML"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.html"
				this.Identity ~"*.xhtml"
				this.Identity ~"*.htm"
			}
		}
	}

	Type "CSS"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.css"
				this.Identity ~"*.less"
			}
		}
	}

	Type "PNG"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.png"
			}
		}
	}

	Type "SVG"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.svg"
			}
		}
	}

	Type "XML"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.xml"
			}
		}
	}

	Type "MacIcon"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.icns"
			}
		}
	}

	Type "StaticLibrary"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.a"
			}
		}
	}

	Type "DynamicLibrary"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.dylib"
			}
		}
	}

	Type "JSON"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.json"
			}
		}
	}

	// Malterlib build system types

	Type "MalterlibBuildSystem"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.MTarget*"
				this.Identity ~"*.MBuildSystem*"
				this.Identity ~"*.OldMBuildSystem"
				this.Identity ~"*.MWorkspace*"
				this.Identity ~"*.MHeader"
				this.Identity ~"*.MInclude"
				this.Identity ~"*.MSettings*"
				this.Identity ~"*.MGeneratorSettings*"
				this.Identity ~"*.MBuildOptions*"
				this.Identity ~"*.MConfig*"
				this.Identity ~"*.MLBuildOptions"
				this.Identity ~"*.ir"
				this.Identity ~"*.irg"
			}
		}
	}


}

Compile
{
	///////////////////////////////
	// Leave this last
	///////////////////////////////

	Type "None"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
		}
	}
}

// Optimization needs to be available for all types
Compile
{
	Optimize define one_of("Off", "Fast", "On", "Full")? = "Off"

	Optimize "Fast"
	{
		&
		{
			RealDebugCompiler false
			!RealConfiguration "Release Debug"
		}
	}

	// The following levels are not enabled for RealConfiguration as they require link time code generation which we don't want in debug
	Optimize "On"
	{
		!!Configuration "Release"
	}

	Optimize "Full"
	{
		!!Configuration "Optimized"
	}
}

Property
{
	MalterlibDebugSymbolsEnable define bool = true // User(Debug)=false: Enable generation of debug symbols
	BuildArch_x86 define bool = true
	DebugCodeAlwaysRelease define bool = false
}

Compile
{
	!!LanguageFamily ".NET"

	Symbols "Full"
	Symbols "FullForDebug"
	{
		!!RealDebugCompiler true
	}
	Symbols "None"
	{
		!!Configuration "Fast Compile"
		!!MalterlibDebugSymbolsEnable false
	}

	Warnings "Pedantic"

	PreprocessorDefines += ["DEBUG", "TRACE"]
	{
		&
		{
			DebugCode true
			!DebugCodeAlwaysRelease true
		}
	}

	PreprocessorDefines += [
		MalterlibUniqueConfig
		, `DWorkspace_@(Workspace:this.Identity->Replace(' ', ''))`
		, `DTarget_@(Target:this.Identity->ReplaceChars(' -', ''))`, `DConfig_@(ConfigNoSpace)`
	]

	PreprocessorDefines += "DPConsole"
	{
		!!Target.Type "ConsoleExecutable"
	}
	PreprocessorDefines += "DMibConfig_RefCountDebugging"
	{
		!!Malterlib_RefCountDebugging_Enable true
	}

	PreprocessorDefines += "DMibConfig_Tests_Enable"
	{
		!!Malterlib_Tests_Enable true
	}
	PreprocessorDefines += "DMibConfig_Contracts_Enable"
	{
		!!Malterlib_Contracts_Enable true
	}
	PreprocessorDefines += "DMibConfig_Memory_Shims_Enable"
	{
		!!MalterlibMemory_Shims_Enable true
	}
	PreprocessorDefines += "DMibConfig_MalterlibMemoryManager_Debug"
	{
		!!MalterlibMemoryManager_Debug true
	}
	PreprocessorDefines += "DMalterlibEnable32Bit"
	{
		!!BuildArch_x86 true
	}
}

Property
{
	MalterlibNativeClangArchitecture define string

	MalterlibNativeClangArchitecture "i386" // Figure a way to include proper arch in Xcode
	{
		!!Architecture "le32"
	}

	MalterlibNativeClangArchitecture "i386"
	{
		!!Architecture "x86"
	}
	MalterlibNativeClangArchitecture "x86_64"
	{
		!!Architecture "x64"
	}
	MalterlibNativeClangArchitecture "ppc"
	{
		!!Architecture "ppc32"
	}

	MalterlibNativeClangArchitecture "armv7"
	{
		!!Architecture "ArmV7"
	}
	MalterlibNativeClangArchitecture "armv7s"
	{
		!!Architecture "ArmV7s"
	}
	MalterlibNativeClangArchitecture "arm64"
	{
		!!Architecture "arm64"
	}
	MalterlibNativeClangArchitecture "arm64e"
	{
		|
		{
			Architecture "arm64e"
			&
			{
				Architecture "arm64"
				Target.Type "Driver"
				!Target.DriverType "DriverKit"
			}
		}
	}
	MalterlibNativeClangArchitecture "aarch64"
	{
		&
		{
			Architecture "arm64"
			PlatformFamily "Linux"
		}
	}
}

Property
{
	MalterlibXcodeBuildArchitecture define string = MalterlibNativeClangArchitecture
	MalterlibXcodeBuildArchitecture "x86_64"
	{
		!!PlatformFamily "Linux"
	}
}

Property
{
	!!PlatformIsDarwin true

	MalterlibNativeClangDarwinTarget define string

	MalterlibNativeClangDarwinTarget Format("{1,xpr($+4)}", MalterlibMinSupportedMacOSVersion->Parse("{}.{}", "int", "int")...)
	{
		!!PlatformFamily "macOS"
	}
	MalterlibNativeClangDarwinTarget Format("{1,xpr($+6)}", MalterlibMinSupportediOSVersion->Parse("{}.{}", "int", "int")...)
	{
		!!PlatformFamily "iOS"
	}
	MalterlibNativeClangDarwinTarget Format("{0,xpr($+9)}", MalterlibMinSupportedMacOSVersion->Parse("{}.{}", "int", "int")...)
	{
		&
		{
			PlatformFamily "macOS"
			MalterlibMinSupportedMacOSVersion >= "11.0"
		}
	}
}

Property
{
	MalterlibTargetTriple define string?
	MalterlibTargetTriple `@(MalterlibNativeClangArchitecture)-apple-darwin@(MalterlibNativeClangDarwinTarget)`
	{
		&
		{
			PlatformIsDarwin true
			!Target.DriverType "DriverKit"
		}
	}
	MalterlibTargetTriple `@(MalterlibNativeClangArchitecture)-unknown-linux-gnu`
	{
		!!PlatformFamily "Linux"
	}
}

Property
{
	MalterlibFullSymbolsOnLinux define bool = false // User(Toolset)=true: Enable full symbol generation on Linux
	MalterlibClangTimeTrace define bool = false // User(Debug)=true: Generate time traces for clang invocations
}

Compile
{
	&
	{
		PlatformFamily "macOS"
		|
		{
			CompileDialect "C"
			Compile.Type "Assembler"
		}
	}

	MinMacOSVersion define string?
	MinMacOSVersion MalterlibMinSupportedMacOSVersion
	{
		&
		{
			Compile.MinMacOSVersion undefined
			!Target.DriverType "DriverKit"
		}
	}
}

Compile
{
	TargetTriple define string?
	AsyncUnwindTables define bool?
}

Compile
{
	&
	{
		LanguageFamily "Native"
		|
		{
			CompileDialect "C"
			Compile.Type "Assembler"
		}
		|
		{
			PlatformIsDarwin true
			PlatformFamily "Linux"
		}
	}

	TargetTriple MalterlibTargetTriple
	{
		!MalterlibTargetTriple undefined
	}
	AsyncUnwindTables true
	{
		!Compile.Type "Assembler"
	}
}

Compile
{
	&
	{
		LanguageFamily "Native"
		PlatformFamily "Linux"
		|
		{
			CompileDialect "C"
			Compile.Type "Assembler"
		}
	}

	TargetTriple MalterlibTargetTriple
	{
		!MalterlibTargetTriple undefined
	}
//	AsyncUnwindTables true
}

Property
{
	MalterlibVerboseTemplateErrors define bool = false // User(Toolset)=true: Enabled more verbose template errors for clang
	MalterlibCodeCoverage define bool = false // User(Tests)=true: Set to true to enable code coverage
}

Property
{
	MalterlibCompileSupportTabSetings define bool = false
	MalterlibCompileSupportTabSetings true
	{
		&
		{
			GeneratorFamily "Xcode"
			!
			{
				|
				{
					// Directory/binary targets does not get the tab settings
					Compile.Type "Nib"
					Compile.Type "StaticLibrary"
					Compile.Type "DynamicLibrary"
					Compile.Type "XcodeBundle"

	/*
					// Text targets all get tab settings
					Compile.Type "Assembler"
					Compile.Type "C++"
					Compile.Type "C"
					Compile.Type "Header"
					Compile.Type "QtRcc"
					Compile.Type "QtUic"
					Compile.Type "MlTwk"
					Compile.Type "MalterlibFS"
					Compile.Type "WindowsResource"
					Compile.Type "MSBuildTargets"
					Compile.Type "AppxManifest"
					Compile.Type "ApplicationDefinition"
					Compile.Type "Page"
					Compile.Type "EmbeddedResource_ResX"
					Compile.Type "Settings"
					Compile.Type "C#"
					Compile.Type "ObjC++"
					Compile.Type "ObjC"
					Compile.Type "MacIcon"
					Compile.Type "None"
	*/
				}
			}
		}
	}
}

Compile
{
	!!MalterlibCompileSupportTabSetings true

	IndentWidth 4
	TabWidth 4
	UsesTabs true
}

Compile
{
	&
	{
		LanguageFamily "Native"
		|
		{
			Compile.Type "C"
		}
	}

	CLanguage define string?
	CLanguage "GNU11"
	{
		&
		{
			PlatformFamily "Linux"
			Compile.CLanguage undefined
		}
	}
	CLanguage "C11"
	{
		&
		{
			GeneratorFamily "Xcode"
			!PlatformFamily "Linux"
			Compile.CLanguage undefined
		}
	}
}

Property
{
	!!PlatformFamily "macOS"

	MaxSupportedPlatformVersion `@(MalterlibMaxSupportedMacOSVersion->Replace('.',''))0`
	{
		!!MaxSupportedPlatformVersion undefined
	}
}

Property
{
	!!PlatformFamily "iOS"

	MaxSupportedPlatformVersion `@(MalterlibMaxSupportediOSVersion->Replace('.',''))0`
	{
		!!MaxSupportedPlatformVersion undefined
	}
	PlatformVersion `@(Platform->Replace('.',''))0`->Replace('iOS','')
}

Property
{
	!!PlatformFamily "Emscripten"

	PlatformVersion 1000
}

Property
{
	MalterlibMSVCEnableUTF8 define bool = true
	MalterlibNoShortcuts define bool = false
	DoesNotUseMalterlib define bool = false
	AOCCDisableSSL define bool = false
	MalterlibDisableMalterlib define bool = false
	MalterlibDynamicCRT define bool = false
	MalterlibAlwaysUseLongWindowsPaths define bool = false
	MalterlibCustomConcurrentCompile define int?
}

Compile
{
	Warnings_UnusedCommandLineArgument define bool?
	Warnings_TautolagicalPointerCompare define bool?
	Warnings_UnusedFunction define bool?
	Warnings_UnusedValue define bool?
	Warnings_VarArgs define bool?
	Warnings_CharSubscripts define bool?
	Warnings_Cxx11Narrowing define bool?
	Warnings_OverloadedVirtual define bool?
	Warnings_Parentheses define bool?
	Warnings_UnusedLabel define bool?
	Warnings_NoUnused define bool?
	Warnings_NoVirtualOverride define bool?
	Warnings_DeprecatedEnumConversion define bool?
	Warnings_NoPessimizingMove define bool?

	AllCPUSubTypes define bool?
	StackGuard define bool?
}

// Assembler settings
Compile
{
	&
	{
		LanguageFamily "Native"
		Compile.Type "Assembler"
	}

	Warnings_UnusedCommandLineArgument false
	{
		&
		{
			GeneratorFamily "Xcode"
			!Target.PlatformToolset "com.apple.compilers.llvm.clang.malterlib_generator"
		}
	}
}

Property
{
	DefaultPrefixHeader define string?
	DefaultPrefixHeader `@(Builtin.BasePathAbsolute)/Malterlib/Core/Source/PrefixHeader/PCH_C.h`
	{
		&
		{
			GeneratorFamily "VisualStudio"
			DefaultPrefixHeader undefined
			|
			{
				Compile.Type "C"
				Compile.Type "ObjC"
			}
			!DocumentationEnabled true
			!Target.Type "Driver"
		}
	}

	DefaultPrefixHeader `@(Builtin.BasePathAbsolute)/Malterlib/Core/Source/PrefixHeader/PCH.h`
	{
		&
		{
			DefaultPrefixHeader undefined
			!DocumentationEnabled true
			!Target.Type "Driver"
		}
	}
}

// C and C++ Settings
Compile
{
	&
	{
		LanguageFamily "Native"
		|
		{
			CompileDialect "C"
		}
	}

	Warnings define string?
	Warnings "On"

	Warnings_DeprecatedDeclarations define bool?
	Warnings_AlignMismatch define bool?
	Warnings_ConversionToSmallerInt define bool?
	Warnings_ConversionToSmallerType define bool?
	Warnings_IncompatibleTypes define bool?
	Warnings_UnknownPragma define bool?
	Warnings_UnusedVariable define bool?
	Warnings_UnusedButSetVariable define bool?
	Warnings_Switch define bool?

	Warnings_UnusedExceptionParameter define bool?
	Warnings_UnusedExceptionParameter true
	{
		!!GeneratorFamily "Xcode"
	}

	WarningsAsErrors define bool?
	WarningsAsErrors true

	ClangUnstableWarnings define string?
	ClangUnstableWarnings "On"
	{
		&
		{
			!Target.PlatformToolsetCompiler "/opt/Development/Malterlib/llvm/unstable-emscripten/emscripten/emcc"
			|
			{
				!PlatformFamily "Windows"
				MalterlibUseClangForWindows true
			}
		}
	}

	EmscriptenWarnings define string?
