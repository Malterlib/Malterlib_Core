// Compile type deduction for native language
Compile
{
	!!LanguageFamily "Native"

	Type "Custom"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			!Compile.Custom_CommandLine ""
		}
	}

	Type "StaticLibrary"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.a"
			}
		}
	}

	Type "DynamicLibrary"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.dylib"
			}
		}
	}

	Type "XcodeBundle"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.framework"
				this.Identity "~*.xctest"
			}
		}
	}
	
	Type "Assembler"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.li"
				this.Identity "~*.asm"
				this.Identity "~*.s"
				this.Identity "~*.S"
			}
		}
	}

	Type "C++"
	{
		|
		{
			&
			{
				this.Type "File"
				Compile.Type ""
				|
				{
					this.Identity "~*.cpp"
					this.Identity "~*.cxx"
					this.Identity "~*.cc"
				}
			}
			&
			{
				this.Type "File"
				DocumentationEnabled true
				Compile.Type ""
				|
				{
					this.Identity "~*.h"
					this.Identity "~*.hpp"
					this.Identity "~*.dox" // For doxygen
				}
			}
		}
	}

	Type "C"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.c"
			}
		}
	}

	Type "Header"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.h"
				this.Identity "~*.hpp"
				this.Identity "~*.dox" // For doxygen
				!this.Identity "~*.*"
			}
		}
	}

	Type "QtRcc"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			this.Identity "~*.qrc"
		}
	}

	Type "QtUic"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			this.Identity "~*.ui"
		}
	}

	Type "MlTwk"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			this.Identity "~*.twk"
		}
	}

	Type "MalterlibFS"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			this.Identity "~*.MalterlibFSSpec"
		}
	}

	Type "WindowsResource"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
            this.Identity "~*.rc"
		}
	}

	Type "MSBuildTargets"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.targets"
				this.Identity "~*.props"
			}
		}
	}

	Type "VisualStudioVisualizer"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.natvis"
			}
		}
	}
}

// Compile type deduction for .NET shared
Compile
{
	!!LanguageFamily ".NET"

	Type "AppxManifest"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			this.Identity "~*.appxmanifest"
		}
	}
	Type "ApplicationDefinition"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			this.Identity "~*App.xaml"
		}
	}
	Type "Page"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			this.Identity "~*.xaml"
		}
	}
	Type "EmbeddedResource_ResX"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			this.Identity "~*.resx"
		}
	}
	Type "Settings"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			this.Identity "~*.settings"
		}
	}	
}

// Compile type deduction for C#
Compile
{
	!!Target.Language "C#"

	Type "C#"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			this.Identity "~*.cs"
		}
	}
}

Compile
{
	&
	{
		Documentation Doxygen
		Compile.Type "C++"
	}
	
	PreprocessorDefines "__cplusplus=201402L;@(Compile.PreprocessorDefines)"
}

Compile
{
	&
	{
		LanguageFamily "Native"
		|
		{
			PlatformIsDarwin true
			GeneratorFamily Xcode // Needed because the file type cannot be different per config
		}
	}

	Type "ObjC++"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.mm"
			}
		}
	}

	Type "ObjC"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.m"
			}
		}
	}

	Type "Nib"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.nib"
			}
		}
	}

	Type "Xib"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.xib"
			}
		}
	}

	Type "XCodeStoryboard"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.storyboard"
			}
		}
	}

	Type "XCodeAssets"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.xcassets"
			}
		}
	}

	Type "ShellScript"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.sh"
				this.Identity "~*.conf"
			}
 		}
	}
	
	Type "Python"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.py"
			}
		}
	}

	Type "JavaScript"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.js"
				this.Identity "~*.ts" // Typescript
			}
		}
	}

	
	Type "HTML"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.html"
				this.Identity "~*.xhtml"
				this.Identity "~*.htm"
			}
		}
	}
	
	Type "CSS"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.css"
				this.Identity "~*.less"
			}
		}
	}
	
	Type "PNG"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.png"
			}
		}
	}
	
	Type "SVG"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.svg"
			}
		}
	}
	
	Type "XML"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.xml"
			}
		}
	}
		
	Type "MacIcon"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.icns"
			}
		}
	}

	Type "StaticLibrary"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.a"
			}
		}
	}

	Type "DynamicLibrary"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.dylib"
			}
		}
	}
	
	Type "JSON"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.json"
			}
		}
	}
	
	// Malterlib build system types

	Type "MalterlibBuildSystem"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
			|
			{
				this.Identity "~*.MTarget"
				this.Identity "~*.MBuildSystem"
				this.Identity "~*.OldMBuildSystem"
				this.Identity "~*.MWorkspace"
				this.Identity "~*.MHeader"
				this.Identity "~*.MSettings"
				this.Identity "~*.MGeneratorSettings"
				this.Identity "~*.MBuildOptions"
				this.Identity "~*.MConfig"
				
				this.Identity "~*.MLBuildOptions"
				this.Identity "~*.ir"
				this.Identity "~*.irg"
			}
		}
	}


}

Compile
{
	///////////////////////////////
	// Leave this last
	///////////////////////////////

	Type "None"
	{
		&
		{
			this.Type "File"
			Compile.Type ""
		}
	}
}

// Optimization needs to be available for all types
Compile
{
	Optimize "Off"
	{
	}
	Optimize "Fast"
	{
		&
		{
			RealDebugCompiler "false"
			!RealConfiguration "Release Debug"
		}
	}

	// The following levels are not enabled for RealConfiguration as they require link time code generation which we don't want in debug
	Optimize "On"
	{
		!!Configuration "Release"
	}
	Optimize "Full"
	{
		!!Configuration "Optimized"
	}
}

Compile
{
	!!LanguageFamily .NET

	Symbols "Full"
	Symbols "FullForDebug"
	{
		!!RealDebugCompiler "true"
	}
	Symbols "None"
	{
		!!Configuration "Fast Compile"
	}

	Warnings "Pedantic"

	PreprocessorDefines "DMibNewBuildSystem;@(Compile.PreprocessorDefines);@(Builtin.Inherit)"
		
	PreprocessorDefines "DEBUG;@(Compile.PreprocessorDefines)"
	{
		!!DebugCode "true"
	}
	PreprocessorDefines "TRACE;@(Compile.PreprocessorDefines)"
	{
		!!DebugCode "true"
	}

	PreprocessorDefines "@(MalterlibUniqueConfig);DWorkspace_@(Workspace:this.Identity->Replace(' ', ''));DTarget_@(Target:this.Identity->Replace(' ', ''));DConfig_@(ConfigNoSpace);@(Compile.PreprocessorDefines)"
	{
	}
	PreprocessorDefines "DPConsole;@(Compile.PreprocessorDefines)"
	{
		!!Target.Type "ConsoleExecutable"
	}
	PreprocessorDefines "DMibConfig_RefcountDebugging;@(Compile.PreprocessorDefines)"
	{
		!!Malterlib_RefcountDebugging_Enable "true"
	}

	PreprocessorDefines "DMibConfig_Tests_Enable;@(Compile.PreprocessorDefines)"
	{
		!!Malterlib_Tests_Enable "true"
	}
	PreprocessorDefines "DMibConfig_Contracts_Enable;@(Compile.PreprocessorDefines)"
	{
		!!Malterlib_Contracts_Enable "true"
	}	
	PreprocessorDefines "DMibConfig_Memory_Shims_Enable;@(Compile.PreprocessorDefines)"
	{
		!!MalterlibMemory_Shims_Enable "true"
	}
	PreprocessorDefines "DMibConfig_MalterlibMemoryManager_Debug;@(Compile.PreprocessorDefines)"
	{
		!!MalterlibMemoryManager_Debug "true"
	}
	PreprocessorDefines "DMalterlibEnable32Bit;@(Compile.PreprocessorDefines)"
	{
		!!BuildArch_x86 "1"
	}
}

Property
{
	MalterlibPrefixHeaderWorkaround true

	MalterlibNativeClangArchitecture "@(Architecture)"

	MalterlibNativeClangArchitecture "i386" // Figure a way to include proper arch in Xcode
	{
		!!Architecture "le32"
	}
	
	MalterlibNativeClangArchitecture "i386"
	{
		!!Architecture "x86"
	}
	MalterlibNativeClangArchitecture "x86_64"
	{
		!!Architecture "x64"
	}
	MalterlibNativeClangArchitecture "ppc"
	{
		!!Architecture "ppc32"
	}

	MalterlibNativeClangArchitecture "armv7"
	{
		!!Architecture "ArmV7"
	}
	MalterlibNativeClangArchitecture "armv7s"
	{
		!!Architecture "ArmV7s"
	}
	MalterlibNativeClangArchitecture "arm64"
	{
		!!Architecture "Arm64"
	}
}

Property
{
	MalterlibXcodeBuildArchitecture "@(MalterlibNativeClangArchitecture)"
	MalterlibXcodeBuildArchitecture "x86_64"
	{
		!!PlatformFamily Linux
	}
}

Property
{
	!!PlatformIsDarwin true

	MalterlibNativeClangDarwinTarget "9"
	{
		!!Platform "OSX10.5"
	}
	MalterlibNativeClangDarwinTarget "10"
	{
		!!Platform "OSX10.6"
	}
	MalterlibNativeClangDarwinTarget "11"
	{
		!!Platform "OSX10.7"
	}
	MalterlibNativeClangDarwinTarget "12"
	{
		!!Platform "OSX10.8"
	}
	MalterlibNativeClangDarwinTarget "13"
	{
		!!Platform "OSX10.9"
	}
	MalterlibNativeClangDarwinTarget "14"
	{
		!!Platform "OSX10.10"
		!!Platform "iOS8.1"
	}
	MalterlibNativeClangDarwinTarget "15"
	{
		!!Platform "OSX10.11"
	}
	MalterlibNativeClangDarwinTarget "16"
	{
		!!Platform "OSX10.12"
	}
	MalterlibNativeClangDarwinTarget "17"
	{
		!!Platform "OSX10.13"
	}
}

Property
{
	MalterlibTargetTriple "@(MalterlibNativeClangArchitecture)-apple-darwin@(MalterlibNativeClangDarwinTarget)"
	{
		!!PlatformIsDarwin true
	}
	MalterlibTargetTriple "@(MalterlibNativeClangArchitecture)-pc-linux-gnu"
	{
		!!PlatformFamily Linux
	}
}


Property 
{
	MalterlibFullSymbolsOnLinux "false" // User(Toolset)=true: Enable full symbol generation on Linux
	{
		!!MalterlibFullSymbolsOnLinux ""
	}
}

Compile
{
	&
	{
		LanguageFamily Native
		PlatformIsDarwin true
		|
		{
			CompileDialect C
		}
	}

	TargetTriple "@(MalterlibTargetTriple)"
	AsyncUnwindTables true
}

Compile
{
	&
	{
		LanguageFamily Native
		PlatformFamily Linux
		|
		{
			CompileDialect C
			Compile.Type Assembler
		}
	}

	TargetTriple "@(MalterlibTargetTriple)"
//	AsyncUnwindTables true
}

Property
{
	MalterlibVerboseTemplateErrors "false" // User(Toolset)=true: Enabled more verbose template errors for clang
	{
		!!MalterlibVerboseTemplateErrors ""
	}
}

Property
{
	MalterlibCompileSupportTabSetings true
	{
		&
		{
			GeneratorFamily "Xcode"
			!
			{
				|
				{
					// Directory/binary targets does not get the tab settings
					Compile.Type "Nib"
					Compile.Type "StaticLibrary"
					Compile.Type "DynamicLibrary"
					Compile.Type "XcodeBundle"
					
	/*
					// Text targets all get tab settings
					Compile.Type "Assembler"
					Compile.Type "C++"
					Compile.Type "C"
					Compile.Type "Header"
					Compile.Type "QtRcc"
					Compile.Type "QtUic"
					Compile.Type "MlTwk"
					Compile.Type "MalterlibFS"
					Compile.Type "WindowsResource"
					Compile.Type "MSBuildTargets"
					Compile.Type "AppxManifest"
					Compile.Type "ApplicationDefinition"
					Compile.Type "Page"
					Compile.Type "EmbeddedResource_ResX"
					Compile.Type "Settings"
					Compile.Type "C#"
					Compile.Type "ObjC++"
					Compile.Type "ObjC"
					Compile.Type "MacIcon"
					Compile.Type "None"
	*/
				}
			}
		}
	}
}

Compile
{
	!!MalterlibCompileSupportTabSetings true

	IndentWidth 4
	TabWidth 4
	UsesTabs true
}

Compile
{
	&
	{
		LanguageFamily Native
		|
		{
			Compile.Type "C"
		}
	}
	
	CLanguage "GNU11"
	{
		&
		{
			PlatformFamily "Linux"
			Compile.CLanguage ""
		}
	}
}

Property
{
	!!PlatformFamily OSX
	MaxSupportedPlatformVersion "@(MalterlibMaxSupportedOSXVersion->Replace('.',''))0"
	{
		!!MaxSupportedPlatformVersion ""
	}
	PlatformVersion "@(Platform->Replace('.',''))0"
	PlatformVersion "@(PlatformVersion->Replace('OSX',''))"
}
Property
{
	!!PlatformFamily iOS
	MaxSupportedPlatformVersion "@(MalterlibMaxSupportediOSVersion->Replace('.',''))0"
	{
		!!MaxSupportedPlatformVersion ""
	}
	PlatformVersion "@(Platform->Replace('.',''))0"
	PlatformVersion "@(PlatformVersion->Replace('iOS',''))"

}

Property
{
	!!PlatformFamily "Emscripten"
	PlatformVersion "1000"
}

Property
{
	MalterlibMSVCEnableUTF8 true
	{
		!!MalterlibMSVCEnableUTF8 ""
	}
}

// Assembler settings
Compile
{
	&
	{
		LanguageFamily Native
		Compile.Type "Assembler"
	}

	Warnings_UnusedCommandLineArgument false
	{
		&
		{
			GeneratorFamily Xcode
			!Target.PlatformToolset "com.apple.compilers.llvm.clang.malterlib_generator"
		}
	}
}

// C and C++ Settings
Compile
{
	&
	{
		LanguageFamily Native
		|
		{
			CompileDialect C
		}
	}

	Warnings "On"
	WarningsAsErrors "true"
	ClangUnstableWarnings "On"
	{
		&
		{
			!Target.PlatformToolsetCompiler "/Development/Malterlib/llvm/unstable-emscripten/emscripten/emcc"
			|
			{
				!PlatformFamily Windows
				MalterlibUseClangForWindows true
			}
		}
	}
	
	EmscriptenWarnings "On"
	{
		!!PlatformFamily Emscripten
	}
	
	SysRoot "@(MalterlibSysRoot)"
	{
		!MalterlibSysRoot ""
	}

	LinkerInternalLinkageOpt "inline"
	{
		&
		{
			PlatformFamily Windows
			!Target.PlatformToolset v90
		}
	}

	ToolClass "DoxygenCompile"
	{
		!!Documentation Doxygen
	}
	
	FunctionSections true
	{
		!!PlatformFamily OSX
		!!PlatformFamily Linux
	}
	
	DataSections true
	{
		!!PlatformFamily OSX
		!!PlatformFamily Linux
	}

	Inline "Off"
	{
	}
	Inline "Automatic"
	{
		&
		{
			RealDebugCompiler "false"
			!RealConfiguration "Release Debug"
		}
	}
	Inline "Explicit"
	{
		!!RealConfiguration "Debug Inlined"
	}
	
	RuntimeLibrary "Static"
	{
		&
		{
			!Target.VisualStudioPlatform "Clang"
			!MalterlibDynamicCRT "true"
		}
	}
	RuntimeLibrary "StaticDebug"
	{
		&
		{
			!Target.VisualStudioPlatform "Clang"
			!MalterlibDynamicCRT "true"
			|
			{
				DebugCompiler "true"
				Configuration "Debug Optimized"
			}
		}
	}
	RuntimeLibrary "Dynamic"
	{
		&
		{
			!Target.VisualStudioPlatform "Clang"
			MalterlibDynamicCRT "true"
		}
	}
	RuntimeLibrary "DynamicDebug"
	{
		&
		{
			!Target.VisualStudioPlatform "Clang"
			MalterlibDynamicCRT "true"
			|
			{
				DebugCompiler "true"
				Configuration "Debug Optimized"
			}
		}
	}

	StructMemberAlignment "Default"
	{
		&
		{
			!Target.VisualStudioPlatform "Clang"
			PlatformType "Windows"
		}
	}
	
	AppleKernelOptionsCxx "true"
	{
		&
		{
			PlatformIsDarwin true
			Target.Type Driver
			Compile.Type "C++"
		}
	}
	
	AppleKernelOptions "true"
	{
		&
		{
			PlatformIsDarwin true
			Target.Type Driver
		}
	}

	Exceptions "C++"
	{
	}

	Exceptions "Off"
	{
		!!Target.Type "Driver"
	}

	PrefixHeader "@(Builtin.BasePathAbsolute)/Malterlib/Core/Source/PrefixHeader/PCH.h"
	{
		&
		{
			Compile.PrefixHeader ""
			!DocumentationEnabled true
			!MalterlibQtSupport "true"
			!Target.Type Driver
		}
	}
	PrefixHeader "@(Builtin.BasePathAbsolute)/Projects/Shared/PCHQt/PCH.h"
	{
		&
		{
			Compile.PrefixHeader ""
			!DocumentationEnabled true
			MalterlibQtSupport "true"
			!Target.Type Driver
		}
	}

	PrecompilePrefixHeader "true"
	{
		&
		{
			Compile.PrecompilePrefixHeader ""
			!DocumentationEnabled true
		}
	}
	PrecompilePrefixHeader "false"
	{
		&
		{
			|
			{
				this.Type "File"
				!this.Type "File"
			}
			Compile.PrefixHeader ""
		}
	}
	
	SearchPath "@(Compile.SearchPath);@(Builtin.Inherit)"
	
	Verbose false // User(Toolset)=true: Enables output of cc1 command line
	{
		&
		{
			PlatformToolsetFamily clang
			Compile.Verbose ""
		}
	}
	
	MiniOSVersion "@(Platform->Replace('iOS',''))"
	{
		!!PlatformFamily iOS
	}

	SizedDeallocation "true"
	{
		!!PlatformToolsetFamily "clang"
	}

	BuiltinSearchPath ""
	{
		!!PlatformToolsetFamily clang
	}

	SearchPath "@(Builtin.BasePathAbsolute)/External/libcxx/include;@(Compile.SearchPath)"
	{
		&
		{
			!MalterlibDisableMalterlib true
			MalterlibUseStaticLibCxx "true"
		}
	}
	SearchPath "@(Builtin.BasePathAbsolute)/External/libcxxabi/include;@(Compile.SearchPath)"
	{
		&
		{
			!MalterlibDisableMalterlib true
			MalterlibUseStaticLibCxxABI "true"
		}
	}

	SearchPath "@(Builtin.BasePathAbsolute)/SDK/WDK/inc/ddk;@(Builtin.BasePathAbsolute)/SDK/WDK/inc/api;@(Builtin.BasePathAbsolute)/SDK/WDK/inc/crt;@(Compile.SearchPath)"
	{
		&
		{
			Target.Type "Driver"
