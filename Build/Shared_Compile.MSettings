			Configuration "Fast Compile"
		}
	}

	SplitSymbols define bool?
	SplitSymbols true
	{
		&
		{
			PlatformFamily "Linux"
			|
			{
				Malterlib_LinuxLinker "gold"
				Malterlib_LinuxLinker "lld"
			}
			!MalterlibBuildServerBuild true
		}
	}

/*	SymbolFile `@(Builtin.IntermediateDirectory)@(Target.FileName).pdb`

	SymbolFile ""
	{
		!!Configuration "Fast Compile"
	}*/

	ConcurrentCompile define bool?
	ConcurrentCompile true
	{
		&
		{
			Compile.ConcurrentCompile undefined
			PlatformType "Windows"
			!Compile.PrecompilePrefixHeader "XInternalCreate"
			!Target.VisualStudioPlatform "Clang"
		}
	}

	FullEval true
	{
		&
		{
			GeneratorFamily "VisualStudio"
			Compile.PrecompilePrefixHeader "XInternalCreate"
		}
	}

	ForceSynchronousPDBWrites define bool?
	ForceSynchronousPDBWrites true
	{
		&
		{
			GeneratorFamily "VisualStudio"
			Compile.PrecompilePrefixHeader "XInternalCreate"
		}
	}

	SeparateWCharType define bool?
	SeparateWCharType true
	{
		&
		{
			!Target.VisualStudioPlatform "Clang"
			PlatformType "Windows"
		}
	}

	ForceConformanceInForLoopScope define bool?
	ForceConformanceInForLoopScope true
	{
		&
		{
			PlatformType "Windows"
			!Target.VisualStudioPlatform "Clang"
		}
	}

	PositionIndependantCode define bool?
	PositionIndependantCode true
	{
		!!PlatformFamily "Linux"
	}

	DynamicTypeInfo define bool?
	DynamicTypeInfo true
	{
		&
		{
			Compile.DynamicTypeInfo undefined
			MalterlibSupportSanitizerEnable_UndefinedBehavior true
		}
	}
	DynamicTypeInfo false
	{
		!!Compile.DynamicTypeInfo undefined
	}

	OpenMP define bool?
	OpenMP false
	{
		!Target.VisualStudioPlatform "Clang"
	}

	UseFullPaths define bool?
	UseFullPaths true
	{
		!Target.VisualStudioPlatform "Clang"
	}

	StringPooling define bool?
	StringPooling false
	{
		&
		{
			!Target.VisualStudioPlatform "Clang"
			PlatformType "Windows"
		}
	}
	StringPooling true
	{
		&
		{
			!Target.VisualStudioPlatform "Clang"
			PlatformType "Windows"
			|
			{
				Compile.Optimize "On"
				Compile.Optimize "Full"
			}
		}
	}

	MinimalRebuild define bool?
	MinimalRebuild false
	{
		&
		{
			!Target.VisualStudioPlatform "Clang"
			PlatformType "Windows"
		}
	}

	RuntimeChecks define string?
	RuntimeChecks "Off"
	RuntimeChecks "On"
	{
		&
		{
			RealDebugCompiler true
			!Compile.Type "C++Managed"
			!Target:Target.Type "Driver"
		}
	}
	RuntimeChecks "Fast"
	{
		&
		{
			RealConfiguration "Release Testing"
			!Compile.Type "C++Managed"
			!Target:Target.Type "Driver"
		}
	}

	Sanitize_Thread define bool?
	Sanitize_Thread true
	{
		!!MalterlibSupportSanitizerEnable_Thread true
	}

	Sanitize_Address define bool?
	Sanitize_Address true
	{
		!!MalterlibSupportSanitizerEnable_Address true
	}

	Sanitize_UndefinedBehavior define bool?
	Sanitize_UndefinedBehavior true
	{
		!!MalterlibSupportSanitizerEnable_UndefinedBehavior true
	}

	Sanitize_NoRecover define bool?
	Sanitize_NoRecover true
	{
		&
		{
			MalterlibSupportSanitizers true
			MalterlibSupportSanitizerEnable_NoRecover true
		}
	}

	FunctionLevelLinking define bool?
	FunctionLevelLinking false
	{
		&
		{
			PlatformType "Windows"
			!Target.VisualStudioPlatform "Clang"
		}
	}
	FunctionLevelLinking true
	{
		&
		{
			!Target.VisualStudioPlatform "Clang"
			PlatformType "Windows"
			|
			{
				RealDebugCompiler false
				Target.Type "Driver"
			}
		}
	}

	ExtendedInstructionSet define string?
	ExtendedInstructionSet "SSE2"
	{
		|
		{
			Architecture "x86"
		}
	}

	ExtendedInstructionSet "SSE3"
	{
		&
		{
			!PlatformFamily "Windows"
			Architecture "x64"
		}
	}

	ExtendedInstructionSet "AVX2"
	{
		&
		{
			RealConfiguration "Optimized"
			|
			{
				Architecture "x86"
				Architecture "x64"
			}
		}
	}

	FloatingPointModel define string?
	FloatingPointModel "Precise"
	{
		&
		{
			PlatformType "Windows"
			!Target.VisualStudioPlatform "Clang"
		}
	}

	FloatingPointExceptions define bool?
	FloatingPointExceptions false
	{
		!Target.VisualStudioPlatform "Clang"
	}

	EnableLanguageExtensions define bool?
	EnableLanguageExtensions true

	EnableFiberSafeOptimizations define bool?
	EnableFiberSafeOptimizations false
	{
		&
		{
			PlatformType "Windows"
			!Target.VisualStudioPlatform "Clang"
		}
	}

	CreateHotpatchableImage define bool?
	CreateHotpatchableImage false
	{
		&
		{
			PlatformType "Windows"
			!Target.VisualStudioPlatform "Clang"
		}
	}

	IgnoreStandardIncludePath define bool?
	IgnoreStandardIncludePath true
	{
		&
		{
			PlatformType "Windows"
			Target.Type "Driver"
		}
	}
}


// ObjC and ObjC++ Settings
Compile
{
	&
	{
		LanguageFamily "Native"
		PlatformIsDarwin true
		|
		{
			Compile.Type "ObjC"
			Compile.Type "ObjC++"
		}
	}

	PreprocessorDefines += "NS_FORMAT_ARGUMENT(A)="
}

// ObjC and ObjC++ Settings
Compile
{
	&
	{
		LanguageFamily "Native"
		PlatformIsDarwin true
		|
		{
			CompileDialect "C"
		}
	}

	ObjectiveCARC define bool?
	ObjectiveCARC false
	{
		&
		{
			Compile.ObjectiveCARC undefined
			|
			{
				PlatformVersion 1050
				PlatformVersion 1060
			}
		}
	}
	ObjectiveCARC true
	{
		&
		{
			Compile.ObjectiveCARC undefined
			!Target.DriverType "DriverKit"
		}
	}

	PreprocessorDefines += "DMibObjC_Arc"
	{
		!!Compile.ObjectiveCARC true
	}
}

// Windows resources
Compile
{
	&
	{
		LanguageFamily "Native"
		Compile.Type "WindowsResource"
	}

	Culture define string?
	Culture "0x0409"

	PreprocessorDefines =+ Builtin.Inherit

	PreprocessorDefines += "NDEBUG"
	{
		!!DebugCode false
	}
	PreprocessorDefines += "DBG=0"
	{
		&
		{
			DebugCode false
			Target.Type "Driver"
		}
	}
	PreprocessorDefines += "_DEBUG"
	{
		!!DebugCode true
	}
	PreprocessorDefines += "DBG=1"
	{
		&
		{
			DebugCode false
			Target.Type "Driver"
		}
	}
}

Compile
{
	&
	{
		Compile.Type "MalterlibFS"
		LanguageFamily "Native"
		|
		{
			PlatformIsDarwin true
			GeneratorFamily "Xcode" // Needed because the file type cannot be different per config
		}
	}

	GenericCompileType "GenericCustom"

	Custom_WorkingDirectory Target:Target.IntermediateDirectory->MakeAbsolute()
	Custom_Outputs [Compile.ObjectFileName, Compile.CppFileName]

	Custom_Inputs =+ "$(InputFilePath)"
	Custom_CommandLine `@(Builtin.MToolExe) VirtualFS -o @(Compile.ObjectFileName->Escape()) -ocpp @(Compile.CppFileName->Escape())`
	Custom_CommandLine `@(Compile.Custom_CommandLine) -oidsdepend @(Compile.MalterlibDependencyFileName->Escape()) `
	{
		!Compile.MalterlibDependencyFileName undefined
	}
	Custom_CommandLine `@(Compile.Custom_CommandLine) -platform @(Compile.Platform->Escape()) `
	{
		!Compile.Platform undefined
	}
	Custom_CommandLine `@(Compile.Custom_CommandLine) -verbose `
	{
		!!Compile.VerboseLogging true
	}
	Custom_CommandLine `@(Compile.Custom_CommandLine) -elf32 `
	{
		!!Compile.OutputAsObjectFile "Elf32"
	}
	Custom_CommandLine `@(Compile.Custom_CommandLine) -elf64 `
	{
		!!Compile.OutputAsObjectFile "Elf64"
	}
	Custom_CommandLine `@(Compile.Custom_CommandLine) -asm `
	{
		!!Compile.OutputAsAssembly true
	}
	Custom_CommandLine `@(Compile.Custom_CommandLine) @(fg_RecursiveStringArrayToCommandLine(Compile.ExtraCompilerFlags)) `
	{
		!Compile.ExtraCompilerFlags undefined
	}
	Custom_CommandLine `@(Compile.Custom_CommandLine) -dest @(Compile.MalterlibFSPathPrefix->Escape()) `
	{
		!Compile.MalterlibFSPathPrefix undefined
	}
	Custom_CommandLine `@(Compile.Custom_CommandLine) "$(InputFilePath)" `
}

Compile
{
	&
	{
		GeneratorFamily "Xcode"
		Compile.GenericCompileType undefined
		!Compile.Custom_CommandLine undefined
	}

	GenericCompileType "GenericCustom"
}

Compile
{
	DoCompileAndLink define bool?
	ObjectFileName define string?
}

Property
{
	MalterlibDisableDependencyFiles define bool = false
}

// MalterlibFS
Compile
{
	&
	{
		LanguageFamily "Native"
		Compile.Type "MalterlibFS"
	}

	DoCompileAndLink true
	{
		!!Compile.DoCompileAndLink undefined
	}

	VerboseLogging define bool?
	VerboseLogging false

	MalterlibFSPathPrefix define string?

	ObjectFileName `@(Target:Target.IntermediateDirectory)@(Builtin.SourceFileName)_VirtualFS.obj`
	{
		!!PlatformFamily "Windows"
	}
	ObjectFileName `@(Target:Target.IntermediateDirectory)@(Builtin.SourceFileName)_VirtualFS.s`
	{
		!PlatformFamily "Windows"
	}
	ASMFileName define string?
	ASMFileName Compile.ObjectFileName
	{
		!PlatformFamily "Windows"
	}

	Platform define string?
	Platform PlatformFamily
	{
		!!PlatformFamily "Linux"
		!!PlatformFamily "macOS"
	}

	CppFileName define string?
	CppFileName `@(Target:Target.IntermediateDirectory)@(Builtin.SourceFileName)_VirtualFSCPP.cpp`
	//DependencyFileName `@(Target:Target.IntermediateDirectory)@(Builtin.SourceFileName)_VirtualFS.d`

	MalterlibDependencyFileName define string?
	MalterlibDependencyFileName `@(Target:Target.IntermediateDirectory)MalterlibDependencies/@(Builtin.SourceFileName)_VirtualFS.MalterlibDependency`
	{
		&
		{
			GeneratorFamily "Xcode"
			!MalterlibDisableDependencyFiles true
		}
	}

	SymbolName define string?
	SymbolName "_gc_VFS_Bytes"
	{
		&
		{
			PlatformFamily "Windows"
			Architecture "x86"
		}
	}

	OutputAsObjectFile define one_of(bool, string)?
	OutputAsObjectFile true
	{
		&
		{
			Compile.OutputAsObjectFile undefined
			PlatformFamily "Windows"
		}
	}
	OutputAsObjectFile false
	{
		!!Compile.OutputAsObjectFile undefined
	}

	OutputAsAssembly define bool?
	OutputAsAssembly true
	{
		&
		{
			Compile.OutputAsAssembly undefined
			|
			{
				PlatformFamily "Linux"
				PlatformFamily "macOS"
			}
		}
	}
	OutputAsAssembly false
	{
		!!Compile.OutputAsAssembly undefined
	}

	/*OutputAsObjectFile Elf32
	{
		&
		{
			!PlatformFamily "Windows"
			ArchitectureBitness 32
		}
	}
	OutputAsObjectFile Elf64
	{
		&
		{
			!PlatformFamily "Windows"
			ArchitectureBitness 64
		}
	}*/
}

// MlTwk
Compile
{
	&
	{
		LanguageFamily "Native"
		Compile.Type "MlTwk"
	}

	DoCompileAndLink true
	{
		&
		{
			Compile.DoCompileAndLink undefined
			!DebugCode true
            !GeneratorFamily "Xcode" // Due to limitations in Xcode we always compile and link
		}
	}
	DoCompileAndLink false
	{
		&
		{
			Compile.DoCompileAndLink undefined
			DebugCode true
            !GeneratorFamily "Xcode" // Due to limitations in Xcode we always compile and link
		}
	}

	GenerateDebugInformation define bool?
	GenerateDebugInformation true
	{
		!!Compile.GenerateDebugInformation undefined
	}

	ObjectFileName `@(MalterlibQtTweakPath)/@(Builtin.SourceFileName)_Twk.cpp`
}


// Windows assembler settings
Compile
{
	&
	{
		LanguageFamily "Native"
		Compile.Type "Assembler"
		PlatformType "Windows"
	}

	PreserveIdentifierCase define bool?
	PreserveIdentifierCase true
	{
	}
}

// C#
Compile
{
	&
	{
		Target:Target.Language "C#"
		Compile.Type "Compile"
	}
}

Property
{
	f_ExpandCustomCommandOutputs function (string _Output) string = ""
	f_ExpandCustomCommandOutputs =+ `if exist @(_Output->EscapeHost()) MTool TouchOrCreate @(_Output->EscapeHost())\r\n`

	MalterlibIntermediateDirectoryBase define string = `@(MalterlibCompiledFilesSourceBase)/@(Workspace:Workspace.Name)/Intermediate/`

	f_ConvertCustomCommandInputs function (string _Input) [string] = []
	f_ConvertCustomCommandInputs =+ _Input->FindFilesRecursiveIn("*")
	{
		&
		{
			!_Input->StartsWith(MalterlibIntermediateDirectoryBase) true
			_Input->DirectoryExists() true
		}
	}
	f_ConvertCustomCommandInputs =+ _Input
	{
		|
		{
			_Input->StartsWith(MalterlibIntermediateDirectoryBase) true
			!_Input->DirectoryExists() true
		}
	}
}

Compile
{
	!!Compile.Type "Custom"

	Custom_WorkingDirectory `@(this.Identity->GetPath())`
	{
		!!Compile.Custom_WorkingDirectory undefined
	}

	FullEval true
	Custom_VerifyInputsAndOutputsExist false
	{
		!!GeneratorFamily "VisualStudio"
	}

	Custom_Message `Custom @(File:this.Identity->GetFile())`
	{
		&
		{
			GeneratorFamily "VisualStudio"
			this.Type "File"
		}
	}

	RealCustom_Inputs define [string] = []

	RealCustom_Inputs (Compile.Custom_Inputs || [])->ForEach("f_ConvertCustomCommandInputs")

	CustomCombined_CommandLine define string?
	CustomCombined_CommandLine 	`@(Compile.Custom_WorkingDirectory->GetDrive())\r\n`\
								`cd @(Compile.Custom_WorkingDirectory->Escape())\r\n`\
								`call @(MalterlibExportEnvironmentScript->EscapeHost())\r\n`\
								`@((Compile.Custom_CommandLine || "")->Replace('">"', ">")->Replace("&& ", "&& ^\r\n"))\r\n`\
								`@((Compile.Custom_Outputs || [])->ForEach("f_ExpandCustomCommandOutputs"))\r\n`
	{
		!!GeneratorFamily "VisualStudio"
	}
}
