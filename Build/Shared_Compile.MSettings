Property
{
	f_ExpandCustomCommandOutputs function (string _Output) string = ""
	f_ExpandCustomCommandOutputs =+ `if exist @(_Output->EscapeHost()) MTool TouchOrCreate @(_Output->EscapeHost())\r\n`

	MalterlibIntermediateDirectoryBase: string = `@(MalterlibCompiledFilesWarkspaceBase)/Int/`

	f_ConvertCustomCommandInputs function (string _Input) [string] = []
	f_ConvertCustomCommandInputs =+ _Input->FindFilesRecursiveIn("*")
	{
		&
		{
			!_Input->StartsWith(MalterlibIntermediateDirectoryBase) true
			_Input->DirectoryExists() true
		}
	}
	f_ConvertCustomCommandInputs =+ _Input
	{
		|
		{
			_Input->StartsWith(MalterlibIntermediateDirectoryBase) true
			!_Input->DirectoryExists() true
		}
	}
}

Compile
{
	|
	{
		Compile.Type "Custom"
		Compile.GenericCompileType "GenericCustom"
	}

	Custom_WorkingDirectory `@(this.Identity->GetPath())`
	{
		!!Compile.Custom_WorkingDirectory undefined
	}

	FullEval true
	Custom_VerifyInputsAndOutputsExist true
	{
		!!GeneratorFamily "VisualStudio"
	}

	Custom_BuildInParallel: bool?
	Custom_BuildInParallel true
	{
		!!GeneratorFamily "VisualStudio"
	}

	Custom_MinimalRebuildFromTracking: bool?
	Custom_MinimalRebuildFromTracking true
	{
		!!GeneratorFamily "VisualStudio"
	}

	Custom_Message `Custom @(File:this.Identity->GetFile())`
	{
		&
		{
			GeneratorFamily "VisualStudio"
			this.Type "File"
		}
	}

	RealCustom_Inputs: [string] = []

	RealCustom_Inputs (Compile.Custom_Inputs || [])->ForEach(&f_ConvertCustomCommandInputs)

	CustomCombined_CommandLine: string?
	CustomCombined_CommandLine	`@(Compile.Custom_WorkingDirectory->GetDrive())\r\n`\
								`cd @(Compile.Custom_WorkingDirectory->Escape())\r\n`\
								`call @(MalterlibExportEnvironmentScript->EscapeHost())\r\n`\
								`@((Compile.Custom_CommandLine || "")->Replace('">"', ">")->Replace("&& ", "&& ^\r\n"))\r\n`\
								`@((Compile.Custom_Outputs || [])->ForEach(&f_ExpandCustomCommandOutputs))\r\n`
	{
		!!GeneratorFamily "VisualStudio"
	}
}

Import "Shared_Compile_MalterlibFS.MSettings"

Compile
{
	&
	{
		GeneratorFamily "Xcode"
		Compile.GenericCompileType undefined
		!Compile.Custom_CommandLine undefined
	}

	GenericCompileType "GenericCustom"
}
