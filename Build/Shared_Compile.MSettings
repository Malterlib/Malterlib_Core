			}
		}
	}
	DynamicTypeInfo false
	{
		&
		{
			Compile.DynamicTypeInfo undefined
			!Target.CLRSupport true
		}
	}

	OpenMP: bool?
	OpenMP false
	{
		&
		{
			GeneratorFamily "VisualStudio"
			!Target.VisualStudioPlatform "Clang"
		}
	}

	UseFullPaths: bool?
	UseFullPaths true
	{
		&
		{
			GeneratorFamily "VisualStudio"
			!Target.VisualStudioPlatform "Clang"
		}
	}

	StringPooling: bool?
	StringPooling false
	{
		&
		{
			PlatformType "Windows"
			!Target.VisualStudioPlatform "Clang"
			!Target.PlatformToolset "ClangCL"
		}
	}
	StringPooling true
	{
