// Compile type deduction for native language
Compile
{
	!!LanguageFamily "Native"

	Type "Custom"
	{
		&
		{
			!GeneratorFamily "Xcode"
			this.Type "File"
			Compile.Type undefined
			!Compile.Custom_CommandLine undefined
		}
	}

	Type "StaticLibrary"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.a"
			}
		}
	}

	Type "DynamicLibrary"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.dylib"
			}
		}
	}

	Type "XcodeBundle"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.framework"
				this.Identity ~"*.xctest"
			}
		}
	}

	Type "ShellScript"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*/mib"
				this.Identity ~"*.sh"
				this.Identity ~"*.conf"
			}
 		}
	}

	Type "Assembler"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.li"
				this.Identity ~"*.asm"
				this.Identity ~"*.s"
				this.Identity ~"*.S"
			}
		}
	}

	Type "C++"
	{
		|
		{
			&
			{
				this.Type "File"
				Compile.Type undefined
				|
				{
					this.Identity ~"*.cpp"
					this.Identity ~"*.cxx"
					this.Identity ~"*.cc"
				}
			}
			&
			{
				this.Type "File"
				DocumentationEnabled true
				Compile.Type undefined
				|
				{
					this.Identity ~"*.h"
					this.Identity ~"*.hpp"
					this.Identity ~"*.dox" // For doxygen
				}
			}
		}
	}

	Type "C"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.c"
			}
		}
	}

	Type "Header"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.h"
				this.Identity ~"*.hpp"
				this.Identity ~"*.dox" // For doxygen
				!this.Identity ~"*.*"
			}
		}
	}

	Type "QtRcc"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			this.Identity ~"*.qrc"
		}
	}

	Type "QtUic"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			this.Identity ~"*.ui"
		}
	}

	Type "MlTwk"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			this.Identity ~"*.twk"
		}
	}

	Type "MalterlibFS"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			this.Identity ~"*.MalterlibFSSpec"
		}
	}

	Type "WindowsResource"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
            this.Identity ~"*.rc"
		}
	}

	Type "MSBuildTargets"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.targets"
				this.Identity ~"*.props"
			}
		}
	}

	Type "WindowsManifest"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.manifest"
			}
		}
	}

	Type "VisualStudioVisualizer"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.natvis"
			}
		}
	}

	Type "PList"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.plist"
			}
		}
	}

	Type "DriverKitInterface"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.iig"
			}
		}
	}

	Type "Object"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.obj"
				this.Identity ~"*.o"
			}
		}
	}
}

// Compile type deduction for .NET shared
Compile
{
	!!LanguageFamily ".NET"

	Type "AppxManifest"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			this.Identity ~"*.appxmanifest"
		}
	}
	Type "ApplicationDefinition"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			this.Identity ~"*App.xaml"
		}
	}
	Type "Page"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			this.Identity ~"*.xaml"
		}
	}
	Type "EmbeddedResource_ResX"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			this.Identity ~"*.resx"
		}
	}
	Type "Settings"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			this.Identity ~"*.settings"
		}
	}
}

// Compile type deduction for C#
Compile
{
	!!Target.Language "C#"

	Type "C#"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			this.Identity ~"*.cs"
		}
	}
}

Compile
{
	&
	{
		Documentation "Doxygen"
		Compile.Type "C++"
	}

	PreprocessorDefines += "__cplusplus=201402L"
}

Compile
{
	&
	{
		LanguageFamily "Native"
		|
		{
			PlatformIsDarwin true
			GeneratorFamily "Xcode" // Needed because the file type cannot be different per config
		}
	}

	GenericCompileType define string?

	GenericCompileType "GenericCompile"
	{
		!!Compile.Type "DriverKitInterface"
	}


	Type "ObjC++"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.mm"
			}
		}
	}

	Type "ObjC"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.m"
			}
		}
	}

	Type "Nib"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.nib"
			}
		}
	}

	Type "Xib"
	{
		&
		{
			this.Type "File"
			Compile.Type undefined
			|
			{
				this.Identity ~"*.xib"
			}
