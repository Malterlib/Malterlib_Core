// Windows paths
Property
{
	!!HostPlatformFamily "Windows"

	MalterlibDependenciesDirectory "X:/CompiledFiles/Dependencies"
	{
		!!MalterlibDependenciesDirectory ""
	}
	MalterlibCompiledFiles "X:/CompiledFiles/"
	{
		!!MalterlibCompiledFiles ""
	}
	MalterlibCompiledFiles "@(MalterlibCompiledFiles->UnixPath())"
	{
		!MalterlibCompiledFiles ""
	}

	MalterlibDevelopmentRoot "X:/Development"
	{
		!!MalterlibDevelopmentRoot ""
	}


    MalterlibDeployRoot "X:\\Deploy"
	{
		!!MalterlibDeployRoot ""
	}

    MalterlibRemoteDeployRoot "R:\\Deploy"
	{
		!!MalterlibRemoteDeployRoot ""
	}

    MalterlibRemoteDeployDebugRoot "C:\\Deploy"
	{
		!!MalterlibRemoteDeployDebugRoot ""
	}

	MalterlibDeploySymbolsPath "Z:/Development/Symbols"
	{
		!!MalterlibDeploySymbolsPath ""
	}
}

// Unix paths
Property
{
	!!HostPlatformFamily "OSX"
	!!HostPlatformFamily "Linux"

	MalterlibDependenciesDirectory "/CompiledFiles/Dependencies"
	{
		&
		{
			MalterlibDependenciesDirectory ""
			!Empty "@('/'->FindDirectoriesIn('CompiledFiles'))"
		}
	}

	MalterlibDependenciesDirectory "@(HOME)/.CompiledFiles/Dependencies"
	{
		!!MalterlibDependenciesDirectory ""
	}

	MalterlibCompiledFiles "/CompiledFiles/"
	{
		&
		{
			MalterlibCompiledFiles ""
			!Empty "@('/'->FindDirectoriesIn('CompiledFiles'))"
		}
	}

	MalterlibCompiledFiles "@(HOME)/.CompiledFiles/"
	{
		!!MalterlibCompiledFiles ""
	}

	MalterlibDevelopmentRoot "/Development"
	{
		!!MalterlibDevelopmentRoot ""
	}

    MalterlibDeployRoot "/Deploy"
	{
		!!MalterlibDeployRoot ""
	}

    MalterlibRemoteDeployRoot "/RemoteDeploy"
	{
		!!MalterlibRemoteDeployRoot ""
	}

    MalterlibRemoteDeployDebugRoot "/LocalDeploy"
	{
		!!MalterlibRemoteDeployDebugRoot ""
	}

	MalterlibDeploySymbolsPath "Z:/Development/Symbols"
	{
		!!MalterlibDeploySymbolsPath ""
	}
}

Property
{
	MaltelibBasePathAbsolute "@(Builtin.BasePathAbsolute)"
	MaltelibBasePathName "@(MaltelibBasePathAbsolute->GetFile())"
	
	MalterlibCompiledFilesSourceBase "@(MalterlibCompiledFiles)@(MaltelibBasePathName)-@(Builtin.GeneratedBuildSystemDir->HashSHA256('8'))"
}

// Calculated properties
Property
{
	MalterlibTargetNameType "Normal"
	{
		&
		{
			Property.MalterlibTargetNameType ""
			|
			{
				Target.Type StaticLibrary
				Target.Type DynamicLibrary
				Target.Type XcodeBundle
				Target.Type SharedDynamicLibrary
			}
		}
	}
	MalterlibTargetNameType "Suffixed"
	{
		&
		{
			PlatformFamily Windows
			Property.MalterlibTargetNameType ""
		}
	}
	MalterlibTargetNameType "Config"
	{
		&
		{
			!PlatformFamily Windows
			Property.MalterlibTargetNameType ""
		}
	}

    MalterlibGenerateLibrary "true"
	{
		!!MalterlibGenerateLibrary ""
	}

    MalterlibGenerateLibrary "false"
	{
		&
		{
			MalterlibGenerateLibrary ""
			DebugCompiler "true"
		}
	}
    MalterlibGenerateLibrary "true"
	{
		&
		{
			MalterlibGenerateLibrary ""
			DebugCompiler "false"
		}
	}
}
