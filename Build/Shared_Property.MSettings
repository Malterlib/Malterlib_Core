Property
{
	MalterlibDependenciesDirectory: string
	MalterlibCompiledFiles: string
	MalterlibDevelopmentRoot: string
	MalterlibDeployRoot: string
	MalterlibRemoteDeployDebugRoot: string
	MalterlibDeploySymbolsPath: string
	HOME: string
}

// Windows paths
Property
{
	!!HostPlatformFamily "Windows"

	MalterlibCompiledFiles "X:/CompiledFiles/"
	{
		&
		{
			MalterlibCompiledFiles undefined
			![] "X:/"->FindDirectoriesIn("CompiledFiles")
		}
	}
	MalterlibCompiledFiles "C:/CompiledFiles/"
	{
		&
		{
			MalterlibCompiledFiles undefined
			![] "C:/"->FindDirectoriesIn("CompiledFiles")
		}
	}
	MalterlibCompiledFiles `@(HOME)/.CompiledFiles/`
	{
		!!MalterlibCompiledFiles undefined
	}
	MalterlibCompiledFiles MalterlibCompiledFiles->UnixPath()


	MalterlibDependenciesDirectory MalterlibCompiledFiles / "Dependencies"
	{
		!!MalterlibDependenciesDirectory undefined
	}

	MalterlibDevelopmentRoot "X:/Development"
	{
		&
		{
			MalterlibDevelopmentRoot undefined
			![] "X:/"->FindDirectoriesIn("Development")
		}
	}

	MalterlibDevelopmentRoot "C:/Development"
	{
		&
		{
			MalterlibDevelopmentRoot undefined
			![] "C:/"->FindDirectoriesIn("Development")
		}
	}

	MalterlibDevelopmentRoot `@(HOME)/.Development/`
	{
		!!MalterlibDevelopmentRoot undefined
	}

	MalterlibDevelopmentRoot "X:/Development"
	{
		!!MalterlibDevelopmentRoot undefined
	}

	MalterlibDeployRoot "X:/Deploy"
	{
		&
		{
			MalterlibDeployRoot undefined
			![] "X:/"->FindDirectoriesIn("Deploy")
		}
	}

	MalterlibDeployRoot "C:/Deploy"
	{
		&
		{
			MalterlibDeployRoot undefined
			![] "C:/"->FindDirectoriesIn("Deploy")
		}
	}

	MalterlibDeployRoot `@(HOME)/.Deploy`
	{
		!!MalterlibDeployRoot undefined
	}

	MalterlibRemoteDeployDebugRoot "C:\\Deploy"
	{
		!!MalterlibRemoteDeployDebugRoot undefined
	}

	MalterlibDeploySymbolsPath "Z:/Development/Symbols"
	{
		!!MalterlibDeploySymbolsPath undefined
	}
}

// Unix paths
Property
{
	!!HostPlatformFamily "macOS"
	!!HostPlatformFamily "Linux"

	MalterlibDependenciesDirectory "/opt/CompiledFiles/Dependencies"
	{
		&
		{
			MalterlibDependenciesDirectory undefined
			![] "/opt"->FindDirectoriesIn("CompiledFiles")
		}
	}

	MalterlibDependenciesDirectory "/CompiledFiles/Dependencies"
	{
		&
		{
			MalterlibDependenciesDirectory undefined
			![] "/"->FindDirectoriesIn("CompiledFiles")
		}
	}


	MalterlibDependenciesDirectory `@(HOME)/.CompiledFiles/Dependencies`
	{
		!!MalterlibDependenciesDirectory undefined
	}

	MalterlibCompiledFiles "/opt/CompiledFiles/"
	{
		&
		{
			MalterlibCompiledFiles undefined
			![] "/opt"->FindDirectoriesIn("CompiledFiles")
		}
	}

	MalterlibCompiledFiles "/CompiledFiles/"
	{
		&
		{
			MalterlibCompiledFiles undefined
			![] "/"->FindDirectoriesIn("CompiledFiles")
		}
	}

	MalterlibCompiledFiles `@(HOME)/.CompiledFiles/`
	{
		!!MalterlibCompiledFiles undefined
	}

	MalterlibDevelopmentRoot "/opt/Development"
	{
		&
		{
			MalterlibDevelopmentRoot undefined
			![] "/opt"->FindDirectoriesIn("Development")
		}
	}

	MalterlibDevelopmentRoot "/Development"
	{
		!!MalterlibDevelopmentRoot undefined
	}

	MalterlibDeployRoot "/opt/Deploy"
	{
		&
		{
			MalterlibDeployRoot undefined
			![] "/opt"->FindDirectoriesIn("Deploy")
		}
	}

	MalterlibDeployRoot "/Deploy"
	{
		&
		{
			MalterlibDeployRoot undefined
			![] "/"->FindDirectoriesIn("Deploy")
		}
	}

	MalterlibDeployRoot `@(HOME)/.Deploy`
	{
		!!MalterlibDeployRoot undefined
	}

	MalterlibRemoteDeployDebugRoot "/opt/LocalDeploy"
	{
		!!MalterlibRemoteDeployDebugRoot undefined
	}

	MalterlibDeploySymbolsPath "Z:/Development/Symbols"
	{
		!!MalterlibDeploySymbolsPath undefined
	}
}

Property
{
	MaltelibBasePathAbsolute: string = Builtin.BasePathAbsolute
	MaltelibBasePathName: string = MaltelibBasePathAbsolute->GetFile()
	MalterlibShortenPaths: bool = false

	MalterlibCompiledFilesSourceBase: string = `@(MalterlibCompiledFiles)@(MaltelibBasePathName)-@(Builtin.GeneratedBuildSystemDir->HashSHA256(8))`
	MalterlibCompiledFilesSourceBase `@(MalterlibCompiledFiles)@(MaltelibBasePathName->ParseFormatString("{}", "{sj3,a-}"))@(Builtin.GeneratedBuildSystemDir->HashSHA256(3))`
	{
		!!MalterlibShortenPaths true
	}

	MalterlibCompiledFilesWarkspaceBase: string = `@(MalterlibCompiledFilesSourceBase)/@(Workspace:Workspace.Name)`
	MalterlibCompiledFilesWarkspaceBase `@(MalterlibCompiledFilesSourceBase)/@(Workspace:Workspace.Name->ParseFormatString("{}", "{sj3,a-}"))@(Workspace:Workspace.Name->HashSHA256(3))`
	{
		!!MalterlibShortenPaths true
	}

	GeneratedGlobalDirectory: string = `@(MalterlibCompiledFilesSourceBase)/Generated/`
}

// Calculated properties
Property
{
	MalterlibTargetNameType "Normal"
	{
		&
		{
			Property.MalterlibTargetNameType undefined
			|
			{
				Target.Type "StaticLibrary"
				Target.Type "DynamicLibrary"
				Target.Type "XcodeBundle"
				Target.Type "SharedDynamicLibrary"
			}
		}
	}
	MalterlibTargetNameType "Config"
	{
		!!Property.MalterlibTargetNameType undefined
	}

	MalterlibGenerateLibrary: bool = true

/*	MalterlibGenerateLibrary false
	{
		&
		{
			MalterlibGenerateLibrary undefined
			DebugCompiler true
		}
	}
	MalterlibGenerateLibrary true
	{
		&
		{
			MalterlibGenerateLibrary undefined
			DebugCompiler false
		}
	}*/
}
