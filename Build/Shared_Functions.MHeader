Property
{
	HasTargetIdentityHelper_Identity: string
	fg_HasTargetIdentity function(string _Target) bool = false
	fg_HasTargetIdentity true
	{
		!!HasTargetIdentityHelper_Identity GetProperty(&TargetIdentity, _Target)
	}

	fg_IsTargetInDependencies function(string _Target) bool = Target:Target.DependenciesNames->ContainsListElement(_Target)

	fg_IsTargetInWorkspace function(string _Target) bool = false
	fg_IsTargetInWorkspace Workspace:Workspace.AllTargets->ForEach(&fg_HasTargetIdentity, {HasTargetIdentityHelper_Identity: _Target})

	fg_ExpandRecursiveStringArrayHelper function(one_of(string, [string]) _Flag) [string] = []
	fg_ExpandRecursiveStringArrayHelper =+ _Flag
	{
		!!true IsString(_Flag)
	}
	fg_ExpandRecursiveStringArrayHelper =+ _Flag
	{
		!!true IsArray(_Flag)
	}
	fg_ExpandRecursiveStringArrayHelper Error("Expected string arrays")
	{
		&
		{
			!true IsArray(_Flag)
			!true IsString(_Flag)
		}
	}

	fg_ExpandRecursiveStringArray function([one_of(string, [string])] _Strings) [string] = _Strings->ForEach(&fg_ExpandRecursiveStringArrayHelper)

	f_ToStringArray function(one_of(string, [string]) _Flag) [string] = []
	f_ToStringArray =+ _Flag

	fg_StringArrayToCommandLine function(string _Flag) string = ""
	fg_StringArrayToCommandLine =+ `@(_Flag->Escape())`
	{
		!!fg_StringArrayToCommandLine undefined
	}
	fg_StringArrayToCommandLine =+ ` @(_Flag->Escape())`
	{
		!fg_StringArrayToCommandLine undefined
	}

	fg_RecursiveStringArrayToCommandLine function([one_of(string, [string])] _Commands) string = ""
	fg_RecursiveStringArrayToCommandLine _Commands->ForEach(&fg_ExpandRecursiveStringArrayHelper)->ForEach(&fg_StringArrayToCommandLine)

	fg_RemoveEmptyStringsFromArrayHelper function(string _String) [string] = []
	fg_RemoveEmptyStringsFromArrayHelper =+ _String
	{
		!_String->IsEmpty() true
	}

	fg_RemoveEmptyStringsFromArray function([string] _Strings) [string] = _Strings->ForEach(&fg_RemoveEmptyStringsFromArrayHelper)

	f_RemoveFromArrayHelper function(any _Value) [any] = []
	f_RemoveFromArrayHelper =+ _Value
	{
		&
		{
			_Value != ToRemove
		}
	}

	f_RemoveFromArray function([any] _Array, any _ToRemove) [any] = _Array->ForEach(&f_RemoveFromArrayHelper, {ToRemove: _ToRemove})

	fg_EscapeCommand function(string _String) string

	fg_EscapeCommand _String->EscapeWindows()
	{
		&
		{
			fg_EscapeCommand undefined
			GeneratorFamily "VisualStudio"
		}
	}

	fg_EscapeCommand _String->EscapeBash()
	{
		!!fg_EscapeCommand undefined
	}
}
