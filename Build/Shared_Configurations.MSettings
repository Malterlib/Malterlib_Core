	DefaultOSXPlatform "10.13"
	{
		!!MalterlibSupportSanitizers true
	}

	EnablePlatform_Windows true // User: Enables Windows platform
	{
		&
		{
			EnablePlatform_Windows ""
			GeneratorFamily "VisualStudio"
		}
	}
	EnablePlatform_Linux2_6 "true" // User: Enables 2.6 support for Linux platform
	{
		&
		{
  			EnablePlatform_Linux2_6 ""
			GeneratorFamily "Xcode"
			|
			{
				 MalterlibBuildServerBuild "true"
				 HostPlatformFamily Linux
			}
		}
	}
