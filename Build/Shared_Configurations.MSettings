Property
{
	EnablePlatform_Windows define bool // User(Platform)=true: Enables Windows platform
	EnablePlatform_Windows true
	{
		&
		{
			EnablePlatform_Windows undefined
			GeneratorFamily "VisualStudio"
		}
	}
	EnablePlatform_Windows false
	{
		!!EnablePlatform_Windows undefined
	}

	EnablePlatform_Linux define bool // User(Platform)=true: Enables Linux platform
	EnablePlatform_Linux true
	{
		&
		{
  			EnablePlatform_Linux undefined
			GeneratorFamily "Xcode"
			|
			{
				 MalterlibBuildServerBuild true
				 HostPlatformFamily "Linux"
			}
		}
	}
	EnablePlatform_Linux false // User(Platform)=true: Enables Linux platform
	{
		!!EnablePlatform_Linux undefined
	}

	EnablePlatform_macOS define bool // User(Platform)=true: Enables macOS platform
	EnablePlatform_macOS true
	{
		&
		{
			EnablePlatform_macOS undefined
			GeneratorFamily "Xcode"
			HostPlatformFamily "macOS"
		}
	}
	EnablePlatform_macOS false
	{
		!!EnablePlatform_macOS undefined
	}

	EnablePlatform_iOS8_1 define bool = false
	EnablePlatform_Emscripten define bool = false // User(Platform)=true: Enables emscripten support
	EnableArchitecture_x64 define bool = true // User(Platform)=false: Enables generation of x64 architecture
	EnableArchitecture_x86 define bool = true // User(Platform)=false: Enables generation of x86 architecture

	EnableArchitecture_ArmV7 define bool = true // User(Platform)=false: Enables generation of arm V7 architecture
	EnableArchitecture_ArmV7s define bool = true // User(Platform)=false: Enables generation of arm V7s architecture
	EnableArchitecture_arm64 define bool = true // User(Platform)=false: Enables generation of arm arm64 architecture
	EnableArchitecture_arm64e define bool = false // User(Platform)=true: Enables generation of arm arm64e architecture
	EnableArchitecture_Itanium define bool = false // User(Platform)=true: Enables generation of itanium architecture
	EnableArchitecture_ppc64 define bool = false // User(Platform)=true: Enables generation of ppc64 architecture
	EnableArchitecture_ppc32 define bool = false // User(Platform)=true: Enables generation of ppc32 architecture

	DisablePostCopy define bool = false // User(Build System)=true: Disables post copy
	DisableDiffCopy define bool = false // User(Build System)=true: Disables diff copy
	EnableTestConfigs define bool = false // User(Configs)=true: Enable test configs
	OnlyTestConfigs define bool = false // User(Configs)=true: Only test configs enabled
	EnableProfileConfigs define bool = false // User(Configs)=true: Enable 'Optimized' and 'Profile' configs
	EnableExtraDebuggingConfigs define bool = false // User(Configs)=true: Enable 'Debug Optimized', 'Fast Compile', 'Release Debug' configs
	EnableReleaseConfig define bool = true // User(Configs)=false: Enable 'Release' configuration
	EnableReleaseTestingConfig define bool = true // User(Configs)=false: Enable 'Release Testing' configuration
	EnableDebugInlinedConfig define bool? // User(Configs)=false: Enable 'Debug Inlined' configuration
	EnableDebugConfig define bool? // User(Configs)=false: Enable 'Debug' configuration
	EnableSafeThreadLocals define bool = false // User(Undocumented)=true: Enables use of safe thread locals so you can do tests against other versions of macOS
	EnablePlatformFamily_macOS define bool = false
	EnablePlatformFamily_macOS true
	{
		!!EnablePlatform_macOS true
	}
	EnablePlatformFamily_Linux define bool = false
	EnablePlatformFamily_Linux true
	{
		!!EnablePlatform_Linux true
	}
}

*Platform
{
	Windows "Win32 platform"
	{
		&
		{
			GeneratorFamily "VisualStudio"
			EnablePlatform_Windows true
		}

	}
	macOS "macOS plattform"
	{
		&
		{
			GeneratorFamily "Xcode"
			EnablePlatform_macOS true
		}
	}
	iOS "iOS platfgorm"
	{
		&
		{
			GeneratorFamily "Xcode"
			EnablePlatform_iOS8_1 true
		}
	}
	Linux "Linux platform"
	{
		&
		{
			GeneratorFamily "Xcode"
			EnablePlatform_Linux true
		}
	}
	Emscripten "Emscripten platform"
	{
		&
		{
			GeneratorFamily "Xcode"
			EnablePlatform_Emscripten true
		}
	}
}

*Architecture
{
	x86 "Intel x86" // Maps to Win32 Platform in Visual tudio
	{
		&
		{
			!Platform "macOS"
			!Platform "Emscripten"
			!PlatformFamily "iOS"
			EnableArchitecture_x86 true
		}
	}
	x64 "Intel x64" // Maps to x64 Platform in Visual tudio
	{
		&
		{
			!Platform "Emscripten"
			!PlatformFamily "iOS"
			EnableArchitecture_x64 true
		}
	}
	Itanium "Itanium" // Maps to Itanium Platform in Visual tudio
	{
		&
		{
			Platform "Windows"
			EnableArchitecture_Itanium true
		}
	}
	ArmV7 "Arm V7" // Maps to Itanium Platform in Visual tudio
	{
		&
		{
			PlatformFamily "iOS"
			EnableArchitecture_ArmV7 true
		}
	}
	ArmV7s "Arm V7s" // Maps to Itanium Platform in Visual tudio
	{
		&
		{
			PlatformFamily "iOS"
			EnableArchitecture_ArmV7s true
		}
	}
	arm64 "Arm 64"
	{
		&
		{
			|
			{
				PlatformFamily "iOS"
				PlatformFamily "macOS"
				PlatformFamily "Linux"
			}
			EnableArchitecture_arm64 true
		}
	}
	arm64e "Arm 64 Extended"
	{
		&
		{
			|
			{
				PlatformFamily "iOS"
				PlatformFamily "macOS"
			}
			EnableArchitecture_arm64e true
		}
	}
	ppc32 "Power PC"
	{
		&
		{
			EnableArchitecture_ppc32 true
			PlatformVersion 1050
		}
	}
	ppc64 "Power PC 64 bit"
	{
		&
		{
			EnableArchitecture_ppc64 true
			PlatformVersion 1050
		}
	}
	le32 "Generic 32 bit Little endian"
	{
		|
		{
			Platform "Emscripten"
		}
	}
}

*Configuration
{
	Debug "Maximum Debuggability"
	{
		!EnableDebugConfig false
	}
    Fast\ Compile "Minimize compiler time"
	{
		!!EnableExtraDebuggingConfigs true
	}
    Debug\ Inlined "High debuggability with compiler optimizations that does not hurt debuggability"
	{
		|
		{
			EnableDebugInlinedConfig true
			&
			{
				!EnableDebugInlinedConfig false
				!MalterlibBuildServerBuild true
				|
				{
					PlatformFamily "Windows"
					EnableExtraDebuggingConfigs true
				}
			}
		}
	}
    Debug\ Optimized "All debug code paths, but with optimizations"
	{
		|
		{
			EnableExtraDebuggingConfigs true
			MalterlibBuildServerTest true
		}
	}
    Optimized "Fully optimized using latest CPU instructions"
	{
		!!EnableProfileConfigs true
	}
    Profile "High performance, but good compile time"
	{
		!!EnableProfileConfigs true
	}
    Release\ Debug "Release code paths, but no compiler optimizations"
	{
		!!EnableExtraDebuggingConfigs true
	}
    Release\ Testing "Release code with optimizations, but with asserts and contracts enabled"
	{
		!!EnableReleaseTestingConfig true
	}
    Release "Release code paths with full compiler optizations, but not latest CPU instructions"
	{
		!!EnableReleaseConfig true
	}
}

Property
{
	Tests define string?
	MalterlibEnablePrefTestConfig define bool = true // User(Tests)=false: Enable sanitizers as separate configurations
}

*Tests
{
	\ "Empty"
	Tests "Force tests enabled"
	{
		&
		{
			|
			{
				Configuration "Profile"
				Configuration "Release"
				Configuration "Optimized"
				Configuration "Release Debug"
				Configuration "Release Testing"
			}
		}
	}
	Perf\ Tests "Force tests enabled but with minimum performance impact"
	{
		&
		{
			MalterlibEnablePrefTestConfig true
			|
			{
				Configuration "Profile"
				Configuration "Release"
				Configuration "Optimized"
			}
		}
	}
}

Workspace.Enabled false
{
	|
	{
		&
		{
			!EnableTestConfigs true
			|
			{
				Tests "Tests"
				Tests "Perf Tests"
			}
		}
		&
		{
			OnlyTestConfigs true
			|
			{
				Configuration "Release"
				Configuration "Profile"
				Configuration "Optimized"
				Configuration "Release Debug"
				Configuration "Release Testing"
			}
			Tests undefined
		}
	}
}

Property.Documentation define string?

*Documentation
{
	\ "Empty"
	Doxygen "Enable doxygen documentation generation"
	{
		&
		{
			!HostPlatformFamily "Windows"
			PlatformFamily HostPlatformFamily
			Configuration "Debug"
		}
	}
}

Property
{
	Sanitizer_Thread define string = ""
	Sanitizer_Address define string = ""
	Sanitizer_UndefinedBehavior define string = ""
	MalterlibEnableSanitizerReleaseConfigs define bool = false // User(Debug)=true: Enable sanitizers as separate configurations
}

*Sanitizer_Thread
{
	\ "Empty"
	TSan "Enable TSan sanitizer"
	{
		&
		{
			MalterlibEnableSanitizerReleaseConfigs true
			Configuration "Release"
			!Tests "Perf Tests"
			Sanitizer_Address undefined
			Sanitizer_UndefinedBehavior undefined
		}
	}
}

*Sanitizer_Address
{
	\ "Empty"
	ASan "Enable ASan sanitizer"
	{
		&
		{
			MalterlibEnableSanitizerReleaseConfigs true
			Configuration "Release"
			!Tests "Perf Tests"
			Sanitizer_Thread undefined
			Sanitizer_UndefinedBehavior undefined
		}
	}
}

*Sanitizer_UndefinedBehavior
{
	\ "Empty"
	UBSan "Enable UBSan sanitizer"
	{
		&
		{
			MalterlibEnableSanitizerReleaseConfigs true
			Configuration "Release"
			!Tests "Perf Tests"
			Sanitizer_Thread undefined
			Sanitizer_Address undefined
		}
	}
}

Property
{
	FullConfiguration =+ `@(Configuration->Replace(" ",""))@((Tests || "")->Replace(" ",""))@((Documentation || "")->Replace(" ",""))`

	FullConfiguration =+ Sanitizer_UndefinedBehavior
	{
		!Sanitizer_UndefinedBehavior undefined
	}

	FullConfiguration =+ Sanitizer_Address
	{
		!Sanitizer_Address undefined
	}

	FullConfiguration =+ Sanitizer_Thread
	{
		!Sanitizer_Thread undefined
	}
}
