Property
{
	DefaultOSXPlatform "10.13"
	{
		&
		{
			DefaultOSXPlatform ""
			MalterlibDefaultToolset true
			HostPlatformFamily OSX
		}
	}
	DefaultOSXPlatform "10.7"
