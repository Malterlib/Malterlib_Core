*Architecture
{
	x86 "Intel x86" // Maps to Win32 Platform in Visual tudio
	{
		&
		{
			!Platform OSX10.6 // OSX 10.6 is disabled for now
			!Platform OSX10.7 // OSX 10.7 and 10.8 does not require 32 bit Applications
			!Platform OSX10.8
			!Platform OSX10.9
			!Platform OSX10.10
			!Platform OSX10.11
			!Platform OSX10.12
			!Platform OSX10.13
			!Platform Emscripten
			!PlatformFamily iOS
			EnableArchitecture_x86 true
		}
	}
	x64 "Intel x64" // Maps to x64 Platform in Visual tudio
	{
		&
		{
			!Platform Emscripten
			!PlatformFamily iOS
			EnableArchitecture_x64 true
		}
	}
	Itanium "Itanium" // Maps to Itanium Platform in Visual tudio
	{
		&
		{
			Platform "Windows"
			EnableArchitecture_Itanium "true"
		}
	}
	ArmV7 "Arm V7" // Maps to Itanium Platform in Visual tudio
	{
		&
		{
			PlatformFamily iOS
			EnableArchitecture_ArmV7 "true"
		}
	}
	ArmV7s "Arm V7s" // Maps to Itanium Platform in Visual tudio
	{
		&
		{
			PlatformFamily iOS
			EnableArchitecture_ArmV7s "true"
		}
	}
	Arm64 "Arm 64" // Maps to Itanium Platform in Visual tudio
	{
		&
		{
			PlatformFamily iOS
			EnableArchitecture_Arm64 "true"
		}
	}
	ppc32 "Power PC"
	{
		&
		{
			Platform OSX10.5
			EnableArchitecture_ppc32 "true"
		}
	}
	ppc64 "Power PC 64 bit"
	{
		&
		{
			Platform OSX10.5
			EnableArchitecture_ppc64 "true"
		}
	}
	le32 "Generic 32 bit Little endian"
	{
		|
		{
			Platform Emscripten
		}
	}
}

*Configuration
{
	Debug "Maximum Debuggability"
    "Fast Compile" "Minimize compiler time"
	{
		!!EnableExtraDebuggingConfigs true
	}
    "Debug Inlined" "High debuggability with compiler optimizations that does not hurt debuggability"
	{
		&
		{
			!MalterlibBuildServerBuild "true"
			|
			{
				PlatformFamily Windows
				EnableExtraDebuggingConfigs true
			}
		}
	}
    "Debug Optimized" "All debug code paths, but with optimizations"
	{
		|
		{
			EnableExtraDebuggingConfigs true
			MalterlibBuildServerTest true
		}
	}
    Optimized "Fully optimized using latest CPU instructions"
	{
		!!EnableProfileConfigs true
	}
    Profile "High performance, but good compile time"
	{
		!!EnableProfileConfigs true
	}
    "Release Debug" "Release code paths, but no compiler optimizations"
	{
		!!EnableExtraDebuggingConfigs true
	}
    "Release Testing" "Release code with optimizations, but with asserts and contracts enabled"
    Release "Release code paths with full compiler optizations, but not latest CPU instructions"
	{
		!!EnableReleaseConfig true
	}
}

*Tests
{
	"" "Empty"
	"Tests" "Force tests enabled"
	{
		&
		{
			|
			{
				Configuration "Profile"
				Configuration "Release"
				Configuration "Optimized"
				Configuration "Release Debug"
				Configuration "Release Testing"
			}
		}
	}
	"Perf Tests" "Force tests enabled but with minimum performance impact"
	{
		&
		{
			|
			{
				Configuration "Profile"
				Configuration "Release"
				Configuration "Optimized"
			}
		}
	}
}

Workspace.Enabled false
{
	|
	{
		&
		{
			!EnableTestConfigs true
			|
			{
				Tests "Tests"
				Tests "Perf Tests"
			}
		}
		&
		{
			OnlyTestConfigs true
			|
			{
				Configuration Release
				Configuration Profile
				Configuration Optimized
				Configuration "Release Debug"
				Configuration "Release Testing"
			}
			Tests ""
		}
	}
}

*Documentation
{
	"" "Empty"
	"Doxygen" "Enable doxygen documentation generation"
	{
		&
		{
			!HostPlatformFamily Windows
			Platform "@(HostPlatform)"
			Configuration "Debug"
		}
	}
}
