Property
{
	SinglePlatform: string? // User(-  Single Config)="macOS": Enable only a single Platform
	SingleArchitecture: string? // User(-  Single Config)="arm64": Enable only a single Architecture
	SingleConfiguration: string? // User(-  Single Config)="Debug": Enable only a single Configuration

	EnablePlatform_Windows: bool // User(- Platform)=true: Enables Windows platform
	EnablePlatform_Windows ((SinglePlatform <!=> undefined) ? SinglePlatform == "Windows" : true)
	{
		&
		{
			EnablePlatform_Windows undefined
			GeneratorFamily "VisualStudio"
		}
	}
	EnablePlatform_Windows ((SinglePlatform <!=> undefined) ? SinglePlatform == "Windows" : false)
	{
		!!EnablePlatform_Windows undefined
	}

	EnablePlatform_Linux: bool // User(- Platform)=true: Enables Linux platform
	EnablePlatform_Linux ((SinglePlatform <!=> undefined) ? SinglePlatform == "Linux" : true)
	{
		&
		{
			EnablePlatform_Linux undefined
			GeneratorFamily "Xcode"
			|
			{
				 MalterlibBuildServerBuild true
				 HostPlatformFamily "Linux"
			}
		}
	}
	EnablePlatform_Linux ((SinglePlatform <!=> undefined) ? SinglePlatform == "Linux" : false)
	{
		!!EnablePlatform_Linux undefined
	}

	EnablePlatform_macOS: bool // User(- Platform)=true: Enables macOS platform
	EnablePlatform_macOS ((SinglePlatform <!=> undefined) ? SinglePlatform == "macOS" : true)
	{
		&
		{
			EnablePlatform_macOS undefined
			GeneratorFamily "Xcode"
			HostPlatformFamily "macOS"
		}
	}
	EnablePlatform_macOS ((SinglePlatform <!=> undefined) ? SinglePlatform == "macOS" : false)
	{
		!!EnablePlatform_macOS undefined
	}

	EnablePlatform_iOS: bool = ((SinglePlatform <!=> undefined) ? SinglePlatform == "iOS" : false)
	EnablePlatform_Emscripten: bool = ((SinglePlatform <!=> undefined) ? SinglePlatform == "Emscripten" : false) // User(- Platform)=true: Enables emscripten support

	// Supported
	EnableArchitecture_x64: bool = ((SingleArchitecture <!=> undefined) ? SingleArchitecture == "x64" : true) // User(- Platform)=false: Enables generation of x64 architecture
	EnableArchitecture_x86: bool = ((SingleArchitecture <!=> undefined) ? SingleArchitecture == "x86" : true) // User(- Platform)=false: Enables generation of x86 architecture
	EnableArchitecture_arm64: bool = ((SingleArchitecture <!=> undefined) ? SingleArchitecture == "arm64" : true) // User(- Platform)=false: Enables generation of arm arm64 architecture

	// Unsupported
	EnableArchitecture_ArmV7: bool = ((SingleArchitecture <!=> undefined) ? SingleArchitecture == "ArmV7" : false) // User(- Platform)=false: Enables generation of arm V7 architecture
	EnableArchitecture_ArmV7s: bool = ((SingleArchitecture <!=> undefined) ? SingleArchitecture == "ArmV7s" : false) // User(- Platform)=false: Enables generation of arm V7s architecture
	EnableArchitecture_arm64e: bool = ((SingleArchitecture <!=> undefined) ? SingleArchitecture == "arm64e" : false) // User(- Platform)=true: Enables generation of arm arm64e architecture
	EnableArchitecture_Itanium: bool = ((SingleArchitecture <!=> undefined) ? SingleArchitecture == "Itanium" : false) // User(- Platform)=true: Enables generation of itanium architecture
	EnableArchitecture_ppc64: bool = ((SingleArchitecture <!=> undefined) ? SingleArchitecture == "ppc64" : false) // User(- Platform)=true: Enables generation of ppc64 architecture
	EnableArchitecture_ppc32: bool = ((SingleArchitecture <!=> undefined) ? SingleArchitecture == "ppc32" : false ) // User(- Platform)=true: Enables generation of ppc32 architecture

	DisablePostCopy: bool = false // User(Build System)=true: Disables post copy
	DisableDiffCopy: bool = false // User(Build System)=true: Disables diff copy

	EnableTestConfigs: bool = false // User(- Configs)=true: Enable test configs
	EnableDocumentationConfigs: bool = false // User(- Configs)=true: Enable documenattion configs
	OnlyTestConfigs: bool = false // User(- Configs)=true: Only test configs enabled
	EnableProfileConfigs: bool = false // User(- Configs)=true: Enable 'Optimized' and 'Profile' configs
	EnableExtraDebuggingConfigs: bool = false // User(- Configs)=true: Enable 'Debug Optimized', 'Fast Compile', 'Release Debug' configs

	EnableReleaseConfig: bool = ((SingleConfiguration <!=> undefined) ? SingleConfiguration == "Release" : true) // User(- Configs)=false: Enable 'Release' configuration
	EnableReleaseTestingConfig: bool = ((SingleConfiguration <!=> undefined) ? SingleConfiguration == "Release Testing" : true) // User(- Configs)=false: Enable 'Release Testing' configuration
	EnableDebugInlinedConfig: bool = ((SingleConfiguration <!=> undefined) ? SingleConfiguration == "Debug Inlined" : false) // User(- Configs)=false: Enable 'Debug Inlined' configuration
	EnableDebugInlinedConfig ((SingleConfiguration <!=> undefined) ? SingleConfiguration == "Debug Inlined" : true)
	{
		&
		{
			EnableDebugInlinedConfig undefined
			!MalterlibBuildServerBuild true
			|
			{
				PlatformFamily "Windows"
				EnableExtraDebuggingConfigs true
			}
		}
	}

	EnableDebugConfig: bool = ((SingleConfiguration <!=> undefined) ? SingleConfiguration == "Debug" : true) // User(- Configs)=false: Enable 'Debug' configuration

	EnableSafeThreadLocals: bool = false // User(Undocumented)=true: Enables use of safe thread locals so you can do tests against other versions of macOS
	EnablePlatformFamily_macOS: bool = false
	EnablePlatformFamily_macOS true
	{
		!!EnablePlatform_macOS true
	}
	EnablePlatformFamily_Linux: bool = false
	EnablePlatformFamily_Linux true
	{
		!!EnablePlatform_Linux true
	}
	EnablePlatformFamily_Windows: bool = false
	EnablePlatformFamily_Windows true
	{
		!!EnablePlatform_Windows true
	}
}

*Platform
{
	Windows "Win32 platform"
	{
		&
		{
			GeneratorFamily "VisualStudio"
			EnablePlatform_Windows true
		}

	}
	macOS "macOS plattform"
	{
		&
		{
			GeneratorFamily "Xcode"
			EnablePlatform_macOS true
		}
	}
	iOS "iOS platfgorm"
	{
		&
		{
			GeneratorFamily "Xcode"
			EnablePlatform_iOS true
		}
	}
	Linux "Linux platform"
	{
		&
		{
			GeneratorFamily "Xcode"
			EnablePlatform_Linux true
		}
	}
	Emscripten "Emscripten platform"
	{
		&
		{
			GeneratorFamily "Xcode"
			EnablePlatform_Emscripten true
		}
	}
}

*Architecture
{
	x86 "Intel x86" // Maps to Win32 Platform in Visual tudio
	{
		&
		{
			!Platform "macOS"
			!Platform "Emscripten"
			!PlatformFamily "iOS"
			EnableArchitecture_x86 true
		}
	}
	x64 "Intel x64" // Maps to x64 Platform in Visual tudio
	{
		&
		{
			!Platform "Emscripten"
			!PlatformFamily "iOS"
			EnableArchitecture_x64 true
		}
	}
	Itanium "Itanium" // Maps to Itanium Platform in Visual tudio
	{
		&
		{
			Platform "Windows"
			EnableArchitecture_Itanium true
		}
	}
	ArmV7 "Arm V7" // Maps to Itanium Platform in Visual tudio
	{
		&
		{
			PlatformFamily "iOS"
			EnableArchitecture_ArmV7 true
		}
	}
	ArmV7s "Arm V7s" // Maps to Itanium Platform in Visual tudio
	{
		&
		{
			PlatformFamily "iOS"
			EnableArchitecture_ArmV7s true
		}
	}
	arm64 "Arm 64"
	{
		&
		{
			|
			{
				PlatformFamily "iOS"
				PlatformFamily "macOS"
				PlatformFamily "Linux"
				PlatformFamily "Windows"
			}
			EnableArchitecture_arm64 true
		}
	}
	arm64e "Arm 64 Extended"
	{
		&
		{
			|
			{
				PlatformFamily "iOS"
				PlatformFamily "macOS"
			}
			EnableArchitecture_arm64e true
		}
	}
	ppc32 "Power PC"
	{
		&
		{
			EnableArchitecture_ppc32 true
			PlatformVersion 1050
		}
	}
	ppc64 "Power PC 64 bit"
	{
		&
		{
			EnableArchitecture_ppc64 true
			PlatformVersion 1050
		}
	}
	le32 "Generic 32 bit Little endian"
	{
		|
		{
			Platform "Emscripten"
		}
	}
}

*Configuration
{
	Debug "Maximum Debuggability"
	{
		!!EnableDebugConfig true
	}
    Fast\ Compile "Minimize compiler time"
	{
		|
		{
			EnableExtraDebuggingConfigs true
			SingleConfiguration "Fast Compile"
		}
	}
    Debug\ Inlined "High debuggability with compiler optimizations that does not hurt debuggability"
	{
		!!EnableDebugInlinedConfig true
	}
    Debug\ Optimized "All debug code paths, but with optimizations"
	{
		|
		{
			EnableExtraDebuggingConfigs true
			SingleConfiguration "Debug Optimized"
		}
	}
    Optimized "Fully optimized using latest CPU instructions"
	{
		|
		{
			EnableProfileConfigs true
			SingleConfiguration "Optimized"
		}
	}
    Profile "High performance, but good compile time"
	{
		|
		{
			EnableProfileConfigs true
			SingleConfiguration "Profile"
		}
	}
    Release\ Debug "Release code paths, but no compiler optimizations"
	{
		|
		{
			EnableExtraDebuggingConfigs true
			SingleConfiguration "Release Debug"
		}
	}
    Release\ Testing "Release code with optimizations, but with asserts and contracts enabled"
	{
		!!EnableReleaseTestingConfig true
	}
    Release "Release code paths with full compiler optizations, but not latest CPU instructions"
	{
		!!EnableReleaseConfig true
	}
}

Property
{
	Tests: string?
	MalterlibEnablePerfTestConfig: bool = true // User(Tests)=false: Enable Perf Tests config
	MalterlibEnableTestsConfig: bool = true // User(Tests)=false: Enable Tests config
}

*Tests
{
	\ "Empty"
	Tests "Force tests enabled"
	{
		&
		{
			MalterlibEnableTestsConfig true
			|
			{
				Configuration "Profile"
				Configuration "Release"
				Configuration "Optimized"
				Configuration "Release Debug"
				Configuration "Release Testing"
			}
		}
	}
	Perf\ Tests "Force tests enabled but with minimum performance impact"
	{
		&
		{
			MalterlibEnablePerfTestConfig true
			|
			{
				Configuration "Profile"
				Configuration "Release"
				Configuration "Optimized"
			}
		}
	}
}

Workspace.Enabled false
{
	|
	{
		&
		{
			!EnableTestConfigs true
			|
			{
				Tests "Tests"
				Tests "Perf Tests"
			}
		}
		&
		{
			OnlyTestConfigs true
			|
			{
				Configuration "Release"
				Configuration "Profile"
				Configuration "Optimized"
				Configuration "Release Debug"
				Configuration "Release Testing"
			}
			Tests undefined
		}
	}
}

Property.Documentation: string?

*Documentation
{
	\ "Empty"
	Doxygen "Enable doxygen documentation generation"
	{
		&
		{
			EnableDocumentationConfigs true
			!HostPlatformFamily "Windows"
			PlatformFamily HostPlatformFamily
			Configuration "Debug"
		}
	}
}

Property
{
	Sanitizer_Thread: string = ""
	Sanitizer_Address: string = ""
	Sanitizer_UndefinedBehavior: string = ""
	MalterlibEnableSanitizerReleaseConfigs: bool = false // User(Debug)=true: Enable sanitizers as separate configurations
}

*Sanitizer_Thread
{
	\ "Empty"
	TSan "Enable TSan sanitizer"
	{
		&
		{
			MalterlibEnableSanitizerReleaseConfigs true
			Configuration "Release"
			!Tests "Perf Tests"
			Sanitizer_Address undefined
			Sanitizer_UndefinedBehavior undefined
			!PlatformFamily "Windows"
		}
	}
}

*Sanitizer_Address
{
	\ "Empty"
	ASan "Enable ASan sanitizer"
	{
		&
		{
			MalterlibEnableSanitizerReleaseConfigs true
			Configuration "Release"
			!Tests "Perf Tests"
			Sanitizer_Thread undefined
			Sanitizer_UndefinedBehavior undefined
		}
	}
}

*Sanitizer_UndefinedBehavior
{
	\ "Empty"
	UBSan "Enable UBSan sanitizer"
	{
		&
		{
			MalterlibEnableSanitizerReleaseConfigs true
			Configuration "Release"
			!Tests "Perf Tests"
			Sanitizer_Thread undefined
			Sanitizer_Address undefined
			!PlatformFamily "Windows"
		}
	}
}

Property
{
	ClangForWindows_Enabled: string = ""
	MalterlibUseClangForWindowsConfigs: bool = false // User(Debug)=true: Enable clang-cl as separate configuration
}

*ClangForWindows_Enabled
{
	\ "Empty"
	Clang "Enable clang-cl"
	{
		&
		{
			PlatformFamily "Windows"
			MalterlibUseClangForWindowsConfigs true
			!Tests "Perf Tests"
			Sanitizer_Thread undefined
			Sanitizer_Address undefined
			Sanitizer_UndefinedBehavior undefined
		}
	}
}

Property
{
	FullConfiguration =+ `@(Configuration->Replace(" ",""))@((Tests || "")->Replace(" ",""))@((Documentation || "")->Replace(" ",""))`

	FullConfiguration =+ Sanitizer_UndefinedBehavior
	{
		!Sanitizer_UndefinedBehavior undefined
	}

	FullConfiguration =+ Sanitizer_Address
	{
		!Sanitizer_Address undefined
	}

	FullConfiguration =+ Sanitizer_Thread
	{
		!Sanitizer_Thread undefined
	}

	FullConfiguration =+ ClangForWindows_Enabled
	{
		!ClangForWindows_Enabled undefined
	}
}
