Property
{
	DefaultOSXPlatform define string
	DefaultOSXPlatform "10.15"
	{
		&
		{
			DefaultOSXPlatform undefined
			MalterlibDefaultToolset true
			HostPlatformFamily "OSX"
		}
	}
	DefaultOSXPlatform "10.13"
	{
		&
		{
			DefaultOSXPlatform undefined
			!MalterlibUseStaticLibCxxABI true
			HostPlatformFamily "OSX"
		}
	}
	DefaultOSXPlatform "10.9"
	{
		&
		{
			DefaultOSXPlatform undefined
			MalterlibXcodeNewBuildSystem true
			HostPlatformFamily "OSX"
		}
	}
	DefaultOSXPlatform "10.7"
	{
		&
		{
			DefaultOSXPlatform undefined
			HostPlatformFamily "OSX"
		}
	}

	EnablePlatform_Windows define bool // User(Platform)=true: Enables Windows platform
	EnablePlatform_Windows true
	{
		&
		{
			EnablePlatform_Windows undefined
			GeneratorFamily "VisualStudio"
		}
	}
	EnablePlatform_Windows false
	{
		!!EnablePlatform_Windows undefined
	}

	EnablePlatform_Linux2_6 define bool // User(Platform)=true: Enables 2.6 support for Linux platform
	EnablePlatform_Linux2_6 true
	{
		&
		{
  			EnablePlatform_Linux2_6 undefined
			GeneratorFamily "Xcode"
			|
			{
				 MalterlibBuildServerBuild true
				 HostPlatformFamily "Linux"
			}
		}
	}
	EnablePlatform_Linux2_6 false // User(Platform)=true: Enables 2.6 support for Linux platform
	{
		!!EnablePlatform_Linux2_6 undefined
	}

	EnablePlatform_OSX10_5 define bool // User(Platform)=true: Enables 10.5 support for OSX platform
	EnablePlatform_OSX10_5 true
	{
		&
		{
			EnablePlatform_OSX10_5 undefined
			GeneratorFamily "Xcode"
			DefaultOSXPlatform "10.5"
		}
	}
	EnablePlatform_OSX10_5 false
	{
		!!EnablePlatform_OSX10_5 undefined
	}

