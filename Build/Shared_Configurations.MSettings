	EnablePlatform_iOS8_1 define bool = false
	EnablePlatform_Emscripten define bool = false // User(Platform)=true: Enables emscripten support
	EnableArchitecture_x64 define bool = true // User(Platform)=false: Enables generation of x64 architecture
	EnableArchitecture_x86 define bool = true // User(Platform)=false: Enables generation of x86 architecture

	EnableArchitecture_ArmV7 define bool = true // User(Platform)=true: Enables generation of arm V7 architecture
	EnableArchitecture_ArmV7s define bool = true // User(Platform)=true: Enables generation of arm V7s architecture
	EnableArchitecture_arm64 define bool = true // User(Platform)=true: Enables generation of arm arm64 architecture
	EnableArchitecture_arm64e define bool = true // User(Platform)=true: Enables generation of arm arm64e architecture
	EnableArchitecture_Itanium define bool = false // User(Platform)=true: Enables generation of itanium architecture
	EnableArchitecture_ppc64 define bool = false // User(Platform)=true: Enables generation of ppc64 architecture
	EnableArchitecture_ppc32 define bool = false // User(Platform)=true: Enables generation of ppc32 architecture

	DisablePostCopy define bool = false // User(Build System)=true: Disables post copy
	DisableDiffCopy define bool = false // User(Build System)=true: Disables diff copy
	EnableTestConfigs define bool = false // User(Configs)=true: Enable test configs
	OnlyTestConfigs define bool = false // User(Configs)=true: Only test configs enabled
	EnableProfileConfigs define bool = false // User(Configs)=true: Enable 'Optimized' and 'Profile' configs
	EnableExtraDebuggingConfigs define bool = false // User(Configs)=true: Enable 'Debug Optimized', 'Fast Compile', 'Release Debug' configs
	EnableReleaseConfig define bool = true // User(Configs)=false: Enable 'Release' configuration
	EnableReleaseTestingConfig define bool = true // User(Configs)=false: Enable 'Release Testing' configuration
	EnableSafeThreadLocals define bool = false // User(Undocumented)=true: Enables use of safe thread locals so you can do tests against other versions of OSX
	EnablePlatformFamily_OSX define bool = false
	EnablePlatformFamily_OSX true
	{
		!!EnablePlatform_OSX10_5 true
		!!EnablePlatform_OSX10_6 true
		!!EnablePlatform_OSX10_7 true
		!!EnablePlatform_OSX10_8 true
		!!EnablePlatform_OSX10_9 true
		!!EnablePlatform_OSX10_10 true
		!!EnablePlatform_OSX10_11 true
		!!EnablePlatform_OSX10_12 true
		!!EnablePlatform_OSX10_13 true
		!!EnablePlatform_OSX10_14 true
		!!EnablePlatform_OSX10_15 true
		!!EnablePlatform_OSX11 true
	}
	EnablePlatformFamily_Linux define bool = false
	EnablePlatformFamily_Linux true
	{
		!!EnablePlatform_Linux2_6 true
	}
}

