// Malterlib
Property
{
    MalterlibTargetExtraSuffix ""
	{
		!!MalterlibTargetExtraSuffix ""
	}
    MalterlibTargetCustom ""
	{
		!!MalterlibTargetCustom ""
	}
    MalterlibDoExeFS "false"
	{
		!!MalterlibDoExeFS ""
	}
    MalterlibUsesTranslation "false"
	{
		!!MalterlibUsesTranslation ""
	}
    MalterlibDoTranslationExeFS "false"
	{
		!!MalterlibDoTranslationExeFS ""
	}
    MalterlibStronglyNamedAssembly ""
	{
		!!MalterlibStronglyNamedAssembly ""
	}
    MalterlibNotifyResult "false"
	{
		!!MalterlibNotifyResult ""
	}
    MalterlibExeFSPath "@(Target:this.IdentityPath->GetPath())/ExeFS/*"
	{
		!!MalterlibExeFSPath ""
	}
    MalterlibPostCopyProject ""
	{
		!!MalterlibPostCopyProject ""
	}
	MalterlibPostCopyHash false
	{
		!!MalterlibPostCopyHash ""
	}
    MalterlibPostCopyDestination ""
	{
		!!MalterlibPostCopyDestination ""
	}
    MalterlibPostCopyProject2 ""
	{
		!!MalterlibPostCopyProject2 ""
	}
	MalterlibPostCopyHash2 false
	{
		!!MalterlibPostCopyHash2 ""
	}
    MalterlibPostCopyDestination2 ""
	{
		!!MalterlibPostCopyDestination2 ""
	}
	MalterlibPostCopyDestination3 ""
	{
		!!MalterlibPostCopyDestination3 ""
	}
    MalterlibConsoleApp "false"
	{
		!!MalterlibConsoleApp ""
	}
    MalterlibQtSupport "false"
	{
		!!MalterlibQtSupport ""
	}
	MalterlibOutOfProcessSupport "false"
	{
		!!MalterlibOutOfProcessSupport ""
	}
    MalterlibRWPropertyPages "false"
	{
		!!MalterlibRWPropertyPages ""
	}
    MalterlibBuildSigning "true"
	{
		&
		{
			MalterlibBuildSigning ""
			MalterlibBuildServerBuild true
		}
	}
    MalterlibSigning "true"
	{
		&
		{
			MalterlibSigning ""
			MalterlibBuildServerBuild true
			!Configuration "Release Testing" // Only default to signing if building release builds (Release Testing will not be signed)
		}
	}

	MalterlibNoOSXCrossModuleExceptions "true" // User(Undocumented)=false: Disables catching of exception across modules on OSX. This will bring in libunwind statically (default true)
	{
		&
		{
			MalterlibNoOSXCrossModuleExceptions ""
			PlatformIsDarwin true
		}
	}

	MalterlibMaxSupportedWindowsVersion "10.0.18362.0" // User(Platform Version): Max supported Windows version.
	{
		!!MalterlibMaxSupportedWindowsVersion ""
	}

	MalterlibMaxSupportedOSXVersion "10.14"
	{
		&
		{
			MalterlibMaxSupportedOSXVersion ""
			Generator "Xcode10"
		}
	}

	MalterlibMaxSupportedOSXVersion "10.13" // User(Platform Version): Max supported OSX version. Set this to smaller version to compile time check that you aren't using disallowed functions without version checks
	{
		!!MalterlibMaxSupportedOSXVersion ""
	}

    MalterlibMaxSupportediOSVersion "8.1" // User(Platform Version): Max supported iOS version. Set this to smaller version to compile time check that you aren't using disallowed functions without version checks
	{
		!!MalterlibMaxSupportediOSVersion ""
	}

    MalterlibAllSchemes "" // User(Build System)=true: Enable to generate schemes for all targets, even targets without debug commands
	{
		!!MalterlibAllSchemes ""
	}

	MalterlibSharedDeployRoot "/Shared"
	{
		!!MalterlibSharedDeployRoot ""
	}
    MalterlibSigning "false"
	{
		!!MalterlibSigning ""
	}
    MalterlibBuildSigning "false"
	{
		!!MalterlibSigning ""
	}
	MalterlibSignIncludeCert "@(Builtin.BasePathAbsolute)/Settings/Certificates/MSCV-GlobalSign.cer" // User(Signing): Set this to 'none' to disable incude cert for development
	{
		!!MalterlibSignIncludeCert ""
	}
	MalterlibSignTimestampServer "http://timestamp.globalsign.com/scripts/timestamp.dll" // User(Signing): Timestamp server to use when signing windows executables
	{
		!!MalterlibSignTimestampServer ""
	}
	MalterlibSignTimestampServerRFC3161 "" // User(Signing): RFC 3161 Timestamp server to use when signing windows executables. This will override any setting in MalterlibSignTimestampServer
	{
		!!MalterlibSignTimestampServerRFC3161 ""
	}
	MalterlibSignCertWindows "Unknown Company" // User(Signing)="Name of cert": Set this to your local certificate for driver development
	{
		!!MalterlibSignCertWindows ""
	}
	MalterlibSignCertOSX "-" // User(Signing)=SHA1OfCert: Set this to your Developer ID cert for driver development
	{
		!!MalterlibSignCertOSX ""
	}

	MalterlibBreakpadUploadServer "https://error-reports.malterlib.com"
	{
		!!MalterlibBreakpadUploadServer ""
	}
	MalterlibBreakpadReportInterval "0"
	{
		!!MalterlibBreakpadReportInterval ""
	}
	MalterlibBreakpadRequestComments "true"
	{
		!!MalterlibBreakpadRequestComments ""
	}
	MalterlibBreakpadRequestEmail "true"
	{
		!!MalterlibBreakpadRequestEmail ""
	}
	MalterlibBreakpadPrivacyPolicyURL "http://www.malterlib.com"
	{
		!!MalterlibBreakpadPrivacyPolicyURL ""
	}

	MalterlibDriverSigning "true"
	{
		!!MalterlibDriverSigning ""
	}
    MalterlibDeploySymbols "true"
	{
		&
		{
			MalterlibDeploySymbols ""
			MalterlibBuildServerBuild true
			|
			{
				!PlatformIsDarwin true
				&
				{
					PlatformIsDarwin true
					!Configuration "Release Testing" // Only deploy in Release/Debug builds, not Release testing
				}
				MalterlibForceDeploySymbols 1
			}
		}
	}
    MalterlibDeploySymbols "false"
	{
		!!MalterlibDeploySymbols ""
	}
	MalterlibLocalizationRoot "@(Builtin.BasePathAbsolute)/Projects/Localization"
	{
		!!MalterlibLocalizationRoot ""
	}
	MalterlibBuildServerBuild "true"
	{
		!!BUILDSERVER "TRUE"
	}
	MalterlibBuildServerBuild "false"
	{
		!!MalterlibBuildServerBuild ""
	}

	MalterlibSupportSanitizers "false" // User(Debug): Enable to support sanitizer debugging such as ASAN on macOS. Implicitly turns on default toolchain, and system memory manager
	{
		!!MalterlibSupportSanitizers ""
	}

	MalterlibDefaultToolset "true"
	{
		&
		{
			MalterlibDefaultToolset ""
			MalterlibSupportSanitizers "true"
		}
	}

	MalterlibDefaultToolset "false" // User(Undocumented)=true: Use default Xcode toolset with no custom modifications to libc++ or clang
	{
		!!MalterlibDefaultToolset ""
	}

	MalterlibDefaultCompiler "false" // User(Undocumented)=true: Use default Xcode compiler
	{
		&
		{
			MalterlibDefaultCompiler ""
			PlatformFamily Linux
		}
	}

	MalterlibDefaultCompiler "true"
	{
		&
		{
			MalterlibDefaultCompiler ""
			MalterlibDefaultToolset true
		}
	}

	MalterlibDefaultCompiler "false"
	{
		!!MalterlibDefaultCompiler ""
	}

	MalterlibCustomCompilerOptions "true"
	{
		&
		{
			MalterlibCustomCompilerOptions ""
			PlatformFamily Linux
		}
	}

	MalterlibCustomCompilerOptions "false" // User(Undocumented)=true: Use custom compiler options only available in patched compiler
	{
		!!MalterlibCustomCompilerOptions ""
	}

	MalterlibDefaultXcode "true" // User(Undocumented)=false: Use default Xcode clang compiler specifications
	{
		!!MalterlibDefaultXcode ""
	}

	MalterlibUseStaticLibCxxABI true
	{
		&
		{
			MalterlibUseStaticLibCxxABI ""
			!MalterlibDefaultToolset true
			|
			{
				PlatformFamily "Emscripten"
				PlatformIsDarwin true
				PlatformFamily "Linux"
			}
		}
	}
	MalterlibUseStaticLibCxxABI false // User(Toolset)=false: Enables static libc++abi
	{
		!!MalterlibUseStaticLibCxxABI ""
	}

	MalterlibUseStaticLibUnwind true
	{
		&
		{
			MalterlibUseStaticLibUnwind ""
			|
			{
				PlatformFamily "Linux"
				PlatformFamily "Emscripten"
				PlatformIsDarwin true
			}
		}
	}

	MalterlibUseStaticLibUnwind false
	{
		!!MalterlibUseStaticLibUnwind ""
	}

	MalterlibUseStaticLibCxx true
	{
		&
		{
			MalterlibUseStaticLibCxx ""
			!MalterlibDefaultToolset true
			|
			{
				PlatformFamily "Emscripten"
				PlatformIsDarwin true
				PlatformFamily "Linux"
			}
		}
	}

	MalterlibUseStaticLibCxx false // User(Toolset)=false: Enables static libc++
	{
		!!MalterlibUseStaticLibCxx ""
	}

	MalterlibMemoryManager "System"
	{
		&
		{
			MalterlibMemoryManager ""
			MalterlibSupportSanitizers true
		}
	}

	MalterlibMemoryManager "Malterlib" // User(Memory Manager)=OverwriteCheck: Choose the memory manager. Options: Malterlib, System, OverwriteCheck, MiMalloc, TcMalloc (default Malterlib)
	{
		!!MalterlibMemoryManager ""
	}

	MalterlibMemoryManager_AlwaysRelease "true" // User(Memory Manager)=false: Enable memory manager to always be compile as if release config (default true)
	{
		&
		{
			MalterlibMemoryManager_AlwaysRelease ""
			!DocumentationEnabled true
		}
	}

	MalterlibMemoryManager_Debug "" // User(Memory Manager)=true: Enable Enable debug memory manager that reports leaks and checks for overwrites. Toggling will recompile everything. (default true in debug configs, false otherwise)
	{
		!!MalterlibMemoryManager_Debug ""
	}

	MalterlibMemoryManager_Debug_Features "" // User(Memory Manager)=false: Global toggle for debug memory manager. Can be toggled without recompiling everything.
	{
		!!MalterlibMemoryManager_Debug_Features ""
	}

	MalterlibMemoryManager_Debug_EnableFreeValidation false // User(Memory Manager)=true: Enable validation of freed blocks. Detects double frees and invalid frees. High impact on performance. (default false)
	{
		!!MalterlibMemoryManager_Debug_EnableFreeValidation ""
	}

	MalterlibMemoryManager_Debug_EnableMemoryLeaks false // User(Memory Manager)=true: Enables listing of memory leaks. High impact on performance. (default false)
	{
		!!MalterlibMemoryManager_Debug_EnableMemoryLeaks ""
	}

	MalterlibMemoryManager_Debug_EnableStackTrace false // User(Memory Manager)=true: Enable stack trace in debug heap (default false)
	{
		!!MalterlibMemoryManager_Debug_EnableStackTrace ""
	}

	MalterlibMemoryManager_Debug_EnableFreedGuards true // User(Memory Manager)=false: Enable checks for overwritten freed memory in debug heap (0xDD pattern) (default true)
	{
		!!MalterlibMemoryManager_Debug_EnableFreedGuards ""
	}

	MalterlibMemoryManager_Debug_EnableAllocatedFill true // User(Memory Manager)=false: Enable filling of allocated bytes in debug heap (0xCD pattern) (default true)
	{
		!!MalterlibMemoryManager_Debug_EnableAllocatedFill ""
	}

	MalterlibMemoryManager_Debug_EnableEdgeGuards true // User(Memory Manager)=false: Enable checks for overwritten memory before and after allocated blocks (0xFD pattern) (default true). If disabled, also disables stack traces, leak checks
	{
		!!MalterlibMemoryManager_Debug_EnableEdgeGuards ""
	}

	MalterlibMemoryManager_OverrideSystemMalloc true
	{
		&
		{
			MalterlibMemoryManager_OverrideSystemMalloc ""
			|
			{
				PlatformFamily OSX
				PlatformFamily Linux
				PlatformFamily Windows
			}
		}
	}

	MalterlibMemoryManager_OverrideSystemMalloc false // User(Memory Manager)=true: Override the default malloc
	{
		!!MalterlibMemoryManager_OverrideSystemMalloc ""
	}



	MalterlibBuildSpecifics ""

	MalterlibWindowsNtVersion "_WIN32_WINNT_VISTA"
	{
		!!PlatformFamily "Windows"
	}
	MalterlibWindowsVersion "NTDDI_VISTA"
	{
		!!PlatformFamily "Windows"
	}
	MalterlibDisableBuildSystemGeneration "true"
	{
		&
		{
			MalterlibDisableBuildSystemGeneration ""
			MalterlibBuildServerBuild "true"
		}
	}
	MalterlibEnableBreakpadUploader "false"
	{
		!!MalterlibEnableBreakpad ""
	}
	MalterlibClangVersion "9.0"
	{
		!!MalterlibClangVersion ""
	}
	MalterlibCustomToolchainClangVersion "8.0"
	{
		!!MalterlibCustomToolchainClangVersion ""
	}
	/*
	// TODO: Enable when supported
	MalterlibEnableBreakpad "true"
	{
		&
		{
			PlatformFamily "OSX"
			Target:Target.Type "UIExecutable"
		}
	}
	*/
	MalterlibThread_LinuxUseStaticThreadLocal false // User(Undocumented)=true: Use static thread locals on Linux. WARNING: This only works for executables, or load time dynamic libraries. Dynamic libraries loaded with dlopen() will not work, unless Malterlib_AssumeMalterlibHost is also specified.
	{
		!!MalterlibThread_LinuxUseStaticThreadLocal ""
	}
	MalterlibThread_LinuxAssumeGlibc true // User(Undocumented)=false: Executable will only work on glibc system. Speeds up thread self access.
	{
		!!MalterlibThread_LinuxAssumeGlibc ""
	}
	Malterlib_AssumeMalterlibHost false // User(Undocumented)=true: Dynamic libraries will only work when loaded from a process that uses Malterlib. Speeds up thread local access.
	{
		!!Malterlib_AssumeMalterlibHost ""
	}
	Malterlib_LinuxInitInPreInitArray "false" // User: Init before other shared libraries has been initialized. This can cause problems in some GLIBC versions
	{
		!!Malterlib_LinuxInitInPreInitArray ""
	}
	Malterlib_LinuxLinker lld // User(Toolset)=gold: Which linker to use on linux. Defaults to lld
	{
		!!Malterlib_LinuxLinker ""
	}
}

// Product version
Property
{
    ProductVersionExtra "D"
	{
		&
		{
			ProductVersionExtra ""
			!MalterlibBuildServerBuild true
		}
	}
    ProductVersionMajor "1"
	{
		!!ProductVersionMajor ""
	}
    ProductVersionMinor "0"
	{
		!!ProductVersionMinor ""
	}
    ProductVersionRevision "001"
	{
		!!ProductVersionRevision ""
	}
    ProductName "Unnamed Product"
	{
		!!ProductName ""
	}
    ProductCompanyUniqueIdentifier "com.example"
	{
		!!ProductCompanyUniqueIdentifier ""
	}
    ProductCompany "Unknown company"
	{
		!!ProductCompany ""
	}
    ProductCountry "XX"
	{
		!!ProductCountry ""
	}
    ProductLocality "Unknown"
	{
		!!ProductLocality ""
	}
    ProductOrganizationalUnit "Unknown"
	{
		!!ProductOrganizationalUnit ""
	}
    ProductContact "Malterlib <support@malterlib.com>"
	{
		!!ProductContact ""
	}
    ProductCopyright "Copyright © @(Builtin.Function->DateTime('{YYYY}')) @(ProductCompany). All rights reserved."
	{
		!!ProductCopyright ""
	}
	ProductDescription "@(ProductName)"
	{
		!!ProductDecription ""
	}
    ProductFileName "@(Workspace:Workspace.Name)"
	{
		!!ProductFileName ""
	}
	ProductVersionHex "000@(ProductVersionMajor)@(ProductVersionMinor)@(ProductVersionRevision)"
	{
		!!ProductVersionHex ""
	}
}
