// Malterlib
Property
{
    MalterlibTargetExtraSuffix ""
	{
		!!MalterlibTargetExtraSuffix ""
	}
    MalterlibTargetCustom ""
	{
		!!MalterlibTargetCustom ""
	}
    MalterlibDoExeFS "false"
	{
		!!MalterlibDoExeFS ""
	}
    MalterlibUsesTranslation "false"
	{
		!!MalterlibUsesTranslation ""
	}
    MalterlibDoTranslationExeFS "false"
	{
		!!MalterlibDoTranslationExeFS ""
	}
    MalterlibStronglyNamedAssembly ""
	{
		!!MalterlibStronglyNamedAssembly ""
	}
    MalterlibNotifyResult "false"
	{
		!!MalterlibNotifyResult ""
	}
    MalterlibExeFSPath "@(Target:this.IdentityPath->GetPath())/ExeFS/*"
	{
		!!MalterlibExeFSPath ""
	}
    MalterlibPostCopyProject ""
	{
		!!MalterlibPostCopyProject ""
	}
	MalterlibPostCopyHash false
	{
		!!MalterlibPostCopyHash ""
	}
    MalterlibPostCopyDestination ""
	{
		!!MalterlibPostCopyDestination ""
	}
    MalterlibPostCopyProject2 ""
	{
		!!MalterlibPostCopyProject2 ""
	}
	MalterlibPostCopyHash2 false
	{
		!!MalterlibPostCopyHash2 ""
	}
    MalterlibPostCopyDestination2 ""
	{
		!!MalterlibPostCopyDestination2 ""
	}
	MalterlibPostCopyDestination3 ""
	{
		!!MalterlibPostCopyDestination3 ""
	}
    MalterlibConsoleApp "false"
	{
		!!MalterlibConsoleApp ""
	}
    MalterlibQtSupport "false"
	{
		!!MalterlibQtSupport ""
	}
	MalterlibOutOfProcessSupport "false"
	{
		!!MalterlibOutOfProcessSupport ""
	}
    MalterlibRWPropertyPages "false"
	{
		!!MalterlibRWPropertyPages ""
	}
    MalterlibBuildSigning "true"
	{
		&
		{
			MalterlibBuildSigning ""
			MalterlibBuildServerBuild true
		}
	}
    MalterlibSigning "true"
	{
		&
		{
			MalterlibSigning ""
			MalterlibBuildServerBuild true
			!Configuration "Release Testing" // Only default to signing if building release builds (Release Testing will not be signed)
		}
	}

	MalterlibNoOSXCrossModuleExceptions "true" // User: Disables catching of exception across modules on OSX. This will bring in libunwind statically (default true)
	{
		&
		{
			MalterlibNoOSXCrossModuleExceptions ""
			PlatformIsDarwin true
		}
	}

	MalterlibMaxSupportedWindowsVersion "10.0.14393.0"
	{
		&
		{
			MalterlibMaxSupportedWindowsVersion ""
			Generator "VisualStudio2017"
		}
	}
	
	MalterlibMaxSupportedWindowsVersion "10.0.10586.0" // User: Max supported Windows version.
	{
		!!MalterlibMaxSupportedWindowsVersion ""
	}

	MalterlibMaxSupportedOSXVersion "10.12" // User: Max supported OSX version. Set this to smaller version to compile time check that you aren't using disallowed functions without version checks
	{
		!!MalterlibMaxSupportedOSXVersion ""
	}
	
    MalterlibMaxSupportediOSVersion "8.1" // User: Max supported iOS version. Set this to smaller version to compile time check that you aren't using disallowed functions without version checks
	{
		!!MalterlibMaxSupportediOSVersion ""
	}
	
    MalterlibAllSchemes "" // User: Enable to generate schemes for all targets, even targets without debug commands
	{
		!!MalterlibAllSchemes ""
	}
	
    MalterlibSigning "false"
	{
		!!MalterlibSigning ""
	}
    MalterlibBuildSigning "false"
	{
		!!MalterlibSigning ""
	}
	MalterlibSignIncludeCert "@(Builtin.BasePath)/Settings/Certificates/MSCV-GlobalSign.cer" // User: Set this to 'none' to disable incude cert for development
	{
		!!MalterlibSignIncludeCert ""
	}
	MalterlibSignCertWindows "Hansoft AB" // User: Set this to your local certificate for driver development
	{
		!!MalterlibSignCertWindows ""
	}
	MalterlibSignCertOSX "3f44c9ec9e8cf380146e7ecf696d8fe2651fc22f" // User: Set this to your Developer ID cert for driver development
	{
		!!MalterlibSignCertOSX ""
	}    
	
	MalterlibBreakpadUploadServer "https://error-reports.malterlib.com"
	{
		!!MalterlibBreakpadUploadServer ""
	}
	MalterlibBreakpadReportInterval "0"
	{
		!!MalterlibBreakpadReportInterval ""
	}
	MalterlibBreakpadRequestComments "true"
	{
		!!MalterlibBreakpadRequestComments ""
	}
	MalterlibBreakpadRequestEmail "true"
	{
		!!MalterlibBreakpadRequestEmail ""
	}
	MalterlibBreakpadPrivacyPolicyURL "http://www.malterlib.com"
	{
		!!MalterlibBreakpadPrivacyPolicyURL ""
	}

	MalterlibDriverSigning "true"
	{
		!!MalterlibDriverSigning ""
	}
    MalterlibDeploySymbols "true"
	{
		&
		{
			MalterlibDeploySymbols ""
			MalterlibBuildServerBuild true
			|
			{
				!PlatformIsDarwin true
				&
				{
					PlatformIsDarwin true
					!Configuration "Release Testing" // Only deploy in Release/Debug builds, not Release testing
				}
				MalterlibForceDeploySymbols 1
			}
		}
	}
    MalterlibDeploySymbols "false"
	{
		!!MalterlibDeploySymbols ""
	}
	MalterlibLocalizationRoot "@(Builtin.BasePath)/Projects/Localization"
	{
		!!MalterlibLocalizationRoot ""
	}
	MalterlibBuildServerBuild "true"
	{
		!!BUILDSERVER "TRUE"
	}
	MalterlibBuildServerBuild "false"
	{
		!!MalterlibBuildServerBuild ""
	}
	
	MalterlibDefaultToolset "false" // User: Use default Xcode toolset with no custom modifications to libc++ or clang
	{
		!!MalterlibDefaultToolset ""
	}
	
	MalterlibUseStaticLibCxxABI true
	{
		&
		{
			MalterlibUseStaticLibCxxABI ""
			!MalterlibDefaultToolset true
			|
			{
				PlatformFamily "Emscripten"
				PlatformIsDarwin true
				PlatformFamily "Linux"
			}
		}
	}
	MalterlibUseStaticLibCxxABI false // User: Enables static libc++abi
	{
		!!MalterlibUseStaticLibCxxABI ""
	}

	MalterlibUseStaticLibUnwind true
	{
		&
		{
			MalterlibUseStaticLibUnwind ""
			|
			{
				PlatformFamily "Emscripten"
				PlatformIsDarwin true
			}
		}
	}

	MalterlibUseStaticLibUnwind false
	{
		!!MalterlibUseStaticLibUnwind ""
	}
	
	MalterlibUseStaticLibCxx true
	{
		&
		{
			MalterlibUseStaticLibCxx ""
			!MalterlibDefaultToolset true
			|
			{
				PlatformFamily "Emscripten"
				PlatformIsDarwin true
				PlatformFamily "Linux"
			}
		}
	}

	MalterlibUseStaticLibCxx false // User: Enables static libc++
	{
		!!MalterlibUseStaticLibCxx ""
	}
	
	MalterlibMemoryManager "New" // User: Choose the memory manager. Options: Old, New, System, OverwriteCheck, DLMalloc, LLAlloc (default New)
	{
		!!MalterlibMemoryManager ""
	}

	MalterlibMemoryManager_AlwaysRelease "true" // User: Enable memory manager to always be compile as if release config (default true)
	{
		&
		{
			MalterlibMemoryManager_AlwaysRelease ""
			!DocumentationEnabled true
		}
	}
	
	MalterlibMemoryManager_Debug "" // User: Enable Enable debug memory manager that reports leaks and checks for overwrites. Toggling will recompile everything. (default true in debug configs, false otherwise)
	{
		!!MalterlibMemoryManager_Debug ""
	}

	MalterlibMemoryManager_Debug_Features "" // User: Global toggle for debug memory manager. Can be toggled without recompiling everything.
	{
		!!MalterlibMemoryManager_Debug_Features ""
	}
	
	MalterlibMemoryManager_Debug_EnableFreeValidation false // User: Enable validation of freed blocks. Detects double frees and invalid frees. High impact on performance. (default false)
	{
		!!MalterlibMemoryManager_Debug_EnableFreeValidation ""
	}
	
	MalterlibMemoryManager_Debug_EnableMemoryLeaks false // User: Enables listing of memory leaks. High impact on performance. (default false)
	{
		!!MalterlibMemoryManager_Debug_EnableMemoryLeaks ""
	}
	
	MalterlibMemoryManager_Debug_EnableStackTrace false // User: Enable stack trace in debug heap (default false)
	{
		!!MalterlibMemoryManager_Debug_EnableStackTrace ""
	}

	MalterlibMemoryManager_Debug_EnableFreedGuards true // User: Enable checks for overwritten freed memory in debug heap (0xDD pattern) (default true)
	{
		!!MalterlibMemoryManager_Debug_EnableFreedGuards ""
	}
	
	MalterlibMemoryManager_Debug_EnableAllocatedFill true // User: Enable filling of allocated bytes in debug heap (0xCD pattern) (default true)
	{
		!!MalterlibMemoryManager_Debug_EnableAllocatedFill ""
	}

	MalterlibMemoryManager_Debug_EnableEdgeGuards true // User: Enable checks for overwritten memory before and after allocated blocks (0xFD pattern) (default true). If disabled, also disables stack traces, leak checks 
	{
		!!MalterlibMemoryManager_Debug_EnableEdgeGuards ""
	}

	MalterlibMemoryManager_OverrideSystemMalloc true
	{
		&
		{
			MalterlibMemoryManager_OverrideSystemMalloc ""
			|
			{
				PlatformFamily OSX
				PlatformFamily Linux
				PlatformFamily Windows
			}
		}
	}

	MalterlibMemoryManager_OverrideSystemMalloc false // User: Override the default malloc
	{
		!!MalterlibMemoryManager_OverrideSystemMalloc ""
	}



	MalterlibBuildSpecifics ""
	
	MalterlibWindowsNtVersion "_WIN32_WINNT_WINXP"
	{
		&
		{
			PlatformFamily "Windows"
			Architecture "x86"
		}
	}
	MalterlibWindowsVersion "NTDDI_WINXPSP3"
	{
		&
		{
			PlatformFamily "Windows"
			Architecture "x86"
		}
	}
	MalterlibWindowsNtVersion "_WIN32_WINNT_WS03"
	{
		&
		{
			PlatformFamily "Windows"
			Architecture "x64"
		}
	}
	MalterlibWindowsVersion "NTDDI_WS03SP2"
	{
		&
		{
			PlatformFamily "Windows"
			Architecture "x64"
		}
	}
	MalterlibDisableBuildSystemGeneration "true"
	{
		&
		{
			MalterlibDisableBuildSystemGeneration ""
			MalterlibBuildServerBuild "true"
		}
	}
	MalterlibEnableBreakpadUploader "false"
	{
		!!MalterlibEnableBreakpad ""
	}
	MalterlibClangVersion "4.0"
	{
		!!MalterlibClangVersion ""
	}
	/*
	// TODO: Enable when supported
	MalterlibEnableBreakpad "true"
	{
		&
		{
			PlatformFamily "OSX"
			Target:Target.Type "UIExecutable"
		}
	}
	*/
	MalterlibThread_LinuxUseStaticThreadLocal false // User: Use static thread locals on Linux. WARNING: This only works for executables, or load time dynamic libraries. Dynamic libraries loaded with dlopen() will not work, unless Malterlib_AssumeMalterlibHost is also specified.
	{
		!!MalterlibThread_LinuxUseStaticThreadLocal ""
	}
	MalterlibThread_LinuxAssumeGlibc true // User: Executable will only work on glibc system. Speeds up thread self access.
	{
		!!MalterlibThread_LinuxAssumeGlibc ""
	}
	Malterlib_AssumeMalterlibHost false // User: Dynamic libraries will only work when loaded from a process that uses Malterlib. Speeds up thread local access.
	{
		!!Malterlib_AssumeMalterlibHost ""
	}
	Malterlib_LinuxUseGoldLinker true // User: Use gold linker
	{
		!!Malterlib_LinuxUseGoldLinker ""
	}
}

// Product version
Property
{
    ProductVersionExtra "D"
	{
		&
		{
			ProductVersionExtra ""
			!MalterlibBuildServerBuild true
		}
	}
    ProductVersionMajor "1"
	{
		!!ProductVersionMajor ""
	}
    ProductVersionMinor "0"
	{
		!!ProductVersionMinor ""
	}
    ProductVersionRevision "001"
	{
		!!ProductVersionRevision ""
	}
    ProductName "Unnamed Product"
	{
		!!ProductName ""
	}
    ProductCompanyUniqueIdentifier "com.example"
	{
		!!ProductCompanyUniqueIdentifier ""
	}
    ProductCompany "Unknown company"
	{
		!!ProductCompany "" 
	}
    ProductContact "Malterlib <support@malterlib.com>"
	{
		!!ProductContact "" 
	}
    ProductCopyright "Copyright © @(Builtin.Function->DateTime('{YYYY}')) @(ProductCompany). All rights reserved."
	{
		!!ProductCopyright ""
	}
	ProductDescription "@(ProductName)"
	{
		!!ProductDecription ""
	}
    ProductFileName "@(Workspace:Workspace.Name)"
	{
		!!ProductFileName ""
	}
	ProductVersionHex "000@(ProductVersionMajor)@(ProductVersionMinor)@(ProductVersionRevision)"
	{
		!!ProductVersionHex ""
	}
}
