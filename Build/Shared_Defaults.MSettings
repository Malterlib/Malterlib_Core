// Malterlib

Property
{
    MalterlibTargetExtraSuffix: string = ""
    MalterlibTargetCustom: string = ""
    MalterlibDoExeFS: bool = false
    MalterlibUsesTranslation: bool = false
    MalterlibDoTranslationExeFS: bool = false
    MalterlibStronglyNamedAssembly: string?
    MalterlibNotifyResult: bool = false
    MalterlibExeFSPath: string = `@(Target:this.IdentityPath->GetPath())/ExeFS/*`
    MalterlibPostCopyProject: string?
	MalterlibPostCopyHash: bool = false
    MalterlibPostCopyDestination: string = ""
    MalterlibPostCopyProject2: string?
	MalterlibPostCopyHash2: bool = false
    MalterlibPostCopyDestination2: string = ""
    MalterlibConsoleApp: bool = false
    MalterlibQtSupport: bool = false
	MalterlibOutOfProcessSupport: bool = false
    MalterlibRWPropertyPages: bool = false
	MalterlibEnableInternalWorkspaces: bool = false
	MalterlibDoingProductBuild: bool = false

	BUILDSERVER: bool = false
	MalterlibBuildServerBuild: bool = BUILDSERVER
    MalterlibBuildSigning: bool = MalterlibBuildServerBuild
	MalterlibBuildServerTest: bool = false

	MalterlibBuildServerCommandPrefix: string = ""

	MalterlibManualForeignThreadInitialization: bool = true

    MalterlibSigning: bool
	MalterlibSigning true
	{
		&
		{
			MalterlibSigning undefined
			MalterlibBuildServerBuild true
			!Configuration "Release Testing" // Only default to signing if building release builds (Release Testing will not be signed)
		}
	}
	MalterlibSigning false
	{
		!!MalterlibSigning undefined
	}

	MalterlibXcodeNewBuildSystem: bool = false  // User(Build System)=true: Use Xcode new build system

	MalterlibXcodeNewBuildSystem true
	{
		&
		{
			MalterlibXcodeNewBuildSystem undefined
			Generator "Xcode14"
		}
	}

	MalterlibNoMacOSCrossModuleExceptions: bool = PlatformIsDarwin // User(Undocumented)=false: Disables catching of exception across modules on macOS. This will bring in libunwind statically (default true)

	MalterlibMaxSupportedWindowsVersion: string = "10.0.22000.0" // User(Platform Version): Max supported Windows version.

	MalterlibMinSupportedMacOSVersion: string = "10.13" // User(Platform Version): Max supported macOS version. Set this to smaller version to compile time check that you aren't using disallowed functions without version checks
	MalterlibMaxSupportedMacOSVersion: string = "Latest" // User(Platform Version): Max supported macOS version. Set this to smaller version to compile time check that you aren't using disallowed functions without version checks

	MalterlibMinSupportedMacOSVersion "13.0"
	{
		&
		{
			MalterlibMinSupportedMacOSVersion undefined
			&
			{
				PlatformFamily "macOS"
				Architecture "arm64e"
			}
		}
	}

    MalterlibMinSupportediOSVersion: string = "8.1" // User(Platform Version): Max supported iOS version. Set this to smaller version to compile time check that you aren't using disallowed functions without version checks
    MalterlibMaxSupportediOSVersion: string = "Latest" // User(Platform Version): Max supported iOS version. Set this to smaller version to compile time check that you aren't using disallowed functions without version checks

    MalterlibAllSchemes: bool = false // User(Build System)=true: Enable to generate schemes for all targets, even targets without debug commands

	MalterlibSharedDeployRoot: string = "/Shared"

	MalterlibSignIncludeCert: string = `@(Builtin.BasePathAbsolute)/Settings/Certificates/MSCV-GlobalSign.cer` // User(Signing): Set this to 'none' to disable incude cert for development
	MalterlibSignTimestampServer: string = "http://timestamp.globalsign.com/scripts/timestamp.dll" // User(Signing): Timestamp server to use when signing windows executables
	MalterlibSignTimestampServerRFC3161: string = "" // User(Signing): RFC 3161 Timestamp server to use when signing windows executables. This will override any setting in MalterlibSignTimestampServer
	MalterlibSignCertWindows: string = "Unknown Company" // User(Signing)="Name of cert": Set this to your local certificate for driver development
	MalterlibSignCertMacOS: string = "-" // User(Signing)=SHA1OfCert: Set this to your Developer ID cert for driver development

	MalterlibNotarizeMacOSProfile: string? // User(Signing)="ProfileName": Set this to keychain profile used for notarization. Previously stored with xcrun notarytool store-credentials --apple-id "email" --team-id "team"

	MalterlibBreakpadUploadServer: string = "https://error-reports.malterlib.org"
	MalterlibBreakpadReportInterval: int = 0
	MalterlibBreakpadRequestComments: bool = true
	MalterlibBreakpadRequestEmail: bool = true
	MalterlibBreakpadPrivacyPolicyURL: string = ""

	MalterlibDriverSigning: bool = true

	MalterlibForceDeploySymbols: bool = false

	MalterlibDeploySymbols: bool = false
    MalterlibDeploySymbols true
	{
		&
		{
			MalterlibDeploySymbols undefined
			MalterlibBuildServerBuild true
			|
			{
				!PlatformIsDarwin true
				&
				{
					PlatformIsDarwin true
					!Configuration "Release Testing" // Only deploy in Release/Debug builds, not Release testing
				}
				MalterlibForceDeploySymbols true
			}
		}
	}
	MalterlibLocalizationRoot: string = `@(Builtin.BasePathAbsolute)/MalterlibLegacy/Localization`

	MalterlibSupportSanitizerEnable_Thread: bool = (Sanitizer_Thread == "TSan") // User(Debug)=true: Enable thread sanitizer
	MalterlibSupportSanitizerEnable_Address: bool = (Sanitizer_Address == "ASan") // User(Debug)=true: Enable address sanitizer
	MalterlibSupportSanitizerEnable_UndefinedBehavior: bool = (Sanitizer_UndefinedBehavior == "UBSan") // User(Debug)=true: Enable undefined behavior sanitizer
	MalterlibSupportSanitizerEnable_NoRecover: bool = false // User(Debug)=true: Don't recover from sanitizer errors. Useful for running automated tests.

	MalterlibSupportSanitizers: bool = false // User(Debug)=true: Enable to support sanitizer debugging such as ASAN on macOS. Implicitly turns on default toolchain, and system memory manager
	MalterlibSupportSanitizers true
	{
		&
		{
			MalterlibSupportSanitizers undefined
			|
			{
				MalterlibSupportSanitizerEnable_Thread true
				MalterlibSupportSanitizerEnable_Address true
				MalterlibSupportSanitizerEnable_UndefinedBehavior true
			}
		}
	}

	MalterlibDefaultToolset: bool = false // User(Undocumented)=true: Use default Xcode toolset with no custom modifications to libc++ or clang

	MalterlibDefaultToolset true
	{
		&
		{
			MalterlibDefaultToolset undefined
			&
			{
				PlatformFamily "macOS"
				Architecture "arm64e"
			}
		}
	}

	MalterlibDefaultCompiler: bool // User(Undocumented)=true: Use default Xcode compiler
	MalterlibDefaultCompiler false
	{
		&
		{
			MalterlibDefaultCompiler undefined
			PlatformFamily "Linux"
		}
	}
	MalterlibDefaultCompiler true
	{
		&
		{
			MalterlibDefaultCompiler undefined
			MalterlibDefaultToolset true
		}
	}
	MalterlibDefaultCompiler false
	{
		!!MalterlibDefaultCompiler undefined
	}

	MalterlibCustomCompilerOptions: bool // User(Undocumented)=true: Use custom compiler options only available in patched compiler
	MalterlibCustomCompilerOptions true
	{
		&
		{
			MalterlibCustomCompilerOptions undefined
			|
			{
				MalterlibSupportSanitizers true
				PlatformFamily "Linux"
			}
		}
	}
	MalterlibCustomCompilerOptions false
	{
		!!MalterlibCustomCompilerOptions undefined
	}

	MalterlibDefaultXcode: bool = true // User(Undocumented)=false: Use default Xcode clang compiler specifications

	MalterlibUseStaticLibCxxABI: bool // User(Toolset)=false: Enables static libc++abi
	MalterlibUseStaticLibCxxABI true
	{
		&
		{
			MalterlibUseStaticLibCxxABI undefined
			!MalterlibDefaultToolset true
			|
			{
				PlatformFamily "Emscripten"
				PlatformIsDarwin true
				PlatformFamily "Linux"
			}
		}
	}
	MalterlibUseStaticLibCxxABI false
	{
		!!MalterlibUseStaticLibCxxABI undefined
	}

	MalterlibUseStaticLibUnwind: bool
	MalterlibUseStaticLibUnwind true
	{
		&
		{
			MalterlibUseStaticLibUnwind undefined
			|
			{
				PlatformFamily "Linux"
				PlatformFamily "Emscripten"
				PlatformIsDarwin true
			}
		}
	}

	MalterlibUseStaticLibUnwind false
	{
		!!MalterlibUseStaticLibUnwind undefined
	}

	MalterlibUseStaticLibCxx: bool // User(Toolset)=false: Enables static libc++
	MalterlibUseStaticLibCxx true
	{
		&
		{
			MalterlibUseStaticLibCxx undefined
			!MalterlibDefaultToolset true
			|
			{
				PlatformFamily "Emscripten"
				PlatformIsDarwin true
				PlatformFamily "Linux"
			}
		}
	}

	MalterlibUseStaticLibCxx false
	{
		!!MalterlibUseStaticLibCxx undefined
	}


	MalterlibRuntime_AlwaysRelease: bool? // User(Toolset)=false: Enable runtime (libc++ etc) to always be compile as if release config (default true)
	MalterlibRuntime_AlwaysRelease true
	{
		&
		{
			MalterlibRuntime_AlwaysRelease undefined
			!DocumentationEnabled true
		}
	}

	MalterlibMemoryManager: one_of("Malterlib", "System", "OverwriteCheck", "MiMalloc", "TcMalloc") = "Malterlib" // User(Memory Manager)=OverwriteCheck: Choose the memory manager. Options: Malterlib, System, OverwriteCheck, MiMalloc, TcMalloc (default Malterlib)
	MalterlibMemoryManager "System"
	{
		&
		{
			MalterlibMemoryManager undefined
			MalterlibSupportSanitizerEnable_Address true
		}
	}

	MalterlibMemoryManager_AlwaysRelease: bool = Not(DocumentationEnabled) // User(Memory Manager)=false: Enable memory manager to always be compile as if release config (default true)

	MalterlibMemoryManager_Debug_Features: one_of(bool, undefined) // User(Memory Manager)=false: Global toggle for debug memory manager. Can be toggled without recompiling everything.

	MalterlibMemoryManager_Debug_EnableFreeValidation: bool = false // User(Memory Manager)=true: Enable validation of freed blocks. Detects double frees and invalid frees. High impact on performance. (default false)
	MalterlibMemoryManager_Debug_EnableMemoryLeaks: bool = false // User(Memory Manager)=true: Enables listing of memory leaks. High impact on performance. (default false)
	MalterlibMemoryManager_Debug_EnableStackTrace: bool = false // User(Memory Manager)=true: Enable stack trace in debug heap (default false)
	MalterlibMemoryManager_Debug_EnableFreedGuards: bool = true // User(Memory Manager)=false: Enable checks for overwritten freed memory in debug heap (0xDD pattern) (default true)
	MalterlibMemoryManager_Debug_EnableAllocatedFill: bool = true // User(Memory Manager)=false: Enable filling of allocated bytes in debug heap (0xCD pattern) (default true)
	MalterlibMemoryManager_Debug_EnableEdgeGuards: bool = true // User(Memory Manager)=false: Enable checks for overwritten memory before and after allocated blocks (0xFD pattern) (default true). If disabled, also disables stack traces, leak checks
	MalterlibMemoryManager_Debug_EnableAssertOnMemoryLeak: bool = false // User(Memory Manager)=true: Assert at exit if any memory leak is detected

	MalterlibMemoryManager_OverrideSystemMalloc: bool = false // User(Memory Manager)=true: Override the default malloc
	MalterlibMemoryManager_OverrideSystemMalloc true
	{
		&
		{
			MalterlibMemoryManager_OverrideSystemMalloc undefined
			!MalterlibSupportSanitizers true
			|
			{
				PlatformFamily "macOS"
				PlatformFamily "Linux"
				PlatformFamily "Windows"
			}
		}
	}

	MalterlibExeIcon: string?
	MalterlibExeMainNibFile: string?

	MalterlibBuildSpecifics: string?

	MalterlibWindowsNtVersion: string
	MalterlibWindowsNtVersion "_WIN32_WINNT_VISTA"
	{
		&
		{
			MalterlibWindowsNtVersion undefined
			PlatformFamily "Windows"			
		}
	}
	MalterlibWindowsVersion: string
	MalterlibWindowsVersion "NTDDI_VISTA"
	{
		&
		{
			MalterlibWindowsVersion undefined
			PlatformFamily "Windows"
		}
	}
	MalterlibDisableBuildSystemGeneration: bool = MalterlibBuildServerBuild
	MalterlibEnableBreakpadUploader: bool = false
	MalterlibClangVersion: string = "17.0"
	MalterlibClangVersionMajor: string = MalterlibClangVersion->ParseFormatString("{}.{}", "{0}")
	MalterlibCustomToolchainClangVersion: string = "8.0"
	MalterlibEnableBreakpad: bool = false
	MalterlibEnableBreakpad true
	{
		&
		{
			MalterlibEnableBreakpad undefined
			PlatformFamily "macOS"
			Target:Target.Type "UIExecutable"
		}
	}

	MalterlibThread_LinuxUseStaticThreadLocal: bool = false // User(Undocumented)=true: Use static thread locals on Linux. WARNING: This only works for executables, or load time dynamic libraries. Dynamic libraries loaded with dlopen() will not work, unless Malterlib_AssumeMalterlibHost is also specified.
	MalterlibThread_LinuxAssumeGlibc: bool = true // User(Undocumented)=false: Executable will only work on glibc system. Speeds up thread self access.
	Malterlib_AssumeMalterlibHost: bool = false // User(Undocumented)=true: Dynamic libraries will only work when loaded from a process that uses Malterlib. Speeds up thread local access.
	Malterlib_LinuxInitInPreInitArray: bool = false // User: Init before other shared libraries has been initialized. This can cause problems in some GLIBC versions
	Malterlib_LinuxLinker: string = "lld" // User(Toolset)="gold": Which linker to use on linux. Defaults to lld
}

// Product version
Property
{
	ProductVersionExtra: string
    ProductVersionExtra "D"
	{
		&
		{
			ProductVersionExtra undefined
			!MalterlibBuildServerBuild true
		}
	}
	ProductVersionExtra ""
	{
		!!ProductVersionExtra undefined
	}

    ProductVersionMajor: string = "1"
    ProductVersionMinor: string = "0"
    ProductVersionRevision: string = "001"

    ProductName: string = "Unnamed Product"
    ProductCompanyUniqueIdentifier: string = "com.example"
    ProductCompany: string = "Unknown company"
    ProductCountry: string = "XX"
    ProductLocality: string = "Unknown"
    ProductOrganizationalUnit: string = "Unknown"
    ProductContact: string = "Malterlib <support@malterlib.com>"
    ProductCopyright: string = `Copyright © @(DateTime('{YYYY}')) @(ProductCompany). All rights reserved.`
	ProductDescription: string = ProductName
    ProductFileName: string = Workspace:Workspace.Name
	ProductVersionHex: string = `000@(ProductVersionMajor)@(ProductVersionMinor)@(ProductVersionRevision)`
}
