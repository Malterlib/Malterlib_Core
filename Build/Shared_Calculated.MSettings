{
	CompileDialect "C"
	{
		!!Compile.Type "C"
		!!Compile.Type "C++"
		!!Compile.Type "ObjC"
		!!Compile.Type "ObjC++"
		!!Compile.Type "C++Managed"
	}
}

Property
{
	PlatformFamilyFromImpFile "@(this.Identity->ParseFormatString('{}PlatformImp_{}_', '{1}'))"
	PlatformFamilyFromImpFile "@(PlatformFamilyFromImpFile->ParseFormatString('{}.', '{0}'))"
}

Property
{
	PlatformFamilyFromFile "@(this.Identity->ParseFormatString('{}Platform_{}_', '{1}'))"
	PlatformFamilyFromFile "@(PlatformFamilyFromFile->ParseFormatString('{}.', '{0}'))"
}

