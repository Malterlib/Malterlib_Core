Property
{
/*	true define bool = true
	false define bool = false
	null define any = null
	undefined define any = undefined*/
}
Property
{
	LanguageFamily define string
	LanguageFamily "Native"
	{
		&
		{
			true HasParentEntity("Target")
			|
			{
				Target:Target.Language undefined
				Target:Target.Language "Native"
			}
		}
	}
	LanguageFamily ".NET"
	{
		&
		{
			true HasParentEntity("Target")
			Target:Target.Language "C#"
		}
	}
}

Property
{
	PlatformType define string = "Unix"
	PlatformType "Windows"
	{
		!!Platform "Windows"
	}

	PlatformVersion define string
	// Version
	PlatformVersion "510" // Windows XP
	{
		!!Platform "Windows"
	}
	PlatformVersion "1050" // OSX 10.5
	{
		!!Platform "OSX10.5"
	}
	PlatformVersion "1060" // OSX 10.6
	{
		!!Platform "OSX10.6"
	}
	PlatformVersion "1070" // OSX 10.7
	{
		!!Platform "OSX10.7"
	}
	PlatformVersion "1080" // OSX 10.8
	{
		!!Platform "OSX10.8"
	}
	PlatformVersion "1090" // OSX 10.9
	{
		!!Platform "OSX10.9"
	}
	PlatformVersion "10100" // OSX 10.10
	{
		!!Platform "OSX10.10"
	}
	PlatformVersion "10110" // OSX 10.11
	{
		!!Platform "OSX10.11"
	}
	PlatformVersion "10120" // OSX 10.12
	{
		!!Platform "OSX10.12"
	}
	PlatformVersion "10130" // OSX 10.13
	{
		!!Platform "OSX10.13"
	}
	PlatformVersion "10140" // OSX 10.14
	{
		!!Platform "OSX10.14"
	}
	PlatformVersion "10150" // OSX 10.15
	{
		!!Platform "OSX10.15"
	}
	PlatformVersion "11000" // OSX 11
	{
		!!Platform "OSX11"
	}
	PlatformVersion "260" // Linux kernel 2.6
	{
		!!Platform "Linux2.6"
	}

	PlatformVersion "810" // iOS 8.1
	{
		!!Platform "iOS8.1"
	}

	// Family
	PlatformFamily define one_of(string, undefined)

	PlatformFamily "Windows"
	{
		!!Platform "Windows"
	}
	PlatformFamily "OSX"
	{
		!!Platform "OSX10.5"
		!!Platform "OSX10.6"
		!!Platform "OSX10.7"
		!!Platform "OSX10.8"
		!!Platform "OSX10.9"
		!!Platform "OSX10.10"
		!!Platform "OSX10.11"
		!!Platform "OSX10.12"
		!!Platform "OSX10.13"
		!!Platform "OSX10.14"
		!!Platform "OSX10.15"
		!!Platform "OSX11"
	}
	PlatformFamily "iOS"
	{
		!!Platform "iOS8.1"
	}
	PlatformFamily "Linux"
	{
		!!Platform "Linux2.6"
	}
	PlatformFamily "Emscripten"
	{
		!!Platform "Emscripten"
	}

	PlatformIsDarwin define bool = false
	PlatformIsDarwin true
	{
		!!PlatformFamily "OSX"
		!!PlatformFamily "iOS"
	}

	RealConfiguration define string = Configuration

	// Documentation

	DocumentationEnabled define bool = false
	DocumentationEnabled true
	{
		!!Documentation "Doxygen"
	}

	// Config

	FullConfiguration `@(Configuration->Replace(" ",""))@((Tests || "")->Replace(" ",""))@((Documentation || "")->Replace(" ",""))`
	{
		!!FullConfiguration undefined
	}
}

Property
{
	ArchitectureBitness define int
	ArchitectureBitness 32
	{
		!!Architecture "x86"
		!!Architecture "Arm"
		!!Architecture "ppc32"
	}
	ArchitectureBitness 64
	{
		!!Architecture "x64"
		!!Architecture "Itanium"
		!!Architecture "ppc64"
		!!Architecture "arm64"
		!!Architecture "arm64e"
	}

	ArchitectureEndian define string
	ArchitectureEndian "Little"
	{
		!!Architecture "x86"
		!!Architecture "Arm"
		!!Architecture "x64"
		!!Architecture "Itanium"
		!!Architecture "arm64"
		!!Architecture "arm64e"
	}
	ArchitectureEndian "Big"
	{
		!!Architecture "ppc64"
		!!Architecture "ppc32"
	}
}

Property
{
	ScriptExtension define string
	ScriptExtension ".bat"
	{
		!!PlatformType "Windows"
	}
	ScriptExtension ".sh"
	{
		|
		{
			PlatformType "Unix"
			ScriptWindowsBash true
		}
	}

	ScriptExport function(string _Name, string _Value) string
	ScriptExport `set @(_Name)=@(_Value)`
	{
		!!PlatformType "Windows"
	}
	ScriptExport `export @(`@(_Name)=@(_Value)`->EscapeHost())`
	{
		|
		{
			PlatformType "Unix"
			ScriptWindowsBash true
		}
	}

	ScriptMkDir function(string _Directory) string
	ScriptMkDir `if not exist @(_Directory->WindowsPath()->EscapeHost()) md @(_Directory->WindowsPath()->EscapeHost())\r\n`\
				`@(CheckErrors)\r\n`
	{
		!!PlatformType "Windows"
	}

	ScriptMkDir `mkdir -p @(_Directory->EscapeHost())`
	{
		|
		{
			PlatformType "Unix"
			ScriptWindowsBash true
		}
	}

	ScriptPreamble define string = ""
	ScriptPreamble "#!/bin/bash\n\n"
	{
		|
		{
			PlatformType "Unix"
			ScriptWindowsBash true
		}
	}

	ScriptUnixLineEnds define bool = false
	ScriptUnixLineEnds true
	{
		|
		{
			PlatformType "Unix"
			ScriptWindowsBash true
		}
	}

	NativeLineEnding define string = "\r\n"
	NativeLineEnding "\n"
	{
		!!ScriptUnixLineEnds true
	}

	BashScriptPrefix define string = ""
	BashScriptPrefix "\"C:/Program Files/Git/bin/bash.exe\" "
	{
		!!PlatformFamily "Windows"
	}

	ScriptWindowsBash define bool = false
}
Property
{
	DebugCompiler define bool
	DebugCompiler true
	{
		!!Configuration "Debug"
		!!Configuration "Debug Inlined"
		!!Configuration "Fast Compile"
	}
	DebugCompiler false
	{
		!!Configuration "Debug Optimized"
		!!Configuration "Profile"
		!!Configuration "Release"
		!!Configuration "Optimized"
	    !!Configuration "Debug Optimized"
		!!Configuration "Release Testing"
		!!Configuration "Release Debug"
	}

	RealDebugCompiler define bool
	RealDebugCompiler true
	{
		!!RealConfiguration "Debug"
		!!RealConfiguration "Debug Inlined"
		!!RealConfiguration "Fast Compile"
	}
	RealDebugCompiler false
	{
		!!RealConfiguration "Debug Optimized"
		!!RealConfiguration "Profile"
		!!RealConfiguration "Release"
		!!RealConfiguration "Optimized"
	    !!RealConfiguration "Debug Optimized"
		!!RealConfiguration "Release Testing"
		!!RealConfiguration "Release Debug"
	}
}

Property
{
	PlatformToolsetFamily define string = ""
	PlatformToolsetFamily "clang"
	{
		!!Target.PlatformToolset "com.apple.compilers.llvm.clang.malterlib_generator"
		!!Target.PlatformToolset "com.apple.compilers.llvm.clang.1_0"
	}

	ToolsetDir define string
	ToolsetDir Target.PlatformToolset
	ToolsetDir "VC17"
	{
		&
		{
			PlatformType "Windows"
			|
			{
				Target.PlatformToolset "v110"
				Target.PlatformToolset "v120_CTP_Nov2012"
			}
		}
	}
	ToolsetDir "VC18"
	{
		&
		{
			PlatformType "Windows"
			|
			{
				Target.PlatformToolset "v120"
			}
		}
	}
	ToolsetDir "VC19"
	{
		&
		{
			PlatformType "Windows"
			|
			{
				Target.PlatformToolset "v140"
				Target.PlatformToolset "v141"
				Target.PlatformToolset "v142"
			}
		}
	}
	ToolsetDir "VC19_clang_c2"
	{
		&
		{
			PlatformType "Windows"
			|
			{
				Target.PlatformToolset "v140_clang_c2"
			}
		}
	}
	ToolsetDir "clang_libc++"
	{
		!!PlatformToolsetFamily "clang"
	}

	WindowsNativeToolChain define bool = true // Visual Studio 2013 supports native toolchain for all targets
}

Property
{
	ExplicitTests define bool = false
	ExplicitTests true
	{
		!!Configuration "Profile"
		!!Configuration "Release"
		!!Configuration "Optimized"
	}
}

Property
{
	DebugCode define bool = false
	DebugCode true
	{
		!!Configuration "Debug"
		!!Configuration "Debug Inlined"
		!!Configuration "Debug Optimized"
		!!Configuration "Fast Compile"
	}
}

Property
{
	ConfigNoSpace define string = Configuration->Replace(" ", "")

	MalterlibPerforceStreamName define string?

	MalterlibBaseSourcePath define string = "Development"
	MalterlibCalcBranch define string
	MalterlibCalcBranch Builtin.BasePathAbsolute->GetLastPaths(4)
	MalterlibCalcBranch Builtin.BasePathAbsolute->GetLastPaths(3)
	{
		|
		{
			MalterlibCalcBranch ~`*/@(MalterlibBaseSourcePath)/*`
			MalterlibCalcBranch ~`@(MalterlibBaseSourcePath)/*`
		}
	}
	MalterlibCalcBranch Builtin.BasePathAbsolute->GetLastPaths(2)
	{
		|
		{
			MalterlibCalcBranch ~`*/@(MalterlibBaseSourcePath)/*`
			MalterlibCalcBranch ~`@(MalterlibBaseSourcePath)/*`
		}
	}
	MalterlibCalcBranch Builtin.BasePathAbsolute->GetLastPaths(1)
	{
		|
		{
			MalterlibCalcBranch ~`*/@(MalterlibBaseSourcePath)/*`
			MalterlibCalcBranch ~`@(MalterlibBaseSourcePath)/*`
		}
	}
	MalterlibBranch define string
	MalterlibBranch MalterlibGitBranch
	{
		&
		{
			MalterlibBranch undefined
			!MalterlibGitBranch undefined
		}
	}
	MalterlibBranch MalterlibCalcBranch->Replace(":", "")
	{
		!!MalterlibBranch undefined
	}
	MalterlibTaskStreamName define string?
	MalterlibTaskStreamName MalterlibPerforceStreamName->ParseFormatString("{}({})", "{1}")
	{
		&
		{
			!MalterlibPerforceStreamName undefined
			MalterlibPerforceStreamName ~"*(*)"
		}
	}

	MalterlibCalcFullBranch define string = MalterlibBranch
	MalterlibCalcFullBranch `@(MalterlibCalcFullBranch) (@(MalterlibTaskStreamName))`
	{
		!MalterlibTaskStreamName undefined
	}

	MalterlibFullBranch define string
	MalterlibFullBranch MalterlibGitBranch
	{
		&
		{
			MalterlibFullBranch undefined
			!MalterlibGitBranch undefined
		}
	}

	MalterlibFullBranch MalterlibCalcFullBranch
	{
		!!MalterlibFullBranch undefined
	}

	MalterlibChangingBootstrapVersion define bool?

	MalterlibIsGitRepository define bool = false
	MalterlibIsGitRepository true
	{
		&
		{
			!MalterlibChangingBootstrapVersion true
			![] Builtin.BasePathAbsolute->FindDirectoriesIn(".git")
		}
	}

	MalterlibGitRepoGitDir define string = `@(Builtin.BasePathAbsolute)/.git`

	MalterlibGitRepoInputFiles define [string] = []

	MalterlibGitRepoInputFiles =+ `@(MalterlibGitRepoGitDir)/HEAD`
	MalterlibGitRepoInputFiles =+ `@(MalterlibGitRepoGitDir)/packed-refs`
	{
		![] MalterlibGitRepoGitDir->FindFilesIn("packed-refs")
	}

	MalterlibGitHeadRef define string = `@(ReadFile(`@(MalterlibGitRepoGitDir)/HEAD`)->ParseFormatString("ref: {}\n", "{0}"))`
	MalterlibGitHeadRefPath define string = `@(MalterlibGitRepoGitDir)/@(MalterlibGitHeadRef)`
	MalterlibGitHeadRefFile define string = MalterlibGitHeadRefPath->GetFile()
	MalterlibGitHeadRefDir define string = MalterlibGitHeadRefPath->GetPath()

	MalterlibGitRepoInputFiles =+ `@(MalterlibGitRepoGitDir)/@(MalterlibGitHeadRef)`
	{
		![] MalterlibGitHeadRefDir->FindFilesIn(MalterlibGitHeadRefFile)
	}

	MalterlibGitOriginRemote define string = ""
	MalterlibGitOriginRemote ExecuteCommand(`@(GeneratedGlobalDirectory)GitOriginRemote.MState`, [`@(MalterlibGitRepoGitDir)/config`], "git", "remote", "get-url", "origin")
	{
		!!MalterlibIsGitRepository true
	}
	MalterlibGitOriginRemote MalterlibGitOriginRemote->FindGetLine("*")
	{
		!!MalterlibIsGitRepository true
	}

	MalterlibGitBranch define string?
	MalterlibGitBranch ExecuteCommand(`@(GeneratedGlobalDirectory)GitBranch.MState`, MalterlibGitRepoInputFiles, "git", "rev-parse", "--symbolic-full-name", "--abbrev-ref", "HEAD")->Trim()
	{
		!!MalterlibIsGitRepository true
	}

	MalterlibGitCommit define string = ""
	MalterlibGitCommit ExecuteCommand(`@(GeneratedGlobalDirectory)GitCommit.MState`, MalterlibGitRepoInputFiles, "git", "rev-parse", "HEAD")->Trim()
	{
		!!MalterlibIsGitRepository true
	}
}

Property
{
	MalterlibIsOSXBundle define bool = false
	MalterlibIsOSXBundle true
	{
		&
		{
			PlatformIsDarwin true
			|
			{
				Target.Type "UIExecutable"
				Target.Type "XcodeBundle"
				Target.Type "Driver"
			}
		}

	}
	MalterlibOSXHideDockTile define bool = false
	MalterlibOSXHideDockTile true
	{
		&
		{
			MalterlibOSXHideDockTile undefined
			PlatformFamily "OSX"
			TargetIsExecutable true
			!Target.Type "UIExecutable"
			!Target.Type "XcodeBundle"
		}
	}
	MalterlibOSXNoDarkMode define bool = false
}

Property
{
	MalterlibDebugPrefix define string = ""
	MalterlibDebugPrefix "D"
	{
		|
		{
			Configuration "Debug"
			Configuration "Debug Inlined"
			Configuration "Debug Optimized"
			Configuration "Fast Compile"
		}
	}

	MalterlibDebugLibrariesFolderName define string = "Release"
	MalterlibDebugLibrariesFolderName "Debug"
	{
		|
		{
			Configuration "Debug"
			Configuration "Debug Inlined"
			Configuration "Debug Optimized"
			Configuration "Fast Compile"
		}
	}

	MalterlibQtLibrarySuffix define string = ""
	MalterlibQtLibrarySuffix "D"
	{
		&
		{
			PlatformFamily "Windows"
			MalterlibDebugLibrariesFolderName "Debug"
		}
	}
	MalterlibQtLibrarySuffix "_debug"
	{
		&
		{
			PlatformIsDarwin true
			MalterlibDebugLibrariesFolderName "Debug"
		}
	}

	MalterlibArchitectureSuffix define string = Architecture

	MalterlibConfigSuffix define string = ""
	MalterlibConfigSuffix "D"
	{
		!!Configuration "Debug"
	}
	MalterlibConfigSuffix "DI"
	{
		!!Configuration "Debug Inlined"
	}
	MalterlibConfigSuffix "DO"
	{
		!!Configuration "Debug Optimized"
	}
	MalterlibConfigSuffix "FC"
	{
		!!Configuration "Fast Compile"
	}
	MalterlibConfigSuffix ""
	{
		!!DocumentationEnabled true
	}

	Malterlib_RefcountDebugging_Enable define bool = false // User(Debug)=true: Set to true to enable shared pointer reference debugging

	Malterlib_Tests_Enable define bool // User(Tests)=true: Force enable or disable of tests (set to true or false)
	Malterlib_Tests_Enable false
	{
		&
		{
			Malterlib_Tests_Enable undefined
			DebugCode false
			!Tests "Tests"
			!Tests "Perf Tests"
		}
	}
	Malterlib_Tests_Enable true
	{
		!!Malterlib_Tests_Enable undefined
	}

	Malterlib_Contracts_Enable define bool // User(Debug)=false: Force enable or disable of contracts (set to true or false)
	Malterlib_Contracts_Enable false
	{
		&
		{
			Malterlib_Contracts_Enable undefined
			DebugCode false
			!Configuration "Release Testing"
		}
	}
	Malterlib_Contracts_Enable true
	{
		!!Malterlib_Contracts_Enable undefined
	}

	MalterlibMemory_Shims_Enable define bool // User(Debug)=true: Force enable or disable of memory shims (set to true or false). Also used for enabling remote debugger support currently
	MalterlibMemory_Shims_Enable false
	{
		&
		{
			MalterlibMemory_Shims_Enable undefined
			DebugCode false
		}
	}
	MalterlibMemory_Shims_Enable true
	{
		!!MalterlibMemory_Shims_Enable undefined
	}

	MalterlibMemory_Shims_EnableLocal define bool // User(Debug)=false: Enable thread local memory reporters. Used in for example tests to track memory in local scopes
	MalterlibMemory_Shims_EnableLocal false
	{
		&
		{
			MalterlibMemory_Shims_EnableLocal undefined
			DebugCode false
			!Tests "Tests"
		}
	}
	MalterlibMemory_Shims_EnableLocal true
	{
		!!MalterlibMemory_Shims_EnableLocal undefined
	}

	MalterlibMemory_Shims_Lightweight define bool = false // User(Debug)=true: Enable lightweight thread local memory reporters for main memory manager only.
	MalterlibMemory_Shims_EnableGlobal define bool = true // User(Debug)=false: Enable global memory reporter. Used for for example remote debugger support

	MalterlibMemoryManager_Debug define bool = DebugCode // User(Memory Manager)=true: Enable Enable debug memory manager that reports leaks and checks for overwrites. Toggling will recompile everything. (default true in debug configs, false otherwise)
	MalterlibMemoryManager_CrossModule_Enable define bool = true // User(Memory Manager)=false: Enables cross module memory manager that shares the memory manager in all dlls with the executables memory manager
	MalterlibMemoryManager_HugePage_Enable define bool = false // User(Memory Manager)=true: Enables transparent huge page support on Linux
	MalterlibMemoryManager_Stats_Enable define bool = false // User(Memory Manager)=true: Report statistics about memory allocations at the end of the program
	MalterlibMemoryManager_Stats_EnableCategories define bool = false // User(Memory Manager)=true: Dump statistics about memory allocations through categories
	MalterlibMemoryManager_Stats_EnableCallstack define bool = false // User(Memory Manager)=true: Dump statistics about memory allocations callstacks
	MalterlibMemoryManager_System_UseLibC define bool = false // User(Memory Manager)=true: Use LibC for system memory manager. Useful on OSX to track allocs in Instruments
}

Property
{
	VersionStringSuffix define string = ""
}

Property
{
	CompileDialect define string = ""

	CompileDialect "C"
	{
		!!Compile.Type "C"
		!!Compile.Type "C++"
		!!Compile.Type "ObjC"
		!!Compile.Type "ObjC++"
		!!Compile.Type "C++Managed"
	}
}

Property
{
	PlatformFamilyFromImpFile define string = this.Identity->ParseFormatString("{}PlatformImp_{}_", "{1}")->ParseFormatString("{}.", "{0}")
}

Property
{
	PlatformFamilyFromFile define string
	PlatformFamilyFromFile this.Identity->ParseFormatString("{}Platform_{}_", "{1}")->ParseFormatString("{}.", "{0}")
}

Property
{
	!!PlatformFamily "OSX"
	PlatformFamilyFromFile "OSX"
	{
		!!PlatformFamilyFromFile "Unix"
		!!PlatformFamilyFromFile "POSIX"
	}
}

Property
{
	!!PlatformFamily "Linux"
	PlatformFamilyFromFile "Linux"
	{
		!!PlatformFamilyFromFile "Unix"
		!!PlatformFamilyFromFile "POSIX"
	}
}
