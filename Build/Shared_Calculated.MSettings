Property
{
/*	true: bool = true
	false: bool = false
	null: any = null
	undefined: any = undefined*/
}
Property
{
	LanguageFamily: string = "Native"
	LanguageFamily "Native"
	{
		&
		{
			true HasParentEntity("Target")
			|
			{
				Target:Target.Language undefined
				Target:Target.Language "Native"
			}
		}
	}
	LanguageFamily ".NET"
	{
		&
		{
			true HasParentEntity("Target")
			Target:Target.Language "C#"
		}
	}
}

Property
{
	PlatformType: string = "Unix"
	PlatformType "Windows"
	{
		!!Platform "Windows"
	}

	PlatformVersion: int
	// Version
	PlatformVersion 510 // Windows XP
	{
		!!Platform "Windows"
	}
	PlatformVersion `@(MalterlibMinSupportedMacOSVersion->Replace(".", "0"))0`->AsInteger()
	{
		!!Platform "macOS"
	}
	PlatformVersion 260 // Linux Kernel 2.6
	{
		!!Platform "Linux"
	}

	PlatformVersion `@(MalterlibMinSupportediOSVersion->Replace(".", "0"))0`->AsInteger()
	{
		!!Platform "iOS8.1"
	}

	// Family
	PlatformFamily: one_of(string, undefined)

	PlatformFamily "Windows"
	{
		!!Platform "Windows"
	}
	PlatformFamily "macOS"
	{
		!!Platform "macOS"
	}
	PlatformFamily "iOS"
	{
		!!Platform "iOS8.1"
	}
	PlatformFamily "Linux"
	{
		!!Platform "Linux"
	}

	PlatformIsDarwin: bool = false
	PlatformIsDarwin true
	{
		!!PlatformFamily "macOS"
		!!PlatformFamily "iOS"
	}

	RealConfiguration: string = Configuration

	// Documentation

	DocumentationEnabled: bool = false
	DocumentationEnabled true
	{
		!!Documentation "Doxygen"
	}
}

Property
{
	ArchitectureBitness: int
	ArchitectureBitness 32
	{
		!!Architecture "x86"
		!!Architecture "Arm"
		!!Architecture "ppc32"
	}
	ArchitectureBitness 64
	{
		!!Architecture "x64"
		!!Architecture "Itanium"
		!!Architecture "ppc64"
		!!Architecture "arm64"
		!!Architecture "arm64e"
	}

	ArchitectureEndian: string
	ArchitectureEndian "Little"
	{
		!!Architecture "x86"
		!!Architecture "Arm"
		!!Architecture "x64"
		!!Architecture "Itanium"
		!!Architecture "arm64"
		!!Architecture "arm64e"
	}
	ArchitectureEndian "Big"
	{
		!!Architecture "ppc64"
		!!Architecture "ppc32"
	}
}

Property
{
	ScriptWindowsBash: bool?

	ScriptWindowsBat: bool = (ScriptWindowsBash <==> false || (ScriptWindowsBash <!=> true && HostPlatformFamily == "Windows" && GeneratorFamily == "VisualStudio"))

	ScriptExtension: string
	ScriptExtension ".bat"
	{
		!!ScriptWindowsBat true
	}
	ScriptExtension ".sh"
	{
		!!ScriptExtension undefined
	}

	HostExecutableExtension: string = ""
	HostExecutableExtension ".exe"
	{
		!!HostPlatformFamily "Windows"
	}

	ScriptExport function(string _Name, string _Value) string
	ScriptExport `set @(_Name)=@(_Value)`
	{
		!!ScriptWindowsBat true
	}
	ScriptExport `export @(`@(_Name)=@(_Value)`->EscapeBash())`
	{
		!!ScriptWindowsBat false
	}

	f_ScriptEscapeString function(string _Value) string
	f_ScriptEscapeString _Value->EscapeWindows()
	{
		!!ScriptWindowsBat true
	}
	f_ScriptEscapeString _Value->EscapeBash()
	{
		!!ScriptWindowsBat false
	}

	f_ScriptNativePath function(string _Value) string
	f_ScriptNativePath _Value->NativePath()
	{
		!!ScriptWindowsBat true
	}
	f_ScriptNativePath _Value->UnixPath()
	{
		!!ScriptWindowsBat false
	}

	f_ScriptNativeEscapedPath function(string _Value) string
	f_ScriptNativeEscapedPath _Value->f_ScriptNativePath()->f_ScriptEscapeString()

	ScriptMkDir function(string _Directory) string
	ScriptMkDir `if not exist @(_Directory->WindowsPath()->EscapeHost()) md @(_Directory->WindowsPath()->EscapeHost())\r\n`
	{
		!!ScriptWindowsBat true
	}

	ScriptMkDir `mkdir -p @(_Directory->EscapeBash())`
	{
		!!ScriptWindowsBat false
	}

	ScriptPreamble: string = ""
	ScriptPreamble "#!/bin/bash\n\n"
	{
		!!ScriptWindowsBat false
	}

	ScriptUnixLineEnds: bool = false
	ScriptUnixLineEnds true
	{
		!!ScriptWindowsBat false
	}

	NativeLineEnding: string = "\r\n"
	NativeLineEnding "\n"
	{
		!!ScriptUnixLineEnds true
	}

	BashScriptPrefix: string = ""
	BashScriptPrefix "\"C:/Program Files/Git/bin/bash.exe\" "
	{
		&
		{
			GeneratorFamily "VisualStudio"
			PlatformFamily "Windows"
		}
	}
}
Property
{
	DebugCompiler: bool
	DebugCompiler true
	{
		!!Configuration "Debug"
		!!Configuration "Debug Inlined"
		!!Configuration "Fast Compile"
	}
	DebugCompiler false
	{
		!!Configuration "Debug Optimized"
		!!Configuration "Profile"
		!!Configuration "Release"
		!!Configuration "Optimized"
	    !!Configuration "Debug Optimized"
		!!Configuration "Release Testing"
		!!Configuration "Release Debug"
	}

	RealDebugCompiler: bool
	RealDebugCompiler true
	{
		!!RealConfiguration "Debug"
		!!RealConfiguration "Debug Inlined"
		!!RealConfiguration "Fast Compile"
	}
	RealDebugCompiler false
	{
		!!RealConfiguration "Debug Optimized"
		!!RealConfiguration "Profile"
		!!RealConfiguration "Release"
		!!RealConfiguration "Optimized"
	    !!RealConfiguration "Debug Optimized"
		!!RealConfiguration "Release Testing"
		!!RealConfiguration "Release Debug"
	}
}

Property
{
	PlatformToolsetFamily: string = ""
	PlatformToolsetFamily "clang"
	{
		!!Target.PlatformToolset "com.apple.compilers.llvm.clang.malterlib_generator"
		!!Target.PlatformToolset "com.apple.compilers.llvm.clang.1_0"
	}

	ToolsetDir: string
	ToolsetDir Target.PlatformToolset
	ToolsetDir "VC19"
	{
		&
		{
			PlatformType "Windows"
			|
			{
				Target.PlatformToolset "v142"
			}
		}
	}
	ToolsetDir "VC19_clang_c2"
	{
		&
		{
			PlatformType "Windows"
			|
			{
				Target.PlatformToolset "v140_clang_c2"
			}
		}
	}
	ToolsetDir "clang_libc++"
	{
		!!PlatformToolsetFamily "clang"
	}

	WindowsNativeToolChain: bool = true // Visual Studio 2013 supports native toolchain for all targets
}

Property
{
	ExplicitTests: bool = false
	ExplicitTests true
	{
		!!Configuration "Profile"
		!!Configuration "Release"
		!!Configuration "Optimized"
	}
}

Property
{
	DebugCode: bool = false
	DebugCode true
	{
		!!Configuration "Debug"
		!!Configuration "Debug Inlined"
		!!Configuration "Debug Optimized"
		!!Configuration "Fast Compile"
	}
}

Property
{
	ConfigNoSpace: string = Configuration->Replace(" ", "")

	MalterlibPerforceStreamName: string?

	MalterlibBaseSourcePath: string = "Development"
	MalterlibCalcBranch: string
	MalterlibCalcBranch Builtin.BasePathAbsolute->GetLastPaths(4)
	MalterlibCalcBranch Builtin.BasePathAbsolute->GetLastPaths(3)
	{
		|
		{
			MalterlibCalcBranch ~`*/@(MalterlibBaseSourcePath)/*`
			MalterlibCalcBranch ~`@(MalterlibBaseSourcePath)/*`
		}
	}
	MalterlibCalcBranch Builtin.BasePathAbsolute->GetLastPaths(2)
	{
		|
		{
			MalterlibCalcBranch ~`*/@(MalterlibBaseSourcePath)/*`
			MalterlibCalcBranch ~`@(MalterlibBaseSourcePath)/*`
		}
	}
	MalterlibCalcBranch Builtin.BasePathAbsolute->GetLastPaths(1)
	{
		|
		{
			MalterlibCalcBranch ~`*/@(MalterlibBaseSourcePath)/*`
			MalterlibCalcBranch ~`@(MalterlibBaseSourcePath)/*`
		}
	}
	MalterlibBranch: string
	MalterlibBranch MalterlibGitBranch
	{
		&
		{
			MalterlibBranch undefined
			!MalterlibGitBranch undefined
		}
	}
	MalterlibBranch MalterlibCalcBranch->Replace(":", "")
	{
		!!MalterlibBranch undefined
	}
	MalterlibTaskStreamName: string?
	MalterlibTaskStreamName MalterlibPerforceStreamName->ParseFormatString("{}({})", "{1}")
	{
		&
		{
			!MalterlibPerforceStreamName undefined
			MalterlibPerforceStreamName ~"*(*)"
		}
	}

	MalterlibCalcFullBranch: string
	MalterlibCalcFullBranch MalterlibBranch
	MalterlibCalcFullBranch `@(MalterlibCalcFullBranch) (@(MalterlibTaskStreamName))`
	{
		!MalterlibTaskStreamName undefined
	}

	MalterlibFullBranch: string
	MalterlibFullBranch MalterlibGitBranch
	{
		&
		{
			MalterlibFullBranch undefined
			!MalterlibGitBranch undefined
		}
	}

	MalterlibFullBranch MalterlibCalcFullBranch
	{
		!!MalterlibFullBranch undefined
	}

	MalterlibChangingBootstrapVersion: bool?

	MalterlibIsGitRepository: bool = false
	MalterlibIsGitRepository true
	{
		&
		{
			!MalterlibChangingBootstrapVersion true
			`@(Builtin.BasePathAbsolute)/.git`->FileOrDirectoryExists() true
		}
	}

	MalterlibIsPerforceRepository: bool = false
	MalterlibIsPerforceRepository true
	{
		&
		{
			!MalterlibChangingBootstrapVersion true
			!`@(Builtin.BasePathAbsolute)/.git`->FileOrDirectoryExists() true
			`@(Builtin.BasePathAbsolute)/.p4config`->FileExists() true
		}
	}

	// Resolves a location to its actual git data directory.
	// Normal repo: .git is a directory -> Location/.git
	// Worktree/submodule: .git is a file containing "gitdir: <path>" -> resolved path
	f_MalterlibGitDataDir function(string _Location) string
	f_MalterlibGitDataDir `@(_Location)/.git`
	{
		!!`@(_Location)/.git`->DirectoryExists() true
	}
	f_MalterlibGitDataDir ReadFile(`@(_Location)/.git`)->Trim()->ParseFormatString("gitdir: {}", "{0}")->MakeAbsolute(_Location)
	{
		&
		{
			f_MalterlibGitDataDir undefined
			`@(_Location)/.git`->FileExists() true
		}
	}

	// Resolves common dir from data dir.
	// Worktree: reads commondir file (contains relative path like "../..")
	// Normal/submodule: no commondir file, common dir = data dir
	f_MalterlibGitCommonDir function(string _DataDir) string
	f_MalterlibGitCommonDir ReadFile(`@(_DataDir)/commondir`)->Trim()->MakeAbsolute(_DataDir)
	{
		!!`@(_DataDir)/commondir`->FileExists() true
	}
	f_MalterlibGitCommonDir _DataDir
	{
		!`@(_DataDir)/commondir`->FileExists() true
	}

	MalterlibGitRepoGitDir: string = f_MalterlibGitDataDir(Builtin.BasePathAbsolute)
	MalterlibGitRepoGitCommonDir: string = f_MalterlibGitCommonDir(MalterlibGitRepoGitDir)

	f_MalterlibGitRepoInputFiles function(string _DataDir, string _CommonDir) [string] = []

	f_MalterlibGitRepoInputFiles =+ `@(_DataDir)/HEAD`
	f_MalterlibGitRepoInputFiles =+ `@(_CommonDir)/packed-refs`
	{
		![] _CommonDir->FindFilesIn("packed-refs")
	}

	f_MalterlibGitHeadRef function(string _DataDir) string = `@(ReadFile(`@(_DataDir)/HEAD`)->ParseFormatString("ref: {}\n", "{0}"))`
	f_MalterlibGitHeadRefPath function(string _DataDir, string _CommonDir) string = `@(_CommonDir)/@(f_MalterlibGitHeadRef(_DataDir))`
	f_MalterlibGitHeadRefFile function(string _DataDir, string _CommonDir) string = f_MalterlibGitHeadRefPath(_DataDir, _CommonDir)->GetFile()
	f_MalterlibGitHeadRefDir function(string _DataDir, string _CommonDir) string = f_MalterlibGitHeadRefPath(_DataDir, _CommonDir)->GetPath()

	f_MalterlibGitRepoInputFiles =+ `@(_CommonDir)/@(f_MalterlibGitHeadRef(_DataDir))`
	{
		![] f_MalterlibGitHeadRefDir(_DataDir, _CommonDir)->FindFilesIn(f_MalterlibGitHeadRefFile(_DataDir, _CommonDir))
	}

	MalterlibGitRemotes: string = ""
	MalterlibGitRemotes ExecuteCommand(`@(GeneratedGlobalDirectory)GitRemotes.MState`, ["ByDigest:", `@(MalterlibGitRepoGitCommonDir)/config`], `git@(HostExecutableExtension)`, "remote")
	{
		!!MalterlibIsGitRepository true
	}

	MalterlibGitHasOrigin: bool = false
	MalterlibGitHasOrigin true
	{
		!!MalterlibGitRemotes->FindGetLine("origin") "origin"
	}

	MalterlibGitOriginRemote: string = ""
	MalterlibGitOriginRemote ExecuteCommand(`@(GeneratedGlobalDirectory)GitOriginRemote.MState`, ["ByDigest:", `@(MalterlibGitRepoGitCommonDir)/config`], `git@(HostExecutableExtension)`, "remote", "get-url", "origin")
	{
		!!MalterlibGitHasOrigin true
	}
	MalterlibGitOriginRemote MalterlibGitOriginRemote->FindGetLine("*")
	{
		!!MalterlibGitHasOrigin true
	}
	MalterlibGitOriginRemote Error(`Your root git repository at '@(Builtin.BasePathAbsolute)' remote 'origin' doesn't have a proper remote URL, please set it`)
	{
		&
		{
			MalterlibGitHasOrigin true
			MalterlibGitOriginRemote ""
		}
	}

	MalterlibReproducibleBuild: bool = false // User(Build System)=true: Set to true to enable reproducible builds, setting dates to a known value

	CurrentTimeVersionString: string = DateTime("{YYYY}/{MM}/{DD} {HH}:{MNMN}:{SS}")

	CurrentTimeVersionString "2024/03/08 18:00:00"
	{
		!!MalterlibReproducibleBuild true
	}

	CurrentMalterlibTime: string = MalterlibTime("{}:{}")
	CurrentMalterlibTime "237148623877035302:9203263159192756512"
	{
		!!MalterlibReproducibleBuild true
	}

	// Probe whether HEAD itself resolves to a commit, not whether any ref does.
	// `rev-list --all` would include remote refs and tags that a fetch may have
	// populated while HEAD is still unborn, which would spoof MalterlibGitHasValidHead
	// and then break on the subsequent `rev-parse HEAD`. The .MTryState extension
	// enables ExecuteCommand's Try mode, so a non-zero exit (unborn HEAD) yields
	// an empty string instead of throwing.
	MalterlibGitHeadCommit: string = ""
	MalterlibGitHeadCommit ExecuteCommand(`@(GeneratedGlobalDirectory)GitHeadCommit.MTryState`, f_MalterlibGitRepoInputFiles(MalterlibGitRepoGitDir, MalterlibGitRepoGitCommonDir), `git@(HostExecutableExtension)`, "rev-parse", "--verify", "--quiet", "HEAD")->Trim()
	{
		!!MalterlibIsGitRepository true
	}

	MalterlibGitHasValidHead: bool = false
	MalterlibGitHasValidHead true
	{
		&
		{
			MalterlibIsGitRepository true
			!MalterlibGitHeadCommit ""
		}
	}

	MalterlibGitBranch: string?
	MalterlibGitBranch ExecuteCommand(`@(GeneratedGlobalDirectory)GitBranch.MState`, f_MalterlibGitRepoInputFiles(MalterlibGitRepoGitDir, MalterlibGitRepoGitCommonDir), `git@(HostExecutableExtension)`, "rev-parse", "--symbolic-full-name", "--abbrev-ref", "HEAD")->Trim()
	{
		&
		{
			MalterlibReproducibleBuild false
			MalterlibGitHasValidHead true
		}
	}
	MalterlibGitBranch "default"
	{
		&
		{
			MalterlibGitBranch undefined
			MalterlibIsGitRepository true
		}
	}

	MalterlibGitCommit: string = ""
	MalterlibGitCommit MalterlibGitHeadCommit
	{
		&
		{
			MalterlibReproducibleBuild false
			MalterlibGitHasValidHead true
		}
	}
	MalterlibGitCommit "default"
	{
		&
		{
			MalterlibGitCommit undefined
			MalterlibIsGitRepository true
		}
	}

	_MSPDBSRV_ENDPOINT_: string = "" // Used as a unique identifier for each build server build

	// Collect all git sub-repo locations (repo locations that have .git and are not the base dir)
	f_MalterlibCollectGitSubRepoLocation: [string] = []
	f_MalterlibCollectGitSubRepoLocation [Repository.Location]
	{
		!Repository.Location Builtin.BasePathAbsolute
	}

	f_MalterlibCollectGitSubRepoLocations function(string _Property) [string]
	f_MalterlibCollectGitSubRepoLocations =+ &f_MalterlibCollectGitSubRepoLocation->GetProperty(_Property)

	MalterlibGitSubRepoLocations: [string] = AllRepositories->ForEach(&f_MalterlibCollectGitSubRepoLocations)
	MalterlibPerforcePrefixTarget: string

	// Helper: returns _Location if PrefixTarget starts with it (config file is inside this git repo)
	f_MalterlibPerforceCheckPathPrefix function(string _Location) [string] = []
	f_MalterlibPerforceCheckPathPrefix =+ _Location
	{
		!!MalterlibPerforcePrefixTarget->StartsWith(`@(_Location->RemoveSuffix("/"))/`) true
	}

	// Collect config files that are NOT inside any git sub-repo (belong to perforce root)
	f_MalterlibCollectPerforceRootConfigFiles function(string _Property) [string]
	f_MalterlibCollectPerforceRootConfigFiles =+ GetProperty(&Repository.ConfigFile, _Property)
	{
		!!MalterlibGitSubRepoLocations->ForEach(&f_MalterlibPerforceCheckPathPrefix, {MalterlibPerforcePrefixTarget: &Repository.ConfigFile->GetProperty(_Property)})->IsEmpty() true
	}

	MalterlibPerforceRootConfigFiles: [string] = AllRepositories->ForEach(&f_MalterlibCollectPerforceRootConfigFiles)

	MalterlibPerforceChangelist: string = ""
	MalterlibPerforceChangelist ExecuteCommand(`@(GeneratedGlobalDirectory)@(_MSPDBSRV_ENDPOINT_)P4Changelist.MState`, MalterlibPerforceRootConfigFiles, `p4@(HostExecutableExtension)`, "changes", "-m", "1", "...#have")->Trim()->ParseFormatString("Change {} on {}", "{0}")
	{
		&
		{
			MalterlibReproducibleBuild false
			MalterlibIsPerforceRepository true
		}
	}
	MalterlibPerforceChangelist "default"
	{
		&
		{
			MalterlibPerforceChangelist undefined
			MalterlibIsPerforceRepository true
		}
	}

	MalterlibRootRevision: string = ""
	MalterlibRootRevision MalterlibGitCommit
	{
		!!MalterlibIsGitRepository true
	}
	MalterlibRootRevision MalterlibPerforceChangelist
	{
		!!MalterlibIsPerforceRepository true
	}
}

Property
{
	MalterlibIsMacOSBundle: bool = false
	MalterlibIsMacOSBundle true
	{
		&
		{
			PlatformIsDarwin true
			|
			{
				Target.Type "UIExecutable"
				Target.Type "XcodeBundle"
				Target.Type "Driver"
			}
		}

	}
	MalterlibMacOSHideDockTile: bool = false
	MalterlibMacOSHideDockTile true
	{
		&
		{
			MalterlibMacOSHideDockTile undefined
			PlatformFamily "macOS"
			TargetIsExecutable true
			!Target.Type "UIExecutable"
			!Target.Type "XcodeBundle"
		}
	}
	MalterlibMacOSNoDarkMode: bool = false
}

Property
{
	MalterlibDebugPrefix: string = ""
	MalterlibDebugPrefix "D"
	{
		|
		{
			Configuration "Debug"
			Configuration "Debug Inlined"
			Configuration "Debug Optimized"
			Configuration "Fast Compile"
		}
	}

	MalterlibDebugLibrariesFolderName: string = "Release"
	MalterlibDebugLibrariesFolderName "Debug"
	{
		|
		{
			Configuration "Debug"
			Configuration "Debug Inlined"
			Configuration "Debug Optimized"
			Configuration "Fast Compile"
		}
	}

	MalterlibQtLibrarySuffix: string = ""
	MalterlibQtLibrarySuffix "D"
	{
		&
		{
			PlatformFamily "Windows"
			MalterlibDebugLibrariesFolderName "Debug"
		}
	}
	MalterlibQtLibrarySuffix "_debug"
	{
		&
		{
			PlatformIsDarwin true
			MalterlibDebugLibrariesFolderName "Debug"
		}
	}

	MalterlibArchitectureSuffix: string = Architecture

	MalterlibConfigSuffix: string = ""
	MalterlibConfigSuffix "D"
	{
		!!Configuration "Debug"
	}
	MalterlibConfigSuffix "DI"
	{
		!!Configuration "Debug Inlined"
	}
	MalterlibConfigSuffix "DO"
	{
		!!Configuration "Debug Optimized"
	}
	MalterlibConfigSuffix "FC"
	{
		!!Configuration "Fast Compile"
	}
	MalterlibConfigSuffix ""
	{
		!!DocumentationEnabled true
	}

	MalterlibIoUring_Enable: bool = true // User(Core)=false: Set to false to build without the io_uring io loop backend (Linux falls back to epoll)
	MalterlibIoDebug_Enable: bool = DebugCode // User(Debug)=true: Enable the io loop / io debugging environment overrides (MalterlibIoUring, MalterlibIoUringCompletion, MalterlibIoUringMultishot, MalterlibIoUringSendZeroCopy, MalterlibIoUringZeroCopyLocal, MalterlibIoUringSendDepth, MalterlibIoUringReceiveBuffers, MalterlibIoLoops, MalterlibUringTrace, MalterlibSocketBufferSize, MalterlibSSLSendBatching, MalterlibSSLCompletionIoSend, MalterlibSSLCompletionIoReceive, MalterlibIocpCompletion, MalterlibIocpSendDepth, MalterlibIocpRecvDepth, MalterlibIocpRecvBufferBytes, MalterlibIocpSkipSuccess, MalterlibIocpTrace, MalterlibLoopbackFastPath). Enabled by default except in release configs

	Malterlib_RefCountDebugging_Enable: bool = false // User(Debug)=true: Set to true to enable shared pointer reference debugging
	Malterlib_RefCountLeakDebugging_Enable: bool = false // User(Debug)=true: Set to true to enable tracing information about shared pointer references when displaying memory leaks. Requires Malterlib_RefCountDebugging_Enable to be enabled as well

	Malterlib_Tests_Enable: bool // User(Tests)=true: Force enable or disable of tests (set to true or false)
	Malterlib_Tests_Enable false
	{
		&
		{
			Malterlib_Tests_Enable undefined
			DebugCode false
			!Tests "Tests"
			!Tests "Perf Tests"
		}
	}
	Malterlib_Tests_Enable true
	{
		!!Malterlib_Tests_Enable undefined
	}

	Malterlib_Contracts_Enable: bool // User(Debug)=false: Force enable or disable of contracts (set to true or false)
	Malterlib_Contracts_Enable false
	{
		&
		{
			Malterlib_Contracts_Enable undefined
			DebugCode false
			!Configuration "Release Testing"
		}
	}
	Malterlib_Contracts_Enable true
	{
		!!Malterlib_Contracts_Enable undefined
	}

	MalterlibMemory_Shims_Enable: bool // User(Debug)=true: Force enable or disable of memory shims (set to true or false). Also used for enabling remote debugger support currently
	MalterlibMemory_Shims_Enable false
	{
		&
		{
			MalterlibMemory_Shims_Enable undefined
			DebugCode false
		}
	}
	MalterlibMemory_Shims_Enable true
	{
		!!MalterlibMemory_Shims_Enable undefined
	}

	MalterlibMemory_Shims_EnableLocal: bool // User(Debug)=false: Enable thread local memory reporters. Used in for example tests to track memory in local scopes
	MalterlibMemory_Shims_EnableLocal false
	{
		&
		{
			MalterlibMemory_Shims_EnableLocal undefined
			DebugCode false
			!Tests "Tests"
		}
	}
	MalterlibMemory_Shims_EnableLocal true
	{
		!!MalterlibMemory_Shims_EnableLocal undefined
	}

	MalterlibMemory_Shims_Lightweight: bool = false // User(Debug)=true: Enable lightweight thread local memory reporters for main memory manager only.
	MalterlibMemory_Shims_EnableGlobal: bool = true // User(Debug)=false: Enable global memory reporter. Used for for example remote debugger support

	MalterlibMemoryManager_Debug: bool = DebugCode // User(Memory Manager)=true: Enable Enable debug memory manager that reports leaks and checks for overwrites. Toggling will recompile everything. (default true in debug configs, false otherwise)
	MalterlibMemoryManager_CrossModule_Enable: bool = true // User(Memory Manager)=false: Enables cross module memory manager that shares the memory manager in all dlls with the executables memory manager
	MalterlibMemoryManager_HugePage_Enable: bool = false // User(Memory Manager)=true: Enables transparent huge page support on Linux
	MalterlibMemoryManager_Stats_Enable: bool = false // User(Memory Manager)=true: Report statistics about memory allocations at the end of the program
	MalterlibMemoryManager_Stats_EnableCategories: bool = false // User(Memory Manager)=true: Dump statistics about memory allocations through categories
	MalterlibMemoryManager_Stats_EnableCallstack: bool = false // User(Memory Manager)=true: Dump statistics about memory allocations callstacks
	MalterlibMemoryManager_System_UseLibC: bool = false // User(Memory Manager)=true: Use LibC for system memory manager. Useful on macOS to track allocs in Instruments

	Malterlib_MacOSDeveloperLocaction: string = "/Applications/Xcode.app/Contents/Developer"
	Malterlib_MacOSDeveloperLocaction "/var/select/developer_dir"->ResolveSymbolicLink()
	{
		&
		{
			Malterlib_MacOSDeveloperLocaction undefined
			"/var/select/developer_dir"->LinkExists() true
		}
	}
	Malterlib_MacOSDeveloperLocaction "/var/db/xcode_select_link"->ResolveSymbolicLink()
	{
		&
		{
			Malterlib_MacOSDeveloperLocaction undefined
			"/var/db/xcode_select_link"->LinkExists() true
		}
	}
	Malterlib_MacOSDeveloperLocaction "/usr/share/xcode-select/xcode_dir_link"->ResolveSymbolicLink()
	{
		&
		{
			Malterlib_MacOSDeveloperLocaction undefined
			"/usr/share/xcode-select/xcode_dir_link"->LinkExists() true
		}
	}
	Malterlib_MacOSDeveloperLocaction "/usr/share/xcode-select/xcode_dir_path"->ResolveSymbolicLink()
	{
		&
		{
			Malterlib_MacOSDeveloperLocaction undefined
			"/usr/share/xcode-select/xcode_dir_path"->LinkExists() true
		}
	}

	// Xcode platform directory name (e.g., MacOSX.platform, iPhoneOS.platform)
	Malterlib_XcodePlatformName: string = "MacOSX.platform"
	Malterlib_XcodePlatformName "iPhoneOS.platform"
	{
		!!PlatformFamily "iOS"
	}
	Malterlib_XcodePlatformName "DriverKit.platform"
	{
		&
		{
			PlatformFamily "macOS"
			Target.DriverType "DriverKit"
		}
	}

	Malterlib_XcodePlatformDir: string = `@(Malterlib_MacOSDeveloperLocaction)/Platforms/@(Malterlib_XcodePlatformName)`

	Malterlib_MacOSSDKsRoot: string = `@(Malterlib_XcodePlatformDir)/Developer/SDKs`

	Malterlib_DummmyLibrary: string = "/dev/null"
	Malterlib_DummmyLibrary `@(Malterlib_MacOSDeveloperLocaction)/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/lib/libSystem.B.tbd`
	{
		!!PlatformFamily "macOS"
	}
	Malterlib_DummmyLibrary `@(MalterlibSysRoot)/lib/libc.so`
	{
		!!PlatformFamily "Linux"
	}
	Malterlib_DummmyLibrary VisualStudioMSVCRootPath / MalterlibMSVCVersion / `lib/@(Architecture)/delayimp.lib`
	{
		!!PlatformFamily "Windows"
	}
}

Property
{
	VersionStringSuffix: string = ""
}

Property
{
	CompileDialect: string = ""

	CompileDialect "C"
	{
		!!Compile.Type "C"
		!!Compile.Type "C++"
		!!Compile.Type "ObjC"
		!!Compile.Type "ObjC++"
		!!Compile.Type "C++Managed"
	}
}

Property
{
	PlatformFamilyFromImpFile: string
	PlatformFamilyFromImpFile this.Identity->ParseFormatString("{}PlatformImp_{}_", "{1}")->ParseFormatString("{}.", "{0}")

	PlatformFamilyFromImpFile "macOS"
	{
		!!PlatformFamilyFromImpFile "MacOS"
	}
}

Property
{
	PlatformFamilyFromFile: string
	PlatformFamilyFromFile this.Identity->ParseFormatString("{}Platform_{}_", "{1}")->ParseFormatString("{}.", "{0}")
}

Property
{
	!!PlatformFamily "macOS"
	PlatformFamilyFromFile "macOS"
	{
		!!PlatformFamilyFromFile "MacOS"
		!!PlatformFamilyFromFile "Unix"
		!!PlatformFamilyFromFile "POSIX"
	}
}

Property
{
	!!PlatformFamily "Linux"
	PlatformFamilyFromFile "Linux"
	{
		!!PlatformFamilyFromFile "Unix"
		!!PlatformFamilyFromFile "POSIX"
	}
}
