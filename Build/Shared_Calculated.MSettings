Property
{
/*	true: bool = true
	false: bool = false
	null: any = null
	undefined: any = undefined*/
}
Property
{
	LanguageFamily: string = "Native"
	LanguageFamily "Native"
	{
		&
		{
			true HasParentEntity("Target")
			|
			{
				Target:Target.Language undefined
				Target:Target.Language "Native"
			}
		}
	}
	LanguageFamily ".NET"
	{
		&
		{
			true HasParentEntity("Target")
			Target:Target.Language "C#"
		}
	}
}

Property
{
	PlatformType: string = "Unix"
	PlatformType "Windows"
	{
		!!Platform "Windows"
	}

	PlatformVersion: int
	// Version
	PlatformVersion 510 // Windows XP
	{
		!!Platform "Windows"
	}
	PlatformVersion `@(MalterlibMinSupportedMacOSVersion->Replace(".", "0"))0`->AsInteger()
	{
		!!Platform "macOS"
	}
	PlatformVersion 260 // Linux Kernel 2.6
	{
		!!Platform "Linux"
	}

	PlatformVersion `@(MalterlibMinSupportediOSVersion->Replace(".", "0"))0`->AsInteger()
	{
		!!Platform "iOS8.1"
	}

	// Family
	PlatformFamily: one_of(string, undefined)

	PlatformFamily "Windows"
	{
		!!Platform "Windows"
	}
	PlatformFamily "macOS"
	{
		!!Platform "macOS"
	}
	PlatformFamily "iOS"
	{
		!!Platform "iOS8.1"
	}
	PlatformFamily "Linux"
	{
		!!Platform "Linux"
	}
	PlatformFamily "Emscripten"
	{
		!!Platform "Emscripten"
	}

	PlatformIsDarwin: bool = false
	PlatformIsDarwin true
	{
		!!PlatformFamily "macOS"
		!!PlatformFamily "iOS"
	}

	RealConfiguration: string = Configuration

	// Documentation

	DocumentationEnabled: bool = false
	DocumentationEnabled true
	{
		!!Documentation "Doxygen"
	}
}

Property
{
	ArchitectureBitness: int
	ArchitectureBitness 32
	{
		!!Architecture "x86"
		!!Architecture "Arm"
		!!Architecture "ppc32"
	}
	ArchitectureBitness 64
	{
		!!Architecture "x64"
		!!Architecture "Itanium"
		!!Architecture "ppc64"
		!!Architecture "arm64"
		!!Architecture "arm64e"
	}

	ArchitectureEndian: string
	ArchitectureEndian "Little"
	{
		!!Architecture "x86"
		!!Architecture "Arm"
		!!Architecture "x64"
		!!Architecture "Itanium"
		!!Architecture "arm64"
		!!Architecture "arm64e"
	}
	ArchitectureEndian "Big"
	{
		!!Architecture "ppc64"
		!!Architecture "ppc32"
	}
}

Property
{
	ScriptExtension: string
	ScriptExtension ".bat"
	{
		!!PlatformType "Windows"
	}
	ScriptExtension ".sh"
	{
		|
		{
			PlatformType "Unix"
			ScriptWindowsBash true
		}
	}

	HostExecutableExtension: string = ""
	HostExecutableExtension ".exe"
	{
		!!HostPlatformFamily "Windows"
	}

	ScriptExport function(string _Name, string _Value) string
	ScriptExport `set @(_Name)=@(_Value)`
	{
		!!PlatformType "Windows"
	}
	ScriptExport `export @(`@(_Name)=@(_Value)`->EscapeBash())`
	{
		|
		{
			PlatformType "Unix"
			ScriptWindowsBash true
		}
	}

	ScriptMkDir function(string _Directory) string
	ScriptMkDir `if not exist @(_Directory->WindowsPath()->EscapeHost()) md @(_Directory->WindowsPath()->EscapeHost())\r\n`\
				`@(CheckErrors)\r\n`
	{
		!!PlatformType "Windows"
	}

	ScriptMkDir `mkdir -p @(_Directory->EscapeBash())`
	{
		|
		{
			PlatformType "Unix"
			ScriptWindowsBash true
		}
	}

	ScriptPreamble: string = ""
	ScriptPreamble "#!/bin/bash\n\n"
	{
		|
		{
			PlatformType "Unix"
			ScriptWindowsBash true
		}
	}

	ScriptUnixLineEnds: bool = false
	ScriptUnixLineEnds true
	{
		|
		{
			PlatformType "Unix"
			ScriptWindowsBash true
		}
	}

	NativeLineEnding: string = "\r\n"
	NativeLineEnding "\n"
	{
		!!ScriptUnixLineEnds true
	}

	BashScriptPrefix: string = ""
	BashScriptPrefix "\"C:/Program Files/Git/bin/bash.exe\" "
	{
		!!PlatformFamily "Windows"
	}

	ScriptWindowsBash: bool = false
}
Property
{
	DebugCompiler: bool
	DebugCompiler true
	{
		!!Configuration "Debug"
		!!Configuration "Debug Inlined"
		!!Configuration "Fast Compile"
	}
	DebugCompiler false
	{
		!!Configuration "Debug Optimized"
		!!Configuration "Profile"
		!!Configuration "Release"
		!!Configuration "Optimized"
	    !!Configuration "Debug Optimized"
		!!Configuration "Release Testing"
		!!Configuration "Release Debug"
	}

	RealDebugCompiler: bool
	RealDebugCompiler true
	{
		!!RealConfiguration "Debug"
		!!RealConfiguration "Debug Inlined"
		!!RealConfiguration "Fast Compile"
	}
	RealDebugCompiler false
	{
		!!RealConfiguration "Debug Optimized"
		!!RealConfiguration "Profile"
		!!RealConfiguration "Release"
		!!RealConfiguration "Optimized"
	    !!RealConfiguration "Debug Optimized"
		!!RealConfiguration "Release Testing"
		!!RealConfiguration "Release Debug"
	}
}

Property
{
	PlatformToolsetFamily: string = ""
	PlatformToolsetFamily "clang"
	{
		!!Target.PlatformToolset "com.apple.compilers.llvm.clang.malterlib_generator"
		!!Target.PlatformToolset "com.apple.compilers.llvm.clang.1_0"
	}

	ToolsetDir: string
	ToolsetDir Target.PlatformToolset
	ToolsetDir "VC17"
	{
		&
		{
			PlatformType "Windows"
			|
			{
				Target.PlatformToolset "v110"
				Target.PlatformToolset "v120_CTP_Nov2012"
			}
		}
	}
	ToolsetDir "VC18"
	{
		&
		{
			PlatformType "Windows"
			|
			{
				Target.PlatformToolset "v120"
			}
		}
	}
	ToolsetDir "VC19"
	{
		&
		{
			PlatformType "Windows"
			|
			{
				Target.PlatformToolset "v140"
				Target.PlatformToolset "v141"
				Target.PlatformToolset "v142"
			}
		}
	}
	ToolsetDir "VC19_clang_c2"
	{
		&
		{
			PlatformType "Windows"
			|
			{
				Target.PlatformToolset "v140_clang_c2"
			}
		}
	}
	ToolsetDir "clang_libc++"
	{
		!!PlatformToolsetFamily "clang"
	}

	WindowsNativeToolChain: bool = true // Visual Studio 2013 supports native toolchain for all targets
}

Property
{
	ExplicitTests: bool = false
	ExplicitTests true
	{
		!!Configuration "Profile"
		!!Configuration "Release"
		!!Configuration "Optimized"
	}
}

Property
{
	DebugCode: bool = false
	DebugCode true
	{
		!!Configuration "Debug"
		!!Configuration "Debug Inlined"
		!!Configuration "Debug Optimized"
		!!Configuration "Fast Compile"
	}
}

Property
{
	ConfigNoSpace: string = Configuration->Replace(" ", "")

	MalterlibPerforceStreamName: string?

	MalterlibBaseSourcePath: string = "Development"
	MalterlibCalcBranch: string
	MalterlibCalcBranch Builtin.BasePathAbsolute->GetLastPaths(4)
	MalterlibCalcBranch Builtin.BasePathAbsolute->GetLastPaths(3)
	{
		|
		{
			MalterlibCalcBranch ~`*/@(MalterlibBaseSourcePath)/*`
			MalterlibCalcBranch ~`@(MalterlibBaseSourcePath)/*`
		}
	}
	MalterlibCalcBranch Builtin.BasePathAbsolute->GetLastPaths(2)
	{
		|
		{
			MalterlibCalcBranch ~`*/@(MalterlibBaseSourcePath)/*`
			MalterlibCalcBranch ~`@(MalterlibBaseSourcePath)/*`
		}
	}
	MalterlibCalcBranch Builtin.BasePathAbsolute->GetLastPaths(1)
	{
		|
		{
			MalterlibCalcBranch ~`*/@(MalterlibBaseSourcePath)/*`
			MalterlibCalcBranch ~`@(MalterlibBaseSourcePath)/*`
		}
	}
	MalterlibBranch: string
	MalterlibBranch MalterlibGitBranch
	{
		&
		{
			MalterlibBranch undefined
			!MalterlibGitBranch undefined
		}
	}
	MalterlibBranch MalterlibCalcBranch->Replace(":", "")
	{
		!!MalterlibBranch undefined
	}
	MalterlibTaskStreamName: string?
	MalterlibTaskStreamName MalterlibPerforceStreamName->ParseFormatString("{}({})", "{1}")
	{
		&
		{
			!MalterlibPerforceStreamName undefined
			MalterlibPerforceStreamName ~"*(*)"
		}
	}

	MalterlibCalcFullBranch: string
	MalterlibCalcFullBranch MalterlibBranch
	MalterlibCalcFullBranch `@(MalterlibCalcFullBranch) (@(MalterlibTaskStreamName))`
	{
		!MalterlibTaskStreamName undefined
	}

	MalterlibFullBranch: string
	MalterlibFullBranch MalterlibGitBranch
	{
		&
		{
			MalterlibFullBranch undefined
			!MalterlibGitBranch undefined
		}
	}

	MalterlibFullBranch MalterlibCalcFullBranch
	{
		!!MalterlibFullBranch undefined
	}

	MalterlibChangingBootstrapVersion: bool?

	MalterlibIsGitRepository: bool = false
	MalterlibIsGitRepository true
	{
		&
		{
			!MalterlibChangingBootstrapVersion true
			![] Builtin.BasePathAbsolute->FindDirectoriesIn(".git")
		}
	}

	MalterlibGitRepoGitDir: string = `@(Builtin.BasePathAbsolute)/.git`

	MalterlibGitRepoInputFiles: [string] = []

	MalterlibGitRepoInputFiles =+ `@(MalterlibGitRepoGitDir)/HEAD`
	MalterlibGitRepoInputFiles =+ `@(MalterlibGitRepoGitDir)/packed-refs`
	{
		![] MalterlibGitRepoGitDir->FindFilesIn("packed-refs")
	}

	MalterlibGitHeadRef: string = `@(ReadFile(`@(MalterlibGitRepoGitDir)/HEAD`)->ParseFormatString("ref: {}\n", "{0}"))`
	MalterlibGitHeadRefPath: string = `@(MalterlibGitRepoGitDir)/@(MalterlibGitHeadRef)`
	MalterlibGitHeadRefFile: string = MalterlibGitHeadRefPath->GetFile()
	MalterlibGitHeadRefDir: string = MalterlibGitHeadRefPath->GetPath()

	MalterlibGitRepoInputFiles =+ `@(MalterlibGitRepoGitDir)/@(MalterlibGitHeadRef)`
	{
		![] MalterlibGitHeadRefDir->FindFilesIn(MalterlibGitHeadRefFile)
	}

	MalterlibGitOriginRemote: string = ""
	MalterlibGitOriginRemote ExecuteCommand(`@(GeneratedGlobalDirectory)GitOriginRemote.MState`, [`@(MalterlibGitRepoGitDir)/config`], "git", "remote", "get-url", "origin")
	{
		!!MalterlibIsGitRepository true
	}
	MalterlibGitOriginRemote MalterlibGitOriginRemote->FindGetLine("*")
	{
		!!MalterlibIsGitRepository true
	}
	MalterlibGitOriginRemote Error(`Your root git repository at '@(Builtin.BasePathAbsolute)' remote 'origin' doesn't have a proper remote URL, please set it`)
	{
		!!MalterlibGitOriginRemote ""
	}

	MalterlibGitBranch: string?
	MalterlibGitBranch ExecuteCommand(`@(GeneratedGlobalDirectory)GitBranch.MState`, MalterlibGitRepoInputFiles, "git", "rev-parse", "--symbolic-full-name", "--abbrev-ref", "HEAD")->Trim()
	{
		!!MalterlibIsGitRepository true
	}

	MalterlibGitCommit: string = ""
	MalterlibGitCommit ExecuteCommand(`@(GeneratedGlobalDirectory)GitCommit.MState`, MalterlibGitRepoInputFiles, "git", "rev-parse", "HEAD")->Trim()
	{
		!!MalterlibIsGitRepository true
	}
}

Property
{
	MalterlibIsMacOSBundle: bool = false
	MalterlibIsMacOSBundle true
	{
		&
		{
			PlatformIsDarwin true
			|
			{
				Target.Type "UIExecutable"
				Target.Type "XcodeBundle"
				Target.Type "Driver"
			}
		}

	}
	MalterlibMacOSHideDockTile: bool = false
	MalterlibMacOSHideDockTile true
	{
		&
		{
			MalterlibMacOSHideDockTile undefined
			PlatformFamily "macOS"
			TargetIsExecutable true
			!Target.Type "UIExecutable"
			!Target.Type "XcodeBundle"
		}
	}
	MalterlibMacOSNoDarkMode: bool = false
}

Property
{
	MalterlibDebugPrefix: string = ""
	MalterlibDebugPrefix "D"
	{
		|
		{
			Configuration "Debug"
			Configuration "Debug Inlined"
			Configuration "Debug Optimized"
			Configuration "Fast Compile"
		}
	}

	MalterlibDebugLibrariesFolderName: string = "Release"
	MalterlibDebugLibrariesFolderName "Debug"
	{
		|
		{
			Configuration "Debug"
			Configuration "Debug Inlined"
			Configuration "Debug Optimized"
			Configuration "Fast Compile"
		}
	}

	MalterlibQtLibrarySuffix: string = ""
	MalterlibQtLibrarySuffix "D"
	{
		&
		{
			PlatformFamily "Windows"
			MalterlibDebugLibrariesFolderName "Debug"
		}
	}
	MalterlibQtLibrarySuffix "_debug"
	{
		&
		{
			PlatformIsDarwin true
			MalterlibDebugLibrariesFolderName "Debug"
		}
	}

	MalterlibArchitectureSuffix: string = Architecture

	MalterlibConfigSuffix: string = ""
	MalterlibConfigSuffix "D"
	{
		!!Configuration "Debug"
	}
	MalterlibConfigSuffix "DI"
	{
		!!Configuration "Debug Inlined"
	}
	MalterlibConfigSuffix "DO"
	{
		!!Configuration "Debug Optimized"
	}
	MalterlibConfigSuffix "FC"
	{
		!!Configuration "Fast Compile"
	}
	MalterlibConfigSuffix ""
	{
		!!DocumentationEnabled true
	}

	Malterlib_RefCountDebugging_Enable: bool = false // User(Debug)=true: Set to true to enable shared pointer reference debugging
	Malterlib_RefCountLeakDebugging_Enable: bool = false // User(Debug)=true: Set to true to enable tracing information about shared pointer references when displaying memory leaks. Requires Malterlib_RefCountDebugging_Enable to be enabled as well

	Malterlib_Tests_Enable: bool // User(Tests)=true: Force enable or disable of tests (set to true or false)
	Malterlib_Tests_Enable false
	{
		&
		{
			Malterlib_Tests_Enable undefined
			DebugCode false
			!Tests "Tests"
			!Tests "Perf Tests"
		}
	}
	Malterlib_Tests_Enable true
	{
		!!Malterlib_Tests_Enable undefined
	}

	Malterlib_Contracts_Enable: bool // User(Debug)=false: Force enable or disable of contracts (set to true or false)
	Malterlib_Contracts_Enable false
	{
		&
		{
			Malterlib_Contracts_Enable undefined
			DebugCode false
			!Configuration "Release Testing"
		}
	}
	Malterlib_Contracts_Enable true
	{
		!!Malterlib_Contracts_Enable undefined
	}

	MalterlibMemory_Shims_Enable: bool // User(Debug)=true: Force enable or disable of memory shims (set to true or false). Also used for enabling remote debugger support currently
	MalterlibMemory_Shims_Enable false
	{
		&
		{
			MalterlibMemory_Shims_Enable undefined
			DebugCode false
		}
	}
	MalterlibMemory_Shims_Enable true
	{
		!!MalterlibMemory_Shims_Enable undefined
	}

	MalterlibMemory_Shims_EnableLocal: bool // User(Debug)=false: Enable thread local memory reporters. Used in for example tests to track memory in local scopes
	MalterlibMemory_Shims_EnableLocal false
	{
		&
		{
			MalterlibMemory_Shims_EnableLocal undefined
			DebugCode false
			!Tests "Tests"
		}
	}
	MalterlibMemory_Shims_EnableLocal true
	{
		!!MalterlibMemory_Shims_EnableLocal undefined
	}

	MalterlibMemory_Shims_Lightweight: bool = false // User(Debug)=true: Enable lightweight thread local memory reporters for main memory manager only.
	MalterlibMemory_Shims_EnableGlobal: bool = true // User(Debug)=false: Enable global memory reporter. Used for for example remote debugger support

	MalterlibMemoryManager_Debug: bool = DebugCode // User(Memory Manager)=true: Enable Enable debug memory manager that reports leaks and checks for overwrites. Toggling will recompile everything. (default true in debug configs, false otherwise)
	MalterlibMemoryManager_CrossModule_Enable: bool = true // User(Memory Manager)=false: Enables cross module memory manager that shares the memory manager in all dlls with the executables memory manager
	MalterlibMemoryManager_HugePage_Enable: bool = false // User(Memory Manager)=true: Enables transparent huge page support on Linux
	MalterlibMemoryManager_Stats_Enable: bool = false // User(Memory Manager)=true: Report statistics about memory allocations at the end of the program
	MalterlibMemoryManager_Stats_EnableCategories: bool = false // User(Memory Manager)=true: Dump statistics about memory allocations through categories
	MalterlibMemoryManager_Stats_EnableCallstack: bool = false // User(Memory Manager)=true: Dump statistics about memory allocations callstacks
	MalterlibMemoryManager_System_UseLibC: bool = false // User(Memory Manager)=true: Use LibC for system memory manager. Useful on macOS to track allocs in Instruments

	Malterlib_MacOSDeveloperLocaction: string = "/Applications/Xcode.app/Contents/Developer"
	Malterlib_MacOSDeveloperLocaction "/var/select/developer_dir"->ResolveSymbolicLink()
	{
		&
		{
			Malterlib_MacOSDeveloperLocaction undefined
			"/var/select/developer_dir"->LinkExists() true
		}
	}
	Malterlib_MacOSDeveloperLocaction "/var/db/xcode_select_link"->ResolveSymbolicLink()
	{
		&
		{
			Malterlib_MacOSDeveloperLocaction undefined
			"/var/db/xcode_select_link"->LinkExists() true
		}
	}
	Malterlib_MacOSDeveloperLocaction "/usr/share/xcode-select/xcode_dir_link"->ResolveSymbolicLink()
	{
		&
		{
			Malterlib_MacOSDeveloperLocaction undefined
			"/usr/share/xcode-select/xcode_dir_link"->LinkExists() true
		}
	}
	Malterlib_MacOSDeveloperLocaction "/usr/share/xcode-select/xcode_dir_path"->ResolveSymbolicLink()
	{
		&
		{
			Malterlib_MacOSDeveloperLocaction undefined
			"/usr/share/xcode-select/xcode_dir_path"->LinkExists() true
		}
	}

	Malterlib_DummmyLibrary: string = "/dev/null"
	Malterlib_DummmyLibrary `@(Malterlib_MacOSDeveloperLocaction)/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/lib/libSystem.B.tbd`
	{
		!!PlatformFamily "macOS"
	}
	Malterlib_DummmyLibrary `@(MalterlibSysRoot)/lib/libc.so`
	{
		!!PlatformFamily "Linux"
	}
	Malterlib_DummmyLibrary "kernel32.lib"
	{
		!!PlatformFamily "Windows"
	}
}

