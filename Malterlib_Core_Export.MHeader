Property
{
	MalterlibExportDirectory "@(Builtin.GeneratedBuildSystemDir)/Export/@(Platform)/@(Architecture)/@(FullConfiguration)"
}

%Target "Malterlib_Export"
{
	Target
	{
		FileName "MalterlibExport"
		Type StaticLibrary
	}
	%Dependency "Lib_zlib"
	%Dependency "Lib_Malterlib"
	%Dependency "Lib_Malterlib_Init"
	{
		!!MalterlibNeedsInitProject true
		Dependency.Link false
	}
	%Dependency "Lib_Malterlib_RuntimeABI"
	{
		&
		{
			MalterlibUseStaticLibCxxABI true
			Documentation ""
		}
	}
	%Dependency "Lib_Malterlib_Runtime"
	{
		&
		{
			Documentation ""
			|
			{
				PlatformFamily Windows
				MalterlibUseStaticLibCxx true
			}
		}
		Dependency.LinkWithObjectFiles "false"
	}

	%Group Source
	{
		%Group "C"
		{
			%File "Export/Malterlib_Core_Export_C"
			{
				Compile.Type C
			}
		}
		%Group "C++"
		{
			%File "Export/Malterlib_Core_Export_C++"
			{
				Compile.Type C++
			}
		}
		%Group "ObjC"
		{
			!!PlatformFamily OSX
			%File "Export/Malterlib_Core_Export_ObjC"
			{
				Compile.Type ObjC
			}
		}
		%Group "ObjC++"
		{
			!!PlatformFamily OSX
			%File "Export/Malterlib_Core_Export_ObjC++"
			{
				Compile.Type ObjC++
			}
		}
	}

	Property
	{
		MalterlibExportCompileFlagsTypes "C;C++;@(MalterlibExportCompileFlagsTypes)"
		MalterlibExportCompileFlagsTypes "ObjC;ObjC++;@(MalterlibExportCompileFlagsTypes)"
		{
			!!PlatformFamily OSX
		}
	}

	%GenerateFile "@(MalterlibExportCompileFlagsTypes)"
	{
		Property
		{
			FileFullPath "Export/Malterlib_Core_Export_@(this.Identity)"
			FileFullPath "@(FileFullPath->MakeAbsolute())"
		}
		Property
		{
			CompileFlags_PreprocessorDefines_EntityPath "Target:*.Group:Source.Group:@(this.Identity).File:@(FileFullPath)"
			CompileFlags_PreprocessorDefines_Contents "@(GetProperty('Compile', 'PreprocessorDefines', '@(CompileFlags_PreprocessorDefines_EntityPath)'))"

			CompileFlags_PreprocessorDefines_Template "\"-D@(Explodee->Replace('\"','\\\\\"'))\" "
			{
				&
				{
					!Explodee ""
					Explodee "~*\"*"
					!MalterlibExportSupportQuotes false
				}

			}
			CompileFlags_PreprocessorDefines_Template "\"-D@(Explodee)\" "
			{
				&
				{
					!Explodee ""
					|
					{
						Explodee "~* *"
						Explodee "~*(*"
						Explodee "~*)*"
					}
					!Explodee "~*\"*"
					!MalterlibExportSupportSpaceAndParenthesis false
				}

			}
			CompileFlags_PreprocessorDefines_Template "-D@(Explodee) "
			{
				&
				{
					!Explodee ""
					!
					{
						|
						{
							Explodee "~* *"
							Explodee "~*(*"
							Explodee "~*)*"
							Explodee "~*\"*"
						}
					}
					!Explodee "~*\"*"
				}
			}

			CompileFlags_PreprocessorDefines "@(ExplodeList('@(CompileFlags_PreprocessorDefines_Contents)', ';', 'CompileFlags_PreprocessorDefines_Template'))"
		}
		Property
		{
			CompileFlags_IncludePaths_EntityPath "Target:*.Group:Source.Group:@(this.Identity).File:@(FileFullPath)"
			CompileFlags_IncludePaths_Contents "@(GetProperty('Compile', 'SearchPath', '@(CompileFlags_IncludePaths_EntityPath)'))"

			CompileFlags_IncludePaths_Template "\"-I@(Explodee)\" "
			{
				&
				{
					!Explodee ""
				}

			}

			CompileFlags_IncludePaths "@(ExplodeList('@(CompileFlags_IncludePaths_Contents)', ';', 'CompileFlags_IncludePaths_Template'))"
		}

		Property
		{
			Name "@(MalterlibExportDirectory)/CompileFlags_@(this.Identity).txt"
			Contents "@(CompileFlags_PreprocessorDefines) @(CompileFlags_IncludePaths) \n"
			Executable false
			UnixLineEnds true
			UnicodeBOM false
		}
	}

	%GenerateFile "LDFlags_Dll.txt"
	{
		Property
		{
			LDFlags_EntityPath "Workspace:*.Target:Dll_Malterlib_Export_Dll.Target:Dll_Malterlib_Export_Dll"
			LDFlags_Contents "@(GetProperty('Target', 'LDFlagsFirst', '@(LDFlags_EntityPath)')) @(GetProperty('Target', 'LDFlags', '@(LDFlags_EntityPath)'))"
			LinkWithLibraries_Contents "@(GetProperty('Target', 'RealLinkWithLibraries', '@(LDFlags_EntityPath)'))"
			NeedsOverrideLibrary "@(GetProperty('Property', 'MalterlibNeedsMallocOverrideLibrary', '@(LDFlags_EntityPath)'))"
			OverrideLibrary "@(GetProperty('Property', 'MalterlibOverrideMallocLibrary', '@(LDFlags_EntityPath)'))"
		}
		Property
		{
			Name "@(MalterlibExportDirectory)/@(this.Identity)"
			Contents "@(LDFlags_Contents) \"-L@(MalterlibExportDirectory)/Dll\" -lc++ @(LinkWithLibraries_Contents)"
			Contents "@(Contents) \"@(OverrideLibrary)\""
			{
				!!NeedsOverrideLibrary true
			}
			Contents "@(Contents)\n"
			Executable false
			UnixLineEnds true
			UnicodeBOM false

		}
	}
	%GenerateFile "LDFlags_Exe.txt;LDFlags_MalterlibExe.txt"
	{
		Property
		{
			LDFlags_EntityPath "Workspace:*.Target:Exe_Malterlib_Export_Exe.Target:Exe_Malterlib_Export_Exe"
			LDFlags_Contents "@(GetProperty('Target', 'LDFlagsFirst', '@(LDFlags_EntityPath)')) @(GetProperty('Target', 'LDFlags', '@(LDFlags_EntityPath)'))"
			LinkWithLibraries_Contents "@(GetProperty('Target', 'RealLinkWithLibraries', '@(LDFlags_EntityPath)'))"
			NeedsOverrideLibrary "@(GetProperty('Property', 'MalterlibNeedsMallocOverrideLibrary', '@(LDFlags_EntityPath)'))"
			OverrideLibrary "@(GetProperty('Property', 'MalterlibOverrideMallocLibrary', '@(LDFlags_EntityPath)'))"
		}
		Property
		{
			NoApp_Object "@(MalterlibCompiledFilesSourceBase)/@(Workspace:Workspace.Name)/Intermediate/Exe_Malterlib_Export_NoExe/@(Platform)/@(Architecture)/@(FullConfiguration)/@(MalterlibXcodeObjectsDirectory)/@(MalterlibXcodeBuildArchitecture)/Malterlib_Core_Export_NoExecutable.o"
		}
		Property
		{
			Name "@(MalterlibExportDirectory)/@(this.Identity)"
			Contents "@(LDFlags_Contents) \"-L@(MalterlibExportDirectory)/Exe\" -lc++ @(LinkWithLibraries_Contents)"
			Contents "@(Contents) \"@(OverrideLibrary)\""
			{
				!!NeedsOverrideLibrary true
			}
			Contents "@(Contents) \"@(NoApp_Object)\""
			{
				!this.Identity "LDFlags_MalterlibExe.txt"
			}
			Contents "@(Contents)\n"
			Executable false
			UnixLineEnds true
			UnicodeBOM false
		}
	}
}

%Target "Lib_Malterlib_Export_Exe"
{
	Target
	{
		Name Lib_Malterlib_Export_Exe
		FileName "libc++"
		Type StaticLibrary
	}
	%Dependency "Malterlib_Export=Lib_Malterlib_Export"
	%Dependency "Lib_MalterlibExecutable"

	Property.MalterlibPostBuildScript_Last 	"@(MalterlibPostBuildScript_Last)"\
											"MTool DiffCopy \"@(MalterlibFinalModuleDestination)\" \"@(MalterlibExportDirectory)/Exe\"\r\n"
}

%Target "Lib_Malterlib_Export_Dll"
{
	Target
	{
		Name Lib_Malterlib_Export_Dll
		FileName "libc++"
		Type StaticLibrary
	}
	%Dependency "Malterlib_Export=Lib_Malterlib_Export"
	%Dependency "Lib_MalterlibDll"

	Property.MalterlibPostBuildScript_Last 	"@(MalterlibPostBuildScript_Last)"\
											"MTool DiffCopy \"@(MalterlibFinalModuleDestination)\" \"@(MalterlibExportDirectory)/Dll\"\r\n"
}

%Target "Exe_Malterlib_Export_Exe"
{
	Target
	{
		Name Exe_Malterlib_Export_Exe
		Type ConsoleExecutable
		GenerateScheme true
		{
			!!GeneratorFamily Xcode
		}
	}
	%Dependency "Lib_Malterlib"

	%Group Source
	{
		%File "Export/Malterlib_Core_Export_Executable.cpp"
	}
}

%Target "Exe_Malterlib_Export_NoExe"
{
	Target
	{
		Name Exe_Malterlib_Export_NoExe
		Type ConsoleExecutable
		GenerateScheme true
		{
			!!GeneratorFamily Xcode
		}
	}
	%Dependency "Lib_Malterlib"

	%Group Source
	{
		%File "Export/Malterlib_Core_Export_NoExecutable.cpp"
		%File "Export/Malterlib_Core_Export_NoExecutableMain.cpp"
	}
}

%Target "Dll_Malterlib_Export_Dll"
{
	Target
	{
		Name Dll_Malterlib_Export_Dll
		Type DynamicLibrary
		GenerateScheme true
		{
			!!GeneratorFamily Xcode
		}
	}
	%Dependency "Lib_Malterlib"

	%Group Source
	{
		%File "Export/Malterlib_Core_Export_Executable.cpp"
	}
}

%Workspace "Malterlib_Export"
{
	Property.MalterlibXcodeObjectsDirectory "Objects-normal"

	%Target "Lib_Malterlib_Export_Exe"
	%Target "Lib_Malterlib_Export_Dll"
	%Target "Exe_Malterlib_Export_Exe"
	%Target "Exe_Malterlib_Export_NoExe"
	%Target "Dll_Malterlib_Export_Dll"
}


