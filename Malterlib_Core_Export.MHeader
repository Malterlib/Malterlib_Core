Property
{
	MalterlibExportDirectory: string
	MalterlibExportDirectory `@(Builtin.GeneratedBuildSystemDir)/Export/@(Platform)/@(Architecture)/@(FullConfiguration)`
	{
		!!MalterlibExportDirectory undefined
	}
	MalterlibExportSupportQuotes: bool = true
	MalterlibExportEnable: bool = false // User(Malterlib)=true: Enable malterlib export workspace
}

%Target "Malterlib_Export"
{
	Target
	{
		FileName "MalterlibExport"
		Type "StaticLibrary"
	}
	%Dependency "Lib_zlib"
	%Dependency "Lib_Malterlib"
	%Dependency "Lib_Malterlib_Init"
	{
		!!MalterlibNeedsInitProject true
		Dependency.Link false
	}
	%Dependency "Lib_Malterlib_RuntimeABI"
	{
		&
		{
			MalterlibUseStaticLibCxxABI true
			Documentation undefined
		}
	}
	%Dependency "Lib_Malterlib_Runtime"
	{
		&
		{
			Documentation undefined
			|
			{
				PlatformFamily "Windows"
				MalterlibUseStaticLibCxx true
			}
		}
		Dependency.LinkWithObjectFiles false
	}

	%Group "Source"
	{
		%Group "C"
		{
			%File "Export/Malterlib_Core_Export_C"
			{
				Compile.Type "C"
			}
		}
		%Group "C++"
		{
			%File "Export/Malterlib_Core_Export_C++"
			{
				Compile.Type "C++"
			}
		}
		%Group "ObjC"
		{
			!!PlatformFamily "macOS"
			%File "Export/Malterlib_Core_Export_ObjC"
			{
				Compile.Type "ObjC"
			}
		}
		%Group "ObjC++"
		{
			!!PlatformFamily "macOS"
			%File "Export/Malterlib_Core_Export_ObjC++"
			{
				Compile.Type "ObjC++"
			}
		}
	}

	Property
	{
		MalterlibExportCompileFlagsTypes: [type(CEntity)] = []
		MalterlibExportCompileFlagsTypes =+ ["C", "C++"]
		MalterlibExportCompileFlagsTypes =+ ["ObjC", "ObjC++"]
		{
			!!PlatformFamily "macOS"
		}
	}

	%GenerateFile MalterlibExportCompileFlagsTypes
	{
		Property
		{
			FileFullPath: string = `Export/Malterlib_Core_Export_@(this.Identity)`->MakeAbsolute()
			EntityPath: string = `Target:*.Group:Source.Group:@(this.Identity)."File:@(FileFullPath)"`
		}
		Property
		{
			CompileFlags_PreprocessorDefines_Template function(string _Define) string
			CompileFlags_PreprocessorDefines_Template += `@(`-D@(_Define)`->Escape()) `
			{
				&
				{
					|
					{
						_Define ~"*\"*"
						_Define ~"* *"
						_Define ~"*(*"
						_Define ~"*)*"
					}
					MalterlibExportSupportQuotes true
				}

			}
			CompileFlags_PreprocessorDefines_Template += `-D@(_Define) `
			{
				!
				{
					|
					{
						_Define ~"*\"*"
						_Define ~"* *"
						_Define ~"*(*"
						_Define ~"*)*"
					}
				}
			}

			CompileFlags_PreprocessorDefines: string = GetProperty(&Compile.PreprocessorDefines, EntityPath, {Compile.Type: "C++"})->ForEach(&CompileFlags_PreprocessorDefines_Template)
		}
		Property
		{
			CompileFlags_IncludePaths_Template function(string _Path) string
			CompileFlags_IncludePaths_Template += `@(`-I@(_Path)`->Escape()) `

			CompileFlags_IncludePaths: string = GetProperty(&Compile.SearchPath, EntityPath, {Compile.Type: "C++"})->ForEach(&CompileFlags_IncludePaths_Template)
		}

		GenerateFile
		{
			Name `@(MalterlibExportDirectory)/CompileFlags_@(this.Identity).txt`
			Contents `@(CompileFlags_PreprocessorDefines) @(CompileFlags_IncludePaths) \n`
			Executable false
			UnixLineEnds true
			UnicodeBOM false
		}
	}

	%GenerateFile "LDFlags_Dll.txt"
	{
		Property
		{
			LDFlags_EntityPath: string = "Workspace:*.Target:Dll_Malterlib_Export_Dll.Target:Dll_Malterlib_Export_Dll"
			LDFlags_Contents: string = ""
			LDFlags_Contents fg_RecursiveStringArrayToCommandLine(
				Concat(
					GetProperty(&Target.LDFlagsFirst, LDFlags_EntityPath, {Compile.Type: "C++"})
					, GetProperty(&Target.LDFlags, LDFlags_EntityPath, {Compile.Type: "C++"})
				)
			)
			{
				|
				{
					PlatformFamily "macOS"
					PlatformFamily "Linux"
				}
			}
			
			LinkWithLibraries_Contents: string?
			LinkWithLibraries_Contents fg_RecursiveStringArrayToCommandLine(
				Concat(
					GetProperty(&Target.LinkWithLibraries, LDFlags_EntityPath, {Compile.Type: "C++"})
				)
			)
			{
				!GetProperty(&Target.LinkWithLibraries, LDFlags_EntityPath, {Compile.Type: "C++"}) undefined
			}

			NeedsOverrideLibrary: bool = GetProperty(&MalterlibNeedsMallocOverrideLibrary, LDFlags_EntityPath, {Compile.Type: "C++"})
			OverrideLibrary: string = GetProperty(&MalterlibOverrideMallocLibrary, LDFlags_EntityPath, {Compile.Type: "C++"})
		}
		GenerateFile
		{
			Name `@(MalterlibExportDirectory)/@(this.Identity)`
			Contents `@(LDFlags_Contents) "-L@(MalterlibExportDirectory)/Dll" -lc++`
			Contents =+ ` @(LinkWithLibraries_Contents)`
			{
				!LinkWithLibraries_Contents undefined
			}
			Contents += `"@(OverrideLibrary)" `
			{
				!!NeedsOverrideLibrary true
			}
			Contents =+ "\n"
			Executable false
			UnixLineEnds true
			UnicodeBOM false
		}
	}
	%GenerateFile ["LDFlags_Exe.txt", "LDFlags_MalterlibExe.txt"]
	{
		Property
		{
			LDFlags_EntityPath: string = "Workspace:*.Target:Exe_Malterlib_Export_Exe.Target:Exe_Malterlib_Export_Exe"
			LDFlags_Contents: string = ""
			LDFlags_Contents fg_RecursiveStringArrayToCommandLine(
				Concat(
					GetProperty(&Target.LDFlagsFirst, LDFlags_EntityPath, {Compile.Type: "C++"})
					, GetProperty(&Target.LDFlags, LDFlags_EntityPath, {Compile.Type: "C++"})
				)
			)
			{
				|
				{
					PlatformFamily "macOS"
					PlatformFamily "Linux"
				}
			}

			LinkWithLibraries_Contents: string?
			LinkWithLibraries_Contents fg_RecursiveStringArrayToCommandLine(
				Concat(
					GetProperty(&Target.LinkWithLibraries, LDFlags_EntityPath, {Compile.Type: "C++"})
				)
			)
			{
				!GetProperty(&Target.LinkWithLibraries, LDFlags_EntityPath, {Compile.Type: "C++"}) undefined
			}
			NeedsOverrideLibrary: bool = GetProperty(&MalterlibNeedsMallocOverrideLibrary, LDFlags_EntityPath, {Compile.Type: "C++"})
			OverrideLibrary: string = GetProperty(&MalterlibOverrideMallocLibrary, LDFlags_EntityPath, {Compile.Type: "C++"})
		}
		Property
		{
			NoApp_Object: string =`@(MalterlibCompiledFilesWarkspaceBase)/Int/Exe_Malterlib_Export_NoExe/@(Platform)/@(Architecture)/@(FullConfiguration)/@(MalterlibXcodeObjectsDirectory)/@(MalterlibXcodeBuildArchitecture)/Malterlib_Core_Export_NoExecutable.o`
		}
		GenerateFile
		{
			Name `@(MalterlibExportDirectory)/@(this.Identity)`
			Contents `@(LDFlags_Contents) "-L@(MalterlibExportDirectory)/Exe" -lc++`
			Contents =+ ` @(LinkWithLibraries_Contents)`
			{
				!LinkWithLibraries_Contents undefined
			}
			Contents += ` "@(OverrideLibrary)"`
			{
				!!NeedsOverrideLibrary true
			}
			Contents =+ ` @(NoApp_Object->EscapeBash())`
			{
				!this.Identity "LDFlags_MalterlibExe.txt"
			}
			Contents =+ "\n"
			Executable false
			UnixLineEnds true
			UnicodeBOM false
		}
	}
}

%Target "Lib_Malterlib_Export_Exe"
{
	Target
	{
		Name "Lib_Malterlib_Export_Exe"
		FileName "libc++"
		Type "StaticLibrary"
	}
	%Dependency {Name: "Lib_Malterlib_Export", Properties: {Dependency.Target: "Malterlib_Export"}}
	%Dependency "Lib_MalterlibExecutable"

	Property.MalterlibPostBuildScript_Last =+ `MTool DiffCopy "@(MalterlibFinalModuleDestination)" "@(MalterlibExportDirectory)/Exe"\r\n`
}

%Target "Lib_Malterlib_Export_Dll"
{
	Target
	{
		Name "Lib_Malterlib_Export_Dll"
		FileName "libc++"
		Type "StaticLibrary"
	}
	%Dependency {Name: "Lib_Malterlib_Export", Properties: {Dependency.Target: "Malterlib_Export"}}
	%Dependency "Lib_MalterlibDll"

	Property.MalterlibPostBuildScript_Last =+ `MTool DiffCopy "@(MalterlibFinalModuleDestination)" "@(MalterlibExportDirectory)/Dll"\r\n`
}

%Target "Exe_Malterlib_Export_Exe"
{
	Target
	{
		Name "Exe_Malterlib_Export_Exe"
		Type "ConsoleExecutable"
		GenerateScheme true
		{
			!!GeneratorFamily "Xcode"
		}
	}
	%Dependency "Lib_Malterlib"

	%Group "Source"
	{
		%File "Export/Malterlib_Core_Export_Executable.cpp"
	}
}

%Target "Exe_Malterlib_Export_NoExe"
{
	Target
	{
		Name "Exe_Malterlib_Export_NoExe"
		Type "ConsoleExecutable"
		GenerateScheme true
		{
			!!GeneratorFamily "Xcode"
		}
	}
	%Dependency "Lib_Malterlib"

	%Group "Source"
	{
		%File "Export/Malterlib_Core_Export_NoExecutable.cpp"
		%File "Export/Malterlib_Core_Export_NoExecutableMain.cpp"
	}
}

%Target "Dll_Malterlib_Export_Dll"
{
	Target
	{
		Name "Dll_Malterlib_Export_Dll"
		Type "DynamicLibrary"
		GenerateScheme true
		{
			!!GeneratorFamily "Xcode"
		}
	}
	%Dependency "Lib_Malterlib"

	%Group "Source"
	{
		%File "Export/Malterlib_Core_Export_Executable.cpp"
	}
}

%Workspace "Malterlib_Export"
{
	!!MalterlibExportEnable true
	
	Property.MalterlibXcodeObjectsDirectory "Objects-normal"

	%Target "Lib_Malterlib_Export_Exe"
	%Target "Lib_Malterlib_Export_Dll"
	%Target "Exe_Malterlib_Export_Exe"
	%Target "Exe_Malterlib_Export_NoExe"
	%Target "Dll_Malterlib_Export_Dll"
}

