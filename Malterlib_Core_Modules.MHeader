Import "Malterlib_Core_RepositoryModules.MHeader"

Property.MalterlibModules "Atomic;Algorithm;Bit;BuildSystem;Cloud;CommandLine;Compression;Concurrency;Container;Contract;CrashReport;Cryptography;Daemon;Database;Debug;Desktop;Documentation;Encoding;Exception;File;Function;Graphics;Instrumentation;InterProcess;Intrusive;Iterator;Log;Memory;Meta;Mongo;Network;Numeric;Perforce;Preprocessor;Process;SQL;STL;Security;Storage;Stream;String;System;Test;Thread;Time;Type;Web;WebApp;XML;@(Property.MalterlibModules)"

%Repository "MalterlibSDK"
{
	!MalterlibUseGitRepo false
	Property.RepoName "@(this.Identity).git"
	Repository
	{
		Type "Malterlib"
		Location "@('../../SDK'->MakeAbsolute())"
		URL "@(Repository.MalterlibRoot)/@(RepoName)"
		Remotes "@(ExplodeList('@(MalterlibRemotePrefixes)', ';', 'MalterlibRemotePrefixesTemplate'));@(Repository.Remotes)"
		{
			!MalterlibRemotePrefixes  ""
		}
		Remotes "malterlib=https://github.com/Malterlib/MalterlibSDK.git@(MalterlibUpstreamWritableHelper);@(Repository.Remotes)"
		{
			&
			{
				MalterlibUpstreamAccess true
				!Repository.URL "https://github.com/Malterlib/@(RepoName)"
			}
		}
	}
}

Property
{
	MalterlibSharedBinariesRoot "@(MalterlibDependenciesDirectory)/Binaries"
}

Property
{
	MalterlibBinarySDKRepositories "MalterlibBinariesSDK_Linux_x64;@(MalterlibBinarySDKRepositories)"
	{
		&
		{
			EnablePlatform_Linux2_6 true
			EnableArchitecture_x64 true
		}
	}
	MalterlibBinarySDKRepositories "MalterlibBinariesSDK_Linux_x86;@(MalterlibBinarySDKRepositories)"
	{
		&
		{
			EnablePlatform_Linux2_6 true
			EnableArchitecture_x86 true
		}
	}

	MalterlibAllBinarySDKRepositories false // User(Repository)=true: Set to true to sync all binary SDK repositories.
	{
		!!MalterlibAllBinarySDKRepositories ""
	}
}

Property
{
	!!MalterlibAllBinarySDKRepositories true

	MalterlibBinarySDKRepositories "MalterlibBinariesSDK_Linux_x64;@(MalterlibBinarySDKRepositories)"
	MalterlibBinarySDKRepositories "MalterlibBinariesSDK_Linux_x86;@(MalterlibBinarySDKRepositories)"
}

%Repository "@(MalterlibBinarySDKRepositories)"
{
	Property
	{
		RepoName "@(this.Identity).git"
		RepoPlatformFamily "@(this.Identity->ParseFormatString('{}_{}_{}', '{1}'))"
		RepoArchitecture "@(this.Identity->ParseFormatString('{}_{}_{}', '{2}'))"
		RepoDir "../../Binaries/MalterlibSDK/@(RepoPlatformFamily)/@(RepoArchitecture)"
	}
	Repository
	{
		Type "Malterlib"
		Location "@(RepoDir->MakeAbsolute())"
		URL "@(Repository.MalterlibRoot)/@(RepoName)"
		Remotes "@(ExplodeList('@(MalterlibRemotePrefixes)', ';', 'MalterlibRemotePrefixesTemplate'));@(Repository.Remotes)"
		{
			!MalterlibRemotePrefixes  ""
		}
		Remotes "malterlib=https://github.com/Malterlib/@(RepoName)@(MalterlibUpstreamWritableHelper);@(Repository.Remotes)"
		{
			&
			{
				MalterlibUpstreamAccess true
				!Repository.URL "https://github.com/Malterlib/@(RepoName)"
			}
		}
	}
}
