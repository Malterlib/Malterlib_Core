Import "Malterlib_Core_RepositoryModules.MHeader"

Property.MalterlibModules =+ [
	"Atomic"
	, "Algorithm"
	, "Bit"
	, "BuildSystem"
	, "Cloud"
	, "CommandLine"
	, "Compression"
	, "Concurrency"
	, "Container"
	, "Contract"
	, "CrashReport"
	, "Cryptography"
	, "Daemon"
	, "Database"
	, "Debug"
	, "Desktop"
	, "Documentation"
	, "Encoding"
	, "Exception"
	, "File"
	, "Function"
	, "Graphics"
	, "Instrumentation"
	, "InterProcess"
	, "Intrusive"
	, "Iterator"
	, "Log"
	, "Memory"
	, "Meta"
	, "WebApp"
	, "Mongo"
	, "Network"
	, "Numeric"
	, "Perforce"
	, "Preprocessor"
	, "Process"
	, "SQL"
	, "STL"
	, "Security"
	, "Storage"
	, "Stream"
	, "String"
	, "System"
	, "Test"
	, "Thread"
	, "Time"
	, "Type"
	, "Web"
	, "XML"
]

Property
{
	MalterlibBinarySDKRepositories define [string] = []
}

Property
{
	MalterlibBinarySDKRepositories =+ "MalterlibBinariesSDK_Linux_x64"
	{
		&
		{
			EnablePlatform_Linux true
			EnableArchitecture_x64 true
		}
	}
	MalterlibBinarySDKRepositories =+ "MalterlibBinariesSDK_Linux_arm64"
	{
		&
		{
			EnablePlatform_Linux true
			EnableArchitecture_arm64 true
		}
	}
	MalterlibBinarySDKRepositories =+ "MalterlibBinariesSDK_Linux_x86"
	{
		&
		{
			EnablePlatform_Linux true
			EnableArchitecture_x86 true
		}
	}

	MalterlibAllBinarySDKRepositories define bool = false // User(Repository)=true: Set to true to sync all binary SDK repositories.
}

Property
{
	!!MalterlibAllBinarySDKRepositories true

	MalterlibBinarySDKRepositories =+ "MalterlibBinariesSDK_Linux_x64"
	MalterlibBinarySDKRepositories =+ "MalterlibBinariesSDK_Linux_x86"
	MalterlibBinarySDKRepositories =+ "MalterlibBinariesSDK_Linux_arm64"
}

%Repository MalterlibBinarySDKRepositories->Unique()
{
	Property
	{
		RepoName define string = `@(this.Identity).git`
		RepoPlatformFamily define string = `@(this.Identity->ParseFormatString("{}_{}_{}", "{1}"))`
		RepoArchitecture define string = `@(this.Identity->ParseFormatString("{}_{}_{}", "{2}"))`
		RepoDir define string = `../../Binaries/MalterlibSDK/@(RepoPlatformFamily)/@(RepoArchitecture)`
	}
	Repository
	{
		Type "Malterlib"
		Location RepoDir->MakeAbsolute()
		URL `@(Repository.MalterlibRoot)/@(RepoName)`
		Remotes =+ MalterlibRemotePrefixes->ForEach("f_MalterlibRemotePrefixesTemplate")
		{
			!MalterlibRemotePrefixes undefined
		}
		Remotes =+ {Name: "malterlib", URL: `https://github.com/Malterlib/@(RepoName)`, Write: MalterlibUpstreamWriteAccess}
		{
			&
			{
				MalterlibUpstreamAccess true
				!Repository.URL `https://github.com/Malterlib/@(RepoName)`
			}
		}
	}
}
