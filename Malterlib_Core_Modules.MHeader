Import "Malterlib_Core_RepositoryModules.MHeader"

Property.MalterlibModules "Tools;Atomic;Algorithm;Bit;BuildSystem;Cloud;CommandLine;Compression;Concurrency;Container;Contract;CrashReport;Cryptography;Daemon;Database;Debug;Desktop;Documentation;Encoding;Exception;File;Function;Graphics;Instrumentation;InterProcess;Intrusive;Iterator;Log;Memory;Meta;Meteor;Mongo;Network;Numeric;Perforce;Preprocessor;Process;SQL;STL;Security;Storage;Stream;String;System;Test;Thread;Time;Type;Web;XML;@(Property.MalterlibModules)"

%Repository "MalterlibSDK"
{
	!MalterlibUseGitRepo false
	Property.RepoName "@(this.Identity).git"
	Repository
	{
		Type Malterlib
		Location "@('../../SDK'->MakeAbsolute())"
		URL "@(Repository.MalterlibRoot)/@(RepoName)"
		Remotes "@(ExplodeList('@(MalterlibRemotePrefixes)', ';', 'MalterlibRemotePrefixesTemplate'));@(Repository.Remotes)"
		{
			!MalterlibRemotePrefixes  ""
		}
		Remotes "malterlib=https://github.com/Malterlib/MalterlibSDK.git;@(Repository.Remotes)"
		{
			&
			{
				MalterlibUpstreamAccess true
				!Repository.URL "https://github.com/Malterlib/@(RepoName)"
			}
		}
	}
}

%Repository "MalterlibBinaries_Linux"
{
	!!EnablePlatform_Linux2_6 true
	
	Property.RepoName "@(this.Identity).git"
	Repository
	{
		Type Malterlib
		Location "@('../../Binaries/Malterlib_Linux'->MakeAbsolute())"
		URL "@(Repository.MalterlibRoot)/@(RepoName)"
		Remotes "@(ExplodeList('@(MalterlibRemotePrefixes)', ';', 'MalterlibRemotePrefixesTemplate'));@(Repository.Remotes)"
		{
			!MalterlibRemotePrefixes  ""
		}
		Remotes "malterlib=https://github.com/Malterlib/MalterlibBinaries_Linux.git;@(Repository.Remotes)"
		{
			&
			{
				MalterlibUpstreamAccess true
				!Repository.URL "https://github.com/Malterlib/@(RepoName)"
			}
		}
	}
}
