Import "Malterlib_Core_RepositoryModules.MHeader"

Property
{
	MalterlibEnableOptonalModules: bool = false // User(Repository)=true: Enable extra optional Malterlib modules

	MalterlibOptionalModules: [string] = []
}

Property.MalterlibOptionalModules =+ [
	"BuildSystem"
	, "Cloud"
	, "Git"
	, "Instrumentation"
	, "InterProcess"
	, "Mongo"
	, "Perforce"
	, "SQL"
	, "Tool"
	, "WebApp"
]

Property.MalterlibModules =+ [
	"Atomic"
	, "Bit"
	, "CommandLine"
	, "Compression"
	, "Concurrency"
	, "Container"
	, "Contract"
	, "CrashReport"
	, "Cryptography"
	, "Daemon"
	, "Database"
	, "Debug"
	, "Desktop"
	, "Documentation"
	, "Encoding"
	, "Exception"
	, "File"
	, "Function"
	, "Graphics"
	, "Intrusive"
	, "Log"
	, "Memory"
	, "Meta"
	, "Network"
	, "Numeric"
	, "Preprocessor"
	, "Process"
	, "Security"
	, "Storage"
	, "Stream"
	, "String"
	, "System"
	, "Test"
	, "Thread"
	, "Time"
	, "Type"
	, "Web"
	, "XML"
]

Property.MalterlibModules =+ MalterlibOptionalModules
{
	!!MalterlibEnableOptonalModules true
}

Property
{
	MalterlibBinarySDKRepositories: [string] = []
}

Property
{
	MalterlibBinarySDKRepositories =+ "MalterlibBinariesSDK_Linux_Ubuntu_x64"
	{
		&
		{
			EnablePlatform_Linux true
			EnableArchitecture_x64 true
		}
	}
	MalterlibBinarySDKRepositories =+ "MalterlibBinariesSDK_Linux_Ubuntu_arm64"
	{
		&
		{
			EnablePlatform_Linux true
			EnableArchitecture_arm64 true
		}
	}
	MalterlibBinarySDKRepositories =+ "MalterlibBinariesSDK_Linux_Debian_x86"
	{
		&
		{
			EnablePlatform_Linux true
			EnableArchitecture_x86 true
		}
	}

	MalterlibAllBinarySDKRepositories: bool = false // User(Repository)=true: Set to true to sync all binary SDK repositories.
	MalterlibSourceRepositories: bool = false // User(Repository)=true: Set to true to sync source SDK repositories.
}

Property
{
	!!MalterlibAllBinarySDKRepositories true

	MalterlibBinarySDKRepositories =+ "MalterlibBinariesSDK_Linux_Ubuntu_x64"
	MalterlibBinarySDKRepositories =+ "MalterlibBinariesSDK_Linux_Ubuntu_arm64"
	MalterlibBinarySDKRepositories =+ "MalterlibBinariesSDK_Linux_Debian_x86"
}

Property
{
	!!MalterlibSourceRepositories true

	MalterlibBinarySDKRepositories =+ "MalterlibBinariesSDK_Linux_DebianBased_Source"
}

%Repository MalterlibBinarySDKRepositories->Unique()
{
	Property
	{
		MalterlibRepoName `@(this.Identity).git`
		MalterlibRepoName `@(this.Identity)_rLFS.git`
		{
			!!MalterlibBinaryRepositoriesUseReleaseLFSStore true
		}
		RepoPlatformFamily: string = `@(this.Identity->ParseFormatString("{}_{}_{}_{}", "{1}"))`
		RepoVariant: string = `@(this.Identity->ParseFormatString("{}_{}_{}_{}", "{2}"))`
		RepoArchitecture: string = `@(this.Identity->ParseFormatString("{}_{}_{}_{}", "{3}"))`
		RepoDir: string = `../../Binaries/MalterlibSDK/@(RepoPlatformFamily)/@(RepoVariant)/@(RepoArchitecture)`
	}
	Repository
	{
		Type "Malterlib"
		GitIgnoreType "GitIgnore"
		Location RepoDir->MakeAbsolute()
		URL `@(Repository.MalterlibRoot)/@(MalterlibRepoName)`
		Remotes =+ MalterlibRemotePrefixes->ForEach(&f_MalterlibRemotePrefixesTemplate)
		{
			!MalterlibRemotePrefixes undefined
		}
		Remotes =+ {Name: "malterlib", URL: `https://github.com/Malterlib/@(MalterlibRepoName)`, Write: MalterlibUpstreamWriteAccess}
		{
			&
			{
				MalterlibUpstreamAccess true
				!Repository.URL `https://github.com/Malterlib/@(MalterlibRepoName)`
			}
		}
		LfsReleaseStore MalterlibBinaryRepositoriesUseReleaseLFSStore
	}
}
