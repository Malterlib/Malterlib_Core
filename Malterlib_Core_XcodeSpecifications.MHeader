%Group "~Automatic/Xcode Specifications"
{
	Property
	{
		FullPath define string
		HOME define string
		
		g_DSStoreName define string = ".DS_Store"

		XcodeSpecificationsDir define string = `@(HOME)/Library/Application Support/Developer/Shared/Xcode/Specifications`
		SpecificationsRoot define string = "Build/Xcode/Specifications"->MakeAbsolute()

		RelativePath function(string _File) string
		RelativePath _File->MakeRelative(SpecificationsRoot)

		ConvertToEntity function(string _File) [type(CEntity)]
		ConvertToEntity	=+ {
			Name: `@(XcodeSpecificationsDir)/@(RelativePath(_File))`
			, Properties: {
				RelativePath: RelativePath(_File)
				, FullPath: _File
			}
		}
		{
			&
			{
				!g_DSStoreName _File->GetFile()
			}
		}
	}

	%GenerateFile SpecificationsRoot->FindFilesRecursiveIn("*")->ForEach("ConvertToEntity")
	{
		Compile.Type "None"
		GenerateFile
		{
			Name this.Identity
			Contents ReadFile(FullPath)
			Executable false
			UnixLineEnds true
			UnicodeBOM false
			Group RelativePath->GetPath()
		}
	}
}
