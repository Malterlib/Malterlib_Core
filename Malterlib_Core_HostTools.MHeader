Property
{
	MalterlibHostTools: [type(CEntity)] = []
}

%Workspace "HostTools"
{
	!!MalterlibHostToolsBuildSystem true

	Property.MalterlibPostCopyProject "Binaries"
	{
		!!TargetIsExecutable true
	}

	%Group "Tools"
	{
		%Target MalterlibHostTools
	}
}

Property
{
	HostToolsTargets: [string]? // The host tools that a Tool target builds, as a group, in the build system of host tools

	// The environment of builds of host tools, which ninja copies from its own: what every build copies and what programs
	// need on a host, without the settings meant for the build that runs them
	MalterlibHostToolsCopiedEnvironmentVariables: [string] = []
	MalterlibHostToolsCopiedEnvironmentVariables =+ BuildSystemCopiedEnvironmentVariables
	MalterlibHostToolsCopiedEnvironmentVariables =+ [
		"PATH"
		, "HOME"
		, "USER"
		, "LOGNAME"
		, "SHELL"
		, "LANG"
		, "LC_ALL"
		, "LC_CTYPE"
		, "TZ"
		, "DEVELOPER_DIR"
	]
	// A build that leaves out the global user settings leaves them out of its host tools too
	MalterlibHostToolsCopiedEnvironmentVariables =+ ["MalterlibDisableGlobalUserSettings"]
	MalterlibHostToolsCopiedEnvironmentVariables =+ [
		"SystemRoot"
		, "SystemDrive"
		, "windir"
		, "ComSpec"
		, "PATHEXT"
		, "USERPROFILE"
		, "USERNAME"
		, "USERDOMAIN"
		, "COMPUTERNAME"
		, "HOMEDRIVE"
		, "HOMEPATH"
		, "APPDATA"
		, "LOCALAPPDATA"
		, "ProgramData"
		, "ProgramFiles"
		, "ProgramFiles(x86)"
		, "ProgramW6432"
		, "CommonProgramFiles"
		, "CommonProgramFiles(x86)"
		, "CommonProgramW6432"
		, "NUMBER_OF_PROCESSORS"
		, "PROCESSOR_ARCHITECTURE"
		, "PROCESSOR_IDENTIFIER"
		, "OS"
		, "MSYSTEM"
	]
	{
		!!HostPlatformFamily "Windows"
	}

	// Bash commands, appended with &&, that unset the exported variables that are not in
	// MalterlibHostToolsCopiedEnvironmentVariables, for ninjas before MToolVersion 6 and generators that cannot replace the
	// environment of a command. Bash cannot unset variables whose names are not identifiers, as the ProgramFiles(x86) of
	// Windows, so those stay
	MalterlibHostToolsClearEnvironment: string = ""
	MalterlibHostToolsClearEnvironment ` && for Variable in $(compgen -e); do`\
		` case " @(MalterlibHostToolsCopiedEnvironmentVariables->Join(" ")) " in *" $Variable "*) ;; *) unset "$Variable" 2>/dev/null || true;; esac;`\
		` done`
	{
		!!(MToolVersion < 6 || GeneratorFamily != "Ninja") true
	}

	// A Bash command. It generates the host tools from an environment of their own: only the variables of
	// MalterlibHostToolsCopiedEnvironmentVariables, which ninja copies from its own environment and the command keeps itself, so
	// that the settings meant for the build that runs it stay out. Their build system does not generate itself
	// (MalterlibDisableBuildSystemGeneration), so the build that follows does not generate again. The host tools are built for
	// the host whatever configuration that build builds, so the settings that select a configuration or disable its generation
	// are not passed on. The build system file is, since a checkout can have several. It waits for another generation or build
	// of host tools also when no ninja runs it. The two are locked apart, so two builds with different environments that run it
	// at once can build what the other generated, which is left as is, as the host tools come out the same
	MalterlibHostToolsBuildCommand: string = `cd "@(Builtin.BasePathAbsolute)"@(MalterlibHostToolsClearEnvironment)`\
		` && export Malterlib_BuildSystem="@(Builtin.BuildSystemSourceAbsolute)"`\
		` && ./mib generate@(MalterlibGenerateWaitForLock) --build-system "@(Builtin.BuildSystemSourceAbsolute)" --generator Ninja`\
		` --output-directory "@(MalterlibHostToolsBuildSystemDir)" --no-use-cached-environment --skip-update --no-signal-changed HostTools`\
		` && ./mib build-target --wait-for-lock --output-directory "@(MalterlibHostToolsBuildSystemDir)" HostTools "@(HostToolsTargets->Join(","))"`
}

// A build of host tools is a no-op when they have not changed, and restat leaves what runs them alone then
Target
{
	&
	{
		Target.Type "Tool"
		!HostToolsTargets undefined
	}

	CommandLine_Build MalterlibHostToolsBuildCommand
	CommandLine_Pool "HostToolsPool"
	CommandLine_TargetEnvironment false
	CommandLine_Environment {Copy: MalterlibHostToolsCopiedEnvironmentVariables, Set: {}}
	{
		!!(MToolVersion >= 6) true
	}
}

// Visual Studio runs the commands of tools with cmd.exe
Target
{
	&
	{
		Target.Type "Tool"
		!HostToolsTargets undefined
		!BashScriptPrefix ""
	}

	CommandLine_Build `@(BashScriptPrefix)-c @(MalterlibHostToolsBuildCommand->EscapeWindows())`
}
