%Group "~Automatic/Include Roots"
{
	Property
	{
		g_DSStoreName: string = ".DS_Store"
		Root: string
		ExpandTemplate2 function(string _Path) [type(CEntity)] = []
		ExpandTemplate2	=+ {
			Name: `@(MalterlibIncludeOutputDir)/@(_Path->MakeRelative(Root))`
			, Properties: {
				RelativePath: _Path->MakeRelative(Root)
				, FullPath: _Path
			}
		}
		{
			&
			{
				!undefined _Path
				!g_DSStoreName _Path->GetFile()
			}
		}
		ExpandTemplate function(string _Root) [type(CEntity)] = []
		ExpandTemplate =+ _Root->FindFilesRecursiveIn("*")->ForEach(&ExpandTemplate2, {Root: _Root})
		{
			!_Root undefined
		}
	}

	%GenerateFile MalterlibIncludeRoots->ForEach(&ExpandTemplate)
	{
		Compile.Type "Header"
		GenerateFile
		{
			Name this.Identity
			Contents `#include @(FullPath->Escape())\n`
			Executable false
			UnixLineEnds true
			UnicodeBOM true
			Group `@(Platform) @(Architecture) @(FullConfiguration)/@(RelativePath->GetPath())`
			{
				!!MalterlibIncludePerConfig true
			}
			Group RelativePath->GetPath()
			{
				!MalterlibIncludePerConfig true
			}
		}
	}
}

Property
{
	MalterlibLibrary_All: bool = true // Default to all functionality being included in the library
	MalterlibIncludeLevel: one_of("Workspace", "Target") = "Workspace" // These too will cause performance issues if changed
	MalterlibIncludePerConfig: bool = false // These too will cause performance issues if changed

	MalterlibIncludeOutputDir: string = `@(GeneratedDirectory)RootInclude`
	MalterlibIncludeOutputDir `@(GeneratedDirectoryNoConfig)RootInclude`
	{
		&
		{
			MalterlibIncludeLevel "Target"
			!MalterlibIncludePerConfig true
		}

	}
	MalterlibIncludeOutputDir `@(GeneratedWorkspaceDirectory)RootInclude`
	{
		&
		{
			MalterlibIncludeLevel "Workspace"
			MalterlibIncludePerConfig true
		}
	}
	MalterlibIncludeOutputDir `@(GeneratedWorkspaceDirectoryNoConfig)RootInclude`
	{
		&
		{
			MalterlibIncludeLevel "Workspace"
			!MalterlibIncludePerConfig true
		}
	}
}

Property
{
	MalterlibMemoryManager_EnableOverrideSystemMalloc: bool = false
	MalterlibMemoryManager_EnableOverrideSystemMalloc true
	{
		&
		{
			MalterlibMemoryManager_OverrideSystemMalloc true
			|
			{
				!MalterlibMemoryManager "System"
				PlatformFamily "Windows"
			}
			!
			{
				&												// Disable for dynamic libraries on Linux and macOS as only main executable should override malloc
				{
					MalterlibDynamicLibrary true
					|
					{
						PlatformFamily "Linux"
						PlatformFamily "macOS"
					}
				}
			}
		}
	}
}

