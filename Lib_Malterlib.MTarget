Property
{
	MalterlibNeedsInitProject true
	{
		!!PlatformType "Unix"
	}
}

%Target "Lib_Malterlib_Init"
{
	&
	{
		MalterlibNeedsInitProject  true
		!MalterlibDefaultToolset true
	}
	Property.DocumentationModule Malterlib
	Property.MalterlibNoShortcuts true	

	Property.MalterlibConcurrency_DistributedActors true
	{
		!MalterlibConcurrency_DistributedActorsInAnyTarget ""
	}
	
	Target
	{
		BaseName "Malterlib_Init"
		Type "StaticLibrary"
		Group "Libraries/Malterlib"
	}
	Compile
	{
		!!CompileDialect "C"
		PrefixHeader ""
	}
	%Group Source
	{
		%Group Runtime
		{
			%Group Runtimes
			{
				%Group MacOSX
				{
					%File Source/Platform/Malterlib_Core_PlatformImp_Posix_Init.cpp
				}
			}
		}
	}
}

%Group "~Automatic/Init Early"
{
	%File Source/Platform/Malterlib_Core_PlatformImp_Posix_Init.cpp
	{
		Compile.InitEarly true
	}
}

Target.ExtraGroups "~Automatic/Init Early;@(Target.ExtraGroups)"
{
	&
	{
		MalterlibNeedsInitProject  true
		MalterlibDefaultToolset true
		TargetIsExecutable true
		!MalterlibDisableMalterlib true
	}
}

%Target "Lib_Malterlib_Runtime2"
{
	Property.MalterlibNoShortcuts true	
	Property.DocumentationModule Malterlib
	Target
	{
		BaseName "Malterlib_Runtime2"
		Type "StaticLibrary"
		Group "Libraries/Malterlib"
	}
	Compile
	{
		!!CompileDialect "C"
		PrefixHeader ""
		SearchPath "@(Builtin.BasePath)/External/elftoolchain/libelf;@(Builtin.BasePath)/External/elftoolchain/common;@(Compile.SearchPath)"
		{
			!!PlatformFamily "Linux"
		}
	}
	Property.MalterlibConcurrency_DistributedActors true
	{
		!MalterlibConcurrency_DistributedActorsInAnyTarget ""
	}
	%Group "Source"
	{
		Compile
		{
			!!MalterlibCompileSupportTabSetings true
			IndentWidth 2
			TabWidth 2
			UsesTabs false
		}
		%Group compiler-rt
		{
			&
			{
				MalterlibUseStaticLibCxxABI true
				|
				{
					PlatformFamily OSX
					PlatformFamily Emscripten
				}
			}
			%File "../../External/compiler-rt/lib/builtins/*.c"
			%File "../../External/compiler-rt/lib/builtins/*.h"
			%Group x86
			{
				!!Architecture x86
				//%File "../../SDK/compiler-rt/lib/builtins/i386/*.c"
				%File "../../External/compiler-rt/lib/builtins/i386/*.S"
			}
			%Group x64
			{
				!!Architecture x64
				%File "../../External/compiler-rt/lib/builtins/x86_64/*.c"
				%File "../../External/compiler-rt/lib/builtins/x86_64/*.S"
			}
			%Group ppc
			{
				!!Architecture ppc32
				!!Architecture ppc64
				%File "../../External/compiler-rt/lib/builtins/ppc/*.c"
				%File "../../External/compiler-rt/lib/builtins/ppc/*.S"
			}
		}
	}
}

%Target "Lib_Malterlib_Runtime"
{
	Property
	{
		MalterlibNoShortcuts true	
		DocumentationModule Malterlib
		MalterlibGenerateLibrary true // Always generate library here so files can be excluded
	}
	Target
	{
		BaseName "Malterlib_Runtime"
		Type "StaticLibrary"
		Group "Libraries/Malterlib"
	}
	Property.MalterlibConcurrency_DistributedActors true
	{
		!MalterlibConcurrency_DistributedActorsInAnyTarget ""
	}
	Compile
	{
		!!CompileDialect "C"
		PrefixHeader ""
		PrecompilePrefixHeader false
		SearchPath "@(Builtin.BasePath)/External/elftoolchain/libelf;@(Builtin.BasePath)/External/elftoolchain/common;@(Builtin.BasePath)/External/elftoolchain/libdwarf;@(Compile.SearchPath)"
		{
			!!PlatformFamily "Linux"
		}
		SearchPath "@('../../External/libunwind/include'->MakeAbsolute());@(Compile.SearchPath)"
		{
			&
			{
				MalterlibUseStaticLibCxxABI true
				MalterlibUseStaticLibUnwind true
			}
		}
		PreprocessorDefines "_LIBUNWIND_DYLD_FIND_UNWIND_SECTIONS_PROVIDED;@(Compile.PreprocessorDefines)"
	}
	Compile
	{
		&
		{
			CompileDialect "C"
			|
			{
				PlatformFamily "Emscripten"
				PlatformFamily "Linux"
				PlatformFamily "OSX"
			}
			!DocumentationEnabled true
		}
		PreprocessorDefines "malloc=nontracked_malloc;@(Compile.PreprocessorDefines)"
		PreprocessorDefines "free=nontracked_free;@(Compile.PreprocessorDefines)"
		PreprocessorDefines "calloc=nontracked_calloc;@(Compile.PreprocessorDefines)"
		PreprocessorDefines "realloc=nontracked_realloc;@(Compile.PreprocessorDefines)"
		PreprocessorDefines "cfree=nontracked_cfree;@(Compile.PreprocessorDefines)"
		PreprocessorDefines "memalign=nontracked_memalign;@(Compile.PreprocessorDefines)"
		PreprocessorDefines "posix_memalign=nontracked_posix_memalign;@(Compile.PreprocessorDefines)"
		PreprocessorDefines "valloc=nontracked_valloc;@(Compile.PreprocessorDefines)"
		PreprocessorDefines "pvalloc=nontracked_pvalloc;@(Compile.PreprocessorDefines)"
		PreprocessorDefines "malloc_usable_size=nontracked_malloc_usable_size;@(Compile.PreprocessorDefines)"
	}
	%Group "Source"
	{
		%Group NonTracked
		{
			Compile
			{
				!!MalterlibCompileSupportTabSetings true
				IndentWidth 2
				TabWidth 2
				UsesTabs false
			}
			%Group libc++
			{
				!!MalterlibUseStaticLibCxx "true"
				Compile
				{
					PreprocessorDefines "_LIBCPP_BUILDING_LIBRARY;_LIBUNWIND_DYLD_FIND_UNWIND_SECTIONS_PROVIDED;@(Compile.PreprocessorDefines)"
					DynamicTypeInfo true
					{
						!!ForceEnableDynamicTypeInfoLibCXX true
					}
				}
				%Group Headers
				{
					%File "../../External/libcxx/include/*"
					Compile.Type Header
				}
				%Group Source
				{
					%File "../../External/libcxx/src/*.cpp"
					%File "../../External/libcxx/src/new.cpp"
					{
						Compile.PreprocessorDefines "_LIBCPP_DISABLE_NEW_DELETE;@(Compile.PreprocessorDefines)"
					}
					%File "../../External/libcxx/src/debug.cpp"
					{
						Compile.Disabled true
					}
				}
			}
			%Group elftoolchain
			{
				Property
				{
					ThisFileName "@(this.Identity->GetFileNoExt())"
					ElfToolchainRoot "@('../../External/elftoolchain'->MakeAbsolute())"
					
					Executable false
					UnixLineEnds true
					UnicodeBOM false
					Group "@(Platform) @(Architecture) @(FullConfiguration)/@(RelativePath->GetPath())"
				}
				%Group libelf
				{
					!!PlatformFamily Linux
					%File "../../External/elftoolchain/libelf/*.c"
					%File "../../External/elftoolchain/libelf/*.h"
					%File "../../External/elftoolchain/libelf/*.m4"
					
					%Group Generated
					{
						Property
						{
							TypesFile "@('../../External/elftoolchain/libelf/elf_types.m4'->MakeAbsolute())"
							
							Name "@(GeneratedDirectory)libelf/@(ThisFileName).c"
							Contents "@(ExecuteCommand('@(GeneratedDirectory)libelf/@(ThisFileName).state', '@(this.Identity->MakeAbsolute());@(TypesFile)', 'm4', '-E', '-d', '-DSRCDIR=@(ElfToolchainRoot)/libelf', '-I@(ElfToolchainRoot)/common', '@(this.Identity->MakeAbsolute())'))"
						}
						
						%GenerateFile "../../External/elftoolchain/libelf/libelf_convert.m4"
						%GenerateFile "../../External/elftoolchain/libelf/libelf_fsize.m4"
						%GenerateFile "../../External/elftoolchain/libelf/libelf_msize.m4"
					}
				}
				%Group libdwarf
				{
					!!PlatformFamily Linux
					%File "../../External/elftoolchain/libdwarf/*.c"
					%File "../../External/elftoolchain/libdwarf/*.h"
					%File "../../External/elftoolchain/libdwarf/*.m4"

					%Group Generated
					{
						Property
						{
							NameTable "@('../../External/elftoolchain/libdwarf/dwarf_nametbl.m4'->MakeAbsolute())"

							Name "@(GeneratedDirectory)libdwarf/@(ThisFileName).c"
							Contents "@(ExecuteCommand('@(GeneratedDirectory)libdwarf/@(ThisFileName).state', '@(this.Identity->MakeAbsolute());@(TypesFile)', 'm4', '-E', '-d', '-DSRCDIR=@(ElfToolchainRoot)/libdwarf', '-I@(ElfToolchainRoot)/common', '@(this.Identity->MakeAbsolute())'))"
						}

						%GenerateFile "../../External/elftoolchain/libdwarf/dwarf_pubnames.m4"
						%GenerateFile "../../External/elftoolchain/libdwarf/dwarf_pubtypes.m4"
						%GenerateFile "../../External/elftoolchain/libdwarf/dwarf_weaks.m4"
						%GenerateFile "../../External/elftoolchain/libdwarf/dwarf_funcs.m4"
						%GenerateFile "../../External/elftoolchain/libdwarf/dwarf_vars.m4"
						%GenerateFile "../../External/elftoolchain/libdwarf/dwarf_types.m4"
						%GenerateFile "../../External/elftoolchain/libdwarf/dwarf_pro_pubnames.m4"
						%GenerateFile "../../External/elftoolchain/libdwarf/dwarf_pro_weaks.m4"
						%GenerateFile "../../External/elftoolchain/libdwarf/dwarf_pro_funcs.m4"
						%GenerateFile "../../External/elftoolchain/libdwarf/dwarf_pro_types.m4"
						%GenerateFile "../../External/elftoolchain/libdwarf/dwarf_pro_vars.m4"
					}
				}
			}
			%Group libc++abi
			{
				!!MalterlibUseStaticLibCxxABI true
				
				%Group Lib
				{
					Compile
					{
						!!CompileDialect "C"
						DynamicTypeInfo true
						PreprocessorDefines "LIBCXXABI_NO_NEW_DELETE;@(Compile.PreprocessorDefines)"
					}
					
					%File "../../External/libcxxabi/src/*.cpp"
					{
						Compile.Disabled true
						{
							!!PlatformFamily Emscripten
						}
					}
					%File "../../External/libcxxabi/src/*.h"
					%File "../../External/libcxxabi/include/*.h"
					{
						Compile.Disabled true
					}
					%File "../../External/libcxxabi/src/cxa_exception.cpp"
					%File "../../External/libcxxabi/src/stdlib_stdexcept.cpp"
					%File "../../External/libcxxabi/src/stdlib_typeinfo.cpp"
					%File "../../External/libcxxabi/src/private_typeinfo.cpp"
				}
			}
			%Group libunwind
			{
				&
				{
					MalterlibUseStaticLibCxxABI true
					MalterlibUseStaticLibUnwind true
				}
				Compile
				{
					!!Compile.Type "Assembler"
					
					AllCPUSubTypes true
					PreprocessorDefines "_LIBCXXABI_DISABLE_VISIBILITY_ANNOTATIONS;COMPILER_RT_NODEFAULTVISIBILITY;LIBCXXABI_NODEFAULTVISIBILITY;LIBUNWIND_NODEFAULTVISIBILITY;@(Compile.PreprocessorDefines)"
				}
				%File "../../External/libunwind/include/^*"
				%File "../../External/libunwind/src/*"
				{
					Compile.Disabled true
					{
						!!PlatformFamily Emscripten
					}
				}
			}
		}
		%Group "MSVC"
		{
			Compile.Disabled true
			{
				!PlatformType "Windows"
			}

			Property
			{
				VisualStudioVersion "15"

				VisualStudioCRTPath "../../SDK/VS.@(VisualStudioVersion).Crt"
			}

			%Group "CDecl"
			{
				Compile
				{
					!!CompileDialect "C"
					CallingConvention "Cdecl"
					{
						!Target.VisualStudioPlatform "Clang"
					}
				}
				%Group CRT
				{
					|
					{
						MalterlibEnableThirdPartyComparisonTests true
						PlatformFamily Windows
					}
					Compile.Disabled true
					Compile
					{
						!!CompileDialect "C"
						SearchPath "@(VisualStudioCRTPath->MakeAbsolute())/vcruntime;@(Compile.SearchPath)"
						PreprocessorDefines "_VCRT_BUILD;@(Compile.PreprocessorDefines)"
						PrefixHeader "@('Source/Platform/Malterlib_Core_PlatformImp_MSVC_CRTPatches.h'->MakeAbsolute())"
						{
							!!PlatformType "Windows"
						}
					}

					%Group vcruntime
					{
						Compile.Disabled false
						{
							!!PlatformType "Windows"
						}
						%File "../../SDK/VS.@(VisualStudioVersion).Crt/vcruntime/exe_common.inl"
						%File "../../SDK/VS.@(VisualStudioVersion).Crt/vcruntime/utility.cpp"
						%File "../../SDK/VS.@(VisualStudioVersion).Crt/vcruntime/exe_main.cpp"
						%File "../../SDK/VS.@(VisualStudioVersion).Crt/vcruntime/exe_winmain.cpp"
						%File "../../SDK/VS.@(VisualStudioVersion).Crt/vcruntime/exe_wmain.cpp"
						%File "../../SDK/VS.@(VisualStudioVersion).Crt/vcruntime/exe_wwinmain.cpp"
						%File "../../SDK/VS.@(VisualStudioVersion).Crt/vcruntime/dll_dllmain.cpp"
					}
				}
			}
		}
	}
}

%Target "Lib_MalterlibExecutable"
{
	Property.MalterlibNoShortcuts true	
	Property.DocumentationModule Malterlib
	Target
	{
		BaseName "MalterlibExecutable"
		Type "StaticLibrary"
		Group "Libraries/Malterlib"
	}
	Property.MalterlibConcurrency_DistributedActors true
	{
		!MalterlibConcurrency_DistributedActorsInAnyTarget ""
	}
	Compile
	{
		!!CompileDialect "C"
		PrefixHeader ""
	}
	Include "Lib_MalterlibNoPrefix.MHeader"
}

%Target "Lib_MalterlibDll"
{
	Property.MalterlibNoShortcuts true	
	Property.DocumentationModule Malterlib
	Property
	{
		MalterlibDynamicLibrary true
	}
	Target
	{
		BaseName "MalterlibDll"
		Type "StaticLibrary"
		Group "Libraries/Malterlib"
	}
	Property.MalterlibConcurrency_DistributedActors true
	{
		!MalterlibConcurrency_DistributedActorsInAnyTarget ""
	}
	Compile
	{
		!!CompileDialect "C"
		PrefixHeader ""
	}
	Include "Lib_MalterlibNoPrefix.MHeader"
}

Compile
{
	&
	{
		MalterlibEnableBreakpad true
		|
		{
			CompileDialect "C"
		}
	}
	SearchPath "@(Builtin.BasePath)/SDK/breakpad/src;@(Compile.SearchPath)"
	PreprocessorDefines "typeof=__typeof__;@(Compile.PreprocessorDefines)"
}

%Group "~Automatic/Breakpad Support"
{
	%File Source/Platform/Malterlib_Core_PlatformImp_MacOSX_Breakpad.mm
	{
		Compile.Disabled "true"
		{
			|
			{
				!PlatformFamily "OSX"
				!Target:Target.Type "UIExecutable"
			}
		}
		
	}
	%File Source/Platform/Malterlib_Core_PlatformImp_Linux_Breakpad.cpp
	{
		Compile.Disabled "true"
		{
			|
			{
				PlatformFamily "Windows"
				&
				{
					PlatformFamily "OSX"
					Target:Target.Type "UIExecutable"
				}

			}
		}
	}	
	!!MalterlibEnableBreakpad "true"
}

Target
{
	ExtraGroups "~Automatic/Breakpad Support;@(Target.ExtraGroups)"
	{
		!!MalterlibEnableBreakpad "true"
	}
}

Compile
{
	&
	{
		MalterlibEnableBreakpadUploader true
		|
		{
			CompileDialect "C"
		}
	}
	PreprocessorDefines "DMibBreakpadUploadServer=\"@(MalterlibBreakpadUploadServer)\";@(Compile.PreprocessorDefines)"
}

%Group "~Automatic/Breakpad Uploader Support"
{
	%File ../CrashReport/Source/Malterlib_CrashReport_BreakpadUploader.cpp
	!!MalterlibEnableBreakpadUploader "true"
}

Property.MalterlibUseCurl true
{
	!!MalterlibEnableBreakpadUploader "true"
}

Target
{
	ExtraGroups "~Automatic/Breakpad Uploader Support;@(Target.ExtraGroups)"
	{
		!!MalterlibEnableBreakpadUploader "true"
	}
}

%Group "~Automatic/Program Identifier"
{
	%File Source/Platform/Malterlib_Core_PlatformImp_Linux_ProgramIdentifier.cpp
	
	&
	{
		PlatformFamily Linux
		TargetIsExecutable true
		!MalterlibDisableMalterlib true
	}
}

Target
{
	ExtraGroups "~Automatic/Program Identifier;@(Target.ExtraGroups)"
	{
		&
		{
			PlatformFamily Linux
			TargetIsExecutable true
		}
	}
}

%Group "~Automatic/Include Roots"
{
	Property
	{
		EvalFile "@(Explodee->GetFile())"
		RelativePath "@(Explodee->MakeRelative(@(Explodee1)))"
		ExpandTemplate2	"@(MalterlibIncludeOutputDir)/@(RelativePath)|RelativePath=@(RelativePath)|FullPath=@(Explodee);"
		{
			&
			{
				!EvalFile ""
				!EvalFile ".DS_Store"
			}
		}
		ExpandTemplate	"@(Builtin.Function->ExplodeList('@(Explodee->FindFilesRecursiveIn('*'))', ';', 'ExpandTemplate2'))"
		{
			!Explodee ""
		}
		ExplodedContents "@(Builtin.Function->ExplodeList('@(MalterlibIncludeRoots)', ';', 'ExpandTemplate'))\n"
	}
	
	%GenerateFile "@(Builtin.Function->ExplodeList('@(MalterlibIncludeRoots)', ';', 'ExpandTemplate'))"
	{
		Compile.Type "Header"
		Property
		{
			Name "@(this.Identity)"
			Contents "#include \"@(FullPath)\"\n"
			Executable false
			UnixLineEnds true
			UnicodeBOM true
			Group "@(Platform) @(Architecture) @(FullConfiguration)/@(RelativePath->GetPath())"
			{
				!!MalterlibIncludePerConfig true
			}
			Group "@(RelativePath->GetPath())"
			{
				!MalterlibIncludePerConfig true
			}
		}
		//!!MalterlibIncludeRoots ""
	}
}

Property
{
	MalterlibLibrary_All true // Default to all functionality being included in the library
	MalterlibIncludeLevel "Workspace" // These too will cause performance issues if changed
	MalterlibIncludePerConfig false // These too will cause performance issues if changed
	
	MalterlibIncludeOutputDir "@(GeneratedDirectory)RootInclude"
	{
		&
		{
			MalterlibIncludeLevel "Target"
			MalterlibIncludePerConfig true
		}
		
	}
	MalterlibIncludeOutputDir "@(GeneratedDirectoryNoConfig)RootInclude"
	{
		&
		{
			MalterlibIncludeLevel "Target"
			!MalterlibIncludePerConfig true
		}
		
	}
	MalterlibIncludeOutputDir "@(GeneratedWorkspaceDirectory)RootInclude"
	{
		&
		{
			MalterlibIncludeLevel "Workspace"
			MalterlibIncludePerConfig true
		}
		
	}
	MalterlibIncludeOutputDir "@(GeneratedWorkspaceDirectoryNoConfig)RootInclude"
	{
		&
		{
			MalterlibIncludeLevel "Workspace"
			!MalterlibIncludePerConfig true
		}
	}
}

Property
{
	MalterlibMemoryManager_EnableOverrideSystemMalloc true
	{
		&
		{
			MalterlibMemoryManager_OverrideSystemMalloc true
			!MalterlibMemoryManager System
			!
			{
				&												// Disable for dynamic libraries on linux and OSX as only main executable should override malloc
				{
					MalterlibDynamicLibrary true
					|
					{
						PlatformFamily Linux
						PlatformFamily OSX
					}
				}
			}
		}
	}
}

Target
{
	&
	{
		!MalterlibIncludeRoots ""
		MalterlibIncludeLevel Target
	}
	ExtraGroups "~Automatic/Include Roots;@(Target.ExtraGroups)"
}

%Group "~Automatic/Malterlib Indirect Dependencies"
{
	Dependency.Indirect true
	
	%Dependency "Lib_Malterlib_Init"
	{
		&
		{
			MalterlibNeedsInitProject true
			!MalterlibDefaultToolset true
		}
		Dependency.Link false
	}
	%Dependency "Lib_Malterlib_Runtime"
	{
		&
		{
			Documentation ""
			|
			{
				PlatformFamily Windows
				MalterlibUseStaticLibCxx true
				MalterlibUseStaticLibCxxABI true
			}
		}
		Dependency.LinkWithObjectFiles "false"
	}
	%Dependency "Lib_Malterlib_Runtime2"
	{
		&
		{
			MalterlibUseStaticLibCxxABI true
			Documentation ""
		}
	}
	%Dependency "Lib_MalterlibDll"
	{
		&
		{
			|
			{
				Target:Target.Type "DynamicLibrary"
				Target:Target.Type "SharedDynamicLibrary"
				Target:Target.Type "XcodeBundle"
			}
		}
	}
	%Dependency "Lib_MalterlibExecutable"
	{
		|
		{
			Target:Target.Type "ConsoleExecutable"
			Target:Target.Type "UIExecutable"
			Target:Target.Type "Executable"
		}
	}
	%Dependency "Dll_MalterlibOverrideMalloc"
	{
		&
		{
			!MalterlibMemoryManager_OverrideOSXSystemMalloc false
			|
			{
				PlatformFamily OSX
				&
				{
					PlatformFamily Linux
					|
					{
						EnablePlatform_OSX10_5 true
						EnablePlatform_OSX10_6 true
						EnablePlatform_OSX10_7 true
						EnablePlatform_OSX10_8 true
						EnablePlatform_OSX10_9 true
						EnablePlatform_OSX10_10 true
						EnablePlatform_OSX10_11 true
						EnablePlatform_OSX10_12 true
					}
				}
			}
			Documentation ""
			TargetIsExecutable true
			|
			{
				&
				{
					!Target.Type DynamicLibrary
					!Target.Type XcodeBundle
					!Target.Type SharedDynamicLibrary
				}
			}
			!MalterlibMemoryManager System
		}
		Dependency.Link true
		{
			&
			{
				PlatformFamily OSX
				MalterlibMemoryManager_EnableOverrideSystemMalloc true
			}
		}
		Dependency.Link false
		{
			!
			{
				&
				{
					PlatformFamily OSX
					MalterlibMemoryManager_EnableOverrideSystemMalloc true
				}
			}
		}
	}
}

%Target "Lib_Malterlib"
{
	Property.MalterlibNoShortcuts true
	Property
	{
		DocumentationModule Malterlib
	}
	Target
	{
		BaseName "Malterlib"
		Type "StaticLibrary"
		Group "Libraries/Malterlib"
	}
	Property.MalterlibConcurrency_DistributedActors true
	{
		!MalterlibConcurrency_DistributedActorsInAnyTarget ""
	}
	Compile
	{
		!!CompileDialect "C"
		PrefixHeader "@(Builtin.BasePath)/@(Builtin.Function->RelativeBase('../Core/Source/PrefixHeader/PCH.h'))"
		{
			!DocumentationEnabled true
		}
		SearchPath "@(Builtin.BasePath)/@(Builtin.Function->RelativeBase('../PCH'));@(Compile.SearchPath)"
		SearchPath "@(Builtin.BasePath)/External/elftoolchain/common;@(Builtin.BasePath)/External/elftoolchain/libelf;@(Compile.SearchPath)"
		{
			!!PlatformFamily "Linux"
		}
		SearchPath "@(MalterlibSysRoot)/usr/include/glib-2.0;@(Compile.SearchPath)"
		{
			!!PlatformFamily "Linux"
		}
		SearchPath "@(Builtin.BasePath)/External/elftoolchain/libdwarf;@(Compile.SearchPath)"
		{
			!!PlatformFamily "Linux"
		}
	}
	%Group "Source"
	{
		%Group !PreComp
		{
			%File ../Core/Source/PrefixHeader/PCH.h
		}
	}
	Property
	{
		AllSubLibraryGroupsTemplate "{Malterlib}/{Lib_Malterlib_@(Explodee)};"
		{
			&
			{
				!Explodee ""
				!
				{
					|
					{
						true "@(MalterlibSubLibrarySeparate_Lib_Malterlib_@(Explodee))"
						true "@(MalterlibLibrarySeparate_Lib_Malterlib_@(Explodee))"
						&
						{
							MalterlibSubLibrarySeparate true
							!false "@(MalterlibSubLibrarySeparate_Lib_Malterlib_@(Explodee))" 
						}
					}
				}
			}
		}
		
		AllSubLibraryGroups "@(Builtin.Function->ExplodeList('@(MalterlibSubLibraries)', ';', 'AllSubLibraryGroupsTemplate'))"
		{
		}
	}
	
	Target.ExtraGroups "~Automatic/Malterlib Indirect Dependencies;@(AllSubLibraryGroups);@(MalterlibLibraryGroups);@(Target.ExtraGroups)"
	
	%Group "Indirect Dependencies"
	{
		Property
		{
			AllDependenciesTemplate "Lib_Malterlib_@(Explodee);"
			{
				&
				{
					!Explodee ""
					|
					{
						&
						{
							true "@(MalterlibSubLibrarySeparate_Lib_Malterlib_@(Explodee))"
							!true "@(MalterlibLibrarySeparate_Lib_Malterlib_@(Explodee))"
						}
						&
						{
							MalterlibSubLibrarySeparate true
							!false "@(MalterlibSubLibrarySeparate_Lib_Malterlib_@(Explodee))" 
						}
					}
				}
			}
			
			AllDependencies "@(Builtin.Function->ExplodeList('@(MalterlibSubLibraries)', ';', 'AllDependenciesTemplate'))"
			{
			}
		}
		
		%Dependency "@(AllDependencies)"
		
		Dependency.Indirect true		
	}
}

%Target "Dll_MalterlibOverrideMallocDummy"
{
	Property.MalterlibNoShortcuts true	
	Target
	{
		BaseName "MalterlibOverrideMallocDummy"
		Type "SharedDynamicLibrary"
		Group "Libraries/Malterlib"
		LDFlags "-nostdlibc++ @(Target.LDFlags)"
		{
			!!PlatformFamily OSX
			!!PlatformFamily Linux
		}
	}
	Target
	{
		!!PlatformFamily OSX
		LinkWithLibraries ""
		LinkWithStandardLibraries false
		SharedLibraryInstallPath "/usr/lib/system/MalterlibMallocOverrideDummy.dylib"
	}
	Compile
	{
		!!CompileDialect "C"
		PrefixHeader ""
	}
	Property
	{
		MalterlibDisableMalterlib true
		MalterlibStripSymbols false
		MalterlibSigning false // Linker crashes if we sign this dylib
	}
	%Group Source
	{
		%File ../Memory/Source/Malterlib_Memory_SystemOverride_OSXDyldDummy.cpp
		{
			!!PlatformFamily OSX
		}
		%File Source/Dummy/DummyMainRaw.cpp
		{
			!PlatformFamily OSX
		}
	}
}

Property
{
	MalterlibMemoryManager_OverrideSystemMallocInitBeforeLibSystem "" // User: Init early support. Currently breaks OSX 10.12
	{
		!!MalterlibMemoryManager_OverrideSystemMallocInitBeforeLibSystem ""
	}
}

%Target "Dll_MalterlibOverrideMalloc"
{
	Property.MalterlibNoShortcuts true	
	Target
	{
		BaseName "MalterlibOverrideMalloc"
		Type "SharedDynamicLibrary"
		Group "Libraries/Malterlib"
		LDFlags "-nostdlibc++ @(Target.LDFlags)"
		{
			!!PlatformFamily OSX
			!!PlatformFamily Linux
		}
	}
	Target
	{
		!!PlatformFamily OSX

		LinkWithLibraries "-undefined dynamic_lookup \"@(MalterlibCompiledFiles)@(MalterlibBranch)/@(Workspace:Workspace.Name)/Output/Dll_MalterlibOverrideMallocDummy/@(Platform)/@(Architecture)/@(FullConfiguration)/Deployed/MalterlibOverrideMallocDummy.dylib\""
		LinkWithLibraries "/usr/lib/libSystem.B.dylib @(Target.LinkWithLibraries)"
		{
			!MalterlibMemoryManager_OverrideSystemMallocInitBeforeLibSystem true
		}
		LinkWithLibraries "/usr/lib/dylib1.o @(Target.LinkWithLibraries)"
		{
			!!Platform "OSX10.5"
		}
		LinkWithStandardLibraries false
		SharedLibraryInstallPath "@executable_path/MalterlibOverrideMalloc.dylib"
	}
	Compile
	{
		!!CompileDialect "C"
		PrefixHeader ""
		StackGuard false
		{
			!!PlatformFamily OSX
		}
		PreprocessorDefines "DMalterlibMemoryOverrideOSXInitBeforeLibSystemSupport;@(Compile.PreprocessorDefines)"
		{
			!!MalterlibMemoryManager_OverrideSystemMallocInitBeforeLibSystem true 
		}
	}
	Property
	{
		MalterlibDisableMalterlib true
		MalterlibStripSymbols false
	}
	%Group Source
	{
		%File ../Memory/Source/Malterlib_Memory_SystemOverride_OSXLibSystem.cpp
		{
			!!PlatformFamily OSX
		}
		%File Source/Dummy/DummyMainRaw.cpp
		{
			!PlatformFamily OSX
		}
	}
	%Dependency "Dll_MalterlibOverrideMallocDummy"
}
