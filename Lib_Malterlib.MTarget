Property
{
	MalterlibNeedsInitProject: bool = false
	MalterlibNeedsInitProject true
	{
		!!PlatformType "Unix"
	}

	ForceEnableDynamicTypeInfoLibCXX: bool = false
}

%Target "Lib_Malterlib_Init"
{
	!!MalterlibNeedsInitProject  true
	Property.DocumentationModule "Malterlib"
	Property.MalterlibNoShortcuts true

	Target
	{
		BaseName "Malterlib_Init"
		Type "StaticLibrary"
		Group "Malterlib"
	}
	Compile
	{
		!!CompileDialect "C"
		PrefixHeader undefined
	}
	%Group "Source"
	{
		%Group "Runtime"
		{
			%Group "Runtimes"
			{
				%Group "Unix"
				{
					%File "Source/Platform/Malterlib_Core_PlatformImp_Posix_Init.cpp"
				}
			}
		}
	}
}

%Group "{Lib_Malterlib_Runtime}/{SharedSettings}"
{
	Property
	{
		MalterlibNoShortcuts true
		DocumentationModule "Malterlib"
		MalterlibGenerateLibrary true // Always generate library here so files can be excluded
	}
	Compile
	{
		!!CompileDialect "C"
		PrefixHeader undefined
		PrecompilePrefixHeader false
		SearchPath += [
			`@(GeneratedWorkspaceDirectory)elftoolchain`
			, `@(Builtin.BasePathAbsolute)/External/elftoolchain/libelf`
			, `@(Builtin.BasePathAbsolute)/External/elftoolchain/common`
			, `@(Builtin.BasePathAbsolute)/External/elftoolchain/libdwarf`
		]
		{
			!!PlatformFamily "Linux"
		}
		SearchPath += "../../External/llvm-project/libunwind/include"->MakeAbsolute()
		{
			&
			{
				MalterlibUseStaticLibCxxABI true
				MalterlibUseStaticLibUnwind true
			}
		}
		PreprocessorDefines =+ ["COMPILER_RT_HAS_ATOMICS=1", "_LIBUNWIND_DYLD_FIND_UNWIND_SECTIONS_PROVIDED"]
		PreprocessorDefines =+ ["COMPILER_RT_HAS_UNAME=1", "COMPILER_RT_HAS_FCNTL_LCK=1"]
		{
			!!PlatformType "Unix"
		}
	}
}

%Target "Lib_Malterlib_RuntimeABI"
{
	Property
	{
		RealConfiguration "Release"
		{
			!!MalterlibRuntime_AlwaysRelease true
		}
		RealConfiguration MalterlibRuntime_AlwaysRelease
		{
			&
			{
				!MalterlibRuntime_AlwaysRelease undefined
				!MalterlibRuntime_AlwaysRelease false
				!MalterlibRuntime_AlwaysRelease true
			}
		}
		DebugCodeAlwaysRelease true
		{
			!RealConfiguration Configuration
		}
	}

	Target
	{
		BaseName "Malterlib_RuntimeABI"
		Type "StaticLibrary"
		Group "Malterlib"
		LinkTimeCodeGeneration false
		ExtraGroups =+ "{Lib_Malterlib_Runtime}/{SharedSettings}"
	}
	Compile
	{
		&
		{
			CompileDialect "C"
			|
			{
				PlatformFamily "Emscripten"
				PlatformFamily "Linux"
				PlatformFamily "macOS"
			}
			!DocumentationEnabled true
		}
		PreprocessorDefines =+ "malloc=nontracked_malloc"
		PreprocessorDefines =+ "free=nontracked_free"
		PreprocessorDefines =+ "calloc=nontracked_calloc"
		PreprocessorDefines =+ "realloc=nontracked_realloc"
		PreprocessorDefines =+ "cfree=nontracked_cfree"
		PreprocessorDefines =+ "memalign=nontracked_memalign"
		PreprocessorDefines =+ "posix_memalign=nontracked_posix_memalign"
		PreprocessorDefines += "aligned_alloc=nontracked_aligned_alloc"
		PreprocessorDefines =+ "valloc=nontracked_valloc"
		PreprocessorDefines =+ "pvalloc=nontracked_pvalloc"
		PreprocessorDefines =+ "malloc_usable_size=nontracked_malloc_usable_size"
		PreprocessorDefines =+ ["_LIBCPP_BUILDING_LIBRARY", "_LIBUNWIND_DYLD_FIND_UNWIND_SECTIONS_PROVIDED"]
	}
	Compile
	{
		!!CompileDialect "C"

		Analyzer false

		SearchPath += "../../External/llvm-project/libcxx/src"->MakeAbsolute()
		{
			&
			{
				MalterlibUseStaticLibCxxABI true
			}
		}
		SearchPath += "../../External/llvm-project/compiler-rt/lib/builtins"->MakeAbsolute()
		{
			&
			{
				MalterlibUseStaticLibCxxABI true
				|
				{
					PlatformFamily "Linux"
					PlatformFamily "macOS"
					PlatformFamily "Emscripten"
				}
			}
		}

	}
	Property.WorkaroundLTOValue: bool = false
	%Group "Source"
	{
		Compile
		{
			!!MalterlibCompileSupportTabSetings true
			IndentWidth 2
			TabWidth 2
			UsesTabs false
		}
		%Group "compiler-rt"
		{
			&
			{
				MalterlibUseStaticLibCxxABI true
				|
				{
					PlatformFamily "Linux"
					PlatformFamily "macOS"
					PlatformFamily "Emscripten"
				}
			}

			Compile
			{
				!!CompileDialect "C"
				LinkTimeCodeGeneration MalterlibEnableLinkTimeCodeGeneration
				Warnings_ShiftCountNegative false
				{
					!!Compiler "Clang"
				}
				Warnings_ConstantConversion false
				{
					!!Compiler "Clang"
				}
				Warnings_ShiftOverflow false
				{
					!!Compiler "Clang"
				}
			}

			%Group "LSE"
			{
				&
				{
					PlatformFamily "Linux"
					|
					{
						Architecture "arm64"
						Architecture "arm64e"
					}
				}

				Property
				{
					_Name: string
					_Size: string
					_Model: string

					LseFilesToGenerate_Names: [string] = ["cas", "swp", "ldadd", "ldclr", "ldeor" , "ldset"]
					LseFilesToGenerate_Sizes: [string] = ["1", "2", "4", "8", "16"]
					LseFilesToGenerate_Models: [string] = ["1", "2", "3", "4"]

					fg_IterateNames function(string _Name) [type(CEntity)] = []
					fg_IterateNames =+ LseFilesToGenerate_Sizes->ForEach(&fg_IterateSizes, {_Name: _Name})

					fg_IterateSizes function(string _Size) [type(CEntity)] = []
					fg_IterateSizes =+ LseFilesToGenerate_Models->ForEach(&fg_IterateModels, {_Size: _Size, _Name: _Name})

					fg_IterateModels function(string _Model) [type(CEntity)] = []
					fg_IterateModels =+ {
						Name: `outline_atomic_@(_Name)_@(_Size)_@(_Model).S`
						, Properties: {
							LseName: _Name
							, LseSize: _Size
							, LseModel: _Model
						}
					}
					{
						|
						{
							_Name "cas"
							!_Size "16"
						}
					}
				}
				%GenerateFile LseFilesToGenerate_Names->ForEach(&fg_IterateNames)
				{
					GenerateFile
					{
						Name `@(GeneratedDirectory)LSE/@(this.Identity)`

						Symlink true
						SymlinkBasePath `@(GeneratedDirectory)LSE`
						Contents "../../External/llvm-project/compiler-rt/lib/builtins/aarch64/lse.S"->MakeAbsolute()
						Executable false
						UnixLineEnds true
						UnicodeBOM false
					}

					Property
					{
						LseName: string = this.Identity->ParseFormatString("{}/outline_atomic_{}_{}_{}.S", "{1}")
						LseSize: string = this.Identity->ParseFormatString("{}/outline_atomic_{}_{}_{}.S", "{2}")
						LseModel: string = this.Identity->ParseFormatString("{}/outline_atomic_{}_{}_{}.S", "{3}")
					}

					Compile
					{
						!!Compile.Type "Assembler"

						SearchPath += "../../External/llvm-project/compiler-rt/lib/builtins"->MakeAbsolute()

						PreprocessorDefines =+ ["HAS_ASM_LSE", `L_@(LseName)`, `SIZE=@(LseSize)`, `MODEL=@(LseModel)`]
						{
							!!Architecture "arm64"
							!!Architecture "arm64e"
						}
					}
				}
			}

			%Group "Core"
			{
				%File "../../External/llvm-project/compiler-rt/lib/builtins/*.c"
				{
					Compile.Disabled (
						this.Identity->GetFile() == "crtbegin.c"
						|| this.Identity->GetFile() == "crtend.c"
						|| this.Identity->GetFile() == "ctor_dtor.c"
						|| this.Identity->GetFile() == "dso_handle.c"
					)
				}
				%File "../../External/llvm-project/compiler-rt/lib/builtins/*.h"
				%File "../../External/llvm-project/compiler-rt/lib/builtins/*bf2.c"
				{
					Compile.Disabled true
				}
				%Group "x86"
				{
					!!Architecture "x86"
					//%File "../../SDK/compiler-rt/lib/builtins/i386/*.c"
					%File "../../External/llvm-project/compiler-rt/lib/builtins/i386/*.S"
				}
				%Group "x64"
				{
					!!Architecture "x64"
					%File "../../External/llvm-project/compiler-rt/lib/builtins/x86_64/*.c"
					%File "../../External/llvm-project/compiler-rt/lib/builtins/x86_64/*.S"
				}
				%Group "aarch64"
				{
					!!Architecture "arm64"
					!!Architecture "arm64e"
					%File "../../External/llvm-project/compiler-rt/lib/builtins/aarch64/*.c"
					%File "../../External/llvm-project/compiler-rt/lib/builtins/aarch64/*.S"
					%File "../../External/llvm-project/compiler-rt/lib/builtins/aarch64/lse.S"
					{
						Compile.Disabled true
					}
					%File "../../External/llvm-project/compiler-rt/lib/builtins/aarch64/sme-*"
					{
						Compile.Disabled true
						{
							!!PlatformFamily "macOS"
						}
					}
				}
				%Group "ppc"
				{
					!!Architecture "ppc32"
					!!Architecture "ppc64"
					%File "../../External/llvm-project/compiler-rt/lib/builtins/ppc/*.c"
					%File "../../External/llvm-project/compiler-rt/lib/builtins/ppc/*.S"
				}
			}
		}
		%Group "libunwind"
		{
			&
			{
				MalterlibUseStaticLibCxxABI true
				MalterlibUseStaticLibUnwind true
			}

			Property
			{
				MalterlibSupportSanitizerEnable_Thread false
				MalterlibSupportSanitizerEnable_Address false
				MalterlibSupportSanitizerEnable_UndefinedBehavior false
			}

			Compile.LinkTimeCodeGeneration WorkaroundLTOValue // Exception handling breaks if this is enabled
			{
				&
				{
					CompileDialect "C"
					!WorkaroundLTOValue undefined
				}
			}

			Compile
			{
				!!CompileDialect "C"

				Sanitize_Thread false
				Sanitize_Address false
				Sanitize_UndefinedBehavior false
			}

			Compile
			{
				!!Compile.Type "Assembler"

				AllCPUSubTypes true
				PreprocessorDefines =+ ["_LIBCXXABI_DISABLE_VISIBILITY_ANNOTATIONS", "COMPILER_RT_NODEFAULTVISIBILITY", "LIBCXXABI_NODEFAULTVISIBILITY", "LIBUNWIND_NODEFAULTVISIBILITY", "_LIBUNWIND_HIDE_SYMBOLS"]
			}
			%File "../../External/llvm-project/libunwind/include/^*"
			%File "../../External/llvm-project/libunwind/src/*"
			{
				Compile.Disabled true
				{
					!!PlatformFamily "Emscripten"
				}
			}
		}
		%Group "libc++abi"
		{
			!!MalterlibUseStaticLibCxxABI true

			Compile.LinkTimeCodeGeneration MalterlibEnableLinkTimeCodeGeneration
			{
				!!CompileDialect "C"
			}

			Compile
			{
				!!CompileDialect "C"
				DynamicTypeInfo true
				PreprocessorDefines =+ "LIBCXXABI_NO_NEW_DELETE"
				PreprocessorDefines =+ "_LIBCXXABI_BUILDING_LIBRARY"
				PreprocessorDefines =+ "_LIBCXXABI_UBSAN_HELPERS"
				{
					!!MalterlibSupportSanitizerEnable_UndefinedBehavior true
				}
			}

			%File "../../External/llvm-project/libcxxabi/src/*.cpp"
			{
				Compile.Disabled true
				{
					!!PlatformFamily "Emscripten"
				}
			}
			%File "../../External/llvm-project/libcxxabi/src/*.h"
			%File "../../External/llvm-project/libcxxabi/include/*.h"
			{
				Compile.Disabled true
			}
			%File "../../External/llvm-project/libcxxabi/src/cxa_noexception.cpp"
			{
				Compile.Disabled true
			}
			%File "../../External/llvm-project/libcxxabi/src/cxa_guard.cpp"
			{
				Compile.LinkTimeCodeGeneration WorkaroundLTOValue // Exception handling breaks if this is enabled
				{
					&
					{
						CompileDialect "C"
						!WorkaroundLTOValue undefined
					}
				}
			}
			%File "../../External/llvm-project/libcxxabi/src/cxa_exception.cpp"
			{
				Compile.LinkTimeCodeGeneration WorkaroundLTOValue // Exception handling breaks if this is enabled
				{
					&
					{
						CompileDialect "C"
						!WorkaroundLTOValue undefined
					}
				}
			}
			%File "../../External/llvm-project/libcxxabi/src/cxa_personality.cpp"
			{
				Compile.LinkTimeCodeGeneration WorkaroundLTOValue // Exception handling breaks if this is enabled
				{
					&
					{
						CompileDialect "C"
						!WorkaroundLTOValue undefined
					}
				}
				Compile.Disabled true
				{
					!!PlatformFamily "Emscripten"
				}
			}
		}
	}
}

%Target "Lib_Malterlib_Runtime"
{
	Property
	{
		RealConfiguration "Release"
		{
			!!MalterlibRuntime_AlwaysRelease true
		}
		RealConfiguration MalterlibRuntime_AlwaysRelease
		{
			&
			{
				!MalterlibRuntime_AlwaysRelease undefined
				!MalterlibRuntime_AlwaysRelease false
				!MalterlibRuntime_AlwaysRelease true
			}
		}
		DebugCodeAlwaysRelease true
		{
			!RealConfiguration Configuration
		}
	}
	Target
	{
		BaseName "Malterlib_Runtime"
		Type "StaticLibrary"
		Group "Malterlib"
		ExtraGroups =+ "{Lib_Malterlib_Runtime}/{SharedSettings}"
	}
	Compile
	{
		!!CompileDialect "C"

		SearchPath += [
			"../../External/llvm-project/libcxx/src"->MakeAbsolute()
			, "../../External/llvm-project/libc"->MakeAbsolute()
		]
		{
			&
			{
				MalterlibUseStaticLibCxx true
			}
		}


		Analyzer false
	}
	%Group "Source"
	{
		Compile
		{
			!!MalterlibCompileSupportTabSetings true
			IndentWidth 2
			TabWidth 2
			UsesTabs false
		}

		%Group "libc++"
		{
			!!MalterlibUseStaticLibCxx true
			Compile
			{
				!!CompileDialect "C"
				!!Compile.Type "Assembler"

				PreprocessorDefines =+ ["_LIBCPP_BUILDING_LIBRARY", "_LIBUNWIND_DYLD_FIND_UNWIND_SECTIONS_PROVIDED"]
				DynamicTypeInfo true
				{
					!!ForceEnableDynamicTypeInfoLibCXX true
				}
			}
			%Group "Headers"
			{
				%File "../../External/llvm-project/libcxx/include/^*"
				Compile.Type "Header"
			}
			%Group "Source"
			{
				%File "../../External/llvm-project/libcxx/src/^*"
				%File "../../External/llvm-project/libcxx/src/new.cpp"
				{
					Compile.PreprocessorDefines =+ "_LIBCPP_DISABLE_NEW_DELETE_DEFINITIONS"
					{
						!MalterlibDefaultToolset true
					}
				}
				%Group "experimental"
				{
					Compile.Disabled true
					%File "../../External/llvm-project/libcxx/src/experimental/*.cpp"
				}
				%Group "pstl"
				{
					%File "../../External/llvm-project/libcxx/src/pstl/libdispatch.cpp"
					{
						Compile.Disabled true
						{
							!PlatformFamily "macOS"
						}
					}
				}
				%Group "support"
				{
					%Group "ibm"
					{
						%File "../../External/llvm-project/libcxx/src/support/ibm/*.cpp"
						{
							Compile.Disabled true
						}
					}
					%Group "win32"
					{
						%File "../../External/llvm-project/libcxx/src/support/win32/*.cpp"
						{
							Compile.Disabled true
							{
								!PlatformFamily "Windows"
							}
						}
					}
				}
			}
		}
		%Group "NonTracked"
		{
			Compile
			{
				&
				{
					CompileDialect "C"
					|
					{
						PlatformFamily "Emscripten"
						PlatformFamily "Linux"
						PlatformFamily "macOS"
					}
					!DocumentationEnabled true
				}
				PreprocessorDefines =+ "malloc=nontracked_malloc"
				PreprocessorDefines =+ "free=nontracked_free"
				PreprocessorDefines =+ "calloc=nontracked_calloc"
				PreprocessorDefines =+ "realloc=nontracked_realloc"
				PreprocessorDefines =+ "cfree=nontracked_cfree"
				PreprocessorDefines =+ "memalign=nontracked_memalign"
				PreprocessorDefines =+ "posix_memalign=nontracked_posix_memalign"
				PreprocessorDefines += "aligned_alloc=nontracked_aligned_alloc"
				PreprocessorDefines =+ "valloc=nontracked_valloc"
				PreprocessorDefines =+ "pvalloc=nontracked_pvalloc"
				PreprocessorDefines =+ "malloc_usable_size=nontracked_malloc_usable_size"
			}
			%Group "elftoolchain"
			{
				Property
				{
					ThisFileName: string = this.Identity->GetFileNoExt()
					ElfToolchainRoot: string = "../../External/elftoolchain"->MakeAbsolute()
				}
				GenerateFile
				{
					Executable false
					UnixLineEnds true
					UnicodeBOM false
					Group `@(Platform) @(Architecture) @(FullConfiguration)`
				}
				%Group "common"
				{
					!!PlatformFamily "Linux"
					%Group "sys"
					{
						%Group "Generated"
						{
							GenerateFile
							{
								Name `@(GeneratedWorkspaceDirectory)elftoolchain/sys/@(ThisFileName).h`
								Contents ExecuteCommand(
									`@(GeneratedWorkspaceDirectory)elftoolchain/sys/@(ThisFileName).state`
									, [this.Identity->MakeAbsolute(), "../../External/elftoolchain/common/sys/elfconstants.m4"->MakeAbsolute()]
									, "m4"
									, `-DSRCDIR=@(ElfToolchainRoot)/common/sys`
									, `-I@(ElfToolchainRoot)/common/sys`
									, this.Identity->MakeAbsolute()
								)
							}

							%GenerateFile "../../External/elftoolchain/common/sys/elfdefinitions.m4"
						}
					}
				}
				%Group "libelf"
				{
					!!PlatformFamily "Linux"
					%File "../../External/elftoolchain/libelf/*.c"
					%File "../../External/elftoolchain/libelf/*.h"
					%File "../../External/elftoolchain/libelf/*.m4"

					%Group "Generated"
					{
						Property
						{
							TypesFile: string = "../../External/elftoolchain/libelf/elf_types.m4"->MakeAbsolute()
						}
						GenerateFile
						{
							Name `@(GeneratedDirectory)libelf/@(ThisFileName).c`
							Contents ExecuteCommand(
								`@(GeneratedDirectory)libelf/@(ThisFileName).state`
								, [this.Identity->MakeAbsolute(), TypesFile]
								, "m4"
								, "-E"
								, "-d"
								, `-DSRCDIR=@(ElfToolchainRoot)/libelf`
								, `-I@(ElfToolchainRoot)/common`
								, this.Identity->MakeAbsolute()
							)
						}

						%GenerateFile "../../External/elftoolchain/libelf/libelf_convert.m4"
						%GenerateFile "../../External/elftoolchain/libelf/libelf_fsize.m4"
						%GenerateFile "../../External/elftoolchain/libelf/libelf_msize.m4"
					}
				}
				%Group "libdwarf"
				{
					!!PlatformFamily "Linux"
					%File "../../External/elftoolchain/libdwarf/*.c"
					%File "../../External/elftoolchain/libdwarf/*.h"
					%File "../../External/elftoolchain/libdwarf/*.m4"

					%Group "Generated"
					{
						Property
						{
							NameTable: string = `@("../../External/elftoolchain/libdwarf/dwarf_nametbl.m4"->MakeAbsolute())`
						}
						GenerateFile
						{
							Name `@(GeneratedDirectory)libdwarf/@(ThisFileName).c`
							Contents ExecuteCommand(
								`@(GeneratedDirectory)libdwarf/@(ThisFileName).state`
								, [this.Identity->MakeAbsolute(), NameTable]
								, "m4"
								, "-E"
								, "-d"
								, `-DSRCDIR=@(ElfToolchainRoot)/libdwarf`
								, `-I@(ElfToolchainRoot)/common`
								, this.Identity->MakeAbsolute()
							)
						}

						%GenerateFile "../../External/elftoolchain/libdwarf/dwarf_pubnames.m4"
						%GenerateFile "../../External/elftoolchain/libdwarf/dwarf_pubtypes.m4"
						%GenerateFile "../../External/elftoolchain/libdwarf/dwarf_weaks.m4"
						%GenerateFile "../../External/elftoolchain/libdwarf/dwarf_funcs.m4"
						%GenerateFile "../../External/elftoolchain/libdwarf/dwarf_vars.m4"
						%GenerateFile "../../External/elftoolchain/libdwarf/dwarf_types.m4"
						%GenerateFile "../../External/elftoolchain/libdwarf/dwarf_pro_pubnames.m4"
						%GenerateFile "../../External/elftoolchain/libdwarf/dwarf_pro_weaks.m4"
						%GenerateFile "../../External/elftoolchain/libdwarf/dwarf_pro_funcs.m4"
						%GenerateFile "../../External/elftoolchain/libdwarf/dwarf_pro_types.m4"
						%GenerateFile "../../External/elftoolchain/libdwarf/dwarf_pro_vars.m4"
					}
				}
			}
		}
		%Group "MSVC"
		{
			Compile.Disabled true
			{
				!PlatformType "Windows"
			}

			Property
			{
				VisualStudioRoot: string = Builtin.VisualStudioRoot->UnixPath()

				MSVCRootPath: string
				MSVCRootPath `@(VisualStudioRoot)/VC/Tools/MSVC`
				{
					!!MSVCRootPath undefined
				}

				VisualStudioCRTPath: string = `@(MSVCRootPath)/@(MalterlibMSVCVersion)/crt/src`
			}

			%Group "CDecl"
			{
				%Group "CRT"
				{
					&
					{
						PlatformFamily "Windows"
						HostPlatformFamily "Windows"
					}

					Compile.Disabled true
					Compile
					{
						!!CompileDialect "C"

						FullEval true

						SearchPath += `@(VisualStudioCRTPath->MakeAbsolute())/vcruntime`
						PreprocessorDefines =+ "_VCRT_BUILD"
						PreprocessorDefines =+ ["__load_acquire32(x)=__atomic_load_n(x,__ATOMIC_SEQ_CST)", "__load_acquire64(x)=__atomic_load_n(x,__ATOMIC_SEQ_CST)"]
						{
							&
							{
								Compiler "Clang"
								Architecture "arm64"
							}
						}

						PrefixHeader "Source/Platform/Malterlib_Core_PlatformImp_MSVC_CRTPatches.h"->MakeAbsolute()
						{
							!!PlatformType "Windows"
						}
					}

					%Group "vcruntime"
					{
						Compile.Disabled false
						{
							!!PlatformType "Windows"
						}
						Property
						{
							ThisFileName: string = this.Identity->GetFileNoExt()
							ThisSourceFile: string = `@(VisualStudioCRTPath)/vcruntime/@(this.Identity)`
							PatchFile: string
							PatchFile `@("Patches"->MakeAbsolute())/@(MalterlibMSVCVersion)/VCCrt_@(this.Identity).patch`
							PatchFile `@("Patches"->MakeAbsolute())/Latest/VCCrt_@(this.Identity).patch`
							{
								!PatchFile->FileExists() true
							}
						}
						%GenerateFile ["exe_common.inl", "utility.cpp", "dll_dllmain.cpp"]
						{
							// ./Binaries/Malterlib/Windows/x64/MTool BinaryDiff "/c/Program Files/Microsoft Visual Studio/2022/Professional/VC/Tools/MSVC/14.40.33807/crt/src/vcruntime/utility.cpp" /c/CompiledFiles/Mal18f/Tese5c/Generated/Lib_Malterlib_Runtime/NoConfig/vcruntime/utility.cpp Malterlib/Core/Patches/14.38.33130/VCCrt_utility.cpp.patch
							// ./Binaries/Malterlib/Windows/x64/MTool BinaryDiff "/c/Program Files/Microsoft Visual Studio/2022/Professional/VC/Tools/MSVC/14.40.33807/crt/src/vcruntime/dll_dllmain.cpp" /c/CompiledFiles/Mal18f/Tese5c/Generated/Lib_Malterlib_Runtime/NoConfig/vcruntime/dll_dllmain.cpp Malterlib/Core/Patches/14.38.33130/VCCrt_dll_dllmain.cpp.patch
							// ./Binaries/Malterlib/Windows/x64/MTool BinaryDiff "/c/Program Files/Microsoft Visual Studio/2022/Professional/VC/Tools/MSVC/14.40.33807/crt/src/vcruntime/exe_common.inl" /c/CompiledFiles/Mal18f/Tese5c/Generated/Lib_Malterlib_Runtime/NoConfig/vcruntime/exe_common.inl Malterlib/Core/Patches/14.38.33130/VCCrt_exe_common.inl.patch
							GenerateFile
							{
								Name `@(GeneratedDirectoryNoConfig)vcruntime/@(this.Identity)`
								Contents ExecuteCommand(
									`@(GeneratedDirectoryNoConfig)vcruntime_@(ThisFileName).state`
									, [ThisSourceFile, PatchFile]
									, MToolPath
									, "BinaryPatch"
									, ThisSourceFile
									, PatchFile
									, "-"
								)
								Executable false
								UnixLineEnds false
								UnicodeBOM false
							}
						}
						%GenerateFile ["exe_main.cpp", "exe_winmain.cpp", "exe_wmain.cpp", "exe_wwinmain.cpp"]
						{
							GenerateFile
							{
								Name `@(GeneratedDirectoryNoConfig)/vcruntime/@(this.Identity)`
								Contents ExecuteCommand(`@(GeneratedDirectoryNoConfig)vcruntime_@(ThisFileName).state`, [ThisSourceFile], MToolPath, "Cat", ThisSourceFile)
								Executable false
								UnixLineEnds false
								UnicodeBOM false
							}
						}
					}
				}
			}
		}
	}
}

