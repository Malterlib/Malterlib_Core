%Group "{Malterlib}/{Lib_Malterlib}/{TargetInjection}"
{
	Target.ExtraGroups =+ "!Automatic/!MalterlibWindows"
	{
		&
		{
			PlatformFamily "Windows"
			TargetIsExecutable true
		}
	}
}

%Target "Lib_Malterlib"
{
	Property.MalterlibNoShortcuts true
	Property
	{
		DocumentationModule "Malterlib"
	}
	Target
	{
		BaseName "Malterlib"
		Type "StaticLibrary"
		Group "Malterlib"
		DependencyInjectionGroups =+ "{Malterlib}/{Lib_Malterlib}/{TargetInjection}"
	}
	Compile
	{
		!!CompileDialect "C"
		PrefixHeader "../Core/Source/PrefixHeader/PCH.h"->MakeAbsolute()
		{
			!DocumentationEnabled true
		}
		PrefixHeader "../Core/Source/PrefixHeader/PCH_C.h"->MakeAbsolute()
		{
			&
			{
				GeneratorFamily "VisualStudio"
				|
				{
					Compile.Type "C"
					Compile.Type "ObjC"
				}
				!DocumentationEnabled true
			}
		}
		SearchPath += "../PCH"->MakeAbsolute()
		SearchPath += [`@(GeneratedWorkspaceDirectory)elftoolchain`, `@(Builtin.BasePathAbsolute)/External/elftoolchain/common`, `@(Builtin.BasePathAbsolute)/External/elftoolchain/libelf`]
		{
			!!PlatformFamily "Linux"
		}
		SearchPath += `@(MalterlibSysRoot)/usr/include/glib-2.0`
		{
			!!PlatformFamily "Linux"
		}
		SearchPath += `@(Builtin.BasePathAbsolute)/External/elftoolchain/libdwarf`
		{
			!!PlatformFamily "Linux"
		}
	}
	%Group "Source"
	{
		%Group "!PreComp"
		{
			%File "../Core/Source/PrefixHeader/PCH.h"
			%File "../Core/Source/PrefixHeader/PCH_C.h"
		}
	}
	Property
	{
		AllSubLibraryGroupsTemplate function(string _Library) [string] = []
		AllSubLibraryGroupsTemplate += `{Malterlib}/{Lib_Malterlib_@(_Library)}`
		{
			&
			{
				!_Library ""
				!
				{
					|
					{
						true IsDefined(`MalterlibSubLibrarySeparate_Lib_Malterlib_@(_Library)`) ? MalterlibSubLibrarySeparate_Lib_Malterlib_@(_Library) : false
						true IsDefined(`MalterlibLibrarySeparate_Lib_Malterlib_@(_Library)`) ? MalterlibLibrarySeparate_Lib_Malterlib_@(_Library) : false
						&
						{
							MalterlibSubLibrarySeparate true
							!false IsDefined(`MalterlibSubLibrarySeparate_Lib_Malterlib_@(_Library)`) ? MalterlibSubLibrarySeparate_Lib_Malterlib_@(_Library) : false
						}
					}
				}
			}
		}
	}

	Target.ExtraGroups =+ ["~Automatic/Malterlib Indirect Dependencies", MalterlibSubLibraries->ForEach(&AllSubLibraryGroupsTemplate)..., MalterlibLibraryGroups...]

	%Group "Indirect Dependencies"
	{
		Property
		{
			AllDependenciesTemplate function(string _Library) [string] = []
			AllDependenciesTemplate += `Lib_Malterlib_@(_Library)`
			{
				&
				{
					!_Library ""
					|
					{
						&
						{
							true IsDefined(`MalterlibSubLibrarySeparate_Lib_Malterlib_@(_Library)`) ? MalterlibSubLibrarySeparate_Lib_Malterlib_@(_Library) : false
							!true IsDefined(`MalterlibLibrarySeparate_Lib_Malterlib_@(_Library)`) ? MalterlibLibrarySeparate_Lib_Malterlib_@(_Library) : false
						}
						&
						{
							MalterlibSubLibrarySeparate true
							!false IsDefined(`MalterlibSubLibrarySeparate_Lib_Malterlib_@(_Library)`) ? MalterlibSubLibrarySeparate_Lib_Malterlib_@(_Library) : false
						}
					}
				}
			}
		}

		%Dependency MalterlibSubLibraries->ForEach(&AllDependenciesTemplate)

		Dependency.Indirect true
	}
}

%Target "Dll_MalterlibOverrideMallocDummy"
{
	Property.MalterlibNoShortcuts true
	Property.MalterlibProfileGuidedOptimization undefined
	Target
	{
		BaseName "MalterlibOverrideMallocDummy"
		Type "SharedDynamicLibrary"
