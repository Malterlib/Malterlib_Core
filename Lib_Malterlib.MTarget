	{
		!!PlatformFamily "macOS"
		LinkWithLibraries []
		CodeCoverageLinkerMapping false
		CodeCoverageMapping false
		InstrumentForOptimization false
		SharedLibraryInstallPath "@executable_path/MalterlibMallocOverrideDummy.dylib"
	}
	Compile
	{
		!!CompileDialect "C"
		PrefixHeader undefined
		CodeCoverage false
		{
			!!MalterlibCodeCoverage true
		}
		DefaultHeaders "NoStdIncludeCxx"
		DefaultLibraries "NoStdLibCxx"
	}
	Property
	{
		MalterlibDisableMalterlib true
		MalterlibStripSymbols false
		MalterlibPostCopyProject undefined
	}
	%Group "Source"
	{
		%File "../Memory/Source/Malterlib_Memory_SystemOverride_MacOSDyldDummy.cpp"
		{
			!!PlatformFamily "macOS"
		}
		%File "Source/Dummy/DummyMainRaw.cpp"
		{
			!PlatformFamily "macOS"
		}
	}
}

