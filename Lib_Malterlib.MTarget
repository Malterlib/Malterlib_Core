		!!PlatformFamily "Linux"
	}
	Target
	{
		&
		{
			!MalterlibSupportSanitizers true
			PlatformFamily "macOS"
		}
	}
	Target
	{
		!!PlatformFamily "macOS"

		CodeCoverageLinkerMapping false
		CodeCoverageMapping false
		InstrumentForOptimization false
	}
	Compile
	{
		!!CompileDialect "C"
		PrefixHeader undefined
		CodeCoverage false
		{
			!!MalterlibCodeCoverage true
		}
		StackGuard false
		{
			!!PlatformFamily "macOS"
		}
		DefaultHeaders "NoStdIncludeCxx"
		DefaultLibraries "NoStdLibCxx"
	}
	Property
	{
		MalterlibDisableMalterlib true
		MalterlibStripSymbols false
	}
	%Group "Source"
	{
		%File "Tools/Helper/Malterlib_Core_Helper.cpp"
	}
}

