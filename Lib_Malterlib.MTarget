%Group "~Automatic/Breakpad Support"
{
	%File "Source/Platform/Malterlib_Core_PlatformImp_Breakpad.cpp"
	{
		Compile.Disabled true
		{
			|
			{
				PlatformFamily "Windows"
			}
		}
	}
	%GenerateFile "Breakpad"
	{
		&
		{
			MalterlibEnableBreakpad true
			|
			{
				Target.Type "Executable"
				Target.Type "ConsoleExecutable"
				Target.Type "UIExecutable"
			}
		}

		GenerateFile
		{
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
			Name `@(GeneratedDirectory)BreakpadInfo.cpp`

			Contents	`#include <Mib/Core/Core>\n\n`\
						`namespace NMib\n`\
						`{\n`\
						`	namespace NSys\n`\
						`	{\n`\
						`		void fg_InitialiseCrashReporter()\n`\
						`		{\n`\
						`			NMib::fg_GetSys()->f_SetCrashHandler("", @(MalterlibBreakpadUploadServer->Escape()));\n`\
						`		}\n`\
						`	}\n`\
						`}\n`

			UnicodeBOM true
		}
	}

	%Dependency "Lib_Breakpad_Common"
	{
		!!MalterlibEnableBreakpad true
	}
	%Dependency "Lib_Breakpad_Client"
	{
		!!MalterlibEnableBreakpad true
	}
}

%Group "~Automatic/Metadata"
{
	%GenerateFile "Metadata"
	{
		Property
		{
			f_ExpandTags function(string _Tag) string = ""

			f_ExpandTags =+ "			"
			{
				!!f_ExpandTags undefined
			}

			f_ExpandTags =+ "			, "
			{
				!f_ExpandTags "			"
			}

			f_ExpandTags =+ `@(_Tag->Escape())\n`
		}

		GenerateFile
		{
			Group `@(Platform) @(Architecture) @(FullConfiguration)`
			Name `@(GeneratedDirectory)BuildMetadata.cpp`

			Contents	`#include <Mib/Core/BuildMetaData>\n\n`\
						`namespace NMib::NSys\n`\
						`{\n`

			Contents =+ `	static constexpr ch8 const *gc_Tags[] =\n`\
						`		{\n`\
						`@(MalterlibCloudVersionInfo_Tags->ForEach(&f_ExpandTags))`\
						`		}\n`\
						`	;\n`\
						`\n`
						{
							!MalterlibCloudVersionInfo_Tags->Length() 0
						}

			Contents =+ `	CBuildMetadata fg_GetBuildMetadata()\n`\
						`	{\n`\
						`		return\n`\
						`			{\n`\
						`				.m_pProduct = @(MalterlibCloudVersionInfo_Product->Escape())\n`\
						`				, .m_pApplication = @(MalterlibCloudVersionInfo_Application->Escape())\n`\
						`				, .m_pConfiguration = @(MalterlibCloudVersionInfo_Configuration->Escape())\n`\
						`				, .m_pGitBranch = @((MalterlibGitBranch || "")->Escape())\n`\
						`				, .m_pGitCommit = @(MalterlibGitCommit->Escape())\n`\
						`				, .m_pPlatform = @(MalterlibCloudPlatform->Escape())\n`\
						`				, .m_pVersion = @(MalterlibCloudVersionInfo_Version->Escape())\n`\
						`				, .m_nTags = @(MalterlibCloudVersionInfo_Tags->Length()->ToString())\n`\
						`				, .m_pTags = @((MalterlibCloudVersionInfo_Tags->Length() == 0) ? "nullptr" : "gc_Tags")\n`\
						`		 	}\n`\
						`		;\n`\
						`	}\n`\
						`}\n`

			UnicodeBOM true
		}
	}

	%Dependency "Lib_Breakpad_Common"
	{
		!!MalterlibEnableBreakpad true
	}
	%Dependency "Lib_Breakpad_Client"
	{
		!!MalterlibEnableBreakpad true
	}
}

