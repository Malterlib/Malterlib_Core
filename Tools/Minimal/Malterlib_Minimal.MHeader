Property
{
	MalterlibMinimalEnable: bool = false // User(Malterlib)=true: Enable malterlib minimal workspace
}

%Target "Malterlib_Minimal"
{
	Property
	{
		MalterlibPostCopyProject "Malterlib"
	}
	
	%File "Main.cpp"
	%Dependency "Lib_Malterlib_Core"
//	%Dependency "Lib_Malterlib"
	//%Dependency "Lib_Malterlib_Override"
}

%Workspace "Malterlib_Minimal"
{
	!!MalterlibMinimalEnable true
	
	//Property.MalterlibLibrary_All true
	Property.MalterlibSubLibrarySeparate true
	Property.MalterlibMemoryManager "System"
	
	//Property.MalterlibUseStaticLibCxx false
	//Property.MalterlibUseStaticLibCxxABI false
	//Property.MalterlibDefaultToolset true
	
	%Target "Malterlib_Minimal"
}
